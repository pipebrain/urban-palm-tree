unit/MilliPA"},{"@id":"http://qudt.org/vocab/unit/MilliTORR"},{"@id":"http://qudt.org/vocab/unit/N-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/N-PER-M2"},{"@id":"http://qudt.org/vocab/unit/N-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/PA"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/PSI"},{"@id":"http://qudt.org/vocab/unit/PicoPA"},{"@id":"http://qudt.org/vocab/unit/PlanckPressure"},{"@id":"http://qudt.org/vocab/unit/TORR"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Pressure","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD142","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD142","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Pressure","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$p = \\frac{dF}{dA}$, where $dF$ is the force component perpendicular to the surface element of area $dA$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Pressure is an effect which occurs when a force is applied on a surface. Pressure is the amount of\n    force acting on a unit area. Pressure is distinct from stress, as the former is the ratio of the component of force normal to\n    a surface to the surface area. Stress is a tensor that relates the vector force to the vector area.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/PRES"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q39552"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ForcePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Druck","@language":"de"},{"@value":"Pressure","@language":"en"},{"@value":"Tekanan","@language":"ms"},{"@value":"Tlak","@language":"cs"},{"@value":"basınç","@language":"tr"},{"@value":"ciśnienie","@language":"pl"},{"@value":"nyomás","@language":"hu"},{"@value":"presiune","@language":"ro"},{"@value":"presión","@language":"es"},{"@value":"pressio","@language":"la"},{"@value":"pression","@language":"fr"},{"@value":"pressione","@language":"it"},{"@value":"pressão","@language":"pt"},{"@value":"tlak","@language":"sl"},{"@value":"Πίεση - τάση","@language":"el"},{"@value":"Давление","@language":"ru"},{"@value":"Налягане","@language":"bg"},{"@value":"לחץ","@language":"he"},{"@value":"الضغط أو الإجهاد","@language":"ar"},{"@value":"فشار، تنش","@language":"fa"},{"@value":"दबाव","@language":"hi"},{"@value":"压强、压力","@language":"zh"},{"@value":"圧力","@language":"ja"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"naprężenie","@language":"pl"},{"@value":"pritisk","@language":"sl"},{"@value":"tegasan","@language":"ms"},{"@value":"tensione meccanica","@language":"it"},{"@value":"tensiune mecanică","@language":"ro"},{"@value":"tensão","@language":"pt"},{"@value":"механично напрежение","@language":"bg"},{"@value":"दाब","@language":"hi"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/PressureBasedAmountOfSubstanceConcentration","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio between the amount-of-substance concentration of a dissolved material (its amount of substance\n    divided by the volume of the solution) and the related pressure\n  ","@language":"en"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ307#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L-2I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient Molarität (Quotient aus der Stoffmenge eines gelösten Stoffes und dem Volumen der Lösung)\n    dividiert durch den zugehörigen Druck\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pressure-based Amount-of-substance Concentration","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/PressureBasedDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio of density divided by the related pressure","@language":"en"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ299#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient aus Dichte dividiert durch den zugehörigen Druck","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pressure-based Density","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/PressureBasedDynamicViscosity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio of dynamic viscosity divided by the related pressure","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/POISE-PER-PA"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ300#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient aus der dynamischen Viskosität dividiert durch den zugehörigen Druck","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:PressureBasedDynamicViscosity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pressure-based Dynamic Viscosity","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/PressureBasedElectricCurrent","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio of electric current divided by the related pressure","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-PER-PA"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ309#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L1I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient elektrische Stromstärke dividiert durch den zugehörigen Druck","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykin