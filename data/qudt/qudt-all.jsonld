":"http://qudt.org/vocab/unit/PINT_US-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/PINT_US-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PK_UK-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/PK_UK-PER-HR"},{"@id":"http://qudt.org/vocab/unit/PK_UK-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/PK_UK-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PK_US_DRY-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/PK_US_DRY-PER-HR"},{"@id":"http://qudt.org/vocab/unit/PK_US_DRY-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/PK_US_DRY-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/QT_UK-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/QT_UK-PER-HR"},{"@id":"http://qudt.org/vocab/unit/QT_UK-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/QT_UK-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/QT_US-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/QT_US-PER-HR"},{"@id":"http://qudt.org/vocab/unit/QT_US-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/QT_US-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/YD3-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/YD3-PER-HR"},{"@id":"http://qudt.org/vocab/unit/YD3-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/YD3-PER-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/VolumeFlowRate"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"q_V","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:VolumeFlowRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Moisture Diffusivity","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/VolumeFlowRate"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolalityOfSolute","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Molality of Solute\" of a solution is defined as the amount of substance of solute divided by the\n    mass in kg of the solvent.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiMOL-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloMOL-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MOL_LB-PER-LB"},{"@id":"http://qudt.org/vocab/unit/MicroMOL-PER-GM"},{"@id":"http://qudt.org/vocab/unit/NanoMOL-PER-GM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Molality","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$b_B = \\frac{n_B}{m_a}$, where $n_B$ is the amount of substance and $m_A$ is the mass.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Molality of Solute\" of a solution is defined as the amount of substance of solute divided by\n    the mass in kg of the solvent.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstancePerMass"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"b_B","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolalityOfSolute","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molality of Solute","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstancePerMass"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarAbsorptionCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Molar Absorption Coefficient\" is a spectrophotometric unit indicating the light a substance absorbs with\n    respect to length, usually centimeters, and concentration, usually moles per liter.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/M2-PER-MOL"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/MolarAttenuationCoefficient"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://medical-dictionary.thefreedictionary.com/molar+absorption+coefficient","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$x = aV_m$, where $a$ is the linear absorption coefficient and $V_m$ is the molar volume.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Molar Absorption Coefficient\" is a spectrophotometric unit indicating the light a substance\n    absorbs with respect to length, usually centimeters, and concentration, usually moles per liter.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"x","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q11784888"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarAbsorptionCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Absorption Coefficient","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarAngularMomentum","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-SEC-PER-MOL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://cvika.grimoar.cz/callen/callen_21.pdf","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarAngularMomentum","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Angular Momentum","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarAttenuationCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Molar Attenuation Coefficient\" is a measurement of how strongly a chemical species or substance absorbs\n    or scatters light at a given wavelength, per amount of substance.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/M2-PER-MOL"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ356#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/MolarAbsorptionCoefficient"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD120","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD120","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Mass_attenuation_coefficient","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mu_c = -\\frac{\\mu}{c}$, where $\\mu$ is the linear attenuation coefficient and $c$ is the amount-of-substance concentration.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mu_c$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Molar Attenuation Coefficient\" is a measurement of how strongly a chemical species or substance\n    absorbs or scatters light at a given wavelength, per amount of substance.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q900239"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarAttenuationCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Attenuation Coefficient","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://qudt.org/vocab/quantitykind/MassAttenuationCoefficient"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarConductivity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Molar Conductivity\" is the conductivity of an electrolyte solution divided by the molar concentration of\n    the electrolyte, and so measures the efficiency with which a given electrolyte conducts electricity in solution.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/S-M2-PER-MOL"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ354#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E2L0I0M-1H0T3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD121","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://encyclopedia2.thefreedictionary.com/molar+conductivity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD121","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Molar_conductivity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\Gamma_m = \\frac{x}{c_B}$, where $x$ is the electrolytic conductivity and $c_B$ is the amount-of-substance concentration.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Gamma_m$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Molar Conductivity\" is the conductivity of an electrolyte solution divided by the molar\n    concentration of the electrolyte, and so measures the efficiency with which a given electrolyte conducts electricity in\n    solution.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1943278"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarConductivity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Conductivity","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"quantity whose value is inversely proportional to the quantity of material","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PER-MOL"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ372#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/InverseAmountOfSubstance"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Größe, deren Wert sich umgekehrt proportional zu Stoffmengenwert verhält","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Density","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Molar Energy\" is the total energy contained by a thermodynamic system. The unit is $$J/mol$$, also\n    expressed as $$joule/mole$$,  or $$joules per mole$$. This unit is commonly used in the SI unit system. The quantity has the\n    dimension of $$M \\cdot L^2 \\cdot  T^{-2} \\cdot N^{-1}$$ where $$M$$ is mass, $$L$$ is length, $$T$$ is time, and $$N$$ is\n    amount of substance.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-MOL"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-MOL"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-MOL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.efunda.com/glossary/units/units--molar_energy--joule_per_mole.cfm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Joule_per_mole","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$U_m = \\frac{U}{n}$, where $U$ is internal energy and $n$ is amount of substance.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/MOEG"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"U_M","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q69427512"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"dimensions are wrong","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Energy","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarEntropy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Standard Molar Entropy\" is the entropy content of one mole of substance, under standard conditions\n    (not standard temperature and pressure STP).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-MOL-K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H-1T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Standard_molar_entropy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$S_m = \\frac{S}{n}$, where $S$ is entropy and $n$ is amount of substance.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Standard Molar Entropy\" is the entropy content of one mole of substance, under standard\n    conditions (not standard temperature and pressure STP).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/MOEN"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"S_m","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q68972876"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarEntropy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Entropy","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarEquivalent","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Molar Equivalent\" is the amount of a substance that reacts with (or is equivalent to) an arbitrary\n    amount (typically one mole) of another substance in a given chemical reaction.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/EQ"},{"@id":"http://qudt.org/vocab/unit/MicroEQ"},{"@id":"http://qudt.org/vocab/unit/MilliEQ"},{"@id":"http://qudt.org/vocab/unit/NanoEQ"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Equivalent_(chemistry)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstance"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"equiv","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarEquivalent","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Equivalent","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstance"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarFlowRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Molar Flow Rate is a measure of the amount of substance (the number of molecules) that passes through a\n    given area perpendicular to the flow in a given time. Typically this area is constrained, for example a section through a\n    pipe, but it could also apply to an open flow.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloMOL-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloMOL-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/SCF-PER-HR"},{"@id":"http://qudt.org/vocab/unit/SCF-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/SCM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/SCM-PER-MIN"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/CurrentOfTheAmountOfSubstance"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD122","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD122","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://www.sciencedirect.com/topics/engineering/molar-flow-rate","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Molar Flow Rate is a measure of the amount of substance (the number of molecules) that passes\n    through a given area perpendicular to the flow in a given time. Typically this area is constrained, for example a section\n    through a pipe, but it could also apply to an open flow.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"q_V","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarFlowRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Flow Rate","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarFluxDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"the rate at which moles of a substance pass through a unit area per unit time. It is used for describing\n    the flow of materials in terms of the transport of molecules or particles rather than bulk mass. The SI units are mol m-2 s-1\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MilliMOL-PER-M2-HR"},{"@id":"http://qudt.org/vocab/unit/NanoMOL-PER-M2-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L-2I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Mass_flux#Molar_fluxes","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"the rate at which moles of a substance pass through a unit area per unit time. It is used for\n    describing the flow of materials in terms of the transport of molecules or particles rather than bulk mass. The SI units are\n    mol m-2 s-1\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarFluxDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Flux Density","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarFluxDensityVariance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Variance for Molar Flux Density data.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MicroMOL2-PER-M4-SEC2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A2E0L-4I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://www.neonscience.org/data-samples/data-management/data-processing","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Variance for Molar Flux Density data.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarFluxDensityVariance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Flux Density Variance","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarFluxDensityVariance_NEON","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Variance for NEON Molar Flux Denisity data measured in unit:MicroMOL-PER-M2-SEC","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/MolarFluxDensityVariance"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A2E0L-4I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://www.neonscience.org/data-samples/data-management/data-processing","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Variance for NEON Molar Flux Denisity data measured in unit:MicroMOL-PER-M2-SEC","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Flux Density Variance, NEON","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarHeatCapacity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Molar Heat Capacity\" is the amount of heat energy required to raise the temperature of 1 mole of a\n    substance. In SI units, molar heat capacity (symbol: cn) is the amount of heat in joules required to raise 1 mole of a\n    substance 1 Kelvin.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/altSymbol":[{"@value":"cn","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-MOL_LB-DEG_F"},{"@id":"http://qudt.org/vocab/unit/J-PER-MOL-K"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-MOL-DEG_C"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/MolarThermalCapacity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H-1T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD123","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://chemistry.about.com/od/chemistryglossary/g/Molar-Heat-Capacity-Definition.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD123","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$C_m = \\frac{C}{n}$, where $C$ is heat capacity and $n$ is amount of substance.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Molar Heat Capacity\" is the amount of heat energy required to raise the temperature of 1 mole of a\n    substance. In SI units, molar heat capacity (symbol: cn) is the amount of heat in joules required to raise 1 mole of a\n    substance 1 Kelvin.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"C_m","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q2937190"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarHeatCapacity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Heat Capacity","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarInternalEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-MOL"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-MOL"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-MOL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD124","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD124","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MolarEnergy"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Internal Energy","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MolarEnergy"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarMass","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In chemistry, the molar mass M is defined as the mass of a given substance (chemical element or chemical\n    compound) divided by its amount of substance. It is a physical property of a given substance. The base SI unit for molar mass\n    is $kg/mol$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/GM-PER-MOL"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-KiloMOL"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-MOL"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Molar_mass","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ287#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD125","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD125","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Molar_mass","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"M","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q145623"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarMass","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Jisim molar","@language":"ms"},{"@value":"Masa molowa","@language":"pl"},{"@value":"Masă molară","@language":"ro"},{"@value":"Molar Mass","@language":"en"},{"@value":"Molmasse","@language":"de"},{"@value":"Molární hmotnost","@language":"cs"},{"@value":"masa molar","@language":"es"},{"@value":"massa molar","@language":"pt"},{"@value":"massa molare","@language":"it"},{"@value":"masse molaire","@language":"fr"},{"@value":"molar kütle","@language":"tr"},{"@value":"molska masa","@language":"sl"},{"@value":"Молярная масса","@language":"ru"},{"@value":"جرم مولی","@language":"fa"},{"@value":"كتلة مولية","@language":"ar"},{"@value":"मोलर द्रव्यमान","@language":"hi"},{"@value":"モル質量","@language":"ja"},{"@value":"摩尔质量","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"molare Masse","@language":"de"},{"@value":"stoffmengenbezogene Masse","@language":"de"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarOpticalRotationalAbility","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"material-specific quantity resulting as the specific angle of rotation of a substance for a particular\n    wavelength and a particular temperature from the relationship: ratio between measured angle of rotation divided by the\n    concentration of material and the covered path\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/RAD-M2-PER-MOL"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ426#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/MolarOpticalRotatoryPower"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"materialspezifische Größe, die sich als spezifischer Drehwinkel einer Substanz für eine bestimmte\n    Wellenlänge und eine bestimmte Temperatur ergibt durch die Beziehung: Quotient aus gemessener Drehwinkel dividiert durch die\n    Stoffmenegenkonzentration und die durchstrahlte Wegstrecke\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarOpticalRotationalAbility","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Optical Rotational Ability","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarOpticalRotatoryPower","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Molar Optical Rotatory Power\" Angle of optical rotation divided by the optical path length through\n    the medium and by the amount concentration giving the molar optical rotatory power.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/RAD-M2-PER-MOL"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/MolarOpticalRotationalAbility"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD126","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://goldbook.iupac.org/O04313.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD126","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\alpha_n = \\alpha \\frac{A}{n}$, where $\\alpha$ is the angle of optical rotation, and $n$ is the amount of substance of the optically active component in the path of a linearly polarized light beam of cross sectional area $A$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\alpha_n$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Molar Optical Rotatory Power\" Angle of optical rotation divided by the optical path length\n    through the medium and by the amount concentration giving the molar optical rotatory power.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q96346994"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarOpticalRotatoryPower","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Optical Rotatory Power","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarRefractivity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A quantity kind that is a measure of the total polarizability of a mole of substance that depends on the\n    temperature, the index of refraction and the pressure.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM3-PER-MOL"},{"@id":"http://qudt.org/vocab/unit/DeciM3-PER-MOL"},{"@id":"http://qudt.org/vocab/unit/L-PER-MOL"},{"@id":"http://qudt.org/vocab/unit/L-PER-MicroMOL"},{"@id":"http://qudt.org/vocab/unit/M3-PER-MOL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A quantity kind that is a measure of the total polarizability of a mole of substance that depends\n    on the temperature, the index of refraction and the pressure.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarRefractivity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Refractivity","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarThermalCapacity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"thermal capacity divided by the amount of substance","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-MOL_LB-DEG_F"},{"@id":"http://qudt.org/vocab/unit/J-PER-MOL-K"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-MOL-DEG_C"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ355#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/MolarHeatCapacity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H-1T-2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"auf die Stoffmenge bezogene Wärmekapazität","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarThermalCapacity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Thermal Capacity","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarThermodynamicEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"energy in relation to the amount of a substance","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-MOL"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-MOL"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-MOL"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ353#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"auf die Stoffmenge bezogene Energie","@language":"de"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MolarEnergy"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Thermodynamic Energy","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MolarEnergy"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolarVolume","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The molar volume, symbol $V_m$, is the volume occupied by one mole of a substance (chemical element or\n    chemical compound) at a given temperature and pressure. It is equal to the molar mass ($M$) divided by the mass density\n    ($\\rho$). It has the SI unit cubic metres per mole ($m^{1}/mol$). For ideal gases, the molar volume is given by the ideal gas\n    equation: this is a good approximation for many common gases at standard temperature and pressure. For crystalline solids, the\n    molar volume can be measured by X-ray crystallography.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM3-PER-MOL"},{"@id":"http://qudt.org/vocab/unit/DeciM3-PER-MOL"},{"@id":"http://qudt.org/vocab/unit/L-PER-MOL"},{"@id":"http://qudt.org/vocab/unit/L-PER-MicroMOL"},{"@id":"http://qudt.org/vocab/unit/M3-PER-MOL"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Molar_volume","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ357#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD127","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD127","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Molar_volume","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$V_m = \\frac{V}{n}$, where $V$ is volume and $n$ is amount of substance.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"V_m","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q487112"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarVolume","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Isipadu molar","@language":"ms"},{"@value":"Molar Volume","@language":"en"},{"@value":"Molvolumen","@language":"de"},{"@value":"molar hacim","@language":"tr"},{"@value":"molski volumen","@language":"sl"},{"@value":"molární objem","@language":"cs"},{"@value":"volum molar","@language":"ro"},{"@value":"volume molaire","@language":"fr"},{"@value":"volume molar","@language":"pl"},{"@value":"volume molar","@language":"pt"},{"@value":"volume molare","@language":"it"},{"@value":"volumen molar","@language":"es"},{"@value":"Молярный объём","@language":"ru"},{"@value":"حجم مولي","@language":"ar"},{"@value":"حجم مولی","@language":"fa"},{"@value":"モル体積","@language":"ja"},{"@value":"摩尔体积","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"molares Volumen","@language":"de"},{"@value":"stoffmengenbezogenes Volumen","@language":"de"}]},{"@id":"http://qudt.org/vocab/quantitykind/MoleFraction","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In chemistry, the mole fraction of a component in a mixture is the relative proportion of molecules\n    belonging to the component to those in the mixture, by number of molecules. It is one way of measuring concentration.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/PERMILLE"},{"@id":"http://qudt.org/vocab/unit/PPB"},{"@id":"http://qudt.org/vocab/unit/PPM"},{"@id":"http://qudt.org/vocab/unit/PPQ"},{"@id":"http://qudt.org/vocab/unit/PPT"},{"@id":"http://qudt.org/vocab/unit/PPTH"},{"@id":"http://qudt.org/vocab/unit/PPTM"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Mole_fraction","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In chemistry, the mole fraction of a component in a mixture is the relative proportion of molecules\n    belonging to the component to those in the mixture, by number of molecules. It is one way of measuring concentration.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q125264"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MoleFraction","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mole Fraction","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolecularConcentration","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Molecular Concentration\" of substance B  is defined as the number of molecules of B  divided by the\n    volume of the mixture\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"m^{-3}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/NUM-PER-L"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-M3"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-MicroL"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-MilliL"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-MilliM3"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-NanoL"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-PicoL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Molar_concentration","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$C_B = \\frac{N_B}{V}$, where $N_B$ is the number of molecules of $B$ and $V$ is the volume.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Molecular Concentration\" of substance B  is defined as the number of molecules of B  divided\n    by the volume of the mixture\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/NumberDensity"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"C_B","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q88865973"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:NumberDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molecular Concentration","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/NumberDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolecularMass","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The molecular mass, or molecular weight of a chemical compound is the mass of one molecule of that\n    compound, relative to the unified atomic mass unit, u. Molecular mass should not be confused with molar mass, which is the\n    mass of one mole of a substance.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DA"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Molecular_mass","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Molecular_mass#Relative_molecular_mass","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The molecular mass, or molecular weight of a chemical compound is the mass of one molecule of that\n    compound, relative to the unified atomic mass unit, u. Molecular mass should not be confused with molar mass, which is the\n    mass of one mole of a substance.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"M","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q182854"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolecularMass","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molecular Mass","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}]},{"@id":"http://qudt.org/vocab/quantitykind/MolecularViscosity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Molecules in a fluid close to a solid boundary sometime strike the boundary and transfer momentum to it.\n    Molecules further from the boundary collide with molecules that have struck the boundary, further transferring the change in\n    momentum into the interior of the fluid. This transfer of momentum is molecular viscosity. Molecules, however, travel only\n    micrometers between collisions, and the process is very inefficient for transferring momentum even a few centimeters.\n    Molecular viscosity is important only within a few millimeters of a boundary. The coefficient of molecular viscosity has the\n    same value as the dynamic viscosity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiPOISE"},{"@id":"http://qudt.org/vocab/unit/DecaPOISE"},{"@id":"http://qudt.org/vocab/unit/GM-PER-CentiM-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M-DAY"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M-HR"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloPOISE"},{"@id":"http://qudt.org/vocab/unit/LB-PER-FT-DAY"},{"@id":"http://qudt.org/vocab/unit/LB-PER-FT-HR"},{"@id":"http://qudt.org/vocab/unit/LB-PER-FT-MIN"},{"@id":"http://qudt.org/vocab/unit/LB-PER-FT-SEC"},{"@id":"http://qudt.org/vocab/unit/LB_F-SEC-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/LB_F-SEC-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/MicroPOISE"},{"@id":"http://qudt.org/vocab/unit/MilliPA-SEC"},{"@id":"http://qudt.org/vocab/unit/N-SEC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/PA-SEC"},{"@id":"http://qudt.org/vocab/unit/PDL-SEC-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/PDL-SEC-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/POISE"},{"@id":"http://qudt.org/vocab/unit/SLUG-PER-FT-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://oceanworld.tamu.edu/resources/ocng_textbook/chapter08/chapter08_01.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Molecules in a fluid close to a solid boundary sometime strike the boundary and transfer momentum\n    to it. Molecules further from the boundary collide with molecules that have struck the boundary, further transferring the\n    change in momentum into the interior of the fluid. This transfer of momentum is molecular viscosity. Molecules, however,\n    travel only micrometers between collisions, and the process is very inefficient for transferring momentum even a few\n    centimeters. Molecular viscosity is important only within a few millimeters of a boundary. The coefficient of molecular\n    viscosity has the same value as the dynamic viscosity.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/DynamicViscosity"},{"@id":"http://qudt.org/vocab/quantitykind/Viscosity"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:DynamicViscosity","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:Viscosity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molecular Viscosity","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/DynamicViscosity"},{"@id":"http://qudt.org/vocab/quantitykind/KinematicViscosity"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DynamicViscosity"},{"@id":"http://qudt.org/vocab/quantitykind/Viscosity"}]},{"@id":"http://qudt.org/vocab/quantitykind/MomentOfForce","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Moment of force (often just moment) is the tendency of a force to twist or rotate an object.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiN-M"},{"@id":"http://qudt.org/vocab/unit/DYN-CentiM"},{"@id":"http://qudt.org/vocab/unit/DYN-M"},{"@id":"http://qudt.org/vocab/unit/DeciN-M"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F_Torque"},{"@id":"http://qudt.org/vocab/unit/IN-PDL"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F-M"},{"@id":"http://qudt.org/vocab/unit/KiloN-M"},{"@id":"http://qudt.org/vocab/unit/LB_F-IN"},{"@id":"http://qudt.org/vocab/unit/MegaN-M"},{"@id":"http://qudt.org/vocab/unit/MicroN-M"},{"@id":"http://qudt.org/vocab/unit/MilliN-M"},{"@id":"http://qudt.org/vocab/unit/N-CentiM"},{"@id":"http://qudt.org/vocab/unit/N-M"},{"@id":"http://qudt.org/vocab/unit/OZ_F-IN"},{"@id":"http://qudt.org/vocab/unit/PDL-FT"},{"@id":"http://qudt.org/vocab/unit/PDL-IN"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/Torque"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Moment_(physics)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$M = r \\cdot F$, where $r$ is the position vector and $F$ is the force.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Moment of force (often just moment) is the tendency of a force to twist or rotate an object.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/TORQ"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"M","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q17232562"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MomentOfForce","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Moment of Force","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MomentOfInertia","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The rotational inertia or resistance to change in direction or speed of rotation about a defined axis.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloGM-M2"},{"@id":"http://qudt.org/vocab/unit/KiloGM-MilliM2"},{"@id":"http://qudt.org/vocab/unit/LB-FT2"},{"@id":"http://qudt.org/vocab/unit/LB-IN2"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ246#006","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/RotationalMass"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD128","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD128","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Moment_of_inertia","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$I_Q = \\int r^2_Q dm$, where $r_Q$ is the radial