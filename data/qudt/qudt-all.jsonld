kind/SurgeImpedanceOfTheMedium","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"in a mechanical system the area-related quotient of a force affecting to a point divided by the resulting\n    component of the particle velocity in direction of the force\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/N-SEC-PER-M3"},{"@id":"http://qudt.org/vocab/unit/PA-SEC-PER-M"},{"@id":"http://qudt.org/vocab/unit/RAYL"},{"@id":"http://qudt.org/vocab/unit/RAYL_MKS"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ323#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD185","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD185","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"in einem mechanischen System der flächenbezogene Quotient einer an einem Punkt angreifenden Kraft\n    durch die resultierende Komponente der Teilchengeschwindigkeit in Richtung der Kraft\n  ","@language":"de"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MassPerAreaTime"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SurgeImpedanceOfTheMedium","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Surge Impedance of the Medium","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.or