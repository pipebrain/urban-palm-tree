chema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/CoefficientOfHeatTransfer"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_F-HR-FT2-PER-BTU_TH"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB277","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB277","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Btu{th}/(h·ft²·°F)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[Btu_th].h-1.[ft_i]-2.[degF]-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"N75","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/CoefficientOfHeatTransfer"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"British Thermal Unit (thermochemical Definition) per Hour Square Foot Degree Fahrenheit","@language":"en"},{"@value":"British Thermal Unit (thermochemical Definition) per Hour Square Foot Degree Fahrenheit","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-LB","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"${\\bf Btu_{th} / lbm}$, British Thermal Unit (therm.) Per Pound Mass, is a unit in the category of total\n    energy per unit mass, commonly known as specific enthalpy. It is also known as Btu per pound, Btu/pound, Btu/lb. This unit is\n    commonly used in the UK unit system. British Thermal Unit (therm.) Per Pound Mass (Btu (therm.)/lbm) has a dimension of\n    $L^2T^{-2}$ where $L$ is length, and $T$ is time. It can be converted to the corresponding standard SI unit J/kg by\n    multiplying its value by a factor of 2324.443861.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"2324.444444468940251353875286746997","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"2.324444444468940251353875286746997E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$btu_th-per-lb$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-735"},{"@id":"_:n3-736"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/Pubs/SP811/appenB9.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.efunda.com/glossary/units/units--thermal_heat_capacity--british_thermal_unit_therm_per_pound_mass.cfm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Btu{th}/lbm","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[Btu_th].[lb_av]-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"British Thermal Unit (thermochemical Definition) per Pound Mass","@language":"en"},{"@value":"British Thermal Un