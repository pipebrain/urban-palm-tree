 period as required may be used to obtain the required precision. \n  All fields require leading zeros.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}]},{"@id":"http://www.w3.org/2001/XMLSchema#decimal","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype"]},{"@id":"http://www.w3.org/2001/XMLSchema#double","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype"]},{"@id":"http://www.w3.org/2001/XMLSchema#duration","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype"]},{"@id":"http://www.w3.org/2001/XMLSchema#float","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype"]},{"@id":"http://www.w3.org/2001/XMLSchema#gDay","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype"]},{"@id":"http://www.w3.org/2001/XMLSchema#gMonth","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype"]},{"@id":"http://www.w3.org/2001/XMLSchema#gMonthDay","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype"]},{"@id":"http://www.w3.org/2001/XMLSchema#gYear","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype"]},{"@id":"http://www.w3.org/2001/XMLSchema#gYearMonth","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype"]},{"@id":"http://www.w3.org/2001/XMLSchema#hexBinary","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype"]},{"@id":"http://www.w3.org/2001/XMLSchema#int","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype"]},{"@id":"http://www.w3.org/2001/XMLSchema#integer","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype"]},{"@id":"http://www.w3.org/2001/XMLSchema#long","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype"]},{"@id":"http://www.w3.org/2001/XMLSchema#negativeInteger","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype"]},{"@id":"http://www.w3.org/2001/XMLSchema#nonNegativeInteger","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype"]},{"@id":"http://www.w3.org/2001/XMLSchema#nonPositiveInteger","@type":["http://w