"@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$N/kg$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-3993"},{"@id":"_:n3-3994"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThrustToMassRatio"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"N/kg","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"N.kg-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThrustToMassRatio"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Newton na Kilogram","@language":"cs"},{"@value":"Newton na Kilogram","@language":"sl"},{"@value":"Newton par Kilogramme","@language":"fr"},{"@value":"Newton pe Kilogram","@language":"ro"},{"@value":"Newton per Chilogrammo","@language":"it"},{"@value":"Newton per Kilogram","@language":"en"},{"@value":"Newton per Kilogram","@language":"ms"},{"@value":"Newton per Kilogram","@language":"tr"},{"@value":"Newton per Kilogram","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Newton por Kilogramo","@language":"es"},{"@value":"Newton por Quilograma","@language":"pt"},{"@value":"Newton pro Kilogramm","@language":"de"},{"@value":"Newtonium per Chiliogramma","@language":"la"},{"@value":"Niuton na Kilogram","@language":"pl"},{"@value":"Νιούτον ανά Χιλιόγραμμο","@language":"el"},{"@value":"Ньютон на Килограмм","@language":"ru"},{"@value":"Нютон на Килограм","@language":"bg"}]},{"@id":"http://qudt.org/vocab/unit/N-PER-M","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Newton Per Meter (N/m) is a unit in the category of Surface tension. It is also known as newtons per\n    meter, newton per metre, newtons per metre, newton/meter, newton/metre. This unit is commonly used in the SI unit system.\n    Newton Per Meter (N/m) has a dimension of MT-2 where $M$ is mass, and $T$ is time. This unit is the standard SI unit in this\n    category.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$N/m$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-3995"},{"@id":"_:n3-3996"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerLength"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA246","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA246","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"N/m","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"N.m-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"4P","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerLength"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q26156113"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Newton na Meter","@language":"sl"},{"@value":"Newton na Metr","@language":"cs"},{"@value":"Newton par Mètre","@language":"fr"},{"@value":"Newton pe Metru","@language":"ro"},{"@value":"Newton per Meter","@language":"en-us"},{"@value":"Newton per Meter","@language":"ms"},{"@value":"Newton per Metre","@language":"en"},{"@value":"Newton per Metre","@language":"tr"},{"@value":"Newton per Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Newton per Metro","@language":"it"},{"@value":"Newton por Metro","@language":"es"},{"@value":"Newton por Metro","@language":"pt"},{"@value":"Newton pro Meter","@language":"de"},{"@value":"Newtonium per Metrum","@language":"la"},{"@value":"Niuton na Metr","@language":"pl"},{"@value":"Νιούτον ανά Μέτρο","@language":"el"},{"@value":"Ньютон на Метр","@language":"ru"},{"@value":"Нютон на Метър","@language":"bg"},{"@value":"مقياس التبادل، الأس السالب للمتر","@language":"ar"},{"@value":"نیوتن بر متر","@language":"fa"},{"@value":"प्रति मीटर न्यूटन","@language":"hi"},{"@value":"ニュートン毎メートル","@language":"ja"},{"@value":"牛顿每米","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/N-PER-M2","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The SI unit of pressure. The pascal is the standard pressure unit in the MKS metric system, equal to one\n    newton per square meter or one \"kilogram per meter per second per second.\" The unit is named for Blaise Pascal (1623-1662),\n    French philosopher and mathematician, who was the first person to use a barometer to measure differences in altitude.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Pascal","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M-SEC2"},{"@id":"http://qudt.org/vocab/unit/PA"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-3997"},{"@id":"_:n3-3998"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"},{"@id":"http://qudt.org/vocab