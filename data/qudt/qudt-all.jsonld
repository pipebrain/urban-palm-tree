antitykind:ForcePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mechanical Tension","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/MeltingPoint","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A temperature that is the one at which a substance will change its physical state from a solid to a\n    liquid.  It is also the temperature where the solid and liquid forms of a pure substance can exist in equilibrium.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_C"},{"@id":"http://qudt.org/vocab/unit/DEG_F"},{"@id":"http://qudt.org/vocab/unit/DEG_R"},{"@id":"http://qudt.org/vocab/unit/DecaK"},{"@id":"http://qudt.org/vocab/unit/K"},{"@id":"http://qudt.org/vocab/unit/MegaK"},{"@id":"http://qudt.org/vocab/unit/MilliDEG_C"},{"@id":"http://qudt.org/vocab/unit/MilliK"},{"@id":"http://qudt.org/vocab/unit/PlanckTemperature"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A temperature that is the one at which a substance will change its physical state from a solid to a\n    liquid.  It is also the temperature where the solid and liquid forms of a pure substance can exist in equilibrium.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MeltingPoint","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Melting Point Temperature","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/MicroCanonicalPartitionFunction","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A \"Micro Canonical Partition Function\" applies to a micro canonical ensemble, in which the system is\n    allowed to exchange heat with the environment at fixed temperature, volume, and a fixed number of particles.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Microcanonical_ensemble","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Partition_function_(statistical_mechanics)#Grand_canonical_partition_function","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\Omega = \\sum_r 1$, where the sum is over all quantum states consistent with given energy. volume, external fields, and content.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Omega$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A \"Micro Canonical Partition Function\" applies to a micro canonical ensemble, in which the system\n    is allowed to exchange heat with the environment at fixed temperature, volume, and a fixed number of particles.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/CanonicalPartitionFunction"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q96106546"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CanonicalPartitionFunction","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Micro Canonical Partition Function","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/CanonicalPartitionFunction"}]},{"@id":"http://qudt.org/vocab/quantitykind/MicrobialFormation","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.5.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Deprecated as ill-defined. This quantity kind entered QUDT with the initial bulk vocabulary import and has never\n    carried a description, an external reference or an applicable unit, and no source defining what it denotes has been found. It\n    is deprecated without a replacement rather than have a meaning inferred for it.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Microbial Formation","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MigrationArea","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Migration Area\" is the sum of the slowing-down area from fission energy to thermal energy and the\n    diffusion area for thermal neutrons.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AC"},{"@id":"http://qudt.org/vocab/unit/ARE"},{"@id":"http://qudt.org/vocab/unit/BARN"},{"@id":"http://qudt.org/vocab/unit/CentiM2"},{"@id":"http://qudt.org/vocab/unit/DecaARE"},{"@id":"http://qudt.org/vocab/unit/DeciM2"},{"@id":"http://qudt.org/vocab/unit/FT2"},{"@id":"http://qudt.org/vocab/unit/HA"},{"@id":"http://qudt.org/vocab/unit/IN2"},{"@id":"http://qudt.org/vocab/unit/KiloM2"},{"@id":"http://qudt.org/vocab/unit/KiloMIL_Circ"},{"@id":"http://qudt.org/vocab/unit/M2"},{"@id":"http://qudt.org/vocab/unit/MI2"},{"@id":"http://qudt.org/vocab/unit/MIL_Circ"},{"@id":"http://qudt.org/vocab/unit/MI_US2"},{"@id":"http://qudt.org/vocab/unit/MicroM2"},{"@id":"http://qudt.org/vocab/unit/MilliM2"},{"@id":"http://qudt.org/vocab/unit/NanoM2"},{"@id":"http://qudt.org/vocab/unit/PIXEL_AREA"},{"@id":"http://qudt.org/vocab/unit/PlanckArea"},{"@id":"http://qudt.org/vocab/unit/YD2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://encyclopedia2.thefreedictionary.com/migration+area","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Migration Area\" is the sum of the slowing-down area from fission energy to thermal energy and the\n    diffusion area for thermal neutrons.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Area"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"M^2","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98966325"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Area","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Migration Area","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Area"}]},{"@id":"http://qudt.org/vocab/quantitykind/MigrationLength","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Migration Length\" is the square root of the migration area.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ANGSTROM"},{"@id":"http://qudt.org/vocab/unit/AU"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB_F"},{"@id":"http://qudt.org/vocab/unit/CHAIN"},{"@id":"http://qudt.org/vocab/unit/CHAIN_US"},{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/DecaM"},{"@id":"http://qudt.org/vocab/unit/DeciM"},{"@id":"http://qudt.org/vocab/unit/FATH"},{"@id":"http://qudt.org/vocab/unit/FM"},{"@id":"http://qudt.org/vocab/unit/FT"},{"@id":"http://qudt.org/vocab/unit/FT_US"},{"@id":"http://qudt.org/vocab/unit/FUR"},{"@id":"http://qudt.org/vocab/unit/FemtoM"},{"@id":"http://qudt.org/vocab/unit/GAUGE_FR"},{"@id":"http://qudt.org/vocab/unit/GA_Charriere"},{"@id":"http://qudt.org/vocab/unit/HectoM"},{"@id":"http://qudt.org/vocab/unit/IN"},{"@id":"http://qudt.org/vocab/unit/KiloM"},{"@id":"http://qudt.org/vocab/unit/LY"},{"@id":"http://qudt.org/vocab/unit/M"},{"@id":"http://qudt.org/vocab/unit/MI"},{"@id":"http://qudt.org/vocab/unit/MI_N"},{"@id":"http://qudt.org/vocab/unit/MI_UK"},{"@id":"http://qudt.org/vocab/unit/MI_US"},{"@id":"http://qudt.org/vocab/unit/MicroIN"},{"@id":"http://qudt.org/vocab/unit/MicroM"},{"@id":"http://qudt.org/vocab/unit/MilLength"},{"@id":"http://qudt.org/vocab/unit/MilliIN"},{"@id":"http://qudt.org/vocab/unit/MilliM"},{"@id":"http://qudt.org/vocab/unit/NanoM"},{"@id":"http://qudt.org/vocab/unit/PARSEC"},{"@id":"http://qudt.org/vocab/unit/PCA"},{"@id":"http://qudt.org/vocab/unit/PT"},{"@id":"http://qudt.org/vocab/unit/PicoM"},{"@id":"http://qudt.org/vocab/unit/PlanckLength"},{"@id":"http://qudt.org/vocab/unit/ROD"},{"@id":"http://qudt.org/vocab/unit/YD"},{"@id":"http://qudt.org/vocab/unit/ZOLL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://encyclopedia2.thefreedictionary.com/migration+area","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$M = \\sqrt{M^2}$, where $M^2$ is the migration area.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Migration Length\" is the square root of the migration area.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"M","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98998318"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Migration Length","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}]},{"@id":"http://qudt.org/vocab/quantitykind/Mobility","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Mobility\" characterizes how quickly a particle can move through a metal or semiconductor, when pulled by\n    an electric field. The average drift speed imparted to a charged particle in a medium by an electric field, divided by the\n    electric field strength.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM2-PER-V-SEC"},{"@id":"http://qudt.org/vocab/unit/M2-PER-V-SEC"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ352#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Electron_mobility","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mu$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Mobility\" characterizes how quickly a particle can move through a metal or semiconductor, when\n    pulled by an electric field. The average drift speed imparted to a charged particle in a medium by an electric field, divided\n    by the electric field strength.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q900648"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Mobility","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Beweglichkeit","@language":"de"},{"@value":"Mobility","@language":"en"},{"@value":"mobilidade","@language":"pt"},{"@value":"mobilità","@language":"it"},{"@value":"mobilité","@language":"fr"},{"@value":"mobilność","@language":"pl"},{"@value":"movilidad","@language":"es"},{"@value":"قابلية التحرك","@language":"ar"},{"@value":"移動度","@language":"ja"},{"@value":"迁移率","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Mobilität","@language":"de"}]},{"@id":"http://qudt.org/vocab/quantitykind/MobilityRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"MobilityRatio\" describes permeability of a porous material to a given phase divided by the viscosity of\n    that phase.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$b = \\frac{\\mu_n}{\\mu_p}$, where $\\mu_n$ and $\\mu_p$ are mobilities for electrons and holes, respectively.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"MobilityRatio\" describes permeability of a porous material to a given phase divided by the\n    viscosity of that phase.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"b","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q106010255"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MobilityRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mobility Ratio","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ModulusOfAdmittance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Modulus Of Admittance\" is the absolute value of the quantity \"admittance\".","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DeciS"},{"@id":"http://qudt.org/vocab/unit/KiloS"},{"@id":"http://qudt.org/vocab/unit/MHO"},{"@id":"http://qudt.org/vocab/unit/MegaS"},{"@id":"http://qudt.org/vocab/unit/MicroMHO"},{"@id":"http://qudt.org/vocab/unit/MicroS"},{"@id":"http://qudt.org/vocab/unit/MilliS"},{"@id":"http://qudt.org/vocab/unit/NanoS"},{"@id":"http://qudt.org/vocab/unit/PicoS"},{"@id":"http://qudt.org/vocab/unit/S"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E2L-2I0M-1H0T3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-12-51","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Absolute_value","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Admittance","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$Y = \\left | \\underline{Y} \\right |$, where $\\underline{Y}$ is admittance.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Modulus Of Admittance\" is the absolute value of the quantity \"admittance\".","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Admittance"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Y","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q79466359"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Admittance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Modulus of Admittance","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/Admittance"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Admittance"}]},{"@id":"http://qudt.org/vocab/quantitykind/ModulusOfElasticity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The Modulus of Elasticity is the mathematical description of an object or substance's tendency to be\n    deformed elastically (that is, non-permanently) when a force is applied to it.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DecaPA"},{"@id":"http://qudt.org/vocab/unit/GigaPA"},{"@id":"http://qudt.org/vocab/unit/HectoPA"},{"@id":"http://qudt.org/vocab/unit/KIP_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-M2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/KiloPA"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/MegaPA"},{"@id":"http://qudt.org/vocab/unit/MegaPSI"},{"@id":"http://qudt.org/vocab/unit/MicroPA"},{"@id":"http://qudt.org/vocab/unit/MilliPA"},{"@id":"http://qudt.org/vocab/unit/PA"},{"@id":"http://qudt.org/vocab/unit/PSI"},{"@id":"http://qudt.org/vocab/unit/PicoPA"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Elastic_modulus","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$E = \\frac{\\sigma}{\\varepsilon}$, where $\\sigma$ is the normal stress and $\\varepsilon$ is the linear strain.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The Modulus of Elasticity is the mathematical description of an object or substance's tendency to\n    be deformed elastically (that is, non-permanently) when a force is applied to it.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"E","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ModulusOfElasticity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Modulus of Elasticity","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/ModulusOfImpedance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Modulus Of Impedance} is the absolute value of the quantity $\\textit{impedance}$. Apparent impedance is\n    defined more generally as  the quotient of rms voltage and rms electric current; it is often denoted by $Z$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/OHM"},{"@id":"http://qudt.org/vocab/unit/PlanckImpedance"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-2L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Absolute_value","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Electrical_impedance","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$Z = \\left | \\underline{Z} \\right |$, where $\\underline{Z}$ is impedance.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Impedance"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Z","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q25457909"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Impedance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Modulus of Impedance","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/Impedance"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Impedance"}]},{"@id":"http://qudt.org/vocab/quantitykind/ModulusOfLinearSubgradeReaction","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Modulus of Linear Subgrade Reaction is a measure for modulus of linear subgrade reaction, which expresses\n    the elastic bedding of a linear structural element per length, such as for a beam. It is typically measured in N/m^2\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/N-PER-M2"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-IN2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://www.lusas.com/user_area/documentation/1004_Winkler_spring_models.pdf","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Modulus of Linear Subgrade Reaction is a measure for modulus of linear subgrade reaction, which\n    expresses the elastic bedding of a linear structural element per length, such as for a beam. It is typically measured in N/m^2\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ModulusOfLinearSubgradeReaction","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Modulus of Linear Subgrade Reaction","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/ModulusOfRotationalSubgradeReaction","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Modulus of Rotational Subgrade Reaction is a measure for modulus of rotational subgrade reaction, which\n    expresses the rotational elastic bending of a linear structural element per length, such as for a beam. It is typically\n    measured in Nm/(m*rad).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloN-M-PER-DEG-M"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-DEG-M"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-M-RAD"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://standards.buildingsmart.org/IFC/DEV/IFC4_2/FINAL/HTML/schema/ifcstructuralloadresource/lexical/ifcmodulusofrotationalsubgradereactionselect.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Modulus of Rotational Subgrade Reaction is a measure for modulus of rotational subgrade reaction,\n    which expresses the rotational elastic bending of a linear structural element per length, such as for a beam. It is typically\n    measured in Nm/(m*rad).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ModulusOfRotationalSubgradeReaction","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Modulus of Rotational Subgrade Reaction","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ModulusOfSubgradeReaction","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Modulus of Subgrade Reaction is a geotechnical measure describing interaction between foundation\n    structures and the soil. May also be known as bedding measure. Usually measured in N/m3.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloN-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MegaN-PER-M3"},{"@id":"http://qudt.org/vocab/unit/N-PER-M3"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://standards.buildingsmart.org/IFC/DEV/IFC4_2/FINAL/HTML/schema/ifcstructuralloadresource/lexical/ifcmodulusofsubgradereactionselect.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Modulus of Subgrade Reaction is a geotechnical measure describing interaction between foundation\n    structures and the soil. May also be known as bedding measure. Usually measured in N/m3.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ModulusOfSubgradeReaction","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Modulus of Subgrade Reaction","@language":"en