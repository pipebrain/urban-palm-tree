ubject to temperature. Originally used in Wien's Law to\n    describe phenomena related to filaments. One use today is to express how a current generator derates with temperature.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$A/degC$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H-1T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-460"},{"@id":"_:n3-461"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPerTemperature"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://books.google.com/books?id=zkErAAAAYAAJ&pg=PA60&lpg=PA60&dq=ampere+per+degree","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://web.mit.edu/course/21/21.guide/use-tab.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"A/°C","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"A.Cel-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPerTemperature"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Amper na Stopień Celsjusza","@language":"pl"},{"@value":"Amper na Stopinja Celzija","@language":"sl"},{"@value":"Amper pe Grad Celsius",