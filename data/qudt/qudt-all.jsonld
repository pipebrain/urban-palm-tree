udt.org/vocab/quantitykind/WaterVapourDiffusionCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/WaterVapourPermeability"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Common unit for the Water vapour diffusion coefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"kg/(Pa·s·m)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"kg.Pa-1.s-1.m-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/VapourPermeability"},{"@id":"http://qudt.org/vocab/quantitykind/WaterVapourDiffusionCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/WaterVapourPermeability"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Chiliogramma per Pascalium Secundum Metrum","@language":"la"},{"@value":"Chilogrammo per Pascal Secondo Metro","@language":"it"},{"@value":"Kilogram na Pascal Sekunda Meter","@language":"sl"},{"@value":"Kilogram na Pascal Sekunda Metr","@language":"cs"},{"@value":"Kilogram na Paskal Sekunda Metr","@language":"pl"},{"@value":"Kilogram pe Pascal Secundă Metru","@language":"ro"},{"@value":"Kilogram per Pascal Saat Meter","@language":"ms"},{"@value":"Kilogram per Pascal Saniye Metre","@language":"tr"},{"@value":"Kilogram per Pascal Second Meter","@language":"en-us"},{"@value":"Kilogram per Pascal Second Metre","@language":"en"},{"@value":"Kilogram per Pascal Second Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Kilogramm pro Pascal Sekunde Meter","@language":"de"},{"@value":"Kilogramme par Pascal Seconde Mètre","@language":"fr"},{"@value":"Kilogramo por Pascal Segundo Metro","@language":"es"},{"@value":"Quilograma por Pascal Segundo Metro","@language":"pt"},{"@value":"Χιλιόγραμμο ανά Πασκάλ Δευτερόλεπτο Μέτρο","@language":"el"},{"@value":"Килограм на Паскал Секунда Метър","@language":"bg"},{"@value":"Килограмм на Паскаль Секунда Метр","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-SEC","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Kilogram Per Second (kg/s) is a unit in the category of Mass flow rate. It is also known as\n    kilogram/second, kilograms per second. This unit is commonly used in the SI unit system. Kilogram Per Second (kg/s) has a\n    dimension of $MT^{-1}$ where $M$ is mass, and $T$ is time. This unit is the standard SI unit in this category.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$kg/s$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2183"},{"@id":"_:n3-2184"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MassFlowRate"},{"@id":"http://qudt.org/vocab/quantitykind/MassPerTime"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/SEC-PER-KiloGM"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@v