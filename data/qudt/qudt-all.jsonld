 quantitykind:FissionFuelUtilizationFactor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Fission Fuel Utilization Factor","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}]},{"@id":"http://qudt.org/vocab/quantitykind/FissionMultiplicationFactor","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The number of fission neutrons produced per absorption in the fuel.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The number of fission neutrons produced per absorption in the fuel.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:FissionMultiplicationFactor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Fission Multiplication Factor","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}]},{"@id":"http://qudt.org/vocab/quantitykind/FlashPoint","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A temperature that is the lowest one at which the vapours of a volatile material will ignite if exposed\n    to an ignition source.  It is frequently used to characterize fire hazards and distinguish different flammable fuels.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_C"},{"@id":"http://qudt.org/vocab/unit/DEG_F"},{"@id":"http://qudt.org/vocab/unit/DEG_R"},{"@id":"http://qudt.org/vocab/unit/DecaK"},{"@id":"http://qudt.org/vocab/unit/K"},{"@id":"http://qudt.org/vocab/unit/MegaK"},{"@id":"http://qudt.org/vocab/unit/MilliDEG_C"},{"@id":"http://qudt.org/vocab/unit/MilliK"},{"@id":"http://qudt.org/vocab/unit/PlanckTemperature"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A temperature that is the lowest one at which the vapours of a volatile material will ignite if\n    exposed to an ignition source.  It is frequently used to characterize fire hazards and distinguish different flammable fuels.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:FlashPoint","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Flash Point Temperature","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/FlightPathAngle","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Flight path angle is defined in two different ways. To the aerodynamicist, it is the angle between the\n    flight path vector (where the airplane is going) and the local atmosphere. To the flight crew, it is normally known as the\n    angle between the flight path vector and the horizon, also known as the climb (or descent) angle.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ARCMIN"},{"@id":"http://qudt.org/vocab/unit/ARCSEC"},{"@id":"http://qudt.org/vocab/unit/DEG"},{"@id":"http://qudt.org/vocab/unit/GON"},{"@id":"http://qudt.org/vocab/unit/GRAD"},{"@id":"http://qudt.org/vocab/unit/MIL_Angle"},{"@id":"http://qudt.org/vocab/unit/MIN_Angle"},{"@id":"http://qudt.org/vocab/unit/MicroRAD"},{"@id":"http://qudt.org/vocab/unit/MilliARCSEC"},{"@id":"http://qudt.org/vocab/unit/MilliRAD"},{"@id":"http://qudt.org/vocab/unit/RAD"},{"@id":"http://qudt.org/vocab/unit/REV"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\gamma$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Flight path angle is defined in two different ways. To the aerodynamicist, it is the angle between\n    the flight path vector (where the airplane is going) and the local atmosphere. To the flight crew, it is normally known as the\n    angle between the flight path vector and the horizon, also known as the climb (or descent) angle.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Angle","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:PlaneAngle","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Flight Path Angle","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}]},{"@id":"http://qudt.org/vocab/quantitykind/FloatingPointCalculationCapability","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FLOPS"},{"@id":"http://qudt.org/vocab/unit/GigaFLOPS"},{"@id":"http://qudt.org/vocab/unit/MegaFLOPS"},{"@id":"http://qudt.org/vocab/unit/PetaFLOPS"},{"@id":"http://qudt.org/vocab/unit/TeraFLOPS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD363","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD363","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:FloatingPointCalculationCapability","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Floating Point Calculation Capability","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Fluidity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"fluidity of a material as complement of the dynamic viscosity","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PERCENT-FT2-PER-LB_F-SEC"},{"@id":"http://qudt.org/vocab/unit/PERCENT-IN2-PER-LB_F-SEC"},{"@id":"http://qudt.org/vocab/unit/RHE"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ447#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M-1H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD264","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD264","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Fließvermögen eines Stoffes als Kehrwert der dynamischen Viskosität","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Fluidity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Fluidity","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/Flux","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Flux describes any effect that appears to pass or travel (whether it actually moves or not) through a\n    surface or substance. [Wikipedia]\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MicroM-PER-L-DAY"},{"@id":"http://qudt.org/vocab/unit/PER-M2-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Flux","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Flux describes any effect that appears to pass or travel (whether it actually moves or not) through\n    a surface or substance. [Wikipedia]\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Flux","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Flux","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Force","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Force\" is an influence that causes mass to accelerate. It may be experienced as a lift, a push, or a\n    pull. Force is defined by Newton's Second Law as $F = m \\times a $, where $F$ is force, $m$ is mass and $a$ is acceleration.\n    Net force is mathematically equal to the time rate of change of the momentum of the body on which it acts. Since momentum is a\n    vector quantity (has both a magnitude and direction), force also is a vector quantity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiN"},{"@id":"http://qudt.org/vocab/unit/DYN"},{"@id":"http://qudt.org/vocab/unit/DeciN"},{"@id":"http://qudt.org/vocab/unit/GM_F"},{"@id":"http://qudt.org/vocab/unit/GigaN"},{"@id":"http://qudt.org/vocab/unit/KIP_F"},{"@id":"http://qudt.org/vocab/unit/KiloGM-M-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F"},{"@id":"http://qudt.org/vocab/unit/KiloN"},{"@id":"http://qudt.org/vocab/unit/KiloPOND"},{"@id":"http://qudt.org/vocab/unit/LB_F"},{"@id":"http://qudt.org/vocab/unit/MegaLB_F"},{"@id":"http://qudt.org/vocab/unit/MegaN"},{"@id":"http://qudt.org/vocab/unit/MicroN"},{"@id":"http://qudt.org/vocab/unit/MilliN"},{"@id":"http://qudt.org/vocab/unit/N"},{"@id":"http://qudt.org/vocab/unit/NanoN"},{"@id":"http://qudt.org/vocab/unit/OZ_F"},{"@id":"http://qudt.org/vocab/unit/PDL"},{"@id":"http://qudt.org/vocab/unit/POND"},{"@id":"http://qudt.org/vocab/unit/PlanckForce"},{"@id":"http://qudt.org/vocab/unit/TON_F_US"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Force","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ212#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD054","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD054","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Force","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$F = \\frac{dp}{dt}$, where $F$ is the resultant force acting on a body, $p$ is momentum of a body, and $t$ is time.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/FORC"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"F","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q11402"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Force","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Daya","@language":"ms"},{"@value":"Force","@language":"en"},{"@value":"Kraft","@language":"de"},{"@value":"Síla","@language":"cs"},{"@value":"erő","@language":"hu"},{"@value":"force","@language":"fr"},{"@value":"forza","@language":"it"},{"@value":"força","@language":"pt"},{"@value":"forță","@language":"ro"},{"@value":"fuerza","@language":"es"},{"@value":"kuvvet","@language":"tr"},{"@value":"sila","@language":"sl"},{"@value":"siła","@language":"pl"},{"@value":"vis","@language":"la"},{"@value":"Δύναμη","@language":"el"},{"@value":"Сила","@language":"ru"},{"@value":"сила","@language":"bg"},{"@value":"כוח","@language":"he"},{"@value":"نیرو","@language":"fa"},{"@value":"وحدة القوة في نظام متر كيلوغرام ثانية","@language":"ar"},{"@value":"बल","@language":"hi"},{"@value":"力","@language":"ja"},{"@value":"力","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"भार","@language":"hi"}]},{"@id":"http://qudt.org/vocab/quantitykind/ForceConstant","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The force constant of an electromechanical transducer such as a linear motor or voice coil: the quotient\n    of the force produced and the current through the device (F = k·I), expressed in newtons per ampere. Equal to the product of\n    the magnetic flux density and the effective conductor length (k = B·l), and numerically equal to the back-EMF constant in\n    V·s/m. Not to be confused with the spring constant of mechanics (force per displacement, N/m); for that quantity see\n    quantitykind:ForcePerLength.\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/N-PER-A"},{"@id":"http://qudt.org/vocab/unit/T-M"},{"@id":"http://qudt.org/vocab/unit/V-SEC-PER-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD055","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD055","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxPerLength"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticFluxPerLength","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Force Constant","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxPerLength"}]},{"@id":"http://qudt.org/vocab/quantitykind/ForceMagnitude","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The 'magnitude' of a force is its 'size' or 'strength', regardless of the direction in which it acts.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiN"},{"@id":"http://qudt.org/vocab/unit/DYN"},{"@id":"http://qudt.org/vocab/unit/DeciN"},{"@id":"http://qudt.org/vocab/unit/GM_F"},{"@id":"http://qudt.org/vocab/unit/GigaN"},{"@id":"http://qudt.org/vocab/unit/KIP_F"},{"@id":"http://qudt.org/vocab/unit/KiloGM-M-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F"},{"@id":"http://qudt.org/vocab/unit/KiloN"},{"@id":"http://qudt.org/vocab/unit/KiloPOND"},{"@id":"http://qudt.org/vocab/unit/LB_F"},{"@id":"http://qudt.org/vocab/unit/MegaLB_F"},{"@id":"http://qudt.org/vocab/unit/MegaN"},{"@id":"http://qudt.org/vocab/unit/MicroN"},{"@id":"http://qudt.org/vocab/unit/MilliN"},{"@id":"http://qudt.org/vocab/unit/N"},{"@id":"http://qudt.org/vocab/unit/NanoN"},{"@id":"http://qudt.org/vocab/unit/OZ_F"},{"@id":"http://qudt.org/vocab/unit/PDL"},{"@id":"http://qudt.org/vocab/unit/POND"},{"@id":"http://qudt.org/vocab/unit/PlanckForce"},{"@id":"http://qudt.org/vocab/unit/TON_F_US"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://wiki.answers.com/Q/What_is_magnitude_of_force","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The 'magnitude' of a force is its 'size' or 'strength', regardless of the direction in which it\n    acts.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Force"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"U","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Force","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Force Magnitude","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Force"}]},{"@id":"http://qudt.org/vocab/quantitykind/ForcePerAngle","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/N-PER-RAD"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ForcePerAngle","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id"