iveReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA758","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m³/K","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m3.K-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"G29","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/TemperatureRelatedVolume"},{"@id":"http://qudt.org/vocab/quantitykind/VolumeThermalExpansion"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Cubic Meter per Kelvin","@language":"en-us"},{"@value":"Cubic Metre per Kelvin","@language":"en"},{"@value":"Cubic Metre per Kelvin","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Kubikmeter pro Kelvin","@language":"de"},{"@value":"Kubični Meter na Kelvin","@language":"sl"},{"@value":"Meter Kubik per Kelvin","@language":"ms"},{"@value":"Metr Krychlový na Kelvin","@language":"cs"},{"@value":"Metr Sześcienny na Kelwin","@language":"pl"},{"@value":"Metreküp per Kelvin","@language":"tr"},{"@value":"Metro Cubo per Kelvin","@language":"it"},{"@value":"Metro Cúbico por Kelvin","@language":"es"},{"@value":"Metro Cúbico por Kelvin","@language":"pt"},{"@value":"Metru Cub pe Kelvin","@language":"ro"},{"@value":"Metrum Cubicum per Kelvin","@language":"la"},{"@value":"Mètre Cube par Kelvin","@language":"fr"},{"@value":"Κυβικό Μέτρο ανά Κέλβιν","@language":"el"},{"@value":"Кубичен Метър на Келвин","@language":"bg"},{"@value":"Кубический Метр на Кельвин","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/M3-PER-KiloGM","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Cubic Meter Per Kilogram (m3/kg) is a unit in the category of Specific volume. It is also known as cubic\n    meters per kilogram, cubic metre per kilogram, cubic metres per kilogram, cubic meter/kilogram, cubic metre/kilogram. This\n    unit is commonly used in the SI unit system. Cubic Meter Per Kilogram (m3/kg) has a dimension of M-1L3 where $M$ is mass, and\n    $L$ is length. This unit is the standard SI unit in this category.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$m^{3}/kg$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-3006"},{"@id":"_:n3-3007"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SoilAdsorptionCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificVolume"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M3"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA766","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA766","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m³/kg",