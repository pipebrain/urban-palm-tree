a/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Density"},{"@id":"http://qudt.org/vocab/quantitykind/MassDensity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA680","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA680","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"unit of the mass avoirdupois pound according to the avoirdupois system divided by the unit gallon\n    (US, liq.) according to the Anglo-American system of units\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"lbm/gal{US}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[lb_av].[gal_us]-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"GE","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Density"},{"@id":"http://qudt.org/vocab/quantitykind/MassDensity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pound Mass per Us Gallon","@language":"en"},{"@value":"Pound Mass per Us Gallon","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/LB-PER-HR","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Pound per hour is a mass flow unit. It is abbreviated as PPH or more conventionally as lb/h. Fuel flow\n    for engines is usually expressed using this unit, it is particularly useful when dealing with gases or liquids as volume flow\n    varies more with temperature and pressure. $1 lb/h = 0.4535927 kg/h = 126.00 mg/s$.  Minimum fuel intake on a jumbojet can be\n    as low as 150 lb/h when idling, however this is not enough to sustain flight.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0001259978805555555555555555555555556","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.259978805555555555555555555555556E-4","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Pound_per_hour","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$PPH$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2676"},{"@id":"_:n3-2677"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MassFlowRate"},{"@id":"http://qudt.org/vocab/quantitykind/MassPerTime"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA682","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA682","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Pound_per_hour?oldid=328571072","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"lbm/h","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qu