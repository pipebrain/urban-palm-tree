#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"F80","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Horsepower (water)","@language":"en"},{"@value":"Horsepower (water)","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/HP_Metric","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"unit of the mechanical power according to the Anglo-American system of units","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"735.49875","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"7.3549875E2","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA534","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA534","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"unit of the mechanical power according to the Anglo-American system of units","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/J-PER-SEC"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"HP{metric}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"HJ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q160857"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Horsepower (metric)","@language":"en"},{"@value":"Horsepower (metric)","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/HR","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The hour (common symbol: h or h) is a unit of measurement of time. In modern usage, an hour comprises 60\n    minutes, or 3,600 seconds. It is approximately 1/24 of a mean solar day. An hour in the Universal Coordinated Time (UTC) time\n    standard can include a negative or positive leap second, and may therefore have a duration of 3,599 or 3,601 seconds for\n    adjustment purposes. Although it is not a standard defined by the International System of Units, the hour is a unit accepted\n    for use with SI, represented by the symbol h.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/SI"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"3600.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"3.6E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Hour","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/HalfLife"},{"@id":"http://qudt.org/vocab/quantitykind/MeanLifetime"},{"@id":"http://qudt.org/vocab/quantitykind/Time"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA525","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA525","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Hour?oldid=495040268","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/hour"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/SEC"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/SI/units/hour"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"h","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"h","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/udunitsCode":[{"@value":"h","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"HUR","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/HalfLife"},{"@id":"http://qudt.org/vocab/quantitykind/MeanLifetime"},{"@id":"http://qudt.org/vocab/quantitykind/Time"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q25235"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Hour","@language":"en"},{"@value":"Hour","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/HR-FT2","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\"Hour Square Foot\" is an Imperial unit for  'Area Time' expressed as $hr-ft^{2}$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"334.450944","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"3.34450944E2","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$h-ft^{2}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1740"},{"@id":"_:n3-1741"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AreaTime"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"h·ft²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"h.[ft_i]2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AreaTime"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Hour Square Foot","@language":"en"},{"@value":"Hour Square Foot","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/HR-PER-FT2","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"quotient of the unit of the mass avoirdupois pound according to the avoirdupois system of units per power\n    of the unit foot according to the Anglo-American and the Imperial system of units with the exponent 3 and unit of the mass\n    avoirdupois pound according to the avoirdupois system of units per product of foot according to the Anglo-American and the\n    Imperial system of units and unit of time hour\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/categorizedByQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Unknown"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"38750.07750015500031000062000124","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"3.875007750015500031000062000124E4","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1742"},{"@id":"_:n3-1743"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Unknown"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/FT2-PER-HR"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD842","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAD842","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"h/ft²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"h.[ft_i]-2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Hour per Square Foot","@language":"en"},{"@value":"Hour per Square Foot","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/HR-PER-NUM","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"3600.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"3.6E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1744"},{"@id":"_:n3-1745"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/TimePerCount"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/NUM-PER-HR"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"h/#","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"h.{#}-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/TimePerCount"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Hour per Number","@language":"en"},{"@value":"Hour per Number","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/HR-PER-YR","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Hours per year, used for the time an industrial facility or installation is active during one year\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0001140771161305042208532968286561716","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.140771161305042208532968286561716E-4","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1746"},{"@id":"_:n3-1747"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/TimeRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"hours (of activity) per year","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"h/a","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"h.a-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/TimeRatio"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Hour per Year","@language":"en"},{"@value":"Hour per Year","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Uur per Jaar","@language":"nl"}]},{"@id":"http://qudt.org/vocab/unit/HR_Sidereal","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Sidereal time is a time-keeping system astronomers use to keep track of the direction to point their\n    telescopes to view a given star in the night sky. A mean sidereal day is about 23 h 56 m 4.1 s in length. However, due to\n    variations in the rotation rate of the Earth, the rate of an ideal sidereal clock deviates from any simple multiple of a civil\n    clock. In practice, the difference is kept track of by the difference UTC-UT1, which is measured by radio telescopes and kept\n    on file and available to the public at the IERS and at the United States Naval Observatory. A Sidereal Hour is $1/24^{th}$ of\n    a Sidereal Day. A mean sidereal day is 23 hours, 56 minutes, 4.0916 seconds (23.9344699 hours or 0.99726958 mean solar days),\n    the time it takes Earth to make one rotation relative to the vernal equinox. (Due to nutation, an actual sidereal day is not\n    quite so constant.) The vernal equinox itself precesses slowly westward relative to the fixed stars, completing one revolution\n    in about 26,000 years, so the misnamed sidereal day (\"sidereal\" is derived from the Latin sidus meaning \"star\") is 0.0084\n    seconds shorter than Earth's period of rotation relative to the fixed stars.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/SI"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"3590.17","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"3.59017E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Time"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Sidereal_time","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/SEC"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"h{sidereal}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Time"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q101435269"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Sidereal Hour","@language":"en"},{"@value":"Sidereal Hour","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/HUNDRED","@type":["http://qudt.org/schema/qudt/CountingUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Counting unit for a count of one hundred","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/ASU"},{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-ESU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/PLANCK"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/categorizedByQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Count"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"100.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E2","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Count"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/ONE"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"100","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q5760634"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Hundred","@language":"en"},{"@value":"Hundred","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/HZ","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Hertz}$ (symbol $Hz$) is the SI unit of frequency defined as the number of cycles per second of\n    a periodic phenomenon. One of its most common uses is the description of the sine wave, particularly those used in radio and\n    audio applications, such as the frequency of musical tones. The word $\\bf{hertz}$ is named for Heinrich Rudolf Hertz, who was\n    the first to conclusively prove the existence of electromagnetic waves.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/SI"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Hertz","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/unit/CYC-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PER-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1748"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Frequency"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA170","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA170","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/hertz"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/SI/units/hertz"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Hz","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Hz","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/udunitsCode":[{"@value":"Hz","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"HTZ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Frequency"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q39369"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Herc","@language":"pl"},{"@value":"Hercio","@language":"es"},{"@value":"Hertz","@language":"cs"},{"@value":"Hertz","@language":"de"},{"@value":"Hertz","@language":"en"},{"@value":"Hertz","@language":"fr"},{"@value":"Hertz","@language":"hu"},{"@value":"Hertz","@language":"it"},{"@value":"Hertz","@language":"ms"},{"@value":"Hertz","@language":"pt"},{"@value":"Hertz","@language":"ro"},{"@value":"Hertz","@language":"sl"},{"@value":"Hertz","@language":"tr"},{"@value":"Hertz","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Hertzium","@language":"la"},{"@value":"Χερτζ","@language":"el"},{"@value":"Герц","@language":"ru"},{"@value":"Херц","@language":"bg"},{"@value":"הרץ","@language":"he"},{"@value":"هرتز","@language":"ar"},{"@value":"هرتز","@language":"fa"},{"@value":"हर्ट्ज","@language":"hi"},{"@value":"ヘルツ","@language":"ja"},{"@value":"赫兹","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/HZ-M","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Hertz Metre}$ is the product of the SI derived unit hertz and the SI base unit metre.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1749"},{"@id":"_:n3-1750"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Speed"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA171","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA171","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"product of the SI derived unit hertz and the SI base unit metre","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Hz·m","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Hz.m","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"H34","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Speed"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Herc Metr","@language":"pl"},{"@value":"Hercio Metro","@language":"es"},{"@value":"Hertz Meter","@language":"de"},{"@value":"Hertz Meter","@language":"en-us"},{"@value":"Hertz Meter","@language":"ms"},{"@value":"Hertz Meter","@language":"sl"},{"@value":"Hertz Metr","@language":"cs"},{"@value":"Hertz Metre","@language":"en"},{"@value":"Hertz Metre","@language":"tr"},{"@value":"Hertz Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Hertz Metro","@language":"it"},{"@value":"Hertz Metro","@language":"pt"},{"@value":"Hertz Metru","@language":"ro"},{"@value":"Hertz Mètre","@language":"fr"},{"@value":"Hertzium Metrum","@language":"la"},{"@value":"Χερτζ Μέτρο","@language":"el"},{"@value":"Герц Метр","@language":"ru"},{"@value":"Херц Метър","@language":"bg"}]},{"@id":"http://qudt.org/vocab/unit/HZ-PER-K","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\n  $\\textit{Hertz per Kelvin}$ is a unit for 'Inverse Time Temperature' expressed as $Hz K^{-1}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$Hz K^{-1}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H-1T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1751"},{"@id":"_:n3-1752"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InverseTimeTemperature"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Hz/K","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Hz.K-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InverseTimeTemperature"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Herc na Kelwin","@language":"pl"},{"@value":"Hercio por Kelvin","@language":"es"},{"@value":"Hertz na Kelvin","@language":"cs"},{"@value":"Hertz na Kelvin","@language":"sl"},{"@value":"Hertz par Kelvin","@language":"fr"},{"@value":"Hertz pe Kelvin","@language":"ro"},{"@value":"Hertz per Kelvin","@language":"en"},{"@value":"Hertz per Kelvin","@language":"it"},{"@value":"Hertz per Kelvin","@language":"ms"},{"@value":"Hertz per Kelvin","@language":"tr"},{"@value":"Hertz per Kelvin","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Hertz por Kelvin","@language":"pt"},{"@value":"Hertz pro Kelvin","@language":"de"},{"@value":"Hertzium per Kelvin","@language":"la"},{"@value":"Χερτζ ανά Κέλβιν","@language":"el"},{"@value":"Герц на Кельвин","@language":"ru"},{"@value":"Херц на Келвин","@language":"bg"},{"@value":"هرتز بر کلوین","@language":"fa"},{"@value":"هرتز لكل كلفن","@language":"ar"},{"@value":"हर्ट्ज प्रति कैल्विन","@language":"hi"},{"@value":"ヘルツ毎立方メートル","@language":"ja"}]},{"@id":"http://qudt.org/vocab/unit/HZ-PER-SEC","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Hertz per Second}$ is a unit for 'Rate of Change of Frequency' expressed as $Hz s^{-1}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$Hz s^{-1}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1753"},{"@id":"_:n3-1754"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/RateOfChangeOfFrequency"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Hz/s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Hz.s-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/RateOfChangeOfFrequency"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Herc na Sekunda","@language":"pl"},{"@value":"Hercio por Segundo","@language":"es"},{"@value":"Hertz na Sekunda","@language":"cs"},{"@value":"Hertz na Sekunda","@language":"sl"},{"@value":"Hertz par Seconde","@language":"fr"},{"@value":"Hertz pe Secundă","@language":"ro"},{"@value":"Hertz per Saat","@language":"ms"},{"@value":"Hertz per Saniye","@language":"tr"},{"@value":"Hertz per Second","@language":"en"},{"@value":"Hertz per Second","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Hertz per Secondo","@language":"it"},{"@value":"Hertz por Segundo","@language":"pt"},{"@value":"Hertz pro Sekunde","@language":"de"},{"@value":"Hertzium per Secundum","@language":"la"},{"@value":"Χερτζ ανά Δευτερόλεπτο","@language":"el"},{"@value":"Герц на Секунда","@language":"ru"},{"@value":"Херц на Секунда","@language":"bg"}]},{"@id":"http://qudt.org/vocab/unit/HZ-PER-T","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\"Hertz per Tesla\" is a unit for  'Electric Charge Per Mass' expressed as $Hz T^{-1}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$Hz T^{-1}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M-1H0T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1755"},{"@id":"_:n3-1756"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerMass"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Hz/T","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Hz.T-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerMass"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q21095810"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Herc na Tesla","@language":"pl"},{"@value":"Hercio por Tesla","@language":"es"},{"@value":"Hertz na Tesla","@language":"cs"},{"@value":"Hertz na Tesla","@language":"sl"},{"@value":"Hertz par Tesla","@language":"fr"},{"@value":"Hertz pe Tesla","@language":"ro"},{"@value":"Hertz per Tesla","@language":"en"},{"@value":"Hertz per Tesla","@language":"it"},{"@value":"Hertz per Tesla","@language":"ms"},{"@value":"Hertz per Tesla","@language":"tr"},{"@value":"Hertz per Tesla","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Hertz por Tesla","@language":"pt"},{"@value":"Hertz pro Tesla","@language":"de"},{"@value":"Hertzium per Tesla","@language":"la"},{"@value":"Χερτζ ανά Τέσλα","@language":"el"},{"@value":"Герц на Тесла","@language":"ru"},{"@value":"Херц на Тесла","@language":"bg"}]},{"@id":"http://qudt.org/vocab/unit/HZ-PER-V","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"In the Hertz per Volt standard the frequency of the note is directly related to the voltage. A pitch of a\n    note goes up one octave when its frequency doubles, meaning that the voltage will have to double for every octave rise.\n    Depending on the footage (octave) selected, nominally one volt gives 1000Hz, two volts 2000Hz and so on. In terms of notes,\n    bottom C would be 0.25 volts, the next C up would be 0.5 volts, then 1V, 2V, 4V, 8V for the following octaves. This system was\n    used mainly by Yamaha and Korg.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$Hz V^{-1}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-2I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1757"},{"@id":"_:n3-1758"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InverseMagneticFlux"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Hz/V","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Hz.V-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InverseMagneticFlux"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q101195156"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Herc na Wolt","@language":"pl"},{"@value":"Hercio por Voltio","@language":"es"},{"@value":"Hertz na Volt","@language":"cs"},{"@value":"Hertz na Volt","@language":"sl"},{"@value":"Hertz par Volt","@language":"fr"},{"@value":"Hertz pe Volt","@language":"ro"},{"@value":"Hertz per Volt","@language":"en"},{"@value":"Hertz per Volt","@language":"it"},{"@value":"Hertz per Volt","@language":"ms"},{"@value":"Hertz per Volt","@language":"tr"},{"@value":"Hertz per Volt","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Hertz por Volt","@language":"pt"},{"@value":"Hertz pro Volt","@language":"de"},{"@value":"Hertzium per Voltium","@language":"la"},{"@value":"Χερτζ ανά Βολτ","@language":"el"},{"@value":"Герц на Вольт","@language":"ru"},{"@value":"Херц на Волт","@language":"bg"}]},{"@id":"http://qudt.org/vocab/unit/H_Ab","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Abhenry is the centimeter-gram-second electromagnetic unit of inductance, equal to one billionth of a\n    henry.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.000000001","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E-9","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Abhenry","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/derivedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/CGS-EMU"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/unit/NanoH"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-2L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Inductance"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Abhenry?oldid=477198643","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/abhenry"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/H"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"abH","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"nH","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Inductance"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q4667368"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Abhenry","@language":"en"},{"@value":"Abhenry","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/H_Stat","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\text{Stathenry (statH)}$ is a unit in the category of Electric inductance.\n  It is also known as $tathenries$.\n  This unit is commonly used in the cgs unit system.\n  $Stathenry$ has a dimension of $ML^2T^{-2}I^{-2}$ where $M$ is mass, $L$ is length, $T$ is time, and $I$ is electric current.\n  It can be converted to the corresponding standard SI unit H by multiplying its value by a factor of $8.987552 \\times 10^{11}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-ESU"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"898755179000.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"8.98755179E11","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/derivedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/CGS-ESU"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-2L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Inductance"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.efunda.com/glossary/units/units--electric_inductance--stathenry.cfm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/stathenry"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/H"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"statH","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Inductance"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q12955440"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Stathenry","@language":"en"},{"@value":"Stathenry","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/H_Stat-PER-CentiM","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The Stathenry per Centimeter is a unit of measure for the absolute permeability of free space.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-ESU"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"89875517900000.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"8.98755179E13","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/derivedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/CGS-ESU"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$stath-per-cm$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-2L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1759"},{"@id":"_:n3-1760"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectromagneticPermeability"},{"@id":"http://qudt.org/vocab/quantitykind/Permeability"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"statH/cm","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectromagneticPermeability"},{"@id":"http://qudt.org/vocab/quantitykind/Permeability"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Stathenry per Centimeter","@language":"en-us"},{"@value":"Stathenry per Centimetre","@language":"en"},{"@value":"Stathenry per Centimetre","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/HeartBeat","@type":["http://qudt.org/schema/qudt/ContextualUnit","http://qudt.org/schema/qudt/CountingUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A heart beat is a single contraction of the heart muscle,\n  which pumps blood through the circulatory system. The heart rate is the number of heart beats\n  per unit of time, typically measured in beats per minute (bpm). A normal resting\n  heart rate for adults ranges from 60 to 100 beats per minute.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/unit/BEAT"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/ASU"},{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-ESU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/PLANCK"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.8","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"heartbeat","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Heart Beat","@language":"en"},{"@value":"Heart Beat","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/unit/NUM"}]},{"@id":"http://qudt.org/vocab/unit/HectoBAR","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"100-fold of the unit bar","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"10000000.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E7","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"},{"@id":"http://qudt.org/vocab/quantitykind/VapourPressure"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB087","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB087","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"100-fold of the unit bar","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/prefix":[{"@id":"http://qudt.org/vocab/prefix/Hecto"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/BAR"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"hbar","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"hbar","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"HBA","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"},{"@id":"http://qudt.org/vocab/quantitykind/VapourPressure"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q106886632"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Hectobar","@language":"en"},{"@value":"Hectobar","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/HectoC","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\"HectoCoulomb\" is a unit for  'Electric Charge' expressed as $hC$.","@type":"http://qudt