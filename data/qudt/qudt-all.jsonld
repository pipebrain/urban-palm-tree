df-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Vatio por Metro Grado Celsius","@language":"es"},{"@value":"Wat na Metr Stopień Celsjusza","@language":"pl"},{"@value":"Watt na Meter Stopinja Celzija","@language":"sl"},{"@value":"Watt na Metr Stupně Celsia","@language":"cs"},{"@value":"Watt par Mètre Degré Celsius","@language":"fr"},{"@value":"Watt pe Metru Grad Celsius","@language":"ro"},{"@value":"Watt per Meter Darjah Celsius","@language":"ms"},{"@value":"Watt per Meter Degree Celsius","@language":"en-us"},{"@value":"Watt per Metre Celsius","@language":"tr"},{"@value":"Watt per Metre Degree Celsius","@language":"en"},{"@value":"Watt per Metre Degree Celsius","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Watt per Metro Grado Celsius","@language":"it"},{"@value":"Watt por Metro Grau Celsius","@language":"pt"},{"@value":"Watt pro Meter Grad Celsius","@language":"de"},{"@value":"Wattium per Metrum Gradus Celsii","@language":"la"},{"@value":"Βατ ανά Μέτρο Βαθμός Κελσίου","@language":"el"},{"@value":"Ват на Метър Градус Целзий","@language":"bg"},{"@value":"Ватт на Метр Градус Цельсия","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/W-PER-M-K","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$W-per-MK$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H-1T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-5222"},{"@id":"_:n3-5223"},{"@id":"_:n3-5224"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalConductivity"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/K-M-PER-W"},{"@id":"http://qudt.org/vocab/unit/M-K-PER-W"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA309","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA309","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Thermal_conductivity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$W \\cdot m^{-1} \\cdot K^{-1}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"W/(m·K)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"W.m-1.K-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"D53","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalConductivity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1463969"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Vatio por Metro Kelvin","@language":"es"},{"@value":"Wat na Metr Kelwin","@language":"pl"},{"@value":"Watt na Meter Kelvin","@language":"sl"},{"@value":"Watt na Metr Kelvin","@language":"cs"},{"@value":"Watt par Mètre Kelvin","@language":"fr"},{"@value":"Watt pe Metru Kelvin","@language":"ro"},{"@value":"Watt per Meter Kelvin","@language":"en-us"},{"@value":"Watt per Meter Kelvin","@language":"ms"},{"@value":"Watt per Metre Kelvin","@language":"en"},{"@value":"Watt per Metre Kelvin","@language":"tr"},{"@value":"Watt per Metre Kelvin","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Watt per Metro Kelvin","@language":"it"},{"@value":"Watt por Metro Kelvin","@language":"pt"},{"@value":"Watt pro Meter Kelvin","@language":"de"},{"@value":"Wattium per Metrum Kelvin","@language":"la"},{"@value":"Βατ ανά Μέτρο Κέλβιν","@language":"el"},{"@value":"Ват на Метър Келвин","@language":"bg"},{"@value":"Ватт на Метр Кельвин","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/W-PER-M2","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\"Watt per Square Meter} is a unit of irradiance defined as the power received per area. This is a unit in\n    the category of Energy flux. It is also known as watts per square meter, watt per square metre, watts per square metre,\n    watt/square meter, watt/square metre. This unit is commonly used in the SI unit system. Watt Per Square Meter ($W/m^2$) has a\n    dimension of $MT^{-3\"$ where $M$ is mass, and $T$ is time. This unit is the standard SI unit in this category.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$W/m^2$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-5225"},{"@id":"_:n3-5226"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/PowerPerArea"},{"@id":"http://qudt.org/vocab/quantitykind/PoyntingVector"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/M2-PER-W"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA310","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.efunda.com/glossary/units/units--energy_flux--watt_per_square_meter.cfm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA310","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"W/m²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"W.m-2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"D54","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/PowerPerArea"},{"@id":"http://qudt.org/vocab/quantitykind/PoyntingVector"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q3566737"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Vatio por Metro Cuadrado","@language":"es"},{"@value":"Wat na Metr Kwadratowy","@language":"pl"},{"@value":"Watt na Kvadratni Meter","@language":"sl"},{"@value":"Watt na Čtvereční Metr","@language":"cs"},{"@value":"Watt par Mètre Carré","@language":"fr"},{"@value":"Watt pe Metru Pătrat","@language":"ro"},{"@value":"Watt per Meter Persegi","@language":"ms"},{"@value":"Watt per Metrekare","@language":"tr"},{"@value":"Watt per Metro Quadrato","@language":"it"},{"@value":"Watt per Square Meter","@language":"en-us"},{"@value":"Watt per Square Metre","@language":"en"},{"@value":"Watt per Square Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Watt por Metro Quadrado","@language":"pt"},{"@value":"Watt pro Quadratmeter","@language":"de"},{"@value":"Wattium per Metrum Quadratum","@language":"la"},{"@value":"Βατ ανά Τετραγωνικό Μέτρο","@language":"el"},{"@value":"Ват на Квадратен Метър","@language":"bg"},{"@value":"Ватт на Квадратный Метр","@language":"ru"},{"@value":"وات بر مترمربع","@language":"fa"},{"@value":"واط في المتر المربع","@language":"ar"},{"@value":"वाट प्रति वर्ग मीटर","@language":"hi"},{"@value":"ワット毎平方メートル","@language":"ja"},{"@value":"瓦特每平方米","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/W-PER-M2-K","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The unit $\\textit{Watt Per Square Meter Kelvin }$ ($W m^{-2} K^{-1}$) is a unit in the category of\n    Thermal heat transfer coefficient. It is also known as $\\textit{watt/square meter-kelvin}$. This unit is commonly used in the\n    SI unit system. $\\textit{Watt Per Square Meter Kelvin }$ has a dimension of $MT^{-1}Q^{-1}$ where $M$ is mass, $T$ is time,\n    and $Q$ is temperature. This unit is the standard SI unit in this category.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$W/(m^{2}-K)$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H-1T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-5227"},{"@id":"_:n3-5228"},{"@id":"_:n3-5229"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/CoefficientOfHeatTransfer"},{"@id":"http://qudt.org/vocab/quantitykind/CombinedNonEvaporativeHeatTransferCoefficient"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/M2-K-PER-W"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA311","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA311","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"W/(m²·K)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"W.m-2.K-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"D55","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/CoefficientOfHeatTransfer"},{"@id":"http://qudt.org/vocab/quantitykind/CombinedNonEvaporativeHeatTransferCoefficient"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q3566738"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://ww