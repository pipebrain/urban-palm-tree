//qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"traditional unit for the ability of a material to allow the transition of the steam, defined at a\n    temperature of 0 °C as steam transmittance, where the mass of one grain steam penetrates an area of one foot squared at a\n    pressure from one inch mercury per hour\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"0.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/VapourPermeance"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB294","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB294","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"perm (0 °C)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"P91","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Perm (0 °C)","@language":"en"},{"@value":"Perm (0 °C)","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/PERM_Metric_23DEG_C","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"traditional unit for the ability of a material to allow the transition of the steam, defined at a\n    temperature of 23 °C as steam transmittance at which the mass of one grain of steam penetrates an area of one square foot at a\n    pressure of one inch mercury per hour\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"0.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/VapourPermeance"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB295","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB295","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"perm (23 °C)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"P92","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Perm (23 °C)","@language":"en"},{"@value":"Perm (23 °C)","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/PERM_US","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The rate of water vapor transmission through a specific thickness of a material—i.e., the permeability\n    divided by the thickness.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0000000000572135","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"5.72135E-11","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/VapourPermeance"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Perm_(unit)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"\\frac{grain}{hour \\cdot ft^2 \\cdot in\\,Hg}","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/SEC-PER-M"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"perm{US}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/VapourPermeance"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"U.s. Perm","@language":"en"},{"@value":"U.s. Perm","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/PFERDESTAERKE","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"obsolete, non-legal unit of the power in Germany relating to DIN 1301-3:1979","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"735.49875","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"7.3549875E2","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB438","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB438","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/W"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"PS","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"N12","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pferdestaerke","@language":"en"},{"@value":"Pferdestaerke","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/unit/HP_Metric"}]},{"@id":"http://qudt.org/vocab/unit/PFUND","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"outdated unit of the mass in Germany","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.5","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"5.0E-1","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB387","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB387","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/KiloGM"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"pfd","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"M86","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pfund","@language":"en"},{"@value":"Pfund","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/PH","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"In chemistry the unit $\\textit{pH}$, also referred to as $\\textit{acidity}$ or $\\textit{basicity}$, is\n    the negative logarithm (base 10) of the concentration of free protons (or hydronium ions). The definition of $pH$ in terms of\n    hydrogen ions in solution is:  $$\\text{pH}=-\\log_{10}(a_{H^+})\\equiv-\\log_{10}\\left(\\left[H^+\\right]\\right)$$  Where\n    $a_{H^+}$ is the equilibrium molar concentration of $H^+$ in the solution, the activity of the hydrogen ion in the solution.\n    $$$$ This definition is appropriate for concentrations equal to, or less than $1\\ mol/l$, where $aH+ \\equiv [H+]$, that is,\n    $1\\ mol/L\\ HCl$ has a $pH$ of zero. $$$$ To relate this to standard molality ($b^\\circ$), typically taken as $1 \\ mol/kg$,\n    consideration is given to the activity ($a_{H^+}$) of the hydrogen ions. $$$$ The activity can be expressed as:  $$a_{H^+} =\n    \\gamma_{H^+} \\times m_{H^+}$$  Where, $\\gamma_{H^+}$ is the activity coefficient, which adjusts the molality to account for\n    non-ideal behavior due to interactions between ions in the solution. $m_{H^+}$ is the molality of hydrogen ions in the\n    solution relative to the standard molality, expressed in $mol/kg$. $$$$ The expansion of $pH$ then becomes:  $$\\text{pH} =\n    -log_{10}\\left(m_{H+}\\times\\gamma_{H^+}\\right)$$  $$$$ This definition is relevant in more concentrated solutions or when\n    precise thermodynamic calculations are required. It reflects how the properties of the solution deviate from ideal behavior\n    and provides a more accurate understanding of the $pH$ under various conditions. $$$$ While $pH$ is a universally recognized\n    scale for expressing hydrogen ion activity, its appropriateness and accuracy can diminish under conditions of extremely high\n    ionic strength, non-aqueous environments, high temperatures, or very high or low $pH$ values. In such cases, alternative\n    measurement strategies might be required to obtain meaningful and accurate descriptions of acidity or basicity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/ASU"},{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-ESU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/PLANCK"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"0.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Acidity"},{"@id":"http://qudt.org/vocab/quantitykind/Basicity"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://iupac.org/wp-content/uploads/2019/05/IUPAC-GB3-2012-2ndPrinting-PDFsearchable.pdf","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"pH","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[pH]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Acidity"},{"@id":"http://qudt.org/vocab/quantitykind/Basicity"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Unsure about dimensionality of pH; conversion requires a log function not just a multiplier","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Acidity","@language":"en"},{"@value":"Acidity","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/PHON","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"psychoacoustical unit for the loudness level, to describe the emotionally sense of the sound level, with\n    which a human will understand an acoustic noise event as an hearing event\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SoundPressureLevel"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA937","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA937","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"phon","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"C69","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SoundPressureLevel"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Phon","@language":"en"},{"@value":"Phon","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/PHOT","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A phot (ph) is a photometric unit of illuminance, or luminous flux through an area. It is not an SI unit,\n    but rather is associated with the older centimetre gram second system of units.  Metric dimensions: $illuminance = luminous\n    intensity \\times solid angle / length$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"10000.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E4","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.or