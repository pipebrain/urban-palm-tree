eUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/IU-PER-MilliGM"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ350#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Mass_fraction_(chemistry)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$w_B = \\frac{m_B}{m}$, where $m_B$ is the mass of substance $B$ and $m$ is the total.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Mass Fraction\" is the fraction of one substance with mass to the mass of the total mixture .\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"w_B","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q899138"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassFraction","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Fraction","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/MassRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassFractionOfDryMatter","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Mass Fraction of Dry Matter\" is one of a number of $\\textit{Concentration}$ quantities defined by ISO\n    80000.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$w_d= 1 - w_{h2o}$, where $w_{h2o}$ is mass fraction of water.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Mass Fraction of Dry Matter\" is one of a number of Concentration quantities defined by ISO 80000.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"w_d","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q76379189"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassFractionOfDryMatter","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Fraction of Dry Matter","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/MassFractionOfWater"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassFractionOfWater","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Mass Fraction of Water\" is one of a number of $\\textit{Concentration}$ quantities defined by ISO 80000.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$w_{H_2o} = \\frac{u}{1+u}$, where $u$ is mass ratio of water to dry water.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Mass Fraction of Water is one of a number of Concentration quantities defined by ISO 80000.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"w_{H_2o}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q76379025"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassFractionOfWater","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Fraction of Water","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/MassFractionOfDryMatter"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassNumber","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Mass Number\" (A), also called atomic mass number or nucleon number, is the total number of protons\n    and neutrons (together known as nucleons) in an atomic nucleus. Nuclides with the same value of $A$ are called isobars.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/COUNT"},{"@id":"http://qudt.org/vocab/unit/NUM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Mass_number","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$A = Z + N$, where $Z$ is the atomic number and $N$ is the neutron number.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Count"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"A","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q101395"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassNumber","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-sche