ma/qudt/symbol":[{"@value":"U_s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q185329"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricPotential","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:ElectricPotentialDifference","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:EnergyPerElectricCharge","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:Voltage","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Source Voltage","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotential"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotentialDifference"},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerElectricCharge"},{"@id":"http://qudt.org/vocab/quantitykind/Voltage"}]},{"@id":"http://qudt.org/vocab/quantitykind/SourceVoltageBetweenSubstances","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Source Voltage Between Substances\" is the source voltage between substance a and b.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ExaV"},{"@id":"http://qudt.org/vocab/unit/FemtoV"},{"@id":"http://qudt.org/vocab/unit/GigaV"},{"@id":"http://qudt.org/vocab/unit/KiloV"},{"@id":"http://qudt.org/vocab/unit/MegaV"},{"@id":"http://qudt.org/vocab/unit/MicroV"},{"@id":"http://qudt.org/vocab/unit/MilliV"},{"@id":"http://qudt.org/vocab/unit/NanoV"},{"@id":"http://qudt.org/vocab/unit/PetaV"},{"@id":"http://qudt.org/vocab/unit/PicoV"},{"@id":"http://qudt.org/vocab/unit/PlanckVolt"},{"@id":"http://qudt.org/vocab/unit/TeraV"},{"@id":"http://qudt.org/vocab/unit/V"},{"@id":"http://qudt.org/vocab/unit/V_Ab"},{"@id":"http://qudt.org/vocab/unit/V_Stat"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Source Voltage Between Substances\" is the source voltage between substance a and b.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotential"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotentialDifference"},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerElectricCharge"},{"@id":"http://qudt.org/vocab/quantitykind/Voltage"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"E_{ab}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricPotential","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:ElectricPotentialDifference","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:EnergyPerElectricCharge","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:Voltage","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Source Voltage Between Substances","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotential"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotentialDifference"},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerElectricCharge"},{"@id":"http://qudt.org/vocab/quantitykind/Voltage"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpatialSummationFunction","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Spatial Summation Function\" is he ability to produce a composite signal from the signals coming into the\n    eyes from different directions.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ANGSTROM"},{"@id":"http://qudt.org/vocab/unit/AU"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB_F"},{"@id":"http://qudt.org/vocab/unit/CHAIN"},{"@id":"http://qudt.org/vocab/unit/CHAIN_US"},{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/DecaM"},{"@id":"http://qudt.org/vocab/unit/DeciM"},{"@id":"http://qudt.org/vocab/unit/FATH"},{"@id":"http://qudt.org/vocab/unit/FM"},{"@id":"http://qudt.org/vocab/unit/FT"},{"@id":"http://qudt.org/vocab/unit/FT_US"},{"@id":"http://qudt.org/vocab/unit/FUR"},{"@id":"http://qudt.org/vocab/unit/FemtoM"},{"@id":"http://qudt.org/vocab/unit/GAUGE_FR"},{"@id":"http://qudt.org/vocab/unit/GA_Charriere"},{"@id":"http://qudt.org/vocab/unit/HectoM"},{"@id":"http://qudt.org/vocab/unit/IN"},{"@id":"http://qudt.org/vocab/unit/KiloM"},{"@id":"http://qudt.org/vocab/unit/LY"},{"@id":"http://qudt.org/vocab/unit/M"},{"@id":"http://qudt.org/vocab/unit/MI"},{"@id":"http://qudt.org/vocab/unit/MI_N"},{"@id":"http://qudt.org/vocab/unit/MI_UK"},{"@id":"http://qudt.org/vocab/unit/MI_US"},{"@id":"http://qudt.org/vocab/unit/MicroIN"},{"@id":"http://qudt.org/vocab/unit/MicroM"},{"@id":"http://qudt.org/vocab/unit/MilLength"},{"@id":"http://qudt.org/vocab/unit/MilliIN"},{"@id":"http://qudt.org/vocab/unit/MilliM"},{"@id":"http://qudt.org/vocab/unit/NanoM"},{"@id":"http://qudt.org/vocab/unit/PARSEC"},{"@id":"http://qudt.org/vocab/unit/PCA"},{"@id":"http://qudt.org/vocab/unit/PT"},{"@id":"http://qudt.org/vocab/unit/PicoM"},{"@id":"http://qudt.org/vocab/unit/PlanckLength"},{"@id":"http://qudt.org/vocab/unit/ROD"},{"@id":"http://qudt.org/vocab/unit/YD"},{"@id":"http://qudt.org/vocab/unit/ZOLL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Summation_(neurophysiology)#Spatial_summation","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Spatial Summation Function\" is he ability to produce a composite signal from the signals coming\n    into the eyes from different directions.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Spatial Summation Function","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificAcousticImpedance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Specific Acoustic Impedance}$ at a point in a medium is the complex quotient of the sound\n    pressure $p$ by the particle velocity $v$ in the direction of wave propagation: $z = p / v$.\n    Its SI unit is the pascal second per metre (Pa·s/m), also called the rayl.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/N-SEC-PER-M3"},{"@id":"http://qudt.org/vocab/unit/PA-SEC-PER-M"},{"@id":"http://qudt.org/vocab/unit/RAYL"},{"@id":"http://qudt.org/vocab/unit/RAYL_MKS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MassPerAreaTime"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificAcousticImpedance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Acoustic Impedance","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MassPerAreaTime"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificActivity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Specific Activity\" is the number of decays per unit time of a radioactive sample. The SI unit of\n    radioactive activity is the becquerel (Bq), in honor of the scientist Henri Becquerel.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BQ-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/CI-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloBQ-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MegaBQ-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MicroBQ-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MilliBQ-PER-GM"},{"@id":"http://qudt.org/vocab/unit/MilliBQ-PER-KiloGM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Specific_activity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$a = \\frac{A}{m}$, where $A$ is the activity of a sample and $m$ is its mass.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Specific Activity\" is the number of decays per unit time of a radioactive sample. The SI unit\n    of radioactive activity is the becquerel (Bq), in honor of the scientist Henri Becquerel.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"a","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q2823748"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificActivity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Activity","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificElectricCharge","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Electric charge (often capacity in the context of electrochemical cells) relativ to the mass (often only\n    active components). capacity\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MilliA-HR-PER-GM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M-1H0T1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Electric charge (often capacity in the context of electrochemical cells) relativ to the mass (often\n    only active components). capacity\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificElectricCharge","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Electric Charge","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificElectricCurrent","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Specific Electric Current\" is a measure to specify the applied current relative to a corresponding mass.\n    This measure is often used for standardization within electrochemistry.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-PER-GM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M-1H0T0D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificElectricCurrent","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Electrical Current","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Specific Energy}$ is defined as the energy per unit mass. Common metric units are $J/kg$. It is\n    an intensive property. Contrast this with energy, which is an extensive property. There are two main types of specific energy:\n    potential energy and specific kinetic energy. Others are the $\\textit{gray}$ and $\\textit{sievert}$, which are measures for\n    the absorption of radiation. $$$$ The concept of specific energy applies to a particular or theoretical way of extracting\n    useful energy from the material considered that is usually implied by context. These intensive properties are each symbolized\n    by using the lower case letter of the symbol for the corresponding extensive property, which is symbolized by a capital\n    letter. For example, the extensive thermodynamic property enthalpy is symbolized by $H$; specific enthalpy is symbolized by\n    $h$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-LB"},{"@id":"http://qudt.org/vocab/unit/CAL_IT-PER-GM"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-GM"},{"@id":"http://qudt.org/vocab/unit/ERG-PER-GM"},{"@id":"http://qudt.org/vocab/unit/J-PER-GM"},{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-GM"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F-FT-PER-LB"},{"@id":"http://qudt.org/vocab/unit/MegaJ-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MilliJ-PER-GM"},{"@id":"http://qudt.org/vocab/unit/W-HR-PER-KiloGM"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Specific_energy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD173","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://en.citizendium.org/wiki/Enthalpy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD173","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Specific_energy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$e = E/m$, where $E$ is energy and $m$ is mass.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/SENG"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"e","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q3023293"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Energy","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/Enthalpy"},{"@id":"http://qudt.org/vocab/quantitykind/MassieuFunction"},{"@id":"http://qudt.org/vocab/quantitykind/PlanckFunction"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnthalpy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificGibbsEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHelmholtzEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificInternalEnergy"},{"@id":"http://qudt.org/vocab/unit/GRAY"},{"@id":"http://qudt.org/vocab/unit/SV"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergyImparted","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Specific Energy Imparted\", is the energy imparted to an element of irradiated matter divided by the\n    mass, dm, of that element.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-LB"},{"@id":"http://qudt.org/vocab/unit/CAL_IT-PER-GM"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-GM"},{"@id":"http://qudt.org/vocab/unit/ERG-PER-GM"},{"@id":"http://qudt.org/vocab/unit/J-PER-GM"},{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-GM"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F-FT-PER-LB"},{"@id":"http://qudt.org/vocab/unit/MegaJ-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MilliJ-PER-GM"},{"@id":"http://qudt.org/vocab/unit/W-HR-PER-KiloGM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.answers.com/topic/energy-imparted","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"For ionizing radiation, $z = \\frac{\\varepsilon}{m}$, where $\\varepsilon$ is the energy imparted to irradiated matter and $m$ is the mass of that matter.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Specific Energy Imparted\", is the energy imparted to an element of irradiated matter divided\n    by the mass, dm, of that element.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"z","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q99566195"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Energy Imparted","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnthalpy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Specific Enthalpy}$ is enthalpy per mass of substance involved. Specific enthalpy is denoted by\n    a lower case h, with dimension of energy per mass (SI unit: joule/kg). In thermodynamics, $\\textit{enthalpy}$ is the sum of\n    the internal energy U and the product of pressure p and volume V of a system: $H = U + pV$.  The internal energy U and the\n    work term pV have dimension of energy, in SI units this is joule; the extensive (linear in size) quantity H has the same\n    dimension.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-LB"},{"@id":"http://qudt.org/vocab/unit/CAL_IT-PER-GM"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-GM"},{"@id":"http://qudt.org/vocab/unit/ERG-PER-GM"},{"@id":"http://qudt.org/vocab/unit/J-PER-GM"},{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-GM"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F-FT-PER-LB"},{"@id":"http://qudt.org/vocab/unit/MegaJ-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MilliJ-PER-GM"},{"@id":"http://qudt.org/vocab/unit/W-HR-PER-KiloGM"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Entropy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://en.citizendium.org/wiki/Enthalpy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$h = H/m$, where $H$ is enthalpy and $m$ is mass.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"h","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q21572993"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Enthalpy","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/Enthalpy"},{"@id":"http://qudt.org/vocab/quantitykind/MassieuFunction"},{"@id":"http://qudt.org/vocab/quantitykind/PlanckFunction"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificGibbsEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHelmholtzEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificInternalEnergy"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificEntropy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Specific Entropy\" is entropy per unit of mass.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB-DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-LB-DEG_F"},{"@id":"http://qudt.org/vocab/unit/CAL_IT-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/CAL_IT-PER-GM-K"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-GM-K"},{"@id":"http://qudt.org/vocab/unit/J-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/J-PER-GM-K"},{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM-K"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-KiloGM-K"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Entropy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H-1T-2D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$s = S/m$, where $S$ is entropy and $m$ is mass.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Specific Entropy\" is entropy per unit of mass.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q69423705"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificEntropy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Entropy","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/Entropy"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificGibbsEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\n  $\\textit{Specific Gibbs Energy}$ is a \"corresponding intensive property\",\n   which is $\\textit{Gibbs Energy}$ per mass of substance involved. \n  Energy has corresponding intensive (size-independent) properties for pure materials. \n  $\\textit{Specific Gibbs Energy}$ is denoted by a lower case $g$,\n   with dimension of energy per mass (SI unit: $joule/kg$).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-LB"},{"@id":"http://qudt.org/vocab/unit/CAL_IT-PER-GM"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-GM"},{"@id":"http://qudt.org/vocab/unit/ERG-PER-GM"},{"@id":"http://qudt.org/vocab/unit/J-PER-GM"},{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-GM"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F-FT-PER-LB"},{"@id":"http://qudt.org/vocab/unit/MegaJ-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MilliJ-PER-GM"},{"@id":"http://qudt.org/vocab/unit/W-HR-PER-KiloGM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://en.citizendium.org/wiki/Enthalpy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$g = G/m$, where $G$ is Gibbs energy and $m$ is mass.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Energy has corresponding intensive (size-independent) properties for pure materials. A\n    corresponding intensive property is \"Specific Gibbs Energy}, which is $\\textit{Gibbs Energy} per mass of substance involved.\n    $\\textit{Specific Gibbs Energy\" is denoted by a lower case g, with dimension of energy per mass (SI unit: joule/kg).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"g","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q76360636"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Gibbs Energy","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/MassieuFunction"},{"@id":"http://qudt.org/vocab/quantitykind/PlanckFunction"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnthalpy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHelmholtzEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificInternalEnergy"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Specific Heat Capacity\" of a solid or liquid is defined as the heat required to raise unit mass of\n    substance by one degree of temperature. This is $\\textit{Heat Capacity}$ divided by $\\textit{Mass}$. Note that there are\n    corresponding molar quantities.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB-DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB-DEG_R"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-LB-DEG_F"},{"@id":"http://qudt.org/vocab/unit/CAL_IT-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/CAL_IT-PER-GM-K"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-GM-K"},{"@id":"http://qudt.org/vocab/unit/J-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/J-PER-GM-K"},{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM-K"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-KiloGM-K"},{"@id":"http://qudt.org/vocab/unit/M2-PER-SEC2-K"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Specific_heat_capacity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H-1T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD112","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.taftan.com/thermodynamics/CP.HTM","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD112","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Specific Heat Capacity of a solid or liquid is defined as the heat required to raise unit mass of\n    substance by one degree of temperature. This is Heat Capacity divided by Mass. Note that there are corresponding molar\n    quantities.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/SHEC"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"c","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q487756"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificHeatCapacity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Heat Capacity","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/HeatCapacity"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacityAtConstantPressure"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacityAtConstantVolume"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacityAtSaturation"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacityAtConstantPressure","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Specific heat at a constant pressure.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB-DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB-DEG_R"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-LB-DEG_F"},{"@id":"http://qudt.org/vocab/unit/CAL_IT-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/CAL_IT-PER-GM-K"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-GM-K"},{"@id":"http://qudt.org/vocab/unit/J-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/J-PER-GM-K"},{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM-K"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-KiloGM-K"},{"@id":"http://qudt.org/vocab/unit/M2-PER-SEC2-K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H-1T-2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Specific heat at a constant pressure.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacity"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"c_p","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q75774282"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificHeatCapacity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Heat Capacity at Constant Pressure","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacity"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacityAtConstantVolume"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacityAtSaturation"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacity"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacityAtConstantVolume","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Specific heat per constant volume.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB-DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB-DEG_R"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-LB-DEG_F"},{"@id":"http://qudt.org/vocab/unit/CAL_IT-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/CAL_IT-PER-GM-K"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-GM-K"},{"@id":"http://qudt.org/vocab/unit/J-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/J-PER-GM-K"},{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM-K"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-KiloGM-K"},{"@id":"http://qudt.org/vocab/unit/M2-PER-SEC2-K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H-1T-2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Specific heat per constant volume.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacity"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"c_v","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q75774757"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificHeatCapacity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Heat Capacity at Constant Volume","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacity"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacityAtConstantPressure"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacityAtSaturation"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacity"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacityAtSaturation","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Specific heat per constant volume.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB-DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB-DEG_R"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-LB-DEG_F"},{"@id":"http://qudt.org/vocab/unit/CAL_IT-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/CAL_IT-PER-GM-K"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-GM-K"},{"@id":"http://qudt.org/vocab/unit/J-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/J-PER-GM-K"},{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM-K"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-GM-DEG_C"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-KiloGM-K"},{"@id":"http://qudt.org/vocab/unit/M2-PER-SEC2-K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H-1T-2D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Specific heat per constant volume.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacity"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"c_{sat}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q75775005"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificHeatCapacity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Heat Capacity at Saturation","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacity"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacityAtConstantPressure"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacityAtConstantVolume"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacity"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatPressure","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Specific heat at a constant pressure.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM-K-PA"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M-1H-1T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Specific heat at a constant pressure.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificHeatPressure","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Heat Pressure","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatVolume","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Specific heat per constant volume.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM-K-M3"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H-1T-2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Specific heat per constant volume.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificHeatVolume","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Heat Volume","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatsRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The ratio of specific heats, for the exhaust gases adiabatic gas constant, is the relative amount of\n    compression/expansion energy that goes into temperature $T$ versus pressure $P$ can be characterized by the heat capacity\n    ratio: $\\gamma\\frac{C_P}{C_V}$, where $C_P$ is the specific heat (also called heat capacity) at constant pressure, while\n    $C_V$ is the specific heat at constant volume.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\gamma$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificHeatsRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Heats Ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHelmholtzEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\n  $\\textit{Specific Helmholtz Energy}$ is a \"corresponding intensive property\",\n    which is $\\textit{Helmholz Energy}$ per mass of substance involved.\n  Energy has corresponding intensive (size-independent) properties for pure materials. \n  $\\textit{Specific Helmholz Energy}$ is denoted by a lower case $u$,\n   with dimension of energy per mass (SI unit: $joule/kg$).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-LB"},{"@id":"http://qudt.org/vocab/unit/CAL_IT-PER-GM"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-GM"},{"@id":"http://qudt.org/vocab/unit/ERG-PER-GM"},{"@id":"http://qudt.org/vocab/unit/J-PER-GM"},{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-GM"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F-FT-PER-LB"},{"@id":"http://qudt.org/vocab/unit/MegaJ-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MilliJ-PER-GM"},{"@id":"http://qudt.org/vocab/unit/W-HR-PER-KiloGM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://en.citizendium.org/wiki/Enthalpy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$a = A/m$, where $A$ is Helmholtz energy and $m$ is mass.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"a","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q76359554"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Helmholtz Energy","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/MassieuFunction"},{"@id":"http://qudt.org/vocab/quantitykind/PlanckFunction"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnthalpy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificGibbsEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificInternalEnergy"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHumidity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Specific humidity (or moisture content) is the ratio of the mass of water vapour to the total mass of the\n    air parcel. It is approximately equal to the mixing ratio, defined as the ratio of the mass of water vapour to the mass of dry\n    air in the same parcel. Specific humidity is commonly represented by the symbol $\\omega$ and is widely used in psychrometrics\n    and HVAC system design.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/GRAIN-PER-LB_M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Humidity#Specific_humidity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Specific humidity (or moisture content) is the ratio of the mass of water vapour to the total mass\n    of the air parcel. It is approximately equal to the mixing ratio, defined as the ratio of the mass of water vapour to the mass\n    of dry air in the same parcel.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MassRatio"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificHumidity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Humidity","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/AbsoluteHumidity"},{"@id":"http://qudt.org/vocab/quantitykind/RelativeHumidity"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Moisture Content","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MassRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificImpulse","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The impulse produced by a rocket divided by the mass $mp$ of propellant consumed. Specific impulse\n    ${I_{sp}}$ is a widely used measure of performance for chemical, nuclear, and electric rockets. It is usually given in seconds\n    for both U.S. Customary and International System (SI) units.  The impulse produced by a rocket is the thrust force $F$ times\n    its duration $t$ in seconds. $I_{sp}$ is the thrust per unit mass flowrate, but with $g_o$, is the thrust per weight flowrate.\n    The specific impulse is given by the equation: $I_{sp} = \\frac{F}{\\dot{m}g_o}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MilliSEC"},{"@id":"http://qudt.org/vocab/unit/SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.grc.nasa.gov/WWW/K-12/airplane/specimp.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Time"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificImpulse","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Impulse","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/MassFlowRate"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Time"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificImpulseByMass","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/CentiM-PER-KiloYR"},{"@id":"http://qudt.org/vocab/unit/CentiM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/CentiM-PER-YR"},{"@id":"http://qudt.org/vocab/unit/FT-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/FT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/FT-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/FT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/GigaHZ-M"},{"@id":"http://qudt.org/vocab/unit/IN-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/IN-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/IN-PER-YR"},{"@id":"http://qudt.org/vocab/unit/KN"},{"@id":"http://qudt.org/vocab/unit/KiloM-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/KiloM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/M-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/M-PER-HR"},{"@id":"http://qudt.org/vocab/unit/M-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/M-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/M-PER-YR"},{"@id":"http://qudt.org/vocab/unit/MI-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MI-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MI-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MI_N-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MI_N-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MicroM-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MicroM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-YR"},{"@id":"http://qudt.org/vocab/unit/YD-PER-HR"},{"@id":"http://qudt.org/vocab/unit/YD-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/YD-PER-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/Velocity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q100793317"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearVelocity","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:Velocity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Impulse by Mass","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/Velocity"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificImpulseByWeight","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Specific impulse expressed on a weight basis: the impulse produced divided by the weight of propellant\n    consumed, $I_{sp} = F / (\\dot{m} g_0)$, giving a result in seconds. This is the convention quantitykind:SpecificImpulse\n    already adopts. Contrast the mass basis, $F / \\dot{m}$, which yields an effective exhaust velocity in metres per second and\n    is carried by quantitykind:SpecificThrust; the two differ by the factor $g_0$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MilliSEC"},{"@id":"http://qudt.org/vocab/unit/SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificImpulse"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q100828354"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificImpulse","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Impulse by Weight","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificThrust"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificImpulse"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificInternalEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Energy has corresponding intensive (size-independent) properties for pure materials. A corresponding\n    intensive property is specific internal energy, which is energy per mass of substance involved. Specific internal energy is\n    denoted by a lower case u, with dimension of energy per mass (SI unit: joule/kg).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-LB"},{"@id":"http://qudt.org/vocab/unit/CAL_IT-PER-GM"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-GM"},{"@id":"http://qudt.org/vocab/unit/ERG-PER-GM"},{"@id":"http://qudt.org/vocab/unit/J-PER-GM"},{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-GM"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F-FT-PER-LB"},{"@id":"http://qudt.org/vocab/unit/MegaJ-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MilliJ-PER-GM"},{"@id":"http://qudt.org/vocab/unit/W-HR-PER-KiloGM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD173","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://en.citizendium.org/wiki/Enthalpy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD173","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$u = U/m$, where $U$ is thermodynamic energy and $m$ is mass.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Energy has corresponding intensive (size-independent) properties for pure materials. A\n    corresponding intensive property is specific internal energy, which is energy per mass of substance involved. Specific\n    internal energy is denoted by a lower case u, with dimension of energy per mass (SI unit: joule/kg).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"u","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q76357367"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Internal Energy","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/InternalEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/MassieuFunction"},{"@id":"http://qudt.org/vocab/quantitykind/PlanckFunction"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnthalpy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificGibbsEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHelmholtzEnergy"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificModulus","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"<p><b>Specific modulus</b> is a <a href=\"/wiki/Materials_property\" class=\"mw-redirect\" title=\"Materials\n    property\">materials property</a> consisting of the <a href=\"/wiki/Elastic_modulus\" title=\"Elastic modulus\">elastic modulus</a>\n    per mass <a href=\"/wiki/Density\" title=\"Density\">density</a> of a material. It is also known as the <b>stiffness to weight\n    ratio</b> or <b>specific stiffness</b>. High specific modulus materials find wide application in <a href=\"/wiki/Aerospace\"\n    title=\"Aerospace\">aerospace</a> applications where minimum structural <a href=\"/wiki/Weight\" title=\"Weight\">weight</a> is\n    required. The <a href=\"/wiki/Dimensional_analysis\" title=\"Dimensional analysis\">dimensional analysis</a> yields units of\n    distance squared per time squared.</p>\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/GigaPA-CentiM3-PER-GM"},{"@id":"http://qudt.org/vocab/unit/KiloM2-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/M2-PER-SEC2"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Specific_modulus","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Specific_modulus","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$specific modulus = E/\\rho$, where $E$ is elastic modulus and $\\rho$ is density.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificModulus","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Modulus","@language":"en"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Specific Stiffness","@language":"en"},{"@value":"Stiffness to Weight Ratio","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificOpticalRotationalAbility","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"material-specific quantity, which results as angle of rotation of a substance for a defined wavelength\n    and a defined temperature from the relation: quotient of measured angle of rotation divided by the mass concentration and the\n    radiographed distance\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/RAD-M2-PER-KiloGM"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ425#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificOpticalRotatoryPower"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD174","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD174","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"materialspezifische Größe, die sich als Drehwinkel einer Substanz für eine bestimmte Wellenlänge\n    und eine bestimmte Temperatur ergibt durch die Beziehung: Quotient aus gemessener Drehwinkel dividiert durch die\n    Massenkonzentration und die durchstrahlte Wegstrecke\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificOpticalRotationalAbility","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Optical Rotational Ability","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificOpticalRotatoryPower","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Specific Optical Rotatory Power\" Angle of optical rotation divided by the optical path length\n    through the medium and by the mass concentration of the substance giving the specific optical rotatory power.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/RAD-M2-PER-KiloGM"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificOpticalRotationalAbility"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://goldbook.iupac.org/O04313.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\alpha_m = \\alpha \\frac{A}{m}$, where $\\alpha$ is the angle of optical rotation, and $m$ is the mass of the optically active component in the path of a linearly polarized light beam of cross sectional area $A$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\alpha_m$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Specific Optical Rotatory Power\" Angle of optical rotation divided by the optical path length\n    through the medium and by the mass concentration of the substance giving the specific optical rotatory power.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificOpticalRotatoryPower","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Optical Rotatory Power","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificPower","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Specific power, also known as power-to-weight ratio, is the amount of power output per unit mass of the\n    power source. It is generally used to measure the performance of that power source. The higher the ratio, the more power a\n    system produces relative to its weight. It's commonly used in the automotive and aerospace industries to compare the\n    performance of different engines. It's generally measured in watts per kilogram (W/kg) or horsepower per pound (hp/lb).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ERG-PER-GM-SEC"},{"@id":"http://qudt.org/vocab/unit/MilliW-PER-MilliGM"},{"@id":"http://qudt.org/vocab/unit/W-PER-GM"},{"@id":"http://qudt.org/vocab/unit/W-PER-KiloGM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Power-to-weight_ratio","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Specific power, also known as power-to-weight ratio, is the amount of power output per unit mass of\n    the power source. It is generally used to measure the performance of that power source. The higher the ratio, the more power a\n    system produces relative to its weight. It's commonly used in the automotive and aerospace industries to compare the\n    performance of different engines. It's generally measured in watts per kilogram (W/kg) or horsepower per pound (hp/lb).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificPower","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Power","@language":"en"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Power-to-Weight Ratio","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificSurfaceArea","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"<strong>Specific surface area</strong> (<strong>SSA</strong>) is a property of solids defined as the\n    total surface area (SA) of a material per unit mass, (with units of m<sup>2</sup>/kg or m<sup>2</sup>/g). It is a physical\n    value that can be used to determine the type and properties of a material (e.g. soil or snow). It has a particular importance\n    for adsorption, heterogeneous catalysis, and reactions on surfaces.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM2-PER-GM"},{"@id":"http://qudt.org/vocab/unit/M2-PER-GM"},{"@id":"http://qudt.org/vocab/unit/M2-PER-KiloGM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Specific_surface_area","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$SSA = \\frac{SA}{\\m}$, where $SA$ is the surface area of an object and $\\m$ is the mass density of the object.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$SSA$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/MassAttenuationCoefficient"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Specific surface area (SSA) is a property of solids defined as the total surface area (SA) of a\n    material per unit mass, (with units of m²/kg or m²/g). It is a physical value that can be used to determine the type and\n    properties of a material (e.g. soil or snow). It has a particular importance for adsorption, heterogeneous catalysis, and\n    reactions on surfaces.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificSurfaceArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Surface Area","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MassAttenuationCoefficient"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificThrust","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Specific impulse (usually abbreviated Isp) is a way to describe the efficiency of rocket and jet engines.\n    It represents the force with respect to the amount of propellant used per unit time.[1] If the \"amount\" of propellant is given\n    in terms of mass (such as kilograms), then specific impulse has units of velocity. If it is given in terms of Earth-weight\n    (such as kiloponds), then specific impulse has units of time. The conversion constant between the two versions of specific\n    impulse is g. The higher the specific impulse, the lower the propellant flow rate required for a given thrust, and in the case\n    of a rocket the less propellant is needed for a given delta-v per the Tsiolkovsky rocket equation.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/M-PER-SEC"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Specific_thrust","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/id":[{"@value":"Q-160-100","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Specific_thrust","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Specific impulse (usually abbreviated Isp) is a way to describe the efficiency of rocket and jet\n    engines. It represents the force with respect to the amount of propellant used per unit time.[1] If the \"amount\" of propellant\n    is given in terms of mass (such as kilograms), then specific impulse has units of velocity. If it is given in terms of\n    Earth-weight (such as kiloponds), then specific impulse has units of time. The conversion constant between the two versions of\n    specific impulse is g. The higher the specific impulse, the lower the propellant flow rate required for a given thrust, and in\n    the case of a rocket the less propellant is needed for a given delta-v per the Tsiolkovsky rocket equation.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Speed"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificThrust","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Thrust","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificImpulse"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Speed"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificVolume","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Specific Volume\" ($\\nu$) is the volume occupied by a unit of mass of a material. It is equal to the\n    inverse of density.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM3-PER-GM"},{"@id":"http://qudt.org/vocab/unit/DeciL-PER-GM"},{"@id":"http://qudt.org/vocab/unit/DeciM3-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/FT3-PER-LB"},{"@id":"http://qudt.org/vocab/unit/IN3-PER-LB"},{"@id":"http://qudt.org/vocab/unit/L-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/M3-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MilliL-PER-GM"},{"@id":"http://qudt.org/vocab/unit/MilliL-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MilliM3-PER-GM"},{"@id":"http://qudt.org/vocab/unit/MilliM3-PER-KiloGM"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ383#007","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD175","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD175","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Specific_volume","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$sv = \\frac{1}{\\rho}$, where $\\rho$ is mass density.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/SPVO"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q683556"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificVolume","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Volume","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/Density"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpecificWeight","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloN-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MegaN-PER-M3"},{"@id":"http://qudt.org/vocab/unit/N-PER-M3"},{"@id":"http://qudt.org/vocab/unit/OZ_F-PER-IN3"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD386","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD386","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Specific_weight","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The specific weight, also known as the unit weight is a volume-specific quantity defined as the\n    weight per unit volume of a material. Note that weight is defined as a force, distinct from mass.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"γ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificWeight","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Specific Weight","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpectralAngularCrossSection","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Spectral Angular Cross-section\" is the cross-section for ejecting or scattering a particle into an\n    elementary cone with energy $E$ in an energy interval, divided by the solid angle $d\\Omega$ of that cone and the range $dE$\n    of that interval.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM2-PER-SR-ERG"},{"@id":"http://qudt.org/vocab/unit/M2-PER-SR-J"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Cross_section_(physics)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\sigma = \\int \\int \\sigma_{\\Omega,E} d\\Omega dE$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\sigma_{\\Omega, E}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98269571"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpectralAngularCrossSection","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Spectral Angular Cross-section","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://qudt.org/vocab/quantitykind/AngularCrossSection"},{"@id":"http://qudt.org/vocab/quantitykind/SpectralCrossSection"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpectralConcentrationOfRadiantEnergyDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"energy distribution of the instantaneous value of radiant energy in relation to the volume of the\n    propagation medium\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-M4"},{"@id":"http://qudt.org/vocab/unit/KiloPA-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/PA-PER-M"},{"@id":"http://qudt.org/vocab/unit/PicoPA-PER-KiloM"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ379#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/SpectralRadiantEnergyDensity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Energieverteilung des Augenblickswertes der Strahlungsenergie, bezogen auf das Volumen des\n    Ausbreitungsmediums\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpectralConcentrationOfRadiantEnergyDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Spectral Concentration of Radiant Energy Density","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpectralConcentrationOfVibrationalModes","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"number of vibrational modes in an infinitesimal interval of angular frequency, divided by the size of\n    that interval and by volume\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/SEC-PER-M3-RAD"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ431#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/VibrationalDensityOfStates"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Anzahl von Vibrationsmodi in einem infinitesimalen Energie-Intervall der Kreisfrequenz, dividiert\n    durch die Größe dieses Energie-Intervalls und durch das zugehörige Volumen\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpectralConcentrationOfVibrationalModes","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Spectral Concentration of Vibrational Modes (in Terms of Angular Frequency)","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpectralCrossSection","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Spectral Cross-section\" is the cross-section for a process in which the energy of the ejected or\n    scattered particle is in an interval of energy, divided by the range $dE$ of this interval.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM2-PER-ERG"},{"@id":"http://qudt.org/vocab/unit/M2-PER-J"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ381#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Cross_section_(physics)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\sigma = \\int \\sigma_E dE$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\sigma_E$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98267245"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpectralCrossSection","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Spectral Cross-section","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://qudt.org/vocab/quantitykind/AngularCrossSection"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpectralDensityOfVibrationalModes","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The number of vibrational modes in an infinitesimal interval of angular frequency, divided by the size of that interval and by volume.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/SEC-PER-M3-RAD"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/VibrationalDensityOfStates"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD178","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD178","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpectralDensityOfVibrationalModes","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Spectral Density of Vibrational Modes","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpectralEmittance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/W-PER-M2-NanoM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Spectral Emittance is a radiometry term for the power per unit area of electromagnetic radiation\n    unit wavelength emerging from a surface.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpectralEmittance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Measurement Unit of Spectral Emittance","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpectralIrradiance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/W-PER-M2-NanoM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Spectral Irradiance is a radiometry term for the power per unit area of electromagnetic radiation\n    per unit wavelength incident at a surface.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpectralIrradiance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Measurement Unit of Spectral Irradiance","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpectralLuminousEfficiency","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The Spectral Luminous Efficiency is a measure of how well a light source produces visible light. It is\n    the ratio of luminous flux to power. A common choice is to choose units such that the maximum possible efficacy, 683 lm/W,\n    corresponds to an efficiency of 100%.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Luminous_efficacy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$V(\\lambda) = \\frac{\\Phi_\\lambda(\\lambda_m)}{\\Phi_\\lambda(\\lambda)}$, where $\\Phi_\\lambda(\\lambda_m)$ is the spectral radiant flux at wavelength $\\lambda_m$ and $\\Phi_\\lambda(\\lambda)$ is the spectral radiant flux at wavelength $\\lambda$, such that both radiations produce equal luminous sensations under specified photometric conditions and $\\lambda_m$ is chosen so that the maximum value of this ratio is equal to 1.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The Spectral Luminous Efficiency is a measure of how well a light source produces visible light. It\n    is the ratio of luminous flux to power. A common choice is to choose units such that the maximum possible efficacy, 683 lm/W,\n    corresponds to an efficiency of 100%.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"V","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpectralLuminousEfficiency","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Spectral Luminous Efficiency","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpectralRadiance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MicroW-PER-CentiM2-MicroM-SR"},{"@id":"http://qudt.org/vocab/unit/MilliW-PER-M2-NanoM-SR"},{"@id":"http://qudt.org/vocab/unit/W-PER-M2-MicroM"},{"@id":"http://qudt.org/vocab/unit/W-PER-M2-MicroM-SR"},{"@id":"http://qudt.org/vocab/unit/W-PER-M2-NanoM-SR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Spectral Radiance is a radiometry term for the power per unit area of electromagnetic radiation per\n    unit wavelength per unit solid angle emerging from a surface.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpectralRadiance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Measurement Unit of Spectral Radiance","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpectralRadiantEnergyDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Spectral Radiant Energy Density\" is the spectral concentration of radiant energy density (in terms of\n    wavelength), or the spectral radiant energy density (in terms of wave length).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-M4"},{"@id":"http://qudt.org/vocab/unit/KiloPA-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/PA-PER-M"},{"@id":"http://qudt.org/vocab/unit/PicoPA-PER-KiloM"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/SpectralConcentrationOfRadiantEnergyDensity"},{"@id":"http://qudt.org/vocab/quantitykind/SpectralRadiantEnergyDensityInTermsOfWavelength"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$M-PER-L2-T2$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Spectral Radiant Energy Density\" is the spectral concentration of radiant energy density (in terms\n    of wavelength), or the spectral radiant energy density (in terms of wave length).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpectralRadiantEnergyDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Spectral Radiant Energy Density","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpectralRadiantEnergyDensityInTermsOfWavelength","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-M4"},{"@id":"http://qudt.org/vocab/unit/KiloPA-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/PA-PER-M"},{"@id":"http://qudt.org/vocab/unit/PicoPA-PER-KiloM"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/SpectralRadiantEnergyDensity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD179","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD179","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpectralRadiantEnergyDensityInTermsOfWavelength","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Spectral Radiant Energy Density in Terms of Wavelength","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Speed","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Speed is the magnitude of velocity.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BFT"},{"@id":"http://qudt.org/vocab/unit/FT3-PER-MIN-FT2"},{"@id":"http://qudt.org/vocab/unit/GigaHZ-M"},{"@id":"http://qudt.org/vocab/unit/HZ-M"},{"@id":"http://qudt.org/vocab/unit/IN-PER-YR"},{"@id":"http://qudt.org/vocab/unit/M-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MegaHZ-M"},{"@id":"http://qudt.org/vocab/unit/MicroM-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MicroM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/YD-PER-HR"},{"@id":"http://qudt.org/vocab/unit/YD-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/YD-PER-SEC"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Speed","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Speed is the magnitude of velocity.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q3711325"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Speed","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Speed","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpeedOfLight","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\n  The quantity kind $\\text{Speed of Light}$ is the speed of electomagnetic waves in a given medium.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/SpeedOfLight"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Speed_of_light","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=113-01-34","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Speed"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpeedOfLight","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Hitrost svetlobe","@language":"sl"},{"@value":"Işık hızı","@language":"tr"},{"@value":"Kelajuan cahaya","@language":"ms"},{"@value":"Lichtgeschwindigkeit","@language":"de"},{"@value":"Prędkość światła","@language":"pl"},{"@value":"Rychlost světla","@language":"cs"},{"@value":"Speed of Light","@language":"en"},{"@value":"Velocidade da luz","@language":"pt"},{"@value":"Viteza luminii","@language":"ro"},{"@value":"velocidad de la luz","@language":"es"},{"@value":"velocità della luce","@language":"it"},{"@value":"vitesse de la lumière","@language":"fr"},{"@value":"Скорость света","@language":"ru"},{"@value":"سرعة الضوء","@language":"ar"},{"@value":"سرعت نور","@language":"fa"},{"@value":"प्रकाश का वेग","@language":"hi"},{"@value":"光速","@language":"ja"},{"@value":"光速","@language":"zh"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/constant/MagneticConstant"},{"@id":"http://qudt.org/vocab/constant/PermittivityOfVacuum"},{"@id":"http://qudt.org/vocab/constant/SpeedOfLight_Vacuum"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Speed"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpeedOfSound","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The speed of sound is the distance travelled during a unit of time by a sound wave propagating through an\n    elastic medium.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BFT"},{"@id":"http://qudt.org/vocab/unit/FT3-PER-MIN-FT2"},{"@id":"http://qudt.org/vocab/unit/GigaHZ-M"},{"@id":"http://qudt.org/vocab/unit/HZ-M"},{"@id":"http://qudt.org/vocab/unit/IN-PER-YR"},{"@id":"http://qudt.org/vocab/unit/M-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MegaHZ-M"},{"@id":"http://qudt.org/vocab/unit/MicroM-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MicroM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/YD-PER-HR"},{"@id":"http://qudt.org/vocab/unit/YD-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/YD-PER-SEC"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Speed_of_sound","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Speed_of_sound","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$c = \\sqrt{\\frac{K}{\\rho}}$, where $K$ is the coefficient of stiffness, the bulk modulus (or the modulus of bulk elasticity for gases), and $\\rho$ is the density. Also, $c^2 = \\frac{\\partial p}{\\partial \\rho}$, where $p$ is the pressure and $\\rho$ is the density.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The speed of sound is the distance travelled during a unit of time by a sound wave propagating\n    through an elastic medium.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Speed"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"c","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q124003"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"belongs to SOQ-ISO","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Speed","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Hitrost zvoka","@language":"sl"},{"@value":"Kelajuan bunyi","@language":"ms"},{"@value":"Schallgeschwindigkeit","@language":"de"},{"@value":"Ses hızı","@language":"tr"},{"@value":"Speed of Sound","@language":"en"},{"@value":"prędkość dźwięku","@language":"pl"},{"@value":"rychlost zvuku","@language":"cs"},{"@value":"velocidad del sonido","@language":"es"},{"@value":"velocidade do som","@language":"pt"},{"@value":"velocità del suono","@language":"it"},{"@value":"vitesse du son","@language":"fr"},{"@value":"viteza sunetului","@language":"ro"},{"@value":"скорость звука","@language":"ru"},{"@value":"سرعة الصوت","@language":"ar"},{"@value":"سرعت صوت","@language":"fa"},{"@value":"ध्वनि का वेग","@language":"hi"},{"@value":"音速","@language":"ja"},{"@value":"音速","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Schallausbreitungsgeschwindigkeit","@language":"de"},{"@value":"célérité du son","@language":"fr"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Speed"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpeedRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Speed ratio generally refers to the ratio of the rotational speeds of two interconnected rotating\n    components, but it sometimes relates linear speeds.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://sciencing.com/calculate-speed-ratio-7598425.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Speed ratio generally refers to the ratio of the rotational speeds of two interconnected rotating\n    components, but it sometimes relates linear speeds.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpeedRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Speed Ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/SphericalIlluminance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Spherical illuminance is equal to quotient of the total luminous flux $\\Phi_v$ incident on a small\n    sphere by the cross section area of that sphere.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FC"},{"@id":"http://qudt.org/vocab/unit/LM-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/LM-PER-M2"},{"@id":"http://qudt.org/vocab/unit/LUX"},{"@id":"http://qudt.org/vocab/unit/PHOT"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I1M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Illuminance","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$E_v,0 = \\int_{4\\pi sr}{L_v}{d\\Omega}$, where $d\\Omega$ is the solid angle of each elementary beam passing through the given point and $L_v$ is its luminance at that point in the direction of the beam.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Illuminance"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LuminousFluxPerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Illuminance","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Illuminance"}]},{"@id":"http://qudt.org/vocab/quantitykind/Spin","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In quantum mechanics and particle physics \"Spin\" is an intrinsic form of angular momentum carried by\n    elementary particles, composite particles (hadrons), and atomic nuclei.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ERG-SEC"},{"@id":"http://qudt.org/vocab/unit/EV-SEC"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloGM-M2-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/N-M-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Spin_(physics)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In quantum mechanics and particle physics \"Spin\" is an intrinsic form of angular momentum carried\n    by elementary particles, composite particles (hadrons), and atomic nuclei.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/AngularImpulse"},{"@id":"http://qudt.org/vocab/quantitykind/AngularMomentum"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q133673"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AngularImpulse","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:AngularMomentum","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Spin","@language":"de"},{"@value":"Spin","@language":"en"},{"@value":"Spin","@language":"ms"},{"@value":"Spin","@language":"ro"},{"@value":"Spin","@language":"tr"},{"@value":"espín","@language":"es"},{"@value":"spin","@language":"cs"},{"@value":"spin","@language":"fr"},{"@value":"spin","@language":"it"},{"@value":"spin","@language":"pl"},{"@value":"spin","@language":"pt"},{"@value":"spin","@language":"sl"},{"@value":"Спин","@language":"ru"},{"@value":"اسپین/چرخش","@language":"fa"},{"@value":"لف مغزلي","@language":"ar"},{"@value":"スピン角運動量","@language":"ja"},{"@value":"自旋","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AngularImpulse"},{"@id":"http://qudt.org/vocab/quantitykind/AngularMomentum"}]},{"@id":"http://qudt.org/vocab/quantitykind/SpinQuantumNumber","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Spin Quantum Number\"  describes the spin (intrinsic angular momentum) of the electron within that\n    orbital, and gives the projection of the spin angular momentum S along the specified axis\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD371","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD371","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Quantum_number","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$s^2 = \\hbar^2 s(s + 1)$, where $s$ is the spin quantum number and $\\hbar$ is the Planck constant.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/QuantumNumber"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Spin Quantum Number\"  describes the spin (intrinsic angular momentum) of the electron within\n    that orbital, and gives the projection of the spin angular momentum S along the specified axis\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q3879445"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpinQuantumNumber","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Spin Quantum Number","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/QuantumNumber"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticQuantumNumber"},{"@id":"http://qudt.org/vocab/quantitykind/OrbitalAngularMomentumQuantumNumber"},{"@id":"http://qudt.org/vocab/quantitykind/PrincipalQuantumNumber"}]},{"@id":"http://qudt.org/vocab/quantitykind/SquareEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L4I0M2H0T-4D0"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Square Energy","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SquareTime","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/GM-PER-CentiM-BAR"},{"@id":"http://qudt.org/vocab/unit/GM-PER-MilliM-BAR"},{"@id":"http://qudt.org/vocab/unit/SEC2"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Time_Squared","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T2D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SquareTime","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Square Time","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/StandardAbsoluteActivity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Standard Absolute Activity\" is proportional to the absoulte activity of the pure substance $B$ at\n    the same temperature and pressure multiplied by the standard pressure.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Activity_coefficient","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\lambda_B^\\Theta = \\lambda_B^*(p^\\Theta)$, where $\\lambda_B^\\Theta$ the absolute activity of the pure substance $B$ at the same temperature and pressure, and $p^\\Theta$ is standard pressure.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\lambda_B^\\Theta$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q89406159"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:StandardAbsoluteActivity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Standard Absolute Activity","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/StandardChemicalPotential","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Standard Chemical Potential\" is the value of the chemical potential at standard conditions\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-MOL"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-MOL"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-MOL"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$j-mol^{-1}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Chemical_potential","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mu_B^\\Theta$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Standard Chemical Potential\" is the value of the chemical potential at standard conditions","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ChemicalPotential"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q89333468"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Standard Chemical Potential","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ChemicalPotential"}]},{"@id":"http://qudt.org/vocab/quantitykind/StandardGravitationalParameter","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In celestial mechanics the standard gravitational parameter of a celestial body is the product of the\n    gravitational constant G and the mass M of the body. Expressed as $\\mu = G \\cdot M$. The SI units of the standard\n    gravitational parameter are $m^{3}s^{-2}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloM3-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/M3-PER-SEC2"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Standard_gravitational_parameter","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Standard_gravitational_parameter","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mu$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q579338"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:StandardGravitationalParameter","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Standard Gravitational Parameter","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/StateDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"function of energy in a solid, determined by the number of permissible quantum states in the energy range\n    between E and E+dE per volume of material of this solid\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PER-EV-M3"},{"@id":"http://qudt.org/vocab/unit/PER-J-M3"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ427#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyDensityOfStates"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-5I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Funktion der Energie in einem Festkörper, bestimmt durch die Anzahl von erlaubten Quantenzuständen\n    im Energiebereich zwischen E und E+dE je Volumen des Materials dieses Festkörpers\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:StateDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"State Density","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/StateDensityAsExpressionOfAngularFrequency","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio between number of vibration modes in an infinitesimal interval of the angular frequency and the\n    length of this interval and the volume\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/SEC-PER-RAD-M3"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ454#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD180","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD180","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient aus Anzahl von Vibrationsmodi in einem infinitesimalen Intervall der Kreisfrequenz durch\n    die Spannweite dieses Intervalls und das Volumen\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:StateDensityAsExpressionOfAngularFrequency","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"State Density as Expression of Angular Frequency","@language":"en"},{"@value":"State Density as Expression of Angular Frequency","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/StateOfCharge","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"State of Charge\",quantifies the remaining capacity available in a battery at a given time and in\n    relation to a given state of ageing.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSIUnit":[{"@id":"http://qudt.org/vocab/unit/PERCENT"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/State_of_charge","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"\"State of Charge\",quantifies the remaining capacity available in a battery at a given time and in\n    relation to a given state of ageing.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"SoC","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:StateOfCharge","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"State of Charge","@language":"en"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Remaining battery energy level","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/StaticFriction","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Static friction is friction between two or more solid objects that are not moving relative to each other.\n    For example, static friction can prevent an object from sliding down a sloped surface.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiN"},{"@id":"http://qudt.org/vocab/unit/DYN"},{"@id":"http://qudt.org/vocab/unit/DeciN"},{"@id":"http://qudt.org/vocab/unit/GM_F"},{"@id":"http://qudt.org/vocab/unit/GigaN"},{"@id":"http://qudt.org/vocab/unit/KIP_F"},{"@id":"http://qudt.org/vocab/unit/KiloGM-M-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F"},{"@id":"http://qudt.org/vocab/unit/KiloN"},{"@id":"http://qudt.org/vocab/unit/KiloPOND"},{"@id":"http://qudt.org/vocab/unit/LB_F"},{"@id":"http://qudt.org/vocab/unit/MegaLB_F"},{"@id":"http://qudt.org/vocab/unit/MegaN"},{"@id":"http://qudt.org/vocab/unit/MicroN"},{"@id":"http://qudt.org/vocab/unit/MilliN"},{"@id":"http://qudt.org/vocab/unit/N"},{"@id":"http://qudt.org/vocab/unit/NanoN"},{"@id":"http://qudt.org/vocab/unit/OZ_F"},{"@id":"http://qudt.org/vocab/unit/PDL"},{"@id":"http://qudt.org/vocab/unit/POND"},{"@id":"http://qudt.org/vocab/unit/PlanckForce"},{"@id":"http://qudt.org/vocab/unit/TON_F_US"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Friction","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Friction","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Static friction is friction between two or more solid objects that are not moving relative to each\n    other. For example, static friction can prevent an object from sliding down a sloped surface.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Friction"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q90862568"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Force","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Static Friction","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Friction"}]},{"@id":"http://qudt.org/vocab/quantitykind/StaticFrictionCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Static friction is friction between two or more solid objects that are not moving relative to each other.\n    For example, static friction can prevent an object from sliding down a sloped surface.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Friction","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Friction","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mu = \\frac{F_max}{N}$, where $F_max$ is the maximum tangential component of the contact force and $N$ is the normal component of the contact force between two bodies at relative rest.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mu$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Static friction is friction between two or more solid objects that are not moving relative to each\n    other. For example, static friction can prevent an object from sliding down a sloped surface.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/FrictionCoefficient"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:FrictionCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Static Friction Coefficient","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/FrictionCoefficient"}]},{"@id":"http://qudt.org/vocab/quantitykind/StaticPressure","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Static Pressure\" is the pressure at a nominated point in a fluid. Every point in a steadily flowing\n    fluid, regardless of the fluid speed at that point, has its own static pressure $P$, dynamic pressure $q$, and total pressure\n    $P_0$. The total pressure is the sum of the dynamic and static pressures, that is $P_0 = P + q$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"p","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ATM"},{"@id":"http://qudt.org/vocab/unit/ATM_T"},{"@id":"http://qudt.org/vocab/unit/BAR"},{"@id":"http://qudt.org/vocab/unit/BARAD"},{"@id":"http://qudt.org/vocab/unit/BARYE"},{"@id":"http://qudt.org/vocab/unit/BAR_A"},{"@id":"http://qudt.org/vocab/unit/CentiBAR"},{"@id":"http://qudt.org/vocab/unit/CentiM_H2O"},{"@id":"http://qudt.org/vocab/unit/CentiM_H2O_4DEG_C"},{"@id":"http://qudt.org/vocab/unit/CentiM_HG"},{"@id":"http://qudt.org/vocab/unit/CentiM_HG_0DEG_C"},{"@id":"http://qudt.org/vocab/unit/DYN-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/DecaPA"},{"@id":"http://qudt.org/vocab/unit/DeciBAR"},{"@id":"http://qudt.org/vocab/unit/FT_H2O"},{"@id":"http://qudt.org/vocab/unit/FT_H2O_39dot2DEG_F"},{"@id":"http://qudt.org/vocab/unit/FT_HG"},{"@id":"http://qudt.org/vocab/unit/GM_F-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/GigaPA"},{"@id":"http://qudt.org/vocab/unit/HectoBAR"},{"@id":"http://qudt.org/vocab/unit/HectoPA"},{"@id":"http://qudt.org/vocab/unit/IN_H2O"},{"@id":"http://qudt.org/vocab/unit/IN_H2O_39dot2DEG_F"},{"@id":"http://qudt.org/vocab/unit/IN_H2O_60DEG_F"},{"@id":"http://qudt.org/vocab/unit/IN_HG"},{"@id":"http://qudt.org/vocab/unit/IN_HG_32DEG_F"},{"@id":"http://qudt.org/vocab/unit/IN_HG_60DEG_F"},{"@id":"http://qudt.org/vocab/unit/KIP_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/KiloBAR"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M-SEC2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F-PER-M2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-M2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/KiloPA"},{"@id":"http://qudt.org/vocab/unit/KiloPA_A"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/M_H2O"},{"@id":"http://qudt.org/vocab/unit/MegaBAR"},{"@id":"http://qudt.org/vocab/unit/MegaN-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MegaPA"},{"@id":"http://qudt.org/vocab/unit/MegaPSI"},{"@id":"http://qudt.org/vocab/unit/MicroATM"},{"@id":"http://qudt.org/vocab/unit/MicroBAR"},{"@id":"http://qudt.org/vocab/unit/MicroPA"},{"@id":"http://qudt.org/vocab/unit/MicroTORR"},{"@id":"http://qudt.org/vocab/unit/MilliBAR"},{"@id":"http://qudt.org/vocab/unit/MilliBAR_A"},{"@id":"http://qudt.org/vocab/unit/MilliM_H2O"},{"@id":"http://qudt.org/vocab/unit/MilliM_HG"},{"@id":"http://qudt.org/vocab/unit/MilliM_HGA"},{"@id":"http://qudt.org/vocab/unit/MilliPA"},{"@id":"http://qudt.org/vocab/unit/MilliTORR"},{"@id":"http://qudt.org/vocab/unit/N-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/N-PER-M2"},{"@id":"http://qudt.org/vocab/unit/N-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/PA"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/PSI"},{"@id":"http://qudt.org/vocab/unit/PicoPA"},{"@id":"http://qudt.org/vocab/unit/PlanckPressure"},{"@id":"http://qudt.org/vocab/unit/TORR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Static_pressure","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Pressure"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"p","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q2406217"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"belongs to SOQ-ISO","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ForcePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Static Pressure","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Pressure"}]},{"@id":"http://qudt.org/vocab/quantitykind/StatisticalWeight","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A \"Statistical Weight\" is the relative probability (possibly unnormalized) of a particular feature of a\n    state.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Statistical_weight","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A \"Statistical Weight\" is the relative probability (possibly unnormalized) of a particular feature\n    of a state.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"g","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:StatisticalWeight","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Statistical Weight","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/StochasticProcess","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In probability theory, a stochastic process, or sometimes random process  is a collection of random\n    variables; this is often used to represent the evolution of some random value, or system, over time. This is the probabilistic\n    counterpart to a deterministic process (or deterministic system).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/NUM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-YR"},{"@id":"http://qudt.org/vocab/unit/SAMPLE-PER-SEC"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Stochastic_process","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Stochastic_process","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In probability theory, a stochastic process, or sometimes random process  is a collection of random\n    variables; this is often used to represent the evolution of some random value, or system, over time. This is the probabilistic\n    counterpart to a deterministic process (or deterministic system).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/CountRate"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"X","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CountRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Stochastic Process","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/CountRate"}]},{"@id":"http://qudt.org/vocab/quantitykind/StoichiometricNumber","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Chemical reactions, as macroscopic unit operations, consist of simply a very large number of elementary\n    reactions, where a single molecule reacts with another molecule. As the reacting molecules (or moieties) consist of a definite\n    set of atoms in an integer ratio, the ratio between reactants in a complete reaction is also in integer ratio. A reaction may\n    consume more than one molecule, and the \"Stoichiometric Number\" counts this number, defined as positive for products (added)\n    and negative for reactants (removed).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Stoichiometry","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\nu_B$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Chemical reactions, as macroscopic unit operations, consist of simply a very large number of\n    elementary reactions, where a single molecule reacts with another molecule. As the reacting molecules (or moieties) consist of\n    a definite set of atoms in an integer ratio, the ratio between reactants in a complete reaction is also in integer ratio. A\n    reaction may consume more than one molecule, and the \"Stoichiometric Number\" counts this number, defined as positive for\n    products (added) and negative for reactants (removed).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q17326453"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:StoichiometricNumber","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Stoichiometric Number","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}]},{"@id":"http://qudt.org/vocab/quantitykind/Strain","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In any branch of science dealing with materials and their behaviour, strain is the geometrical expression\n    of deformation caused by the action of stress on a physical body. Strain is calculated by first assuming a change between two\n    body states: the beginning state and the final state. Then the difference in placement of two points in this body in those two\n    states expresses the numerical value of strain. Strain therefore expresses itself as a change in size and/or shape.\n    [Wikipedia]. Strain is commonly used as a synonym for LinearStrain.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Strain","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/LinearStrain"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.freestudy.co.uk/mech%20prin%20h2/stress.pdf","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\epsilon$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In any branch of science dealing with materials and their behaviour, strain is the geometrical\n    expression of deformation caused by the action of stress on a physical body. Strain is calculated by first assuming a change\n    between two body states: the beginning state and the final state. Then the difference in placement of two points in this body\n    in those two states expresses the numerical value of strain. Strain therefore expresses itself as a change in size and/or\n    shape. [Wikipedia] Strain is commonly used as a synonym for LinearStrain.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/LengthRatio"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LengthRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Strain","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/VolumeStrain"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/LengthRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/StrainEnergyDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Defined as the 'work done' for a given strain, that is the area under the stress-strain curve after a\n    specified eation. Source(s): http://www.prepol.com/product-range/product-subpages/terminology\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-FT3"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-FT3"},{"@id":"http://qudt.org/vocab/unit/ERG-PER-CentiM3"},{"@id":"http://qudt.org/vocab/unit/J-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MegaJ-PER-M3"},{"@id":"http://qudt.org/vocab/unit/W-HR-PER-M3"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Defined as the 'work done' for a given strain, that is the area under the stress-strain curve after\n    a specified eation. Source(s): http://www.prepol.com/product-range/product-subpages/terminology\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyDensity"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"u","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EnergyDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Strain Energy Density","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/StrainEnergyReleaseRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In fracture mechanics, the <b>energy release rate</b>, G, is the rate at which energy is transformed as a\n    material undergoes fracture. Mathematically, the energy release rate is expressed as the decrease in total potential energy\n    per increase in fracture surface area, and is thus expressed in terms of energy per unit area.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ERG-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/GigaJ-PER-M2"},{"@id":"http://qudt.org/vocab/unit/J-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/J-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MegaJ-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MilliJ-PER-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Energy_release_rate_(fracture_mechanics)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\G$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In fracture mechanics, the energy release rate, G, is the rate at which energy is transformed as a\n    material undergoes fracture. Mathematically, the energy release rate is expressed as the decrease in total potential energy\n    per increase in fracture surface area, and is thus expressed in terms of energy per unit area.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerArea"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"G","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:StrainEnergyReleaseRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Strain Energy Release Rate","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/Stress","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Stress is a measure of the average amount of force exerted per unit area of a surface within a deformable\n    body on which internal forces act. In other words, it is a measure of the intensity or internal distribution of the total\n    internal forces acting within a deformable body across imaginary surfaces. These internal forces are produced between the\n    particles in the body as a reaction to external forces applied on the body. Stress is defined as ${\\rm{Stress}} =\n    \\frac{F}{A}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ATM"},{"@id":"http://qudt.org/vocab/unit/ATM_T"},{"@id":"http://qudt.org/vocab/unit/BAR"},{"@id":"http://qudt.org/vocab/unit/BARAD"},{"@id":"http://qudt.org/vocab/unit/BARYE"},{"@id":"http://qudt.org/vocab/unit/BAR_A"},{"@id":"http://qudt.org/vocab/unit/CentiBAR"},{"@id":"http://qudt.org/vocab/unit/CentiM_H2O"},{"@id":"http://qudt.org/vocab/unit/CentiM_H2O_4DEG_C"},{"@id":"http://qudt.org/vocab/unit/CentiM_HG"},{"@id":"http://qudt.org/vocab/unit/CentiM_HG_0DEG_C"},{"@id":"http://qudt.org/vocab/unit/DYN-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/DecaPA"},{"@id":"http://qudt.org/vocab/unit/DeciBAR"},{"@id":"http://qudt.org/vocab/unit/FT_H2O"},{"@id":"http://qudt.org/vocab/unit/FT_H2O_39dot2DEG_F"},{"@id":"http://qudt.org/vocab/unit/FT_HG"},{"@id":"http://qudt.org/vocab/unit/GM_F-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/GigaPA"},{"@id":"http://qudt.org/vocab/unit/HectoBAR"},{"@id":"http://qudt.org/vocab/unit/HectoPA"},{"@id":"http://qudt.org/vocab/unit/IN_H2O"},{"@id":"http://qudt.org/vocab/unit/IN_H2O_39dot2DEG_F"},{"@id":"http://qudt.org/vocab/unit/IN_H2O_60DEG_F"},{"@id":"http://qudt.org/vocab/unit/IN_HG"},{"@id":"http://qudt.org/vocab/unit/IN_HG_32DEG_F"},{"@id":"http://qudt.org/vocab/unit/IN_HG_60DEG_F"},{"@id":"http://qudt.org/vocab/unit/KIP_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/KiloBAR"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M-SEC2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F-PER-M2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-M2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/KiloPA"},{"@id":"http://qudt.org/vocab/unit/KiloPA_A"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/M_H2O"},{"@id":"http://qudt.org/vocab/unit/MegaBAR"},{"@id":"http://qudt.org/vocab/unit/MegaN-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MegaPA"},{"@id":"http://qudt.org/vocab/unit/MegaPSI"},{"@id":"http://qudt.org/vocab/unit/MicroATM"},{"@id":"http://qudt.org/vocab/unit/MicroBAR"},{"@id":"http://qudt.org/vocab/unit/MicroPA"},{"@id":"http://qudt.org/vocab/unit/MicroTORR"},{"@id":"http://qudt.org/vocab/unit/MilliBAR"},{"@id":"http://qudt.org/vocab/unit/MilliBAR_A"},{"@id":"http://qudt.org/vocab/unit/MilliM_H2O"},{"@id":"http://qudt.org/vocab/unit/MilliM_HG"},{"@id":"http://qudt.org/vocab/unit/MilliM_HGA"},{"@id":"http://qudt.org/vocab/unit/MilliPA"},{"@id":"http://qudt.org/vocab/unit/MilliTORR"},{"@id":"http://qudt.org/vocab/unit/N-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/N-PER-M2"},{"@id":"http://qudt.org/vocab/unit/N-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/PA"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/PSI"},{"@id":"http://qudt.org/vocab/unit/PicoPA"},{"@id":"http://qudt.org/vocab/unit/PlanckPressure"},{"@id":"http://qudt.org/vocab/unit/TORR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.freestudy.co.uk/mech%20prin%20h2/stress.pdf","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"${\\rm{Stress}} = \\frac{F}{A}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\sigma$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q206175"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ForcePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Stress","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/StressIntensityFactor","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In fracture mechanics, the stress intensity factor (K) is used to predict the stress state (\"stress\n    intensity\") near the tip of a crack or notch caused by a remote load or residual stresses. It is a theoretical construct\n    usually applied to a homogeneous, linear elastic material and is useful for providing a failure criterion for brittle\n    materials, and is a critical technique in the discipline of damage tolerance. The concept can also be applied to materials\n    that exhibit small-scale yielding at a crack tip.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MegaPA-M0dot5"},{"@id":"http://qudt.org/vocab/unit/PA-M0dot5"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-0dot5I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Stress_intensity_factor","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\K$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In fracture mechanics, the stress intensity factor (K) is used to predict the stress state (\"stress\n    intensity\") near the tip of a crack or notch caused by a remote load or residual stresses. It is a theoretical construct\n    usually applied to a homogeneous, linear elastic material and is useful for providing a failure criterion for brittle\n    materials, and is a critical technique in the discipline of damage tolerance. The concept can also be applied to materials\n    that exhibit small-scale yielding at a crack tip.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"K","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:StressIntensityFactor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Stress Intensity Factor","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/StressOpticCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"When a ray of light passes through a photoelastic material, its electromagnetic wave components are\n    resolved along the two principal stress directions and each component experiences a different refractive index due to the\n    birefringence. The difference in the refractive indices leads to a relative phase retardation between the two components.\n    Assuming a thin specimen made of isotropic materials, where two-dimensional photoelasticity is applicable, the magnitude of\n    the relative retardation is given by the stress-optic law Δ=((2πt)/λ)C(σ₁-σ₂), where Δ is the induced retardation, C is the\n    stress-optic coefficient, t is the specimen thickness, λ is the vacuum wavelength, and σ₁ and σ₂ are the first and second\n    principal stresses, respectively.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BREWSTER"},{"@id":"http://qudt.org/vocab/unit/NanoM-PER-CentiM-MegaPA"},{"@id":"http://qudt.org/vocab/unit/NanoM-PER-CentiM-PSI"},{"@id":"http://qudt.org/vocab/unit/NanoM-PER-MilliM-MegaPA"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/w/index.php?title=Photoelasticity&oldid=1109858854#Experimental_principles","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"When a ray of light passes through a photoelastic material, its electromagnetic wave components are resolved along the two principal stress directions and each component experiences a different refractive index due to the birefringence. The difference in the refractive indices leads to a relative phase retardation between the two components. Assuming a thin specimen made of isotropic materials, where two-dimensional photoelasticity is applicable, the magnitude of the relative retardation is given by the stress-optic law $\\Delta ={\\frac {2\\pi t}{\\lambda }}C(\\sigma _{1}-\\sigma _{2})$, where $\\Delta$ is the induced retardation, $C$ is the stress-optic coefficient, $t$ is the specimen thickness, $\\lambda$ is the vacuum wavelength, and $\\sigma_1$ and $\\sigma_2$ are the first and second principal stresses, respectively.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"When a ray of light passes through a photoelastic material, its electromagnetic wave components are\n    resolved along the two principal stress directions and each component experiences a different refractive index due to the\n    birefringence. The difference in the refractive indices leads to a relative phase retardation between the two components.\n    Assuming a thin specimen made of isotropic materials, where two-dimensional photoelasticity is applicable, the magnitude of\n    the relative retardation is given by the stress-optic law Δ=((2πt)/λ)C(σ₁-σ₂), where Δ is the induced retardation, C is the\n    stress-optic coefficient, t is the specimen thickness, λ is the vacuum wavelength, and σ₁ and σ₂ are the first and second\n    principal stresses, respectively.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:StressOpticCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Stress-Optic Coefficient","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/StructuralEfficiency","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Structural efficiency is a function of the weight of structure to the afforded vehicle's strength.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\gamma$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Structural efficiency is a function of the weight of structure to the afforded vehicle's strength.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:StructuralEfficiency","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Structural Efficiency","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}]},{"@id":"http://qudt.org/vocab/quantitykind/StructureFactor","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Structure Factor\" is a mathematical description of how a material scatters incident radiation.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Structure_factor","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$F(h, k, l) = \\sum_{n=1}^N f_n\\exp{[2\\pi i(hx_n + ky_n +lz_n)]}$, where $f_n$ is the atomic scattering factor for atom $n$, and $x_n$, $y_n$, and $z_n$ are fractional coordinates in the unit cell; for $h$, $k$, and $l$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Structure Factor\" is a mathematical description of how a material scatters incident radiation.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"F(h, k, l)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q900684"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:StructureFactor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Structure Factor","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SunProtectionFactorOfAProduct","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/SPF"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD366","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD366","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SunProtectionFactorOfAProduct","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Sun Protection Factor of a Product","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SuperconductionTransitionTemperature","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Superconduction Transition Temperature\" is the critical thermodynamic temperature of a superconductor.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Superconductivity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Superconduction Transition Temperature\" is the critical thermodynamic temperature of a\n    superconductor.\n  ","@type":"http://www.w3.org/2001/