/vocab/unit/PlanckPressure"},{"@id":"http://qudt.org/vocab/unit/TORR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Pressure"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"P_0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ForcePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Total Pressure","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Pressure"}]},{"@id":"http://qudt.org/vocab/quantitykind/TotalRadiance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio between the differential change in the energy fluence dΨ and the time interval dt: ψ = dΨ / dt; the\n    total radiance is identical to the product of the particle flux density and the average energy of the particles\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-FT2-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-FT2-SEC"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-HR-FT2"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-IN2-SEC"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-SEC-FT2"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-FT2-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-FT2-MIN"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-FT2-SEC"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-CentiM2-MIN"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-CentiM2-SEC"},{"@id":"http://qudt.org/vocab/unit/ERG-PER-CentiM2-SEC"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F-PER-FT2-SEC"},{"@id":"http://qudt.org/vocab/unit/J-PER-CentiM2-DAY"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-CentiM2-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-CentiM2-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/M-PA-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MicroW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MilliW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/NanoW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/PicoW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/W-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/W-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/W-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/W-PER-M2"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ318#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyFluenceRate"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient aus der differentiellen Änderung der Energiefluenz dΨ im Zeitintervall dt: ψ = dΨ / dt;\n    die Energieflussdichte ist identisch mit dem Produkt der Teilchenflussdichte und der mittleren Teilchenenergie\n  ","@language":"de"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/PowerPerArea"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:PowerPerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Total Radiance","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/PowerPerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/TouchThresholds","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Touch Thresholds\" is an umbrella term for the thresholds of sensitivity of the skin to touch, vibration\n    and other mechanical stimuli. It has no single dimension: a concrete touch threshold specializes into a force for light-touch\n    detection (e.g. von Frey monofilaments, in millinewtons), a length for vibration-detection amplitude or two-point separation,\n    or a pressure, depending on the stimulus and method.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/NotApplicable"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\overline{T_t}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Touch Thresholds\" is an umbrella term for the thresholds of sensitivity of the skin to touch,\n    vibration and other mechanical stimuli. It has no single dimension: a concrete touch threshold specializes into a force for\n    light-touch detection (e.g. von Frey monofilaments, in millinewtons), a length for vibration-detection amplitude or two-point\n    separation, or a pressure, depending on the stimulus and method.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Touch Thresholds","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/TrafficIntensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"number of all simultaneously occupied units in a particular group of units","@language":"en"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ462#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD205","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD205","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Anzahl aller gleichzeitig belegten Einrichtungen in einer bestimmten Gruppe von einrichtungen","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Traffic Intensity","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/TransmissionRatioBetweenRotationAndTranslation","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"relationship between rotational and longitudinal movements as a measure of how an angle is converted into\n    a linear path\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/IN-PER-REV"},{"@id":"http://qudt.org/vocab/unit/M-PER-RAD"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ400#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/RotaryTranslatoryMotionConversion"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Zusammenhang zwischen Dreh- und Längsbewegung als Maß dafür, wie ein überstrichener Drehwinkel in\n    eine lineare Wegstrecke umgesetzt wird\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TransmissionRatioBetweenRotationAndTranslation","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Transmission Ratio Between Rotation and Translation","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/Transmittance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Transmittance is the fraction of incident light (electromagnetic radiation) at a specified wavelength\n    that passes through a sample.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/PSU"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Transmittance","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\tau = \\frac{\\Phi_t}{\\Phi_m}$, where $\\Phi_t$ is the transmitted radiant flux or the transmitted luminous flux, and $\\Phi_m$ is the radiant flux or luminous flux of the incident radiation.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\tau, T$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Transmittance is the fraction of incident light (electromagnetic radiation) at a specified\n    wavelength that passes through a sample.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1427863"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"belongs to SOQ-ISO","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Transmittance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Transmittance","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/TransmittanceDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Transmittance is the fraction of incident light (electromagnetic radiation) at a specified wavelength\n    that passes through a sample.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$A_{10}(\\lambda) = -lg(\\tau(\\lambda))$, where $\\tau$ is the transmittance at a given wavelength $\\lambda$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Transmittance is the fraction of incident light (electromagnetic radiation) at a specified\n    wavelength that passes through a sample.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"A_10, D","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TransmittanceDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Transmittance Density","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Turbidity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Turbidity is the cloudiness or haziness of a fluid, or of air, caused by individual particles (suspended\n    solids) that are generally invisible to the naked eye, similar to smoke in air. Turbidity in open water is often caused by\n    phytoplankton and the measurement of turbidity is a key test of water quality. The higher the turbidity, the higher the risk\n    of the drinkers developing gastrointestinal diseases, especially for immune-compromised people, because contaminants like\n    virus or bacteria can become attached to the suspended solid. The suspended solids interfere with water disinfection with\n    chlorine because the particles act as shields for the virus and bacteria. Similarly suspended solids can protect bacteria from\n    UV sterilisation of water. Fluids can contain suspended solid matter consisting of particles of many different sizes. While\n    some suspended material will be large enough and heavy enough to settle rapidly to the bottom container if a liquid sample is\n    left to stand (the settleable solids), very small particles will settle only very slowly or not at all if the sample is\n    regularly agitated or the particles are colloidal. These small solid particles cause the liquid to appear turbid.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/NTU"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Turbidity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Turbidity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Turbidity is the cloudiness or haziness of a fluid, or of air, caused by individual particles\n    (suspended solids) that are generally invisible to the naked eye, similar to smoke in air. Turbidity in open water is often\n    caused by phytoplankton and the measurement of turbidity is a key test of water quality. The higher the turbidity, the higher\n    the risk of the drinkers developing gastrointestinal diseases, especially for immune-compromised people, because contaminants\n    like virus or bacteria can become attached to the suspended solid. The suspended solids interfere with water disinfection with\n    chlorine because the particles act as shields for the virus and bacteria. Similarly suspended solids can protect bacteria from\n    UV sterilisation of water. Fluids can contain suspended solid matter consisting of particles of many different sizes. While\n    some suspended material will be large enough and heavy enough to settle rapidly to the bottom container if a liquid sample is\n    left to stand (the settleable solids), very small particles will settle only very slowly or not at all if the sample is\n    regularly agitated or the particles are colloidal. These small solid particles cause the liquid to appear turbid.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q898574"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Turbidity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Turbidity","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Turns","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Turns\" is the number of turns in a winding.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/COUNT"},{"@id":"http://qudt.org/vocab/unit/NUM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Count"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Turns\" is the number of turns in a winding.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"N","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Turns","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Turns","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Count"}]},{"@id":"http://qudt.org/vocab/quantitykind/Unbalance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"unsteady rotation of a body resulting from an anxious distribution of mass, expressed as the product of\n    radius and related mass\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-M"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ432#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD206","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD206","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"durch ungleichmäßige Masseverteilung bedingter, unruhiger Lauf rotierender Körper, ausgedrückt als\n    Produkt aus dem Radius und einer zugehörigen Masse\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Unbalance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unbalance","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/Unknown","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Placeholder value used for reference from units where it is not clear what a given unit is a measure of.\n  ","@language":"en"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/NotApplicable"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unknown","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/UpperCriticalMagneticFluxDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Upper Critical Magnetic Flux Density\" for type II superconductors, is the threshold magnetic flux\n    density for disappearance of bulk superconductivity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/GAMMA"},{"@id":"http://qudt.org/vocab/unit/GAUSS"},{"@id":"http://qudt.org/vocab/unit/KiloGAUSS"},{"@id":"http://qudt.org/vocab/unit/KiloT"},{"@id":"http://qudt.org/vocab/unit/MicroT"},{"@id":"http://qudt.org/vocab/unit/MilliT"},{"@id":"http://qudt.org/vocab/unit/NanoT"},{"@id":"http://qudt.org/vocab/unit/T"},{"@id":"http://qudt.org/vocab/unit/T_Ab"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Upper Critical Magnetic Flux Density\" for type II superconductors, is the threshold magnetic flux\n    density for disappearance of bulk superconductivity.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensity"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"B_{c2}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q106127634"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticFluxDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Upper Critical Magnetic Flux Density","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensity"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://qudt.org/vocab/quantitykind/LowerCriticalMagneticFluxDensity"}]},{"@id":