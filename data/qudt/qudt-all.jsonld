http://qudt.org/schema/qudt/symbol":[{"@value":"cg","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Center of Gravity in the Z Axis","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}]},{"@id":"http://qudt.org/vocab/quantitykind/CharacteristicAcousticImpedance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Characteristic impedance at a point in a non-dissipative medium and for a plane progressive wave, the\n    quotient of the sound pressure $p$ by the component of the sound particle velocity $v$ in the direction of the wave\n    propagation.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/N-SEC-PER-M3"},{"@id":"http://qudt.org/vocab/unit/PA-SEC-PER-M"},{"@id":"http://qudt.org/vocab/unit/RAYL"},{"@id":"http://qudt.org/vocab/unit/RAYL_MKS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Acoustic_impedance#Characteristic_acoustic_impedance","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$Z_c = pc$, where $p$ is the sound pressure and $c$ is the phase speed of sound.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificAcousticImpedance"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Z","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q87051330"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"belongs to SOQ-ISO","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificAcousticImpedance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Characteristic Acoustic Impedance","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificAcousticImpedance"}]},{"@id":"http://qudt.org/vocab/quantitykind/CharacteristicNumber","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"quantity of dimension one (as a result of measuring technology theory) which clarifies facts, states or\n    developments and is used as a scale e.g. to represent causes and effects of events\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ279#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Größe der Dimension 1 (als Ergebnis der metrisierenden Messtheorie), die Sachverhalte, Zustände\n    oder Entwicklungen verdeutlicht und als Maßstab dient, um z. B. Ursache und Wirkung von Vorgängen in kausalem Zusammenhang\n    darzustellen\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CharacteristicNumber","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Characteristic Number","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}]},{"@id":"http://qudt.org/vocab/quantitykind/CharacteristicVelocity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Characteristic velocity or $c^{*}$ is a measure of the combustion performance of a rocket engine\n    independent of nozzle performance, and is used to compare different propellants and propulsion systems.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/CentiM-PER-KiloYR"},{"@id":"http://qudt.org/vocab/unit/CentiM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/CentiM-PER-YR"},{"@id":"http://qudt.org/vocab/unit/FT-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/FT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/FT-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/FT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/GigaHZ-M"},{"@id":"http://qudt.org/vocab/unit/IN-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/IN-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/IN-PER-YR"},{"@id":"http://qudt.org/vocab/unit/KN"},{"@id":"http://qudt.org/vocab/unit/KiloM-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/KiloM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/M-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/M-PER-HR"},{"@id":"http://qudt.org/vocab/unit/M-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/M-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/M-PER-YR"},{"@id":"http://qudt.org/vocab/unit/MI-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MI-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MI-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MI_N-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MI_N-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MicroM-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MicroM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-YR"},{"@id":"http://qudt.org/vocab/unit/YD-PER-HR"},{"@id":"http://qudt.org/vocab/unit/YD-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/YD-PER-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$c^{*}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/Velocity"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearVelocity","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:Velocity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Characteristic Velocity","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/Velocity"}]},{"@id":"http://qudt.org/vocab/quantitykind/ChargeNumber","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Charge Number\", or just valance of an ion is the coefficient that, when multiplied by the elementary\n    charge, gives the ion's charge.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Charge_number","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Charge Number\", or just valance of an ion is the coefficient that, when multiplied by the\n    elementary charge, gives the ion's charge.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"z","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1800063"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ChargeNumber","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Charge Number","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}]},{"@id":"http://qudt.org/vocab/quantitykind/ChemicalAffinity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In chemical physics and physical chemistry, \"Chemical Affinity\" is the electronic property by which\n    dissimilar chemical species are capable of forming chemical compounds. Chemical affinity can also refer to the tendency of an\n    atom or compound to combine by chemical reaction with atoms or compounds of unlike composition.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-MOL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Chemical_affinity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$A = -\\sum \\nu_b\\mu_B$, where $\\nu_b$ is the stoichiometric number of substance $B$ and $\\mu_B$ is the chemical potential of substance $B$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In chemical physics and physical chemistry, \"Chemical Affinity\" is the electronic property by which\n    dissimilar chemical species are capable of forming chemical compounds. Chemical affinity can also refer to the tendency of an\n    atom or compound to combine by chemical reaction with atoms or compounds of unlike composition.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"A","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q382783"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ChemicalAffinity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Chemical Affinity","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ChemicalConsumptionPerMass","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM3-PER-GM"},{"@id":"http://qudt.org/vocab/unit/DeciL-PER-GM"},{"@id":"http://qudt.org/vocab/unit/DeciM3-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/FT3-PER-LB"},{"@id":"http://qudt.org/vocab/unit/IN3-PER-LB"},{"@id":"http://qudt.org/vocab/unit/L-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/M3-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MilliL-PER-GM"},{"@id":"http://qudt.org/vocab/unit/MilliL-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MilliM3-PER-GM"},{"@id":"http://qudt.org/vocab/unit/MilliM3-PER-KiloGM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In the context of a chemical durability test, this is measure of how much of a solution (often a\n    corrosive or reactive one) is consumed or used up per unit mass of a material being tested. In other words, this the volume of\n    solution needed to cause a certain level of chemical reaction or damage to a given mass of the material.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificVolume"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificVolume","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Chemical Consumption per Mass","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificVolume"}]},{"@id":"http://qudt.org/vocab/quantitykind/ChemicalPotential","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Chemical Potential\", also known as partial molar free energy, is a form of potential energy that can be\n    absorbed or released during a chemical reaction.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-MOL"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-MOL"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-MOL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Chemical_potential","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mu_B = (\\frac{\\partial G}{\\partial n_B})_{T,p,n_i}$, where $G$ is Gibbs energy, and $n_B$ is the amount of substance $B$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mu_B$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Chemical Potential\", also known as partial molar free energy, is a form of potential energy that\n    can be absorbed or released during a chemical reaction.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MolarEnergy"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q737004"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MolarEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Chemical Potential","@language":"en"},{"@value":"Chemický potenciál","@language":"cs"},{"@value":"Keupayaan kimia","@language":"ms"},{"@value":"Potencjał chemiczny","@language":"pl"},{"@value":"Potențial chimic","@language":"ro"},{"@value":"chemisches Potential des Stoffs B","@language":"de"},{"@value":"kimyasal potansiyel","@language":"tr"},{"@value":"potencial químico","@language":"es"},{"@value":"potencial químico","@language":"pt"},{"@value":"potential chimique","@language":"fr"},{"@value":"potenziale chimico","@language":"it"},{"@value":"Химический потенциал","@language":"ru"},{"@value":"جهد كيميائي","@language":"ar"},{"@value":"پتانسیل شیمیایی","@language":"fa"},{"@value":"化学ポテンシャル","@language":"ja"},{"@value":"化学势","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MolarEnergy"}]},{"@id":"http://qudt.org/vocab/quantitykind/Chromaticity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Chromaticity is an objective specification of the quality of a color regardless of its luminance\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Chromaticity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Chromaticity is an objective specification of the quality of a color regardless of its luminance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Chromaticity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Chromaticity","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Circulation","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In fluid dynamics, circulation is the line integral around a closed curve of the fluid velocity. It has\n    dimensions of length squared over time.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/M2-PER-SEC"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Circulation_%28fluid_dynamics%29","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Gamma$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/AreaPerTime"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In fluid dynamics, circulation is the line integral around a closed curve of the fluid velocity. It\n    has dimensions of length squared over time.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Circulation","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Circulation","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AreaPerTime"}]},{"@id":"http://qudt.org/vocab/quantitykind/ClosestApproachRadius","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ANGSTROM"},{"@id":"http://qudt.org/vocab/unit/AU"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB_F"},{"@id":"http://qudt.org/vocab/unit/CHAIN"},{"@id":"http://qudt.org/vocab/unit/CHAIN_US"},{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/DecaM"},{"@id":"http://qudt.org/vocab/unit/DeciM"},{"@id":"http://qudt.org/vocab/unit/FATH"},{"@id":"http://qudt.org/vocab/unit/FM"},{"@id":"http://qudt.org/vocab/unit/FT"},{"@id":"http://qudt.org/vocab/unit/FT_US"},{"@id":"http://qudt.org/vocab/unit/FUR"},{"@id":"http://qudt.org/vocab/unit/FemtoM"},{"@id":"http://qudt.org/vocab/unit/GAUGE_FR"},{"@id":"http://qudt.org/vocab/unit/GA_Charriere"},{"@id":"http://qudt.org/vocab/unit/HectoM"},{"@id":"http://qudt.org/vocab/unit/IN"},{"@id":"http://qudt.org/vocab/unit/KiloM"},{"@id":"http://qudt.org/vocab/unit/LY"},{"@id":"http://qudt.org/vocab/unit/M"},{"@id":"http://qudt.org/vocab/unit/MI"},{"@id":"http://qudt.org/vocab/unit/MI_N"},{"@id":"http://qudt.org/vocab/unit/MI_UK"},{"@id":"http://qudt.org/vocab/unit/MI_US"},{"@id":"http://qudt.org/vocab/unit/MicroIN"},{"@id":"http://qudt.org/vocab/unit/MicroM"},{"@id":"http://qudt.org/vocab/unit/MilLength"},{"@id":"http://qudt.org/vocab/unit/MilliIN"},{"@id":"http://qudt.org/vocab/unit/MilliM"},{"@id":"http://qudt.org/vocab/unit/NanoM"},{"@id":"http://qudt.org/vocab/unit/PARSEC"},{"@id":"http://qudt.org/vocab/unit/PCA"},{"@id":"http://qudt.org/vocab/unit/PT"},{"@id":"http://qudt.org/vocab/unit/PicoM"},{"@id":"http://qudt.org/vocab/unit/PlanckLength"},{"@id":"http://qudt.org/vocab/unit/ROD"},{"@id":"http://qudt.org/vocab/unit/YD"},{"@id":"http://qudt.org/vocab/unit/ZOLL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Radius"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"r_o","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Closest Approach Radius","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Radius"}]},{"@id":"http://qudt.org/vocab/quantitykind/CoefficientOfHeatTransfer","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Coefficient of Heat Transfer\", in thermodynamics and in mechanical and chemical engineering, is used in\n    calculating the heat transfer, typically by convection or phase transition between a fluid and a solid. The heat transfer\n    coefficient is the proportionality coefficient between the heat flux, that is heat flow per unit area, q/A, and the\n    thermodynamic driving force for the flow of heat (that is, the temperature difference, (Delta T).  Areic heat flow rate\n    divided by thermodynamic temperature difference. In building technology, the \"Coefficient of Heat Transfer\", is often called\n    \"thermal transmittance}\" with the symbol \"U\". It has SI units in watts per squared meter kelvin.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSIUnit":[{"@id":"http://qudt.org/vocab/unit/W-PER-M2-K"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-FT2-HR-DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-FT2-SEC-DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-HR-FT2-DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-HR-FT2-DEG_R"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-SEC-FT2-DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-SEC-FT2-DEG_R"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-HR-FT2-DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-SEC-FT2-DEG_F"},{"@id":"http://qudt.org/vocab/unit/CAL_IT-PER-SEC-CentiM2-K"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-SEC-CentiM2-K"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-SEC3-K"},{"@id":"http://qudt.org/vocab/unit/KiloW-PER-M2-K"},{"@id":"http://qudt.org/vocab/unit/W-PER-M2-K"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$heat-xfer-coeff$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H-1T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Heat_transfer_coefficient","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"\"Coefficient of Heat Transfer\", in thermodynamics and in mechanical and chemical engineering, is used in calculating the heat transfer, typically by convection or phase transition between a fluid and a solid. The heat transfer coefficient is the proportionality coefficient between the heat flux, that is heat flow per unit area, $q/A$, and the thermodynamic driving force for the flow of heat (that is, the temperature difference, $ \\bigtriangleup T $).  Areic heat flow rate divided by thermodynamic temperature difference. In building technology, the $\\textit{Coefficient of Heat Transfer}$, is often called $\\textit{thermal transmittance}$, with the symbol $U$. $\\textit{Coefficient of Heat Transfer}$, has SI units in watts per squared meter kelvin: $W/(m^2 \\cdot K)$ .\n\n$K = \\frac{\\varphi}{T}$, where $\\varphi$ is areic heat flow rate and $T$ is thermodynamic temperature difference.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\kappa$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Coefficient of Heat Transfer\", in thermodynamics and in mechanical and chemical engineering, is\n    used in calculating the heat transfer, typically by convection or phase transition between a fluid and a solid. The heat\n    transfer coefficient is the proportionality coefficient between the heat flux, that is heat flow per unit area, q/A, and the\n    thermodynamic driving force for the flow of heat (that is, the temperature difference, (Delta T).  Areic heat flow rate\n    divided by thermodynamic temperature difference. In building technology, the \"Coefficient of Heat Transfer\", is often called\n    \"thermal transmittance}\" with the symbol \"U\". It has SI units in watts per squared meter kelvin.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CoefficientOfHeatTransfer","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Coefficient of Heat Transfer","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/CoefficientOfPerformance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Coefficient of Performance\" is a measure of the efficiency of a heating or cooling system, defined as\n    the ratio of useful heating or cooling output to the energy input required to achieve it.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableSIUnit":[{"@id":"http://qudt.org/vocab/unit/NUM"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Coefficient_of_performance#:~:text=The%20coefficient%20of%20performance%20or,and%20thus%20lower%20operating%20costs.","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Coefficient of Performance\" is a measure of the efficiency of a heating or cooling system,\n    defined as the ratio of useful heating or cooling output to the energy input required to achieve it.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"COP","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CoefficientOfPerformance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Coefficient of Performance","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/Coercivity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Coercivity}$, also referred to as $\\textit{Coercive Field Strength}$, is the magnetic field\n    strength to be applied to bring the magnetic flux density in a substance from its remaining magnetic flux density to zero.\n    This is defined as the coercive field strength in a substance when either the magnetic flux density or the magnetic\n    polarization and magnetization is brought from its value at magnetic saturation to zero by monotonic reduction of the applied\n    magnetic field strength. The quantity which is brought to zero should be stated, and the appropriate symbol used: $H_{cB}$,\n    $H_{cJ}$ or $H_{cM}$ for the coercivity relating to the magnetic flux density, the magnetic polarization or the magnetization\n    respectively, where $H_{cJ} = H_{cM}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/A-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/AT-PER-IN"},{"@id":"http://qudt.org/vocab/unit/AT-PER-M"},{"@id":"http://qudt.org/vocab/unit/KiloA-PER-M"},{"@id":"http://qudt.org/vocab/unit/MilliA-PER-IN"},{"@id":"http://qudt.org/vocab/unit/MilliA-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/OERSTED"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-12-69","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFieldStrength"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"H_{c,B}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q432635"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticFieldStrength","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Coercivity","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFieldStrength"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFieldStrength"}]},{"@id":"http://qudt.org/vocab/quantitykind/CoherenceLength","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Coherence Length\" characterizes the distance in a superconductor over which the effect of a perturbation\n    is appreciable.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ANGSTROM"},{"@id":"http://qudt.org/vocab/unit/AU"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB_F"},{"@id":"http://qudt.org/vocab/unit/CHAIN"},{"@id":"http://qudt.org/vocab/unit/CHAIN_US"},{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/DecaM"},{"@id":"http://qudt.org/vocab/unit/DeciM"},{"@id":"http://qudt.org/vocab/unit/FATH"},{"@id":"http://qudt.org/vocab/unit/FM"},{"@id":"http://qudt.org/vocab/unit/FT"},{"@id":"http://qudt.org/vocab/unit/FT_US"},{"@id":"http://qudt.org/vocab/unit/FUR"},{"@id":"http://qudt.org/vocab/unit/FemtoM"},{"@id":"http://qudt.org/vocab/unit/GAUGE_FR"},{"@id":"http://qudt.org/vocab/unit/GA_Charriere"},{"@id":"http://qudt.org/vocab/unit/HectoM"},{"@id":"http://qudt.org/vocab/unit/IN"},{"@id":"http://qudt.org/vocab/unit/KiloM"},{"@id":"http://qudt.org/vocab/unit/LY"},{"@id":"http://qudt.org/vocab/unit/M"},{"@id":"http://qudt.org/vocab/unit/MI"},{"@id":"http://qudt.org/vocab/unit/MI_N"},{"@id":"http://qudt.org/vocab/unit/MI_UK"},{"@id":"http://qudt.org/vocab/unit/MI_US"},{"@id":"http://qudt.org/vocab/unit/MicroIN"},{"@id":"http://qudt.org/vocab/unit/MicroM"},{"@id":"http://qudt.org/vocab/unit/MilLength"},{"@id":"http://qudt.org/vocab/unit/MilliIN"},{"@id":"http://qudt.org/vocab/unit/MilliM"},{"@id":"http://qudt.org/vocab/unit/NanoM"},{"@id":"http://qudt.org/vocab/unit/PARSEC"},{"@id":"http://qudt.org/vocab/unit/PCA"},{"@id":"http://qudt.org/vocab/unit/PT"},{"@id":"http://qudt.org/vocab/unit/PicoM"},{"@id":"http://qudt.org/vocab/unit/PlanckLength"},{"@id":"http://qudt.org/vocab/unit/ROD"},{"@id":"http://qudt.org/vocab/unit/YD"},{"@id":"http://qudt.org/vocab/unit/ZOLL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Coherence_length","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Coherence Length\" characterizes the distance in a superconductor over which the effect of a\n    perturbation is appreciable.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"ξ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q7643174"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Coherence Length","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}]},{"@id":"http://qudt.org/vocab/quantitykind/ColdReceptorThreshold","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Cold Receptor Threshold\" is the threshold of cold-sensitive free nerve-ending.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_C"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\overline{T_c}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Cold Receptor Threshold\" is the threshold of cold-sensitive free nerve-ending.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ColdReceptorThreshold","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Cold Receptor Threshold","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/CombinedNonEvaporativeHeatTransferCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloW-PER-M2-K"},{"@id":"http://qudt.org/vocab/unit/W-PER-M2-K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H-1T-3D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$h = h_r + h_c + h_k$, where $h_r$ is the linear radiative heat transfer coefficient, $h_c$ is the convective heat transfer coefficient, and $h_k$ is the conductive heat transfer coefficient.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"h","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CombinedNonEvaporativeHeatTransferCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Combined Non Evaporative Heat Transfer Coefficient","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/CommonLogarithmicMedianInformationFlow","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio of the median information content divided by the expected value for the duration of a character,\n    expressed as a logarithm to base 10\n  ","@language":"en"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/InformationFlowRate"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.5.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ470#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient mittlerer Informationsgehalt durch den Erwartungswert für die Dauer eines Zeichens,\n    ausgedrückt als Logarithmus zur Basis 10\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Median Information Flow (from a Source of Information), Expressed as a Common Logarithm ","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/ComplexFrequency_Imaginary","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CYC-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/GigaHZ"},{"@id":"http://qudt.org/vocab/unit/HZ"},{"@id":"http://qudt.org/vocab/unit/HectoHZ"},{"@id":"http://qudt.org/vocab/unit/KiloHZ"},{"@id":"http://qudt.org/vocab/unit/MegaHZ"},{"@id":"http://qudt.org/vocab/unit/MilliHZ"},{"@id":"http://qudt.org/vocab/unit/PER-DAY"},{"@id":"http://qudt.org/vocab/unit/PER-HR"},{"@id":"http://qudt.org/vocab/unit/PER-MIN"},{"@id":"http://qudt.org/vocab/unit/PER-MO"},{"@id":"http://qudt.org/vocab/unit/PER-MilliSEC"},{"@id":"http://qudt.org/vocab/unit/PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PER-WK"},{"@id":"http://qudt.org/vocab/unit/PER-YR"},{"@id":"http://qudt.org/vocab/unit/PERCENT-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/PERCENT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/PERCENT-PER-MO"},{"@id":"http://qudt.org/vocab/unit/PPTH-PER-HR"},{"@id":"http://qudt.org/vocab/unit/PetaHZ"},{"@id":"http://qudt.org/vocab/unit/PlanckFrequency"},{"@id":"http://qudt.org/vocab/unit/TeraHZ"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Frequency"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Frequency","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Imaginary Part of Complex Frequency","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Frequency"}]},{"@id":"http://qudt.org/vocab/quantitykind/ComplexFrequency_Real","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CYC-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/GigaHZ"},{"@id":"http://qudt.org/vocab/unit/HZ"},{"@id":"http://qudt.org/vocab/unit/HectoHZ"},{"@id":"http://qudt.org/vocab/unit/KiloHZ"},{"@id":"http://qudt.org/vocab/unit/MegaHZ"},{"@id":"http://qudt.org/vocab/unit/MilliHZ"},{"@id":"http://qudt.org/vocab/unit/PER-DAY"},{"@id":"http://qudt.org/vocab/unit/PER-HR"},{"@id":"http://qudt.org/vocab/unit/PER-MIN"},{"@id":"http://qudt.org/vocab/unit/PER-MO"},{"@id":"http://qudt.org/vocab/unit/PER-MilliSEC"},{"@id":"http://qudt.org/vocab/unit/PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PER-WK"},{"@id":"http://qudt.org/vocab/unit/PER-YR"},{"@id":"http://qudt.org/vocab/unit/PERCENT-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/PERCENT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/PERCENT-PER-MO"},{"@id":"http://qudt.org/vocab/unit/PPTH-PER-HR"},{"@id":"http://qudt.org/vocab/unit/PetaHZ"},{"@id":"http://qudt.org/vocab/unit/PlanckFrequency"},{"@id":"http://qudt.org/vocab/unit/TeraHZ"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD199","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD199","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Frequency"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Frequency","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Real Part of Complex Frequency","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Frequency"}]},{"@id":"http://qudt.org/vocab/quantitykind/ComplexPower","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Complex Power}$, under sinusoidal conditions, is the product of the phasor $\\mathbf{U}$\n    representing the voltage between the terminals of a linear two-terminal element, or two-terminal circuit and the complex\n    conjugate of the phasor $I$ representing the electric current in the element or circuit.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricPower"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$complex-power$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-11-39","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\underline{S} = \\underline{U}\\underline{I^*}$, where $\\underline{U}$ is voltage phasor and $\\underline{I^*}$ is the complex conjugate of the current phasor.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\underline{S}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q65239736"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Complex Power","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPhasor"},{"@id":"http://qudt.org/vocab/quantitykind/VoltagePhasor"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricPower"}]},{"@id":"http://qudt.org/vocab/quantitykind/CompoundPlaneAngle","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A \"Compound Plane Angle\" is a compound measure of plane angle in degrees, minutes, seconds, and\n    optionally millionth-seconds of arc.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ARCMIN"},{"@id":"http://qudt.org/vocab/unit/ARCSEC"},{"@id":"http://qudt.org/vocab/unit/DEG"},{"@id":"http://qudt.org/vocab/unit/GON"},{"@id":"http://qudt.org/vocab/unit/GRAD"},{"@id":"http://qudt.org/vocab/unit/MIL_Angle"},{"@id":"http://qudt.org/vocab/unit/MIN_Angle"},{"@id":"http://qudt.org/vocab/unit/MicroRAD"},{"@id":"http://qudt.org/vocab/unit/MilliARCSEC"},{"@id":"http://qudt.org/vocab/unit/MilliRAD"},{"@id":"http://qudt.org/vocab/unit/RAD"},{"@id":"http://qudt.org/vocab/unit/REV"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://standards.buildingsmart.org/IFC/DEV/IFC4_2/FINAL/HTML/link/ifccompoundplaneanglemeasure.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A \"Compound Plane Angle\" is a compound measure of plane angle in degrees, minutes, seconds, and\n    optionally millionth-seconds of arc.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Angle","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:PlaneAngle","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Compound Plane Angle","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}]},{"@id":"http://qudt.org/vocab/quantitykind/Compressibility","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Compressibility is a measure of the relative volume change of a fluid or solid as a response to a\n    pressure (or mean stress) change.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/M2-PER-N"},{"@id":"http://qudt.org/vocab/unit/PER-BAR"},{"@id":"http://qudt.org/vocab/unit/PER-MegaPA"},{"@id":"http://qudt.org/vocab/unit/PER-PA"},{"@id":"http://qudt.org/vocab/unit/PERCENT-PER-BAR"},{"@id":"http://qudt.org/vocab/unit/PERCENT-PER-HectoBAR"},{"@id":"http://qudt.org/vocab/unit/PERMILLE-PER-PSI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ374#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD024","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD024","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Compressibility","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\chi = -(\\frac{1}{V})\\frac{dV}{d\\rho}$, where $V$ is volume and $p$ is pressure.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\chi$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Compressibility is a measure of the relative volume change of a fluid or solid as a response to a\n    pressure (or mean stress) change.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q8067817"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Compressibility","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Compressibility","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/CompressibilityFactor","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The compressibility factor ($Z$) is a useful thermodynamic property for modifying the ideal gas law to\n    account for the real gas behaviour. The closer a gas is to a phase change, the larger the deviations from ideal behavior. It\n    is simply defined as the ratio of the molar volume of a gas to the molar volume of an ideal gas at the same temperature and\n    pressure. Values for compressibility are calculated using equations of state (EOS), such as the virial equation and van der\n    Waals equation. The compressibility factor for specific gases can be obtained, with out calculation, from compressibility\n    charts. These charts are created by plotting Z as a function of pressure at constant temperature.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Z","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CompressibilityFactor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Compressibility Factor","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/Concentration","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In chemistry, concentration is defined as the abundance of a constituent divided by the total volume of a\n    mixture. Furthermore, in chemistry, four types of mathematical description can be distinguished: mass concentration, molar\n    concentration, number concentration, and volume concentration. The term concentration can be applied to any kind of chemical\n    mixture, but most frequently it refers to solutes in solutions.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/FemtoMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/KiloMOL-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-DeciM3"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MicroMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/MilliMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/MilliMOL-PER-M3"},{"@id":"http://qudt.org/vocab/unit/NanoMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/PicoMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/PicoMOL-PER-M3"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Concentration","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L-3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Concentration","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In chemistry, concentration is defined as the abundance of a constituent divided by the total\n    volume of a mixture. Furthermore, in chemistry, four types of mathematical description can be distinguished: mass\n    concentration, molar concentration, number concentration, and volume concentration. The term concentration can be applied to\n    any kind of chemical mixture, but most frequently it refers to solutes in solutions.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q3686031"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Concentration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Concentration","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Conductance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Conductance}$, for a resistive two-terminal element or two-terminal circuit with terminals A\n    and B, quotient of the electric current i in the element or circuit by the voltage $u_{AB}$ between the terminals: $G =\n    \\frac{1}{R}$, where the electric current is taken as positive if its direction is from A to B and negative in the opposite\n    case. The conductance of an element or circuit is the inverse of its resistance.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DeciS"},{"@id":"http://qudt.org/vocab/unit/KiloS"},{"@id":"http://qudt.org/vocab/unit/MHO"},{"@id":"http://qudt.org/vocab/unit/MegaS"},{"@id":"http://qudt.org/vocab/unit/MicroMHO"},{"@id":"http://qudt.org/vocab/unit/MicroS"},{"@id":"http://qudt.org/vocab/unit/MilliS"},{"@id":"http://qudt.org/vocab/unit/NanoS"},{"@id":"http://qudt.org/vocab/unit/PicoS"},{"@id":"http://qudt.org/vocab/unit/S"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricalConductance"},{"@id":"http://qudt.org/vocab/quantitykind/ReciprocalElectricResistance"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E2L-2I0M-1H0T3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-12-06","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$G = Re\\underline{Y}$, where $\\underline{Y}$ is admittance.\n\nAlternatively:\n\n$G = \\frac{1}{R}$, where $R$ is resistance.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"G","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Conductance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Conductance","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/Admittance"}]},{"@id":"http://qudt.org/vocab/quantitykind/ConductionSpeed","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Conduction Speed\" is the speed of impulses in nerve fibers.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloHZ-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Conduction Speed\" is the speed of impulses in nerve fibers.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Speed"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"c","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ConductionSpeed","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Conduction Speed","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Speed"}]},{"@id":"http://qudt.org/vocab/quantitykind/ConductiveHeatTransferRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Conductive Heat Transfer Rate\" is proportional to temperature gradient and area of contact.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloCAL_TH-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloCAL_TH-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloCAL_TH-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/THM_US-PER-HR"},{"@id":"http://qudt.org/vocab/unit/TON_FG"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Phi_k$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Conductive Heat Transfer Rate\" is proportional to temperature gradient and area of contact.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/HeatFlowRate"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:HeatFlowRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Conductive Heat Transfer Rate","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/HeatFlowRate"}]},{"@id":"http://qudt.org/vocab/quantitykind/Conductivity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Conductivity}$ is a scalar or tensor quantity the product of which by the electric field\n    strength in a medium is equal to the electric current density. For an isotropic medium the conductivity is a scalar quantity;\n    for an anisotropic medium it is a tensor quantity. $$\\mathbf{J} = \\sigma \\mathbf{E}$$ Where $\\mathbf{J}$ is electric\n    current density, and $\\mathbf{E}$ is electric field strength.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricConductivity"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.11","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ329#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E2L-3I0M-1H0T3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD025","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-12-03","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD025","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mathbf{J} = \\sigma \\mathbf{E}$, where $\\mathbf{J}$ is electric current density, and $\\mathbf{E}$ is electric field strength.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\gamma$","@type":"http://qudt.org/schema/qudt/LatexString"},{"@value":"$\\sigma$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Conductivity\" is a scalar or tensor quantity the product of which by the electric field strength\n    in a medium is equal to the electric current density. For an isotropic medium the conductivity is a scalar quantity; for an\n    anisotropic medium it is a tensor quantity.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Conductivity","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentDensity"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricFieldStrength"}]},{"@id":"http://qudt.org/vocab/quantitykind/ConductivityVariance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Variance for conductivity data.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MicroS2-PER-CentiM2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E4L-6I0M-2H0T6D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://www.neonscience.org/data-samples/data-management/data-processing","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Variance for conductivity data.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ConductivityVariance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Conductivity Variance","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ConductivityVariance_NEON","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Variance for NEON conductivity data measured in MicroS-PER-CM","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/ConductivityVariance"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E4L-6I0M-2H0T6D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://www.neonscience.org/data-samples/data-management/data-processing","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Variance for NEON conductivity data measured in MicroS-PER-CM","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Conductivity Variance, NEON","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Constringence","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In optics and lens design, constringence of a transparent material, also known as the Abbe number or the\n    V-number, is an approximate measure of the material's dispersion (change of refractive index versus wavelength), with high\n    values of V indicating low dispersion.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Abbe_number","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"V","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Constringence","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Constringence","@language":"en"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Abbe Number","@language":"en"},{"@value":"V-number","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/ConvectiveHeatTransfer","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Convective Heat Transfer\" is convective heat transfer coefficient multiplied by temperature difference\n    and exchange area.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloCAL_TH-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloCAL_TH-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloCAL_TH-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/THM_US-PER-HR"},{"@id":"http://qudt.org/vocab/unit/TON_FG"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Heat_transfer#Convection","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Phi_c$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Convective Heat Transfer\" is convective heat transfer coefficient multiplied by temperature\n    difference and exchange area.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/HeatFlowRate"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:HeatFlowRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Convective Heat Transfer","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/HeatFlowRate"}]},{"@id":"http://qudt.org/vocab/quantitykind/CoolingPerformanceRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloW-PER-TON_FG"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Ratio of input power to delivered cooling capacity, used to assess the efficiency of cooling\n    systems such as chillers. Commonly expressed in kW per ton of refrigeration, where lower values indicate better performance.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CoolingPerformanceRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Cooling Performance Ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/CorrelatedColorTemperature","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Correlated color temperature (CCT) is a measure of light source color appearance defined by the proximity\n    of the light source's chromaticity coordinates to the blackbody locus, as a single number rather than the two required to\n    specify a chromaticity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DecaK"},{"@id":"http://qudt.org/vocab/unit/K"},{"@id":"http://qudt.org/vocab/unit/MegaK"},{"@id":"http://qudt.org/vocab/unit/MilliK"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://www.lrc.rpi.edu/programs/NLPIP/lightingAnswers/pdf/print/lightSources.pdf","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Correlated color temperature (CCT) is a measure of light source color appearance defined by the\n    proximity of the light source's chromaticity coordinates to the blackbody locus, as a single number rather than the two\n    required to specify a chromaticity.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ThermodynamicTemperature"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CorrelatedColorTemperature","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Correlated Color Temperature","@language":"en-us"},{"@value":"Correlated Colour Temperature","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/Duv"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ThermodynamicTemperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/CostPerArea","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CCY_CHF-PER-HA"},{"@id":"http://qudt.org/vocab/unit/CCY_EUR-PER-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://www.designingbuildings.co.uk/wiki/Cost_per_m2_of_gross_internal_floor_area","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In the construction industry, cost per area is the unit rate which, when multiplied by the gross\n    internal floor area (GIFA), gives the total building works estimate (i.e.works cost estimate less main contractor’s\n    preliminaries and main contractor’s overheads and profit).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CostPerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Cost per Area","@language":"en"},{"@value":"Kosten pro Fläche","@language":"de"}]},{"@id":"http://qudt.org/vocab/quantitykind/CostPerEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CCY_BGN-PER-KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/CCY_CHF-PER-KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/CCY_CZK-PER-KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/CCY_DKK-PER-KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/CCY_EUR-PER-KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/CCY_EUR-PER-W-HR"},{"@id":"http://qudt.org/vocab/unit/CCY_EUR-PER-W-SEC"},{"@id":"http://qudt.org/vocab/unit/CCY_GBP-PER-KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/CCY_HUF-PER-KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/CCY_NOK-PER-KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/CCY_PLN-PER-KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/CCY_RON-PER-KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/CCY_SEK-PER-KiloW-HR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Cost_of_electricity_by_source","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The monetary cost of a unit of energy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CostPerEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Energiekosten","@language":"de"},{"@value":"Energy Cost","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/CostPerMass","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CCY_CHF-PER-KiloGM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Represents the cost associated with a unit mass of a substance or material. It is typically used in\n    economic and engineering contexts to evaluate the expense incurred per kilogram, gram, or other units of mass. This measure\n    helps in comparing the economic efficiency of different materials or substances based on their mass.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CostPerMass","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Cost per Mass","@language":"en"},{"@value":"Kosten pro Masse","@language":"de"}]},{"@id":"http://qudt.org/vocab/quantitykind/CostPerPower","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CCY_EUR-PER-KiloW"},{"@id":"http://qudt.org/vocab/unit/CCY_EUR-PER-W"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M-1H0T3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Photovoltaics","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In photovoltaics, cost per power of electricity produced measures the cost of installing the\n    hardware relative to the power produced.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CostPerPower","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Anschaffungskosten pro Watt","@language":"de"},{"@value":"Cost per Power","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Count","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Count\" is the value of a count of items.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/COUNT"},{"@id":"http://qudt.org/vocab/unit/NUM"},{"@id":"http://qudt.org/vocab/unit/PIXEL_COUNT"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Count\" is the value of a count of items.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Count","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Count","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/CountRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A measure of a number of items counted per time period.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/NUM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-YR"},{"@id":"http://qudt.org/vocab/unit/SAMPLE-PER-SEC"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ206#006","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://standards.buildingsmart.org/IFC/RELEASE/IFC4/ADD2/HTML/link/ifcintegercountratemeasure.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"This measure may be used for measuring integer units per second or per hour. For example, it may be\n    used to measure the number of books per hour passing along a part of a mechanical book handling system, the number of people\n    per hour travelling along a moving walkway or the number of vehicles per hour travelling along a section of road.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CountRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Count Rate","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/CouplingFactor","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Coupling Factor\" is the ratio of an electromagnetic quantity, usually voltage or current, appearing at a\n    specified location of a given circuit to the corresponding quantity at a specified location in the circuit from which energy\n    is transferred by coupling.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=161-03-18","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"For inductive coupling between two inductive elements, $k = \\frac{\\left | L_{mn} \\right |}{\\sqrt{L_m L_n}}$, where $L_m$ and $L_n$ are their self inductances, and $L_{mn}$ is their mutual inductance.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Coupling Factor\" is the ratio of an electromagnetic quantity, usually voltage or current,\n    appearing at a specified location of a given circuit to the corresponding quantity at a specified location in the circuit from\n    which energy is transferred by coupling.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"k","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CouplingFactor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Constantă de cuplaj","@language":"ro"},{"@value":"Coupling Factor","@language":"en"},{"@value":"constante de acoplamiento","@language":"es"},{"@value":"constante de couplage","@language":"fr"},{"@value":"fattore di accoppiamento","@language":"it"},{"@value":"stała sprzężenia","@language":"pl"},{"@value":"Çiftlenim sabiti","@language":"tr"},{"@value":"Константа взаимодействия","@language":"ru"},{"@va