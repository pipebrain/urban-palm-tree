//qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"DWT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1361854"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Penny Weight","@language":"en"},{"@value":"Penny Weight","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/DYN","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"In physics, the $dyne$ is a unit of force specified in the centimetre-gram-second (CGS) system of units.\n    The $dyne$ is a unit of force specified in the centimetre-gram-second (CGS) system of units. One $dyne$ is equal to\n    $\\SI{10}{\\micro\\newton}$. Equivalently, the $dyne$ is defined as 'the force required to accelerate a mass of one gram at a\n    rate of one centimetre per square second'. A $\\textit{dyne per centimetre}$ is the unit traditionally used to measure surface\n    tension.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.00001","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E-5","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Dyne","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qud