"],"http://purl.org/dc/terms/description":[{"@value":"\"Mass Equivalent\" is the mass of a substance that reacts with (or is equivalent to) an arbitrary mass of \nanother substance in a given chemical reaction.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/MassEquivalent"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Equivalent","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}]},{"@id":"http://qudt.org/vocab/quantitykind/Equivalent_Molar","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Molar Equivalent\" is the amount of a substance that reacts with (or is equivalent to) an arbitrary\n    amount (typically one mole) of another substance in a given chemical reaction.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/MolarEquivalent"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Equivalent_(chemistry)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"equiv","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Equivalent","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstance"}]},{"@id":"http://qudt.org/vocab/quantitykind/EvaporativeHeatTransfer","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Evaporative Heat Transfer\" is the heat flow rate due to evaporation, given by the evaporative heat\n    transfer coefficient multiplied by the water-vapour partial pressure difference and the surface area.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloCAL_TH-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloCAL_TH-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloCAL_TH-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/THM_US-PER-HR"},{"@id":"http://qudt.org/vocab/unit/TON_FG"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Phi_e$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Evaporative Heat Transfer\" is the heat flow rate due to evaporation, given by the evaporative heat\n    transfer coefficient multiplied by the water-vapour partial pressure difference and the surface area.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/HeatFlowRate"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:HeatFlowRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Evaporative Heat Transfer","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/HeatFlowRate"}]},{"@id":"http://qudt.org/vocab/quantitykind/EvaporativeHeatTransferCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Evaporative Heat Transfer Coefficient\" is the areic heat transfer coefficient multiplied by the water\n    vapour pressure difference between skin and the environment, and by the exchange area.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/W-PER-M2-PA"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Evaporative Heat Transfer Coefficient\" is the areic heat transfer coefficient multiplied by the\n    water vapour pressure difference between skin and the environment, and by the exchange area.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"h_e","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EvaporativeHeatTransferCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Evaporative Heat Transfer Coefficient","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ExchangeIntegral","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Exchange Integral\" is the constituent of the interaction energy between the spins of adjacent electrons\n    in matter arising from the overlap of electron state functions.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J"},{"@id":"http://qudt.org/vocab/unit/NanoJ"},{"@id":"http://qudt.org/vocab/unit/PicoJ"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Exchange_interaction","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Exchange Integral\" is the constituent of the interaction energy between the spins of adjacent\n    electrons in matter arising from the overlap of electron state functions.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"K","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q10882959"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ExchangeIntegral","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Exchange Integral","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}]},{"@id":"http://qudt.org/vocab/quantitykind/ExpansionRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/M-PER-DEG_C-M"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-DEG_C-M"},{"@id":"http://qudt.org/vocab/unit/PER-DEG_F"},{"@id":"http://qudt.org/vocab/unit/PER-K"},{"@id":"http://qudt.org/vocab/unit/PER-MegaK"},{"@id":"http://qudt.org/vocab/unit/PPM-PER-K"},{"@id":"http://qudt.org/vocab/unit/PPTM-PER-K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H-1T0D0"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/InverseTemperature"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ExpansionRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Expansion Ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/InverseTemperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/Exposure","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Exposure\" reflects the extent of ionization events taking place when air is irradiated by ionizing\n    photons (gamma radiation and/or x rays). In photography, exposure is the amount of light allowed to fall on each area unit of\n    a photographic medium (photographic film or image sensor) during the process of taking a photograph. Exposure is measured in\n    lux seconds, and can be computed from exposure value (EV) and scene luminance in a specified region.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-HR-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/A-M2-PER-J-SEC"},{"@id":"http://qudt.org/vocab/unit/C-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/HZ-PER-T"},{"@id":"http://qudt.org/vocab/unit/KiloR"},{"@id":"http://qudt.org/vocab/unit/MegaHZ-PER-T"},{"@id":"http://qudt.org/vocab/unit/MilliC-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MilliR"},{"@id":"http://qudt.org/vocab/unit/PER-T-SEC"},{"@id":"http://qudt.org/vocab/unit/R"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Exposure","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ExposureOfIonizingRadiation"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M-1H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD149","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://hps.org/publicinformation/ate/faqs/gammaandexposure.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD149","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Exposure_%28photography%29","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"For X-or gamma radiation, $X = \\frac{dQ}{dm}$, where $dQ$ is the absolute value of the mean total electric charge of the ions of the same sign produced in dry air when all the electrons and positrons liberated or created by photons in an element of air are completely stopped in air, and $dm$ is the mass of that element.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Exposure\" reflects the extent of ionization events taking place when air is irradiated by ionizing\n    photons (gamma radiation and/or x rays). In photography, exposure is the amount of light allowed to fall on each area unit of\n    a photographic medium (photographic film or image sensor) during the process of taking a photograph. Exposure is measured in\n    lux seconds, and can be computed from exposure value (EV) and scene luminance in a specified region.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/XPOS"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerMass"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"X","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q336938"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricChargePerMass","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Exposure","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerMass"}]},{"@id":"http://qudt.org/vocab/quantitykind/ExposureOfIonizingRadiation","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"measure of an electromagnetic radiation field to which a material is exposed in terms of ionization,\n    which the radiation produces as reference material air, expressed as ratio of ∂Q and ∂m, where ∂Q is the absolute value of the\n    total charge of the ions of one sign produced in the air of mass ∂m when all of the electrons (and positrons) liberated by\n    photons in this mass element are completely stopped\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-HR-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/A-M2-PER-J-SEC"},{"@id":"http://qudt.org/vocab/unit/C-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/HZ-PER-T"},{"@id":"http://qudt.org/vocab/unit/KiloR"},{"@id":"http://qudt.org/vocab/unit/MegaHZ-PER-T"},{"@id":"http://qudt.org/vocab/unit/MilliC-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MilliR"},{"@id":"http://qudt.org/vocab/unit/PER-T-SEC"},{"@id":"http://qudt.org/vocab/unit/R"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ326#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/Exposure"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M-1H0T1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Maß für die Wirkung eines elektromagnetischen Feldes auf Materie in Form der Ionisation, die die\n    Strahlung im Referenzmaterial Luft erzeugt, ausgedrückt als Quotient aus ∂Q und ∂m, wobei ∂Q der Absolutwert der gesamten\n    elektrischen Ladung der Ionen eines Vorzeichens ist, die in Luft der Masse ∂m gebildet wird, wenn in diesem Massenelement alle\n    Elektronen (und Positronen), die durch die Photonen freigesetzt werden, komplett gestoppt werden\n  ","@language":"de"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerMass"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricChargePerMass","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Exposure of Ionizing Radiation","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerMass"}]},{"@id":"http://qudt.org/vocab/quantitykind/ExposureRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Exposure Rate\" expresses the rate of charge production per unit mass of air and is commonly expressed in\n    roentgens per hour (R/h) or milliroentgens per hour (mR/h).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/C-PER-KiloGM-SEC"},{"@id":"http://qudt.org/vocab/unit/R-PER-SEC"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ExposureRateOfIonizingRadiation"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD050","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://hps.org/publicinformation/ate/faqs/gammaandexposure.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD050","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\dot{X} = \\frac{dX}{dt}$, where $X$ is the increment of exposure during time interval with duration $t$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\dot{X}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Exposure Rate\" expresses the rate of charge production per unit mass of air and is commonly\n    expressed in roentgens per hour (R/h) or milliroentgens per hour (mR/h).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q99720212"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ExposureRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Exposure Rate","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ExposureRateOfIonizingRadiation","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio between the exposure of ionizing radiation dJ in a time interval and the duration dt of this interval","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/C-PER-KiloGM-SEC"},{"@id":"http://qudt.org/vocab/unit/R-PER-SEC"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ327#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ExposureRate"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient Ionendosis dJ in einem Zeitintervall durch Dauer dt dieses Zeitintervalls","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ExposureRateOfIonizingRadiation","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Exposure Rate of Ionizing Radiation","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/ExtentOfReaction","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In physical chemistry, the \"Extent of Reaction\" is a quantity that measures the extent in which the\n    reaction proceeds.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiMOL"},{"@id":"http://qudt.org/vocab/unit/FemtoMOL"},{"@id":"http://qudt.org/vocab/unit/MOL"},{"@id":"http://qudt.org/vocab/unit/NanoMOL"},{"@id":"http://qudt.org/vocab/unit/PicoMOL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Extent_of_reaction","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$dn_B = \\nu_B d\\xi$, where $n_B$ is the amount of substance $B$ and $\\nu_B$ is the stoichiometric number of substance $B$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\xi$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In physical chemistry, the \"Extent of Reaction\" is a quantity that measures the extent in which the\n    reaction proceeds.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstance"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q899046"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ExtentOfReaction","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Extent of Reaction","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstance"}]},{"@id":"http://qudt.org/vocab/quantitykind/FLIGHT-PERFORMANCE-RESERVE-PROPELLANT-MASS","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A quantity of propellant, at a nominal mixture ratio, along with fuel bias that is set aside from total\n    propellant loaded to cover for statistical variations of flight hardware characteristics and environment conditions on the day\n    of launch. The launch vehicle is designed to accommodate the maximum FPR loading.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A quantity of propellant, at a nominal mixture ratio, along with fuel bias that is set aside from\n    total propellant loaded to cover for statistical variations of flight hardware characteristics and environment conditions on\n    the day of launch. The launch vehicle is designed to accommodate the maximum FPR loading.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Flight Performance Reserve Propellant Mass","@language":"en"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"FPR","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}]},{"@id":"http://qudt.org/vocab/quantitykind/FUEL-BIAS","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"An additional quantity of fuel to ensure depletion of high-weight oxidizer before fuel for systems with\n    high-oxidizer mixing ratios (e.g., 6:1). This practice allows for more efficient propellant utilization. Denoted as a\n    percentage.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"An additional quantity of fuel to ensure depletion of high-weight oxidizer before fuel for systems\n    with high-oxidizer mixing ratios (e.g., 6:1). This practice allows for more efficient propellant utilization. Denoted as a\n    percentage.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Fuel Bias","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}]},{"@id":"http://qudt.org/vocab/quantitykind/FahrenheitTemperature","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"quantity whose zero point is defined by the temperature of a mixture of ice, water and ammonium chloride\n    (-17.8 °C) and its fixed points on the Fahrenheit scale are 32 °F (melting point of ice) and 212 °F (boiling point of water)\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_F"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ278#002","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD263","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD263","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Größe, deren Nullpunkt durch die Mischungstemperatur von Eis, Wasser und Salmiak (Ammoniumchlorid)\n    definiert ist (-17,8 °C) und deren Fixpunkte auf der Fahrenheit-Skala 32 °F (Schmelztemperatur von Eis) und 212 °F\n    (Siedetemperatur des Wassers) sind\n  ","@language":"de"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:FahrenheitTemperature","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Fahrenheit Temperature","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/FailureRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"limiting value - if it exists - of the ratio between the conditional probability that the fault time t of\n    a resource will fall within a defined interval (t, t + Δt), and the duration of this interval if Δt approaches zero and the\n    unit is in an operational state at the beginning of the interval\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/NUM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-YR"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ466#006","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD051","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD051","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/CountRate"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Grenzwert - falls er existiert - des Quotienten aus der bedingten Wahrscheinlichkeit, dass der\n    Ausfallzeitpunkt t eines Betriebsmittels in ein gegebenes Zeitintervall (t, t + Δt) fällt, und der Dauer dieses\n    Zeitintervalls, wenn Δt gegen null geht und das Betriebsmittel sich zu Beginn des Zeitintervalls im betriebsfähigen Zustand\n    befindet\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:FailureRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Failure Rate","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/CountRate"}]},{"@id":"http://qudt.org/vocab/quantitykind/FastFissionFactor","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Fast Fission Factor\" in an infinite medium, is the ratio of the mean number of neutrons produced by\n    fission due to neutrons of all energies to the mean number of neutrons produced by fissions due to thermal neutrons only.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Four_factor_formula","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\varphi$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Fast Fission Factor\" in an infinite medium, is the ratio of the mean number of neutrons produced\n    by fission due to neutrons of all energies to the mean number of neutrons produced by fissions due to thermal neutrons only.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q99197493"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:FastFissionFactor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Fast Fission Factor","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/FermiAngularWavenumber","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG-PER-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Heavy_fermion","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/AngularWavenumber"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"k_F","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q105554303"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{