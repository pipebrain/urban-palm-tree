/DEG_C"},{"@id":"http://qudt.org/vocab/unit/DEG_F"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"the temperature of a parcel of air cooled to saturation (100% relative humidity) by the evaporation\n    of water into it, with the latent heat supplied by the parcel.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:WetBulbTemperature","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Wet Bulb Temperature","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/Width","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Width\" is the middle of three dimensions: length, width, thickness.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ANGSTROM"},{"@id":"http://qudt.org/vocab/unit/AU"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB_F"},{"@id":"http://qudt.org/vocab/unit/CHAIN"},{"@id":"http://qudt.org/vocab/unit/CHAIN_US"},{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/DecaM"},{"@id":"http://qudt.org/vocab/unit/DeciM"},{"@id":"http://qudt.org/vocab/unit/FATH"},{"@id":"http://qudt.org/vocab/unit/FM"},{"@id":"http://qudt.org/vocab/unit/FT"},{"@id":"http://qudt.org/vocab/unit/FT_US"},{"@id":"http://qudt.org/vocab/unit/FUR"},{"@id":"http://qudt.org/vocab/unit/FemtoM"},{"@id":"http://qudt.org/vocab/unit/GAUGE_FR"},{"@id":"http://qudt.org/vocab/unit/GA_Charriere"},{"@id":"http://qudt.org/vocab/unit/HectoM"},{"@id":"http://qudt.org/vocab/unit/IN"},{"@id":"http://qudt.org/vocab/unit/KiloM"},{"@id":"http://qudt.org/vocab/unit/LY"},{"@id":"http://qudt.org/vocab/unit/M"},{"@id":"http://qudt.org/vocab/unit/MI"},{"@id":"http://qudt.org/vocab/unit/MI_N"},{"@id":"http://qudt.org/vocab/unit/MI_UK"},{"@id":"http://qudt.org/vocab/unit/MI_US"},{"@id":"http://qudt.org/vocab/unit/MicroIN"},{"@id":"http://qudt.org/vocab/unit/MicroM"},{"@id":"http://qudt.org/vocab/unit/MilLength"},{"@id":"http://qudt.org/vocab/unit/MilliIN"},{"@id":"http://qudt.org/vocab/unit/MilliM"},{"@id":"http://qudt.org/vocab/unit/NanoM"},{"@id":"http://qudt.org/vocab/unit/PARSEC"},{"@id":"http://qudt.org/vocab/unit/PCA"},{"@id":"http://qudt.org/vocab/unit/PT"},{"@id":"http://qudt.org/vocab/unit/PicoM"},{"@id":"http://qudt.org/vocab/unit/PlanckLength"},{"@id":"http://qudt.org/vocab/unit/ROD"},{"@id":"http://qudt.org/vocab/unit/YD"},{"@id":"http://qudt.org/vocab/unit/ZOLL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Width\" is the middle of three dimensions: length, width, thickness.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q35059"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Width","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}]},{"@id":"http://qudt.org/vocab/quantitykind/Work","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Work}$ or $net\\ work$ is equal to the change in kinetic energy. This relationship is called\n    the work-energy theorem: $$Wnet = K. E._f  K. E._o $$ where $K. E._f$ is the final kinetic energy and $K. E._o$ is the\n    original kinetic energy. Potential energy, also referred to as stored energy, is the ability of a system to do work due to its\n    position or internal structure. Change in potential energy is equal to work. The potential energy equations can also be\n    derived from the integral form of work: $$\\Delta P. E. = W = \\int  F \\cdot dx$$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AttoJ"},{"@id":"http://qudt.org/vocab/unit/BTU_IT"},{"@id":"http://qudt.org/vocab/unit/BTU_TH"},{"@id":"http://qudt.org/vocab/unit/CAL_IT"},{"@id":"http://qudt.org/vocab/unit/CAL_TH"},{"@id":"http://qudt.org/vocab/unit/ERG"},{"@id":"http://qudt.org/vocab/unit/EV"},{"@id":"http://qudt.org/vocab/unit/E_h"},{"@id":"http://qudt.org/vocab/unit/ExaJ"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F_Energy"},{"@id":"http://qudt.org/vocab/unit/FT-PDL"},{"@id":"http://qudt.org/vocab/unit/FemtoJ"},{"@id":"http://qudt.org/vocab/unit/GigaEV"},{"@id":"http://qudt.org/vocab/unit/GigaJ"},{"@id":"http://qudt.org/vocab/unit/GigaW-HR"},{"@id":"http://qudt.org/vocab/unit/J"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH"},{"@id":"http://qudt.org/vocab/unit/KiloCAL"},{"@id":"http://qudt.org/vocab/unit/KiloEV"},{"@id":"http://qudt.org/vocab/unit/KiloJ"},{"@id":"http://qudt.org/vocab/unit/KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT"},{"@id":"http://qudt.org/vocab/unit/MegaEV"},{"@id":"http://qudt.org/vocab/unit/MegaJ"},{"@id":"http://qudt.org/vocab/unit/MegaTOE"},{"@id":"http://qudt.org/vocab/unit/MegaW-HR"},{"@id":"http://qudt.org/vocab/unit/MicroJ"},{"@id":"http://qudt.org/vocab/unit/MilliJ"},{"@id":"http://qudt.org/vocab/unit/NanoJ"},{"@id":"http://qudt.org/vocab/unit/PetaJ"},{"@id":"http://qudt.org/vocab/unit/PicoJ"},{"@id":"http://qudt.org/vocab/unit/PlanckEnergy"},{"@id":"http://qudt.org/vocab/unit/QUAD"},{"@id":"http://qudt.org/vocab/unit/THERM_EC"},{"@id":"http://qudt.org/vocab/unit/THERM_US"},{"@id":"http://qudt.org/vocab/unit/THM_EEC"},{"@id":"http://qudt.org/vocab/unit/THM_US"},{"@id":"http://qudt.org/vocab/unit/TOE"},{"@id":"http://qudt.org/vocab/unit/TeraJ"},{"@id":"http://qudt.org/vocab/unit/TeraW-HR"},{"@id":"http://qudt.org/vocab/unit/TonEnergy"},{"@id":"http://qudt.org/vocab/unit/W-HR"},{"@id":"http://qudt.org/vocab/unit/W-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.cliffsnotes.com/study_guide/Work-and-Energy.topicArticleId-10453,articleId-10418.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Work_(physics)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$A = \\int Pdt$, where $P$ is power and $t$ is time.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A force is said to do Work when it acts on a body so that there is a displacement of the point of\n    application, however small, in the direction of the force.  The concepts of work and energy are closely tied to the concept of\n    force because an applied force can do work on an object and cause a change in energy. Energy is defined as the ability to do\n    work. Work is done on an object when an applied force moves it through a distance. Kinetic energy is the energy of an object\n    in motion. The net work is equal to the change in kinetic energy.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"A","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q42213"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Energy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Arbeit","@language":"de"},{"@value":"Work","@language":"en"},{"@value":"delo","@language":"sl"},{"@value":"iş","@language":"tr"},{"@value":"kerja","@language":"ms"},{"@value":"lavoro","@language":"it"},{"@value":"lucru mecanic","@language":"ro"},{"@value":"praca","@language":"pl"},{"@value":"práce","@language":"cs"},{"@value":"trabajo","@language":"es"},{"@value":"trabalho","@language":"pt"},{"@value":"travail","@language":"fr"},{"@value":"کار","@language":"fa"},{"@value":"कार्य","@language":"hi"},{"@value":"仕事量","@language":"ja"},{"@value":"功","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}]},{"@id":"http://qudt.org/vocab/quantitykind/WorkFunction","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Work Function\" is the energy difference between an electron at rest at infinity and an electron at a\n    certain energy level. The minimum energy (usually measured in electronvolts) needed to remove an electron from a solid to a\n    point immediately outside the solid surface (or energy needed to move an electron from the Fermi level into vacuum).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AttoJ"},{"@id":"http://qudt.org/vocab/unit/BTU_IT"},{"@id":"http://qudt.org/vocab/unit/BTU_TH"},{"@id":"http://qudt.org/vocab/unit/CAL_IT"},{"@id":"http://qudt.org/vocab/unit/CAL_TH"},{"@id":"http://qudt.org/vocab/unit/ERG"},{"@id":"http://qudt.org/vocab/unit/EV"},{"@id":"http://qudt.org/vocab/unit/E_h"},{"@id":"http://qudt.org/vocab/unit/ExaJ"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F_Energy"},{"@id":"http://qudt.org/vocab/unit/FT-PDL"},{"@id":"http://qudt.org/vocab/unit/FemtoJ"},{"@id":"http://qudt.org/vocab/unit/GigaEV"},{"@id":"http://qudt.org/vocab/unit/GigaJ"},{"@id":"http://qudt.org/vocab/unit/GigaW-HR"},{"@id":"http://qudt.org/vocab/unit/J"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH"},{"@id":"http://qudt.org/vocab/unit/KiloCAL"},{"@id":"http://qudt.org/vocab/unit/KiloEV"},{"@id":"http://qudt.org/vocab/unit/KiloJ"},{"@id":"http://qudt.org/vocab/unit/KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT"},{"@id":"http://qudt.org/vocab/unit/MegaEV"},{"@id":"http://qudt.org/vocab/unit/MegaJ"},{"@id":"http://qudt.org/vocab/unit/MegaTOE"},{"@id":"http://qudt.org/vocab/unit/MegaW-HR"},{"@id":"http://qudt.org/vocab/unit/MicroJ"},{"@id":"http://qudt.org/vocab/unit/MilliJ"},{"@id":"http://qudt.org/vocab/unit/NanoJ"},{"@id":"http://qudt.org/vocab/unit/PetaJ"},{"@id":"http://qudt.org/vocab/unit/PicoJ"},{"@id":"http://qudt.org/vocab/unit/PlanckEnergy"},{"@id":"http://qudt.org/vocab/unit/QUAD"},{"@id":"http://qudt.org/vocab/unit/THERM_EC"},{"@id":"http://qudt.org/vocab/unit/THERM_US"},{"@id":"http://qudt.org/vocab/unit/THM_EEC"},{"@id":"http://qudt.org/vocab/unit/THM_US"},{"@id":"http://qudt.org/vocab/unit/TOE"},{"@id":"http://qudt.org/vocab/unit/TeraJ"},{"@id":"http://qudt.org/vocab/unit/TeraW-HR"},{"@id":"http://qudt.org/vocab/unit/TonEnergy"},{"@id":"http://qudt.org/vocab/unit/W-HR"},{"@id":"http://qudt.org/vocab/unit/W-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Work_function","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Phi$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Work Function\" is the energy difference between an electron at rest at infinity and an electron at\n    a certain energy level. The minimum energy (usually measured in electronvolts) needed to remove an electron from a solid to a\n    point immediately outside the solid surface (or energy needed to move an electron from the Fermi level into vacuum).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q783800"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Energy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Work Function","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}]},{"@id":"http://qudt.org/vocab/quantitykind/ZenithAngle","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ARCMIN"},{"@id":"http://qudt.org/vocab/unit/ARCSEC"},{"@id":"http://qudt.org/vocab/unit/DEG"},{"@id":"http://qudt.org/vocab/unit/GON"},{"@id":"http://qudt.org/vocab/unit/GRAD"},{"@id":"http://qudt.org/vocab/unit/MIL_Angle"},{"@id":"http://qudt.org/vocab/unit/MIN_Angle"},{"@id":"http://qudt.org/vocab/unit/MicroRAD"},{"@id":"http://qudt.org/vocab/unit/MilliARCSEC"},{"@id":"http://qudt.org/vocab/unit/MilliRAD"},{"@id":"http://qudt.org/vocab/unit/RAD"},{"@id":"http://qudt.org/vocab/unit/REV"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Zenith angle is the angle measured from the zenith (the point directly overhead) downward to a\n    celestial object or direction of interest. It is the complement of the elevation (altitude) angle.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Angle","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:PlaneAngle","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Zenith Angle","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}]},{"@id":"http://qudt.org/vocab/soqk/CGS","@type":["http://qudt.org/schema/qudt/SystemOfQuantityKinds"],"http://qudt.org/schema/qudt/hasBaseQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"},{"@id":"http://qudt.org/vocab/quantitykind/Length"},{"@id":"http://qudt.org/vocab/quantitykind/Mass"},{"@id":"http://qudt.org/vocab/quantitykind/Time"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/hasUnitSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qudt/systemDerivedQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AngularAcceleration"},{"@id":"http://qudt.org/vocab/quantitykind/AngularMomentum"},{"@id":"http://qudt.org/vocab/quantitykind/AngularVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/Area"},{"@id":"http://qudt.org/vocab/quantitykind/AreaAngle"},{"@id":"http://qudt.org/vocab/quantitykind/AreaTime"},{"@id":"http://qudt.org/vocab/quantitykind/Curvature"},{"@id":"http://qudt.org/vocab/quantitykind/Density"},{"@id":"http://qudt.org/vocab/quantitykind/DynamicViscosity"},{"@id":"http://qudt.org/vocab/quantitykind/Energy"},{"@id":"http://qudt.org/vocab/quantitykind/EnergyDensity"},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerArea"},{"@id":"http://qudt.org/vocab/quantitykind/Force"},{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"},{"@id":"http://qudt.org/vocab/quantitykind/ForcePerLength"},{"@id":"http://qudt.org/vocab/quantitykind/Frequency"},{"@id":"http://qudt.org/vocab/quantitykind/LengthMass"},{"@id":"http://qudt.org/vocab/quantitykind/LinearAcceleration"},{"@id":"http://qudt.org/vocab/quantitykind/LinearMomentum"},{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/MassPerArea"},{"@id":"http://qudt.org/vocab/quantitykind/MassPerLength"},{"@id":"http://qudt.org/vocab/quantitykind/MassPerTime"},{"@id":"http://qudt.org/vocab/quantitykind/MomentOfInertia"},{"@id":"http://qudt.org/vocab/quantitykind/Power"},{"@id":"http://qudt.org/vocab/quantitykind/PowerPerArea"},{"@id":"http://qudt.org/vocab/quantitykind/PowerPerAreaAngle"},{"@id":"http://qudt.org/vocab/quantitykind/Pressure"},{"@id":"http://qudt.org/vocab/quantitykind/RadiantIntensity"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SquareTime"},{"@id":"http://qudt.org/vocab/quantitykind/Stress"},{"@id":"http://qudt.org/vocab/quantitykind/Torque"},{"@id":"http://qudt.org/vocab/quantitykind/Volume"},{"@id":"http://qudt.org/vocab/quantitykind/VolumePerTime"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/soqk"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"CGS System of Quantity Kinds","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/soqk/CGS-EMU","@type":["http://qudt.org/schema/qudt/SystemOfQuantityKinds"],"http://purl.org/dc/terms/description":[{"@value":"The electromagnetic system of units is used to measure electrical quantities of electric charge, current, and voltage, within the centimeter gram second (or \"CGS\") metric system of units. In electromagnetic units, electric current is derived the CGS base units length, mass, and time by solving Ampere's Law (expressing the force between two parallel conducting wires) for current and setting the constant of proportionality (k_m) equal to unity. Thus, in the CGS-EMU system, electric current is derived from length, mass, and time.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/hasBaseQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"},{"@id":"http://qudt.org/vocab/quantitykind/Length"},{"@id":"http://qudt.org/vocab/quantitykind/Mass"},{"@id":"http://qudt.org/vocab/quantitykind/Time"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/hasUnitSystem":[{"@id":"http://qudt.org/vocab/sou/CGS-EMU"}],"http://qudt.org/schema/qudt/systemDerivedQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AuxillaryMagneticField"},{"@id":"http://qudt.org/vocab/quantitykind/Capacitance"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCharge"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricConductivity"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrent"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentDensity"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPerLength"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricDipoleMoment"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricDisplacementField"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricField"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricFlux"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotential"},{"@id":"http://qudt.org/vocab/quantitykind/ElectromotiveForce"},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerElectricCharge"},{"@id":"http://qudt.org/vocab/quantitykind/Inductance"},{"@id":"http://qudt.org/vocab/quantitykind/LengthPerElectricCurrent"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticDipoleMoment"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticField"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFlux"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxPerLength"},{"@id":"http://qudt.org/vocab/quantitykind/MagnetizationField"},{"@id":"http://qudt.org/vocab/quantitykind/MagnetomotiveForce"},{"@id":"http://qudt.org/vocab/quantitykind/Permeability"},{"@id":"http://qudt.org/vocab/quantitykind/Permittivity"},{"@id":"http://qudt.org/vocab/quantitykind/Resistance"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/soqk"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"CGS-EMU System of Quantity Kinds","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/soqk/CGS-ESU","@type":["http://qudt.org/schema/qudt/SystemOfQuantityKinds"],"http://purl.org/dc/terms/description":[{"@value":"The electrostatic system of units is used to measure electrical quantities of electric charge, current, and voltage within the centimeter gram second (or \"CGS\") metric system of units. In electrostatic units, electric charge is derived from Coulomb's Law (expressing the force exerted between two charged particles separated by a distance) by solving for electric charge and setting the constant of proportionality (k_s) equal to unity. Thus, in electrostatic units, the dimensionality of electric charge is derived from the base CGS quantities of length, mass, and time.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/hasBaseQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"},{"@id":"http://qudt.org/vocab/quantitykind/Length"},{"@id":"http://qudt.org/vocab/quantitykind/Mass"},{"@id":"http://qudt.org/vocab/quantitykind/Time"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/hasUnitSystem":[{"@id":"http://qudt.org/vocab/sou/CGS-ESU"}],"http://qudt.org/schema/qudt/systemDerivedQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AuxillaryMagneticField"},{"@id":"http://qudt.org/vocab/quantitykind/Capacitance"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCharge"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrent"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentDensity"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPerLength"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricDipoleMoment"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricDisplacementField"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricField"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricFlux"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotential"},{"@id":"http://qudt.org/vocab/quantitykind/ElectromotiveForce"},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerElectricCharge"},{"@id":"http://qudt.org/vocab/quantitykind/Inductance"},{"@id":"http://qudt.org/vocab/quantitykind/LengthPerElectricCurrent"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticDipoleMoment"},{"@id":"http://qudt.org/vocab/quantitykind/Magneti