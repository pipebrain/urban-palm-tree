","@type":["http://qudt.org/schema/qudt/BitField"],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"bf12","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/bits":[{"@value":"12","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/mySQLName":[{"@value":"BIT(12)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://qudt.org/vocab/datatype/BitField12"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"B12","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bit Field of 12 bits","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/BooleanEncoding","@type":["http://qudt.org/schema/qudt/BooleanEncodingType"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Boolean Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/ByColumn","@type":["http://qudt.org/schema/qudt/ArrayDataOrder"],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"byColumn","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"By Column","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/ByLeftMostIndex","@type":["http://qudt.org/schema/qudt/ArrayDataOrder"],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"byLeftMostIndex","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"By Left Most Index","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/ByRow","@type":["http://qudt.org/schema/qudt/ArrayDataOrder"],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"byRow","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"By row","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/ByteAligned","@type":["http://qudt.org/schema/qudt/AlignmentType"],"http://purl.org/dc/terms/description":[{"@value":"Alignment of a field at a byte boundary.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Byte aligned","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/CDF","@type":["http://qudt.org/schema/qudt/MultiDimensionalDataFormat"],"http://purl.org/dc/terms/description":[{"@value":"CDF (Common Data format), a data format for storing and manipulating scalar and multidimensional data in a platform and discipline independent manner, making interoperability between applications and tools easier. CDF provides device independent view of the CDF data model by software programming interface insulting developers from actual physical file format. CDF was developed by NASA, and is described at http://cdf.gsfc.nasa.gov/.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Common Data Format (CDF)","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/CFN_ConcatenateMatrixRows","@type":["http://qudt.org/schema/qudt/CompositionFunction"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Concatenate Matrix Rows","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/CHAR","@type":["http://qudt.org/schema/qudt/CharacterType"],"http://qudt.org/schema/qudt/bits":[{"@value":"8","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/encoding":[{"@id":"http://qudt.org/vocab/datatype/CharEncoding"}],"http://qudt.org/schema/qudt/id":[{"@value":"T001-01","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#byte"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"char","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"CHAR","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/COLOR_AMBER","@type":["http://qudt.org/schema/qudt/ColorCue"],"http://qudt.org/schema/qudt/rgbCode":[{"@value":"#FFBF00","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"amber","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Amber Color","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/COLOR_GREEN","@type":["http://qudt.org/schema/qudt/ColorCue"],"http://qudt.org/schema/qudt/rgbCode":[{"@value":"#008000","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"green","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Green color","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/COLOR_ORANGE","@type":["http://qudt.org/schema/qudt/ColorCue"],"http://qudt.org/schema/qudt/rgbCode":[{"@value":"#FFA500","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"orange","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Orange color","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/COLOR_RED","@type":["http://qudt.org/schema/qudt/ColorCue"],"http://qudt.org/schema/qudt/rgbCode":[{"@value":"#FF0000","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"red","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Red color","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/COLOR_YELLOW","@type":["http://qudt.org/schema/qudt/ColorCue"],"http://qudt.org/schema/qudt/rgbCode":[{"@value":"#FFFF00","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"yellow","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Yellow color","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/CT_COUNTABLY-INFINITE","@type":["http://qudt.org/schema/qudt/CardinalityType"],"http://purl.org/dc/terms/description":[{"@value":"\n  A set of numbers is called countably infinite if there is a way to enumerate them.\n  Formally this is done with a bijection function that associates each number in the set with exactly one of the positive integers.\n  The set of all fractions is also countably infinite.\n  In other words, any set $X$ that has the same cardinality as the set of the natural numbers,\n   or $| X | \\; =  \\; | \\mathbb N | \\; = \\; \\aleph0$, is said to be a countably infinite set.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.math.vanderbilt.edu/~schectex/courses/infinity.pdf","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"countable","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Countably Infinite Cardinality Type","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/CT_FINITE","@type":["http://qudt.org/schema/qudt/CardinalityType"],"http://purl.org/dc/terms/description":[{"@value":"\n  Any set $X$ with cardinality less than that of the natural numbers, or\n  $$| X | \\; <  \\; | \\mathbb N | $$\n  is said to be a finite set.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"finite","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Finite Cardinality Type","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/CT_UNCOUNTABLE","@type":["http://qudt.org/schema/qudt/CardinalityType"],"http://purl.org/dc/terms/description":[{"@value":"\n  Any set with cardinality greater than that of the natural numbers, or\n  $$| X | \\; >  \\; | \\mathbb N | $$\n  \n  For example $| R| \\; =  \\;  c  \\; > |\\mathbb N |$, is said to be uncountable.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"uncountable","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Uncountable Cardinality Type","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/CharEncoding","@type":["http://qudt.org/schema/qudt/BooleanEncodingType","http://qudt.org/schema/qudt/CharEncodingType"],"http://qudt.org/schema/qudt/bytes":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Char Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/DATE","@type":["http://qudt.org/schema/qudt/DateStringType"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>Provides the date expressed in year, month and day.\n  Expressed as \"YYYY:MM:DD\", where YYYY is a 4 digit year, MM is a 2 digit month and DD is a 2 digit day.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/dimensionality":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/id":[{"@value":"T004-01","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#date"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"255","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"date","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Date","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/DATETIME","@type":["http://qudt.org/schema/qudt/DateStringType"],"http://purl.org/dc/terms/description":[{"@value":"A time stamp encoded as a string 'YYYY-MM-DDThh:mm:ss[.dd]' or 'YYYY-DDDThh:mm:ss[.dd]', where 'YYYY' is the year, 'MM' is the two-digit month, 'DD' is the two-digit day, 'DDD' is the three digit day of year, 'T' is constant, 'hh:mm:ss[.dd]' is the UTC time in hours, minutes, seconds, and optional fractional seconds. As many 'd' characters to the right of the period as required may be used to obtain the required precision. All fields require leading zeros.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/dimensionality":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/datatype/UTC-DATETIME"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#dateTime"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"datetime","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Date Time","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/DECIMAL","@type":["http://qudt.org/schema/qudt/NumericType"],"http://qudt.org/schema/qudt/ansiSQLName":[{"@value":"DECIMAL(p,s)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/odbcName":[{"@value":"SQL_DECIMAL(p,s)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/oracleSQLName":[{"@value":"NUMBER(p,s)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"101","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"numeric","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Decimal","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/DIGIT","@type":["http://qudt.org/schema/qudt/CharacterType"],"http://qudt.org/schema/qudt/bits":[{"@value":"8","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/id":[{"@value":"T001-02","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#byte"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"digit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"DIGIT","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/DoublePrecisionEncoding","@type":["http://qudt.org/schema/qudt/FloatingPointEncodingType"],"http://qudt.org/schema/qudt/bytes":[{"@value":"64","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Double Precision Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/FALSE","@type":["http://qudt.org/schema/qudt/BooleanTypeEnumeratedValue"],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"false","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"False","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/FLAG","@type":["http://qudt.org/schema/qudt/BooleanType"],"http://qudt.org/schema/qudt/id":[{"@value":"T000-02","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"2","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"flag","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"FLAG","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/FLOAT-DP","@type":["http://qudt.org/schema/qudt/RealDoublePrecisionType"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A double precision floating point datatype. \n  Numbers of this type are stored using 64 bits, they require more memory than numbers of type single, which use 32 bits. \n  However, because they are stored with more bits, numbers of type double are represented to more precision than numbers of type single. \n  The double-precision (or double) data type is represented according to IEEE Standard 754 for double precision. \n  A value is formatted with bit-fields for sign, mantissa and exponent.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"F64","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ansiSQLName":[{"@value":"DOUPLE PRECISION","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/base":[{"@value":"2","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bits":[{"@value":"64","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"8","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/encoding":[{"@id":"http://qudt.org/vocab/datatype/DoublePrecisionEncoding"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/datatype/FLOAT_IEEE754-BINARY64"}],"http://qudt.org/schema/qudt/id":[{"@value":"T006-03","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/javaName":[{"@value":"double","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/jsName":[{"@value":"double","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/matlabName":[{"@value":"double","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/maxExclusive":[{"@value":"(1-2^{-53}) \\times 2^{1024}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/maxExponent":[{"@value":"1023","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/maxMantissa":[{"@value":"9007199254740991","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/microsoftSQLServerName":[{"@value":"float","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/minExclusive":[{"@value":"-(1-2^{-53}) \\times 2^{1024}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/minMantissa":[{"@value":"-9007199254740991","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/mySQLName":[{"@value":"DOUBLE","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/odbcName":[{"@value":"SQL_DOUBLE","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/oleDBName":[{"@value":"DBTYPE_R8","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/oracleSQLName":[{"@value":"FLOAT(49)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#double"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"405","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"double","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Double Precision Real","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"http://dev.mysql.com/doc/refman/5.0/en/floating-point-types.html"},{"@id":"http://docs.oracle.com/javase/tutorial/java/nutsandbolts/datatypes.html"},{"@id":"http://en.wikipedia.org/wiki/Floating_point"},{"@id":"http://en.wikipedia.org/wiki/IEEE_floating_point"},{"@id":"http://msdn.microsoft.com/en-us/library/aa275635(v=sql.80).aspx"},{"@id":"http://www.mathworks.com/help/matlab/matlab_prog/floating-point-numbers.html"}]},{"@id":"http://qudt.org/vocab/datatype/FLOAT-SP","@type":["http://qudt.org/schema/qudt/RealSinglePrecisionType"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>\n  A single precision real is a 32 bit signed floating point representation. \n  Numbers of type single are stored using 32 bits, they require less memory than numbers of type double, which use 64 bits. \n  However, because they are stored with fewer bits, numbers of type single are represented to less precision than numbers of type double.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/ansiSQLName":[{"@value":"FLOAT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/bits":[{"@value":"32","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"4","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/cName":[{"@value":"float","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/encoding":[{"@id":"http://qudt.org/vocab/datatype/SinglePrecisionRealEncoding"}],"http://qudt.org/schema/qudt/id":[{"@value":"T006-01","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/javaName":[{"@value":"float","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/jsName":[{"@value":"float","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/matlabName":[{"@value":"single","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/maxExclusive":[{"@value":"$(2-2^{-23}) \\times 2^127$","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/maxExponent":[{"@value":"23","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/microsoftSQLServerName":[{"@value":"real","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/minExclusive":[{"@value":"-(2-2^{-23}) \\times 2^{127}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/mySQLName":[{"@value":"FLOAT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/odbcName":[{"@value":"SQL_FLOAT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/oleDBName":[{"@value":"DBTYPE_R4","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/oracleSQLName":[{"@value":"FLOAT(23)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#float"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"single","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Single Precision Real","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"http://dev.mysql.com/doc/refman/5.0/en/floating-point-types.html"},{"@id":"http://docs.oracle.com/javase/tutorial/java/nutsandbolts/datatypes.html"},{"@id":"http://en.wikipedia.org/wiki/Floating_point"},{"@id":"http://msdn.microsoft.com/en-us/library/aa275635(v=sql.80).aspx"},{"@id":"http://www-01.ibm.com/support/docview.wss?uid=swg21325957"},{"@id":"http://www.mathworks.com/help/matlab/matlab_prog/floating-point-numbers.html"},{"@id":"http://www.stanford.edu/dept/itss/docs/oracle/10g/server.101/b10764/apb.htm"}]},{"@id":"http://qudt.org/vocab/datatype/FLOAT_IEEE754-BINARY64","@type":["http://qudt.org/schema/qudt/RealDoublePrecisionType"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>The IEEE-754 floating point datatype is a technical standard established in 1985 by the Institute of Electrical and Electronics Engineers (IEEE). \n  Many hardware floating point units use the IEEE 754 standard.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/base":[{"@value":"2","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bits":[{"@value":"64","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/datatype/FLOAT-DP"}],"http://qudt.org/schema/qudt/id":[{"@value":"T006-05","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/maxExponent":[{"@value":"970","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/maxMantissa":[{"@value":"9007199254740991","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/minMantissa":[{"@value":"-9007199254740991","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#double"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"IEEE754 BINARY64","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"http://en.wikipedia.org/wiki/IEEE_floating_point"}]},{"@id":"http://qudt.org/vocab/datatype/HDF5","@type":["http://qudt.org/schema/qudt/MultiDimensionalDataFormat"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>The Hierarchical Data Format (HDF) is a common data format and a collection of application programming libraries developed at the NSCA primarily for the scientific community and for the exchange of scientific datasets. \n  A commonly-used version of HDF is HDF5 which offers a simple data model and application interfaces for encoding and exchanging data without the added burden of defining mappings to the underlying machine representations.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"HDF5","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/HDF6","@type":["http://qudt.org/schema/qudt/MultiDimensionalDataFormat"],"http://purl.org/dc/terms/description":[{"@value":"A \"Hierarchical Data Format\".","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"HDF6","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/HEXBINARY","@type":["http://qudt.org/schema/qudt/HexBinaryType"],"http://qudt.org/schema/qudt/dimensionality":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://qudt.org/schema/qudt/hexbinary"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"803","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"hexbinary","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"HEXBINARY","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/HighToLow","@type":["http://qudt.org/schema/qudt/MemoryOrderType"],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"high_to_low","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"High to Low","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/IEEE754_1985RealEncoding","@type":["http://qudt.org/schema/qudt/FloatingPointEncodingType"],"http://qudt.org/schema/qudt/bytes":[{"@value":"32","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"IEEE 754 1985 Real Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/INTEGER","@type":["http://qudt.org/schema/qudt/SignedIntegerType"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>An <em>Integer</em> is an XML Schema Definition (XSD) datatype that represents arbitrary-precision whole numbers\n   (positive, negative, or zero) without fractional or decimal components. \n  It is derived from xsd:decimal by restricting values to integers only..\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"SI","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ansiSQLName":[{"@value":"INT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/bits":[{"@value":"16","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"2","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/encoding":[{"@id":"http://qudt.org/vocab/datatype/ShortSignedIntegerEncoding"}],"http://qudt.org/schema/qudt/id":[{"@value":"T002-03","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/javaName":[{"@value":"integer","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/jsName":[{"@value":"integer","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/matlabName":[{"@value":"int","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/microsoftSQLServerName":[{"@value":"int","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/mySQLName":[{"@value":"INT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"104","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"SI","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Integer","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/ISO8601-UTCDateTime-BasicFormat","@type":["http://qudt.org/schema/qudt/DateTimeStringEncodingType"],"http://qudt.org/schema/qudt/allowedPattern":[{"@value":"[0-9]{4}[0-9]{2}[0-9]{2}T[0-9]{2}[0-9]{2}[0-9]{2}.[0-9]+Z","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"[0-9]{4}[0-9]{2}[0-9]{2}T[0-9]{2}[0-9]{2}[0-9]{2}Z","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"ISO 8601 UTC Date Time - Basic Format","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/InterpolatedTABLE","@type":["http://qudt.org/schema/qudt/InterpolatedTable"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Interpolated table","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/Konopliv2001","@type":["http://qudt.org/schema/qudt/Citation"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>\"Recent Gravity Models as a Result of the Lunar Prospector Mission\", A. S. Konopliv, S. W. Asmar, E. Carranza, W. L. Sjogren,\n   and D. N. Yuan, Academic Press, Icarus 150, 1-18 (2001).\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Konopliv2001","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/LETTER","@type":["http://qudt.org/schema/qudt/CharacterType"],"http://qudt.org/schema/qudt/bits":[{"@value":"8","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/id":[{"@value":"T001-03","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#byte"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"letter","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"LETTER","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/LittleEndian","@type":["http://qudt.org/schema/qudt/EndianType"],"http://purl.org/dc/terms/description":[{"@value":"A little-endian machine stores the least significant byte first.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"2","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"little","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Little Endian","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/LongSignedIntegerEncoding","@type":["http://qudt.org/schema/qudt/IntegerEncodingType"],"http://qudt.org/schema/qudt/bytes":[{"@value":"8","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Long Signed Integer Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/LongUnsignedIntegerEncoding","@type":["http://qudt.org/schema/qudt/IntegerEncodingType"],"http://qudt.org/schema/qudt/bytes":[{"@value":"8","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Long Unsigned Integer Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/LowToHigh","@type":["http://qudt.org/schema/qudt/MemoryOrderType"],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"low_to_high","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Low to High","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/Major","@type":["http://qudt.org/schema/qudt/MajorMinorType"],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"2","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"major","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#order":[{"@value":"2","@type":"http://www.w3.org/2001/XMLSchema#int"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Major","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/Minor","@type":["http://qudt.org/schema/qudt/MajorMinorType"],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"minor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#order":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#int"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Minor","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/NO","@type":["http://qudt.org/schema/qudt/YesNoType"],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"N","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"No","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/NUMERIC","@type":["http://qudt.org/schema/qudt/NumericType"],"http://qudt.org/schema/qudt/ansiSQLName":[{"@value":"DECIMAL(p,s)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/odbcName":[{"@value":"SQL_DECIMAL(p,s)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/oracleSQLName":[{"@value":"NUMBER(p,s)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"101","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"numeric","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Numeric","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/NetCDF","@type":["http://qudt.org/schema/qudt/MultiDimensionalDataFormat"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p><em>NetCDF</em> (network Common Data Form) is a set of interfaces for array-oriented data access and a freely-distributed collection of data access libraries for C, Fortran, C++, Java, and other languages. \n  The netCDF libraries support a machine-independent format for representing scientific data. \n  Together, the interfaces, libraries, and format support the creation, access, and sharing of scientific data.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"NetCDF","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/NonModifiableParameter","@type":["http://qudt.org/schema/qudt/ParameterModifiabilityType"],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"fixed","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Parameter is fixed, not modifiable.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Non modifiable parameter","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/OCTET","@type":["http://qudt.org/schema/qudt/OctetType"],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"octet","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/bits":[{"@value":"8","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/cName":[{"@value":"Byte","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/encoding":[{"@id":"http://qudt.org/vocab/datatype/OctetEncoding"}],"http://qudt.org/schema/qudt/id":[{"@value":"T002-01","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/maxInclusive":[{"@value":"255","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/minInclusive":[{"@value":"0","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#byte"}],"http://qudt.org/schema/qudt/signedness":[{"@id":"http://qudt.org/vocab/datatype/Unsigned"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"800","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"octet","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Octet","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/OFF","@type":["http://qudt.org/schema/qudt/OnOffStateType"],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"off","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Off","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/OFFstate","@type":["http://qudt.org/schema/qudt/OffOnStateTypeEnumeration"],"http://qudt.org/schema/qudt/element":[{"@id":"http://qudt.org/vocab/datatype/OFF"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"off","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Off","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/ON","@type":["http://qudt.org/schema/qudt/OnOffStateType"],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"on","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"On","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/ONstate","@type":["http://qudt.org/schema/qudt/OnOffStateTypeEnumeration"],"http://qudt.org/schema/qudt/element":[{"@id":"http://qudt.org/vocab/datatype/ON"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"on","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"On","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/OctetEncoding","@type":["http://qudt.org/schema/qudt/BooleanEncodingType","http://qudt.org/schema/qudt/ByteEncodingType"],"http://qudt.org/schema/qudt/bytes":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"OCTET Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/OneMeansOff","@type":["http://qudt.org/schema/qudt/OnOffStateType"],"http://qudt.org/schema/qudt/inverted":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"off","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"One means off","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/POSITIVE-BIG-INTEGER","@type":["http://qudt.org/schema/qudt/PositiveBigIntegerType"],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"PI64","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/bits":[{"@value":"64","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"8","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/maxInclusive":[{"@value":"2^{64}-1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/minInclusive":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/mySQLName":[{"@value":"BIGINT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#unsignedLong"}],"http://qudt.org/schema/qudt/signedness":[{"@id":"http://qudt.org/vocab/datatype/Unsigned"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"PI64","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Positive Big Integer","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/POSITIVE-LONG-INTEGER","@type":["http://qudt.org/schema/qudt/PositiveIntegerType"],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"UI32","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/bits":[{"@value":"32","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"4","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/encoding":[{"@id":"http://qudt.org/vocab/datatype/UnsignedIntegerEncoding"}],"http://qudt.org/schema/qudt/maxInclusive":[{"@value":"2^{32}-1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/minInclusive":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/mySQLName":[{"@value":"INT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#unsignedInt"}],"http://qudt.org/schema/qudt/signedness":[{"@id":"http://qudt.org/vocab/datatype/Unsigned"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"PI32","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unsigned Long Integer","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/PadWithAny","@type":["http://qudt.org/schema/qudt/PaddingType"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>Pad with either a one or a zero. \n  In other words, this is the \"don't care\" option.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"none","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pad with any","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/PadWithOnes","@type":["http://qudt.org/schema/qudt/PaddingType"],"http://purl.org/dc/terms/description":[{"@value":"Pad unused bits of a field with a one.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"ones","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pad with ones","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/PadWithZeros","@type":["http://qudt.org/schema/qudt/PaddingType"],"http://purl.org/dc/terms/description":[{"@value":"Pad unused bits of a field with a zero.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"zeros","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pad with zeros","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/PartiallyOrdered","@type":["http://qudt.org/schema/qudt/OrderedType"],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Partial ordered structure.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"partial","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Partially Ordered","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/Pointer","@type":["http://qudt.org/schema/qudt/ReferenceDatatype"],"http://purl.org/dc/terms/description":[{"@value":"\n  A pointer is a programming language data type whose value refers directly to (or \"points to\") another value stored elsewhere in the computer memory using its address. \n  It references a value stored elsewhere in memory, and obtaining or requesting the value to which a pointer refers is called dereferencing the pointer. \n  A pointer is a simple implementation of the general reference data type. \n  Pointers to data improve performance for repetitive operations such as traversing string and tree structures.\n  While \"pointer\" has been used to refer to references in general, it more properly applies to data structures whose interface explicitly allows the pointer to be manipulated as a memory address.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pointer","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/QuaternionVector-DP","@type":["http://qudt.org/schema/qudt/Vector"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>This vector type is intended to hold the (real-valued) coefficients to a quaternion number. \n  That is, if $V=[a,b,c,d]$ is a vector of type <i>QUATERNION-VECTOR</i>,\n   then the proper interpretation of this vector is with respect to the basis elements $1,i,j,k$ of the quaternion algebra. \n  Specifically, the V corresponds to the quaternion $v = a*1 + b*i + c*j + d*k$. \n  Note that for most computations, the quaternion basis elements will be replaced with their 4 X 4 dimensional matrix representations,\n   which are elements of type <i>QuaternionBasisMatrix</i>. \n  In this case, the resulting quaternion will be a 4 X 4 dimensional matrix of the form:\n  </p>\n<pre>\n a   b  c  d\n-b   a -d  c\n-c   d  a -b\n-d  -c  b  a\n</pre>\n","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/datatype":[{"@id":"http://qudt.org/vocab/datatype/FLOAT-DP"}],"http://qudt.org/schema/qudt/dimensionality":[{"@value":"4","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/dimensions":[{"@id":"_:n3-414"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"340","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Quaternion Vector - double precision","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/RELATIVE-DATETIME","@type":["http://qudt.org/schema/qudt/DateStringType"],"http://purl.org/dc/terms/description":[{"@value":"Days and time relative to some Epoch","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/dimensionality":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/id":[{"@value":"T004-08","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"76","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"reldate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Relative Date And Time","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/RN_BINARY-BASE","@type":["http://qudt.org/schema/qudt/RealNumberType"],"http://purl.org/dc/terms/description":[{"@value":"A rational number can be expressed in the form m*b^e, where m (the mantissa), b (the base), and e (the exponent) are integers. In this case b is chosen to be 2, and then the values of m and e are determined given this choice of base.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Real number binary base","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/RN_DECIMAL-BASE","@type":["http://qudt.org/schema/qudt/RealNumberType"],"http://purl.org/dc/terms/description":[{"@value":"A rational number can be expressed in the form m*b^e, where m (the mantissa), b (the base), and e (the exponent) are integers. In this case b is chosen to be 10, and then the values of m and e are determined given this choice of base.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Real number decminal base","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/SIGNED-BIG-INTEGER","@type":["http://qudt.org/schema/qudt/SignedBigIntegerType"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>The <em>Signed Big Integer</em>, (<em>long</em> in Java) data type is a 64-bit signed two's complement integer. \n  It has a minimum value of -9,223,372,036,854,775,808 and a maximum value of 9,223,372,036,854,775,807 (inclusive). \n  Use this data type when you need a range of values wider than those provided by int.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"SI64","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/bits":[{"@value":"64","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"8","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/encoding":[{"@id":"http://qudt.org/vocab/datatype/LongUnsignedIntegerEncoding"}],"http://qudt.org/schema/qudt/id":[{"@value":"T002-02","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/javaName":[{"@value":"long","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/matlabName":[{"@value":"int64","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/maxInclusive":[{"@value":"2^{63}-1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/minInclusive":[{"@value":"-2^{63}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/mySQLName":[{"@value":"BIGINT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/protocolBuffersName":[{"@value":"int64","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#long"}],"http://qudt.org/schema/qudt/signedness":[{"@id":"http://qudt.org/vocab/datatype/Signed"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"109","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"SI64","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Signed Big Integer","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"http://docs.oracle.com/javase/tutorial/java/nutsandbolts/datatypes.html"},{"@id":"http://docs.python.org/2/library/stdtypes.html"},{"@id":"http://msdn.microsoft.com/en-us/library/4xwz0t37(v=vs.71).aspx"},{"@id":"http://www.mathworks.com/help/matlab/ref/int16.html"},{"@value":"http://docs.oracle.com/javase/tutorial/java/nutsandbolts/datatypes.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://docs.python.org/2/library/stdtypes.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://msdn.microsoft.com/en-us/library/4xwz0t37(v=vs.71).aspx","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.mathworks.com/help/matlab/ref/int16.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}]},{"@id":"http://qudt.org/vocab/datatype/SIGNED-INTEGER","@type":["http://qudt.org/schema/qudt/SignedIntegerType"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Signed Integer</em> or 'short' data type is a 16-bit signed two's complement integer. \n  It has a minimum value of -32,768 and a maximum (inclusive) value of 32,767. \n  As with byte, the same guidelines apply: you can use a short to save memory in large arrays,\n   in situations where the memory savings actually matters.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"SI16","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ansiSQLName":[{"@value":"SMALLINT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/bits":[{"@value":"16","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"2","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/encoding":[{"@id":"http://qudt.org/vocab/datatype/ShortSignedIntegerEncoding"}],"http://qudt.org/schema/qudt/id":[{"@value":"T002-03","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/javaName":[{"@value":"short","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/jsName":[{"@value":"short","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/matlabName":[{"@value":"int16","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/maxInclusive":[{"@value":"32767","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/microsoftSQLServerName":[{"@value":"smallint","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/minInclusive":[{"@value":"-32767","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/mySQLName":[{"@value":"SMALLINT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#short"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"105","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"SI16","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Signed Integer","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"http://docs.oracle.com/javase/tutorial/java/nutsandbolts/datatypes.html"},{"@id":"http://docs.python.org/2/library/stdtypes.html"},{"@id":"http://msdn.microsoft.com/en-us/library/4xwz0t37(v=vs.71).aspx"},{"@id":"http://www.mathworks.com/help/matlab/ref/int16.html"}]},{"@id":"http://qudt.org/vocab/datatype/SIGNED-LONG-INTEGER","@type":["http://qudt.org/schema/qudt/SignedLongIntegerType"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Signed Long Integer</em> is a 32 bit signed integer in 2's complement form.  \n  It has a minimum value of -2,147,483,648 and a maximum value of 2,147,483,647 (inclusive). \n  For integral values, this data type is generally the default choice unless there is a reason (like the above) to choose something else. \n  This data type will most likely be large enough for the numbers a program will use.\n  If a wider range of values is needed use long instead.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"SI32","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ansiSQLName":[{"@value":"INTEGER","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/bits":[{"@value":"32","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"4","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/cName":[{"@value":"int","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/id":[{"@value":"T002-04","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/javaName":[{"@value":"int","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/jsName":[{"@value":"int","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/matlabName":[{"@value":"int32","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/maxInclusive":[{"@value":"2^{31}-1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/microsoftSQLServerName":[{"@value":"integer","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/minInclusive":[{"@value":"-2^{31}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/mySQLName":[{"@value":"INT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/odbcName":[{"@value":"SQL_INTEGER","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/oleDBName":[{"@value":"DBTYPE_I4","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/oracleSQLName":[{"@value":"NUMBER(10)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/protocolBuffersName":[{"@value":"int32","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#int"}],"http://qudt.org/schema/qudt/signedness":[{"@id":"http://qudt.org/vocab/datatype/Signed"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"SI32","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Signed Long Integer","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"http://docs.oracle.com/javase/tutorial/java/nutsandbolts/datatypes.html"},{"@id":"http://docs.python.org/2/library/stdtypes.html"},{"@id":"http://msdn.microsoft.com/en-us/library/4xwz0t37(v=vs.71).aspx"},{"@value":"http://docs.oracle.com/javase/tutorial/java/nutsandbolts/datatypes.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://docs.python.org/2/library/stdtypes.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://msdn.microsoft.com/en-us/library/4xwz0t37(v=vs.71).aspx","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}]},{"@id":"http://qudt.org/vocab/datatype/SIGNED-MEDIUM-INTEGER","@type":["http://qudt.org/schema/qudt/SignedMediumIntegerType"],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"SI24","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/bits":[{"@value":"24","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"3","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/maxInclusive":[{"@value":"8388607","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/minInclusive":[{"@value":"-8388608","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/mySQLName":[{"@value":"MEDIUMINT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Signed Medium Integer","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"http://dev.mysql.com/doc/refman/5.0/en/integer-types.html"}]},{"@id":"http://qudt.org/vocab/datatype/SIGNED-SHORT-INTEGER","@type":["http://qudt.org/schema/qudt/SignedShortIntegerType"],"http://purl.org/dc/terms/description":[{"@value":"Unsigned 8 bit integer.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"SI8","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ansiSQLName":[{"@value":"NUMERIC(3,0)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/bits":[{"@value":"8","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/encoding":[{"@id":"http://qudt.org/vocab/datatype/OctetEncoding"}],"http://qudt.org/schema/qudt/id":[{"@value":"T002-06","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/maxInclusive":[{"@value":"127","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/microsoftSQLServerName":[{"@value":"tinyint","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/minInclusive":[{"@value":"-127","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/mySQLName":[{"@value":"TINYINT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/odbcName":[{"@value":"SQL_TINYINT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/oleDBName":[{"@value":"DBTYPE_I1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#byte"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"103","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"SI8","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Signed Short Integer","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/STRING","@type":["http://qudt.org/schema/qudt/StringType"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>String</em> is an ordered list of characters.\n  Typically the characters are UTF-8 characters.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/dimensionality":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/memberDatatype":[{"@id":"http://qudt.org/vocab/datatype/CHAR"}],"http://qudt.org/schema/qudt/protocolBuffersName":[{"@value":"string","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"string","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"String","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/Seidelmann2000","@type":["http://qudt.org/schema/qudt/Citation"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>“Report of the IAU/IAG Working Group on Cartographic Coordinates and Rotational Elements of the Planets and Satellites: 2000”,\n   P.K. Seidelmann, V. K. Abalakin, M. Bursa, M. E. Davies, C. DeBergh, J. H. Lieske, J. Oberst, J. L. Simon, E. M. Standish, P. Stooke, and P. C. Thomas,\n   Celestial Mechanics and Dynamical Astronomy 82: 83-110, 2002 (http://springerlink.metapress.com,\n   follow the links from “Browse by Online Libraries (subject areas)”, then “Physics and Astronomy”,\n   then “Celestial Mechanics and Dynamical Astronomy”, then “Volume 82 - Number 1/January 2002”,\n   then follow the links to download the paper.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Seidelmann2000","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/ShortSignedIntegerEncoding","@type":["http://qudt.org/schema/qudt/IntegerEncodingType"],"http://qudt.org/schema/qudt/bytes":[{"@value":"2","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Short Signed Integer Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/ShortUnsignedIntegerEncoding","@type":["http://qudt.org/schema/qudt/BooleanEncodingType","http://qudt.org/schema/qudt/IntegerEncodingType"],"http://qudt.org/schema/qudt/bytes":[{"@value":"2","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Short Unsigned Integer Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/Signed","@type":["http://qudt.org/schema/qudt/SignednessType"],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"signed","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Signed","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/SignedIntegerEncoding","@type":["http://qudt.org/schema/qudt/IntegerEncodingType"],"http://qudt.org/schema/qudt/bytes":[{"@value":"4","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Signed Integer Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/SinglePrecisionRealEncoding","@type":["http://qudt.org/schema/qudt/FloatingPointEncodingType"],"http://qudt.org/schema/qudt/bytes":[{"@value":"32","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Single Precision Real Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/SystemModifiableParameter","@type":["http://qudt.org/schema/qudt/ParameterModifiabilityType"],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"system","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Parameter is modifiable by a (computer) system.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"System modifiable parameter","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/TIME","@type":["http://qudt.org/schema/qudt/TimeStringType"],"http://purl.org/dc/terms/description":[{"@value":"Time in hh:mm:ss[Z|(+|-)hh:mm]format.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/dimensionality":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/id":[{"@value":"T004-12","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#time"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"68","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"time","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"TIME","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/TRUE","@type":["http://qudt.org/schema/qudt/BooleanTypeEnumeratedValue"],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"True","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/TYPE-MATRIX-4by4-FLOATDP","@type":["http://qudt.org/schema/qudt/TypeList"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"TYPE-MATRIX-4by4-FLOATDP","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/TotallyOrdered","@type":["http://qudt.org/schema/qudt/OrderedType"],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Totally ordered structure.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"total","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Totally Ordered","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/UNARY-FUNCTION","@type":["http://qudt.org/schema/qudt/FunctionDatatype"],"http://purl.org/dc/terms/description":[{"@value":"This type identifies functions that have exactly one argument.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/functionArity":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"UNARY-FUNCTION","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/UNSIGNED-BIG-INTEGER","@type":["http://qudt.org/schema/qudt/UnsignedBigIntegerType"],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"UI64","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/bits":[{"@value":"64","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"8","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/id":[{"@value":"T002-08","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/maxInclusive":[{"@value":"2^{64}-1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/minInclusive":[{"@value":"0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/mySQLName":[{"@value":"BIGINT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#unsignedLong"}],"http://qudt.org/schema/qudt/signedness":[{"@id":"http://qudt.org/vocab/datatype/Unsigned"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"117","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"UI64","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unsigned Big Integer","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/UNSIGNED-INTEGER","@type":["http://qudt.org/schema/qudt/UnsignedIntegerType"],"http://purl.org/dc/terms/description":[{"@value":"An unsigned 16-bit integer in the range 0 to 65,535","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"UI16","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/bits":[{"@value":"16","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/id":[{"@value":"T002-09","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/maxInclusive":[{"@value":"65535","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/microsoftSQLServerName":[{"@value":"smallint","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/minInclusive":[{"@value":"0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/mySQLName":[{"@value":"SMALLINT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#unsignedShort"}],"http://qudt.org/schema/qudt/signedness":[{"@id":"http://qudt.org/vocab/datatype/Unsigned"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"113","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"UI16","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unsigned Integer","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/UNSIGNED-LONG-INTEGER","@type":["http://qudt.org/schema/qudt/UnsignedLongIntegerType"],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"UI32","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/bits":[{"@value":"32","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"4","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/encoding":[{"@id":"http://qudt.org/vocab/datatype/UnsignedIntegerEncoding"}],"http://qudt.org/schema/qudt/id":[{"@value":"T002-10","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/maxInclusive":[{"@value":"2^{32}-1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/minInclusive":[{"@value":"0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/mySQLName":[{"@value":"INT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#unsignedInt"}],"http://qudt.org/schema/qudt/signedness":[{"@id":"http://qudt.org/vocab/datatype/Unsigned"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"115","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"UI32","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unsigned Long Integer","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/UNSIGNED-MEDIUM-INTEGER","@type":["http://qudt.org/schema/qudt/UnsignedMediumIntegerType"],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"UI24","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/bits":[{"@value":"24","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"3","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/maxInclusive":[{"@value":"8388607","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/minInclusive":[{"@value":"-8388608","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/mySQLName":[{"@value":"MEDIUMINT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/signedness":[{"@id":"http://qudt.org/vocab/datatype/Unsigned"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unsigned Medium Integer","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"http://dev.mysql.com/doc/refman/5.0/en/integer-types.html"}]},{"@id":"http://qudt.org/vocab/datatype/UNSIGNED-SHORT-INTEGER","@type":["http://qudt.org/schema/qudt/OctetType"],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"UI8","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/bits":[{"@value":"8","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/id":[{"@value":"T002-13","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/maxInclusive":[{"@value":"255","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/microsoftSQLServerName":[{"@value":"tinyint","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/minInclusive":[{"@value":"0","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/oleDBName":[{"@value":"DBTYPE_UI1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#unsignedByte"}],"http://qudt.org/schema/qudt/signedness":[{"@id":"http://qudt.org/vocab/datatype/Unsigned"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"111","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"UI8","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unsigned Short Integer","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"http://msdn.microsoft.com/en-us/library/aa275635(v=sql.80).aspx"},{"@value":"http://msdn.microsoft.com/en-us/library/aa275635(v=sql.80).aspx","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}]},{"@id":"http://qudt.org/vocab/datatype/UTC-DATETIME","@type":["http://qudt.org/schema/qudt/DateStringType"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>UTC is the time-scale maintained by the BIPM, with assistance from the IERS, which forms the basis of a coordinated dissemination of standard frequencies and time signals. \n  It corresponds exactly in rate with  the international reference scale of atomic time (TAI) but differs from it by an integer number of seconds.  \n  TAI, based on the second (SI), as realized on the rotating geoid, is formed by the BIPM on the basis of clock data supplied by cooperating establishments. \n  It is in the form of a continuous scale, e.g. in days, hours, minutes and seconds from the origin 1 January, 1958 (adopted by the CGPM 1971).\n  </p>\n  <p>UTC date times are expressed as \"YYYY-MM-DDThh:mm:ss[.dd]\" or \"YYYY-DDDThh:mm:ss[.dd]\",\n   where 'YYYY' is the year, 'MM' is the two-digit month, 'DD' is the two-digit day, 'DDD' is the three digit day of year, 'T' is constant,\n    'hh:mm:ss[.dd]' is the UTC time in hours, minutes, seconds, and optional fractional seconds. \n  As many 'd' characters to the right of the period as required may be used to obtain the required precision. All fields require leading zeros.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/dimensionality":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/datatype/DATETIME"}],"http://qudt.org/schema/qudt/id":[{"@value":"T004-13","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#dateTime"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"78","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"utc-date","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"UTC Date Time","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/UTC-DAYTIME","@type":["http://qudt.org/schema/qudt/DateStringType"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>\n  UTC day time is expressed as \"YYYY-DDDThh:mm:ss.ddZ\", where each character is an ASCII character using one octet with the following meanings:\n   YYYY = Year in four-character subfield with values 0001-9999,\n   DDD = Day of year in three-character subfield with values 001-365 or -366,\n   T =  Calendar-Time separator,\n   hh = Hour in two-character subfield with values 00-23,\n   mm = Minute in two-character subfield with values 00-59,\n   ss = Second in two-character subfield with values 00-59 (-58 or -60 during leap seconds),\n   dd = Decimal fraction of second in one- to n-character subfield, each d has values 0-9, and Z = time code terminator (optional)\" \n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/dimensionality":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/id":[{"@value":"T004-14","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://qudt.org/vocab/datatype/UTC-DayTime"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"79","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"utc-dayTime","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"UTC DAY TIME","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/UTC-DayTime","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype"],"http://purl.org/dc/terms/description":[{"@value":"YYYY-DDDThh:mm:ss.ddZ, where each character is an ASCII character using one octet with the following meanings: YYYY = Year in four-character subfield with values 0001-9999, DDD = Day of year in three-character subfield with values 001-365 or -366, T =  Calendar-Time separator, hh = Hour in two-character subfield with values 00-23,  mm = Minute in two-character subfield with values 00-59, ss = Second in two-character subfield with values 00-59 (-58 or -60 during leap seconds), dd = Decimal fraction of second in one- to n-character subfield, each d has values 0-9, and Z = time code terminator (optional)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"[0-9]{4}\\\\-[0-9]{3}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\\\.[0-9]{2}Z?","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"UTC Day time","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/UTF16-CHAR","@type":["http://qudt.org/schema/qudt/CharacterType"],"http://qudt.org/schema/qudt/bits":[{"@value":"16","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"2","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/id":[{"@value":"T001-04","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#short"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"150","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"utf16","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"UTF16 CHAR","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/UTF16-STRING","@type":["http://qudt.org/schema/qudt/StringUTF16"],"http://qudt.org/schema/qudt/dimensionality":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/encoding":[{"@id":"http://qudt.org/vocab/datatype/UTF16-StringEncoding"}],"http://qudt.org/schema/qudt/memberDatatype":[{"@id":"http://qudt.org/vocab/datatype/UTF16-CHAR"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"utf16","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"UTF16 String","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/UTF16-StringEncoding","@type":["http://qudt.org/schema/qudt/StringEncodingType"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"UTF-16 String","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/UTF8-CHAR","@type":["http://qudt.org/schema/qudt/CharacterType"],"http://qudt.org/schema/qudt/bits":[{"@value":"8","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/id":[{"@value":"T001-05","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#byte"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"122","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"utf8","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"UTF8 CHAR","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/UTF8-STRING","@type":["http://qudt.org/schema/qudt/StringUTF8"],"http://purl.org/dc/terms/description":[{"@value":"String consisting of UTF-8 characters","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/dimensionality":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/encoding":[{"@id":"http://qudt.org/vocab/datatype/UTF8-StringEncoding"}],"http://qudt.org/schema/qudt/memberDatatype":[{"@id":"http://qudt.org/vocab/datatype/UTF8-CHAR"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"utf8","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"UTF8 String","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/UTF8-StringEncoding","@type":["http://qudt.org/schema/qudt/StringEncodingType"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"UTF-8 Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/Unordered","@type":["http://qudt.org/schema/qudt/OrderedType"],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Unordered structure.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"unordered","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unordered","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/Unsigned","@type":["http://qudt.org/schema/qudt/SignednessType"],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"unsigned","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unsigned","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/UnsignedIntegerEncoding","@type":["http://qudt.org/schema/qudt/IntegerEncodingType"],"http://qudt.org/schema/qudt/bytes":[{"@value":"4","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unsigned Integer Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/UserModifiableParameter","@type":["http://qudt.org/schema/qudt/ParameterModifiabilityType"],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"2","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"user","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Parameter is modifiable by a user.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"User modifiable parameter","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/WDST_DRY","@type":["http://qudt.org/schema/qudt/WetDryStateType"],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"2","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"dry","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dry","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/WDST_WET","@type":["http://qudt.org/schema/qudt/WetDryStateType"],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"wet","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Wet","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/WordAligned","@type":["http://qudt.org/schema/qudt/AlignmentType"],"http://purl.org/dc/terms/description":[{"@value":"Alignment of a field at a word boundary, that is 2 bytes.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Word aligned","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/YDT","@type":["http://qudt.org/schema/qudt/DateStringType"],"http://qudt.org/schema/qudt/dimensionality":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/id":[{"@value":"T004-16","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"215","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"YDT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Year Day Time","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/YES","@type":["http://qudt.org/schema/qudt/YesNoType"],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"Y","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Yes","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/negative","@type":["http://qudt.org/schema/qudt/Polarity"],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"negative","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"negative","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/positive","@type":["http://qudt.org/schema/qudt/Polarity"],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"2","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"positive","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"positive","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id"