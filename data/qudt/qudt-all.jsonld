nguage":"ms"},{"@value":"Mass Density","@language":"en"},{"@value":"Massendichte","@language":"de"},{"@value":"densidad","@language":"es"},{"@value":"densidade","@language":"pt"},{"@value":"densitate","@language":"ro"},{"@value":"densità","@language":"it"},{"@value":"densité","@language":"fr"},{"@value":"gęstość","@language":"pl"},{"@value":"hustota","@language":"cs"},{"@value":"yoğunluk","@language":"tr"},{"@value":"плотность","@language":"ru"},{"@value":"الكثافة","@language":"ar"},{"@value":"چگالی","@language":"fa"},{"@value":"घनत्व","@language":"hi"},{"@value":"密度","@language":"ja"},{"@value":"密度","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":" jisim isipadu","@language":"ms"},{"@value":"massa volumica","@language":"it"},{"@value":"volumenbezogene Masse","@language":"de"},{"@value":"volumic mass","@language":"en"},{"@value":"भार घनत्व","@language":"hi"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassEnergyTransferCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Mass Energy Transfer Coefficient\" is that fraction of the mass attenuation coefficient which contributes\n    to the production of kinetic energy in charged particles.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM2-PER-GM"},{"@id":"http://qudt.org/vocab/unit/M2-PER-GM"},{"@id":"http://qudt.org/vocab/unit/M2-PER-GM_DRY"},{"@id":"http://qudt.org/vocab/unit/M2-PER-KiloGM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/PhysRefData/XrayMassCoef/chap3.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\frac{\\mu_{tr}}{\\rho} = -\\frac{1}{\\rho}\\frac{1}{R}\\frac{dR_{tr}}{dl}$, where $dR_{tr}$ is the mean energy that is transferred to kinetic energy of charged particles by interactions of the incident radiation $R$ in traversing a distance $dl$ in the material of density $\\rho$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\frac{\\mu_{tr}}{\\rho}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Mass Energy Transfer Coefficient\" is that fraction of the mass attenuation coefficient which\n    contributes to the production of kinetic energy in charged particles.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MassAttenuationCoefficient"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q99714619"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassAttenuationCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Energy Transfer Coefficient","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MassAttenuationCoefficient"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassEquivalent","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Mass Equivalent\" is the mass of a substance that reacts with (or is equivalent to) an arbitrary mass of \nanother substance in a given chemical reaction.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableUni