:"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LengthRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Length Ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/LengthTemperature","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_C-CentiM"},{"@id":"http://qudt.org/vocab/unit/K-M"},{"@id":"http://qudt.org/vocab/unit/M-K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H1T0D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LengthTemperature","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Length Temperature","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LengthTemperatureTime","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM-SEC-DEG_C"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H1T1D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LengthTemperatureTime","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Length Temperature Time","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Lethargy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Lethargy\" is a dimensionless logarithm of the ratio of the energy of source neutrons to the energy\n    of neutrons after a collision.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.scribd.com/doc/51548050/149/Lethargy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$u = \\ln(\\frac{E_0}{E})$, where $E_0$ is a reference energy.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Lethargy\" is a dimensionless logarithm of the ratio of the energy of source neutrons to the\n    energy of neutrons after a collision.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"u","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q25508781"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Lethargy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Lethargy","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LevelWidth","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Level Width\" is the uncertainty in the energy of a quantum-mechanical system having discrete energy\n    levels in a state that is not strictly stationary. The system may be an atom, a molecule, or an atomic nucleus.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J"},{"@id":"http://qudt.org/vocab/unit/NanoJ"},{"@id":"http://qudt.org/vocab/unit/PicoJ"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://encyclopedia2.thefreedictionary.com/Level+Width","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\Gamma = \\frac{\\hbar}{\\tau}$, where $\\hbar$ is the reduced Planck constant and $\\tau$ is the mean lifetime.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Gamma$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Level Width\" is the uncertainty in the energy of a quantum-mechanical system having discrete\n    energy levels in a state that is not strictly stationary. The system may be an atom, a molecule, or an atomic nucleus.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98082340"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LevelWidth","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Level Width","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}]},{"@id":"http://qudt.org/vocab/quantitykind/LiftCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The lift coefficient is a dimensionless coefficient that relates the lift generated by a lifting body,\n    the dynamic pressure of the fluid flow around the body, and a reference area associated with the body.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The lift coefficient is a dimensionless coefficient that relates the lift generated by a lifting\n    body, the dynamic pressure of the fluid flow around the body, and a reference area associated with the body.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"C_{L}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q760106"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LiftCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Lift Coefficient","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}]},{"@id":"http://qudt.org/vocab/quantitykind/LiftForce","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The lift force, lifting force or simply lift is the sum of all the forces on a body that force it to move\n    perpendicular to the direction of flow.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiN"},{"@id":"http://qudt.org/vocab/unit/DYN"},{"@id":"http://qudt.org/vocab/unit/DeciN"},{"@id":"http://qudt.org/vocab/unit/GM_F"},{"@id":"http://qudt.org/vocab/unit/GigaN"},{"@id":"http://qudt.org/vocab/unit/KIP_F"},{"@id":"http://qudt.org/vocab/unit/KiloGM-M-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F"},{"@id":"http://qudt.org/vocab/unit/KiloN"},{"@id":"http://qudt.org/vocab/unit/KiloPOND"},{"@id":"http://qudt.org/vocab/unit/LB_F"},{"@id":"http://qudt.org/vocab/unit/MegaLB_F"},{"@id":"http://qudt.org/vocab/unit/MegaN"},{"@id":"http://qudt.org/vocab/unit/MicroN"},{"@id":"http://qudt.org/vocab/unit/MilliN"},{"@id":"http://qudt.org/vocab/unit/N"},{"@id":"http://qudt.org/vocab/unit/NanoN"},{"@id":"http://qudt.org/vocab/unit/OZ_F"},{"@id":"http://qudt.org/vocab/unit/PDL"},{"@id":"http://qudt.org/vocab/unit/POND"},{"@id":"http://qudt.org/vocab/unit/PlanckForce"},{"@id":"http://qudt.org/vocab/unit/TON_F_US"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The lift force, lifting force or simply lift is the sum of all the forces on a body that force it\n    to move perpendicular to the direction of flow.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Force"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"L","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q101960694"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Force","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Lift Force","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Force"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearAbsorptionCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The Linear Absorption Coefficient is a quantity that characterizes how easily a material or medium can be\n    penetrated by a beam of light, sound, particles, or other energy or matter.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PER-KiloM"},{"@id":"http://qudt.org/vocab/unit/PER-M"},{"@id":"http://qudt.org/vocab/unit/PER-MicroM"},{"@id":"http://qudt.org/vocab/unit/PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/PER-NanoM"},{"@id":"http://qudt.org/vocab/unit/PER-PicoM"},{"@id":"http://qudt.org/vocab/unit/PERCENT-PER-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Attenuation_coefficient","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\alpha(\\lambda) = \\frac{1}{\\Phi_\\lambda(\\lambda)}\\frac{d\\Phi_\\lambda(\\lambda)}{dl}$, where $\\frac{d\\Phi}{\\Phi}$ is the relative decrease, caused by absorption, in the spectral radiant flux $\\Phi$ of a collimated beam of electromagnetic radiation corresponding to the wavelength $\\lambda$ during traversal of an infinitesimal layer of a medium and $dl$ is the length traversed.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mu$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The Linear Absorption Coefficient is a quantity that characterizes how easily a material or medium\n    can be penetrated by a beam of light, sound, particles, or other energy or matter.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/AttenuationCoefficient"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q86204782"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AttenuationCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Linear Absorption Coefficient","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AttenuationCoefficient"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearAcceleration","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/FT-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/G"},{"@id":"http://qudt.org/vocab/unit/GALILEO"},{"@id":"http://qudt.org/vocab/unit/IN-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/KN-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloM-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/KiloPA-M2-PER-GM"},{"@id":"http://qudt.org/vocab/unit/M-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/MI_US-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/MicroG"},{"@id":"http://qudt.org/vocab/unit/MicroGALILEO"},{"@id":"http://qudt.org/vocab/unit/MicroM-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/MilliG"},{"@id":"http://qudt.org/vocab/unit/MilliGALILEO"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/YD-PER-SEC2"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Acceleration","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/Acceleration"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-2D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearAcceleration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Linear Acceleration","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearAttenuationCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Linear Attenuation Coefficient\", also called the attenuation coefficient,  narrow beam attenuation\n    coefficient, or absorption coefficient, is a quantity that characterizes how easily a material or medium can be penetrated by\n    a beam of light, sound, particles, or other energy or matter.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PER-KiloM"},{"@id":"http://qudt.org/vocab/unit/PER-M"},{"@id":"http://qudt.org/vocab/unit/PER-MicroM"},{"@id":"http://qudt.org/vocab/unit/PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/PER-NanoM"},{"@id":"http://qudt.org/vocab/unit/PER-PicoM"},{"@id":"http://qudt.org/vocab/unit/PERCENT-PER-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Attenuation_coefficient","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mu = -\\frac{1}{J}\\frac{dJ}{dx}$, where $J$ is the magnitude of the current rate of a beam of particles parallel to the $x-direction$.\n\nOr:\n\n$\\mu(\\lambda) = \\frac{1}{\\Phi_\\lambda(\\lambda)}\\frac{d\\Phi_\\lambda(\\lambda)}{dl}$, where $\\frac{d\\Phi}{\\Phi}$ is the relative decrease in the spectral radiant flux $\\Phi$ of a collimated beam of electromagnetic radiation corresponding to the wavelength $\\lambda$ during traversal of an infinitesimal layer of a medium and $dl$ is the length traversed.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mu$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Linear Attenuation Coefficient\", also called the attenuation coefficient,  narrow beam attenuation\n    coefficient, or absorption coefficient, is a quantity that characterizes how easily a material or medium can be penetrated by\n    a beam of light, sound, particles, or other energy or matter.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/AttenuationCoefficient"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q86204330"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AttenuationCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Linear Attenuation Coefficient","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AttenuationCoefficient"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearBitDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BIT-PER-M"},{"@id":"http://qudt.org/vocab/unit/ExbiBIT-PER-M"},{"@id":"http://qudt.org/vocab/unit/GibiBIT-PER-M"},{"@id":"http://qudt.org/vocab/unit/GigaBIT-PER-M"},{"@id":"http://qudt.org/vocab/unit/KibiBIT-PER-M"},{"@id":"http://qudt.org/vocab/unit/MebiBIT-PER-M"},{"@id":"http://qudt.org/vocab/unit/PebiBIT-PER-M"},{"@id":"http://qudt.org/vocab/unit/TebiBIT-PER-M"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/LineicDataVolume"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD074","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD074","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearBitDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Lineic Bit Density","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearCompressibility","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Linear Compressibility is a measure of the relative length change of a solid as a response to a normal\n    force change.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MicroM-PER-N"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Linear Compressibility is a measure of the relative length change of a solid as a response to a\n    normal force change.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearCompressibility","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Linear Compressibility","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The Linear density, linear mass density or linear mass is a measure of mass per unit of length, and it is\n    a characteristic of strings or other one-dimensional objects.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DENIER"},{"@id":"http://qudt.org/vocab/unit/GM-PER-KiloM"},{"@id":"http://qudt.org/vocab/unit/GM-PER-M"},{"@id":"http://qudt.org/vocab/unit/GM-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/LB-PER-FT"},{"@id":"http://qudt.org/vocab/unit/LB-PER-IN"},{"@id":"http://qudt.org/vocab/unit/MilliGM-PER-M"},{"@id":"http://qudt.org/vocab/unit/SLUG-PER-FT"},{"@id":"http://qudt.org/vocab/unit/TEX"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Linear_density","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\rho_l = \\frac{dm}{dl}$, where $m$ is mass and $l$ is length.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\rho_l$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The Linear density, linear mass density or linear mass is a measure of mass per unit of length, and\n    it is a characteristic of strings or other one-dimensional objects.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/LineicMass"},{"@id":"http://qudt.org/vocab/quantitykind/MassPerLength"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q56298294"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LineicMass","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:MassPerLength","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Linear Density","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/LineicMass"},{"@id":"http://qudt.org/vocab/quantitykind/MassPerLength"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearElectricCharge","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/C-PER-M"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeLineDensity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD075","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD075","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearElectricCharge","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Lineic Electric Charge","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearElectricChargeDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In electromagnetism, charge density is a measure of electric charge per unit volume of space, in one, two\n    or three dimensions. More specifically: the linear, surface, or volume charge density is the amount of electric charge per\n    unit length, surface area, or volume, respectively.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/C-PER-M"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeLineDensity"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$linear-charge-density$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Charge_density","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\rho_l = \\frac{dQ}{dl}$, where $Q$ is electric charge and $l$ is length.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\rho_l$","@type":"http://qudt.org/schema/qudt/LatexString"},{"@value":"$\\tau$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In electromagnetism, charge density is a measure of electric charge per unit volume of space, in\n    one, two or three dimensions. More specifically: the linear, surface, or volume charge density is the amount of electric\n    charge per unit length, surface area, or volume, respectively.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearElectricChargeDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Charge Linear Density","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearElectricCurrent","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Linear Electric Current\" is the electric current per unit length.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/A-PER-M"},{"@id":"http://qudt.org/vocab/unit/A-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/KiloA-PER-M"},{"@id":"http://qudt.org/vocab/unit/MilliA-PER-IN"},{"@id":"http://qudt.org/vocab/unit/MilliA-PER-MilliM"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPerLength"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD076","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.asknumbers.com/ElectricalConversion.aspx","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD076","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Linear Electric Current\" is the electric current per unit length.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/LinearElectricCurrentDensity"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearElectricCurrentDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Linear Electric Current","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/LinearElectricCurrentDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearElectricCurrentDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Linear Electric Current Density\" is the electric current per unit length. Electric current, $I$,\n    through a curve $C$ is defined as $I = \\int_C J _s \\times e_n$, where $e_n$ is a unit vector perpendicular to the surface\n    and line vector element, and $dr$ is the differential of position vector $r$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/A-PER-M"},{"@id":"http://qudt.org/vocab/unit/A-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/KiloA-PER-M"},{"@id":"http://qudt.org/vocab/unit/MilliA-PER-IN"},{"@id":"http://qudt.org/vocab/unit/MilliA-PER-MilliM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.asknumbers.com/ElectricalConversion.aspx","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$J_s = \\rho_A v$, where $\\rho_A$ is surface density of electric charge and $v$ is velocity.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J_s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q2356741"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearElectricCurrentDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Linear Electric Current Density","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeSurfaceDensity"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearEnergyTransfer","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Linear Energy Transfer\"  (LET) is the linear density of energy lost by a charged ionizing particle\n    travelling through matter.Typically, this measure is used to quantify the effects of ionizing radiation on biological\n    specimens or electronic devices.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-M"},{"@id":"http://qudt.org/vocab/unit/KiloEV-PER-MicroM"},{"@id":"http://qudt.org/vocab/unit/MegaEV-PER-CentiM"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Linear_energy_transfer","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Linear_energy_transfer","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"For ionizing charged particles, $L_\\Delta = \\frac{dE_\\Delta}{dl}$, where $dE_\\Delta$ is the mean energy lost in elctronic collisions locally to matter along a small path through the matter, minus the sum of the kinetic energies of all the electrons released with kinetic energies in excess of $\\Delta$, and $dl$ is the length of that path.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$L_\\Delta$","@type":"http://qudt.org/schema/qudt/LatexString"},{"@value":"$L_\\bigtriangleup$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Linear Energy Transfer\"  (LET) is the linear density of energy lost by a charged ionizing particle\n    travelling through matter.Typically, this measure is used to quantify the effects of ionizing radiation on biological\n    specimens or electronic devices.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1699996"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearEnergyTransfer","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Linear Energy Transfer","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearExpansionCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PERCENT-PER-DecaK"},{"@id":"http://qudt.org/vocab/unit/PERCENT-PER-K"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ373#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalCoefficientOfLinearExpansion"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$lnr-exp-coef$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H-1T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD399","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD399","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\alpha_l = \\frac{1}{l} \\; \\frac{dl}{dT}$, where $l$ is $length$ and $T$ is thermodynamic temperature.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\alpha_l$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H1T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ExpansionRatio"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q74760821"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearExpansionCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Linear Expansion Coefficient","@language":"en"},{"@value":"coefficient de dilatation linéique","@language":"fr"},{"@value":"coefficiente di dilatazione lineare","@language":"it"},{"@value":"coeficiente de dilatação térmica linear","@language":"pt"},{"@value":"coeficiente de expansión térmica lineal","@language":"es"},{"@value":"linearer Ausdehnungskoeffizient","@language":"de"},{"@value":"współczynnik liniowej rozszerzalności cieplnej","@language":"pl"},{"@value":"معدل التمدد الحراري الخطي","@language":"ar"},{"@value":"線熱膨張係数","@language":"ja"},{"@value":"线性热膨胀系数","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ExpansionRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearForce","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Another name for Force Per Length, used by the Industry Foundation Classes (IFC) standard.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DYN-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F-PER-FT"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-M"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-FT"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-IN"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-YD"},{"@id":"http://qudt.org/vocab/unit/MilliN-PER-M"},{"@id":"http://qudt.org/vocab/unit/N-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/N-PER-M"},{"@id":"http://qudt.org/vocab/unit/N-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-IN"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD077","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD077","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Another name for Force Per Length, used by the Industry Foundation Classes (IFC) standard.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerLength"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ForcePerLength","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Linear Force","@language":"en"},{"@value":"Streckenlast","@language":"de"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerLength"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearIonization","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Linear Ionization\"  is a description of how the ionization of an atom or molecule takes place. For\n    example, an ion with a +2 charge can be created only from an ion with a +1 charge or a +3 charge. That is, the numerical\n    charge of an atom or molecule must change sequentially, always moving from one number to an adjacent, or sequential, number.\n    Using sequential ionization definition.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PER-KiloM"},{"@id":"http://qudt.org/vocab/unit/PER-M"},{"@id":"http://qudt.org/vocab/unit/PER-MicroM"},{"@id":"http://qudt.org/vocab/unit/PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/PER-NanoM"},{"@id":"http://qudt.org/vocab/unit/PER-PicoM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Ionization#Classical_ionization","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$N_{il} = \\frac{1}{e}\\frac{dQ}{dl}$, where $e$ is the elementary charge and $dQ$ is the average total charge of all positive ions produced over an infinitesimal element of the path with length $dl$ by an ionizing charged particle.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Linear Ionization\"  is a description of how the ionization of an atom or molecule takes place. For\n    example, an ion with a +2 charge can be created only from an ion with a +1 charge or a +3 charge. That is, the numerical\n    charge of an atom or molecule must change sequentially, always moving from one number to an adjacent, or sequential, number.\n    Using sequential ionization definition.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"N_{il}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98690755"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearIonization","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Linear Ionization","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearLogarithmicRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/Log10RatioPerLength"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.5.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD078","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD078","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Linear Logarithmic Ratio","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearMass","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-KiloM"},{"@id":"http://qudt.org/vocab/unit/LB-PER-YD"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD079","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD079","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearMass","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Lineic Mass","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearMomentum","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Linear momentum is the quantity obtained by multiplying the mass of a body by its linear velocity. The\n    momentum of a continuous medium is given by the integral of the velocity over the mass of the medium or by the product of the\n    total mass of the medium and the velocity of the center of gravity of the medium.The SI unit for linear momentum is\n    meter-kilogram per second ($m-kg/s$).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-M-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MegaEV-PER-SpeedOfLight"},{"@id":"http://qudt.org/vocab/unit/N-M-SEC-PER-M"},{"@id":"http://qudt.org/vocab/unit/N-SEC"},{"@id":"http://qudt.org/vocab/unit/PlanckMomentum"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Momentum","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/Momentum"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Momentum","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"p = m\\upsilon","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"p","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearMomentum","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Linear Momentum","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearNumberDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/NUM-PER-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The number of countable entities (particles, objects, events) per unit length.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearNumberDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Linear Number Density","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearPower","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/W-PER-M"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/LineicPower"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD080","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD080","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearPower","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Lineic Power","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearResistance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/GigaOHM-PER-M"},{"@id":"http://qudt.org/vocab/unit/KiloOHM-PER-M"},{"@id":"http://qudt.org/vocab/unit/MegaOHM-PER-KiloM"},{"@id":"http://qudt.org/vocab/unit/MegaOHM-PER-M"},{"@id":"http://qudt.org/vocab/unit/MilliOHM-PER-M"},{"@id":"http://qudt.org/vocab/unit/OHM-PER-KiloM"},{"@id":"http://qudt.org/vocab/unit/OHM-PER-M"},{"@id":"http://qudt.org/vocab/unit/OHM-PER-MI"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/LineicResistance"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-2L1I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD081","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD081","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearResistance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Lineic Resistance","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearStiffness","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Stiffness is the extent to which an object resists deformation in response to an applied force. Linear\n    Stiffness is the term used in the Industry Foundation Classes (IFC) standard.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DYN-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F-PER-FT"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-M"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-FT"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-IN"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-YD"},{"@id":"http://qudt.org/vocab/unit/MilliN-PER-M"},{"@id":"http://qudt.org/vocab/unit/N-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/N-PER-M"},{"@id":"http://qudt.org/vocab/unit/N-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-IN"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Stiffness","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Stiffness is the extent to which an object resists deformation in response to an applied force.\n    Linear Stiffness is the term used in the Industry Foundation Classes (IFC) standard.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerLength"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ForcePerLength","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Linear Force","@language":"en"},{"@value":"Streckenlast","@language":"de"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerLength"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearStrain","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A strain is a normalized measure of deformation representing the displacement between particles in the\n    body relative to a reference length.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/Strain"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Deformation_(mechanics)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\xi = \\frac{\\Delta l}{l_0}$, where $\\Delta l$ is the increase in length and $l_0$ is the length in a reference state to be specified.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\xi$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A strain is a normalized measure of deformation representing the displacement between particles in\n    the body relative to a reference length.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/LengthRatio"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1990546"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LengthRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Linear Strain","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/VolumeStrain"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/LengthRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearThermalExpansion","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"When the temperature of a substance changes, the energy that is stored in the intermolecular bonds\n    between atoms changes. When the stored energy increases, so does the length of the molecular bonds. As a result, solids\n    typically expand in response to heating and contract on cooling; this dimensional response to temperature change is expressed\n    by its coefficient of thermal expansion. Different coefficients of thermal expansion can be defined for a substance depending\n    on whether the expansion is measured by: linear thermal expansion, area thermal expansion, or volumetric thermal expansion.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB_F-DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB_F-DEG_R"},{"@id":"http://qudt.org/vocab/unit/CentiM-PER-K"},{"@id":"http://qudt.org/vocab/unit/FT-PER-DEG_F"},{"@id":"http://qudt.org/vocab/unit/IN-PER-DEG_F"},{"@id":"http://qudt.org/vocab/unit/M-PER-K"},{"@id":"http://qudt.org/vocab/unit/MicroM-PER-K"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-K"},{"@id":"http://qudt.org/vocab/unit/YD-PER-DEG_F"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H-1T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Thermal_expansion#Length","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/TemperatureBasedLength"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"When the temperature of a substance changes, the energy that is stored in the intermolecular bonds\n    between atoms changes. When the stored energy increases, so does the length of the molecular bonds. As a result, solids\n    typically expand in response to heating and contract on cooling; this dimensional response to temperature change is expressed\n    by its coefficient of thermal expansion. Different coefficients of thermal expansion can be defined for a substance depending\n    on whether the expansion is measured by: linear thermal expansion, area thermal expansion, or volumetric thermal expansion.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearThermalExpansion","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Linear Thermal Expansion","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/TemperatureBasedLength"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearTorque","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/LB_F-FT-PER-IN"},{"@id":"http://qudt.org/vocab/unit/LB_F-IN-PER-IN"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD082","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD082","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearTorque","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Lineic Torque","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Linear Velocity, as the name implies deals with speed in a straight line, the units are often $km/hr$ or\n    $m/s$ or $mph$ (miles per hour). Linear Velocity (v) = change in distance/change in time, where $v = \\bigtriangleup\n    d/\\bigtriangleup t$\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/CentiM-PER-KiloYR"},{"@id":"http://qudt.org/vocab/unit/CentiM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/CentiM-PER-YR"},{"@id":"http://qudt.org/vocab/unit/FT-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/FT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/FT-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/FT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/GigaHZ-M"},{"@id":"http://qudt.org/vocab/unit/IN-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/IN-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/IN-PER-YR"},{"@id":"http://qudt.org/vocab/unit/KN"},{"@id":"http://qudt.org/vocab/unit/KiloM-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/KiloM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/M-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/M-PER-HR"},{"@id":"http://qudt.org/vocab/unit/M-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/M-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/M-PER-YR"},{"@id":"http://qudt.org/vocab/unit/MI-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MI-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MI-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MI_N-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MI_N-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MicroM-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MicroM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-MIN"},{"@id":"