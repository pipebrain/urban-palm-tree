},{"@value":"Coulomb por Metro","@language":"pt"},{"@value":"Coulomb pro Meter","@language":"de"},{"@value":"Coulombium per Metrum","@language":"la"},{"@value":"Culombio por Metro","@language":"es"},{"@value":"Kulomb na Metr","@language":"pl"},{"@value":"Κουλόμπ ανά Μέτρο","@language":"el"},{"@value":"Кулон на Метр","@language":"ru"},{"@value":"Кулон на Метър","@language":"bg"}]},{"@id":"http://qudt.org/vocab/unit/C-PER-M2","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Coulomb Per Square Meter ($C/m^2$) is a unit in the category of Electric charge surface density. It is\n    also known as coulombs per square meter, coulomb per square metre, coulombs per square metre, coulomb/square meter,\n    coulomb/square metre. This unit is commonly used in the SI unit system. Coulomb Per Square Meter (C/m2) has a dimension of\n    $L^{-2}TI$ where $L$ is length, $T$ is time, and $I$ is electric current. This unit is the standard SI unit in this category.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$C/m^{2}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-794"},{"@id":"_:n3-795"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerArea"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPolarization"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA134","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA134","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"C/m²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"C.m-2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"A34","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerArea"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPolarization"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q68343206"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Coulomb na Kvadratni Meter","@language":"sl"},{"@value":"Coulomb na Čtvereční Metr","@language":"cs"},{"@value":"Coulomb par Mètre Carré","@language":"fr"},{"@value":"Coulomb pe Metru Pătrat","@language":"ro"},{"@value":"Coulomb per Meter Persegi","@language":"ms"},{"@value":"Coulomb per Metrekare","@language":"tr"},{"@value":"Coulomb per Metro Quadrato","@language":"it"},{"@value":"Coulomb per Square Meter","@language":"en-us"},{"@value":"Coulomb per Square Metre","@language":"en"},{"@value":"Coulomb per Square Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Coulomb por Metro Quadrado","@language":"pt"},{"@value":"Coulomb pro Quadratmeter","@language":"de"},{"@value":"Coulombium per Metrum Quadratum","@language":"la"},{"@value":"Culombio por Metro Cuadrado","@language":"es"},{"@value":"Kulomb na Metr Kwadratowy","@language":"pl"},{"@value":"Κουλόμπ ανά Τετραγωνικό Μέτρο","@language":"el"},{"@value":"Кулон на Квадратен Метър","@language":"bg"},{"@value":"Кулон на Квадратный Метр","@language":"ru"},{"@value":"كولوم في المتر المربع","@language":"ar"},{"@value":"کولمب/کولن بر مترمربع","@language":"fa"},{"@value":"कूलम्ब प्रति वर्ग मीटर","@language":"hi"},{"@value":"クーロン毎平方メートル","@language":"ja"},{"@value":"库伦每平方米","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/C-PER-M3","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Coulomb Per Cubic Meter ($C/m^{3}$) is a unit in the category of Electric charge density. It is also\n    known as coulomb per cubic metre, coulombs per cubic meter, coulombs per cubic metre, coulomb/cubic meter, coulomb/cubic\n    metre. This unit is commonly used in the SI unit system. Coulomb Per Cubic Meter has a dimension of $L^{-3}TI$ where $L$ is\n    length, $T$ is time, and $I$ is electric current. This unit is the standard SI unit in this category.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$C/m^{3}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-3I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-796"},{"@id":"_:n3-797"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeDensity"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeVolumeDensity"},{"@id":"http://qudt.org/vocab/quantitykind/VolumeDensityOfCharge"},{"@id":"http://qudt.org/vocab/quantitykind/VolumetricElectricCharge"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/M3-PER-C"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA135","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA135","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"C/m³","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"C.m-3","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"A29","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeDensity"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeVolumeDensity"},{"@id":"http://qudt.org/vocab/quantitykind/VolumeDensityOfCharge"},{"@id":"http://qudt.org/vocab/quantitykind/VolumetricElectricCharge"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q69425409"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Coulomb na Kubični Meter","@language":"sl"},{"@value":"Coulomb na Metr Krychlový","@language":"cs"},{"@value":"Coulomb par Mètre Cube","@language":"fr"},{"@value":"Coulomb pe Metru Cub","@language":"ro"},{"@value":"Coulomb per Cubic Meter","@language":"en-us"},{"@value":"Coulomb per Cubic Metre","@language":"en"},{"@value":"Coulomb per Cubic Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Coulomb per Meter Kubik","@language":"ms"},{"@value":"Coulomb per Metreküp","@language":"tr"},{"@value":"Coulomb per Metro Cubo","@language":"it"},{"@value":"Coulomb por Metro Cúbico","@language":"pt"},{"@value":"Coulomb pro Kubikmeter","@language":"de"},{"@value":"Coulombium per Metrum Cubicum","@language":"la"},{"@value":"Culombio por Metro Cúbico","@language":"es"},{"@value":"Kulomb na Metr Sześcienny","@language":"pl"},{"@value":"Κουλόμπ ανά Κυβικό Μέτρο","@language":"el"},{"@value":"Кулон на Кубичен Метър","@language":"bg"},{"@value":"Кулон на Кубический Метр","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/C-PER-MOL","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"($C/mol$) is a unit in the category of Molar electric charge. It is also known as $coulombs/mol$. Coulomb\n    Per Mol has a dimension of $TN{-1}I$ where $T$ is time, $N$ is amount of substance, and $I$ is electric current. This unit is\n    the standard SI unit in this category.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$c-per-mol$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E1L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-798"},{"@id":"_:n3-799"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerAmountOfSubstance"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB142","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB142","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"C/mol","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"C.mol-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"A32","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerAmountOfSubstance"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q21396202"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Coulomb na Mol","@language":"cs"},{"@value":"Coulomb na Mol","@language":"sl"},{"@value":"Coulomb par Mole","@language":"fr"},{"@value":"Coulomb pe Mol","@language":"ro"},{"@value":"Coulomb per Mol","@language":"tr"},{"@value":"Coulomb per Mole","@language":"en"},{"@value":"Coulomb per Mole","@language":"it"},{"@value":"Coulomb per Mole","@language":"ms"},{"@value":"Coulomb per Mole","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Coulomb por Mol","@language":"pt"},{"@value":"Coulomb pro Mol","@language":"de"},{"@value":"Coulombium per Moles","@language":"la"},{"@value":"Culombio por Mol","@language":"es"},{"@value":"Kulomb na Mol","@language":"pl"},{"@value":"Κουλόμπ ανά Μολ","@language":"el"},{"@value":"Кулон на Мол","@language":"bg"},{"@value":"Кулон на Моль","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/C-PER-MilliM2","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"derived SI unit coulomb divided by the 0.000 001-fold of the power of the SI base unit metre by exponent\n    2\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1000000.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E6","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-800"},{"@id":"_:n3-801"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerArea"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB100","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB100","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"derived SI unit coulomb divided by the 0.000 001-fold of the power of the SI base unit metre by\n    exponent 2\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"C/mm²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"C.mm-2","@type":"http://qudt.org/schema/qud