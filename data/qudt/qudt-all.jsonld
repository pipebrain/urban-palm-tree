ultiplier":[{"@value":"6894757.293168361336722673445346887","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"6.894757293168361336722673445346887E6","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$kip/in^{2}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1952"},{"@id":"_:n3-1953"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"},{"@id":"http://qudt.org/vocab/quantitykind/ModulusOfElasticity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB242","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB242","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"kip/in²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"k[lbf_av].[in_i]-2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/udunitsCode":[{"@value":"ksi","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"N20","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"},{"@id":"http://qudt.org/vocab/quantitykind/ModulusOfElasticity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q107410776"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Kip per Square Inch","@language":"en"},{"@value":"Kip per Square Inch","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/KN","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The knot (pronounced 'not') is a unit of speed equal to one nautical mile (1.852 km) per hour,\n    approximately 1.151 mph. The abbreviation $kn$ is preferred by the International Hydrographic Organization (IHO), which\n    includes every major sea-faring nation; however, the abbreviations kt (singular) and kts (plural) are also widely used.\n    However, use of the abbreviation kt for knot conflicts with the SI symbol for kilotonne. The knot is a non-SI unit accepted\n    for use with the International System of Units (SI). Worldwide, the knot is used in meteorology, and in maritime and air\n    navigation - for example, a vessel travelling at 1 knot along a meridian travels one minute of geographic latitude in one\n    hour. Etymologically, the term knot derives from counting the number of knots in the line that unspooled from the reel of a\n    chip log in a specific time.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.5144444444444444444444444444444445","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"5.144444444444444444444444444444445E-1","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Knot","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/unit/MI_N-PER-HR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1954"},{"@id":"_:n3-1955"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/Velocity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB110","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB110","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Knot?oldid=495066194","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"kn","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[kn_i]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/udunitsCode":[{"@value":"kt","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"KNT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/Velocity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q128822"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Knot","@language":"en"},{"@value":"Knot","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"kt","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"kts","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/KN-PER-SEC","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Knot per Second}$ is a unit for 'Linear Acceleration' expressed as $kt/s$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.5144444444444444444444444444444445","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"5.144444444444444444444444444444445E-1","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$kt/s$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1956"},{"@id":"_:n3-1957"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Acceleration"},{"@id":"http://qudt.org/vocab/quantitykind/LinearAcceleration"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"kn/s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[kn_i].s-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Acceleration"},{"@id":"http://qudt.org/vocab/quantitykind/LinearAcceleration"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Knot per Second","@language":"en"},{"@value":"Knot per Second","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/KY","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},