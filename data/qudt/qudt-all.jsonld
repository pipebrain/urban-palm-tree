:"http://qudt.org/vocab/unit/PCA"},{"@id":"http://qudt.org/vocab/unit/PT"},{"@id":"http://qudt.org/vocab/unit/PicoM"},{"@id":"http://qudt.org/vocab/unit/PlanckLength"},{"@id":"http://qudt.org/vocab/unit/ROD"},{"@id":"http://qudt.org/vocab/unit/YD"},{"@id":"http://qudt.org/vocab/unit/ZOLL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Cartesian_coordinate_system","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Cartesian Coordinates\" specify each point uniquely in a plane by a pair of numerical coordinates,\n    which are the signed distances from the point to two fixed perpendicular directed lines, measured in the same unit of length.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"x, y, z","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Cartesian Coordinates","@language":"en"},{"@value":"Kartézská soustava souřadnic","@language":"cs"},{"@value":"Koordiant Kartesius","@language":"ms"},{"@value":"coordenadas cartesianas","@language":"pt"},{"@value":"coordinate cartesiane","@language":"it"},{"@value":"coordonnées cartésiennes","@language":"fr"},{"@value":"kartesische Koordinaten","@language":"de"},{"@value":"kartezyen koordinatları","@language":"tr"},{"@value":"مختصات دکارتی","@language":"fa"},{"@value":"直角坐标系","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Kartézské souřadnice","@language":"cs"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}]},{"@id":"http://qudt.org/vocab/quantitykind/CartesianVolume","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Volume\" is the quantity of three-dimensional space enclosed by some closed boundary, for example, the\n    space that a substance (solid, liquid, gas, or plasma) or shape occupies or contains.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AC-FT"},{"@id":"http://qudt.org/vocab/unit/AC-FT_US"},{"@id":"http://qudt.org/vocab/unit/ANGSTROM3"},{"@id":"http://qudt.org/vocab/unit/BBL"},{"@id":"http://qudt.org/vocab/unit/BBL_UK_PET"},{"@id":"http://qudt.org/vocab/unit/BU_US_DRY"},{"@id":"http://qudt.org/vocab/unit/CentiM3"},{"@id":"http://qudt.org/vocab/unit/DecaL"},{"@id":"http://qudt.org/vocab/unit/DecaM3"},{"@id":"http://qudt.org/vocab/unit/DeciL"},{"@id":"http://qudt.org/vocab/unit/DeciM3"},{"@id":"http://qudt.org/vocab/unit/FBM"},{"@id":"http://qudt.org/vocab/unit/FT3"},{"@id":"http://qudt.org/vocab/unit/FemtoL"},{"@id":"http://qudt.org/vocab/unit/GI_UK"},{"@id":"http://qudt.org/vocab/unit/GI_US"},{"@id":"http://qudt.org/vocab/unit/HectoL"},{"@id":"http://qudt.org/vocab/unit/IN3"},{"@id":"http://qudt.org/vocab/unit/KiloCubicFT"},{"@id":"http://qudt.org/vocab/unit/KiloL"},{"@id":"http://qudt.org/vocab/unit/L"},{"@id":"http://qudt.org/vocab/unit/M3"},{"@id":"http://qudt.org/vocab/unit/MI3"},{"@id":"http://qudt.org/vocab/unit/MI_UK3"},{"@id":"http://qudt.org/vocab/unit/MegaL"},{"@id":"http://qudt.org/vocab/unit/MicroL"},{"@id":"http://qudt.org/vocab/unit/MicroM3"},{"@id":"http://qudt.org/vocab/unit/MilliL"},{"@id":"http://qudt.org/vocab/unit/MilliM3"},{"@id":"http://qudt.org/vocab/unit/NanoL"},{"@id":"http://qudt.org/vocab/unit/OZ_VOL_UK"},{"@id":"http://qudt.org/vocab/unit/PINT"},{"@id":"http://qudt.org/vocab/unit/PINT_UK"},{"@id":"http://qudt.org/vocab/unit/PK_UK"},{"@id":"http://qudt.org/vocab/unit/PicoL"},{"@id":"http://qudt.org/vocab/unit/PlanckVolume"},{"@id":"http://qudt.org/vocab/unit/QT_UK"},{"@id":"http://qudt.org/vocab/unit/QT_US"},{"@id":"http://qudt.org/vocab/unit/STANDARD"},{"@id":"http://qudt.org/vocab/unit/STR"},{"@id":"http://qudt.org/vocab/unit/TBSP"},{"@id":"http://qudt.org/vocab/unit/TON_SHIPPING_UK"},{"@id":"http://qudt.org/vocab/unit/TON_SHIPPING_US"},{"@id":"http://qudt.org/vocab/unit/TSP"},{"@id":"http://qudt.org/vocab/unit/YD3"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Volume","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$V = \\int\\int\\int dxdydz$, where $x$, $y$, and $z$ are cartesian coordinates.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Volume\" is the quantity of three-dimensional space enclosed by some closed boundary, for example,\n    the space that a substance (solid, liquid, gas, or plasma) or shape occupies or contains.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Volume"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"V","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Volume","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Isipadu","@language":"ms"},{"@value":"Objem","@language":"cs"},{"@value":"Volume","@language":"en"},{"@value":"Volumen","@language":"de"},{"@value":"hacim","@language":"tr"},{"@value":"objętość","@language":"pl"},{"@value":"prostornina","@language":"sl"},{"@value":"volum","@language":"ro"},{"@value":"volume","@language":"fr"},{"@value":"volume","@language":"it"},{"@value":"volume","@language":"pt"},{"@value":"volumen","@language":"es"},{"@value":"Επιτάχυνση","@language":"el"},{"@value":"Обем","@language":"bg"},{"@value":"Объём","@language":"ru"},{"@value":"נפח","@language":"he"},{"@value":"حجم","@language":"ar"},{"@value":"حجم","@language":"fa"},{"@value":"आयतन","@language":"hi"},{"@value":"体积","@language":"zh"},{"@value":"体積","@language":"ja"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Volume"}]},{"@id":"http://qudt.org/vocab/quantitykind/CatalyticActivity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"An index of the actual or potential activity of a catalyst. The catalytic activity of an enzyme or an\n    enzyme-containing preparation is defined as the property measured by the increase in the rate of conversion of a specified\n    chemical reaction that the enzyme produces in a specified assay system. Catalytic activity is an extensive quantity and is a\n    property of the enzyme, not of the reaction mixture; it is thus conceptually different from rate of conversion although\n    measured by and equidimensional with it. The unit for catalytic activity is the $katal$; it may also be expressed in mol\n    $s^{-1}$. Dimensions: $N T^{-1}$. Former terms such as catalytic ability, catalytic amount, and enzymic activity are no er\n    recommended. Derived quantities are molar catalytic activity, specific catalytic activity, and catalytic activity\n    concentration. Source(s): <a href=\"http://www.answers.com/topic/catalytic-activity-biochemistry\">www.answers.com</a>\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ENZ"},{"@id":"http://qudt.org/vocab/unit/KAT"},{"@id":"http://qudt.org/vocab/unit/KiloMOL-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MOL_LB-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MOL_LB-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MicroKAT"},{"@id":"http://qudt.org/vocab/unit/MilliKAT"},{"@id":"http://qudt.org/vocab/unit/NanoKAT"},{"@id":"http://qudt.org/vocab/unit/PicoKAT"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Catalysis","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ445#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD022","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"0112/2///62720#UAD367","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD022","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD367","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/CATA"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1735592"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CatalyticActivity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Catalytic Activity","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/CatalyticActivityConcentration","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The catalytic activity of an enzyme per unit volume, where volume refers to that of the original\n    enzyme‐containing preparation, not that of the assay system. It may be expressed in katals per litre.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ENZ-PER-L"},{"@id":"http://qudt.org/vocab/unit/KAT-PER-L"},{"@id":"http://qudt.org/vocab/unit/KAT-PER-M3"},{"@id":"http://qudt.org/vocab/unit/KAT-PER-MicroL"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-M2-SEC-M"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-M3-SEC"},{"@id":"http://qudt.org/vocab/unit/MicroKAT-PER-L"},{"@id":"http://qudt.org/vocab/unit/MicroMOL-PER-L-HR"},{"@id":"http://qudt.org/vocab/unit/MilliKAT-PER-L"},{"@id":"http://qudt.org/vocab/unit/MilliMOL-PER-M3-DAY"},{"@id":"http://qudt.org/vocab/unit/NanoKAT-PER-L"},{"@id":"http://qudt.org/vocab/unit/NanoMOL-PER-CentiM3-HR"},{"@id":"http://qudt.org/vocab/unit/NanoMOL-PER-L-DAY"},{"@id":"http://qudt.org/vocab/unit/NanoMOL-PER-L-HR"},{"@id":"http://qudt.org/vocab/unit/PicoKAT-PER-L"},{"@id":"http://qudt.org/vocab/unit/PicoMOL-PER-L-DAY"},{"@id":"http://qudt.org/vocab/unit/PicoMOL-PER-L-HR"},{"@id":"http://qudt.org/vocab/unit/PicoMOL-PER-M3-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L-3I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD387","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD387","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://doi.org/10.1351/goldbook.C00882","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The catalytic activity of an enzyme per unit volume, where volume refers to that of the original\n    enzyme‐containing preparation, not that of the assay system. It may be expressed in katals per litre.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/CTAC"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CatalyticActivityConcentration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Catalytic Activity Concentration","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/CationExchangeCapacity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The amount of positive ionic charge (in moles or charge or equivalents) that a solid material can\n    exchange per unit mass. Widely used for soils and other materials with cation-exchange sites.\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MilliEQ-PER-HectoGM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ReactiveChargePerMass"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"CEC","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ReactiveChargePerMass","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Cation Exchange Capacity","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ReactiveChargePerMass"}]},{"@id":"http://qudt.org/vocab/quantitykind/CelsiusTemperature","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Celsius Temperature\", the thermodynamic temperature T_0, is exactly 0.01 kelvin below the thermodynamic\n    temperature of the triple point of water.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_C"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ273#002","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD023","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD023","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"\"Celsius Temperature\", the thermodynamic temperature $T_0$, is exactly $0.01$kelvin below the thermodynamic temperature of the triple point of water.\n$t = T - T_0$, where $T$ is Thermodynamic Temperature and $T_0 = 273.15 K$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Celsius Temperature\", the thermodynamic temperature T_0, is exactly 0.01 kelvin below the\n    thermodynamic temperature of the triple point of water.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/TEMC"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q74758530"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CelsiusTemperature","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Celsius Temperature","@language":"en"},{"@value":"Celsius sıcaklık","@language":"tr"},{"@value":"Celsius-Temperatur","@language":"de"},{"@value":"Suhu Celsius","@language":"ms"},{"@value":"temperatura Celsius","@language":"es"},{"@value":"temperatura Celsius","@language":"it"},{"@value":"temperatura celsius","@language":"pt"},{"@value":"temperatura","@language":"pl"},{"@value":"temperatura","@language":"sl"},{"@value":"temperatură Celsius","@language":"ro"},{"@value":"température Celsius","@language":"fr"},{"@value":"teplota","@language":"cs"},{"@value":"Температура Цельсия","@language":"ru"},{"@value":"צלזיוס","@language":"he"},{"@value":"درجة الحرارة المئوية أو السيلسيوس","@language":"ar"},{"@value":"دمای سلسیوس/سانتیگراد","@language":"fa"},{"@value":"सेल्सियस तापमान","@language":"hi"},{"@value":"温度","@language":"ja"},{"@value":"温度","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"h