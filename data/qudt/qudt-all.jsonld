@id":"http://qudt.org/vocab/quantitykind/TemperaturePerSquareTime"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"K/s²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"K.s-2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/TemperaturePerSquareTime"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Kelvin na Kvadratni Sekunda","@language":"sl"},{"@value":"Kelvin na Čtvereční Sekunda","@language":"cs"},{"@value":"Kelvin par Seconde Carré","@language":"fr"},{"@value":"Kelvin pe Secundă Pătrat","@language":"ro"},{"@value":"Kelvin per Saat Persegi","@language":"ms"},{"@value":"Kelvin per Saniyekare","@language":"tr"},{"@value":"Kelvin per Secondo Quadrato","@language":"it"},{"@value":"Kelvin per Secundum Quadratum","@language":"la"},{"@value":"Kelvin per Square Second","@language":"en"},{"@value":"Kelvin per Square Second","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Kelvin por Segundo Cuadrado","@language":"es"},{"@value":"Kelvin por Segundo Quadrado","@language":"pt"},{"@value":"Kelvin pro Quadratsekunde","@language":"de"},{"@value":"Kelwin na Sekunda Kwadratowy","@language":"pl"},{"@value":"Κέλβιν ανά Τετραγωνικό Δευτερόλεπτο","@language":"el"},{"@value":"Келвин на Квадратен Секунда","@language":"bg"},{"@value":"Кельвин на Квадратный Секунда","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/K-PER-T","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Kelvin per Tesla}$ is a unit for 'Temperature Per Magnetic Flux Density' expressed as $K\n    T^{-1}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$K T^{-1}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M-1H1T2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1936"},{"@id":"_:n3-1937"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/TemperaturePerMagneticFluxDensity"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"K/T","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"K.T-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/TemperaturePerMagneticFluxDensity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Kelvin na Tesla","@language":"cs"},{"@value":"Kelvin na Tesla","@language":"sl"},{"@value":"Kelvin par Tesla","@language":"fr"},{"@value":"Kelvin pe Tesla","@language":"ro"},{"@value":"Kelvin per Tesla","@language":"en"},{"@value":"Kelvin per Tesla","@language":"it"},{"@value":"Kelvin per Tesla","@language":"la"},{"@value":"Kelvin per Tesla","@language":"ms"},{"@value":"Kelvin per Tesla","@language":"tr"},{"@value":"Kelvin per Tesla","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Kelvin por Tesla","@language":"es"},{"@value":"Kelvin por Tesla","@language":"pt"},{"@value":"Kelvin pro Tesla","@language":"de"},{"@value":"Kelwin na Tesla","@language":"pl"},{"@value":"Κέλβιν ανά Τέσλα","@language":"el"},{"@value":"Келвин на Тесла","@language":"bg"},{"@value":"Кельвин на Тесла","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/K-PER-W","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"<p>Thermal resistance is a heat property and a measure of a temperature difference by which an object or\n    material resists a heat flow (heat per time unit or thermal resistance). Thermal resistance is the reciprocal thermal\n    conductance. Absolute thermal resistance is the temperature difference across a structure when a unit of heat energy flows\n    through it in unit time. It is the reciprocal of thermal conductance. The SI units of thermal resistance are kelvins per watt\n    or the equivalent degrees Celsius per watt (the two are the same since as intervals).</p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$K/W$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M-1H1T3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1938"},{"@id":"_:n3-1939"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalResistance"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/W-PER-K"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720