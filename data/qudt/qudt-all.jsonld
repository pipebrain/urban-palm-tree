/qudt.org/schema/qudt/symbol":[{"@value":"W/(m²·Pa)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"W.m-2.Pa-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/EvaporativeHeatTransferCoefficient"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Vatio por Metro Cuadrado Pascal","@language":"es"},{"@value":"Wat na Metr Kwadratowy Paskal","@language":"pl"},{"@value":"Watt na Kvadratni Meter Pascal","@language":"sl"},{"@value":"Watt na Čtvereční Metr Pascal","@language":"cs"},{"@value":"Watt par Mètre Carré Pascal","@language":"fr"},{"@value":"Watt pe Metru Pătrat Pascal","@language":"ro"},{"@value":"Watt per Meter Persegi Pascal","@language":"ms"},{"@value":"Watt per Metrekare Pascal","@language":"tr"},{"@value":"Watt per Metro Quadrato Pascal","@language":"it"},{"@value":"Watt per Square Meter Pascal","@language":"en-us"},{"@value":"Watt per Square Metre Pascal","@language":"en"},{"@value":"Watt per Square Metre Pascal","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Watt por Metro Quadrado Pascal","@language":"pt"},{"@value":"Watt pro Quadratmeter Pascal","@language":"de"},{"@value":"Wattium per Metrum Quadratum Pascalium","@language":"la"},{"@value":"Βατ ανά Τετραγωνικό Μέτρο Πασκάλ","@language":"el"},{"@value":"Ват на Квадратен Метър Паскал","@language":"bg"},{"@value":"Ватт на Квадратный Метр Паскаль","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/W-PER-M2-SR","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Watt per steradian per square metre}$ is the SI unit of radiance ($W·sr^{-1}·m^{-2}$),\n  while that of spectral radiance in frequency is the watt per steradian per square metre\n  per hertz ($W·sr^{-1}·m^{-2}·Hz^{-1}$) and that of spectral radiance in wavelength is\n  the watt per steradian per square metre, per metre ($W·sr^{-1}·m^{-3}$),\n  commonly the watt per steradian per square metre per nanometre ($W·sr^{-1}·m^{-2}·nm^{-1}$).\n  It has a dimension of $ML^{-4}T^{-3}$ where $M$ is mass, $L$ is length, and $T$ is time.\n  This unit is the standard SI unit in this category.\"\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$W/(m^2.sr)$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-5257"},{"@id":"_:n3-5258"},{"@id":"_:n3-5259"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/PowerPerAreaAngle"},{"@id":"http://qudt.org/vocab/quantitykind/Radiance"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA315","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.efunda.com/glossary/units/units--radiance--watt_per_square_meter_per_steradian.cfm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA315","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Radiance","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"W/(m²·sr)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"W.m-2.sr-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"D58","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/PowerPerAreaAngle"},{"@id":"http://qudt.org/vocab/quantitykind/Radiance"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q69429226"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Vatio por Metro Cuadrado Estereorradián","@language":"es"},{"@value":"Wat na Metr Kwadratowy Steradian","@language":"pl"},{"@value":"Watt na Kvadratni Meter Steradian","@language":"sl"},{"@value":"Watt na Čtvereční Metr Steradián","@language":"cs"},{"@value":"Watt par Mètre Carré Stéradian","@language":"fr"},{"@value":"Watt pe Metru Pătrat Steradian","@language":"ro"},{"@value":"Watt per Meter Persegi Steradian","@language":"ms"},{"@value":"Watt per Metrekare Steradyan","@language":"tr"},{"@value":"Watt per Metro Quadrato Steradiante","@language":"it"},{"@value":"Watt per Square Meter Steradian","@language":"en-us"},{"@value":"Watt per Square Metre Steradian","@language":"en"},{"@value":"Watt per Square Metre Steradian","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Watt por Metro Quadrado Esterradiano","@language":"pt"},{"@value":"Watt pro Quadratmeter Steradiant","@language":"de"},{"@value":"Wattium per Metrum Quadratum Steradian","@language":"la"},{"@value":"Βατ ανά Τετραγωνικό Μέτρο Στερακτίνιο","@language":"el"},{