","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"ALPHANUMERIC","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/datatype/BOOLEAN","@type":["http://qudt.org/schema/qudt/BooleanType"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>In computer science, the Boolean or logical data type is a data type,\n   having two values (usually denoted true and false), intended to represent the truth values of logic and Boolean algebra. \n  The Boolean data type is the primary result of conditional statements,\n   which allow different actions and change control flow depending on whether a programmer-specified boolean condition evaluates to true or false.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/ansiSQLName":[{"@value":"BOOLEAN","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/encoding":[{"@id":"http://qudt.org/vocab/datatype/BooleanEncoding"}],"http://qudt.org/schema/qudt/id":[{"@value":"T000-01","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/javaName":[{"@value":"boolean","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/jsName":[{"@value":"Boolean()","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/microsoftSQLServerName":[{"@value":"bit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/mySQLName":[{"@value":"BOOL","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"BOOLEAN","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"TINYINT(1)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/odbcName":[{"@value":"SQL_BIT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/oleDBName":[{"@value":"DBTYPE_BOOL","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/oracleSQLName":[{"@value":"RAW(1)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/protocolBuffersName":[{"@value":"bool","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/pythonName":[{"@value":"bool","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"boolean","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"BOOLEAN","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"http://en.wikipedia.org/wiki/Boolean%5Fdata%5Ftype"},{"@id":"http://msdn.microsoft.com/en-us/library/aa275635(v=sql.80).aspx"},{"@value":"http://msdn.microsoft.com/en-us/library/aa275635(v=sql.80).aspx","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Boolean%5Fdata%5Ftype","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}]},{"@id":"http://qudt.org/vocab/datatype/BYTE","@type":["http://qudt.org/schema/qudt/SignedShortIntegerType"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>The byte data type is an 8-bit signed two's complement integer. \n  It has a minimum value of -128 and a maximum value of 127 (inclusive). \n  The byte data type can be useful for saving memory in large arrays, where the memory savings actually matters. \n  They can also be used in place of int where their limits help to clarify your code; the fact that a variable's range is limited can serve as a form of documentation.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"SI8","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/bytes":[{"@value":"1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/cName":[{"@value":"Byte","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/encoding":[{"@id":"http://qudt.org/vocab/datatype/OctetEncoding"}],"http://qudt.org/schema/qudt/id":[{"@value":"T002-01","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/maxInclusive":[{"@value":"127","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/minInclusive":[{"@value":"-128","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/rdfsDatatype":[{"@id":"http://www.w3.org/2001/XMLSchema#byte"}],"http://qudt.org/schema/qudt/signedness":[{"@id":"http://qudt.org/vocab/datatype/Signed"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"800","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"byte","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Byte","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"http://docs.oracle.com/javase/tutorial/java/nutsandbolts/datatypes.html"},{"@value":"http://docs.oracle.com/javase/tutorial/java/nutsandbolts/datatypes.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}]},{"@id":"http://qudt.org/vocab/datatype/BigEndian","@type":["http://qudt.org/schema/qudt/EndianType"],"http://purl.org/dc/terms/description":[{"@value":"A big-endian machine stores the most significant byte first.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.li