/qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"number of data, usually dependent on the respective information complexity or its coding procedure,\n    divided by the related length\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BIT-PER-M"},{"@id":"http://qudt.org/vocab/unit/ExbiBIT-PER-M"},{"@id":"http://qudt.org/vocab/unit/GibiBIT-PER-M"},{"@id":"http://qudt.org/vocab/unit/GigaBIT-PER-M"},{"@id":"http://qudt.org/vocab/unit/KibiBIT-PER-M"},{"@id":"http://qudt.org/vocab/unit/MebiBIT-PER-M"},{"@id":"http://qudt.org/vocab/unit/PebiBIT-PER-M"},{"@id":"http://qudt.org/vocab/unit/TebiBIT-PER-M"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ331#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/LinearBitDensity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Anzahl von Daten, die in der Regel abhängig von der jeweiligen Komplexität der Information oder\n    deren Codierungsverfahren ist, dividiert durch die zugehörige Länge\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LineicDataVolume","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Lineic Data Volume","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/LineicLogarithmicRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"logarithm of the relationship between the value of a given quantity and the quantity of a reference value\n    of the same type divided by the related