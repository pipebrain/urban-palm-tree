http://www.wikidata.org/entity/Q106653452"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Chiliogramma per Metrum Secundum","@language":"la"},{"@value":"Chilogrammo per Metro Secondo","@language":"it"},{"@value":"Kilogram na Meter Sekunda","@language":"sl"},{"@value":"Kilogram na Metr Sekunda","@language":"cs"},{"@value":"Kilogram na Metr Sekunda","@language":"pl"},{"@value":"Kilogram pe Metru Secundă","@language":"ro"},{"@value":"Kilogram per Meter Saat","@language":"ms"},{"@value":"Kilogram per Meter Second","@language":"en-us"},{"@value":"Kilogram per Metre Saniye","@language":"tr"},{"@value":"Kilogram per Metre Second","@language":"en"},{"@value":"Kilogram per Metre Second","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Kilogramm pro Meter Sekunde","@language":"de"},{"@value":"Kilogramme par Mètre Seconde","@language":"fr"},{"@value":"Kilogramo por Metro Segundo","@language":"es"},{"@value":"Quilograma por Metro Segundo","@language":"pt"},{"@value":"Χιλιόγραμμο ανά Μέτρο Δευτερόλεπτο","@language":"el"},{"@value":"Килограм на Метър Секунда","@language":"bg"},{"@value":"Килограмм на Метр Секунда","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M-SEC2","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The SI unit of pressure. The pascal is the standard pressure unit in the MKS metric system, equal to one\n    newton per square meter or one \"kilogram per meter per second per second.\" The unit is named for Blaise Pascal (1623-1662),\n    French philosopher and mathematician, who was the first person to use a barometer to measure differences in altitude.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Pascal","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/unit/N-PER-M2"},{"@id":"http://qudt.org/vocab/unit/PA"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2131"},{"@id":"_:n3-2132"},{"@id":"_:n3-2133"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"},{"@id":"http://qudt.org/vocab/quantitykind/VapourPressure"}],"http://qudt.org/schema/qudt/siUnitsExpression":[{"@value":"kg/m/s^2","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"kg/(m·s²)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"kg.m-1.s-2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"},{"@id":"http://qudt.org/vocab/quantitykind/VapourPressure"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Chiliogramma per Metrum Secundum Quadratum","@language":"la"},{"@value":"Chilogrammo per Metro Secondo Quadrato","@language":"it"},{"@value":"Kilogram na Meter Kvadratni Sekunda","@language":"sl"},{"@value":"Kilogram na Metr Sekunda Kwadratowy","@language":"pl"},{"@value":"Kilogram na Metr Čtvereční Sekunda","@language":"cs"},{"@value":"Kilogram pe Metru Secundă Pătrat","@language":"ro"},{"@value":"Kilogram per Meter Saat Persegi","@language":"ms"},{"@value":"Kilogram per Meter Square Second","@language":"en-us"},{"@value":"Kilogram per Metre Saniyekare","@language":"tr"},{"@value":"Kilogram per Metre Square Second","@language":"en"},{"@value":"Kilogram per Metre Square Second","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Kilogramm pro Meter Quadratsekunde","@language":"de"},{"@value":"Kilogramme par Mètre Seconde Carré","@language":"fr"},{"@value":"Kilogramo por Metro Segundo Cuadrado","@language":"es"},{"@value":"Quilograma por Metro Segundo Quadrado","@language":"pt"},{"@value":"Χιλιόγραμμο ανά Μέτρο Τετραγωνικό Δευτερόλεπτο","@language":"el"},{"@value":"Килограм на Метър Квадратен Секунда","@language":"bg"},{"@value":"Килограмм на Метр Квадратный Секунда","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M2","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Kilogram Per Square Meter (kg/m2) is a unit in the category of Surface density. It is also known as\n    kilograms per square meter, kilogram per square metre, kilograms per square metre, kilogram/square meter, kilogram/square\n    metre. This unit is commonly used in the SI unit system. Kilogram Per Square Meter (kg/m2) has a dimension of ML-2 where $M$\n    is mass, and $L$ is length. This unit is the standard SI unit in this category.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"htt