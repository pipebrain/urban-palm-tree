g"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1000000000000000.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E15","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Activity"},{"@id":"http://qudt.org/vocab/quantitykind/RadioactiveDecay"},{"@id":"http://qudt.org/vocab/quantitykind/Radioactivity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB590","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB590","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/prefix":[{"@id":"http://qudt.org/vocab/prefix/Peta"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/BQ"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"PBq","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"PBq","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Activity"},{"@id":"http://qudt.org/vocab/quantitykind/RadioactiveDecay"},{"@id":"http://qudt.org/vocab/quantitykind/Radioactivity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Petabecquerel","@language":"cs"},{"@value":"Petabecquerel","@language":"de"},{"@value":"Petabecquerel","@language":"en"},{"@value":"Petabecquerel","@language":"es"},{"@value":"Petabecquerel","@language":"fr"},{"@value":"Petabecquerel","@language":"hu"},{"@value":"Petabecquerel","@language":"it"},{"@value":"Petabecquerel","@language":"ms"},{"@value":"Petabecquerel","@language":"ro"},{"@value":"Petabecquerel","@language":"sl"},{"@value":"Petabecquerel","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Petabekerel","@language":"pl"},{"@value":"Petabekerel","@language":"tr"}]},{"@id":"http://qudt.org/vocab/unit/PetaBYTE","@type":["http://qudt.org/schema/qudt/CountingUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A petabyte is a unit of information equal to one quadrillion bytes, or 1024 terabytes. The unit symbol\n    for the petabyte is PB. The prefix peta (P) indicates the fifth power to 1000: 1 PB = 1000000000000000B, 1 million gigabytes =\n    1 thousand terabytes The pebibyte (PiB), using a binary prefix, is the corresponding power of 1024, which is more than $12\\%\n    $greater ($2^{50} bytes = 1,125,899,906,842,624 bytes$).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/ASU"},{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-ESU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/PLANCK"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"8000000000000000.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"8.0E15","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Petabyte","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfData"},{"@id":"http://qudt.org/vocab/quantitykin