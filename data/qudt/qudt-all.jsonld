01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"atomic unit of length","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Atomic_units"}]},{"@id":"http://qudt.org/vocab/constant/AtomicUnitOfMagneticDipoleMoment","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticDipoleMoment"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_AtomicUnitOfMagneticDipoleMoment"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"atomic unit of magnetic dipole moment","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Atomic_units"}]},{"@id":"http://qudt.org/vocab/constant/AtomicUnitOfMagneticFluxDensity","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensity"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_AtomicUnitOfMagneticFluxDensity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"atomic unit of magnetic flux density","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Atomic_units"}]},{"@id":"http://qudt.org/vocab/constant/AtomicUnitOfMagnetizability","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerSquareMagneticFluxDensity"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_AtomicUnitOfMagnetizability"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"atomic unit of magnetizability","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Atomic_units"}]},{"@id":"http://qudt.org/vocab/constant/AtomicUnitOfMass","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_AtomicUnitOfMass"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"atomic unit of mass","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Atomic_units"}]},{"@id":"http://qudt.org/vocab/constant/AtomicUnitOfMomentum","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LinearMomentum"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_AtomicUnitOfMomentum"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"atomic unit of momentum","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Atomic_units"}]},{"@id":"http://qudt.org/vocab/constant/AtomicUnitOfPermittivity","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/exactConstant":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Permittivity"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_AtomicUnitOfPermittivity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"atomic unit of permittivity","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Atomic_units"}]},{"@id":"http://qudt.org/vocab/constant/AtomicUnitOfTime","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Time"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_AtomicUnitOfTime"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"atomic unit of time","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Atomic_units"}]},{"@id":"http://qudt.org/vocab/constant/AtomicUnitOfVelocity","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_AtomicUnitOfVelocity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"atomic unit of velocity","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Atomic_units"}]},{"@id":"http://qudt.org/vocab/constant/AvogadroConstant","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\textit{Avogadro Constant}$ is defined as the ratio of the number of constituent particles N in\n   a sample to the amount of substance $n$ through the relationship $NA = N/n$. \n  Thus, it is the proportionality factor that relates the molar mass of an entity, that is,\n   the mass per amount of substance, to the mass of said entity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"mole^{-1}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PER-MOL"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Avogadro_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InverseAmountOfSubstance"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD015","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD015","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Avogadro_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$L = \\frac{N}{n}$, where $N$ is the number of particles and $n$ is amount of substance.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$L, N_A$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_AvogadroConstant"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/constants/AvogadroConstant"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Avogadro constant","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/BohrMagneton","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\textit{Bohr Magneton}$ is a physical constant and the natural unit for expressing an\n   electron magnetic dipole moment.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-T"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Bohr_magneton","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticDipoleMoment"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Bohr_magneton","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mu_B = \\frac{e\\hbar}{2m_e}$, where $e$ is the elementary charge, $\\hbar$ is the Planck constant, and $m_e$ is the rest mass of electron.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mu_B$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_BohrMagneton"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bohr Magneton","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/BohrMagnetonInEVPerT","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticDipoleMoment"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_BohrMagnetonInEVPerT"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bohr magneton in eV per T","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Bohr_magneton"}]},{"@id":"http://qudt.org/vocab/constant/BohrMagnetonInHzPerT","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerMass"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_BohrMagnetonInHzPerT"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bohr magneton in Hz perT","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Bohr_magneton"}]},{"@id":"http://qudt.org/vocab/constant/BohrMagnetonInInverseMetersPerTesla","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticReluctivity"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_BohrMagnetonInInverseMetersPerTesla"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bohr magneton in inverse meters per tesla","@language":"en-us"},{"@value":"Bohr magneton in inverse metres per tesla","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Bohr_magneton"}]},{"@id":"http://qudt.org/vocab/constant/BohrMagnetonInKPerT","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/TemperaturePerMagneticFluxDensity"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_BohrMagnetonInKPerT"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bohr magneton in K per T","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Bohr_magneton"}]},{"@id":"http://qudt.org/vocab/constant/BohrRadius","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\textit{Bohr Radius}$ is a physical constant, approximately equal to the most probable distance\n   between the proton and electron in a hydrogen atom in its ground state. \n  It is named after Niels Bohr, due to its role in the Bohr model of an atom.\n  The precise definition of the Bohr radius is: \n  \n  $$a_0 = \\frac{4\\pi \\epsilon_0 \\hbar^2}{me^2}$$\n\n  Where,\n   $a_0$ is the Bohr radius,\n   $\\epsilon_0$ is the permittivity of a vacuum,\n   $m_e$ is the mass of an electron,\n   $\\hbar$ is the reduced Planck's constant,\n   $e$ is the elementary charge.\n\n  When rearranged to highlight the role of the Coulomb constant and the elementary charge,\n   the formula can be shown as:\n\n  $$a_0 \\equiv \\frac{{\\hbar ^2 }}{{m_e ke^2 }}$$\n  \n  Where,\n   $a_0$ is the Bohr radius,\n   $m_e$ is the mass of an electron,\n   $\\hbar$ is the reduced Planck's constant,\n   $k$ is the Coulomb Constant,\n   $e$ is the elementary charge.\n\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/M"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Bohr_radius","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.deepnlp.org/blog/atomic-electro-chemical-equations","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://byjus.com/physics/bohr-radius/","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Bohr_radius","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$a_0 = \\frac{4\\pi \\varepsilon_0 \\hbar^2}{m_ee^2}$, where $\\varepsilon_0$ is the electric constant, $\\hbar$ is the reduced Planck constant, $m_e$  is the rest mass of electron, and $e$ is the elementary charge.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$a_0$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_BohrRadius"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bohr Radius","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/BoltzmannConstant","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\textit{Boltzmann Constant}$, symbol $k$ or $kB$, is the physical constant relating energy at the individual particle level with temperature,\n   which must necessarily be observed at the collective or bulk level. \n  It is the gas constant $R$ divided by the Avogadro constant $N_A$, having the same dimension as entropy. \n  It is named after the Austrian physicist Ludwig Boltzmann.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-K"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Boltzmann_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/HeatCapacity"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Boltzmann_constant?oldid=495542430","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$k$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_BoltzmannConstant"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/constants/BoltzmannConstant"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[k]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Boltzmann Constant","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/BoltzmannConstantInEVPerK","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/HeatCapacity"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_BoltzmannConstantInEVPerK"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Boltzmann constant in eV per K","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Boltzmann_constant"}]},{"@id":"http://qudt.org/vocab/constant/BoltzmannConstantInHzPerK","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InverseTimeTemperature"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_BoltzmannConstantInHzPerK"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Boltzmann constant in Hz per K","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Boltzmann_constant"}]},{"@id":"http://qudt.org/vocab/constant/BoltzmannConstantInInverseMetersPerKelvin","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InverseLengthTemperature"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_BoltzmannConstantInInverseMetersPerKelvin"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Boltzmann constant in inverse meters per kelvin","@language":"en-us"},{"@value":"Boltzmann constant in inverse metres per kelvin","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Boltzmann_constant"}]},{"@id":"http://qudt.org/vocab/constant/CharacteristicImpedanceOfVacuum","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The constant $\\textit{Characteristic Impedance of Vacuum}$, symbol $Z0$ is the impedance of free space.\n  This is a physical constant relating the magnitudes of the electric and magnetic fields of electromagnetic radiation travelling through free space. \n  That is, $Z0 = |E|/|H|$, where $|E|$ is the electric field strength and $|H|$ magnetic field strength. \n  It has an exact value, given approximately as 376.73031 ohms. \n  The impedance of free space equals the product of the vacuum permeability or magnetic constant $μ0$ and the speed of light in vacuum $c0$. \n  Since the numerical values of the magnetic constant and of the speed of light are fixed by the definitions of the ampere and the metre respectively,\n   the exact value of the impedance of free space is likewise fixed by definition and is not subject to experimental error.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Impedance_of_free_space","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/exactConstant":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Resistance"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_CharacteristicImpedanceOfVacuum"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"characteristic impedance of vacuum","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/ClassicalElectronRadius","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Classical_electron_radius","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_ClassicalElectronRadius"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"classical electron radius","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/ComptonWavelength","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The constant $\\textit{Compton Wavelength}$ is a quantum mechanical property of a particle. \n  It was introduced by Arthur Compton in his explanation of the scattering of photons by electrons.\n  The process is known as Compton scattering. \n  The Compton Wavelength of a particle is equivalent to the wavelength of a photon whose energy\n   is the same as the rest-mass energy of the particle.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/M"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Compton_wavelength","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Compton_wavelength","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\lambda_C = \\frac{h}{mc_0}$, where $h$ is the Planck constant, $m$ is the rest mass of a particle, and $c_0$ is the speed of light in vacuum.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\lambda_C$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_ComptonWavelength"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Compton Wavelength","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/ComptonWavelengthOver2Pi","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_ComptonWavelengthOver2Pi"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Compton wavelength over 2 pi","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Compton_wavelength"}]},{"@id":"http://qudt.org/vocab/constant/ConductanceQuantum","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Conductance_quantum","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricConductivity"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_ConductanceQuantum"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"conductance quantum","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/ConventionalValueOfJosephsonConstant","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/exactConstant":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InverseMagneticFlux"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_ConventionalValueOfJosephsonConstant"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"conventional value of Josephson constant","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Magnetic_flux_quantum"}]},{"@id":"http://qudt.org/vocab/constant/ConventionalValueOfVonKlitzingConstant","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/exactConstant":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Resistance"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_ConventionalValueOfVonKlitzingConstant"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"conventional value of von Klitzing constant","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Quantum_Hall_effect"}]},{"@id":"http://qudt.org/vocab/constant/CuXUnit","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_CuXUnit"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Cu x unit","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/X_unit"}]},{"@id":"http://qudt.org/vocab/constant/DeuteronElectronMagneticMomentRatio","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_DeuteronElectronMagneticMomentRatio"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"deuteron-electron magnetic moment ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Electron_magnetic_dipole_moment"}]},{"@id":"http://qudt.org/vocab/constant/DeuteronElectronMassRatio","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_DeuteronElectronMassRatio"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"deuteron-electron mass ratio","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/DeuteronGFactor","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_DeuteronGFactor"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"deuteron g factor","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/G-factor"}]},{"@id":"http://qudt.org/vocab/constant/DeuteronMagneticMoment","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticDipoleMoment"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_DeuteronMagneticMoment"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"deuteron magnetic moment","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Magnetic_moment"}]},{"@id":"http://qudt.org/vocab/constant/DeuteronMagneticMomentToBohrMagnetonRatio","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/voc