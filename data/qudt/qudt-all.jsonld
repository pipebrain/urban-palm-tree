al","@language":"pl"},{"@value":"Metre per Pascal","@language":"en"},{"@value":"Metre per Pascal","@language":"tr"},{"@value":"Metre per Pascal","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Metro per Pascal","@language":"it"},{"@value":"Metro por Pascal","@language":"es"},{"@value":"Metro por Pascal","@language":"pt"},{"@value":"Metru pe Pascal","@language":"ro"},{"@value":"Metrum per Pascalium","@language":"la"},{"@value":"Mètre par Pascal","@language":"fr"},{"@value":"Μέτρο ανά Πασκάλ","@language":"el"},{"@value":"Метр на Паскаль","@language":"ru"},{"@value":"Метър на Паскал","@language":"bg"}]},{"@id":"http://qudt.org/vocab/unit/M-PER-RAD","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"unit of the translation factor for implementation from rotation to linear move according","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2871"},{"@id":"_:n3-2872"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/RotaryTranslatoryMotionConversion"},{"@id":"http://qudt.org/vocab/quantitykind/TransmissionRatioBetweenRotationAndTranslation"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/RAD-PER-M"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB482","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB482","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m/rad","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m.rad-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"M55","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/RotaryTranslatoryMotionConversion"},{"@id":"http://qudt.org/vocab/quantitykind/TransmissionRatioBetweenRotationAndTranslation"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Meter na Radian","@language":"sl"},{"@value":"Meter per Radian","@language":"en-us"},{"@value":"Meter per Radian","@language":"ms"},{"@value":"Meter pro Radiant","@language":"de"},{"@value":"Metr na Radian","@language":"pl"},{"@value":"Metr na Radián","@language":"cs"},{"@value":"Metre per Radian","@language":"en"},{"@value":"Metre per Radian","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Metre per Radyan","@language":"tr"},{"@value":"Metro per Radiante","@language":"it"},{"@value":"Metro por Radiano","@language":"pt"},{"@value":"Metro por Radián","@language":"es"},{"@value":"Metru pe Radian","@language":"ro"},{"@value":"Metrum per Radian","@language":"la"},{"@value":"Mètre par Radian","@language":"fr"},{"@value":"Μέτρο ανά Ακτίνιο","@language":"el"},{"@value":"Метр на Радиан","@language":"ru"},{"@value":"Метър на Радиан","@language":"bg"}]},{"@id":"http://qudt.org/vocab/unit/M-PER-SEC","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Metre per second is an SI derived unit of both speed (scalar) and velocity (vector quantity which\n    specifies both magnitude and a specific direction), defined by distance in metres divided by time in seconds. The official SI\n    symbolic abbreviation is mu00b7s-1, or equivalently either m/s.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$m/s$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2873"},{"@id":"_:n3-2874"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectromagneticWavePhaseSpeed"},{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificThrust"},{"@id":"http://qudt.org/vocab/quantitykind/Speed"},{"@id":"http://qudt.org/vocab/quantitykind/Velocity"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/SEC-PER-M"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA733","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA733","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m/s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@valu