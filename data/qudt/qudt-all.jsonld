ma#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Lineic Resolution","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/LineicTorque","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"torque divided by the appropriate length","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloN-M-PER-M"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-M"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ433#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/TorquePerLength"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD082","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD082","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Drehmoment dividiert durch die zugehörige Länge","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LineicTorque","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Lineic Torque","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/LinkedFlux","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Linked Flux\" is defined as the path integral of the magnetic vector potential. This is the line integral\n    of a magnetic vector potential $A$ along a curve $C$. The line vector element $dr$ is the differential of position vector $r$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloLB_F-FT-PER-A"},{"@id":"http://qudt.org/vocab/unit/KiloWB"},{"@id":"http://qudt.org/vocab/unit/MX"},{"@id":"http://qudt.org/vocab/unit/MilliWB"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-A"},{"@id":"http://qudt.org/vocab/unit/UnitPole"},{"@id":"http://qudt.org/vocab/unit/V_Ab-SEC"},{"@id":"http://qudt.org/vocab/unit/WB"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Magnetic_flux","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$linked-flux$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-24","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.oxfordreference.com/display/10.1093/acref/9780199233991.001.0001/acref-9780199233991-e-1800","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\Psi_m = \\int_C A \\cdot dr$, where $A$ is magnetic vector potential and $dr$ is the vector element of the curve $C$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Psi$","@type":"http://qudt.org/schema/qudt/LatexString"},{"@value":"$\\Psi_m$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFlux"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q118540114"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticFlux","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Linked Flux","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFlux"}]},{"@id":"http://qudt.org/vocab/quantitykind/LiquidLevel","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Liquid level refers to the measurement of the height of a liquid within a container.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ANGSTROM"},{"@id":"http://qudt.org/vocab/unit/AU"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB_F"},{"@id":"http://qudt.org/vocab/unit/CHAIN"},{"@id":"http://qudt.org/vocab/unit/CHAIN_US"},{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/DecaM"},{"@id":"http://qudt.org/vocab/unit/DeciM"},{"@id":"http://qudt.org/vocab/unit/FATH"},{"@id":"http://qudt.org/vocab/unit/FM"},{"@id":"http://qudt.org/vocab/unit/FT"},{"@id":"http://qudt.org/vocab/unit/FT_US"},{"@id":"http://qudt.org/vocab/unit/FUR"},{"@id":"http://qudt.org/vocab/unit/FemtoM"},{"@id":"http://qudt.org/vocab/unit/GAUGE_FR"},{"@id":"http://qudt.org/vocab/unit/GA_Charriere"},{"@id":"http://qudt.org/vocab/unit/HectoM"},{"@id":"http://qudt.org/vocab/unit/IN"},{"@id":"http://qudt.org/vocab/unit/KiloM"},{"@id":"http://qudt.org/vocab/unit/LY"},{"@id":"http://qudt.org/vocab/unit/M"},{"@id":"http://qudt.org/vocab/unit/MI"},{"@id":"http://qudt.org/vocab/unit/MI_N"},{"@id":"http://qudt.org/vocab/unit/MI_UK"},{"@id":"http://qudt.org/vocab/unit/MI_US"},{"@id":"http://qudt.org/vocab/unit/MicroIN"},{"@id":"http://qudt.org/vocab/unit/MicroM"},{"@id":"http://qudt.org/vocab/unit/MilLength"},{"@id":"http://qudt.org/vocab/unit/MilliIN"},{"@id":"http://qudt.org/vocab/unit/MilliM"},{"@id":"http://qudt.org/vocab/unit/NanoM"},{"@id":"http://qudt.org/vocab/unit/PARSEC"},{"@id":"http://qudt.org/vocab/unit/PCA"},{"@id":"http://qudt.org/vocab/unit/PT"},{"@id":"http://qudt.org/vocab/unit/PicoM"},{"@id":"http://qudt.org/vocab/unit/PlanckLength"},{"@id":"http://qudt.org/vocab/unit/ROD"},{"@id":"http://qudt.org/vocab/unit/YD"},{"@id":"http://qudt.org/vocab/unit/ZOLL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Liquid level refers to the measurement of the height of a liquid within a container.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1481422"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Liquid Level","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}]},{"@id":"http://qudt.org/vocab/quantitykind/LiquidVolume","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Liquid volume is the volume of a given amount of liquid, that is, the amount of space a liquid takes up.\n    There are a number of different units used to measure liquid volume, but most of them fall under either the metric system of\n    measurement or the Imperial system of measurement.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BBL_US"},{"@id":"http://qudt.org/vocab/unit/BBL_US_PET"},{"@id":"http://qudt.org/vocab/unit/CUP"},{"@id":"http://qudt.org/vocab/unit/CUP_US"},{"@id":"http://qudt.org/vocab/unit/CentiL"},{"@id":"http://qudt.org/vocab/unit/GAL_IMP"},{"@id":"http://qudt.org/vocab/unit/GAL_UK"},{"@id":"http://qudt.org/vocab/unit/GAL_US"},{"@id":"http://qudt.org/vocab/unit/KiloCubicFT"},{"@id":"http://qudt.org/vocab/unit/L"},{"@id":"http://qudt.org/vocab/unit/OZ_VOL_US"},{"@id":"http://qudt.org/vocab/unit/PINT_US"},{"@id":"http://qudt.org/vocab/unit/QT_US"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.ehow.com/facts_6371078_liquid-volume_.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Liquid volume is the volume of a given amount of liquid, that is, the amount of space a liquid\n    takes up. There are a number of different units used to measure liquid volume, but most of them fall under either the metric\n    system of measurement or the Imperial system of measurement.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Volume"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LiquidVolume","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Liquid Volume","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Volume"}]},{"@id":"http://qudt.org/vocab/quantitykind/Log10FrequencyInterval","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The common (base-10) logarithm of the ratio of two frequencies, whereby the frequency forming the\n    numerator is greater than the frequency forming the denominator. Its corresponding unit is the decade.\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DECADE"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ472#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD084","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD084","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$G = \\log_{10}(f_2/f_1)$, where $f_1$ and $f_2 \\geq f_1$ are frequencies of two tones.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Log10FrequencyInterval","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Logarithmic Frequency Interval to Base 10","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/LogarithmicFrequencyInterval"}]},{"@id":"http://qudt.org/vocab/quantitykind/Log10Ratio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The common (base-10) logarithm of the ratio between the value of a defined quantity and the value of a\n    reference quantity of the same type.\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/B"},{"@id":"http://qudt.org/vocab/unit/DeciB"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ441#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD085","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD085","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/RLGB"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Log10Ratio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Logarithmic Ratio to Base 10","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/LogERatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/Log10RatioPerLength","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The common (base-10) logarithm of the ratio between the value of a quantity and the value of a reference\n    quantity of the same type, divided by the length over which the ratio arises. Typically used for attenuation or gain along a\n    cable or transmission path, in bels or decibels per unit length.\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/B-PER-M"},{"@id":"http://qudt.org/vocab/unit/DeciB-PER-KiloM"},{"@id":"http://qudt.org/vocab/unit/DeciB-PER-M"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ332#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD078","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD078","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Log10RatioPerLength","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Logarithmic Ratio to Base 10 per Length","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/LinearAttenuationCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/Log10Ratio"}]},{"@id":"http://qudt.org/vocab/quantitykind/Log2FrequencyInterval","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/OCT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/LogarithmicFrequencyInterval"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD083","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD083","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q86499668"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Log2FrequencyInterval","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Logarithmic Frequency Interval to Base 2","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LogERatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The natural (base-e) logarithm of the ratio between the value of a given quantity and the value of a\n    reference quantity of the same type (base of logarithm: e = 2.718...).\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/NP"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ440#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD086","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD086","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LogERatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Logarithmic Ratio to Base e","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/Log10Ratio"}]},{"@id":"http://qudt.org/vocab/quantitykind/LogOctanolAirPartitionCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A dimensionless ratio that is the logarithm of the ratio of a compound's concentration within a two phase\n    mixture of liquid octanol and gaseous air at equilibrium.  More simply, it is a comparison of the solubilities of the compound\n    solute in these two immiscible substances.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A dimensionless ratio that is the logarithm of the ratio of a compound's concentration within a two\n    phase mixture of liquid octanol and gaseous air at equilibrium.  More simply, it is a comparison of the solubilities of the\n    compound solute in these two immiscible substances.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LogOctanolAirPartitionCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Octanol Air Partition Coefficient","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/LogOctanolWaterPartitionCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A dimensionless ratio that is the logarithm of the ratio of a compound's concentration within a two phase\n    mixture of octanol and water at equilibrium.  More simply, it is a comparison of the solubilities of the compound solute in\n    these two immiscible liquids.  This property is used to measure the lipophilicity and the hydrophilicity of a substance.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A dimensionless ratio that is the logarithm of the ratio of a compound's concentration within a two\n    phase mixture of octanol and water at equilibrium.  More simply, it is a comparison of the solubilities of the compound solute\n    in these two immiscible liquids.  This property is used to measure the lipophilicity and the hydrophilicity of a substance.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LogOctanolWaterPartitionCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Logarithm of Octanol Water Partition Coefficient","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/LogarithmRatioToBase10","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"common logarithm of the ratio between the value of a defined variable and the value of a reference\n    variable of the same type\n  ","@language":"en"},{"@value":"dekadischer Logarithmus des Verhältnisses des Werts einer gegebenen Größe zum Wert einer Bezugsgröße\n    gleicher Art\n  ","@language":"de"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/Log10Ratio"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.5.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ441#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD085","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD085","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/RLGB"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Logarithm Ratio to Base 10","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/LogarithmRatioToBaseE","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"napierian logarithm of the ratio between the value of a given quantity and the value of a reference\n    variable of the same type (base of logarithm: e = 2.718...)\n  ","@language":"en"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/LogERatio"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.5.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ440#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"natürlicher Logarithmus des Verhältnisses des Werts einer gegebenen Größe zum Wert einer\n    Bezugsgröße gleicher Art (Basis des Logarithmus: e = 2,718...)\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Logarithm Ratio to Base e","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/LogarithmicFrequencyInterval","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The binary (base-2) logarithm of the ratio of two frequencies, whereby the frequency forming the\n    numerator is greater than the frequency forming the denominator. Its corresponding unit is the octave.\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/OCT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ338#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/Log2FrequencyInterval"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD083","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD083","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$G = \\log_{2}(f2/f1)$, where $f1$ and $f2 \\geq f1$ are frequencies of two tones.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q86499668"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"belongs to SOQ-ISO","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LogarithmicFrequencyInterval","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Frequenzmaßintervall","@language":"de"},{"@value":"Interval měření frekvence ?","@language":"cs"},{"@value":"Logarithmic Frequency Interval","@language":"en"},{"@value":"Selang kekerapan logaritma","@language":"ms"},{"@value":"intervalle de fréquence logarithmique","@language":"fr"},{"@value":"intervallo logaritmico di frequenza","@language":"it"},{"@value":"intervalo logarítmico de frequência","@language":"pt"},{"@value":"logaritmik frekans aralığı","@language":"tr"},{"@value":"частотный интервал","@language":"ru"},{"@value":"فاصله فرکانس لگاریتمی","@language":"fa"},{"@value":"对数频率间隔","@language":"zh"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/Log10FrequencyInterval"}]},{"@id":"http://qudt.org/vocab/quantitykind/LogarithmicFrequencyIntervalToBase10","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"common logarithm of the ratio of two frequencies, whereby the frequency that forms the numerator is\n    greater than the frequency that forms the denominator\n  ","@language":"en"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/Log10FrequencyInterval"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.5.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ472#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"dekadischer Logarithmus des Quotienten aus zwei Frequenzen, wobei die im Zähler stehende Frequenz\n    größer als die Frequenz im Nenner ist\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Logarithmic Frequency Interval to Base 10","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/LogarithmicMedianInformationFlow_SourceToBase10","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio of the median information content divided by the expected value for the duration of a character,\n    expressed as a logarithm to base 10\n  ","@language":"en"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/InformationFlowRate"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ470#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient mittlerer Informationsgehalt durch den Erwartungswert für die Dauer eines Zeichens,\n    ausgedrückt als Logarithmus zur Basis 10\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"median information flow (from a source of information), expressed as a common logarithm ","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/LogarithmicMedianInformationFlow_SourceToBase2","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio of the median information content divided by the expected value for the duration of a character,\n    expressed as a logarithm to base 2\n  ","@language":"en"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/InformationFlowRate"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ464#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient mittlerer Informationsgehalt durch den Erwartungswert für die Dauer eines Zeichens,\n    ausgedrückt als Logarithmus zur Basis 2\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"median information flow (from a source of information), expressed as a binary logarithm","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/LogarithmicMedianInformationFlow_SourceToBaseE","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio of the median information content divided by the expected value for the duration of a character,\n    expressed as a logarithm to base e\n  ","@language":"en"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/InformationFlowRate"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ471#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient mittlerer Informationsgehalt durch den Erwartungswert für die Dauer eines Zeichens,\n    ausgedrückt als Logarithmus zur Basis e\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"median information flow (from a source of information), expressed as a natural logarithm ","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/LondonPenetrationDepth","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"London Penetration Depth\" characterizes the distance to which a magnetic field penetrates into a\n    superconductor and becomes equal to 1/e times that of the magnetic field at the surface of the superconductor.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ANGSTROM"},{"@id":"http://qudt.org/vocab/unit/AU"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB_F"},{"@id":"http://qudt.org/vocab/unit/CHAIN"},{"@id":"http://qudt.org/vocab/unit/CHAIN_US"},{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/DecaM"},{"@id":"http://qudt.org/vocab/unit/DeciM"},{"@id":"http://qudt.org/vocab/unit/FATH"},{"@id":"http://qudt.org/vocab/unit/FM"},{"@id":"http://qudt.org/vocab/unit/FT"},{"@id":"http://qudt.org/vocab/unit/FT_US"},{"@id":"http://qudt.org/vocab/unit/FUR"},{"@id":"http://qudt.org/vocab/unit/FemtoM"},{"@id":"http://qudt.org/vocab/unit/GAUGE_FR"},{"@id":"http://qudt.org/vocab/unit/GA_Charriere"},{"@id":"http://qudt.org/vocab/unit/HectoM"},{"@id":"http://qudt.org/vocab/unit/IN"},{"@id":"http://qudt.org/vocab/unit/KiloM"},{"@id":"http://qudt.org/vocab/unit/LY"},{"@id":"http://qudt.org/vocab/unit/M"},{"@id":"http://qudt.org/vocab/unit/MI"},{"@id":"http://qudt.org/vocab/unit/MI_N"},{"@id":"http://qudt.org/vocab/unit/MI_UK"},{"@id":"http://qudt.org/vocab/unit/MI_US"},{"@id":"http://qudt.org/vocab/unit/MicroIN"},{"@id":"http://qudt.org/vocab/unit/MicroM"},{"@id":"http://qudt.org/vocab/unit/MilLength"},{"@id":"http://qudt.org/vocab/unit/MilliIN"},{"@id":"http://qudt.org/vocab/unit/MilliM"},{"@id":"http://qudt.org/vocab/unit/NanoM"},{"@id":"http://qudt.org/vocab/unit/PARSEC"},{"@id":"http://qudt.org/vocab/unit/PCA"},{"@id":"http://qudt.org/vocab/unit/PT"},{"@id":"http://qudt.org/vocab/unit/PicoM"},{"@id":"http://qudt.org/vocab/unit/PlanckLength"},{"@id":"http://qudt.org/vocab/unit/ROD"},{"@id":"http://qudt.org/vocab/unit/YD"},{"@id":"http://qudt.org/vocab/unit/ZOLL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/London_penetration_depth","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"If an applied magnetic field is parallel to the plane surface of a semi-infinite superconductor, the field penetrates the superconductor according to the expression $B(x) = B(0) \\exp{(\\frac{-x}{\\lambda_L})}$, where $B$ is magnetic flux density and $x$ is the distance from the surface.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"London Penetration Depth\" characterizes the distance to which a magnetic field penetrates into a\n    superconductor and becomes equal to 1/e times that of the magnetic field at the surface of the superconductor.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"λₗ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q3277853"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"London Penetration Depth","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}]},{"@id":"http://qudt.org/vocab/quantitykind/Long-RangeOrderParameter","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Long-Range Order Parameter\" is the fraction of atoms in an Ising ferromagnet having magnetic moments in\n    one direction, minus the fraction having magnetic moments in the opposite direction.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/LongRangeOrderParameter"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Long-Range Order Parameter\" is the fraction of atoms in an Ising ferromagnet having magnetic\n    moments in one direction, minus the fraction having magnetic moments in the opposite direction.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"R, s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q105496124"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Long-Range Order Parameter","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LongRangeOrderParameter","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Long-Range Order Parameter\" is the fraction of atoms in an Ising ferromagnet having magnetic moments in\n    one direction, minus the fraction having magnetic moments in the opposite direction.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Long-Range Order Parameter\" is the fraction of atoms in an Ising ferromagnet having magnetic\n    moments in one direction, minus the fraction having magnetic moments in the opposite direction.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"R, s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q105496124"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LongRangeOrderParameter","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Long-Range Order Parameter","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LorenzCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Lorenz Coefficient\" is part mof the Lorenz curve.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/V2-PER-K2"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ429#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-2L4I0M2H-2T-6D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD087","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.matter.org.uk/diffraction/geometry/lattice_vectors.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD087","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$L = \\frac{\\lambda}{\\sigma T}$, where $\\lambda$ is thermal conductivity, $\\sigma$ is electric conductivity, and $T$ is thermodynamic temperature.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Lorenz Coefficient\" is part mof the Lorenz curve.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"L","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q105728754"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LorenzCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Lorenz Coefficient","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LossAngle","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ARCMIN"},{"@id":"http://qudt.org/vocab/unit/ARCSEC"},{"@id":"http://qudt.org/vocab/unit/DEG"},{"@id":"http://qudt.org/vocab/unit/GON"},{"@id":"http://qudt.org/vocab/unit/GRAD"},{"@id":"http://qudt.org/vocab/unit/MIL_Angle"},{"@id":"http://qudt.org/vocab/unit/MIN_Angle"},{"@id":"http://qudt.org/vocab/unit/MicroRAD"},{"@id":"http://qudt.org/vocab/unit/MilliARCSEC"},{"@id":"http://qudt.org/vocab/unit/MilliRAD"},{"@id":"http://qudt.org/vocab/unit/RAD"},{"@id":"http://qudt.org/vocab/unit/REV"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\delta = \\arctan d$, where $d$ is loss factor.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\delta$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q20820438"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Angle","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:PlaneAngle","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Loss Angle","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}]},{"@id":"http://qudt.org/vocab/quantitykind/LossFactor","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Loss Factor}$ is the inverse of $\\textit{Quality Factor}$ and is the ratio of the\n    $\\textit{resistance}$ and modulus of $\\textit{reactance}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$d = \\frac{1}{Q}$, where $Q$ is quality factor.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Loss Factor is the inverse of Quality Factor and is the ratio of the resistance and modulus of\n    reactance.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"d","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q79468728"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LossFactor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Loss Factor","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/QualityFactor"},{"@id":"http://qudt.org/vocab/quantitykind/Reactance"},{"@id":"http://qudt.org/vocab/quantitykind/Resistance"}]},{"@id":"http://qudt.org/vocab/quantitykind/Loudness","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"measure of the subjective hearing sensation on a scale extending from soft to loud; a progressive\n    mono-frequency (single-frequency) wave of frequency 1 kHz and sound pressure level 40 dB, directed head-on to hearers is\n    assigned the loudness 1 sone, and a tone which is identified by the listeners as being n-times as loud as that identified by 1\n    sone is assigned the loudness n sone\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ334#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD088","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD088","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Maß für die Stärke der subjektiven Hörempfindung, welche auf einer Skala \"leise-laut\" in sone\n    skaliert wird; einer frei fortschreitenden monofrequenten Welle mit der Frequenz 1 kHz und dem Schalldruckpegel 40 dB, die\n    frontal auf die Zuhörer trifft, ist die Lautheit 1 sone zugeordnet und ein Laut, welcher von den Zuhörern als n-mal so laut\n    wie derjenige mit 1 sone bezeichnet wird, erhält die Lautheit n sone zugeordnet\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Loudness","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Loudness","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}]},{"@id":"http://qudt.org/vocab/quantitykind/LoudnessLevel","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"value specified in phon as a measure of the level of the subjective perception of a sound which\n    corresponds to the sound pressure level of a reference sound specified in dB which comprises a wave coming from the front with\n    a frequency of 1000 Hz and assessed to be just as loud as the noise\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ361#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD089","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD089","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"in phon angegebener Wert als Maß für die Stärke der subjektiven Wahrnehmung eines Schallvorgange,\n    der zahlenmäßig dem in dB angegebenen Schalldruckpegel eines Referenzschalls entspricht, der aus einer frontal einfallenden\n    ebenen Welle mit der Frequenz 1000 Hz besteht und als gleich laut wie das Geräusch empfunden wird\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LoudnessLevel","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Loudness Level","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}]},{"@id":"http://qudt.org/vocab/quantitykind/LowerCriticalMagneticFluxDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Lower Critical Magnetic Flux Density\" for type II superconductors, is the threshold magnetic flux\n    density for magnetic flux entering the superconductor.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/GAMMA"},{"@id":"http://qudt.org/vocab/unit/GAUSS"},{"@id":"http://qudt.org/vocab/unit/KiloGAUSS"},{"@id":"http://qudt.org/vocab/unit/KiloT"},{"@id":"http://qudt.org/vocab/unit/MicroT"},{"@id":"http://qudt.org/vocab/unit/MilliT"},{"@id":"http://qudt.org/vocab/unit/NanoT"},{"@id":"http://qudt.org/vocab/unit/T"},{"@id":"http://qudt.org/vocab/unit/T_Ab"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Lower Critical Magnetic Flux Density\" for type II superconductors, is the threshold magnetic flux\n    density for magnetic flux entering the superconductor.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensity"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"B_{c1}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q106127355"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticFluxDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Lower Critical Magnetic Flux Density","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensity"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://qudt.org/vocab/quantitykind/UpperCriticalMagneticFluxDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/Luminance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Luminance is a photometric measure of the luminous intensity per unit area of light travelling in a given\n    direction. It describes the amount of light that passes through or is emitted from a particular area, and falls within a given\n    solid angle.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CD-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/CD-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/CD-PER-M2"},{"@id":"http://qudt.org/vocab/unit/LA"},{"@id":"http://qudt.org/vocab/unit/LA_FT"},{"@id":"http://qudt.org/vocab/unit/STILB"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Luminance","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ286#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I1M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD090","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD090","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Luminance","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$L_v = \\frac{dI_v}{dA}$, where $dI_v$ is the luminous intensity of an element of the surface with the area $dA$ of the orthogonal projection of this element on a plane perpendicular to the given direction.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Luminance is a photometric measure of the luminous intensity per unit area of light travelling in a\n    given direction. It describes the amount of light that passes through or is emitted from a particular area, and falls within a\n    given solid angle.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/LUMA"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"L_v","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q355386"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Luminance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Luminance","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LuminousEfficacy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Luminous Efficacy is the ratio of luminous flux (in lumens) to power (usually measured in watts).\n    Depending on context, the power can be either the radiant flux of the source's output, or it can be the total electric power\n    consumed by the source.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/LM-PER-W"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ335#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$lm/w$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I1M-1H0T3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD091","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD091","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Luminous_efficacy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$K = \\frac{\\Phi_v}{\\Phi}$, where $\\Phi_v$ is the luminous flux and $\\Phi$ is the corresponding radiant flux.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Luminous Efficacy is the ratio of luminous flux (in lumens) to power (usually measured in watts).\n    Depending on context, the power can be either the radiant flux of the source's output, or it can be the total electric power\n    consumed by the source.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1504173"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LuminousEfficacy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Luminous Efficacy","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LuminousEmittance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Luminous Emittance\" is the luminous flux per unit area emitted from a surface.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FC"},{"@id":"http://qudt.org/vocab/unit/LM-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/LM-PER-M2"},{"@id":"http://qudt.org/vocab/unit/LUX"},{"@id":"http://qudt.org/vocab/unit/PHOT"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I1M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD092","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD092","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Luminous Emittance\" is the luminous flux per unit area emitted from a surface.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/LuminousFluxPerArea"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"M_v","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LuminousFluxPerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Luminous Emmitance","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/LuminousFluxPerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/LuminousEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Luminous Energy is the perceived energy of light. This is sometimes also called the quantity of light.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/altSymbol":[{"@value":"Qv","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/LM-HR"},{"@id":"http://qudt.org/vocab/unit/LM-SEC"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/QuantityOfLight"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I1M0H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD373","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD373","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Luminous_energy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$Q_v = \\int_{0}^{\\Delta t}{\\Phi_v}{dt}$, where $\\Phi_v$ is the luminous flux occurring during the time interval with duration $\\Delta t$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Luminous Energy is the perceived energy of light. This is sometimes also called the quantity of\n    light.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Q_v","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q900164"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LuminousEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Luminous Energy","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://qudt.org/vocab/quantitykind/RadiantEnergy"}]},{"@id":"http://qudt.org/vocab/quantitykind/LuminousExitance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Luminous Exitance}$ is the ratio of the luminous flux dΦ, leaving an element of the surface\n    containing the point, by the area dA of that element.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FC"},{"@id":"http://qudt.org/vocab/unit/LM-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/LM-PER-M2"},{"@id":"http://qudt.org/vocab/unit/LUX"},{"@id":"http://qudt.org/vocab/unit/PHOT"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ382#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I1M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD092","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD092","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Luminous Exitance is the ratio of the luminous flux dΦ, leaving an element of the surface\n    containing the point, by the area dA of that element.\n  ","@language":"en"},{"@value":"Quotient aus dem Lichtstrom dΦ, der ein den Punkt enthaltendes Element der Oberfläche verlässt, und\n    der Fläche dA dieses Elementes\n  ","@language":"de"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/LuminousFluxPerArea"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LuminousFluxPerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Luminous Exitance","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/LuminousFluxPerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/LuminousExposure","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Luminous Exposure is the time-integrated illuminance.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/altSymbol":[{"@value":"Hv","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/LUX-HR"},{"@id":"http://qudt.org/vocab/unit/LUX-SEC"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ232#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I1M0H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD093","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD093","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Exposure_(photography)#Photometric_and_radiometric_exposure","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Luminous_energy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Luminous Exposure is the time-integrated illuminance.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"H_v","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q815588"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LuminousExposure","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Luminous Exposure","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LuminousFlux","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\n  $\\textit{Luminous Flux}$, or $\\textit{Luminous Power}$, is the measure of the perceived power of light. \n  It differs from radiant flux, the measure of the total power of light emitted,\n   in that luminous flux is adjusted to reflect the varying sensitivity of the human eye to different wavelengths of light.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloLM"},{"@id":"http://qudt.org/vocab/unit/LM"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Luminous_flux","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ220#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I1M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD094","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD094","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Luminous_flux","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\Phi_v = K_m \\int_{0}^{\\infty}{\\Phi_\\lambda(\\lambda)}{V(\\lambda)d\\lambda}$, where $K_m$ is the maximum spectral luminous efficacy, $\\Phi_\\lambda(\\lambda)$ is the spectral radiant flux, $V(\\lambda)$ is the spectral luminous efficiency, and $\\lambda$ is the wavelength.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Luminous Flux or Luminous Power is the measure of the perceived power of light. It differs from\n    radiant flux, the measure of the total power of light emitted, in that luminous flux is adjusted to reflect the varying\n    sensitivity of the human eye to different wavelengths of light.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/LUFL"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"F","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q107780"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LuminousFlux","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Fluks berluminositi","@language":"ms"},{"@value":"Lichtstrom","@language":"de"},{"@value":"Luminous Flux","@language":"en"},{"@value":"Světelný tok","@language":"cs"},{"@value":"fluctús lucis","@language":"la"},{"@value":"flujo luminoso","@language":"es"},{"@value":"flusso luminoso","@language":"it"},{"@value":"flux lumineux","@language":"fr"},{"@value":"flux luminos","@language":"ro"},{"@value":"fluxo luminoso","@language":"pt"},{"@value":"fényáram","@language":"hu"},{"@value":"işık akısı","@language":"tr"},{"@value":"strumień świetlny","@language":"pl"},{"@value":"svetlobni tok","@language":"sl"},{"@value":"Светлинен поток","@language":"bg"},{"@value":"Световой поток","@language":"ru"},{"@value":"שטף הארה","@language":"he"},{"@value":"التدفق الضوئي","@language":"ar"},{"@value":"شار نوری","@language":"fa"},{"@value":"प्रकाशीय बहाव","@language":"hi"},{"@value":"光束","@language":"ja"},{"@value":"光通量","@language":"zh"}]},{"@id":"http://qudt.org/vocab/quantitykind/LuminousFluxPerArea","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In photometry, illuminance is the total luminous flux incident on a surface, per unit area. It is a\n    measure of how much the incident light illuminates the surface, wavelength-weighted by the luminosity function to correlate\n    with human brightness perception. Similarly, luminous emittance is the luminous flux per unit area emitted from a surface. In\n    SI derived units these are measured in $lux (lx)$ or $lumens per square metre$ ($cd \\cdot m^{-2}$). In the CGS system, the\n    unit of illuminance is the $phot$, which is equal to $10,000 lux$. The $foot-candle$ is a non-metric unit of illuminance that\n    is used in photography.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FC"},{"@id":"http://qudt.org/vocab/unit/LM-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/LM-PER-M2"},{"@id":"http://qudt.org/vocab/unit/LUX"},{"@id":"http://qudt.org/vocab/unit/PHOT"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I1M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Illuminance","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LuminousFluxPerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Luminous Flux per Area","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/LuminousFluxRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Luminous Flux Ratio (or Relative Luminous Flux or Relative Luminous Power) is the measure of the\n    perceived power of light. It differs from radiant flux, the measure of the total power of light emitted, in that luminous flux\n    is adjusted to reflect the varying sensitivity of the human eye to different wavelengths of light. It is expressed as a\n    percentage or fraction of full power.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Luminous_flux","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Luminous Flux Ratio (or Relative Luminous Flux or Relative Luminous Power) is the measure of the\n    perceived power of light. It differs from radiant flux, the measure of the total power of light emitted, in that luminous flux\n    is adjusted to reflect the varying sensitivity of the human eye to different wavelengths of light. It is expressed as a\n    percentage or fraction of full power.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LuminousFluxRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Luminous Flux Ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/LuminousIntensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Luminous Intensity is a measure of the wavelength-weighted power emitted by a light source in a\n    particular direction per unit solid angle. The weighting is determined by the luminosity function, a standardized model of the\n    sensitivity of the human eye to different wavelengths.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CD"},{"@id":"http://qudt.org/vocab/unit/CD_IT"},{"@id":"http://qudt.org/vocab/unit/CP"},{"@id":"http://qudt.org/vocab/unit/HK"},{"@id":"http://qudt.org/vocab/unit/KiloCD"},{"@id":"http://qudt.org/vocab/unit/MilliCD"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Luminous_intensity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ219#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I1M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD095","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD095","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Luminous Intensity is a measure of the wavelength-weighted power emitted by a light source in a\n    particular direction per unit solid angle. The weighting is determined by the luminosity function, a standardized model of the\n    sensitivity of the human eye to different wavelengths.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/LUIN"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q104831"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LuminousIntensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Keamatan berluminositi","@language":"ms"},{"@value":"Lichtstärke","@language":"de"},{"@value":"Luminous Intensity","@language":"en"},{"@value":"Svítivost","@language":"cs"},{"@value":"fényerősség","@language":"hu"},{"@value":"intensidad luminosa","@language":"es"},{"@value":"intensidade luminosa","@language":"pt"},{"@value":"intensitas luminosa","@language":"la"},{"@value":"intensitate luminoasă","@language":"ro"},{"@value":"intensità luminosa","@language":"it"},{"@value":"intensité lumineuse","@language":"fr"},{"@value":"svetilnost","@language":"sl"},{"@value":"ışık şiddeti","@language":"tr"},{"@value":"światłość","@language":"pl"},{"@value":"Ένταση Φωτεινότητας","@language":"el"},{"@value":"Интензитет на светлината","@language":"bg"},{"@value":"Сила света","@language":"ru"},{"@value":"עוצמת הארה","@language":"he"},{"@value":"شدة الإضاءة","@language":"ar"},{"@value":"شدت نور","@language":"fa"},{"@value":"प्रकाशीय तीव्रता","@language":"hi"},{"@value":"光度","@language":"ja"},{"@value":"发光强度","@language":"zh"}]},{"@id":"http://qudt.org/vocab/quantitykind/LuminousIntensityDistribution","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Luminous Intensity Distribution\" is a measure of the luminous intensity of a light source that changes\n    according to the direction of the ray. It is normally based on some standardized distribution light distribution curves.\n    Usually measured in Candela/Lumen (cd/lm) or (cd/klm).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CD-PER-KiloLM"},{"@id":"http://qudt.org/vocab/unit/CD-PER-LM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Luminous Intensity Distribution\" is a measure of the luminous intensity of a light source that\n    changes according to the direction of the ray. It is normally based on some standardized distribution light distribution\n    curves. Usually measured in Candela/Lumen (cd/lm) or (cd/klm).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LuminousIntensityDistribution","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Ion Concentration","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MASS-DELIVERED","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The minimum mass a propulsive system can deliver to a specified target or location. Most mass- delivered\n    requirements have associated Delta-V requirements, effectively specifying the path between the two points.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The minimum mass a propulsive system can deliver to a specified target or location. Most mass-\n    delivered requirements have associated Delta-V requirements, effectively specifying the path between the two points.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Delivered","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}]},{"@id":"http://qudt.org/vocab/quantitykind/MASS-GROWTH-ALLOWANCE","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A factor applied to basic mass at the lowest level of design detail available based on type and maturity\n    of hardware according to an approved MGA depletion schedule.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A factor applied to basic mass at the lowest level of design detail available based on type and\n    maturity of hardware according to an approved MGA depletion schedule.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Growth Allowance","@language":"en"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"MGA","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}]},{"@id":"http://qudt.org/vocab/quantitykind/MASS-MARGIN","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Requirement minus predicted value. Margin is used as a metric in risk management. Positive margin\n    mitigates the risk of mass increases from requirements maturation and implementation, underestimated predicted system, or\n    subsystem mass.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Requirement minus predicted value. Margin is used as a metric in risk management. Positive margin\n    mitigates the risk of mass increases from requirements maturation and implementation, underestimated predicted system, or\n    subsystem mass.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Margin","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}]},{"@id":"http://qudt.org/vocab/quantitykind/MASS-PROPERTY-UNCERTAINTY","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Variation in predicted MP due to lack of definition, manufacturing variations, environment effects, or\n    accuracy limitation of measuring devices.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Variation in predicted MP due to lack of definition, manufacturing variations, environment effects,\n    or accuracy limitation of measuring devices.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Property Uncertainty","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}]},{"@id":"http://qudt.org/vocab/quantitykind/MOMENT-OF-INERTIA_Y","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The rotational inertia or resistance to change in direction or speed of rotation about a defined axis.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/MomentOfInertia_Y"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The rotational inertia or resistance to change in direction or speed of rotation about a defined\n    axis.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"I_{y}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Moment of Inertia in the Y axis","@language":"en"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"MOI","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MomentOfInertia"}]},{"@id":"http://qudt.org/vocab/quantitykind/MOMENT-OF-INERTIA_Z","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The rotational inertia or resistance to change in direction or speed of rotation about a defined axis.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/MomentOfInertia_Z"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The rotational inertia or resistance to change in direction or speed of rotation about a defined\n    axis.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"I_{z}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Moment of Inertia in the Z axis","@language":"en"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"MOI","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MomentOfInertia"}]},{"@id":"http://qudt.org/vocab/quantitykind/MachNumber","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Mach Number\" is a dimensionless quantity representing the speed of an object moving through air or other\n    fluid divided by the local speed of sound. It is commonly used to represent the speed of an object when it is traveling close\n    to or above the speed of sound. The Mach number is commonly used both with objects traveling at high speed in a fluid, and\n    with high-speed fluid flows inside channels such as nozzles, diffusers or wind tunnels. As it is defined as a ratio of two\n    speeds, it is a dimensionless number.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MACH"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Mach_number","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD364","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD364","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Mach_number","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31896","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$Ma = \\frac{v_o}{c_o}$, where $v_0$ is speed, and $c_o$ is speed of sound.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31896","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Mach Number\" is a dimensionless quantity representing the speed of an object moving through air or\n    other fluid divided by the local speed of sound. It is commonly used to represent the speed of an object when it is traveling\n    close to or above the speed of sound. The Mach number is commonly used both with objects traveling at high speed in a fluid,\n    and with high-speed fluid flows inside channels such as nozzles, diffusers or wind tunnels. As it is defined as a ratio of two\n    speeds, it is a dimensionless number.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Ma","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q160669"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MachNumber","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mach Number","@language":"en"},{"@value":"Mach sayısı","@language":"tr"},{"@value":"Mach-Zahl","@language":"de"},{"@value":"Machovo číslo","@language":"cs"},{"@value":"Machovo število","@language":"sl"},{"@value":"Nombor Mach","@language":"ms"},{"@value":"liczba Macha","@language":"pl"},{"@value":"nombre de Mach","@language":"fr"},{"@value":"numero di Mach","@language":"it"},{"@value":"număr Mach","@language":"ro"},{"@value":"número de Mach","@language":"es"},{"@value":"número de Mach","@language":"pt"},{"@value":"число Маха","@language":"ru"},{"@value":"عدد ماخ","@language":"ar"},{"@value":"عدد ماخ","@language":"fa"},{"@value":"मैक संख्या","@language":"hi"},{"@value":"マッハ数n","@language":"ja"},{"@value":"马赫","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Mach_number"}]},{"@id":"http://qudt.org/vocab/quantitykind/MacroscopicCrossSection","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Macroscopic Cross-section\" is the sum of the cross-sections for a reaction or process of a specified\n    type over all atoms or other entities in a given 3D domain, divided by the volume of that domain.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AC"},{"@id":"http://qudt.org/vocab/unit/ARE"},{"@id":"http://qudt.org/vocab/unit/BARN"},{"@id":"http://qudt.org/vocab/unit/CentiM2"},{"@id":"http://qudt.org/vocab/unit/DecaARE"},{"@id":"http://qudt.org/vocab/unit/DeciM2"},{"@id":"http://qudt.org/vocab/unit/FT2"},{"@id":"http://qudt.org/vocab/unit/HA"},{"@id":"http://qudt.org/vocab/unit/IN2"},{"@id":"http://qudt.org/vocab/unit/KiloM2"},{"@id":"http://qudt.org/vocab/unit/KiloMIL_Circ"},{"@id":"http://qudt.org/vocab/unit/M2"},{"@id":"http://qudt.org/vocab/unit/MI2"},{"@id":"http://qudt.org/vocab/unit/MIL_Circ"},{"@id":"http://qudt.org/vocab/unit/MI_US2"},{"@id":"http://qudt.org/vocab/unit/MicroM2"},{"@id":"http://qudt.org/vocab/unit/MilliM2"},{"@id":"http://qudt.org/vocab/unit/NanoM2"},{"@id":"http://qudt.org/vocab/unit/PIXEL_AREA"},{"@id":"http://qudt.org/vocab/unit/PlanckArea"},{"@id":"http://qudt.org/vocab/unit/YD2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Cross_section_(physics)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\sum = n_1\\sigma_1 + \\cdots + n_j\\sigma_j +$, where $n_j$ is the number density and $\\sigma_j$ the cross-section for entities of type $j$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\sum$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Macroscopic Cross-section\" is the sum of the cross-sections for a reaction or process of a\n    specified type over all atoms or other entities in a given 3D domain, divided by the volume of that domain.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/CrossSection"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98280520"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Area","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Macroscopic Cross-section","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/CrossSection"}]},{"@id":"http://qudt.org/vocab/quantitykind/MacroscopicTotalCrossSection","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Macroscopic Total Cross-section\" is the total cross-sections for all atoms or other entities in a given\n    3D domain, divided by the volume of that domain.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AC"},{"@id":"http://qudt.org/vocab/unit/ARE"},{"@id":"http://qudt.org/vocab/unit/BARN"},{"@id":"http://qudt.org/vocab/unit/CentiM2"},{"@id":"http://qudt.org/vocab/unit/DecaARE"},{"@id":"http://qudt.org/vocab/unit/DeciM2"},{"@id":"http://qudt.org/vocab/unit/FT2"},{"@id":"http://qudt.org/vocab/unit/HA"},{"@id":"http://qudt.org/vocab/unit/IN2"},{"@id":"http://qudt.org/vocab/unit/KiloM2"},{"@id":"http://qudt.org/vocab/unit/KiloMIL_Circ"},{"@id":"http://qudt.org/vocab/unit/M2"},{"@id":"http://qudt.org/vocab/unit/MI2"},{"@id":"http://qudt.org/vocab/unit/MIL_Circ"},{"@id":"http://qudt.org/vocab/unit/MI_US2"},{"@id":"http://qudt.org/vocab/unit/MicroM2"},{"@id":"http://qudt.org/vocab/unit/MilliM2"},{"@id":"http://qudt.org/vocab/unit/NanoM2"},{"@id":"http://qudt.org/vocab/unit/PIXEL_AREA"},{"@id":"http://qudt.org/vocab/unit/PlanckArea"},{"@id":"http://qudt.org/vocab/unit/YD2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Cross_section_(physics)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Nuclear_cross_section","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\sum_{tot}, \\sum_T$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Macroscopic Total Cross-section\" is the total cross-sections for all atoms or other entities in a\n    given 3D domain, divided by the volume of that domain.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/CrossSection"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98280548"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Area","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Macroscopic Total Cross-section","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/CrossSection"}]},{"@id":"http://qudt.org/vocab/quantitykind/MadelungConstant","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Madelung Constant\" is used in determining the electrostatic potential of a single ion in a crystal by\n    approximating the ions by point charges. It is named after Erwin Madelung, a German physicist.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Madelung_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"For a uni-univalent ionic crystal of specified structure, the binding energy $V_b$ per pair of ions is $V_b = \\alpha\\frac{e^2}{4\\pi \\varepsilon_0 a}$, where $e$ is the elementary charge, $\\varepsilon_0$ is the electric constant, and $a$ is the lattice constant which should be specified.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\alpha$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Madelung Constant\" is used in determining the electrostatic potential of a single ion in a crystal\n    by approximating the ions by point charges. It is named after Erwin Madelung, a German physicist.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q898781"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MadelungConstant","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Constante de Madelung","@language":"es"},{"@value":"Constante de Madelung","@language":"fr"},{"@value":"Costante di Madelung","@language":"it"},{"@value":"Madelung Constant","@language":"en"},{"@value":"Madelung-Konstante","@language":"de"},{"@value":"Stała Madelunga","@language":"pl"},{"@value":"constante de Madelung","@language":"pt"},{"@value":"постоянная Маделунга","@language":"ru"},{"@value":"ثابت مادلونك","@language":"ar"},{"@value":"ثابت مادلونگ","@language":"fa"},{"@value":"マーデルングエネルギー","@language":"ja"},{"@value":"馬德隆常數","@language":"zh"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagneticAreaMoment","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Magnetic Area Moment\", for a magnetic dipole, is a vector quantity equal to the product of the current,\n    the loop area, and the unit vector normal to the loop plane, the direction of which corresponds to the loop orientation.\n    \"Magnetic Area Moment\" is also referred to as \"Magnetic Moment\".\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-M2"},{"@id":"http://qudt.org/vocab/unit/A_Ab-CentiM2"},{"@id":"http://qudt.org/vocab/unit/EV-PER-T"},{"@id":"http://qudt.org/vocab/unit/J-PER-T"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticMoment"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-49","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$m = I e_n A$, where $I$ is electric current in a small closed loop, $e_n$ is a unit vector perpendicular to the loop, and $A$ is the area of the loop. The magnetic moment of a substance within a domain is the vector sum of the magnetic moments of all entities included in the domain.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Magnetic Area Moment\", for a magnetic dipole, is a vector quantity equal to the product of the\n    current, the loop area, and the unit vector normal to the loop plane, the direction of which corresponds to the loop\n    orientation. \"Magnetic Area Moment\" is also referred to as \"Magnetic Moment\".\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticAreaMoment","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Magnetic Area Moment","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagneticDipoleMoment","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Magnetic Dipole Moment\" is the magnetic moment of a system is a measure of the magnitude and the\n    direction of its magnetism. Magnetic moment usually refers to its Magnetic Dipole Moment, and quantifies the contribution of\n    the system's internal magnetism to the external dipolar magnetic field produced by the system (that is, the component of the\n    external magnetic field that is inversely proportional to the cube of the distance to the observer). The Magnetic Dipole\n    Moment is a vector-valued quantity. For a particle or nucleus, vector quantity causing an increment $\\Delta W = -\\mu \\cdot\n    B$ to its energy $W$ in an external magnetic field with magnetic flux density $B$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/N-M2-PER-A"},{"@id":"http://qudt.org/vocab/unit/WB-M"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ451#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L3I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD096","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-55","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD096","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://www.simetric.co.uk/siderived.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$E_m = -m \\cdot B$, where $E_m$ is the interaction energy of the molecule with magnetic diploe moment $m$ and a magnetic field with magnetic flux density $B$\n\nor,\n\n$J_m = \\mu_0 M$ where $\\mu_0$ is the magnetic constant and $M$ is Magnetization.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mu$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J_m","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q71008556"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticDipoleMoment","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Magnetic Dipole Moment","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagneticDipoleMomentOfAMolecule","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Em = -m•B, where Em is the interaction energy of the molecule with the magnetic dipole moment m and a\n    magnetic field with the magnetic induced flux density B\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-M2"},{"@id":"http://qudt.org/vocab/unit/A_Ab-CentiM2"},{"@id":"http://qudt.org/vocab/unit/EV-PER-T"},{"@id":"http://qudt.org/vocab/unit/J-PER-T"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ460#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Em = -m•B, wobei Em die Interaktionsenergie vom Molekül ist mit dem magnetischem Dipolmoment m und\n    einem Magnetfeld mit der magnetischen Induktionsflussdichte B\n  ","@language":"de"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticAreaMoment"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticMoment"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticAreaMoment","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:MagneticMoment","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Magnetic Dipole Moment of a Molecule","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticAreaMoment"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticMoment"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagneticField","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The Magnetic Field, denoted $B$, is a fundamental field in electrodynamics which characterizes the\n    magnetic force exerted by electric currents.  It is closely related to the auxillary magnetic field H (see\n    quantitykind:AuxillaryMagneticField).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/GAMMA"},{"@id":"http://qudt.org/vocab/unit/GAUSS"},{"@id":"http://qudt.org/vocab/unit/KiloGAUSS"},{"@id":"http://qudt.org/vocab/unit/KiloT"},{"@id":"http://qudt.org/vocab/unit/MicroT"},{"@id":"http://qudt.org/vocab/unit/MilliT"},{"@id":"http://qudt.org/vocab/unit/NanoT"},{"@id":"http://qudt.org/vocab/unit/T"},{"@id":"http://qudt.org/vocab/unit/T_Ab"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"B","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticField","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Magnetic Field","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFieldStrength","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Magnetic Field Strength}$ is a vector quantity obtained at a given point by subtracting the\n    magnetization $M$ from the magnetic flux density $B$ divided by the magnetic constant $\\mu_0$. The magnetic field strength is\n    related to the total current density $J_{tot}$ via: $\\text{rot} H = J_{tot}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/A-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/AT-PER-IN"},{"@id":"http://qudt.org/vocab/unit/AT-PER-M"},{"@id":"http://qudt.org/vocab/unit/KiloA-PER-M"},{"@id":"http://qudt.org/vocab/unit/MilliA-PER-IN"},{"@id":"http://qudt.org/vocab/unit/MilliA-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/OERSTED"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD098","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-56","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD098","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mathbf{H} = \\frac{\\mathbf{B} }{\\mu_0} - M$, where $\\mathbf{B} $ is magnetic flux density, $\\mu_0$ is the magnetic constant and $M$ is magnetization.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mathbf{H} $","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/MAFD"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPerLength"},{"@id":"http://qudt.org/vocab/quantitykind/LinearElectricCurrent"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q28123"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticFieldStrength","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Câmp magnetic","@language":"ro"},{"@value":"Kekuatan medan magnetik","@language":"ms"},{"@value":"Magnetic Field Strength","@language":"en"},{"@value":"Magnetické pole","@language":"cs"},{"@value":"Manyetik alan","@language":"tr"},{"@value":"intensidad de campo magnético","@language":"es"},{"@value":"intensidade de campo magnético","@language":"pt"},{"@value":"intensità di campo magnetico","@language":"it"},{"@value":"intensité de champ magnétique","@language":"fr"},{"@value":"jakost magnetnega polja","@language":"sl"},{"@value":"magnetische Feldstärke","@language":"de"},{"@value":"pole magnetyczne","@language":"pl"},{"@value":"Магнитное поле","@language":"ru"},{"@value":"حقل مغناطيسي","@language":"ar"},{"@value":"شدت میدان مغناطیسی","@language":"fa"},{"@value":"磁場","@language":"ja"},{"@value":"磁場","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPerLength"},{"@id":"http://qudt.org/vocab/quantitykind/LinearElectricCurrent"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFieldStrength_H","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Magnetic Field Strength}$ is a vector quantity obtained at a given point by subtracting the\n    magnetization $M$ from the magnetic flux density $B$ divided by the magnetic constant $\\mu_0$. The magnetic field strength is\n    related to the total current density $J_{tot}$ via: $\\text{rot} H = J_{tot}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFieldStrength"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD098","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-56","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD098","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mathbf{H} = \\frac{\\mathbf{B} }{\\mu_0} - M$, where $\\mathbf{B} $ is magnetic flux density, $\\mu_0$ is the magnetic constant and $M$ is magnetization.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mathbf{H} $","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/MAFD"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Câmp magnetic","@language":"ro"},{"@value":"Kekuatan medan magnetik","@language":"ms"},{"@value":"Magnetické pole","@language":"cs"},{"@value":"Manyetik alan","@language":"tr"},{"@value":"intensidad de campo magnético","@language":"es"},{"@value":"intensidade de campo magnético","@language":"pt"},{"@value":"intensità di campo magnetico","@language":"it"},{"@value":"intensité de champ magnétique","@language":"fr"},{"@value":"jakost magnetnega polja","@language":"sl"},{"@value":"magnetic field strength","@language":"en"},{"@value":"magnetische Feldstärke","@language":"de"},{"@value":"pole magnetyczne","@language":"pl"},{"@value":"Магнитное поле","@language":"ru"},{"@value":"حقل مغناطيسي","@language":"ar"},{"@value":"شدت میدان مغناطیسی","@language":"fa"},{"@value":"磁場","@language":"ja"},{"@value":"磁場","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPerLength"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFlux","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Magnetic Flux\" is the product of the average magnetic field times the perpendicular area that it\n    penetrates.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloLB_F-FT-PER-A"},{"@id":"http://qudt.org/vocab/unit/KiloWB"},{"@id":"http://qudt.org/vocab/unit/MX"},{"@id":"http://qudt.org/vocab/unit/MilliWB"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-A"},{"@id":"http://qudt.org/vocab/unit/UnitPole"},{"@id":"http://qudt.org/vocab/unit/V_Ab-SEC"},{"@id":"http://qudt.org/vocab/unit/WB"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Magnetic_flux","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ229#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$magnetic-flux$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD099","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.oxfordreference.com/display/10.1093/acref/9780199233991.001.0001/acref-9780199233991-e-1800","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD099","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\Phi = \\int_S B \\cdot e_n d A$, over a surface $S$, where $B$ is magnetic flux density and $e_n dA$ is the vector surface element.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Phi$","@type":"http://qudt.org/schema/qudt/LatexString"},{"@value":"$\\phi$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Magnetic Flux\" is the product of the average magnetic field times the perpendicular area that it\n    penetrates.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q177831"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticFlux","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Fluks magnet","@language":"ms"},{"@value":"Flux d'induction magnétique","@language":"fr"},{"@value":"Magnetic Flux","@language":"en"},{"@value":"Magnetický tok","@language":"cs"},{"@value":"flujo magnético","@language":"es"},{"@value":"flusso magnetico","@language":"it"},{"@value":"flux de inducție magnetică","@language":"ro"},{"@value":"fluxo magnético","@language":"pt"},{"@value":"fluxus magneticus","@language":"la"},{"@value":"magnetischer Flux","@language":"de"},{"@value":"magnetni pretok","@language":"sl"},{"@value":"manyetik akı","@language":"tr"},{"@value":"mágneses fluxus","@language":"hu"},{"@value":"strumień magnetyczny","@language":"pl"},{"@value":"Магнитен поток","@language":"bg"},{"@value":"Магнитный поток","@language":"ru"},{"@value":"שטף מגנטי","@language":"he"},{"@value":"التدفق المغناطيسي","@language":"ar"},{"@value":"شار مغناطیسی","@language":"fa"},{"@value":"चुम्बकीय बहाव","@language":"hi"},{"@value":"磁束","@language":"ja"},{"@value":"磁通量","@language":"zh"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Magnetic Flux Density\" is a vector quantity and is the magnetic flux per unit area of a magnetic field\n    at right angles to the magnetic force. It can be defined in terms of the effects the field has, for example by $B = F/q v\n    \\sin \\theta$, where $F$ is the force a moving charge $q$ would experience if it was travelling at a velocity $v$ in a\n    direction making an angle θ with that of the field. The magnetic field strength is also a vector quantity and is related to\n    $B$ by: $H = B/\\mu$, where $\\mu$ is the permeability of the medium.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/GAMMA"},{"@id":"http://qudt.org/vocab/unit/GAUSS"},{"@id":"http://qudt.org/vocab/unit/KiloGAUSS"},{"@id":"http://qudt.org/vocab/unit/KiloT"},{"@id":"http://qudt.org/vocab/unit/MicroT"},{"@id":"http://qudt.org/vocab/unit/MilliT"},{"@id":"http://qudt.org/vocab/unit/NanoT"},{"@id":"http://qudt.org/vocab/unit/T"},{"@id":"http://qudt.org/vocab/unit/T_Ab"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD100","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.oxfordreference.com/display/10.1093/acref/9780199233991.001.0001/acref-9780199233991-e-1798","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD100","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mathbf{F}  = qv \\times B$, where $F$ is force and $v$ is velocity of any test particle with electric charge $q$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"vektorielle Feldgröße B, die auf jedes geladene Teilchen, das eine Geschwindigkeit v hat, eine\n    Kraft F ausübt, die gleich dem Produkt aus dem Vektorprodukt v x B und der elektrischen Ladung Q des Teilchens ist oder\n    vektorielle Größe gleich dem Produkt aus der Magnetisierung M und der magnetischen Feldkonstante µ₀\n  ","@language":"de"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"B","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q30204"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticFluxDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Densidad de flujo magnético","@language":"es"},{"@value":"Densité de flux magnétique","@language":"fr"},{"@value":"Ketumpatan fluks magnet","@language":"ms"},{"@value":"Magnetic Flux Density","@language":"en"},{"@value":"Magnetic Flux Density","@language":"en-us"},{"@value":"Magnetická indukce","@language":"cs"},{"@value":"densidade de fluxo magnético","@language":"pt"},{"@value":"densitas fluxus magnetici","@language":"la"},{"@value":"densità di flusso magnetico","@language":"it"},{"@value":"gostota magnetnega pretoka","@language":"sl"},{"@value":"inducție magnetică","@language":"ro"},{"@value":"indukcja magnetyczna","@language":"pl"},{"@value":"magnetische Flussdichte","@language":"de"},{"@value":"manyetik akı yoğunluğu","@language":"tr"},{"@value":"mágneses indukció","@language":"hu"},{"@value":"Магнитна индукция","@language":"bg"},{"@value":"Магнитная индукция","@language":"ru"},{"@value":"צפיפות שטף מגנטי","@language":"he"},{"@value":"المجال المغناطيسي","@language":"ar"},{"@value":"چگالی شار مغناطیسی","@language":"fa"},{"@value":"चुम्बकीय क्षेत्र","@language":"hi"},{"@value":"磁束密度","@language":"ja"},{"@value":"磁通量密度","@language":"zh"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticField"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Magnetic Polarization","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"inducción magnética","@language":"es"},{"@value":"magnetische Induktion","@language":"de"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensityOrMagneticPolarization","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"field vector B which exhibits a force F on any charged particle which has a velocity v, where the force\n    is the product of the vector product v x B and the electric charge Q of the particle or vector quantity equal to the product\n    of the magnetization M and the magnetic constant µ₀\n  ","@language":"en"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensity"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.4","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ221#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"vektorielle Feldgröße B, die auf jedes geladene Teilchen, das eine Geschwindigkeit v hat, eine\n    Kraft F ausübt, die gleich dem Produkt aus dem Vektorprodukt v x B und der elektrischen Ladung Q des Teilchens ist oder\n    vektorielle Größe gleich dem Produkt aus der Magnetisierung M und der magnetischen Feldkonstante µ₀\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"magnetic flux density or magnetic polarization","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxPerLength","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Magnetic Flux per Length\" is a quantity in the SI and C.G.S. Systems of Quantities.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/N-PER-A"},{"@id":"http://qudt.org/vocab/unit/T-M"},{"@id":"http://qudt.org/vocab/unit/V-SEC-PER-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Magnetic Flux per Length\" is a quantity in the SI and C.G.S. Systems of Quantities.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-2D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticFluxPerLength","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Magnetic Flux per Length","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagneticMoment","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Magnetic Moment\", for a magnetic dipole, is a vector quantity equal to the product of the current, the\n    loop area, and the unit vector normal to the loop plane, the direction of which corresponds to the loop orientation. \"Magnetic\n    Moment\" is also referred to as \"Magnetic Area Moment\", and is not to be confused with Magnetic Dipole Moment.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-M2"},{"@id":"http://qudt.org/vocab/unit/A_Ab-CentiM2"},{"@id":"http://qudt.org/vocab/unit/EV-PER-T"},{"@id":"http://qudt.org/vocab/unit/J-PER-T"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ244#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticAreaMoment"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD097","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"0112/2///62720#UAD101","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-49","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD097","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD101","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://www.simetric.co.uk/siderived.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$m = I e_n A$, where $I$ is electric current in a small closed loop, $e_n$ is a unit vector perpendicular to the loop, and $A$ is the area of the loop. The magnetic moment of a substance within a domain is the vector sum of the magnetic moments of all entities included in the domain.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Magnetic Moment\", for a magnetic dipole, is a vector quantity equal to the product of the current,\n    the loop area, and the unit vector normal to the loop plane, the direction of which corresponds to the loop orientation.\n    \"Magnetic Moment\" is also referred to as \"Magnetic Area Moment\", and is not to be confused with Magnetic Dipole Moment.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q242657"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticMoment","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Magnetic Moment","@language":"en"},{"@value":"Magnetický dipól","@language":"cs"},{"@value":"Manyetik moment","@language":"tr"},{"@value":"Momen magnetik","@language":"ms"},{"@value":"dipol magnetyczny","@language":"pl"},{"@value":"magnetisches Dipolmoment","@language":"de"},{"@value":"moment magnétique","@language":"fr"},{"@value":"momento de dipolo magnético","@language":"es"},{"@value":"momento de dipolo magnético","@language":"pt"},{"@value":"momento di dipolo magnetico","@language":"it"},{"@value":"Магнитный момент","@language":"ru"},{"@value":"دوقطبی مغناطیسی","@language":"fa"},{"@value":"عزم مغناطيسي","@language":"ar"},{"@value":"चुम्बकीय द्विध्रुव","@language":"hi"},{"@value":"磁偶极","@language":"zh"},{"@value":"磁気双極子","@language":"ja"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"giromagnetic moment","@language":"en"},{"@value":"momen giromagnetik","@language":"ms"},{"@value":"moment giromagnétique","@language":"fr"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagneticPolarization","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\text{Magnetic Polarization}$ is a vector quantity equal to the product of the magnetization $M$ and\n    the magnetic constant $\\mu_0$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/GAUSS"},{"@id":"http://qudt.org/vocab/unit/T"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD102","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-54","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD102","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$J_m = \\mu_0 M$,  where $\\mu_0$ is the magentic constant and $M$ is magnetization.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$J_m$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1884336"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticPolarization","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Magnetic Polarization","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/constant/MagneticConstant"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFieldStrength"},{"@id":"http://qudt.org/vocab/quantitykind/Magnetization"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagneticQuantumNumber","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Magnetic Quantum Number\" describes the specific orbital (or \"cloud\") within that subshell, and\n    yields the projection of the orbital angular momentum along a specified axis.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Quantum_number","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/QuantumNumber"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Magnetic Quantum Number\" describes the specific orbital (or \"cloud\") within that subshell, and\n    yields the projection of the orbital angular momentum along a specified axis.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q2009727"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticQuantumNumber","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Magnetic Quantum Number","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/QuantumNumber"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://qudt.org/vocab/quantitykind/OrbitalAngularMomentumQuantumNumber"},{"@id":"http://qudt.org/vocab/quantitykind/PrincipalQuantumNumber"},{"@id":"http://qudt.org/vocab/quantitykind/SpinQuantumNumber"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagneticReluctivity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Length Per Unit Magnetic Flux\" is the the resistance of a material to the establishment of a magnetic\n    field in it. It is the reciprocal of $\\textit{Magnetic Permeability}$, the inverse of the measure of the ability of a\n    material to support the formation of a magnetic field within itself.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/M-PER-V-SEC"},{"@id":"http://qudt.org/vocab/unit/PER-T-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-1I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Permeability_(electromagnetism)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Length Per Unit Magnetic Flux is the the resistance of a material to the establishment of a\n    magnetic field in it. It is the reciprocal of Magnetic Permeability, the inverse of the measure of the ability of a material\n    to support the formation of a magnetic field within itself.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticReluctivity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Magnetic Reluctivity","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ElectromagneticPermeability"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagneticSusceptability","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Magnetic Susceptability\" is a scalar or tensor quantity the product of which by the magnetic constant\n    $\\mu_0$ and by the magnetic field strength $H$ is equal to the magnetic polarization $J$. The definition given applies to an\n    isotropic medium. For an anisotropic medium permeability is a second order tensor.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/SUSCEPTIBILITY_MAG"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$\\kappa = \\frac{M}{H}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-12-37","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\kappa = \\frac{M}{H}$,  where $M$ is magnetization,  and $H$ is magnetic field strength.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\kappa$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticSusceptability","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Magnetic Susceptability","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/constant/MagneticConstant"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFieldStrength"},{"@id":"http://qudt.org/vocab/quantitykind/Magnetization"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagneticTension","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Magnetic Tension\" is a scalar quantity equal to the line integral of the magnetic field strength\n    $\\mathbf{H}$ along a specified path linking two points a and b.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A"},{"@id":"http://qudt.org/vocab/unit/AttoA"},{"@id":"http://qudt.org/vocab/unit/FemtoA"},{"@id":"http://qudt.org/vocab/unit/GigaA"},{"@id":"http://qudt.org/vocab/unit/PetaA"},{"@id":"http://qudt.org/vocab/unit/TeraA"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-57","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$U_m = \\int_{r_a(C)}^{r_b} \\mathbf{H} \\cdot dr$, where $\\mathbf{H}$ is magnetic field strength and $r$ is the position vector along a given curve $C$ from point $a$ to point $b$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrent"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Magnetic Tension is a scalar quantity equal to the line integral of the magnetic field strength H\n    along a specified path linking two points a and b.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"U_m","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q77993836"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticTension","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Magnetic Tension","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFieldStrength"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrent"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagneticVectorPotential","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Magnetic Vector Potential\" is the vector potential of the magnetic flux density. The magnetic vector\n    potential is not unique since any irrotational vector field quantity can be added to a given magnetic vector potential without\n    changing its rotation. Under static conditions the magnetic vector potential is often chosen so that its divergence is zero.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloWB-PER-M"},{"@id":"http://qudt.org/vocab/unit/V-SEC-PER-M"},{"@id":"http://qudt.org/vocab/unit/WB-PER-M"},{"@id":"http://qudt.org/vocab/unit/WB-PER-MilliM"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ340#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD103","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-23","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD103","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$B = \\text{rot} A$, where $B$ is magnetic flux density.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Magnetic Vector Potential\" is the vector potential of the magnetic flux density. The magnetic\n    vector potential is not unique since any irrotational vector field quantity can be added to a given magnetic vector potential\n    without changing its rotation. Under static conditions the magnetic vector potential is often chosen so that its divergence is\n    zero.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"A","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q2299100"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticVectorPotential","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Keupayaan vektor magnetik","@language":"ms"},{"@value":"Magnetic Vector Potential","@language":"en"},{"@value":"magnetický potenciál","@language":"cs"},{"@value":"magnetisches Potenzial","@language":"de"},{"@value":"manyetik potansiyeli","@language":"tr"},{"@value":"potencial magnético","@language":"es"},{"@value":"potencial magnético","@language":"pt"},{"@value":"potencjał magnetyczny","@language":"pl"},{"@value":"potentiel magnétique","@language":"fr"},{"@value":"potenziale vettore magnetico","@language":"it"},{"@value":"potențial magnetic","@language":"ro"},{"@value":"Магнитний потенциал","@language":"ru"},{"@value":"پتانسیل برداری مغناطیسی","@language":"fa"},{"@value":"磁向量势","@language":"zh"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/Magnetization","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Magnetization\" is defined as the ratio of magnetic moment per unit volume. It is a vector-valued\n    quantity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/altSymbol":[{"@value":"H_i","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/A-PER-M"},{"@id":"http://qudt.org/vocab/unit/A-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/KiloA-PER-M"},{"@id":"http://qudt.org/vocab/unit/MilliA-PER-IN"},{"@id":"http://qudt.org/vocab/unit/MilliA-PER-MilliM"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/MagnetizationField"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-52","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$M = dm/dV$, where $m$ is magentic moment of a substance in a domain with Volume $V$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Magnetization\" is defined as the ratio of magnetic moment per unit volume. It is a vector-valued\n    quantity.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPerLength"},{"@id":"http://qudt.org/vocab/quantitykind/LinearElectricCurrent"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"M","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q856711"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearElectricCurrentDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Magnetisierung","@language":"de"},{"@value":"Magnetization","@language":"en"},{"@value":"aimantation","@language":"fr"},{"@value":"magnetización","@language":"es"},{"@value":"magnetização","@language":"pt"},{"@value":"magnetizzazione","@language":"it"},{"@value":"magnetyzacia","@language":"pl"},{"@value":"намагниченность","@language":"ru"},{"@value":"مغنطة","@language":"ar"},{"@value":"磁化","@language":"ja"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPerLength"},{"@id":"http://qudt.org/vocab/quantitykind/LinearElectricCurrent"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagnetizationField","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The Magnetization Field is defined as the ratio of magnetic moment per unit volume. It is a vector-valued\n    quantity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/A-PER-M"},{"@id":"http://qudt.org/vocab/unit/A-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/KiloA-PER-M"},{"@id":"http://qudt.org/vocab/unit/MilliA-PER-IN"},{"@id":"http://qudt.org/vocab/unit/MilliA-PER-MilliM"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/Magnetization"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The Magnetization Field is defined as the ratio of magnetic moment per unit volume. It is a\n    vector-valued quantity.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPerLength"},{"@id":"http://qudt.org/vocab/quantitykind/LinearElectricCurrent"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"M","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearElectricCurrentDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Magnetization Field","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPerLength"},{"@id":"http://qudt.org/vocab/quantitykind/LinearElectricCurrent"}]},{"@id":"http://qudt.org/vocab/quantitykind/MagnetomotiveForce","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\n$\\text{Magnetomotive Force}$, also referred to as ($mmf$), is the ability of an electric circuit to produce magnetic flux. \n  Just as the ability of a battery to produce electric current is called its electromotive force \n  or emf, mmf is taken as the work required to move a unit magnet pole from any point through any path \n  which links the electric circuit back the same point in the presence of the magnetic force produced \n  by the electric current in the circuit. \n$\\text{Magnetomotive Force}$ is the scalar line integral of the magnetic field strength along a closed path.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AT"},{"@id":"http://qudt.org/vocab/unit/GI"},{"@id":"http://qudt.org/vocab/unit/OERSTED-CentiM"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Magnetomotive_force","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD414","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-60","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD414","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$F_m = \\oint \\mathbf{H} \\cdot dr$, where $\\mathbf{H}$ is magnetic field strength and $r$ is position vector along a given curve $C$ from point $a$ to point $b$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$F_m $","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1266982"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagnetomotiveForce","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Magnetomotive Force","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFieldStrength"}]},{"@id":"http://qudt.org/vocab/quantitykind/Mass","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In physics, mass, more specifically inertial mass, can be defined as a quantitative measure of an\n    object's resistance to acceleration. The SI unit of mass is the kilogram ($kg$)\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AMU"},{"@id":"http://qudt.org/vocab/unit/CARAT"},{"@id":"http://qudt.org/vocab/unit/CWT_LONG"},{"@id":"http://qudt.org/vocab/unit/CWT_SHORT"},{"@id":"http://qudt.org/vocab/unit/CentiGM"},{"@id":"http://qudt.org/vocab/unit/DRAM_UK"},{"@id":"http://qudt.org/vocab/unit/DRAM_US"},{"@id":"http://qudt.org/vocab/unit/DWT"},{"@id":"http://qudt.org/vocab/unit/DecaGM"},{"@id":"http://qudt.org/vocab/unit/DeciGM"},{"@id":"http://qudt.org/vocab/unit/DeciTONNE"},{"@id":"http://qudt.org/vocab/unit/DeciTON_Metric"},{"@id":"http://qudt.org/vocab/unit/EarthMass"},{"@id":"http://qudt.org/vocab/unit/FemtoGM"},{"@id":"http://qudt.org/vocab/unit/GM"},{"@id":"http://qudt.org/vocab/unit/GM_Carbon"},{"@id":"http://qudt.org/vocab/unit/GM_DRY"},{"@id":"http://qudt.org/vocab/unit/GM_Nitrogen"},{"@id":"http://qudt.org/vocab/unit/GRAIN"},{"@id":"http://qudt.org/vocab/unit/HectoGM"},{"@id":"http://qudt.org/vocab/unit/Hundredweight_UK"},{"@id":"http://qudt.org/vocab/unit/Hundredweight_US"},{"@id":"http://qudt.org/vocab/unit/KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloLB"},{"@id":"http://qudt.org/vocab/unit/KiloTONNE"},{"@id":"http://qudt.org/vocab/unit/KiloTON_Metric"},{"@id":"http://qudt.org/vocab/unit/LB"},{"@id":"http://qudt.org/vocab/unit/LB_M"},{"@id":"http://qudt.org/vocab/unit/LB_T"},{"@id":"http://qudt.org/vocab/unit/LunarMass"},{"@id":"http://qudt.org/vocab/unit/MOMME_Pearl"},{"@id":"http://qudt.org/vocab/unit/MOMME_Textile"},{"@id":"http://qudt.org/vocab/unit/MegaGM"},{"@id":"http://qudt.org/vocab/unit/MegaTON"},{"@id":"http://qudt.org/vocab/unit/MegaTONNE"},{"@id":"http://qudt.org/vocab/unit/MicroGM"},{"@id":"http://qudt.org/vocab/unit/MilliGM"},{"@id":"http://qudt.org/vocab/unit/NanoGM"},{"@id":"http://qudt.