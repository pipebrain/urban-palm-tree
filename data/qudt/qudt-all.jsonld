dt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q81809"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ForcePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Atmospheric Pressure","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Pressure"}]},{"@id":"http://qudt.org/vocab/quantitykind/AtomScatteringFactor","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Atom Scattering Factor\" is measure of the scattering power of an isolated atom.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://reference.iucr.org/dictionary/Atomic_scattering_factor","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$f = \\frac{E_a}{E_e}$, where $E_a$ is the radiation amplitude scattered by the atom and $E_e$ is the radiation ampliture scattered by a single electron.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Atom Scattering Factor\" is measure of the scattering power of an isolated atom.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"f","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q837866"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AtomScatteringFactor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Atom Scattering Factor","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/AtomicAttenuationCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Atomic Attenuation Coefficient\" is a measurement of how strongly a chemical species or substance absorbs\n    or scatters light at a given wavelength, per the number of atoms in the substance.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AC"},{"@id":"http://qudt.org/vocab/unit/ARE"},{"@id":"http://qudt.org/vocab/unit/BARN"},{"@id":"http://qudt.org/vocab/unit/CentiM2"},{"@id":"http://qudt.org/vocab/unit/DecaARE"},{"@id":"http://qudt.org/vocab/unit/DeciM2"},{"@id":"http://qudt.org/vocab/unit/FT2"},{"@id":"http://qudt.org/vocab/unit/HA"},{"@id":"http://qudt.org/vocab/unit/IN2"},{"@id":"http://qudt.org/vocab/unit/KiloM2"},{"@id":"http://qudt.org/vocab/unit/KiloMIL_Circ"},{"@id":"http://qudt.org/vocab/unit/M2"},{"@id":"http://qudt.org/vocab/unit/MI2"},{"@id":"http://qudt.org/vocab/unit/MIL_Circ"},{"@id":"http://qudt.org/vocab/unit/MI_US2"},{"@id":"http://qudt.org/vocab/unit/MicroM2"},{"@id":"http://qudt.org/vocab/unit/MilliM2"},{"@id":"http://qudt.org/vocab/unit/NanoM2"},{"@id":"http://qudt.org/vocab/unit/PIXEL_AREA"},{"@id":"http://qudt.org/vocab/unit/PlanckArea"},{"@id":"http://qudt.org/vocab/unit/YD2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Attenuation_coefficient","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mu_a = -\\frac{\\mu}{n}$, where $\\mu$ is the linear attenuation coefficient and $n$ is the number density of the atoms in the substance.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Atomic Attenuation Coefficient\" is a measurement of how strongly a chemical species or substance\n    absorbs or scatters light at a given wavelength, per the number of atoms in the substance.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Area"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"μₐ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98592911"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Area","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Atomic Attenuation Coefficient","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Area"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://qudt.org/vocab/quantitykind/MolarAttenuationCoefficient"}]},{"@id":"http://qudt.org/vocab/quantitykind/AtomicCharge","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The electric charge of an ion, equal to the number of electrons the atom has gained or lost in its\n    ionization multiplied by the charge on one electron.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-HR"},{"@id":"http://qudt.org/vocab/unit/A-SEC"},{"@id":"http://qudt.org/vocab/unit/AttoC"},{"@id":"http://qudt.org/vocab/unit/C"},{"@id":"http://qudt.org/vocab/unit/C_Ab"},{"@id":"http://qudt.org/vocab/unit/C_Stat"},{"@id":"http://qudt.org/vocab/unit/CentiC"},{"@id":"http://qudt.org/vocab/unit/DecaC"},{"@id":"http://qudt.org/vocab/unit/DeciC"},{"@id":"http://qudt.org/vocab/unit/E"},{"@id":"http://qudt.org/vocab/unit/ElementaryCharge"},{"@id":"http://qudt.org/vocab/unit/ExaC"},{"@id":"http://qudt.org/vocab/unit/F"},{"@id":"http://qudt.org/vocab/unit/FR"},{"@id":"http://qudt.org/vocab/unit/FemtoC"},{"@id":"http://qudt.org/vocab/unit/GigaC"},{"@id":"http://qudt.org/vocab/unit/HectoC"},{"@id":"http://qudt.org/vocab/unit/KiloA-HR"},{"@id":"http://qudt.org/vocab/unit/KiloC"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-KiloV"},{"@id":"http://qudt.org/vocab/unit/MegaC"},{"@id":"http://qudt.org/vocab/unit/MicroC"},{"@id":"http://qudt.org/vocab/unit/MilliA-HR"},{"@id":"http://qudt.org/vocab/unit/MilliA-SEC"},{"@id":"http://qudt.org/vocab/unit/MilliC"},{"@id":"http://qudt.org/vocab/unit/NanoC"},{"@id":"http://qudt.org/vocab/unit/PetaC"},{"@id":"http://qudt.org/vocab/unit/PicoC"},{"@id":"http://qudt.org/vocab/unit/PlanckCharge"},{"@id":"http://qudt.org/vocab/unit/TeraC"},{"@id":"http://qudt.org/vocab/unit/YoctoC"},{"@id":"http://qudt.org/vocab/unit/YottaC"},{"@id":"http://qudt.org/vocab/unit/ZeptoC"},{"@id":"http://qudt.org/vocab/unit/ZettaC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.answers.com/topic/atomic-charge","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The electric charge of an ion, equal to the number of electrons the atom has gained or lost in its\n    ionization multiplied by the charge on one electron.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCharge"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricCharge","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Atomic Charge","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCharge"}]},{"@id":"http://qudt.org/vocab/quantitykind/AtomicEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"scalar quantity of elementary particles which is retained within a system following any change and, as\n    saved energy, constitutes the capability of a physical system to carry out work\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AttoJ"},{"@id":"http://qudt.org/vocab/unit/BTU_IT"},{"@id":"http://qudt.org/vocab/unit/BTU_TH"},{"@id":"http://qudt.org/vocab/unit/CAL_IT"},{"@id":"http://qudt.org/vocab/unit/CAL_TH"},{"@id":"http://qudt.org/vocab/unit/ERG"},{"@id":"http://qudt.org/vocab/unit/EV"},{"@id":"http://qudt.org/vocab/unit/E_h"},{"@id":"http://qudt.org/vocab/unit/ExaJ"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F_Energy"},{"@id":"http://qudt.org/vocab/unit/FT-PDL"},{"@id":"http://qudt.org/vocab/unit/FemtoJ"},{"@id":"http://qudt.org/vocab/unit/GigaEV"},{"@id":"http://qudt.org/vocab/unit/GigaJ"},{"@id":"http://qudt.org/vocab/unit/GigaW-HR"},{"@id":"http://qudt.org/vocab/unit/J"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH"},{"@id":"http://qudt.org/vocab/unit/KiloCAL"},{"@id":"http://qudt.org/vocab/unit/KiloEV"},{"@id":"http://qudt.org/vocab/unit/KiloJ"},{"@id":"http://qudt.org/vocab/unit/KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT"},{"@id":"http://qudt.org/vocab/unit/MegaEV"},{"@id":"http://qudt.org/vocab/unit/MegaJ"},{"@id":"http://qudt.org/vocab/unit/MegaTOE"},{"@id":"http://qudt.org/vocab/unit/MegaW-HR"},{"@id":"http://qudt.org/vocab/unit/MicroJ"},{"@id":"http://qudt.org/vocab/unit/MilliJ"},{"@id":"http://qudt.org/vocab/unit/NanoJ"},{"@id":"http://qudt.org/vocab/unit/PetaJ"},{"@id":"http://qudt.org/vocab/unit/PicoJ"},{"@id":"http://qudt.org/vocab/unit/PlanckEnergy"},{"@id":"http://qudt.org/vocab/unit/QUAD"},{"@id":"http://qudt.org/vocab/unit/THERM_EC"},{"@id":"http://qudt.org/vocab/unit/THERM_US"},{"@id":"http://qudt.org/vocab/unit/THM_EEC"},{"@id":"http://qudt.org/vocab/unit/THM_US"},{"@id":"http://qudt.org/vocab/unit/TOE"},{"@id":"http://qudt.org/vocab/unit/TeraJ"},{"@id":"http://qudt.org/vocab/unit/TeraW-HR"},{"@id":"http://qudt.org/vocab/unit/TonEnergy"},{"@id":"http://qudt.org/vocab/unit/W-HR"},{"@id":"http://qudt.org/vocab/unit/W-SEC"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ291#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"skalare Größe von Elementarteilchen, die bei beliebiger Umwandlung innerhalb eines Systems erhalten\n    bleibt und als gespeichertes Arbeitsvermögen die Fähigkeit eines physikalischen Systems darstellt, Arbeit zu verrichten\n  ","@language":"de"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Energy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Atomic Energy","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}]},{"@id":"http://qudt.org/vocab/quantitykind/AtomicMass","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Atomic Mass\" is the mass of a specific isotope, most often expressed in unified atomic mass units.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AMU"},{"@id":"http://qudt.org/vocab/unit/CARAT"},{"@id":"http://qudt.org/vocab/unit/CWT_LONG"},{"@id":"http://qudt.org/vocab/unit/CWT_SHORT"},{"@id":"http://qudt.org/vocab/unit/CentiGM"},{"@id":"http://qudt.org/vocab/unit/DRAM_UK"},{"@id":"http://qudt.org/vocab/unit/DRAM_US"},{"@id":"http://qudt.org/vocab/unit/DWT"},{"@id":"http://qudt.org/vocab/unit/DecaGM"},{"@id":"http://qudt.org/vocab/unit/DeciGM"},{"@id":"http://qudt.org/vocab/unit/DeciTONNE"},{"@id":"http://qudt.org/vocab/unit/DeciTON_Metric"},{"@id":"http://qudt.org/vocab/unit/EarthMass"},{"@id":"http://qudt.org/vocab/unit/FemtoGM"},{"@id":"http://qudt.org/vocab/unit/GM"},{"@id":"http://qudt.org/vocab/unit/GM_Carbon"},{"@id":"http://qudt.org/vocab/unit/GM_DRY"},{"@id":"http://qudt.org/vocab/unit/GM_Nitrogen"},{"@id":"http://qudt.org/vocab/unit/GRAIN"},{"@id":"http://qudt.org/vocab/unit/HectoGM"},{"@id":"http://qudt.org/vocab/unit/Hundredweight_UK"},{"@id":"http://qudt.org/vocab/unit/Hundredweight_US"},{"@id":"http://qudt.org/vocab/unit/KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloLB"},{"@id":"http://qudt.org/vocab/unit/KiloTONNE"},{"@id":"http://qudt.org/vocab/unit/KiloTON_Metric"},{"@id":"http://qudt.org/vocab/unit/LB"},{"@id":"http://qudt.org/vocab/unit/LB_M"},{"@id":"http://qudt.org/vocab/unit/LB_T"},{"@id":"http://qudt.org/vocab/unit/LunarMass"},{"@id":"http://qudt.org/vocab/unit/MOMME_Pearl"},{"@id":"http://qudt.org/vocab/unit/MOMME_Textile"},{"@id":"http://qudt.org/vocab/unit/MegaGM"},{"@id":"http://qudt.org/vocab/unit/MegaTON"},{"@id":"http://qudt.org/vocab/unit/MegaTONNE"},{"@id":"http://qudt.org/vocab/unit/MicroGM"},{"@id":"http://qudt.org/vocab/unit/MilliGM"},{"@id":"http://qudt.org/vocab/unit/NanoGM"},{"@id":"http://qudt.org/vocab/unit/OZ"},{"@id":"http://qudt.org/vocab/unit/OZ_M"},{"@id":"http://qudt.org/vocab/unit/OZ_TROY"},{"@id":"http://qudt.org/vocab/unit/PENNYWEIGHT"},{"@id":"http://qudt.org/vocab/unit/PFUND"},{"@id":"http://qudt.org/vocab/unit/PicoGM"},{"@id":"http://qudt.org/vocab/unit/PlanckMass"},{"@id":"http://qudt.org/vocab/unit/Quarter_UK"},{"@id":"http://qudt.org/vocab/unit/SLUG"},{"@id":"http://qudt.org/vocab/unit/SolarMass"},{"@id":"http://qudt.org/vocab/unit/Stone_UK"},{"@id":"http://qudt.org/vocab/unit/TON"},{"@id":"http://qudt.org/vocab/unit/TONNE"},{"@id":"http://qudt.org/vocab/unit/TON_Assay"},{"@id":"http://qudt.org/vocab/unit/TON_LONG"},{"@id":"http://qudt.org/vocab/unit/TON_Metric"},{"@id":"http://qudt.org/vocab/unit/TON_SHORT"},{"@id":"http://qudt.org/vocab/unit/TON_UK"},{"@id":"http://qudt.org/vocab/unit/TON_US"},{"@id":"http://qudt.org/vocab/unit/U"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Atomic_mass","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Atomic Mass\" is the mass of a specific isotope, most often expressed in unified atomic mass\n    units.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m_a","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q3840065"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Mass","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Atomic Mass","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}]},{"@id":"http://qudt.org/vocab/quantitykind/AtomicNumber","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Atomic Number\", also known as the proton number, is the number of protons found in the nucleus of an\n    atom and therefore identical to the charge number of the nucleus. A nuclide is a species of atom with specified numbers of\n    protons and neutrons. Nuclides with the same value of Z but different values of N are called isotopes of an element. The\n    ordinal number of an element in the periodic table is equal to the atomic number. The atomic number equals the charge of the\n    nucleus in units of the elementary charge.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/Z"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Atomic_number","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Count"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Atomic Number\", also known as the proton number, is the number of protons found in the nucleus\n    of an atom and therefore identical to the charge number of the nucleus. A nuclide is a species of atom with specified numbers\n    of protons and neutrons. Nuclides with the same value of Z but different values of N are called isotopes of an element. The\n    ordinal number of an element in the periodic table is equal to the atomic number. The atomic number equals the charge of the\n    nucleus in units of the elementary charge.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Z","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q23809"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AtomicNumber","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Atomic Number","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Count"}]},{"@id":"http://qudt.org/vocab/quantitykind/AtomicStoppingPower","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio of the linear stopping power to the number density of the atoms in the medium","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/EV-M2"},{"@id":"http://qudt.org/vocab/unit/J-M2"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ292#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/TotalAtomicStoppingPower"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L4I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient aus dem linearen Bremsvermögen und der Anzahldichte der Atome in dem Medium","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AtomicStoppingPower","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Atomic Stopping Power","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/AttenuationCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The attenuation coefficient is a quantity that characterizes how easily a material or medium can be\n    penetrated by a beam of light, sound, particles, or other energy or matter. A large attenuation coefficient means that the\n    beam is quickly \"attenuated\" (weakened) as it passes through the medium, and a small attenuation coefficient means that the\n    medium is relatively transparent to the beam. The Attenuation Coefficient is also called linear attenuation coefficient,\n    narrow beam attenuation coefficient, or absorption coefficient.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PER-KiloM"},{"@id":"http://qudt.org/vocab/unit/PER-M"},{"@id":"http://qudt.org/vocab/unit/PER-MicroM"},{"@id":"http://qudt.org/vocab/unit/PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/PER-NanoM"},{"@id":"http://qudt.org/vocab/unit/PER-PicoM"},{"@id":"http://qudt.org/vocab/unit/PERCENT-PER-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Attenuation_coefficient","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$F(x) = Ae^{-\\alpha x} \\cos{[\\beta (x - x_0)]}$, then $\\alpha$ is the attenuation coefficient and $\\beta$ is the phase coefficient.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\alpha$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The attenuation coefficient is a quantity that characterizes how easily a material or medium can be\n    penetrated by a beam of light, sound, particles, or other energy or matter. A large attenuation coefficient means that the\n    beam is quickly \"attenuated\" (weakened) as it passes through the medium, and a small attenuation coefficient means that the\n    medium is relatively transparent to the beam. The Attenuation Coefficient is also called linear attenuation coefficient,\n    narrow beam attenuation coefficient, or absorption coefficient.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q902086"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"belongs to SOQ-ISO","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AttenuationCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Attenuation Coefficient","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/AuditoryThresholds","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Auditory Thresholds\" is the thresholds of sensitivity to auditory signals and other input to the ear or\n    the sense of hearing.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/B"},{"@id":"http://qudt.org/vocab/unit/DeciB"},{"@id":"http://qudt.org/vocab/unit/DeciB_A"},{"@id":"http://qudt.org/vocab/unit/DeciB_ISO"},{"@id":"http://qudt.org/vocab/unit/DeciB_M"},{"@id":"http://qudt.org/vocab/unit/DeciB_Z"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\overline{T_a}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Auditory Thresholds\" is the thresholds of sensitivity to auditory signals and other input to the\n    ear or the sense of hearing.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SoundPowerLevel"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SoundPowerLevel","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Auditory Thresholds","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SoundPowerLevel"}]},{"@id":"http://qudt.org/vocab/quantitykind/AuxillaryMagneticField","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Magnetic Fields surround magnetic materials and electric currents and are detected by the force they\n    exert on other magnetic materials and moving electric charges. The electric and magnetic fields are two interrelated aspects\n    of a single object, called the electromagnetic field. A pure electric field in one reference frame is observed as a\n    combination of both an electric field and a magnetic field in a moving reference frame. The Auxillary Magnetic Field, H\n    characterizes how the true Magnetic Field B influences the organization of magnetic dipoles in a given medium.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/A-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/AT-PER-IN"},{"@id":"http://qudt.org/vocab/unit/AT-PER-M"},{"@id":"http://qudt.org/vocab/unit/KiloA-PER-M"},{"@id":"http://qudt.org/vocab/unit/MilliA-PER-IN"},{"@id":"http://qudt.org/vocab/unit/MilliA-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/OERSTED"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"H","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Magnetic Fields surround magnetic materials and electric currents and are detected by the force\n    they exert on other magnetic materials and moving electric charges. The electric and magnetic fields are two interrelated\n    aspects of a single object, called the electromagnetic field. A pure electric field in one reference frame is observed as a\n    combination of both an electric field and a magnetic field in a moving reference frame. The Auxillary Magnetic Field, H\n    characterizes how the true Magnetic Field B influences the organization of magnetic dipoles in a given medium.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFieldStrength"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticFieldStrength","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Auxillary Magnetic Field","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFieldStrength"}]},{"@id":"http://qudt.org/vocab/quantitykind/AverageEnergyLossPerElementaryChargeProduced","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Average Energy Loss per Elementary Charge Produced\" is also referred to as average energy loss per ion\n    pair formed.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AttoJ"},{"@id":"http://qudt.org/vocab/unit/BTU_IT"},{"@id":"http://qudt.org/vocab/unit/BTU_TH"},{"@id":"http://qudt.org/vocab/unit/CAL_IT"},{"@id":"http://qudt.org/vocab/unit/CAL_TH"},{"@id":"http://qudt.org/vocab/unit/ERG"},{"@id":"http://qudt.org/vocab/unit/EV"},{"@id":"http://qudt.org/vocab/unit/E_h"},{"@id":"http://qudt.org/vocab/unit/ExaJ"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F_Energy"},{"@id":"http://qudt.org/vocab/unit/FT-PDL"},{"@id":"http://qudt.org/vocab/unit/FemtoJ"},{"@id":"http://qudt.org/vocab/unit/GigaEV"},{"@id":"http://qudt.org/vocab/unit/GigaJ"},{"@id":"http://qudt.org/vocab/unit/GigaW-HR"},{"@id":"http://qudt.org/vocab/unit/J"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH"},{"@id":"http://qudt.org/vocab/unit/KiloCAL"