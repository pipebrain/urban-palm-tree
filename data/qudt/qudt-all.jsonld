":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/KiloGM"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"lbm","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[lb_av]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/udunitsCode":[{"@value":"lb","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"LBR","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pound Mass","@language":"en"},{"@value":"Pound Mass","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/LB_T","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"An obsolete unit of mass; the Troy Pound has been defined as exactly 5760 grains, or 0.3732417216 kg. A\n    Troy Ounce is 1/12th of a Troy Pound.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.3732417216","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"3.732417216E-1","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB197","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB197","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/KiloGM"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"lbt","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[lb_tr]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"LBT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q39617818"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pound Troy","@language":"en"},{"@value":"Pound Troy","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/LM","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The SI unit for measuring the flux of light being produced by a light source or received by a surface.\n    The intensity of a light source is measured in candelas. One lumen represents the total flux of light emitted, equal to the\n    intensity in candelas multiplied by the solid angle in steradians into which the light is emitted. A full sphere has a solid\n    angle of $4\\cdot\\pi$ steradians. A light source that uniformly radiates one candela in all directions has a total luminous\n    flux of $1 cd\\cdot 4 \\pi sr = 4 \\pi cd \\cdot sr \\approx 12.57 \\; \\text{lumens}$. \"Lumen\" is a Latin word for light.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Lumen","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I1M0H0T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2820"},{"@id":"_:n3-2821"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LuminousFlux"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA718","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA718","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Lumen_(unit)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/lumen"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/SI/units/lumen"}],"http://qudt.org/schema/qudt/siUnitsExpression":[{"@value":"cd.sr","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"lm","@type":"http://www.w3.or