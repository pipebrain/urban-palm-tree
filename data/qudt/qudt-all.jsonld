. As a counting\n    unit it measures data volume or storage capacity (one byte = 8 bits).\n  <p>For the distinction between this counting sense and the information-entropy sense (the shannon), see\n  <a href=\"../vocab/unit#BIT\">unit:BIT</a>.</p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/ASU"},{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-ESU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/PLANCK"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"8.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"8.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Byte","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/unit/OCTET"}],"http://qudt.org/schema/qudt/factorUnitScalar":[{"@value":"8.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-768"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfData"},{"@id":"http://qudt.org/vocab/quantitykind/ByteDataVolume"},{"@id":"http://qudt.org/vocab/quantitykind/DatasetOfBytes"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA354","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA354","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Byte?oldid=493588918","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/byte"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"B","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"By","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"AD","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfData"},{"@id":"http://qudt.org/vocab/quantitykind/ByteDataVolume"},{"@id":"http://qudt.org/vocab/quantitykind/DatasetOfBytes"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q8799"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Byte","@language":"en"},{"@value":"Byte","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BYTE-PER-SEC","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"unit byte divided by the SI base unit second","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"8.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"8.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-769"},{"@id":"_:n3-770"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ByteRate"},{"@id":"http://qudt.org/vocab/quantitykind/DataRate"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB305","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB305","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"B/s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"By.s-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"P93","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ByteRate"},{"@id":"http://qudt.org/vocab/quantitykind/DataRate"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Byte per Second","@language":"en"},{"@value":"Byte per Second","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BasePair","@type":["http://qudt.org/schema/qudt/CountingUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"DNA sequence length in numbers of base pairs. One bp corresponds to approximately 3.4 Å (340 pm)[23] of\n    length along the strand, and to roughly 618 or 643 daltons for DNA and RNA respectively.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/ASU"},{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-ESU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/PLANCK"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/categorizedByQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Count"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Count"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Base_pair#As_a_unit_of_length","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"One bp corresponds to approximately 3.4 Å (340 pm)[23] of length along the strand, and to roughly\n    618 or 643 daltons for DNA and RNA respectively.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"bp","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Base Pair","@language":"en"},{"@value":"Base Pair","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/C","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The SI unit of electric charge. One coulomb is the amount of charge accumulated in one second by a\n    current of one ampere. Electricity is actually a flow of charged particles, such as electrons, protons, or ions. The charge on\n    one of these particles is a whole-number multiple of the charge e on a single electron, and one coulomb represents a charge of\n    approximately 6.241 506 x 1018 e. The coulomb is named for a French physicist, Charles-Augustin de Coulomb (1736-1806), who\n    was the first to measure accurately the forces exerted between electric charges.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/PLANCK"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Coulomb","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-771"},{"@id":"_:n3-772"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCharge"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA130","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA130","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Coulomb?oldid=491815163","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/coulomb"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/SI/units/coulomb"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"C","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"C","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/udunitsCode":[{"@value":"C","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"COU","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCharge"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q25406"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Coulomb","@language":"cs"},{"@value":"Coulomb","@language":"de"},{"@value":"Coulomb","@language":"en"},{"@value":"Coulomb","@language":"fr"},{"@value":"Coulomb","@language":"hu"},{"@value":"Coulomb","@language":"it"},{"@value":"Coulomb","@language":"ms"},{"@value":"Coulomb","@language":"pt"},{"@value":"Coulomb","@language":"ro"},{"@value":"Coulomb","@language":"sl"},{"@value":"Coulomb","@language":"tr"},{"@value":"Coulomb","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Coulombium","@language":"la"},{"@value":"Culombio","@language":"es"},{"@value":"Kulomb","@language":"pl"},{"@value":"Κουλόμπ","@language":"el"},{"@value":"Кулон","@language":"bg"},{"@value":"Кулон","@language":"ru"},{"@value":"קולון","@language":"he"},{"@value":"كولوم","@language":"ar"},{"@value":"کولمب/کولن","@language":"fa"},{"@value":"कूलम्ब","@language":"hi"},{"@value":"クーロン","@language":"ja"},{"@value":"库伦","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/C-M","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\text{Coulomb Meter (C-m)}$ is a unit in the category of Electric dipole moment.\n  It is also known as atomic unit, u.a., au, ua.\n  This unit is commonly used in the SI unit system.\n  Coulomb Meter (C-m) has a dimension of LTI where $L$ is length, $T$ is time, and $I$ is electric current.\n  This unit is the standard SI unit in this category.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L1I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-773"},{"@id":"_:n3-774"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricDipoleMoment"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA133","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA133","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"C·m","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"C.m","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"A26","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricDipoleMoment"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q28739766"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Coulomb Meter","@language":"de"},{"@value":"Coulomb Meter","@language":"en-us"},{"@value":"Coulomb Meter","@language":"ms"},{"@value":"Coulomb Meter","@language":"sl"},{"@value":"Coulomb Metr","@language":"cs"},{"@value":"Coulomb Metre","@language":"en"},{"@value":"Coulomb Metre","@language":"tr"},{"@value":"Coulomb Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Coulomb Metro","@language":"it"},{"@value":"Coulomb Metro","@language":"pt"},{"@value":"Coulomb Metru","@language":"ro"},{"@value":"Coulomb Mètre","@language":"fr"},{"@value":"Coulombium Metrum","@language":"la"},{"@value":"Culombio Metro","@language":"es"},{"@value":"Kulomb Metr","@language":"pl"},{"@value":"Κουλόμπ Μέτρο","@language":"el"},{"@value":"Кулон Метр","@language":"ru"},{"@value":"Кулон Метър","@language":"bg"},{"@value":"كولوم متر","@language":"ar"},{"@value":"نیوتون متر","@language":"fa"},{"@value":"कूलम्ब मीटर","@language":"hi"},{"@value":"クーロンメートル","@language":"ja"},{"@value":"库伦米","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/C-M2","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Coulomb Square Meter (C-m2) is a unit in the category of Electric quadrupole moment. This unit is\n    commonly used in the SI unit system. Coulomb Square Meter (C-m2) has a dimension of L2TI where $L$ is length, $T$ is time, and\n    $I$ is electric current. This unit is the standard SI unit in this category.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@