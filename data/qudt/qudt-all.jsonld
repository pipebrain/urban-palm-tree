/exponent":[{"@value":"3","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/hasUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM"}]},{"@id":"_:n3-995","@type":["http://qudt.org/schema/qudt/FactorUnit"],"http://qudt.org/schema/qudt/exponent":[{"@value":"-1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/hasUnit":[{"@id":"http://qudt.org/vocab/unit/DAY"}]},{"@id":"_:n3-996","@type":["http://qudt.org/schema/qudt/FactorUnit"],"http://qudt.org/schema/qudt/exponent":[{"@value":"-1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/hasUnit":[{"@id":"http://qudt.org/vocab/unit/K"}]},{"@id":"_:n3-997","@type":["http://qudt.org/schema/qudt/FactorUnit"],"http://qudt.org/schema/qudt/exponent":[{"@value":"3","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/hasUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM"}]},{"@id":"_:n3-998","@type":["http://qudt.org/schema/qudt/FactorUnit"],"http://qudt.org/schema/qudt/exponent":[{"@value":"-1","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/hasUnit":[{"@id":"http://qudt.org/vocab/unit/GM"}]},{"@id":"_:n3-999","@type":["http://qudt.org/schema/qudt/FactorUnit"],"http://qudt.org/schema/qudt/exponent":[{"@value":"3","@type":"http://www.w3.org/2001/XMLSchema#integer"}],"http://qudt.org/schema/qudt/hasUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM"}]},{"@id":"http://purl.org/dc/terms/abstract","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"abstract","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://purl.org/dc/terms/contributor","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"contributor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://purl.org/dc/terms/created","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"created","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://purl.org/dc/terms/creator","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"creator","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://purl.org/dc/terms/description","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty","http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"description","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://purl.org/dc/terms/isReplacedBy","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"is replaced by","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://purl.org/dc/terms/modified","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"modified","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://purl.org/dc/terms/rights","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"rights","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://purl.org/dc/terms/source","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"source","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://purl.org/dc/terms/subject","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"subject","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://purl.org/dc/terms/title","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"title","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/3.5.2/qudt-all","@type":["http://www.w3.org/2002/07/owl#Ontology"],"http://www.linkedmodel.org/schema/vaem#hasGraphMetadata":[{"@id":"http://www.linkedmodel.org/schema/vaem#GMD_QUDT-All"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/qudt-all"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"QUDT Collection 3.5.2","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2002/07/owl#imports":[{"@id":"http://www.linkedmodel.org/schema/vaem"},{"@id":"http://www.w3.org/2004/02/skos/core"}],"http://www.w3.org/2002/07/owl#versionIRI":[{"@id":"http://qudt.org/3.5.2/qudt-all"}]},{"@id":"http://qudt.org/schema/qudt/AbstractDatatype","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>An \"Abstract Datatype\" (ADT) is a specification of a set of data and the set of operations that can be performed on the data. \n  Such a data type is abstract in the sense that it is independent of various concrete implementations. \n  The definition can be mathematical, or it can be programmed as an interface. \n  A first class ADT supports the creation of multiple instances of the ADT, and the interface normally provides a constructor,\n   which returns an abstract handle to new data, and several operations, \n   which are functions accepting the abstract handle as an argument.</p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Abstract Datatype","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/StructuredDatatype"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"http://en.wikipedia.org/wiki/Abstract_data_type"},{"@id":"http://xlinux.nist.gov/dads/HTML/abstractDataType.html"}]},{"@id":"http://qudt.org/schema/qudt/AbstractQuantityKind","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Quantity Kind (abstract)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-0"},{"@id":"_:n3-1"},{"@id":"_:n3-2"},{"@id":"_:n3-3"},{"@id":"http://qudt.org/schema/qudt/Concept"}]},{"@id":"http://qudt.org/schema/qudt/AbstractQuantityKind-skos_broader","http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}]},{"@id":"http://qudt.org/schema/qudt/AlgebraicDatatype","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"<p>An <em>Algebraic Datatype</em> is a datatype each of whose values are data from other data types wrapped in one of the constructors of the data type. \nAny wrapped datum is an argument to the constructor. \nIn contrast to other data types, the constructor is not executed and the only way to operate on the data is to unwrap the constructor using pattern matching.\n</p>\n<p>The most common algebraic data type is a list with two constructors: Nil or [] for an empty list, and Cons (an abbreviation of constructor), \n ::, or : for the combination of a new element with a shorter list (for example (Cons 1 '(2 3 4)) or 1:[2,3,4]).\n</p>\n<p>Special cases of algebraic types are product types i.e. records (only one constructor) and enumerated types (many constructors with no arguments). \nAlgebraic types are one kind of composite type (i.e. a type formed by combining other types).\n</p>\n<p>An algebraic data type may also be an abstract data type (ADT) if it is exported from a module without its constructors. \nValues of such a type can only be manipulated using functions defined in the same module as the type itself.\n</p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Algebraic Datatype","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/schema/qudt/AbstractDatatype"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/StructuredDatatype"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"http://en.wikipedia.org/wiki/Algebraic_data_type"}]},{"@id":"http://qudt.org/schema/qudt/AlignmentType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  Specifies how a physical data field is aligned. \n  The alignment could be at a bit, byte or word boundary.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Alignment type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}],"http://www.w3.org/2002/07/owl#oneOf":[{"@id":"_:n3-4"}]},{"@id":"http://qudt.org/schema/qudt/AngleUnit","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"All units relating to specificaiton of angles. ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Angle unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/DimensionlessUnit"}],"http://www.w3.org/2004/02/skos/core#exactMatch":[{"@id":"http://dbpedia.org/resource/Category:Units_of_angle"}]},{"@id":"http://qudt.org/schema/qudt/Array","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>An <em>Array></em> is a data structure that stores a collection of elements, typically of the same type, in a contiguous block of memory. \n  Each element in an array is identified by an index or key, which is typically a numerical identifier, either starting at '0' or '1'.\n  </p>\n  <p>The key considerations for an Array are:\n  </p>\n  <ol>\n  <li>Fixed Size: The size of an array may be pre-determined when it is created and cannot be changed;</li>\n  <li>Index-Based Access: Elements can be accessed, updated, or modified using their index;</li>\n  <li>Contiguous Memory Allocation: The elements are stored in consecutive memory locations, which allows efficient access using the index.</li>\n  </ol>\n  <p>An Array is represented as ordered entries of values arranged according to its dimensionality.\n  The number of dimensions is specified in the attribute 'dimensionality'.\n  </p>\n  <p>An array can be multi-dimensional.\n  Multiple indices are used but they are treated as extensions of the same structure.\n  For Example: for a 2D array arr[2][3], indices refer to the row and column positions.\n  A 2D array is still represented as a list, where each member of the list is a list.\n  </p>\n  <p>Higher dimensional arrays can be represented as nested lists.\n  For each dimension a new nested list is defined.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Array","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-10"},{"@id":"_:n3-11"},{"@id":"_:n3-7"},{"@id":"_:n3-8"},{"@id":"_:n3-9"},{"@id":"http://qudt.org/schema/qudt/StructuredDatatype"}]},{"@id":"http://qudt.org/schema/qudt/Array2DvalueList","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  An rdf:List for a 2D array.\n  For example \"[[1,2], [3,4], [5,6]]\"\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#first":[{"@id":"http://qudt.org/schema/qudt/List"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#rest":[{"@id":"_:n3-12"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"2D Array Value List","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/List"}]},{"@id":"http://qudt.org/schema/qudt/ArrayDataOrder","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A sub-type of 'Enumerated Value'. Detailed description to be provided in a future version.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Array data order","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}],"http://www.w3.org/2002/07/owl#oneOf":[{"@id":"_:n3-13"}]},{"@id":"http://qudt.org/schema/qudt/ArrayType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>An <em>Array Type</em> is a type specification for ordered entries of values arranged according to the dimensions given. \n  The dimensions are given as a list of integers where each integer is the cardinality of each dimension. \n  The number of dimensions is specified in the attribute 'dimensionality'.\n  </p>\n  <p>Optionally a reference can be made to a variable, whose values are the array entries. \n  The data type of the array entries is an optional field, 'elementType', which points to a data type definition. \n  If the data type is given, then it applies to all elements.  \n  If it is not given then the elements can be of different types for each position in the array.\n  </p>\n  <p>The property <em>qudt:typeMatrix</em> must refer to a matrix of types.\n  If a default value is given this can be used to place the appropriate value in a cell when an entry value is not known. \n  If no dimensionality or dimension vector is specified the array is under-specified but still legitimate as a place-holder for a data type.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Array Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/CompositeDatatype"}]},{"@id":"http://qudt.org/schema/qudt/Aspect","@type":["http://qudt.org/schema/qudt/AspectClass","http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"An aspect is an abstract type class that defines properties that can be reused.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"QUDT Aspect","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/AspectClass","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Aspect Class","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://www.w3.org/2000/01/rdf-schema#Class"}]},{"@id":"http://qudt.org/schema/qudt/AssociativeArray","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>An <em>Associative Array</em> (or <em>Map</em>) is an abstract data type composed of a collection of keys and a collection of values,\n   where each key is associated with one value. \n  The operation of finding the value associated with a key is called a lookup or indexing,\n   and this is the most important operation supported by an associative array.\n  The relationship between a key and its value is sometimes called a mapping or binding.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Associative Array","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/schema/qudt/Map"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Array"}]},{"@id":"http://qudt.org/schema/qudt/AuralCue","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>An aural cue is a sound produced by a device or a system that is used to alert personnel of of an advisory, cautionary, warning, or emergency state.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Aural Cue","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-16"},{"@id":"_:n3-17"},{"@id":"_:n3-18"},{"@id":"http://qudt.org/schema/qudt/ModalCue"}]},{"@id":"http://qudt.org/schema/qudt/BalancedTree","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Balanced Tree</em> is a data type that defines the properties of data structures that represent balanced trees. \n  A balanced tree is a tree where no leaf is much farther away from the root than any other leaf. \n  Different balancing schemes allow different definitions of \"much farther\" and different amounts of work to keep them balanced.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Balanced Tree Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-19"},{"@id":"http://qudt.org/schema/qudt/Tree"}]},{"@id":"http://qudt.org/schema/qudt/BaseDimensionMagnitude","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Dimension</em> expresses a magnitude for a base quantity kind such as mass, length and time.\n  </p>\n  <p>DEPRECATED - each exponent is expressed as a property. \n  Keep until a validation of this has been done.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://web.mit.edu/2.25/www/pdf/DA_unified.pdf","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Dimensional_analysis","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Base Dimension Magnitude","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-20"},{"@id":"_:n3-21"},{"@id":"_:n3-22"},{"@id":"_:n3-23"},{"@id":"_:n3-24"},{"@id":"_:n3-25"},{"@id":"_:n3-26"},{"@id":"_:n3-27"},{"@id":"http://qudt.org/schema/qudt/Concept"}]},{"@id":"http://qudt.org/schema/qudt/BigIntegerType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Big Integer</em> is an integer that can be represented in eight octets (64 bits) of machine memory. \n  Big integers may be signed or unsigned.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Big Integer Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/IntegerDatatype"}]},{"@id":"http://qudt.org/schema/qudt/BinaryPrefix","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Binary Prefix</em> is a prefix for multiples of units in data processing, data transmission, and digital information,\n   notably the bit and the byte, to indicate multiplication by a power of 2.\n   </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Binary Prefix","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Prefix"}]},{"@id":"http://qudt.org/schema/qudt/BinaryTree","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Binary Tree</em> is a data type that defines the properties of data structures that represent binary trees. \n  A binary tree is a tree in which each node has at most 2 children.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Binary Tree Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Tree"}]},{"@id":"http://qudt.org/schema/qudt/BitEncodingType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Bit Encoding Type</em> is an encoding type for the correspondence between the two possible values of a bit, 0 or 1, and some interpretation. \n  For example, in a boolean encoding, a bit denotes a truth value, where 0 corresponds to False and 1 corresponds to True.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bit Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Encoding"}],"http://www.w3.org/2002/07/owl#oneOf":[{"@id":"_:n3-28"}]},{"@id":"http://qudt.org/schema/qudt/BitField","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A bit field is a common idiom used in computer programming to store a set of Boolean datatype flags compactly, as a series of bits. \n  The bit field is stored in an integral type of known, fixed bit-width. \n  Each Boolean flag is stored in a separate bit. \n  Usually the source code will define a set of constants, each a power of two, that semantically associate each individual bit with its respective Boolean flag. \n  The bitwise operators and, or, and not are used in combination to set, reset and test the flags.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/BooleanEncodingType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Boolean Encoding Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Encoding"}],"http://www.w3.org/2002/07/owl#oneOf":[{"@id":"_:n3-29"}]},{"@id":"http://qudt.org/schema/qudt/BooleanType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A boolean data type can take on only two values.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Boolean Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/OrdinalType"}]},{"@id":"http://qudt.org/schema/qudt/BooleanTypeEnumeratedValue","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"Specifies how a boolean value is expressed","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"boolean value","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}]},{"@id":"http://qudt.org/schema/qudt/ByteEncodingType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"This class contains the various ways that information may be encoded into bytes.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Byte Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Encoding"}]},{"@id":"http://qudt.org/schema/qudt/CRC32","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"CRC-32","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/CardinalityType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  In mathematics, the cardinality of a set is a measure of the number of elements of the set.\n  For example, the set $A = {2, 4, 6}$ contains 3 elements, and therefore $A$ has a cardinality of 3. \n  There are two approaches to cardinality: one which compares sets directly using bijections and injections,\n   and another which uses cardinal numbers.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Cardinal_number","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Cardinality","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In mathematics, the cardinality of a set is a measure of the number of elements of the set.  For example, the set 'A = {2, 4, 6}' contains 3 elements, and therefore 'A' has a cardinality of 3. There are two approaches to cardinality – one which compares sets directly using bijections and injections, and another which uses cardinal numbers.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Cardinality Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-35"},{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}],"http://www.w3.org/2002/07/owl#oneOf":[{"@id":"_:n3-32"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"http://en.wikipedia.org/wiki/Cardinal_number"},{"@id":"http://en.wikipedia.org/wiki/Cardinality"}]},{"@id":"http://qudt.org/schema/qudt/CharEncodingType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"The class of all character encoding schemes, each of which defines a rule or algorithm for encoding character data as a sequence of bits or bytes.","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"\n  <p>The class of all character encoding schemes.\n  Each defines a rule or algorithm for encoding character data as a sequence of bits or bytes.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Char Encoding Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Encoding"}],"http://www.w3.org/2002/07/owl#oneOf":[{"@id":"_:n3-36"}]},{"@id":"http://qudt.org/schema/qudt/CharacterType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A <em>Character Type</em> is a data type that defines the type and encoding of single characters.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Character Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/OrdinalType"}]},{"@id":"http://qudt.org/schema/qudt/Citation","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"Provides a simple way of making citations.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Citation","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-37"},{"@id":"_:n3-38"},{"@id":"_:n3-39"},{"@id":"_:n3-40"},{"@id":"_:n3-41"},{"@id":"http://qudt.org/schema/qudt/Concept"}]},{"@id":"http://qudt.org/schema/qudt/Collection","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A collection is a grouping of some variable number of zero or more data items that need to be operated upon together in some controlled fashion. \n  Generally, the data items will all share the same data type or are derived from some common ancestor data type.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Collection Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/StructuredDatatype"}]},{"@id":"http://qudt.org/schema/qudt/ColorCue","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A visual cue that uses color to distinguish it from other cues. \n  Each color cue has exactly one corresponding coordinate point in the RGB space.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Color Cue","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-42"},{"@id":"_:n3-43"},{"@id":"_:n3-44"},{"@id":"http://qudt.org/schema/qudt/VisualCue"}]},{"@id":"http://qudt.org/schema/qudt/Comment","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Comment","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-45"},{"@id":"_:n3-46"},{"@id":"_:n3-47"},{"@id":"http://qudt.org/schema/qudt/Verifiable"}]},{"@id":"http://qudt.org/schema/qudt/CompositeDataStructure","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Composite Data Structure</em>, also referred to as <em>Data Record</em> is a datatype that aggregates element of possibly different types. \n  The aggregated items are called fields or members and are usually identified or indexed by field labels.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Composite Data Structure","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/CompositeDatatype"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"https://en.wikipedia.org/wiki/List_of_data_structures"},{"@id":"https://en.wikipedia.org/wiki/Record_(computer_science)"}]},{"@id":"http://qudt.org/schema/qudt/CompositeDatatype","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Composite Datatype</em> is a datatype that is constructed from basic primitive types and other composite types. \n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Composite Data Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-48"},{"@id":"http://qudt.org/schema/qudt/StructuredDatatype"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"https://en.wikipedia.org/wiki/List_of_data_structures"}]},{"@id":"http://qudt.org/schema/qudt/CompositeTable","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A sub-type of 'Table Type'.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Composite Table Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Table"}]},{"@id":"http://qudt.org/schema/qudt/CompositionFunction","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Composition function","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Function"}]},{"@id":"http://qudt.org/schema/qudt/CompositionTree","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Composition Tree","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-49"},{"@id":"_:n3-50"},{"@id":"_:n3-51"},{"@id":"http://qudt.org/schema/qudt/Tree"}]},{"@id":"http://qudt.org/schema/qudt/Concept","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"The root class for all QUDT concepts.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"QUDT Concept","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-52"},{"@id":"_:n3-53"},{"@id":"_:n3-54"},{"@id":"_:n3-55"},{"@id":"_:n3-56"},{"@id":"_:n3-57"},{"@id":"_:n3-58"},{"@id":"_:n3-59"},{"@id":"_:n3-60"},{"@id":"_:n3-61"},{"@id":"_:n3-62"}]},{"@id":"http://qudt.org/schema/qudt/ConstantValue","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"Used to specify the values of a constant.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Constant value","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-63"},{"@id":"_:n3-64"},{"@id":"http://qudt.org/schema/qudt/QuantityValue"}]},{"@id":"http://qudt.org/schema/qudt/ContextualUnit","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Contextual Unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-65"},{"@id":"http://qudt.org/schema/qudt/Unit"}]},{"@id":"http://qudt.org/schema/qudt/CountingUnit","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Counting Unit</em> is used for all units that express counts. \n  Examples are Atomic Number, Number, Number per Year, Percent and Sample per Second.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Counting Unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/DimensionlessUnit"}]},{"@id":"http://qudt.org/schema/qudt/CurrencyUnit","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  Currency Units have their own subclass of unit because:\n   (a) they have additional properties such as 'country' and\n   (b) their URIs do not conform to the same rules as other units.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Currency Unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-66"},{"@id":"_:n3-67"},{"@id":"_:n3-68"},{"@id":"http://qudt.org/schema/qudt/DimensionlessUnit"}]},{"@id":"http://qudt.org/schema/qudt/DataEncoding","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p><em>Data Encoding</em> expresses the properties that specify how data is represented at the bit and byte level. \n  These properties are applicable to describing raw data.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Data Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-69"},{"@id":"_:n3-70"},{"@id":"_:n3-71"},{"@id":"http://qudt.org/schema/qudt/Aspect"}]},{"@id":"http://qudt.org/schema/qudt/DataItem","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Data Item</em> holds a value that maybe a scalar or structured datatype.\n  <em>Quantity Value</em> specifies which case applies.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Data Item","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Concept"}]},{"@id":"http://qudt.org/schema/qudt/DataSetElement","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A field is a tuple that carries a name, a type and optionally other properties that characterize a member element of a composite data structure.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"QUDT DataSet Element","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-72"},{"@id":"_:n3-73"},{"@id":"_:n3-74"},{"@id":"_:n3-75"},{"@id":"_:n3-76"},{"@id":"_:n3-77"},{"@id":"http://qudt.org/schema/qudt/DataItem"},{"@id":"http://qudt.org/schema/qudt/Tuple"}]},{"@id":"http://qudt.org/schema/qudt/Datatype","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n   <p>A <em>Datatype</em> is a definition of the type of the \"value\" of a data item (for example, \"all integers between 0 and 10\"),\n   and the allowable operations on those values; the meaning of the data; and the way values of that type can be stored. \n  Some types are primitive - built-in to the language, with no visible internal structure.\n  For example \"Boolean\"; others are composite - constructed from one or more other types (of either kind).\n  For example lists, arrays, structures, unions. \n  Some languages provide strong typing, others allow implicit type conversion and/or explicit type conversion.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"},{"@value":"\n  <p>A <em>Datatype</em> is a definition of the type of the \"value\" of a data item (for example, \"all integers between 0 and 10\"),\n   and the allowable operations on those values; the meaning of the data; and the way values of that type can be stored.\n  Some types are primitive - built-in to the language, with no visible internal structure.\n  For example \"Boolean\"; others are composite - constructed from one or more other types (of either kind).\n  For example lists, arrays, structures, unions.\n  Some languages provide strong typing, others allow implicit type conversion and/or explicit type conversion.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://foldoc.org/data+type","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.princeton.edu/~achaney/tmve/wiki100k/docs/Data_type.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Data_type","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"},{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Datatype","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-100"},{"@id":"_:n3-101"},{"@id":"_:n3-102"},{"@id":"_:n3-103"},{"@id":"_:n3-104"},{"@id":"_:n3-105"},{"@id":"_:n3-106"},{"@id":"_:n3-107"},{"@id":"_:n3-78"},{"@id":"_:n3-79"},{"@id":"_:n3-80"},{"@id":"_:n3-81"},{"@id":"_:n3-82"},{"@id":"_:n3-83"},{"@id":"_:n3-84"},{"@id":"_:n3-85"},{"@id":"_:n3-86"},{"@id":"_:n3-87"},{"@id":"_:n3-88"},{"@id":"_:n3-89"},{"@id":"_:n3-90"},{"@id":"_:n3-91"},{"@id":"_:n3-92"},{"@id":"_:n3-93"},{"@id":"_:n3-94"},{"@id":"_:n3-95"},{"@id":"_:n3-96"},{"@id":"_:n3-97"},{"@id":"_:n3-98"},{"@id":"_:n3-99"},{"@id":"http://qudt.org/schema/qudt/Concept"}]},{"@id":"http://qudt.org/schema/qudt/DateStringType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"Date String Types are scalar data types that define the properties of strings that represent calendar dates.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Date String Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/DateTimeStringType"}]},{"@id":"http://qudt.org/schema/qudt/DateTimeStringEncodingType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"Date Time encodings are logical encodings for expressing date/time quantities as strings by applying unambiguous formatting and parsing rules.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Date Time String Encoding Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-108"},{"@id":"http://qudt.org/schema/qudt/StringEncodingType"}]},{"@id":"http://qudt.org/schema/qudt/DateTimeStringType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A class of data types for structures that represent temporal quantities.\n  For example, calendar dates, times, duration of time since a given epoch, etc.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Temporal Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-109"},{"@id":"http://qudt.org/schema/qudt/StringType"}]},{"@id":"http://qudt.org/schema/qudt/DateTypeUnion","@type":["http://qudt.org/schema/qudt/List"],"http://purl.org/dc/terms/description":[{"@value":"\n  An rdf:List that can be used in property constraints as the type in an sh:or to indicate\n   that all values of a property must be an xsd date type.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#first":[{"@id":"http://www.w3.org/2001/XMLSchema#date"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#rest":[{"@id":"_:n3-418"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Date Type Union","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/DecimalPrefix","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A <em>Decimal Prefix</em> is a prefix for multiples of units that are powers of 10.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Decimal Prefix","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Prefix"}]},{"@id":"http://qudt.org/schema/qudt/DerivedUnit","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Derived Unit</em> is a type specification for units that are derived from other units.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Category:SI_derived_units","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Derived Unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Unit"}]},{"@id":"http://qudt.org/schema/qudt/Dictionary","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A \"Map\".","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dictionary Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Map"}]},{"@id":"http://qudt.org/schema/qudt/DigitalCurrencyUnit","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A currency-like unit for cryptographic or tokenized assets. Instances should reference an ISO 24165 Digital Token Identifier (DTI) when available.","@language":"en"}],"http://qudt.org/schema/qudt/informativeReference":[{"@id":"https://dtif.org/"},{"@id":"https://www.iso.org/standard/79891.html"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"A currency-like unit for cryptographic or tokenized assets. Instances should reference an ISO 24165 Digital Token Identifier (DTI) when available.","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Digital Currency Unit","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-110"},{"@id":"_:n3-111"},{"@id":"_:n3-112"},{"@id":"_:n3-113"},{"@id":"_:n3-114"},{"@id":"_:n3-115"},{"@id":"_:n3-116"},{"@id":"_:n3-117"},{"@id":"http://qudt.org/schema/qudt/CurrencyUnit"}]},{"@id":"http://qudt.org/schema/qudt/DimensionalDatatype","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Dimensional Data Type</em> is a data type that specifies a physical quantity or unit of measure.\n  Information about the physical dimensions of the quantities and units is embedded in their types.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dimensional Data Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/StructuredDatatype"}]},{"@id":"http://qudt.org/schema/qudt/DimensionlessUnit","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Dimensionless Unit</em> is a quantity for which all the exponents of the factors corresponding to the base quantities in its quantity dimension are zero.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dimensionless Unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Unit"}]},{"@id":"http://qudt.org/schema/qudt/Discipline","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Discipline","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Concept"}]},{"@id":"http://qudt.org/schema/qudt/DiscreteState","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Discrete State</em> is the parent class for enumerated values that express a 'State' or 'Condition'.\n  Examples are 'on' and 'off for a switch, 'open' and 'closed' for a valve, and 'wet' and 'dry'.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Discrete State","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-118"},{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}]},{"@id":"http://qudt.org/schema/qudt/DoublePrecisionType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A double precision data type specifies how a numeric value, such as an integer or real number, is stored in memory.\n  Typically this occupies two words in computer memory, where the byte length of a word depends on machine address size of the computer processor. \n  For example, on 32-bit machine architectures, a word is four bytes, and so double precision data value on a 32-bit machine architecture occupies eight bytes of memory.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Double Precision Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/NumericType"}]},{"@id":"http://qudt.org/schema/qudt/Encoding","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>An encoding is a rule or algorithm that is used to convert data from a native, or unspecified form into a specific form that satisfies the encoding rules. \n  Examples of encodings include character encodings, such as UTF-8.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-119"},{"@id":"_:n3-120"},{"@id":"http://www.w3.org/2004/02/skos/core#Concept"}]},{"@id":"http://qudt.org/schema/qudt/EndianType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Endianness","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In computing, endianness is the ordering used to represent some kind of data as a sequence of smaller units. Typical cases are the order in which integer values are stored as bytes in computer memory (relative to a given memory addressing scheme) and the transmission order over a network or other medium. When specifically talking about bytes, endianness is also referred to simply as byte order.  Most computer processors simply store integers as sequences of bytes, so that, conceptually, the encoded value can be obtained by simple concatenation. For an 'n-byte' integer value this allows 'n!' (n factorial) possible representations (one for each byte permutation). The two most common of them are: increasing numeric significance with increasing memory addresses, known as little-endian, and its opposite, called big-endian.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Endian Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}],"http://www.w3.org/2002/07/owl#oneOf":[{"@id":"_:n3-121"}]},{"@id":"http://qudt.org/schema/qudt/EngineeringValueTupleMember","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A sub-type of 'Tuple Member Type'. \n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Engineering Value Tuple Member","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/TupleMember"}]},{"@id":"http://qudt.org/schema/qudt/EnumeratedQuantity","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Enumerated Quantity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-123"},{"@id":"_:n3-124"},{"@id":"_:n3-125"},{"@id":"_:n3-126"},{"@id":"http://qudt.org/schema/qudt/Concept"}]},{"@id":"http://qudt.org/schema/qudt/EnumeratedValue","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>An <em>Enumerated Value</em> class defines the members of an enumeration. \n  An enumeration is a set of literals from which a single value is selected. \n  Each literal can have a tag as an integer within a standard encoding appropriate to the range of integer values. \n  Consistency of enumeration types will allow them, and the enumerated values, to be referred to unambiguously either through symbolic name or encoding. \n  </p>\n  <p>Enumerated values are also controlled vocabularies and as such need to be standardized. \n  Without this consistency enumeration literals can be stated differently and result in  data conflicts and misinterpretations.\n  </p>\n  <p>The tags are a set of positive whole numbers, not necessarily contiguous and having no numerical significance, each corresponding to the associated literal identifier. \n  An order attribute can also be given on the enumeration elements. \n  An enumeration can itself be a member of an enumeration. \n  This allows enumerations to be enumerated in a selection. \n  </p>\n  <p>Enumerations are also subclasses of Scalar Datatype. \n  This allows them to be used as the reference of a datatype specification.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Enumeration","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Enumerated Value","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-127"},{"@id":"_:n3-128"},{"@id":"_:n3-129"},{"@id":"http://qudt.org/schema/qudt/Verifiable"},{"@id":"http://www.linkedmodel.org/schema/dtype#EnumeratedValue"}]},{"@id":"http://qudt.org/schema/qudt/Enumeration","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>An <em>Enumeration</em> is a set of literals from which a single value is selected. \n  Each literal can have a tag as an integer within a standard encoding appropriate to the range of integer values. \n  Consistency of enumeration types will allow them, and the enumerated values, to be referred to unambiguously either through symbolic name or encoding. \n  Enumerated values are also controlled vocabularies and as such need to be standardized. \n  Without this consistency enumeration literals can be stated differently and result in  data conflicts and misinterpretations.\n  </p>\n  <p>The tags are a set of positive whole numbers, not necessarily contiguous and having no numerical significance, each corresponding to the associated literal identifier. \n  An order attribute can also be given on the enumeration elements. An enumeration can itself be a member of an enumeration. This allows enumerations to be enumerated in a selection. \n  Enumerations are also subclasses of <em>Scalar Datatype</em>. \n  This allows them to be used as the reference of a datatype specification.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Enumeration","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Enumerated_type","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Enumeration","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.linkedmodel.org/schema/vaem#isElaboratedIn":[{"@id":"http://qudt.org/3.5.2/schema/shacl/datatype"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"},{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Enumeration","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"QUDT Enumeration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-130"},{"@id":"_:n3-131"},{"@id":"_:n3-132"},{"@id":"_:n3-133"},{"@id":"_:n3-134"},{"@id":"_:n3-135"},{"@id":"_:n3-136"},{"@id":"_:n3-137"},{"@id":"http://qudt.org/schema/qudt/Concept"},{"@id":"http://qudt.org/schema/qudt/StructuredDatatype"},{"@id":"http://www.linkedmodel.org/schema/dtype#Enumeration"}]},{"@id":"http://qudt.org/schema/qudt/EnumerationScale","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A sub-type of 'DTYPE Enumeration'.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Enumeration scale","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Scale"},{"@id":"http://www.linkedmodel.org/schema/dtype#Enumeration"}]},{"@id":"http://qudt.org/schema/qudt/FactorUnit","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Factor Unit</em> is a type specification for a unit, exponent pair that is a component of a derived unit.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Category:SI_derived_units","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Factor Unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-138"},{"@id":"_:n3-139"},{"@id":"_:n3-140"},{"@id":"http://qudt.org/schema/qudt/Concept"}]},{"@id":"http://qudt.org/schema/qudt/FieldType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A sub-type of 'Composite Data Type'.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Field Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-141"},{"@id":"_:n3-142"},{"@id":"_:n3-143"},{"@id":"_:n3-144"},{"@id":"_:n3-145"},{"@id":"_:n3-146"},{"@id":"_:n3-147"},{"@id":"http://qudt.org/schema/qudt/CompositeDatatype"}]},{"@id":"http://qudt.org/schema/qudt/Figure","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Figure","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-148"},{"@id":"_:n3-149"},{"@id":"_:n3-150"},{"@id":"_:n3-151"},{"@id":"_:n3-152"},{"@id":"_:n3-153"},{"@id":"_:n3-154"},{"@id":"_:n3-155"},{"@id":"_:n3-156"},{"@id":"_:n3-157"},{"@id":"_:n3-158"},{"@id":"_:n3-159"},{"@id":"_:n3-160"},{"@id":"_:n3-161"},{"@id":"_:n3-162"},{"@id":"_:n3-163"},{"@id":"http://qudt.org/schema/qudt/Concept"}]},{"@id":"http://qudt.org/schema/qudt/FileFormat","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A sub-type of 'Enumerated Value'.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"File format","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}]},{"@id":"http://qudt.org/schema/qudt/FixedIntervalTimeSeriesArray","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Fixed Interval Time Series Array Type</em> is a data type that specifies the properties of arrays that hold time series data.\n  For example, data that has been sampled over uniformly spaced time intervals.\n  A time series is a sequence of data points, measured typically at successive times, spaced at uniform or non-uniform time intervals.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Fixed Interval Time Series Array Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/TimeSeriesArray"}]},{"@id":"http://qudt.org/schema/qudt/FixedIntervalTimeSeriesArrayType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"<p>A <em>Fixed Interval Time Series Array Type</em> is a data type that specifies the properties of arrays that hold time series data.\n For example, data that has been sampled over uniformly spaced time intervals. \n A time series is a sequence of data points, measured typically at successive times, spaced at uniform or non-uniform time intervals.\n </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Fixed Interval Time Series Array Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/TimeSeriesArrayType"}]},{"@id":"http://qudt.org/schema/qudt/FloatingPointEncodingType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A type for specifying an \"Encoding\" with the following instance(s): \n  \"Double Precision Encoding\", and \"Single Precision Real Encoding\".\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"},{"@value":"\n  A \"Encoding\" with the following instance(s): \"Double Precision Encoding\", \"Single Precision Real Encoding\".\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Floating Point Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Encoding"}]},{"@id":"http://qudt.org/schema/qudt/Function","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Function","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Concept"}]},{"@id":"http://qudt.org/schema/qudt/FunctionDatatype","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A function data type defines the input and output data type for a function or method. \n  The data type includes at least the function name and the number of its parameters. \n  In some programming languages, it may also specify the function's return type or the types of its arguments.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Function Data Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-164"},{"@id":"_:n3-165"},{"@id":"_:n3-166"},{"@id":"_:n3-167"},{"@id":"_:n3-168"},{"@id":"http://qudt.org/schema/qudt/StructuredDatatype"}]},{"@id":"http://qudt.org/schema/qudt/Graph","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Graph</em> is an instance of a kind of abstract data type, that consists of a set of nodes (also called vertices) and a set of edges that establish relationships (connections) between the nodes. \n  A Graph Type is a data type that defines the properties of data structures that represent graphs and their members (nodes and edges).\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Graph Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/DataItem"}]},{"@id":"http://qudt.org/schema/qudt/Heap","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A heap is a specialized tree-based data structure that satisfies the condition: if B is a child node of A, then $key(A) \\ge key(B)$. \n  This implies that an element with the greatest key is always in the root node, and so such a heap is sometimes called a max heap. \n  Alternatively, if the comparison is reversed, the smallest element is always in the root node, which results in a min heap. \n  The function or method that implements the key() operator is specified by the heap type.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Heap","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/OrderedTree"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"http://en.wikipedia.org/wiki/Heap_(data_structure)"}]},{"@id":"http://qudt.org/schema/qudt/HeterogenousArray","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>An <em>Array></em> is a data structure that stores a collection of elements, typically of the same type, in a contiguous block of memory. \n  Each element in an array is identified by an index or key, which is typically a numerical identifier, either starting at '0' or '1'.\n  </p>\n  <p>The key considerations for an Array are:\n  </p>\n  <ol>\n  <li>Fixed Size: The size of an array may be pre-determined when it is created and cannot be changed;</li>\n  <li>Index-Based Access: Elements can be accessed, updated, or modified using their index;</li>\n  <li>Heterogenous Elements: all elements in the array may be of different data types;</li>\n  <li>Contiguous Memory Allocation: \n    the elements are stored in consecutive memory locations, which allows efficient access using the index.</li>\n  </ol>\n  <p>An Array is represented as ordered entries of values arranged according to its dimensionality.\n  The number of dimensions is specified in the attribute 'dimensionality'.\n  </p>\n  <p>The property 'qudt:datatype' refers to a list if the datatypes of the elements.  \n  </p>\n  <p>An heterogenous array can be multi-dimensional.\n  Multiple indices are used but they are treated as extensions of the same structure.\n  For example: for a 2D array arr[2][3], indices refer to the row and column positions.\n  A 2D array is still represented as a list, where each member of the list is a list.\n  </p>\n  <p>Higher dimensional arrays can be represented as nested lists.\n  For each dimension a new nested list is defined.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Heterogenous Array","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-169"},{"@id":"_:n3-170"},{"@id":"_:n3-171"},{"@id":"http://qudt.org/schema/qudt/Array"}]},{"@id":"http://qudt.org/schema/qudt/HexBinaryType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A string composed of hex characters.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Hexidecimal Binary Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-172"},{"@id":"_:n3-173"},{"@id":"_:n3-174"},{"@id":"_:n3-175"},{"@id":"http://qudt.org/schema/qudt/TextStringType"}]},{"@id":"http://qudt.org/schema/qudt/HomogeneousArray","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>An <em>Array></em> is a data structure that stores a collection of elements, typically of the same type, in a contiguous block of memory. \n  Each element in an array is identified by an index or key, which is typically a numerical identifier, either starting at '0' or '1'.\n  </p>\n  <p>The key considerations for an Array are:\n  </p>\n  <ol>\n  <li>Fixed Size: The size of an array may be pre-determined when it is created and cannot be changed;</li>\n  <li>Index-Based Access: Elements can be accessed, updated, or modified using their index;</li>\n  <li>Homogeneous Elements: all elements in an array must be of the same datatype;</li>\n  <li>Contiguous Memory Allocation: The elements are stored in consecutive memory locations, which allows efficient access using the index.</li>\n  </ol>\n  <p>An Array is represented as ordered entries of values arranged according to its dimensionality.\n  The number of dimensions is specified in the attribute 'dimensionality'.\n  </p>\n  <p>The property 'qudt:datatype' refers to the datatype of the elements.  \n  </p>\n  <p>An array can be multi-dimensional.\n  Multiple indices are used but they are treated as extensions of the same structure.\n  For Example: for a 2D array arr[2][3], indices refer to the row and column positions.\n  A 2D array is still represented as a list, where each member of the list is a list.\n  </p>\n  <p>Higher dimensional arrays can be represented as nested lists.\n  For each dimension a new nested list is defined.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Homogeneous Array","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Array"}]},{"@id":"http://qudt.org/schema/qudt/IconicCue","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Iconic enumeration literal","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-176"},{"@id":"_:n3-177"},{"@id":"_:n3-178"},{"@id":"http://qudt.org/schema/qudt/ModalCue"}]},{"@id":"http://qudt.org/schema/qudt/IntegerDatatype","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"An Integer Type is a data type that specifies how integer numbers are represented and stored in machine memory.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Integer Datatype","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/NumericType"},{"@id":"http://qudt.org/schema/qudt/OrdinalType"}]},{"@id":"http://qudt.org/schema/qudt/IntegerEncodingType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"The encoding scheme for integer types","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Integer Encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Encoding"}],"http://www.w3.org/2002/07/owl#oneOf":[{"@id":"_:n3-179"}]},{"@id":"http://qudt.org/schema/qudt/IntegerListShape","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/List"}]},{"@id":"http://qudt.org/schema/qudt/IntegerUnionList","@type":["http://qudt.org/schema/qudt/List"],"http://www.w3.org/1999/02/22-rdf-syntax-ns#first":[{"@id":"http://www.w3.org/2001/XMLSchema#int"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#rest":[{"@id":"_:n3-421"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Integer Union List","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/InterpolatedTable","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A sub-type of 'Table Type'.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Interpolated Table Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Table"}]},{"@id":"http://qudt.org/schema/qudt/IntervalScale","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>The interval type allows for the degree of difference between items, but not the ratio between them. \n  Examples include temperature with the Celsius scale, which has two defined points\n   (the freezing and boiling point of water at specific conditions) and then separated into 100 intervals,\n   date when measured from an arbitrary epoch (such as AD), percentage such as a percentage return on a stock,\n   location in Cartesian coordinates, and direction measured in degrees from true or magnetic north. \n  </p>\n  <p>Ratios are not meaningful since 20 °C cannot be said to be \"twice as hot\" as 10 °C, nor can multiplication/division be carried out between any two dates directly. \n  However, ratios of differences can be expressed; for example, one difference can be twice another. \n  Interval type variables are sometimes also called \"scaled variables\", but the formal mathematical term is an affine space (in this case an affine line).\n  </p>\n  <p>Characteristics: median, percentile &amp; Monotonic increasing (order (&lt;) &amp; totally ordered set.</p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Level_of_measurement","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Interval scale","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/schema/qudt/NominalScale"},{"@id":"http://qudt.org/schema/qudt/OrdinalScale"},{"@id":"http://qudt.org/schema/qudt/RatioScale"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Scale"}]},{"@id":"http://qudt.org/schema/qudt/KinestheticCue","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Kinesthetic Cue","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/ModalCue"}]},{"@id":"http://qudt.org/schema/qudt/LargeObject","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A 'LargeObject' datatype is used to store blocks of unstructured data (such as text, graphic images, video clips, and sound waveforms). \n  They often are used to allow efficient, random, piece-wise access to the data.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Large object","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/CompositeDatatype"}]},{"@id":"http://qudt.org/schema/qudt/LargeObjectType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A 'LargeObject' datatype is used to store blocks of unstructured data (such as text, graphic images, video clips, and sound waveforms). They often are used to allow efficient, random, piece-wise access to the data.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Large object","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/CompositeDatatype"}]},{"@id":"http://qudt.org/schema/qudt/LatexString","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype","http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A type of string in which some characters may be wrapped with '$' and '$ characters for LaTeX rendering.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Latex String","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/LimitType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Limit type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}]},{"@id":"http://qudt.org/schema/qudt/List","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A sub-type of 'AbstractDataItem'.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"List","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-185"},{"@id":"_:n3-186"},{"@id":"_:n3-187"},{"@id":"_:n3-188"},{"@id":"_:n3-189"},{"@id":"http://qudt.org/schema/qudt/DataItem"}]},{"@id":"http://qudt.org/schema/qudt/LogarithmicUnit","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  Logarithmic units are abstract mathematical units that can be used to express any quantities\n   (physical or mathematical) that are defined on a logarithmic scale, that is, as being proportional\n   to the value of a logarithm function.\n  Examples of logarithmic units include common units of information and entropy, such as the bit,\n   and the byte, as well as units of relative signal strength magnitude such as the decibel.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Logarithmic Unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/DimensionlessUnit"}]},{"@id":"http://qudt.org/schema/qudt/LongIntegerType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A \"Long Integer\" is an integer that can be represented in four octets (32 bits) of machine memory. \n  Long integers may be signed or unsigned.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Long Integer Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/IntegerDatatype"}]},{"@id":"http://qudt.org/schema/qudt/MajorMinorType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A sub-type of 'Enumerated Value'.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Major minor type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}],"http://www.w3.org/2002/07/owl#oneOf":[{"@id":"_:n3-190"}]},{"@id":"http://qudt.org/schema/qudt/Map","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A Map Type is an abstract data type that defines the properties of map data structures. A Map (or Associative Array) is an abstract data structure composed of a collection of keys and a collection of values, where each key is associated with one value. The operation of finding the value associated with a key is called a lookup or indexing, and this is the most important operation supported by an associative array. The relationship between a key and its value is sometimes called a mapping or binding.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Map Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/schema/qudt/AssociativeArray"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Collection"}]},{"@id":"http://qudt.org/schema/qudt/MassPropertiesArray","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Mass Properties Array</em> holds, for an object, four values for the properties:\n   Center of Gravity, Mass, Moment of Inertia, and Product of Inertia. </p>\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Properties Array","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/HeterogenousArray"}]},{"@id":"http://qudt.org/schema/qudt/MathsFunctionType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A sub-type of 'QUDT Concept'.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Maths Function Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Concept"}]},{"@id":"http://qudt.org/schema/qudt/Matrix","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Matrix</em> is a data type that specifies the properties of an N-dimensional data structure.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Matrix","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Array"}]},{"@id":"http://qudt.org/schema/qudt/MatrixElementOrder","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A datatype that specifies the order in which matrix elements are arranged.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Matrix Element Order","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-192"},{"@id":"http://qudt.org/schema/qudt/StructuredDatatype"}]},{"@id":"http://qudt.org/schema/qudt/MemoryOrderType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A sub-type of 'Enumerated Value'.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Memory order type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}]},{"@id":"http://qudt.org/schema/qudt/ModalCue","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Modal Cue","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}]},{"@id":"http://qudt.org/schema/qudt/ModalEnumeration","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A sub-type of 'QUDT Enumeration'.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Modal Enumeration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Enumeration"}]},{"@id":"http://qudt.org/schema/qudt/MultiDimensionalArray","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Multi-Dimensional Array</em> is an extension of a standard one-dimensional array,\n   where elements are organized in a grid-like structure across two or more dimensions. \n  It is a collection of elements arranged in a tabular or multi-dimensional structure for representing complex datasets,\n   such as matrices, tensors, or higher-dimensional data.\n  </p>\n  <p>The elements of a multi-dimensional array are N-tuples, where 'N' corresponds to the dimensionality of the array.\n  Each element is specified using the property 'qudt:element'.\n  </p>\n  <p>Ordinary or one-dimensional arrays are indexed by a single integer. \n  For a multi-dimensional array, the index into the array uses an ordered list of integers, such as in 'a[3,1,5]'. \n  The length of the list of integers used to index into the multi-dimensional array is always the same.\n  This is referred to as the array's dimensionality. \n  The bounds on each of these are called the array's dimensions.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Multi-Dimensional Array Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Array"}]},{"@id":"http://qudt.org/schema/qudt/MultiDimensionalDataFormat","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  Data formats for storing and manipulating scalar and multidimensional data in a platform and discipline independent manner,\n   for example HDF, CDF and netCDF.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Multi dimensional data format","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/CompositeDatatype"}]},{"@id":"http://qudt.org/schema/qudt/MultiModalEnumeration","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A sub-type of 'QUDT Enumeration'.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Multi modal enumeration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-193"},{"@id":"_:n3-194"},{"@id":"_:n3-195"},{"@id":"_:n3-196"},{"@id":"http://qudt.org/schema/qudt/Enumeration"}]},{"@id":"http://qudt.org/schema/qudt/MultiModalType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A sub-type of 'Enumerated Value'.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Multi Modal Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-197"},{"@id":"_:n3-198"},{"@id":"_:n3-199"},{"@id":"_:n3-200"},{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}]},{"@id":"http://qudt.org/schema/qudt/MultiSet","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A bag is a set in which elements may be repeated.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bag","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Collection"}]},{"@id":"http://qudt.org/schema/qudt/N-Tuple","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A tuple containing n objects is known as an \"n-tuple\". \n  For example the 4-tuple (or \"quadruple\"), with components of respective types PERSON, DAY, MONTH and YEAR.\n  This could be used to record that a certain person was born on a certain day of a certain month of a certain year.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"N-Tuple Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-201"},{"@id":"http://qudt.org/schema/qudt/Tuple"}]},{"@id":"http://qudt.org/schema/qudt/N-TupleType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A tuple containing n objects is known as an \"n-tuple\". \n  For example the 4-tuple (or \"quadruple\"), with components of respective types PERSON, DAY, MONTH and YEAR.\n  This could be used to record that a certain person was born on a certain day of a certain month of a certain year.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"N-Tuple Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-202"},{"@id":"http://qudt.org/schema/qudt/Tuple"}]},{"@id":"http://qudt.org/schema/qudt/NIST_SP811_Comment","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"National Institute of Standards and Technology (NIST) Special Publication 811 Comments on some quantities and their units","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"NIST SP~811 Comment","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Comment"}]},{"@id":"http://qudt.org/schema/qudt/NominalScale","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A nominal scale differentiates between items or subjects based only on their names or (meta-)categories and other qualitative classifications they belong to;\n   thus dichotomous data involves the construction of classifications as well as the classification of items. \n  Discovery of an exception to a classification can be viewed as progress. \n  Numbers may be used to represent the variables but the numbers do not have numerical value or relationship:\n   for example, a Globally unique identifier. \n  Examples of these classifications include gender, nationality, ethnicity, language, genre, style, biological species, and form. \n  In a university one could also use hall of affiliation as an example.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Level_of_measurement","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Nominal scale","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/schema/qudt/IntervalScale"},{"@id":"http://qudt.org/schema/qudt/OrdinalScale"},{"@id":"http://qudt.org/schema/qudt/RatioScale"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Scale"}]},{"@id":"http://qudt.org/schema/qudt/NonNegativeIntegerUnionList","@type":["http://qudt.org/schema/qudt/List"],"http://www.w3.org/1999/02/22-rdf-syntax-ns#first":[{"@id":"http://www.w3.org/2001/XMLSchema#nonNegativeInteger"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#rest":[{"@id":"_:n3-424"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Non-negative union list","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/NumericType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"Numeric data types are data types whose values denote quantities as defined by a mathematical number system.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Numeric Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-203"},{"@id":"_:n3-204"},{"@id":"http://qudt.org/schema/qudt/ScalarDatatype"}]},{"@id":"http://qudt.org/schema/qudt/OctetType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"An 8 bit unsigned integer","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Octet Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/UnsignedIntegerType"}]},{"@id":"http://qudt.org/schema/qudt/OffOnStateTypeEnumeration","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A discrete state enumeration whose values are 'off' and 'on'. \n  The 'off' value is encoded as a zero (0) and the 'on' value as a one (1).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Enumeration"}]},{"@id":"http://qudt.org/schema/qudt/OnOffStateType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"On off state type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/DiscreteState"}]},{"@id":"http://qudt.org/schema/qudt/OnOffStateTypeEnumeration","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A discrete state enumeration whose values are 'off' and 'on'. \n  The 'on' value is encoded as a zero (0) and the 'off' value as a one (1).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/inverted":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Enumeration"}]},{"@id":"http://qudt.org/schema/qudt/OrderedCollection","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>An <em>Ordered Collection Kind</em> is an abstract data type that defines the properties of collection data structures whose members can be linearly ordered. \n  An ordered collection is a collection together with an ordering relation (such as greater than) that linearly orders the collection elements.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Ordered Collection Kind","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-205"},{"@id":"http://qudt.org/schema/qudt/Collection"}]},{"@id":"http://qudt.org/schema/qudt/OrderedTree","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>An \"Ordered Tree Type\" is a data type that defines the properties of data structures that represent ordered trees. \n  An ordered tree is a tree where the children of every node are ordered, that is, there is a first child, second child, third child, etc. \n  Typically a type specification for an ordered tree will include the comparison operator (such as <b>lt</b> or <b>gt</b>) that is used to order the nodes.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Ordered Tree Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/OrderedCollection"},{"@id":"http://qudt.org/schema/qudt/Tree"}]},{"@id":"http://qudt.org/schema/qudt/OrderedType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"Describes how a data or information structure is ordered.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Ordered type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}],"http://www.w3.org/2002/07/owl#oneOf":[{"@id":"_:n3-206"}]},{"@id":"http://qudt.org/schema/qudt/OrdinalScale","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>The ordinal type allows for rank order (1st, 2nd, 3rd, etc.) by which data can be sorted,\n   but still does not allow for relative degree of difference between them. \n  Examples include, on one hand, dichotomous data with dichotomous (or dichotomized) values such as:\n   'sick' vs. 'healthy' when measuring health, 'guilty' vs. 'innocent' when making judgments in courts,\n   'wrong/false' vs. 'right/true' when measuring truth value, and, on the other hand, non-dichotomous data consisting of a spectrum of values, such as:\n   'completely agree', 'mostly agree', 'mostly disagree', 'completely disagree' when measuring opinion.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Level_of_measurement","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Ordinal scale","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/schema/qudt/IntervalScale"},{"@id":"http://qudt.org/schema/qudt/NominalScale"},{"@id":"http://qudt.org/schema/qudt/RatioScale"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-209"},{"@id":"_:n3-210"},{"@id":"_:n3-211"},{"@id":"_:n3-212"},{"@id":"http://qudt.org/schema/qudt/Scale"}]},{"@id":"http://qudt.org/schema/qudt/OrdinalType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>An ordinal data type is a data type that specifies the properties of values that can easily be put in a one to one correspondence with a subset of the natural numbers. \n  Examples include boolean, character, and integer data types.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Ordinal Data Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/ScalarDatatype"}]},{"@id":"http://qudt.org/schema/qudt/Organization","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Organization","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-213"},{"@id":"_:n3-214"},{"@id":"http://qudt.org/schema/qudt/Concept"}]},{"@id":"http://qudt.org/schema/qudt/PaddingType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>This describes how unused bits of a field are filled. \n  Unused bits could be set to one or zero. \n  A third option is \"don't care\".\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Padding type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}],"http://www.w3.org/2002/07/owl#oneOf":[{"@id":"_:n3-215"}]},{"@id":"http://qudt.org/schema/qudt/ParameterModifiabilityType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"An enumeration of literals that signify whether a parameter is modifiable and if so, by whom.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Parameter modifiability type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}]},{"@id":"http://qudt.org/schema/qudt/PartialArray","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A partial array is an Array with two attributes that define the starting and ending indices of the elements that are provided.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Partial Array","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Array"}]},{"@id":"http://qudt.org/schema/qudt/PhysicalAddress","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A physical address is a pointer to a memory location.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Physical Address Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/CompositeDatatype"}]},{"@id":"http://qudt.org/schema/qudt/PhysicalConstant","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Physical constant</em> is a physical quantity that is generally believed to be both universal in nature and constant in time. \n  It can be contrasted with a mathematical constant, which is a fixed numerical value but does not directly involve any physical measurement. \n  </p>\n  <p>There are many physical constants in science, some of the most widely recognized being:\n   the speed of light in vacuum c, Newton's gravitational constant G, Planck's constant h,\n   the electric permittivity of free space ε0, and the elementary charge e.\n  </p>\n  <p>Physical constants can take many dimensional forms, or may be dimensionless depending on the system of quantities and units used.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Physical_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Physical Constant","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-218"},{"@id":"_:n3-219"},{"@id":"_:n3-220"},{"@id":"_:n3-221"},{"@id":"_:n3-222"},{"@id":"_:n3-223"},{"@id":"_:n3-224"},{"@id":"_:n3-225"},{"@id":"_:n3-226"},{"@id":"_:n3-227"},{"@id":"_:n3-228"},{"@id":"_:n3-229"},{"@id":"_:n3-230"},{"@id":"_:n3-231"},{"@id":"_:n3-232"},{"@id":"_:n3-233"},{"@id":"http://qudt.org/schema/qudt/Quantity"}]},{"@id":"http://qudt.org/schema/qudt/PlaneAngleUnit","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Plane Angle Unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/AngleUnit"}]},{"@id":"http://qudt.org/schema/qudt/Polarity","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A \"Tagged Enumeration\" with the following instance(s): \"negative\", \"positive\".\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Polarity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}]},{"@id":"http://qudt.org/schema/qudt/PositiveBigIntegerType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"Positive Integers are integers that are either non-zero and non-negative.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Positive Big Integer Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/IntegerDatatype"},{"@id":"http://qudt.org/schema/qudt/UnsignedType"}]},{"@id":"http://qudt.org/schema/qudt/PositiveIntegerType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"Positive Integers are integers that are either non-zero and non-negative.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Positive Integer Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/IntegerDatatype"},{"@id":"http://qudt.org/schema/qudt/UnsignedType"}]},{"@id":"http://qudt.org/schema/qudt/Prefix","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Prefix","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-234"},{"@id":"_:n3-235"},{"@id":"_:n3-236"},{"@id":"_:n3-237"},{"@id":"_:n3-238"},{"@id":"_:n3-239"},{"@id":"http://qudt.org/schema/qudt/Concept"},{"@id":"http://qudt.org/schema/qudt/Verifiable"}]},{"@id":"http://qudt.org/schema/qudt/Quantifiable","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p><em>Quantifiable</em> is an aspect class that affords to an entity properties for being measurable,\n   observable, or countable.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.linkedmodel.org/schema/vaem#isElaboratedIn":[{"@id":"http://qudt.org/3.5.2/schema/shacl/datatype"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"},{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Quantifiable","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-240"},{"@id":"_:n3-241"},{"@id":"_:n3-242"},{"@id":"_:n3-243"},{"@id":"_:n3-244"},{"@id":"_:n3-245"},{"@id":"_:n3-246"},{"@id":"_:n3-247"},{"@id":"_:n3-248"},{"@id":"_:n3-249"},{"@id":"http://qudt.org/schema/qudt/Aspect"}]},{"@id":"http://qudt.org/schema/qudt/Quantity","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <b>Quantity</b> is the measurement of an observable property of a particular object, event, or physical system. \n  A quantity is always associated with the context of measurement (i.e. the thing measured, the measured value, the accuracy of measurement, etc.) whereas the \n  underlying <b>quantity kind</b> is independent of any particular measurement. Thus, length is a quantity kind while the height of a rocket is a specific \n  quantity of length; its magnitude that may be expressed in meters, feet, inches, etc. Examples of physical quantities include physical constants, such as \n  the speed of light in a vacuum, Planck's constant, the electric permittivity of free space, and the fine structure constant. </p>\n<p>In other words, quantities are quantifiable aspects of the world, such as the duration of a movie, the distance between two points, \nvelocity of a car, the pressure of the atmosphere, and a person's weight; and units are used to describe their numerical measure.</p> \n<p>Many <b>quantity kinds</b> are related to each other by various physical laws, and as a result, the associated units of some quantity \nkinds can be expressed as products (or ratios) of powers of other quantity kinds (e.g., momentum is mass times velocity and velocity is defined as distance \ndivided by time). In this way, some quantities can be calculated from other measured quantities using their associations to the quantity kinds in these \nexpressions. These quantity kind relationships are also discussed in dimensional analysis. Those that cannot be so expressed can be regarded \nas \"fundamental\" in this sense.</p>\n<p>A quantity is distinguished from a \"quantity kind\" in that the former carries a value and the latter is a type specifier.\n</p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Quantity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Quantity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-250"},{"@id":"_:n3-251"},{"@id":"_:n3-252"},{"@id":"_:n3-253"},{"@id":"http://qudt.org/schema/qudt/Concept"},{"@id":"http://qudt.org/schema/qudt/Quantifiable"},{"@id":"http://qudt.org/schema/qudt/Verifiable"}]},{"@id":"http://qudt.org/schema/qudt/QuantityKind","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Quantity Kind</em> is any observable property that can be  measured and quantified numerically. \n  Familiar examples include physical properties such as length, mass, time, force, energy, power, electric charge, etc. \n  Less familiar examples include currency, interest rate, price to earning ratio, and information capacity.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=112-01-04","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Quantity Kind","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-254"},{"@id":"_:n3-255"},{"@id":"_:n3-256"},{"@id":"_:n3-257"},{"@id":"_:n3-258"},{"@id":"_:n3-259"},{"@id":"_:n3-260"},{"@id":"_:n3-261"},{"@id":"_:n3-262"},{"@id":"_:n3-263"},{"@id":"_:n3-264"},{"@id":"_:n3-265"},{"@id":"_:n3-266"},{"@id":"_:n3-267"},{"@id":"_:n3-268"},{"@id":"_:n3-269"},{"@id":"_:n3-270"},{"@id":"_:n3-271"},{"@id":"_:n3-272"},{"@id":"_:n3-273"},{"@id":"_:n3-274"},{"@id":"_:n3-275"},{"@id":"_:n3-276"},{"@id":"_:n3-277"},{"@id":"_:n3-278"},{"@id":"_:n3-279"},{"@id":"_:n3-280"},{"@id":"_:n3-281"},{"@id":"_:n3-282"},{"@id":"_:n3-283"},{"@id":"_:n3-284"},{"@id":"_:n3-285"},{"@id":"_:n3-286"},{"@id":"http://qudt.org/schema/qudt/AbstractQuantityKind"},{"@id":"http://qudt.org/schema/qudt/Verifiable"}]},{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n $\\text{Quantity Kind Dimension Vector}$ describes the dimensionality of a quantity kind in the context of a system of units. \n In the SI system of units, the dimensions of a quantity kind are expressed as a product of the basic\n  physical dimensions mass ($M$), length ($L$), time ($T$) current ($I$), amount of substance ($N$),\n   luminous intensity ($J$) and absolute temperature \n   ($\\theta$) as $dim \\, Q = L^{\\alpha} \\, M^{\\beta} \\, T^{\\gamma} \\, I ^{\\delta} \\, \\theta ^{\\epsilon} \\, N^{\\eta} \\, J ^{\\nu}$.\n\n\n  The rational powers of the dimensional exponents, $\\alpha, \\, \\beta, \\, \\gamma, \\, \\delta, \\, \\epsilon, \\, \\eta, \\, \\nu$, are positive, negative, or zero.\n\n  For example, the dimension of the physical quantity kind $\\it{speed}$ is $\\boxed{length/time}$, $L/T$ or $LT^{-1}$,\n   and the dimension of the physical quantity kind force is $\\boxed{mass \\times acceleration}$ or $\\boxed{mass \\times (length/time)/time}$, $ML/T^2$ or $MLT^{-2}$ respectively.\n ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://web.mit.edu/2.25/www/pdf/DA_unified.pdf","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Dimensional_analysis","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Quantity Kind Dimension Vector","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-287"},{"@id":"_:n3-288"},{"@id":"_:n3-289"},{"@id":"_:n3-290"},{"@id":"_:n3-291"},{"@id":"_:n3-292"},{"@id":"_:n3-293"},{"@id":"http://qudt.org/schema/qudt/Concept"}]},{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A <em>CGS Dimension Vector</em> is used to specify the dimensions for a C.G.S. quantity kind.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"CGS Dimension vector","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector"}]},{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS-EMU","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A <em>CGS EMU Dimension Vector</em> is used to specify the dimensions for EMU C.G.S. quantity kind.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"CGS EMU Dimension vector","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS"}]},{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS-ESU","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A <em>CGS ESU Dimension Vector</em> is used to specify the dimensions for ESU C.G.S. quantity kind.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"CGS ESU Dimension vector","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS"}]},{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS-GAUSS","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A <em>CGS GAUSS Dimension Vector</em> is used to specify the dimensions for Gaussioan C.G.S. quantity kind.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"CGS GAUSS Dimension vector","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS"}]},{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS-LH","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A <em>CGS LH Dimension Vector</em> is used to specify the dimensions for Lorentz-Heaviside C.G.S. quantity kind.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"CGS LH Dimension vector","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector_CGS"}]},{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector_ISO","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"ISO Dimension vector","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector"}]},{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector_Imperial","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Imperial dimension vector","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector"}]},{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Quantity Kind Dimension vector (SI)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector"}]},{"@id":"http://qudt.org/schema/qudt/QuantityKindList","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Quantity Kind List</em> is a list of qudt:QuantityKind. \n  They are used, for instance, to specify the quantity kind in a Mass Properties Array. \n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Quantity kind List","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/List"}]},{"@id":"http://qudt.org/schema/qudt/QuantityType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A $\\textit{Quantity Type}$ is an enumeration of quantity kinds. \n  It specializes $\\boxed{dtype:EnumeratedValue}$ by constrinaing $\\boxed{dtype:value}$ to instances of $\\boxed{qudt:QuantityKind}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Quantity type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-294"},{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}]},{"@id":"http://qudt.org/schema/qudt/QuantityValue","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Quantity Value</em> \n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Quantity value","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Concept"},{"@id":"http://qudt.org/schema/qudt/Quantifiable"},{"@id":"http://qudt.org/schema/qudt/Verifiable"}]},{"@id":"http://qudt.org/schema/qudt/QuantityValueType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A sub-type of 'Dimensional Data Type'.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Quantity value type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-295"},{"@id":"http://qudt.org/schema/qudt/DimensionalDatatype"}]},{"@id":"http://qudt.org/schema/qudt/RatioScale","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Ratio Scale</em> possesses a meaningful (unique and non-arbitrary) zero value. \n  Most measurement in the physical sciences and engineering is done on ratio scales. \n  Examples include mass, length, duration, plane angle, energy and electric charge.\n  </p>\n  <p>In contrast to interval scales, ratios are now meaningful because having a non-arbitrary zero point makes it meaningful to say,\n   for example, that one object has \"twice the length\" of another (= is \"twice as long\"). \n  Very informally, many ratio scales can be described as specifying \"how much\" of something (i.e. an amount or magnitude) or \"how many\" (a count). \n  The Kelvin temperature scale is a ratio scale because it has a unique, non-arbitrary zero point called absolute zero.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Level_of_measurement","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Ratio scale","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/schema/qudt/IntervalScale"},{"@id":"http://qudt.org/schema/qudt/NominalScale"},{"@id":"http://qudt.org/schema/qudt/OrdinalScale"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Scale"}]},{"@id":"http://qudt.org/schema/qudt/RawValueTupleMember","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A sub-type of 'Tuple Member Type'.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Raw value tuple member","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/TupleMember"}]},{"@id":"http://qudt.org/schema/qudt/RawValueTupleMemberType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Raw value tuple member type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/TupleMember"}]},{"@id":"http://qudt.org/schema/qudt/RealDatatype","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A real number is represented as a factor, called the mantissa, multiplied by a power (the exponent) of a base. \n  Different bases yield different approximations to real numbers, and conversion between them is limited in accuracy.\n  Four floating-point types are defined in 'IEEE-754 Standard for Binary Floating-Point'. \n  These types are 'single', 'extended single', 'double', and 'extended double'.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Real Datatype","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-296"},{"@id":"_:n3-297"},{"@id":"_:n3-298"},{"@id":"http://qudt.org/schema/qudt/NumericType"}]},{"@id":"http://qudt.org/schema/qudt/RealDoublePrecisionType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A real double precision data type specifies how a real number, or an approximation of a real number is stored in memory.\n  Typically this occupies two words in computer memory, where the byte length of a word depends on machine address size of the computer processor. \n  For example, on 32-bit machine architectures, a word is four bytes.\n  An example of a real double precision data type specification is the IEEE 754 standard for encoding binary or decimal floating point numbers in 8 bytes for storage on 32-bit machine architectures.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Real Double Precision Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/DoublePrecisionType"},{"@id":"http://qudt.org/schema/qudt/RealDatatype"}]},{"@id":"http://qudt.org/schema/qudt/RealNumberType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Real Number Type</em> is the class of data values that approximate real numbers in finite precision. \n  Often, such values are expressed in \"mantissa, base, exponent\" form. \n  Any rational number can be expressed in the form m*b^<sup>e</sup>, where m (the mantissa), b (the base), and e (the exponent) are integers. \n  Typically, b is chosen to be either 2 or 10, and then the values of m and e are determined given the choice of base.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Real number type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/RealDatatype"}]},{"@id":"http://qudt.org/schema/qudt/RealSinglePrecisionType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A real single precision data type specifies how a real number,\n   or an approximation of a real number is stored in memory that occupies one word in computer memory, \n   where the byte length of a word depends on machine address size of the computer processor.\n  </p>\n  <p> \n  For example, on 32-bit machine architectures, a word is four bytes. \n  An example of a real single precision data type specification is the IEEE 754 standard for encoding binary\n   or decimal floating point numbers in 4 bytes for storage on 32-bit machine architectures.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Real Single Precision Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/RealDatatype"},{"@id":"http://qudt.org/schema/qudt/SinglePrecisionType"}]},{"@id":"http://qudt.org/schema/qudt/Record","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A Record Type is a type whose values are records, i.e. aggregates of several items of possibly different types. \n  The aggregated items are called fields or members and are usually identified or indexed by field labels.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Record Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/CompositeDatatype"}]},{"@id":"http://qudt.org/schema/qudt/ReferenceDatatype","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A reference is an object containing information which refers to data stored elsewhere, as opposed to containing the data itself. \n  A reference data type is a data type that specifies how a reference is represented and stored in memory,\n   as well as the operations that can be performed on reference values. \n  The most common example of a reference data type is a pointer.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Reference Data Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/StructuredDatatype"}]},{"@id":"http://qudt.org/schema/qudt/Rule","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Rule","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-299"},{"@id":"_:n3-300"},{"@id":"_:n3-301"},{"@id":"http://qudt.org/schema/qudt/Concept"},{"@id":"http://qudt.org/schema/qudt/Verifiable"}]},{"@id":"http://qudt.org/schema/qudt/RuleType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Rule Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}]},{"@id":"http://qudt.org/schema/qudt/ScalarDataItem","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Data Item</em> holds a value that is compliant with a specified <em>Datatype</em>.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Scalar Data Item","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-302"},{"@id":"_:n3-303"},{"@id":"http://qudt.org/schema/qudt/Concept"}]},{"@id":"http://qudt.org/schema/qudt/ScalarDatatype","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  Scalar data types are those that have a single value. \n  The permissible values are defined over a domain that may be integers, float, character or boolean. \n  Often a scalar data type is referred to as a primitive data type.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/vaem#isElaboratedIn":[{"@id":"http://qudt.org/3.5.2/schema/shacl/datatype"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"},{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Scalar Datatype","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-304"},{"@id":"_:n3-305"},{"@id":"_:n3-306"},{"@id":"_:n3-307"},{"@id":"_:n3-308"},{"@id":"_:n3-309"},{"@id":"_:n3-310"},{"@id":"_:n3-311"},{"@id":"_:n3-312"},{"@id":"http://qudt.org/schema/qudt/Datatype"},{"@id":"http://www.w3.org/2000/01/rdf-schema#Datatype"}]},{"@id":"http://qudt.org/schema/qudt/ScalarListShape","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/List"}]},{"@id":"http://qudt.org/schema/qudt/Scale","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>Scales (also called \"scales of measurement\" or \"levels of measurement\") are expressions that typically are based on scale types.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Scale","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-313"},{"@id":"_:n3-314"},{"@id":"_:n3-315"},{"@id":"_:n3-316"},{"@id":"_:n3-317"},{"@id":"_:n3-318"},{"@id":"http://qudt.org/schema/qudt/Concept"},{"@id":"http://qudt.org/schema/qudt/Verifiable"}]},{"@id":"http://qudt.org/schema/qudt/ScaleType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\n  Scales, or scales of measurement (or categorization) provide ways of quantifying measurements, values and other enumerated values according to a normative frame of reference. \n  Four different types of scales are typically used. \n  These are interval, nominal, ordinal and ratio scales.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Scale type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-319"},{"@id":"_:n3-320"},{"@id":"_:n3-321"},{"@id":"_:n3-322"},{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}]},{"@id":"http://qudt.org/schema/qudt/Sequence","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Sequence</em> is an enumerated collection of objects in which repetitions are allowed. \n  Like a set, it contains members (also called elements, or terms). \n  The number of elements (possibly infinite) is called the length of the sequence.\n  </p>\n  <p>Unlike a set, order matters, and exactly the same elements can appear multiple times at different positions in the sequence. \n  Formally, a sequence can be defined as a function whose domain is either the set of the natural numbers (for infinite sequences) or the set of the first n natural numbers (for a sequence of finite length n). \n  </p>\n  <p>The position of an element in a sequence is its rank or index; it is the integer from which the element is the image. \n  It depends on the context or of a specific convention, if the first element has index 0 or 1. [Wikipedia]\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Sequence","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Collection"}]},{"@id":"http://qudt.org/schema/qudt/Set","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Set</em> is an abstract data type that defines the properties of sets. \n  A set is a collection (container) of certain values, without any particular order, and no repeated values. \n  It corresponds with a finite set in mathematics.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Set Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Collection"}]},{"@id":"http://qudt.org/schema/qudt/ShortIntegerType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A Short Integer is an integer that can be represented in two octets (16 bits) of machine memory. \n  Short integers may be signed or unsigned.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Short Integer Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/IntegerDatatype"}]},{"@id":"http://qudt.org/schema/qudt/SignedBigIntegerType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A Signed Big Integer is a signed integer that can be represented in eight octets (64 bits) of machine memory.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Signed Big Integer Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/BigIntegerType"},{"@id":"http://qudt.org/schema/qudt/SignedIntegerType"}]},{"@id":"http://qudt.org/schema/qudt/SignedIntegerType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"Signed Integers are integers can take on both positive and negative values.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Signed Integer Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/IntegerDatatype"},{"@id":"http://qudt.org/schema/qudt/SignedType"}]},{"@id":"http://qudt.org/schema/qudt/SignedLongIntegerType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A Signed Long Integer is a signed integer that can be represented in four octets (32 bits) of machine memory.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Signed Long Integer Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/LongIntegerType"},{"@id":"http://qudt.org/schema/qudt/SignedIntegerType"}]},{"@id":"http://qudt.org/schema/qudt/SignedMediumIntegerType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A \"Signed Medium Integers\" is an integer of 24 bits that can take on both positive and negative values.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Signed Integer Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/SignedIntegerType"}]},{"@id":"http://qudt.org/schema/qudt/SignedShortIntegerType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A Signed Short Integer is a signed integer that can be represented in four octets (32 bits) of machine memory.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Signed Short Integer Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/ShortIntegerType"},{"@id":"http://qudt.org/schema/qudt/SignedIntegerType"}]},{"@id":"http://qudt.org/schema/qudt/SignedType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A signed type is a numeric type that distinguishes between positive and negative numbers using an encoding scheme, such as sign and magnitude, one's compliment, and two's compliment to represent negative numbers.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Signed Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/NumericType"}]},{"@id":"http://qudt.org/schema/qudt/SignedVariableLengthIntegerType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A Signed Variable Length Integer data type defines a data structure for representing signed integers that uses a variable number of bits depending on the magnitude of the integer. Typically, variable length integer data types are between one and 64 bits in length.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Signed Variable Length Integer Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/SignedIntegerType"},{"@id":"http://qudt.org/schema/qudt/VariableLengthIntegerType"}]},{"@id":"http://qudt.org/schema/qudt/SignednessType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"Specifics whether a value should be signed or unsigned.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Signedness type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}],"http://www.w3.org/2002/07/owl#oneOf":[{"@id":"_:n3-323"}]},{"@id":"http://qudt.org/schema/qudt/SinglePrecisionType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A single precision data type specifies how a numeric value, such as an integer or real number,\n   is stored in memory that occupies one word in computer memory,\n   where the byte length of a word depends on machine address size of the computer processor. \n  For example, on 32-bit machine architectures, a word is four bytes.\n  A single precision data value on a 32-bit machine architecture occupies four bytes of memory.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Single Precision Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/NumericType"}]},{"@id":"http://qudt.org/schema/qudt/SolidAngleUnit","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  The solid angle subtended by a surface S is defined as the surface area of a unit sphere covered by the surface S's projection onto the sphere. \n  A solid angle is related to the surface of a sphere in the same way an ordinary angle is related to the circumference of a circle. \n  Since the total surface area of the unit sphere is 4*pi, the measure of solid angle will always be between 0 and 4*pi.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Solid Angle Unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/AngleUnit"}]},{"@id":"http://qudt.org/schema/qudt/SplineCalibrator","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A sub-type of 'Map Type'.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Spline calibrator","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Map"}]},{"@id":"http://qudt.org/schema/qudt/SplinePoint","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A sub-type of 'Tuple Type'.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Spline point","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Tuple"}]},{"@id":"http://qudt.org/schema/qudt/StateSpaceMatrix","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>In control engineering, a state space representation is a mathematical model of a physical system\n   as a set of input, output and state variables related by first-order differential equations. \n  To abstract from the number of inputs, outputs and states, the variables are expressed as vectors.\n  The differential and algebraic equations are written in matrix form (the last one can be done when the dynamical system is linear and time invariant).\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"State Space Matrix Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Matrix"}]},{"@id":"http://qudt.org/schema/qudt/Statement","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Statement","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"}]},{"@id":"http://qudt.org/schema/qudt/StringEncodingType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p><em>String Encoding Type</em> is an \"Encoding\" with the following instance(s):\n   \"UTF-16 String\", \"UTF-8 Encoding\".\n   </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"},{"@value":"\n  An \"Encoding\" with the following instance(s): \"datatype:UTF8-StringEncoding\", \"datatype:UTF16-StringEncoding\".\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"String Encoding Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Encoding"}]},{"@id":"http://qudt.org/schema/qudt/StringType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>String Type</em> is a data type that specifies the properties of a list structure that holds characters.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"String Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-325"},{"@id":"_:n3-326"},{"@id":"http://qudt.org/schema/qudt/ScalarDatatype"}]},{"@id":"http://qudt.org/schema/qudt/StringUTF16","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p><em>String UTF-16</em> is a string data type that specifies the properties of string data structures which encode strings using the UTF-16 encoding. \n  UTF-16 is the native internal representation of text in many software systems, for example:\n  </p>\n  <ol>\n  <li>Microsoft Windows NT/Windows 2000/Windows XP/Windows CE;</li>\n  <li>Qualcomm BREW, and Symbian operating systems;</li>\n  <li>the Java and .NET byte code environments;</li>\n  <li>Mac OS X's Cocoa and Core Foundation frameworks;</li>\n  <li>Qt cross-platform graphical widget toolkit.</li>\n  </ol>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"String UTF16","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/StringType"},{"@id":"http://qudt.org/schema/qudt/TextStringType"}]},{"@id":"http://qudt.org/schema/qudt/StringUTF8","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  String UTF-8 Type is a string data type that specifies the properties of string data structures which encode strings using the UTF-8 encoding. \n  UTF-8 includes ASCII, otherwise referred to as IA-5 (International Alphabet 5, as standardized by International Organization for Standardization [ISO]) as the first 128 values. \n  The Internet Engineering Task Force (IETF) requires all Internet protocols to identify the encoding used for character data with UTF-8 as at least one supported encoding. \n  The Internet Mail Consortium (IMC) recommends that all e-mail programs must be able to display and create mail using UTF-8.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/vaem#isElaboratedIn":[{"@id":"http://qudt.org/3.5.2/schema/shacl/datatype"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"String UTF8 Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/StringType"},{"@id":"http://qudt.org/schema/qudt/TextStringType"}]},{"@id":"http://qudt.org/schema/qudt/StructuredDatatype","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Structured Datatype</em>, in contrast to a scalar data type, is used to characterize classes of complex data structures.\n  Examples are collections, linked and indexed lists, trees, ordered trees, and multi-dimensional file formats.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Structured Data Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-327"},{"@id":"http://qudt.org/schema/qudt/Datatype"}]},{"@id":"http://qudt.org/schema/qudt/Symbol","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Symbol","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Concept"}]},{"@id":"http://qudt.org/schema/qudt/SymmetricRelation","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"A `SymmetricRelation` is modeling construct used to define symmetric behavior for appropriate relations.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Symmetric relation","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"}]},{"@id":"http://qudt.org/schema/qudt/SystemOfQuantityKinds","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>System of Quantity Kinds</em> is a set of one or more quantity kinds together with a set of zero or more algebraic equations that define relationships between quantity kinds in the set. \n  In the physical sciences, the equations relating quantity kinds are typically physical laws and definitional relations, and constants of proportionality. \n  Examples include Newton's First Law of Motion, Coulomb's Law, and the definition of velocity as the instantaneous change in position.  \n  In almost all cases, the system identifies a subset of base quantity kinds. \n  </p>\n  <p>The base set is chosen so that all other quantity kinds of interest can be derived from the base quantity kinds and the algebraic equations. \n  If the unit system is explicitly associated with a quantity kind system, then the unit system must define at least one unit for each quantity kind.  \n  From a scientific point of view, the division of quantities into base quantities and derived quantities is a matter of convention.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"System of Quantity Kinds","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-328"},{"@id":"_:n3-329"},{"@id":"_:n3-330"},{"@id":"_:n3-331"},{"@id":"_:n3-332"},{"@id":"_:n3-333"},{"@id":"_:n3-334"},{"@id":"_:n3-335"},{"@id":"_:n3-336"},{"@id":"_:n3-337"},{"@id":"http://qudt.org/schema/qudt/Concept"},{"@id":"http://qudt.org/schema/qudt/Verifiable"}]},{"@id":"http://qudt.org/schema/qudt/SystemOfUnits","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>System of Units</em> is a set of units which are chosen as the reference scales for some set of quantity kinds together with the definitions of each unit. \n  Units may be defined by experimental observation or by proportion to another unit not included in the system. \n  If the unit system is explicitly associated with a quantity kind system, then the unit system must define at least one unit for each quantity kind.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://dbpedia.org/resource/Category:Systems_of_units","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.ieeeghn.org/wiki/index.php/System_of_Measurement_Units","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"System of Units","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-338"},{"@id":"_:n3-339"},{"@id":"_:n3-340"},{"@id":"_:n3-341"},{"@id":"_:n3-342"},{"@id":"_:n3-343"},{"@id":"_:n3-344"},{"@id":"_:n3-345"},{"@id":"_:n3-346"},{"@id":"http://qudt.org/schema/qudt/Concept"},{"@id":"http://qudt.org/schema/qudt/Verifiable"}]},{"@id":"http://qudt.org/schema/qudt/Table","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A Table Type is a data type that specifies the properties of table data structures. \n  A table is both a mode of visual communication and a means of arranging data. \n  The precise conventions and terminology for describing tables varies depending on the context. \n  Moreover, tables differ significantly in variety, structure, flexibility, notation, representation and use.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Table Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-347"},{"@id":"_:n3-348"},{"@id":"_:n3-349"},{"@id":"_:n3-350"},{"@id":"http://qudt.org/schema/qudt/StructuredDatatype"}]},{"@id":"http://qudt.org/schema/qudt/TaggedEnumeration","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"An enumeration where each literal  has a tag that is a non-negative integer. These enumerations are likely to have their literals encoded - hence the need for the tag.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Tagged Enumeration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Enumeration"}]},{"@id":"http://qudt.org/schema/qudt/TextStringType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A <em>Text String Type</em> has encodings that are specified in subclasses or in connection to character arrays in <em>Structured Datatypes</em>.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Text String Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/StringType"}]},{"@id":"http://qudt.org/schema/qudt/TextTypeUnion","@type":["http://qudt.org/schema/qudt/List"],"http://purl.org/dc/terms/description":[{"@value":"\n  An rdf:List that can be used in property constraints as value for sh:or to indicate that all values of a property\n   must be a plain string, a string with HTML markup, or a string with LaTeX markup.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#first":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#rest":[{"@id":"_:n3-425"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Text Type Union","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/ThreeTuple","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A three-tuple is a tuple with exactly three members. \n  A Three-Tuple Type is a data type that defines the type properties of a class of three-tuples and their members.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Three-Tuple","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-351"},{"@id":"http://qudt.org/schema/qudt/N-Tuple"}]},{"@id":"http://qudt.org/schema/qudt/Time","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"The class of data values that denote a point in time. Time values may be encoded in a 12-hour clock or a 24-hour clock, such as 1:35 AM, or 13:35.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Time","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/ScalarDatatype"}]},{"@id":"http://qudt.org/schema/qudt/TimeDataType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A sub-type of 'QUDT Enumeration'.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#value":[{"@id":"http://qudt.org/vocab/datatype/TIME"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Time data type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Enumeration"},{"@id":"http://qudt.org/schema/qudt/ScalarDatatype"}]},{"@id":"http://qudt.org/schema/qudt/TimeInterval","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A relative interval that is an increment in time. \n  For example, this is used in time series arrays to express the time point of a vector of values.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Time interval","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Concept"}]},{"@id":"http://qudt.org/schema/qudt/TimeSeriesArray","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A Time Series Array is a data type that specifies the properties of arrays that hold time series data. \n  A time series is a sequence of data points, measured at successive time intervals. \n  The time intervals may be uniformly or non-uniformly spaced.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Time Series Array","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-352"},{"@id":"_:n3-353"},{"@id":"_:n3-354"},{"@id":"_:n3-355"},{"@id":"_:n3-356"},{"@id":"_:n3-357"},{"@id":"http://qudt.org/schema/qudt/Array"}]},{"@id":"http://qudt.org/schema/qudt/TimeSeriesArrayType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Time Series Array Type</em> is a data type that specifies the properties of arrays that hold time series data. \n  A time series is a sequence of data points, measured at successive time intervals. \n  The time intervals may be uniformly or non-uniformly spaced.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Time Series Array Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/ArrayType"}]},{"@id":"http://qudt.org/schema/qudt/TimeStringType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"Time takes a number of forms, depending on the units used (e.g., year, day, minute, millisecond, or combinations thereof) and the origin (i.e., time zero) to which the time value is related.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Time Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/DateTimeStringType"},{"@id":"http://qudt.org/schema/qudt/TextStringType"}]},{"@id":"http://qudt.org/schema/qudt/TransformType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Transform type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@value":"Transform type","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/Tree","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A \"Tree\" is a data type that defines the properties of data structures that represent trees. \n  Each node is either a leaf or an internal node. \n  An internal node has one or more child nodes and is called the parent of its child nodes. \n  Leaf nodes have no chidren. Nodes that share the same parent are siblings. \n  In graph theoretic terminology, a tree is a connected, undirected, acyclic graph.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Tree Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Graph"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"http://en.wikipedia.org/wiki/Tree_(data_structure)"}]},{"@id":"http://qudt.org/schema/qudt/Triplet","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A \"Tuple\".","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Triplet","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/schema/qudt/ThreeTuple"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/ThreeTuple"}]},{"@id":"http://qudt.org/schema/qudt/Tuple","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>The term <em>Tuple</em> originated as an abstraction of the sequence: single, double, triple, quadruple, quintuple, n-tuple. \n  In mathematics, a tuple is a finite sequence (also known as an <em>Ordered List</em> of objects, each of a specified type. \n  The <em>n</em> can be any non-negative integer.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Tuple","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-358"},{"@id":"_:n3-359"},{"@id":"_:n3-360"},{"@id":"http://qudt.org/schema/qudt/CompositeDatatype"}]},{"@id":"http://qudt.org/schema/qudt/TupleMember","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p><em>Tuple Member</em> defines the properties of a member of a tuple. \n  It is used to provide fine grained type specification to the elements of tuples.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Tuple Member Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/CompositeDatatype"}]},{"@id":"http://qudt.org/schema/qudt/TupleType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p><em>Tuple</em> originated as an abstraction of the sequence: single, double, triple, quadruple, quintuple, n-tuple.  \n  In mathematics, a tuple is a finite sequence (also known as an <em>Ordered List</em> of objects, each of a specified type. \n  The <em>n</em> can be any non-negative integer.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Tuple Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-361"},{"@id":"_:n3-362"},{"@id":"_:n3-363"},{"@id":"http://qudt.org/schema/qudt/CompositeDatatype"}]},{"@id":"http://qudt.org/schema/qudt/TwoTuple","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A 2-tuple is called a pair. \n  For example, a complex number can be represented as a 2-tuple.\n  2D coordinates are sometimes represented as 2-tuples.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Two-Tuple","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-364"},{"@id":"http://qudt.org/schema/qudt/N-Tuple"}]},{"@id":"http://qudt.org/schema/qudt/TwoTupleType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A 2-tuple is called a pair. For example, a complex number can be represented as a 2-tuple, and 2D coordinates are sometimes represented as 2-tuples.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Two-Tuple Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-365"},{"@id":"http://qudt.org/schema/qudt/N-TupleType"}]},{"@id":"http://qudt.org/schema/qudt/TypeList","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A sub-type of 'QUDT Datatype'.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Type list","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Datatype"}]},{"@id":"http://qudt.org/schema/qudt/TypeMatrix","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  Members of this class are matrix data structures that describe the datatypes of a class of matrices. \n  That is, the members of this class are matrices with cells that contain datatypes (c.f. type:Datatype) and are used to describe the datatype structure of other matrices.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Type matrix","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Matrix"}]},{"@id":"http://qudt.org/schema/qudt/TypeVector","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Type Vector</em> is a vector whose elements are data types. \n  They are used to specify the type of each component of a vector or class of vectors. \n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Type vector","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Vector"}]},{"@id":"http://qudt.org/schema/qudt/UCUMcs","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype","http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"Lexical pattern for the case-sensitive version of UCUM code","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://purl.org/dc/terms/source":[{"@id":"https://ucum.org/ucum.html"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"case-sensitive UCUM code","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://ucum.org/ucum.html"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/Unit","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A unit of measure, or unit, is a particular quantity value that has been chosen as a scale for measuring other quantities the same kind (more generally of equivalent dimension). \n  For example, the meter is a quantity of length that has been rigorously defined and standardized by the BIPM (International Board of Weights and Measures). \n  Any measurement of the length can be expressed as a number multiplied by the unit meter. \n  More formally, the value of a physical quantity Q with respect to a unit (U) is expressed as the scalar multiple of a real number (n) and U, as  $Q = nU$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://dbpedia.org/resource/Category:Units_of_measure","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.allmeasures.com/Fullconversion.asp","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-366"},{"@id":"_:n3-367"},{"@id":"_:n3-368"},{"@id":"_:n3-369"},{"@id":"_:n3-370"},{"@id":"_:n3-371"},{"@id":"_:n3-372"},{"@id":"_:n3-373"},{"@id":"_:n3-374"},{"@id":"_:n3-375"},{"@id":"_:n3-376"},{"@id":"_:n3-377"},{"@id":"_:n3-378"},{"@id":"_:n3-379"},{"@id":"_:n3-380"},{"@id":"_:n3-381"},{"@id":"_:n3-382"},{"@id":"_:n3-383"},{"@id":"_:n3-384"},{"@id":"_:n3-385"},{"@id":"_:n3-386"},{"@id":"_:n3-387"},{"@id":"_:n3-388"},{"@id":"_:n3-389"},{"@id":"_:n3-390"},{"@id":"_:n3-391"},{"@id":"_:n3-392"},{"@id":"_:n3-393"},{"@id":"_:n3-394"},{"@id":"_:n3-395"},{"@id":"_:n3-396"},{"@id":"_:n3-397"},{"@id":"_:n3-398"},{"@id":"_:n3-399"},{"@id":"_:n3-400"},{"@id":"_:n3-401"},{"@id":"_:n3-402"},{"@id":"_:n3-403"},{"@id":"_:n3-404"},{"@id":"_:n3-405"},{"@id":"_:n3-406"},{"@id":"_:n3-407"},{"@id":"_:n3-408"},{"@id":"http://qudt.org/schema/qudt/Concept"},{"@id":"http://qudt.org/schema/qudt/Verifiable"}]},{"@id":"http://qudt.org/schema/qudt/UnsignedBigIntegerType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"An Unsgned Big Integer is an unsigned integer that can be represented in eight octets (64 bits) of machine memory.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unsigned Big Integer Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/BigIntegerType"},{"@id":"http://qudt.org/schema/qudt/UnsignedIntegerType"}]},{"@id":"http://qudt.org/schema/qudt/UnsignedIntegerType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"Unsgned Integers are integers that are either strictly non-negative or non-positive.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unsigned Integer Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/IntegerDatatype"},{"@id":"http://qudt.org/schema/qudt/UnsignedType"}]},{"@id":"http://qudt.org/schema/qudt/UnsignedLongIntegerType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"An Unsigned Long Integer is an unsigned integer that can be represented in four octets (32 bits) of machine memory.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unsigned Long Integer Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/LongIntegerType"},{"@id":"http://qudt.org/schema/qudt/UnsignedIntegerType"}]},{"@id":"http://qudt.org/schema/qudt/UnsignedMediumIntegerType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  An \"Unsigned Medium Integer\" is an integer of 24 bits that only takes on both positive values.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unsigned Medium Integer Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/UnsignedIntegerType"}]},{"@id":"http://qudt.org/schema/qudt/UnsignedShortIntegerType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"An Unsigned Short Integer is an unsigned integer that can be represented in four octets (32 bits) of machine memory.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unsigned Short Integer Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/ShortIntegerType"},{"@id":"http://qudt.org/schema/qudt/UnsignedIntegerType"}]},{"@id":"http://qudt.org/schema/qudt/UnsignedType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"An unsigned data type is a numeric type that does not distinguish between positive and negative values.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unsigned Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/NumericType"}]},{"@id":"http://qudt.org/schema/qudt/UnsignedVariableLengthIntegerType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  An \"Unsigned Variable Length Integer\" data type defines a data structure for representing unsigned integers that uses a variable number of bits depending on the magnitude of the integer. \n  Typically, variable length integer data types are between one and 64 bits in length.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unsigned Variable Length Integer Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/UnsignedIntegerType"},{"@id":"http://qudt.org/schema/qudt/VariableLengthIntegerType"}]},{"@id":"http://qudt.org/schema/qudt/UserModifiableParameter","@type":["http://qudt.org/schema/qudt/ParameterModifiabilityType"],"http://purl.org/dc/terms/description":[{"@value":"Parameter is modifiable by a user.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#code":[{"@value":"2","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.linkedmodel.org/schema/dtype#literal":[{"@value":"user","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"User modifiable parameter","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/UserQuantityKind","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"User Quantity Kind","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-409"},{"@id":"_:n3-410"},{"@id":"_:n3-411"},{"@id":"_:n3-412"},{"@id":"http://qudt.org/schema/qudt/AbstractQuantityKind"}]},{"@id":"http://qudt.org/schema/qudt/VariableIntervalTimeSeriesArray","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A Variable Interval Time Series Array Type is a data type that specifies the properties of arrays that hold time series data that has been sampled over non-uniformly spaced time intervals. A time series is a sequence of data points, measured typically at successive times, spaced at uniform or non-uniform time intervals. For variable interval time series, the successive time intervals may follow a repeating pattern, or may be completely random.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Variable Interval Time Series Array Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/TimeSeriesArray"}]},{"@id":"http://qudt.org/schema/qudt/VariableIntervalTimeSeriesArrayType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"A Variable Interval Time Series Array Type is a data type that specifies the properties of arrays that hold time series data that has been sampled over non-uniformly spaced time intervals. A time series is a sequence of data points, measured typically at successive times, spaced at uniform or non-uniform time intervals. For variable interval time series, the successive time intervals may follow a repeating pattern, or may be completely random.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Variable Interval Time Series Array Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/TimeSeriesArrayType"}]},{"@id":"http://qudt.org/schema/qudt/VariableLengthIntegerType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  A \"Variable Length Integer\" data type defines a data structure for representing integers that uses a variable number of bits depending on the magnitude of the integer. \n  Typically, variable length integer data types are between one and 64 bits in length.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Variable Length Integer Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/IntegerDatatype"}]},{"@id":"http://qudt.org/schema/qudt/Vector","@type":["http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A <em>Vector</em> is an array data type that can have a dimensionality of one, or more elements.\n  Vectors can represent physical quantities, such as velocity, force, displacement;\n  mathematical objects such as points or directions in space;\n  and abstract representations for things such as colors, features, or embeddings in computational contexts.\n  </p>\n  <p>As a one-dimensional mathematical object it can represent a quantity with both magnitude and direction in space.\n  One-dimensional vectors can be thought of as a special case of a 1D array.\n  For example a 3D vector can be expressed as a list of coordinates: [x,y,z].\n  </p>\n  <p>\n  A vector in n-dimensional space can represent a point, a direction, or a linear combination of basis vectors.\n  </p>\n  <p>\n  Vectors can represent quantifiable values.\n  For example a car moving at 60 m/hr to the north, assuming north is along the y-axis, can be represented in 2D as:\n  </p>\n  <dl>\n  <dd>[0, 60]</dd>\n  </dl>\n  <p>\n  In machine learning a <em>Feature Vector</em> can be expressed for a dataset entry as:\n  <p>\n  <dl>\n  <dd>[5.1, 3.5, 1.4, 0.2]</dd>\n  </dl>\n  <p>\n  In AI for text processing a <em>Word Embedding Vector</em> is expressed as a N-dimensional space, where N can be a large number.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Vector","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"_:n3-413"},{"@id":"http://qudt.org/schema/qudt/Array"}]},{"@id":"http://qudt.org/schema/qudt/Verifiable","@type":["http://qudt.org/schema/qudt/AspectClass","http://www.w3.org/2002/07/owl#Class"],"http://purl.org/dc/terms/description":[{"@value":"\n  An aspect class that holds properties that provide external knowledge and specifications of a given resource.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Verifiable","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/Aspect"}]},{"@id":"http://qudt.org/schema/qudt/VisualCue","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Visual Cue","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/ModalCue"}]},{"@id":"http://qudt.org/schema/qudt/WetDryStateType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Wet dry state type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/DiscreteState"},{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}]},{"@id":"http://qudt.org/schema/qudt/XSDatomicTypeUnion","@type":["http://qudt.org/schema/qudt/List"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>In XML Schema Definition (XSD) xsd:anySimpleType is the base type for all simple types.\n  Simple types in XSD represent atomic values without any child elements or complex structures.\n  All simple types are compliant with xsd:anySimpleType.\n  </p>\n  <p>In XSD, the atomic types are: xsd:string, xsd:boolean, xsd:decimal, xsd:float,\n   xsd:double, xsd:duration, xsd:dateTime, xsd:time, xsd:date, xsd:gYearMonth, xsd:gYear, xsd:gMonthDay,\n   xsd:gDay, xsd:gMonth, xsd:hexBinary, xsd:base64Binary, xsd:anyURI, xsd:QName, and xsd:NOTATION.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#first":[{"@id":"http://www.w3.org/2001/XMLSchema#anySimpleType"}],"http://www.w3.org/1999/02/22-rdf-syntax-ns#rest":[{"@id":"_:n3-427"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"XSD Atomic Type Union","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/YesNoType","@type":["http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Yes no type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}]},{"@id":"http://qudt.org/schema/qudt/abbreviation","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>An abbreviation for a unit is a short ASCII string that is used in place of the full name for the unit in contexts where non-ASCII characters would be problematic,\n   or where using the abbreviation will enhance readability. \n  When a power of abase unit needs to be expressed, such as squares this can be done using abbreviations rather than symbols. \n  For example, <em>sq ft</em> means <em>square foot</em>, and <em>cu ft</em> means <em>cubic foot</em>.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"abbreviation","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/accuracy","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p><em>Accuracy</em> is the degree to which a given quantity is correct and free from error. \n  For example, a quantity specified as 100+/-1 has an (absolute) accuracy of +/-1 (meaning its true value can fall in the range 99-101),\n   while a quantity specified as 100+/-2% has a (relative) accuracy of +/-2% (meaning its true value can fall in the range 98-102).\n  </p>\n  <p>The concepts of accuracy and precision are both closely related and often confused. \n  While the accuracy of a number x is given by the number of significant decimal (or other) digits to the right of the decimal point in x,\n   the precision of x is the total number of significant decimal (or other) digits.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"accuracy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/acronym","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"acronym","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/alignment","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"alignment","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/AlignmentType"}]},{"@id":"http://qudt.org/schema/qudt/allowedPattern","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property relates a date string encoding (c.f. type:DateStringEncodingType) to one or more XML Schema compliant regular expressions that together determine the allowed lexical expressions that can be unambiguously parsed to determine a temporal quantity.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"allowed pattern","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/altSymbol","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"An alternative symbol","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"alt symbol","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://www.linkedmodel.org/schema/dtype#literal"}]},{"@id":"http://qudt.org/schema/qudt/ansiSQLName","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"ANSI SQL name","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/id"}]},{"@id":"http://qudt.org/schema/qudt/applicableCGSUnit","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"applicable CGS unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Unit"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/applicableUnit"}]},{"@id":"http://qudt.org/schema/qudt/applicableISOUnit","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"applicable ISO unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Unit"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/applicableUnit"}]},{"@id":"http://qudt.org/schema/qudt/applicableImperialUnit","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"applicable Imperial unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Unit"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/applicableUnit"}]},{"@id":"http://qudt.org/schema/qudt/applicablePhysicalConstant","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"applicable physical constant","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/PhysicalConstant"}]},{"@id":"http://qudt.org/schema/qudt/applicablePlanckUnit","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"applicable Planck unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/applicableUnit"}]},{"@id":"http://qudt.org/schema/qudt/applicableSIUnit","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"applicable SI unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Unit"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/applicableUnit"}]},{"@id":"http://qudt.org/schema/qudt/applicableSystem","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  This property relates a unit of measure with a unit system that may or may not define the unit,\n   but within which the unit is compatible.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"applicable system","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/SystemOfUnits"}]},{"@id":"http://qudt.org/schema/qudt/applicableUSCustomaryUnit","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"applicable US Customary unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Unit"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/applicableUnit"}]},{"@id":"http://qudt.org/schema/qudt/applicableUnit","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>See this page on the QUDT GitHub<a href=\"https://github.com/qudt/qudt-public-repo/wiki/Advanced-User-Guide#4-computing-applicable-units-for-a-quantitykind\">Wiki</a>\n   on how \"qudt:applicableUnit\" is computed from \"qudt:hasQuantityKind\" and then materialized.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"applicable unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Unit"}]},{"@id":"http://qudt.org/schema/qudt/arg1Type","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property relates a funciton data type with the type of its arg1.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"arg1Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/argType"}]},{"@id":"http://qudt.org/schema/qudt/arg2Type","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property relates a funciton data type with the type of its arg2.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"arg2Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/argType"}]},{"@id":"http://qudt.org/schema/qudt/arg3Type","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property relates a funciton data type with the type of its arg3.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"arg3Type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/argType"}]},{"@id":"http://qudt.org/schema/qudt/argType","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property relates a function data type with the type of one of its arguments.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"argType","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Datatype"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/elementDatatype"}]},{"@id":"http://qudt.org/schema/qudt/auralCue","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"aural cue","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/modalCue"}]},{"@id":"http://qudt.org/schema/qudt/auralCueEnumeration","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"aural cue enumeration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/modalCueEnumeration"}]},{"@id":"http://qudt.org/schema/qudt/base","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"base","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/baseCGSUnitDimensions","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"base CGS unit dimensions","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/baseDimensionEnumeration","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property associates a system of quantities with an enumeration that enumerates the base dimensions of the system in canonical order.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"base dimension enumeration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Enumeration"}]},{"@id":"http://qudt.org/schema/qudt/baseISOUnitDimensions","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"base ISO unit dimensions","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/baseImperialUnitDimensions","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"base imperial unit dimensions","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/baseSIUnitDimensions","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"base SI unit dimensions","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/baseUSCustomaryUnitDimensions","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"base US customary unit dimensions","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/baseUnitOfSystem","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  This property relates a unit of measure to the system of units in which it is defined as a base unit for the system. \n  The base units of a system are used to define the derived units of the system by expressing the derived units as products of the base units raised to a rational power.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"is base unit of system","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/definedUnitOfSystem"}],"http://www.w3.org/2002/07/owl#inverseOf":[{"@id":"http://qudt.org/schema/qudt/hasBaseUnit"}]},{"@id":"http://qudt.org/schema/qudt/basis","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"basis","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Datatype"},{"@id":"http://qudt.org/schema/qudt/QuantityType"}]},{"@id":"http://qudt.org/schema/qudt/belongsToSystemOfQuantities","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"belongs to system of quantities","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/SystemOfQuantityKinds"}]},{"@id":"http://qudt.org/schema/qudt/bitOrder","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"bit order","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/EndianType"}]},{"@id":"http://qudt.org/schema/qudt/bits","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"bits","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/blockchainNetwork","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Primary network name (e.g., 'Bitcoin Mainnet', 'Ethereum Mainnet').","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"blockchain network","@language":"en"}]},{"@id":"http://qudt.org/schema/qudt/bounded","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://purl.org/dc/terms/description":[{"@value":"A datatype is bounded if its value space has either a finite upper and lower bound. Either bound may be inclusive or exclusive. ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"bounded","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#boolean"}]},{"@id":"http://qudt.org/schema/qudt/byRow","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"by row","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#boolean"}]},{"@id":"http://qudt.org/schema/qudt/byteOrder","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"Byte order is an enumeration of two values: 'Big Endian' and 'Little Endian' and is used to denote whether the most signiticant byte is either first or last, respectively.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"byte order","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/EndianType"}]},{"@id":"http://qudt.org/schema/qudt/bytes","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"bytes","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/cName","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://purl.org/dc/terms/description":[{"@value":"Datatype name in the C programming language","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"C Language name","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/id"}]},{"@id":"http://qudt.org/schema/qudt/cardinality","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"cardinality","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/CardinalityType"}]},{"@id":"http://qudt.org/schema/qudt/categorizedAs","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"categorized as","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/categorizedByQuantityKind","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>Relates a unit to a non-commensurate quantity-kind <em>category</em> under which it is grouped\n  &mdash; e.g. the placeholder <code>quantitykind:Unknown</code>, or a dimensionless bucket such as\n  <code>quantitykind:DimensionlessRatio</code> &mdash; <strong>without</strong> asserting that the\n  unit measures or is convertible within a commensurate family. A sub-property of\n  <code>qudt:hasQuantityKind</code>. Contrast <code>qudt:unitForQuantityKind</code>.</p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"categorized by quantity kind","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/QuantityKind"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/hasQuantityKind"}]},{"@id":"http://qudt.org/schema/qudt/coherentUnitSystem","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>A system of units is coherent with respect to a system of quantities and equations if the system of units is chosen in such a way that the equations between numerical values have exactly the same form (including the numerical factors) as the corresponding equations between the quantities. \n  In such a coherent system, no numerical factor other than the number 1 ever occurs in the expressions for the derived units in terms of the base units. \n  For example, the $newton$ and the $joule$. \n  These two are, respectively, the force that causes one kilogram to be accelerated at 1 metre per (1) second per (1) second, and the work done by 1 newton acting over 1 metre. \n  Being coherent refers to this consistent use of 1. \n  In the old c.g.s. system , with its base units the centimetre and the gram, the corresponding coherent units were the dyne and the erg,\n   respectively the force that causes 1 gram to be accelerated at 1 centimetre per (1) second per (1) second, and the work done by 1 dyne acting over 1 centimetre. \n  So $1\\,newton = 10^5 dyne$, $1 joule = 10^7 erg$, making each of the four compatible in a decimal sense within its respective other system, but not coherent therein.</p>\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Coherence_(units_of_measurement)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"coherent unit system","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/hasUnitSystem"}]},{"@id":"http://qudt.org/schema/qudt/columns","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"columns","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/conversionMultiplier","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"conversion multiplier","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#decimal"}]},{"@id":"http://qudt.org/schema/qudt/conversionMultiplierSN","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"conversion multiplier scientific","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#double"}]},{"@id":"http://qudt.org/schema/qudt/conversionOffset","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"conversion offset","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#decimal"}]},{"@id":"http://qudt.org/schema/qudt/conversionOffsetSN","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"conversion offset scientific","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#double"}]},{"@id":"http://qudt.org/schema/qudt/currencyCode","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://purl.org/dc/terms/description":[{"@value":"Alphabetic Currency Code as defined by ISO 4217. For example, the currency code for the US dollar is USD.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"currency code","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/currencyExponent","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  The currency exponent indicates the number of decimal places between a major currency unit and its minor currency unit. \n  For example, the US dollar is the major currency unit of the United States, and the US cent is the minor currency unit. Since one cent is 1/100 of a dollar, the US dollar has a currency exponent of 2. \n  However, the Japanese Yen has no minor currency units, so the yen has a currency exponent of 0.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"currency exponent","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/currencyNumber","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://purl.org/dc/terms/description":[{"@value":"Three-digit Currency Code as defined by ISO 4217. For example, the currency number for the US dollar is \"840\".","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"currency number","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/dataEncoding","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"data encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/DataEncoding"}]},{"@id":"http://qudt.org/schema/qudt/dataOrder","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"data order","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/MatrixElementOrder"}]},{"@id":"http://qudt.org/schema/qudt/dataStructure","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"data structure","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/datatype","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property is used to relate a structured data type with the data type of the structured type's elements. It is used for homogeneous structured data types, that is, those whose elements that are all of the same type.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"datatype","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Datatype"}]},{"@id":"http://qudt.org/schema/qudt/dbpediaMatch","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"dbpedia match","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#anyURI"}]},{"@id":"http://qudt.org/schema/qudt/default","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"The default element in an enumeration","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"default","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}]},{"@id":"http://qudt.org/schema/qudt/defaultValue","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Default Value","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/AuralCue"},{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"},{"@id":"http://qudt.org/schema/qudt/IconicCue"},{"@id":"http://qudt.org/schema/qudt/KinestheticCue"},{"@id":"http://qudt.org/schema/qudt/ModalCue"},{"@id":"http://qudt.org/schema/qudt/VisualCue"}]},{"@id":"http://qudt.org/schema/qudt/definedUnitOfSystem","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property relates a unit of measure with the unit system that defines the unit.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"defined unit of system","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/SystemOfUnits"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/isUnitOfSystem"}],"http://www.w3.org/2002/07/owl#inverseOf":[{"@id":"http://qudt.org/schema/qudt/hasDefinedUnit"}]},{"@id":"http://qudt.org/schema/qudt/denominatorDimensionVector","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"denominator dimension vector","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/deprecated","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"deprecated","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#boolean"}]},{"@id":"http://qudt.org/schema/qudt/deprecatedInVersion","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://purl.org/dc/terms/description":[{"@value":"Version number of the first QUDT release in which an entity was deprecated.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"deprecated in version","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property relates a unit of measure to the unit system in which the unit is derived from the system's base units with a proportionality constant of one.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"is coherent derived unit of system","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/SystemOfUnits"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/definedUnitOfSystem"},{"@id":"http://qudt.org/schema/qudt/derivedUnitOfSystem"}],"http://www.w3.org/2002/07/owl#inverseOf":[{"@id":"http://qudt.org/schema/qudt/hasDerivedCoherentUnit"}]},{"@id":"http://qudt.org/schema/qudt/derivedNonCoherentUnitOfSystem","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  This property relates a unit of measure to the unit system in which the unit is derived from the system's\n   base units without proportionality constant of one.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"is non-coherent derived unit of system","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/derivedUnitOfSystem"}],"http://www.w3.org/2002/07/owl#inverseOf":[{"@id":"http://qudt.org/schema/qudt/hasDerivedNonCoherentUnit"}]},{"@id":"http://qudt.org/schema/qudt/derivedUnitOfSystem","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  This property relates a unit of measure to the system of units in which it is defined as a derived unit. \n  That is, the derived unit is defined as a product of the base units for the system raised to some rational power.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"is derived unit of system","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/SystemOfUnits"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/isUnitOfSystem"}],"http://www.w3.org/2002/07/owl#inverseOf":[{"@id":"http://qudt.org/schema/qudt/hasDerivedUnit"}]},{"@id":"http://qudt.org/schema/qudt/descriptor","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"descriptor","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/dimensionExponent","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"dimension exponent","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/dimensionExponentForAmountOfSubstance","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"dimension exponent for amount of substance","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/dimensionExponentForElectricCurrent","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"dimension exponent for electric current","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/dimensionExponentForLength","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"dimension exponent for length","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/dimensionExponentForLuminousIntensity","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"dimension exponent for luminous intensity","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/dimensionExponentForMass","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"dimension exponent for mass","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/dimensionExponentForThermodynamicTemperature","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"dimension exponent for thermodynamic temperature","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/dimensionExponentForTime","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"dimension exponent for time","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/dimensionInverse","@type":["http://www.w3.org/2002/07/owl#InverseFunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty","http://www.w3.org/2002/07/owl#SymmetricProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"dimension inverse","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2002/07/owl#inverseOf":[{"@id":"http://qudt.org/schema/qudt/dimensionInverse"}]},{"@id":"http://qudt.org/schema/qudt/dimensionVectorForSI","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"dimension vector for SI","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector_SI"}]},{"@id":"http://qudt.org/schema/qudt/dimensionality","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  The number of dimensions making up a matrix or an array. \n  For example a 4 by 4 array has a dimensionality of 2. \n  Whereas a vector or a string has a dimensionality of 1.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"dimensionality","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/dimensionlessExponent","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"dimensionless exponent","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/dimensions","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  The extent of each dimension making up an array or matrix.\n  Dimensions are expressed as an integer list.\n  For example a 4 by 4 array has dimensions (4 4), whereas a vector or a string has dimensions (1).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"dimensions","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/List"}]},{"@id":"http://qudt.org/schema/qudt/double_X","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"double X","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/double_Y","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"double Y","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/double_Z","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"double Z","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/duration","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"duration","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/eclassCode","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://purl.org/dc/terms/description":[{"@value":"Provides an IRDI (International Registration Data Identifier) that identifies the corresponding definition in the ECLASS Standard.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"ECLASS code","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/element","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"An element of an enumeration","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"element","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}]},{"@id":"http://qudt.org/schema/qudt/elementDatatype","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  This property is used to relate a structured data type with the data type the structured type's elements. \n  It is used for structured data types with elements that are all of the same type.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"element datatype","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/CharacterType"},{"@id":"http://qudt.org/schema/qudt/Datatype"},{"@id":"http://qudt.org/schema/qudt/NumericType"},{"@id":"http://qudt.org/schema/qudt/RealSinglePrecisionType"},{"@id":"http://qudt.org/schema/qudt/ScalarDatatype"},{"@id":"http://qudt.org/schema/qudt/TupleMember"},{"@id":"http://qudt.org/schema/qudt/UnsignedIntegerType"}]},{"@id":"http://qudt.org/schema/qudt/elementKind","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property is used to describe the quantity kind for a dimensional data type.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"element kind","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/elementKind"}]},{"@id":"http://qudt.org/schema/qudt/elementLabel","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property is used to label the field of a composite data structure.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"element label","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/elementName","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"element name","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/elementTypeCount","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property determines the allowed number of element types that a structured data type may have.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"element type count","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/elementTypeList","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  This property is used to define the data type of the elements of a structured data type. \n  It is used for structured data types with elements that are of different types.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"element type list","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/elementUnit","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"element unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Unit"}]},{"@id":"http://qudt.org/schema/qudt/encoding","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"encoding","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/BooleanEncodingType"},{"@id":"http://qudt.org/schema/qudt/DateTimeStringEncodingType"},{"@id":"http://qudt.org/schema/qudt/Encoding"}]},{"@id":"http://qudt.org/schema/qudt/enumeratedValue","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"enumerated value","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/EnumeratedValue"}]},{"@id":"http://qudt.org/schema/qudt/enumeration","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"enumeration","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/exactConstant","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"exact constant","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#boolean"}]},{"@id":"http://qudt.org/schema/qudt/exactMatch","@type":["http://qudt.org/schema/qudt/SymmetricRelation","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"exact match","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Concept"}]},{"@id":"http://qudt.org/schema/qudt/example","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  The 'qudt:example' property is used to annotate an instance of a class with a reference to a concept that is an example. \n  The type of this property is 'rdf:Property'. \n  This allows both scalar and object ranges.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"example","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/exponent","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property relates a factor unit its exponent","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Defines the exponent of a factor unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"},{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"exponent","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/expression","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  An 'expression' is a finite combination of symbols that are well-formed according to rules that apply to units of measure, quantity kinds and their dimensions.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"expression","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/factorUnitScalar","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://purl.org/dc/terms/description":[{"@value":"For a derived unit that is not exactly the product of its factor units, this property defines the scalar with which that product has to be multiplied with.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"factorUnitScalar","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#decimal"}]},{"@id":"http://qudt.org/schema/qudt/field","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"field","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/DataSetElement"}]},{"@id":"http://qudt.org/schema/qudt/fieldCode","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\n  A field code is a generic property for representing unique codes that make up other identifiers. \n  For example each QuantityKind class caries a domain code as its field code.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"field code","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/fieldLabel","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"field label","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/fieldLabels","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property is used to list the field labels for a record type.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"field labels","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/fieldName","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"field name","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/fieldType","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"field type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Datatype"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/elementDatatype"}]},{"@id":"http://qudt.org/schema/qudt/figure","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"Provides a link to an image.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"figure","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Figure"}]},{"@id":"http://qudt.org/schema/qudt/figureCaption","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"figure caption","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/figureLabel","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"figure label","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/frameType","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"frame type","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/function","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"function","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/CompositionFunction"}]},{"@id":"http://qudt.org/schema/qudt/functionArity","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property is used to state the number of arguments for a function type.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"function arity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/guidance","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"guidance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}]},{"@id":"http://qudt.org/schema/qudt/hasAllowedUnit","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  This property relates a unit system with a unit of measure that is not defined by or part of the system,\n   but is allowed for use within the system.\n   An allowed unit must be convertible to some dimensionally eqiuvalent unit that is defined by the system.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"allowed unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Unit"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/hasUnit"}]},{"@id":"http://qudt.org/schema/qudt/hasBaseQuantityKind","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"has base quantity kind","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/QuantityKind"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/hasQuantityKind"}]},{"@id":"http://qudt.org/schema/qudt/hasBaseUnit","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  This property relates a system of units to a base unit defined within the system.\n  The base units of a system are used to define the derived units of the system by expressing\n   the derived units as products of the base units raised to a rational power.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"base unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Unit"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/hasCoherentUnit"}],"http://www.w3.org/2002/07/owl#inverseOf":[{"@id":"http://qudt.org/schema/qudt/baseUnitOfSystem"}]},{"@id":"http://qudt.org/schema/qudt/hasCoherentUnit","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  A coherent unit of measurement for a unit system is a defined unit that may be expressed as a product of powers\n   of the system's base units with the proportionality factor of one.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"coherent unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Unit"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/hasDefinedUnit"}]},{"@id":"http://qudt.org/schema/qudt/hasDTICode","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"ISO 24165 Digital Token Identifier (12-character alphanumeric).","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"has DTI code","@language":"en"}]},{"@id":"http://qudt.org/schema/qudt/hasDefinedUnit","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property relates a unit system with a unit of measure that is defined by the system.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"defined unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Unit"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/hasUnit"}]},{"@id":"http://qudt.org/schema/qudt/hasDenominatorPart","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"has quantity kind dimension vector denominator part","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/hasDerivedCoherentUnit","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"derived coherent unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Unit"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/hasCoherentUnit"},{"@id":"http://qudt.org/schema/qudt/hasDerivedUnit"}],"http://www.w3.org/2002/07/owl#inverseOf":[{"@id":"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem"}]},{"@id":"http://qudt.org/schema/qudt/hasDerivedNonCoherentUnit","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"has coherent derived unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/hasDerivedUnit"}],"http://www.w3.org/2002/07/owl#inverseOf":[{"@id":"http://qudt.org/schema/qudt/derivedNonCoherentUnitOfSystem"}]},{"@id":"http://qudt.org/schema/qudt/hasDerivedUnit","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  This property relates a system of units to a unit of measure that is defined within the system in terms\n   of the base units for the system. \n  That is, the derived unit is defined as a product of the base units for the system raised to some rational power.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"derived unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Unit"}],"http://www.w3.org/2002/07/owl#inverseOf":[{"@id":"http://qudt.org/schema/qudt/derivedUnitOfSystem"}]},{"@id":"http://qudt.org/schema/qudt/hasDimension","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"has dimension","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/hasDimensionExpression","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"dimension expression","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/hasDimensionVector","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"has dimension vector","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector"}]},{"@id":"http://qudt.org/schema/qudt/hasFactorUnit","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property relates a derived unit to one of its constituent factor units","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"hasFactorUnit","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/hasNumeratorPart","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"has numerator part","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/hasPrefixUnit","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"prefix unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/hasDefinedUnit"}]},{"@id":"http://qudt.org/schema/qudt/hasQuantity","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"has quantity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Quantity"}]},{"@id":"http://qudt.org/schema/qudt/hasQuantityKind","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"has quantity kind","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/QuantityKind"}]},{"@id":"http://qudt.org/schema/qudt/hasQuantityKindsList","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property is used to specify a list of quantity kinds.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"quantity kinds","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/List"}]},{"@id":"http://qudt.org/schema/qudt/hasReciprocalUnit","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"Used to relate a unit to its reciprocal unit.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"has reciprocal unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Unit"}]},{"@id":"http://qudt.org/schema/qudt/hasReferenceQuantityKind","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"has reference quantity kind","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/QuantityKind"}]},{"@id":"http://qudt.org/schema/qudt/hasRule","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"has rule","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Rule"}]},{"@id":"http://qudt.org/schema/qudt/hasUnit","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>This property relates a factor unit to its unit or system of units with a unit of measure that is either:\n  </p>\n  <dl>\n  <dd>a) defined by the system,</dd>\n  <dd>b) accepted for use by the system and is convertible to a unit of equivalent dimension that is defined by the system,</dd>\n  <dd>c) a reference to the unit of measure of a quantity (variable or constant) of interest.</dd>\n  </dl>\n  <p>Systems of units may distinguish between base and derived units.\n  Base units are the units which measure the base quantities for the corresponding system of quantities. \n  The base units are used to define units for all other quantities as products of powers of the base units. \n  Such units are called derived units for the system. \n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"has unit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Unit"}]},{"@id":"http://qudt.org/schema/qudt/hasUnitSystem","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"has unit system","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/SystemOfUnits"}]},{"@id":"http://qudt.org/schema/qudt/hasVocabulary","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Used to relate a class to one or more graphs where vocabularies for the class are defined.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"has vocabulary","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/height","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"height","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/hexbinary","@type":["http://www.w3.org/2000/01/rdf-schema#Datatype","http://www.w3.org/2002/07/owl#Class"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"hexbinary","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subClassOf":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/iconicCue","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"iconic cue","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/modalCue"}]},{"@id":"http://qudt.org/schema/qudt/iconicCueEnumeration","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"iconic cue enumeration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/modalCueEnumeration"}]},{"@id":"http://qudt.org/schema/qudt/id","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>The \"qudt:id\" is an identifier string that uniquely identifies a QUDT concept. \n  The identifier is constructed using a prefix. \n  For example, units are coded using the pattern: \"UCCCENNNN\", where \"CCC\" is a numeric code or a category\n   and \"NNNN\" is a digit string for a member element of that category. \n  </p>\n  <p>For scaled units there may be an addition field that has the format \"QNN\" where \"NN\" is a digit string representing\n   an exponent power, and \"Q\" is a qualifier that indicates with the code \"P\" that the power is a positive decimal exponent,\n   or the code \"N\" for a negative decimal exponent, or the code \"B\" for binary positive exponents.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"qudt id","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/iec61360Code","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://purl.org/dc/terms/description":[{"@value":"Provides an IRDI (International Registration Data Identifier) that identifies the corresponding definition in the IEC CDD (Common Data Dictionary).","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"IEC 61360 code","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/image","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"image","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#anyURI"}]},{"@id":"http://qudt.org/schema/qudt/imageLocation","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"image location","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#anyURI"}]},{"@id":"http://qudt.org/schema/qudt/incrementDatatype","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"increment datatype","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/TimeStringType"}]},{"@id":"http://qudt.org/schema/qudt/informativeReference","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"Provides a way to reference a source that provided useful but non-normative information.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"informative reference","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/inverted","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"inverted","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#boolean"}]},{"@id":"http://qudt.org/schema/qudt/isByteString","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"is byte string","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#boolean"}]},{"@id":"http://qudt.org/schema/qudt/isDeltaQuantity","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  This property is used to identify a Quantity instance that is a measure of a change, or interval, of some property,\n   rather than a measure of its absolute value. \n  This is important for measurements such as temperature differences where the conversion among units would be calculated differently because of offsets.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"is Delta Quantity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#boolean"}]},{"@id":"http://qudt.org/schema/qudt/isDimensionInSystem","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"is dimension in system","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/isHeterogeneous","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"is heterogeneous","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#boolean"}]},{"@id":"http://qudt.org/schema/qudt/isMetricUnit","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"is metric unit","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/isUnitOfSystem","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  This property relates a unit of measure with a system of units that either a) defines the unit\n   or b) allows the unit to be used within the system.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"is unit of system","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/SystemOfUnits"}]},{"@id":"http://qudt.org/schema/qudt/isoNormativeReference","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://purl.org/dc/terms/description":[{"@value":"Provides a way to reference the ISO unit definition.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"normative reference (ISO)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/normativeReference"}]},{"@id":"http://qudt.org/schema/qudt/javaName","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"java name","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/id"}]},{"@id":"http://qudt.org/schema/qudt/jsName","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Javascript name","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/id"}]},{"@id":"http://qudt.org/schema/qudt/kinestheticCue","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"kinesthetic cue","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/modalCue"}]},{"@id":"http://qudt.org/schema/qudt/kinestheticCueEnumeration","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"kinesthetic cue enumeration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/modalCueEnumeration"}]},{"@id":"http://qudt.org/schema/qudt/landscape","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"landscape","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#boolean"}]},{"@id":"http://qudt.org/schema/qudt/latexDefinition","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"latex definition","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/latexSymbol","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  The symbol is a glyph that is used to represent some concept, typically a unit or a quantity, in a compact form. \n  For example, the symbol for an Ohm is $ohm$. \n  This contrasts with 'unit:abbreviation', which gives a short alphanumeric abbreviation for the unit, 'ohm' for Ohm.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"latex symbol","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/length","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://purl.org/dc/terms/description":[{"@value":"The length of a structure, for example the size of a vector","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/lowerBound","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"lower bound","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/mantissa","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"In scientific notation, the mantissa of a real number is the integer coefficient preceding the base raised to the exponent.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"mantissa","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/mathDefinition","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"math definition","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/mathMLdefinition","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"mathML definition","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/mathDefinition"}]},{"@id":"http://qudt.org/schema/qudt/matlabName","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"matlab name","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/id"}]},{"@id":"http://qudt.org/schema/qudt/maxBits","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"maximum bits","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/maxDepth","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"max depth","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/maxExclusive","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://purl.org/dc/terms/description":[{"@value":"maxExclusive is the exclusive upper bound of the value space for a datatype with the ordered property. The value of maxExclusive must be in the value space of the base type or be equal to {value} in {base type definition}.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"max exclusive","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/upperBound"}]},{"@id":"http://qudt.org/schema/qudt/maxExponent","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"max exponent","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/maxInclusive","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://purl.org/dc/terms/description":[{"@value":"maxInclusive is the inclusive upper bound of the value space for a datatype with the ordered property. The value of maxInclusive must be in the value space of the base type.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"max inclusive","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/upperBound"}]},{"@id":"http://qudt.org/schema/qudt/maxLength","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"max length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/maxMantissa","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>The maximium mantissa is the largest integer that may appear as a coefficient in a finite precision representation of a real number.\n  For a given numeric data type, the value of <em>maxMantissa}</em> (<em>M</em>) and the values of <em>base</em> (<em>b</em>) and  <em>precision</em> (<em>p</em>) are related by the formula:\n  </p>\n  <p><em>M = b<sup></sup> - 1</em> .</p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"max mantissa","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/member","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  This property is used to define a collection's elements. \n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"member","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/memberDatatype","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  This property is used to define the data type of a collection's elements. \n  It is used for collections with elements that are all of the same type.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"member datatype","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/CharacterType"}]},{"@id":"http://qudt.org/schema/qudt/microsoftSQLServerName","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Microsoft SQL Server name","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/id"}]},{"@id":"http://qudt.org/schema/qudt/minBits","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"minimum bits","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/minExclusive","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"minExclusive is the exclusive lower bound of the value space for a datatype with the ordered property. The value of minExclusive must be in the value space of the base type or be equal to {value} in {base type definition}.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"min exclusive","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/lowerBound"}]},{"@id":"http://qudt.org/schema/qudt/minInclusive","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"minInclusive is the inclusive lower bound of the value space for a datatype with the ordered property. The value of minInclusive must be in the value space of the base type.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"min inclusive","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/lowerBound"}]},{"@id":"http://qudt.org/schema/qudt/minLength","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"min length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/minMantissa","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>The minimium mantissa is the negative integer with the greatest magnitude that may appear as a coefficient in a finite precision representation of a real number.  \n  For a given numeric data type, the value of <em>minMantissa</em> (<em>M</em>) and the values of <em>base</em> (<em>b</em>) and <em>precision</em> (<em>p</em>) are related by the formula:\n  </p>\n  <p><em>M = -(b<sup>p</sup> - 1)</em>.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"min mantissa","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/minValue","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"minimum value","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/modalCue","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"modal cue","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/ModalCue"}]},{"@id":"http://qudt.org/schema/qudt/modalCueEnumeration","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"modal cue enumeration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/ModalEnumeration"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/enumeration"}]},{"@id":"http://qudt.org/schema/qudt/modifiability","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"Reference to one in a list of enumerated elements that indicates whether data (e.g. variable or parameter) can be changed.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"modifiability","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/mySQLName","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"MySQL name","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/id"}]},{"@id":"http://qudt.org/schema/qudt/negativeDeltaLimit","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"A negative change limit between consecutive sample values for a parameter. The Negative Delta may be the encoded value or engineering units value depending on whether or not a Calibrator is defined.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"negative delta limit","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/normativeReference","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://purl.org/dc/terms/description":[{"@value":"Provides a way to reference information that is an authoritative source providing a standard definition","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"normative reference","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#anyURI"}]},{"@id":"http://qudt.org/schema/qudt/numeratorDimensionVector","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"numerator dimension vector","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/numericValue","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"numeric value","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/odbcName","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"ODBC name","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/id"}]},{"@id":"http://qudt.org/schema/qudt/oleDBName","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://purl.org/dc/terms/description":[{"@value":"OLE DB (Object Linking and Embedding, Database, sometimes written as OLEDB or OLE-DB), an API designed by Microsoft, allows accessing data from a variety of sources in a uniform manner. The API provides a set of interfaces implemented using the Component Object Model (COM); it is otherwise unrelated to OLE. ","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"\n  <p>OLE DB (Object Linking and Embedding, Database, sometimes written as OLEDB or OLE-DB), an API designed by Microsoft, allows accessing data from a variety of sources in a uniform manner. \n  The API provides a set of interfaces implemented using the Component Object Model (COM); it is otherwise unrelated to OLE.\n  </p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://msdn.microsoft.com/en-us/library/windows/desktop/ms714931(v=vs.85).aspx","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/OLE_DB","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"OLE DB name","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/id"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"http://en.wikipedia.org/wiki/OLE_DB"},{"@id":"http://msdn.microsoft.com/en-us/library/windows/desktop/ms714931(v=vs.85).aspx"}]},{"@id":"http://qudt.org/schema/qudt/omUnit","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"om unit","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/onlineReference","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"online reference","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/optional","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"optional","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#boolean"}]},{"@id":"http://qudt.org/schema/qudt/oracleSQLName","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"ORACLE SQL name","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/id"}]},{"@id":"http://qudt.org/schema/qudt/order","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"order","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#nonNegativeInteger"}]},{"@id":"http://qudt.org/schema/qudt/orderInStructure","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"order in structure","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/orderedType","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"ordered type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/OrderedType"}]},{"@id":"http://qudt.org/schema/qudt/orderingRelation","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  This property identifies the mathematical comparison operator (such as \"<\" or \">\") that is used to order the elements of a collection.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Ordering Relation","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.linkedmodel.org/schema/dtype#ComparisonOperator"}]},{"@id":"http://qudt.org/schema/qudt/organizedUnder","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>Relates a quantity kind to a broader quantity kind for the purpose of <em>organization and unit\n  applicability only</em> &mdash; it does <strong>not</strong> assert commensurability. A sub-property\n  of <code>skos:broader</code> (so it contributes to the concept hierarchy), but unlike\n  <code>qudt:specializationOf</code> it makes no commensurability claim:\n  <code>qudt:organizedUnder</code> groups quantity kinds that share a dimension but are <em>not</em>\n  interchangeable &mdash; principally the dimensionless quantity kinds, which are all organised under\n  <code>quantitykind:Dimensionless</code> / <code>quantitykind:DimensionlessRatio</code> without being\n  commensurable with one another. <code>qudt:organizedUnder</code> still contributes to the concept\n  hierarchy (via <code>skos:broader</code>), and the build still validates that it only links\n  quantity kinds of the same dimension, but the applicable-unit computation traverses only\n  <code>qudt:specializationOf</code> &mdash; an organizational grouping confers no units on its\n  members. The commensurability test likewise traverses\n  <code>qudt:specializationOf</code> and <code>qudt:exactMatch</code> (never\n  <code>qudt:organizedUnder</code>).</p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"organized under","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/QuantityKind"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://www.w3.org/2004/02/skos/core#broader"}]},{"@id":"http://qudt.org/schema/qudt/originDefinition","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"origin definition","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/outOfScope","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"out of scope","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/padding","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"padding","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/PaddingType"}]},{"@id":"http://qudt.org/schema/qudt/pattern","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://purl.org/dc/terms/description":[{"@value":"A pattern is a constraint on the value space of a datatype which is achieved by constraining the lexical space to literals which match a specific pattern. The value of pattern must be a regular expression.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"pattern","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/permissibleMaths","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"permissible maths","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/MathsFunctionType"}]},{"@id":"http://qudt.org/schema/qudt/permissibleTransformation","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"permissible transformation","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/TransformType"}]},{"@id":"http://qudt.org/schema/qudt/plainTextDescription","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"A plain text description is used to provide a description with only simple ASCII characters for cases where LaTeX , HTML or other markup would not be appropriate.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"description (plain text)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2000/01/rdf-schema#Literal"}]},{"@id":"http://qudt.org/schema/qudt/positiveDeltaLimit","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"A positive change limit between consecutive sample values for a parameter. The Positive Delta may be the encoded value or engineering units value depending on whether or not a Calibrator is defined.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Positive delta limit","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/precision","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>Precision is the number of digits used to perform a given computation. \n  The concepts of accuracy and precision are both closely related and often confused. \n  While the accuracy of a number x is given by the number of significant decimal (or other) digits to the right of the decimal point in x,\n   the precision of x is the total number of significant decimal (or other) digits.\n  </p>\n  <p>For a given numeric data type, the value of type:precision (?p) is related to the values of type:maxMantissa (?M) and type:base (?b) by the formula:\n  </p>\n  <p>?p := log(?b, ?M)\n  </p>\n  <p>where log(a,y) = x iff y=a^x.\n  </p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"precision","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/prefix","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"Associates a unit with the appropriate prefix, if any.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"prefix","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Prefix"}]},{"@id":"http://qudt.org/schema/qudt/prefixMultiplier","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"prefix multiplier","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#decimal"}]},{"@id":"http://qudt.org/schema/qudt/prefixMultiplierSN","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"prefix multiplier scientific","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#double"}]},{"@id":"http://qudt.org/schema/qudt/protocolBuffersName","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"protocol buffers name","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/id"}]},{"@id":"http://qudt.org/schema/qudt/pythonName","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"python name","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/id"}]},{"@id":"http://qudt.org/schema/qudt/qkdvDenominator","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"denominator dimension vector","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector"}]},{"@id":"http://qudt.org/schema/qudt/qkdvNumerator","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"numerator dimension vector","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/QuantityKindDimensionVector"}]},{"@id":"http://qudt.org/schema/qudt/quantify","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"quantify","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Quantity"}]},{"@id":"http://qudt.org/schema/qudt/quantity","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"a property to relate an observable thing with a quantity (qud:Quantity)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"quantity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Quantity"}]},{"@id":"http://qudt.org/schema/qudt/quantityValue","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"quantity value","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/QuantityValue"}]},{"@id":"http://qudt.org/schema/qudt/rationale","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"rationale","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}]},{"@id":"http://qudt.org/schema/qudt/rdfsDatatype","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"rdfs datatype","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2000/01/rdf-schema#Datatype"}]},{"@id":"http://qudt.org/schema/qudt/realization","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"realization","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/reference","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"reference","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/referenceUnit","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"reference unit","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/relativeStandardUncertainty","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://purl.org/dc/terms/description":[{"@value":"The relative standard uncertainty of a measurement is the (absolute) standard uncertainty divided by the magnitude of the exact value.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"relative standard uncertainty","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#double"}]},{"@id":"http://qudt.org/schema/qudt/relevantQuantityKind","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"relevant quantity kind","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/relevantUnit","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property is used for qudt:Discipline instances to identify the Unit instances that are used within a given discipline.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Relevant Unit","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/returnType","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property is used to state the return type of a function type.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"return type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Datatype"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/elementDatatype"}]},{"@id":"http://qudt.org/schema/qudt/rgbCode","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"rgb code","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/rows","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"rows","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#integer"}]},{"@id":"http://qudt.org/schema/qudt/ruleType","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"rule type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/RuleType"}]},{"@id":"http://qudt.org/schema/qudt/scalarValue","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"scalar value","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/scaleType","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"scale type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/ScaleType"}]},{"@id":"http://qudt.org/schema/qudt/scalingOf","@type":["http://www.w3.org/2002/07/owl#FunctionalProperty","http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"This property relates a unit that is scaled to the base unit that its qudt:conversionMultiplier converts it to","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"scalingOf","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/Unit"}]},{"@id":"http://qudt.org/schema/qudt/siExactMatch","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Individual from SI Reference Point","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/siUnitsExpression","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"si units expression","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/signedness","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"signedness","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/SignednessType"}]},{"@id":"http://qudt.org/schema/qudt/significantDigits","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"significant digits","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/sound","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://purl.org/dc/terms/description":[{"@value":"The intended use of the sound property is to be associated with modal enumerations","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"sound","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#anyURI"}]},{"@id":"http://qudt.org/schema/qudt/specializationOf","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>Relates a quantity kind to a broader quantity kind of which it is a <em>specialization</em>,\n  asserting <strong>commensurability</strong>: the two share a dimension, their values are comparable\n  and addable, and their units are inter-convertible. A sub-property of <code>skos:broader</code>.\n  Commensurability families are the connected components under\n  <code>(qudt:specializationOf | qudt:exactMatch)</code>. Contrast <code>qudt:organizedUnder</code>,\n  which groups quantity kinds without asserting commensurability.</p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"specialization of","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/QuantityKind"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://www.w3.org/2004/02/skos/core#broader"}]},{"@id":"http://qudt.org/schema/qudt/standardUncertainty","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://purl.org/dc/terms/description":[{"@value":"The standard uncertainty of a quantity is the estimated standard deviation of the mean taken from a series of measurements.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"standard uncertainty","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#decimal"}]},{"@id":"http://qudt.org/schema/qudt/standardUncertaintySN","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://purl.org/dc/terms/description":[{"@value":"The standard uncertainty of a quantity is the estimated standard deviation of the mean taken from a series of measurements.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"standard uncertainty scientific","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#double"}]},{"@id":"http://qudt.org/schema/qudt/stringValue","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"string value","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/scalarValue"}]},{"@id":"http://qudt.org/schema/qudt/symbol","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"The symbol is a glyph that is used to represent some concept, typically a unit or a quantity, in a compact form. For example, the symbol for an Ohm is $ohm$. This contrasts with 'unit:abbreviation', which gives a short alphanumeric abbreviation for the unit, 'ohm' for Ohm.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"symbol","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://www.linkedmodel.org/schema/dtype#literal"}]},{"@id":"http://qudt.org/schema/qudt/systemDefinition","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"system definition","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/systemDerivedQuantityKind","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"system derived quantity kind","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/QuantityKind"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/hasQuantityKind"}]},{"@id":"http://qudt.org/schema/qudt/systemDimension","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"system dimension","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/timeDatatype","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"time datatype","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/type"}]},{"@id":"http://qudt.org/schema/qudt/totalDigits","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"total digits","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/type","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"A reference to the specification of the data type of a variable or constant.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"type","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/TimeStringType"}]},{"@id":"http://qudt.org/schema/qudt/typeMatrix","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"type matrix","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/typeVector","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"type vector","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/ucumCode","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://purl.org/dc/terms/description":[{"@value":"<p><em>ucumCode</em> associates a QUDT unit with its UCUM code (case-sensitive). </p><p>In SHACL the values are derived from specific ucum properties using 'sh:values'.</p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://purl.org/dc/terms/source":[{"@value":"https://ucum.org/ucum.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"ucum code","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"https://ucum.org/ucum.html"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://www.w3.org/2004/02/skos/core#notation"}]},{"@id":"http://qudt.org/schema/qudt/udunitsCode","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://purl.org/dc/terms/description":[{"@value":"The UDUNITS package supports units of physical quantities. Its C library provides for arithmetic manipulation of units and for conversion of numeric values between compatible units. The package contains an extensive unit database, which is in XML format and user-extendable. The package also contains a command-line utility for investigating units and converting values.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://purl.org/dc/terms/source":[{"@value":"https://www.unidata.ucar.edu/software/udunits/","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"udunits code","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/uneceCommonCode","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://purl.org/dc/terms/description":[{"@value":"The UN/CEFACT Recommendation 20 provides three character alphabetic and alphanumeric codes for representing units of measurement for length, area, volume/capacity, mass (weight), time, and other quantities used in international trade. The codes are intended for use in manual and/or automated systems for the exchange of information between participants in international trade.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://purl.org/dc/terms/source":[{"@value":"https://service.unece.org/trade/uncefact/vocabulary/rec20/","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://unece.org/trade/documents/2021/06/uncefact-rec20-0","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"unece common code","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/unitFor","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#domain":[{"@id":"http://qudt.org/schema/qudt/Unit"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"unit for","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2002/07/owl#inverseOf":[{"@id":"http://qudt.org/schema/qudt/hasUnit"}]},{"@id":"http://qudt.org/schema/qudt/unitForQuantityKind","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://purl.org/dc/terms/description":[{"@value":"\n  <p>Relates a unit to a quantity kind it is a <em>unit for</em> &mdash; a quantity kind the unit\n  measures, a member of the commensurate family within which the unit is convertible. A\n  sub-property of <code>qudt:hasQuantityKind</code>. Contrast\n  <code>qudt:categorizedByQuantityKind</code>.</p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"unit for quantity kind","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://qudt.org/schema/qudt/QuantityKind"}],"http://www.w3.org/2000/01/rdf-schema#subPropertyOf":[{"@id":"http://qudt.org/schema/qudt/hasQuantityKind"}]},{"@id":"http://qudt.org/schema/qudt/upperBound","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"upper bound","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/url","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"url","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#range":[{"@id":"http://www.w3.org/2001/XMLSchema#anyURI"}]},{"@id":"http://qudt.org/schema/qudt/value","@type":["http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"],"http://purl.org/dc/terms/description":[{"@value":"A property to relate an observable thing with a value expressed as a decimal","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"value","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/valueQuantity","@type":["http://www.w3.org/2002/07/owl#ObjectProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"value for quantity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2002/07/owl#inverseOf":[{"@id":"http://qudt.org/schema/qudt/quantityValue"}]},{"@id":"http://qudt.org/schema/qudt/valueRange","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"value range","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/valueSN","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"A property to relate an observable thing with a value expressed in scientific notation","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/qudt"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"value scientific","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/valueType","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"value type","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/valueVector","@type":["http://www.w3.org/2002/07/owl#AnnotationProperty"],"http://purl.org/dc/terms/description":[{"@value":"A list of the values of elements in a Partial Array.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/schema/datatype"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"value vector","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/schema/qudt/vbName","@type":["http://www.w3.org/2002/07/owl#DatatypeProperty","http://www.w3.org/2002/07/owl#FunctionalProperty"],"http://www.w3.org/2000/01/rdf-schema#isDefinedB