p://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB499","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB499","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Pa·s/L","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Pa.s.L-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"M32","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AcousticImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/PressureInRelationToVolumeFlow"},{"@id":"http://qudt.org/vocab/quantitykind/PressureInRelationToVolumeFlowRate"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pascal Second per Liter","@language":"en-us"},{"@value":"Pascal Second per Litre","@language":"en"},{"@value":"Pascal Second per Litre","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/PA-SEC-PER-M","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Pascal Second Per Meter ($Pa-s/m$) is a unit in the category of Specific acoustic impedance. It is also\n    known as pascal-second/meter. Pascal Second Per Meter has a dimension of $ML^2T^{-1}$ where $M$ is mass, $L$ is length, and\n    $T$ is time. It essentially the same as the corresponding standard SI unit $kg/m2\\cdot s$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$Pa-s/m$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4391"},{"@id":"_:n3-4392"},{"@id":"_:n3-4393"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MechanicalSurfaceImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificAcousticImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/SurgeImpedanceOfTheMedium"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/M-PER-SEC-PA"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA268","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.efunda.com/glossary/units/units--specific_acoustic_impedance--pascal_second_per_meter.cfm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA268","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/siUnitsExpression":[{"@value":"Pa.s/m","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Pa·s/m","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Pa.s.m-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"C67","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MechanicalSurfaceImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificAcousticImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/SurgeImpedanceOfTheMedium"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q87051580"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pascal Saat per Meter","@language":"ms"},{"@value":"Pascal Saniye per Metre","@language":"tr"},{"@value":"Pascal Second per Meter","@language":"en-us"},{"@value":"Pascal Second per Metre","@language":"en"},{"@value":"Pascal Second per Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Pascal Seconde par Mètre","@language":"fr"},{"@value":"Pascal Secondo per Metro","@language":"it"},{"@value":"Pascal Secundă pe Metru","@language":"ro"},{"@value":"Pascal Segundo por Metro","@language":"es"},{"@value":"Pascal Segundo por Metro","@language":"pt"},{"@value":"Pascal Sekunda na Meter","@language":"sl"},{"@value":"Pascal Sekunda na Metr","@language":"cs"},{"@value":"Pascal Sekunde pro Meter","@language":"de"},{"@value":"Pascalium Secundum per Metrum","@language":"la"},{"@value":"Paskal Sekunda na Metr","@language":"pl"},{"@value":"Πασκάλ Δευτερόλεπτο ανά Μέτρο","@language":"el"},{"@value":"Паскал Секунда на Метър","@language":"bg"},{"@value":"Паскаль Секунда на Метр","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/PA-SEC-PER-M3","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Pascal Second Per Cubic Meter}$ ($Pa-s/m^3$) is a unit in the category of Acoustic impedance.\n    It is also known as $\\textit{pascal-second/cubic meter}$. It has a dimension of $ML^{-4}T^{-1}$ where $M$ is mass, $L$ is\n    length, and $T$ is time. This unit is the standard SI unit in this category.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$Pa-s/m3$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-4I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4394"},{"@id":"_:n3-4395"},{"@id":"_:n3-4396"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AcousticImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/PressureInRelationToVolumeFlow"},{"@id":"http://qudt.org/vocab/quantitykind/PressureInRelationToVolumeFlowRate"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/M3-PER-SEC-PA"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA263","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.efunda.com/glossary/units/units--acoustic_impedance--pascal_second_per_cubic_meter.cfm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA263","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/siUnitsExpression":[{"@value":"Pa.s/m3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Pa·s/m³","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Pa.s.m-3","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"C66","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AcousticImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/PressureInRelationToVolumeFlow"},{"@id":"http://qudt.org/vocab/quantitykind/PressureInRelationToVolumeFlowRate"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q87047886"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pascal Saat per Meter Kubik","@language":"ms"},{"@value":"Pascal Saniye per Metreküp","@language":"tr"},{"@value":"Pascal Second per Cubic Meter","@language":"en-us"},{"@value":"Pascal Second per Cubic Metre","@language":"en"},{"@value":"Pascal Second per Cubic Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Pascal Seconde par Mètre Cube","@language":"fr"},{"@value":"Pascal Secondo per Metro Cubo","@language":"it"},{"@value":"Pascal Secundă pe Metru Cub","@language":"ro"},{"@value":"Pascal Segundo por Metro Cúbico","@language":"es"},{"@value":"Pascal Segundo por Metro Cúbico","@language":"pt"},{"@value":"Pascal Sekunda na Kubični Meter","@language":"sl"},{"@value":"Pascal Sekunda na Metr Krychlový","@language":"cs"},{"@value":"Pascal Sekunde pro Kubikmeter","@language":"de"},{"@value":"Pascalium Secundum per Metrum Cubicum","@language":"la"},{"@value":"Paskal Sekunda na Metr Sześcienny","@language":"pl"},{"@value":"Πασκάλ Δευτερόλεπτο ανά Κυβικό Μέτρο","@language":"el"},{"@value":"Паскал Секунда на Кубичен Метър","@language":"bg"},{"@value":"Паскаль Секунда на Кубический Метр","@language":"ru"},{"@value":"باسكال ثانية لكل متر مكعب","@language":"ar"},{"@value":"نیوتون ثانیه بر متر مکعب","@language":"fa"},{"@value":"पास्कल सैकण्ड प्रति घन मीटर","@language":"hi"},{"@value":"パスカル秒毎立方メートル","@language":"ja"}]},{"@id":"http://qudt.org/vocab/unit/PA2-PER-SEC2","@type":["http://qudt.org/schema/qudt/Unit"],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/categorizedByQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Unknown"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M2H0T-6D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4397"},{"@id":"_:n3-4398"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Unknown"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Pa²/s²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Pa2.s-2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Kvadratni Pascal na Kvadratni Sekunda","@language":"sl"},{"@value":"Pascal Carré par Seconde Carré","@language":"fr"},{"@value":"Pascal Cuadrado por Segundo Cuadrado","@language":"es"},{"@value":"Pascal Persegi per Saat Persegi","@language":"ms"},{"@value":"Pascal Pătrat pe Secundă Pătrat","@language":"ro"},{"@value":"Pascal Quadrado por Segundo Quadrado","@language":"pt"},{"@value":"Pascal Quadrato per Secondo Quadrato","@language":"it"},{"@value":"Pascalium Quadratum per Secundum Quadratum","@language":"la"},{"@value":"Pascalkare per Saniyekare","@language":"tr"},{"@value":"Paskal Kwadratowy na Sekunda Kwadratowy","@language":"pl"},{"@value":"Quadratpascal pro Quadratsekunde","@language":"de"},{"@value":"Square Pascal per Square Second","@language":"en"},{"@value":"Square Pascal per Square Second","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Čtvereční Pascal na Čtvereční Sekunda","@language":"cs"},{"@value":"Τετραγωνικό Πασκάλ ανά Τετραγωνικό Δευτερόλεπτο","@language":"el"},{"@value":"Квадратен Паскал на Квадратен Секунда","@language":"bg"},{"@value":"Квадратный Паскаль на Квадратный Секунда","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/PA2-SEC","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Square Pascal Second ($Pa^2\\cdot s$) is a unit in the category of sound exposure.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$Pa2-s$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M2H0T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4399"},{"@id":"_:n3-4400"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SoundExposure"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB339","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.efunda.com/glossary/units/units--specific_acoustic_impedance--pascal_second_per_meter.cfm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB339","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/siUnitsExpression":[{"@value":"Pa2.s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Pa²·s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Pa2.s","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"P42","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SoundExposure"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q86897783"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Kvadratni Pascal Sekunda","@language":"sl"},{"@value":"Pascal Carré Seconde","@language":"fr"},{"@value":"Pascal Cuadrado Segundo","@language":"es"},{"@value":"Pascal Persegi Saat","@language":"ms"},{"@value":"Pascal Pătrat Secundă","@language":"ro"},{"@value":"Pascal Quadrado Segundo","@language":"pt"},{"@value":"Pascal Quadrato Secondo","@language":"it"},{"@value":"Pascalium Quadratum Secundum","@language":"la"},{"@value":"Pascalkare Saniye","@language":"tr"},{"@value":"Paskal Kwadratowy Sekunda","@language":"pl"},{"@value":"Quadratpascal Sekunde","@language":"de"},{"@value":"Square Pascal Second","@language":"en"},{"@value":"Square Pascal Second","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Čtvereční Pascal Sekunda","@language":"cs"},{"@value":"Τετραγωνικό Πασκάλ Δευτερόλεπτο","@language":"el"},{"@value":"Квадратен Паскал Секунда","@language":"bg"},{"@value":"Квадратный Паскаль Секунда","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/PARSEC","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The parsec (parallax of one arcsecond; symbol: pc) is a unit of length, equal to just under 31 trillion\n    ($31 \\times 10^{12}$) kilometres (about 19 trillion miles), 206265 AU, or about 3.26 light-years. The parsec measurement unit\n    is used in astronomy. It is defined as the length of the adjacent side of an imaginary right triangle in space. The two\n    dimensions that specify this triangle are the parallax angle (defined as 1 arcsecond) and the opposite side (defined as 1\n    astronomical unit (AU), the distance from the Earth to the Sun). Given these two measurements, along with the rules of\n    trigonometry, the length of the adjacent side (the parsec) can be found.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"30856780000000000.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"3.085678E16","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB067","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB067","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/parsec"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/M"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"pc","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"pc","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"C63","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q12129"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Parsec","@language":"en"},{"@value":"Parsec","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/PCA","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A pica is a typographic unit of measure corresponding to 1/72 of its respective foot, and therefore to\n    1/6 of an inch. The pica contains 12 point units of measure. Notably, Adobe PostScript promoted the pica unit of measure that\n    is the standard in contemporary printing, as in home computers and printers. Usually, pica measurements are represented with\n    an upper-case 'P' with an upper-right-to-lower-left virgule (slash) starting in the upper right portion of the 'P' and ending\n    at the lower left of the upright portion of the 'P'; essentially drawing a virgule (/) through a 'P'.  Note that these\n    definitions are different from a typewriter's pica setting, which denotes a type size of ten characters per horizontal inch.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0042333","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"4.2333E-3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Pica","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB606","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB606","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Pica?oldid=458102937","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/M"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"pc","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[pca]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"R1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q2718629"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pica","@language":"en"},{"@value":"Pica","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/PDL","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The poundal is a unit of force that is part of the foot-pound-second system of units, in Imperial units\n    introduced in 1877, and is from the specialized subsystem of English absolute (a coherent system). The poundal is defined as\n    the force necessary to accelerate 1 pound-mass to 1 foot per second per second. $1 pdl = 0.138254954376 N$ exactly.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.138254954376","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.38254954376E-1","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Poundal","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Force"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB233","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB233","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Poundal?oldid=494626458","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/poundal"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/N"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"pdl","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[lb_av].[ft_i].s-2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"M76","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Force"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1972579"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Poundal","@language":"en"},{"@value":"Poundal","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/PDL-FT","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"product from the non SI-conform unit of the force poundal and the unit foot according to the\n    Anglo-American and Imperial system of units\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0421401100938048","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"4.21401100938048E-2","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4401"},{"@id":"_:n3-4402"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MomentOfForce"},{"@id":"http://qudt.org/vocab/quantitykind/Torque"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB417","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB417","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"pdl·ft","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[lb_av].[ft_i].s-2.[ft_i]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"M95","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MomentOfForce"},{"@id":"http://qudt.org/vocab/quantitykind/Torque"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Poundal Foot","@language":"en"},{"@value":"Poundal Foot","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/PDL-IN","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"product of the non SI-conform unit of the force poundal and the unit inch according to the Anglo-American\n    and Imperial system of units\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0035116758411504","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"3.5116758411504E-3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4403"},{"@id":"_:n3-4404"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MomentOfForce"},{"@id":"http://qudt.org/vocab/quantitykind/Torque"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB418","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB418","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"pdl·in","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[lb_av].[ft_i].s-2.[in_i]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"M96","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MomentOfForce"},{"@id":"http://qudt.org/vocab/quantitykind/Torque"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Poundal Inch","@language":"en"},{"@value":"Poundal Inch","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/PDL-PER-FT2","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\n  A $\\textit{Poundal Per Square Foot}$, ($pdl/ft^2$), is a unit in the category of Pressure.\n  It is also known as poundals per square foot, poundal/square foot.\n  This unit is commonly used in the UK, US unit systems.\n  A $\\textit{Poundal Per Square Foot}$ has a dimension of $ML^{-1}T^{-2}$,\n   where $M$ is mass, $L$ is length, and $T$ is time.\n   It can be converted to the corresponding standard SI unit $\\textit{Pa}$ by multiplying its value\n    by a factor of 1.488163944.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.488163943569553805774278215223097","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.488163943569553805774278215223097E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$pdl/ft^2$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4405"},{"@id":"_:n3-4406"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"},{"@id":"http://qudt.org/vocab/quantitykind/VapourPressure"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB243","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.efunda.com/glossary/units/units--pressure--poundal_per_square_foot.cfm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB243","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"pdl/ft²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[lb_av].[ft_i].s-2.[ft_i]-2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"N21","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"},{"@id":"http://qudt.org/vocab/quantitykind/VapourPressure"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q107410782"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Poundal per Square Foot","@language":"en"},{"@value":"Poundal per Square Foot","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/PDL-PER-IN","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"non SI-conform unit of the surface tension according to the Imperial unit system as quotient poundal by\n    inch\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"5.44310844","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"5.44310844E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4407"},{"@id":"_:n3-4408"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerLength"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB453","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB453","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"pdl/in","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[lb_av].[ft_i].s-2.[in_i]-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"N32","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerLength"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Poundal per Inch","@language":"en"},{"@value":"Poundal per Inch","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/PDL-PER-IN2","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"non SI-conform unit of the pressure according to the Imperial system of units (poundal by square inch)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"214.295607874015748031496062992126","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conv