chema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"YC","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCharge"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q94415526"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Yottacoulomb","@language":"cs"},{"@value":"Yottacoulomb","@language":"de"},{"@value":"Yottacoulomb","@language":"en"},{"@value":"Yottacoulomb","@language":"fr"},{"@value":"Yottacoulomb","@language":"hu"},{"@value":"Yottacoulomb","@language":"it"},{"@value":"Yottacoulomb","@language":"ms"},{"@value":"Yottacoulomb","@language":"ro"},{"@value":"Yottacoulomb","@language":"sl"},{"@value":"Yottacoulomb","@language":"tr"},{"@value":"Yottacoulomb","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Yottaculombio","@language":"es"},{"@value":"Yottakulomb","@language":"pl"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"http://qudt.org/vocab/unit/C"}]},{"@id":"http://qudt.org/vocab/unit/Z","@type":["http://qudt.org/schema/qudt/CountingUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"In chemistry and physics, the atomic number (also known as the proton number) is the number of protons\n    found in the nucleus of an atom and therefore identical to the charge number of the nucleus. It is conventionally represented\n    by the symbol Z. The atomic number uniquely identifies a chemical element. In an atom of neutral charge, the atomic number is\n    also equal to the number of electrons.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"0.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Atomic_number","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AtomicNumber"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Atomic_number?oldid=490723437","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Z","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AtomicNumber"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Atomic-number","@language":"en"},{"@value":"Atomic-number","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/ZOLL","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"length measure corresponding to the imperial unit \"inch\"","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0254","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"2.54E-2","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/unit/IN"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/iec61360Code":