ergy"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Energy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Energy Content","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}]},{"@id":"http://qudt.org/vocab/quantitykind/EnergyDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\n  Energy density is defined as energy per unit volume. \n  The SI unit for energy density is the joule per cubic meter.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-FT3"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-FT3"},{"@id":"http://qudt.org/vocab/unit/ERG-PER-CentiM3"},{"@id":"http://qudt.org/vocab/unit/J-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MegaJ-PER-M3"},{"@id":"http://qudt.org/vocab/unit/W-HR-PER-M3"}],"http://qudt.org/schema/qudt/baseISOUnitDimensions":[{"@value":"$m^{-1} \\cdot kg \\cdot s^{-2}$","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/baseImperialUnitDimensions":[{"@value":"$ft^{-1} \\cdot lb \\cdot s^{-2}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/baseSIUnitDimensions":[{"@value":"$m^{-1} \\cdot kg \\cdot s^{-2}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/baseUSCustomaryUnitDimensions":[{"@value":"$L^{-1} \\cdot M \\cdot T^{-2}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Energy_density","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ316#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD047","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD047","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Energy_density","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Energy density is defined as energy per unit volume. The SI unit for energy density is the joule\n    per cubic meter.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/ENGD"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q828402"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EnergyDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Energy Density","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/EnergyDensityOfStates","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Energy Density of States\" refers to electrons or other entities, e.g. phonons. It quantifies the numnber\n    of states in an infitesimal energy range, per volume, and has dimensionality of inverse energy times inverse volume.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PER-EV-M3"},{"@id":"http://qudt.org/vocab/unit/PER-J-M3"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/StateDensity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-5I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD030","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD030","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Density_of_states","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\rho(E) = n_E(E) = \\frac{dN(E)}{dE}\\frac{1}{V}$, where $N(E)$ is the total number of states with energy less than $E$, and $V$ is the volume.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Energy Density of States\" refers to electrons or other entities, e.g. phonons.  It quantifies the\n    numnber of states in an infitesimal energy range, per volume, and has dimensionality of inverse energy times inverse volume.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"n_E","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q105687031"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EnergyDensityOfStates","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Energy Density of States","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/VibrationalDensityOfStates"}]},{"@id":"http://qudt.org/vocab/quantitykind/EnergyExpenditure","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Energy expenditure is dependent on a person's sex, metabolic rate, body-mass composition, the thermic\n    effects of food, and activity level.  The approximate energy expenditure of a man lying in bed is\n    $1.0\\,kilo\\,calorie\\,per\\,hour\\,per\\,kilogram$. For slow walking (just over two miles per hour),\n    $3.0\\,kilo\\,calorie\\,per\\,hour\\,per\\,kilogram$. For fast steady running (about 10 miles per hour),\n    $16.3\\,kilo\\,calorie\\,per\\,hour\\,per\\,kilogram$. Females expend about 10 per cent less energy than males of the same\n    size doing a comparable activity.  For people weighing the same, individuals with a high percentage of body fat usually expend\n    less energy than lean people, because fat is not as metabolically active as muscle.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ERG-PER-GM-SEC"},{"@id":"http://qudt.org/vocab/unit/MilliW-PER-MilliGM"},{"@id":"http://qudt.org/vocab/unit/W-PER-GM"},{"@id":"http://qudt.org/vocab/unit/W-PER-KiloGM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.oxfordreference.com/display/10.1093/acref/9780198631477.001.0001/acref-9780198631477-e-594","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MassicPower"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificPower","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Energy Expenditure","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MassicPower"}]},{"@id":"http://qudt.org/vocab/quantitykind/EnergyFluence","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Energy Fluence\" can be used to describe the energy delivered per unit area","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/GigaJ-PER-M2"},{"@id":"http://qudt.org/vocab/unit/J-PER-M2"},{"@id":"http://qudt.org/vocab/unit/LANGLEY"},{"@id":"http://qudt.org/vocab/unit/MilliJ-PER-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Fluence","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\Psi = \\frac{dR}{dA}$, where $dR$ describes the sum of radiant energies, exclusive of rest energy, of all particles incident on a small spherical domain, and $dA$ describes the cross-sectional area of that domain.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Psi$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Energy Fluence\" can be used to describe the energy delivered per unit area","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerArea"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98538612"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EnergyFluence","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Energy Fluence","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/EnergyFluenceRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Energy Fluence Rate\" can be used to describe the energy fluence delivered per unit time.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-FT2-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-FT2-SEC"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-HR-FT2"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-IN2-SEC"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-SEC-FT2"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-FT2-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-FT2-MIN"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-FT2-SEC"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-CentiM2-MIN"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-CentiM2-SEC"},{"@id":"http://qudt.org/vocab/unit/ERG-PER-CentiM2-SEC"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F-PER-FT2-SEC"},{"@id":"http://qudt.org/vocab/unit/J-PER-CentiM2-DAY"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-CentiM2-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-CentiM2-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/M-PA-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MicroW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MilliW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/NanoW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/PicoW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/W-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/W-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/W-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/W-PER-M2"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/TotalRadiance"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Fluence","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\Psi = \\frac{d\\Psi}{dt}$, where $d\\Psi$ is the increment of the energy fluence during an infinitesimal time interval with duration $dt$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Energy Fluence Rate\" can be used to describe the energy fluence delivered per unit time.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/PowerPerArea"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Ψ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q65274525"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:PowerPerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Energy Fluence Rate","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/PowerPerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/EnergyImparted","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Energy Imparted\", is a physical quantity associated with the energy delivered to a particular volume\n    of matter by all the directly and indirectly ionizing particles (i.e. charged and uncharged) entering that volume.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AttoJ"},{"@id":"http://qudt.org/vocab/unit/BTU_IT"},{"@id":"http://qudt.org/vocab/unit/BTU_TH"},{"@id":"http://qudt.org/vocab/unit/CAL_IT"},{"@id":"http://qudt.org/vocab/unit/CAL_TH"},{"@id":"http://qudt.org/vocab/unit/ERG"},{"@id":"http://qudt.org/vocab/unit/EV"},{"@id":"http://qudt.org/vocab/unit/E_h"},{"@id":"http://qudt.org/vocab/unit/ExaJ"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F_Energy"},{"@id":"http://qudt.org/vocab/unit/FT-PDL"},{"@id":"http://qudt.org/vocab/unit/FemtoJ"},{"@id":"http://qudt.org/vocab/unit/GigaEV"},{"@id":"http://qudt.org/vocab/unit/GigaJ"},{"@id":"http://qudt.org/vocab/unit/GigaW-HR"},{"@id":"http://qudt.org/vocab/unit/J"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH"},{"@id":"http://qudt.org/vocab/unit/KiloCAL"},{"@id":"http://qudt.org/vocab/unit/KiloEV"},{"@id":"http://qudt.org/vocab/unit/KiloJ"},{"@id":"http://qudt.org/vocab/unit/KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT"},{"@id":"http://qudt.org/vocab/unit/MegaEV"},{"@id":"http://qudt.org/vocab/unit/MegaJ"},{"@id":"http://qudt.org/vocab/unit/MegaTOE"},{"@id":"http://qudt.org/vocab/unit/MegaW-HR"},{"@id":"http://qudt.org/vocab/unit/MicroJ"},{"@id":"http://qudt.org/vocab/unit/MilliJ"},{"@id":"http://qudt.org/vocab/unit/NanoJ"},{"@id":"http://qudt.org/vocab/unit/PetaJ"},{"@id":"http://qudt.org/vocab/unit/PicoJ"},{"@id":"http://qudt.org/vocab/unit/PlanckEnergy"},{"@id":"http://qudt.org/vocab/unit/QUAD"},{"@id":"http://qudt.org/vocab/unit/THERM_EC"},{"@id":"http://qudt.org/vocab/unit/THERM_US"},{"@id":"http://qudt.org/vocab/unit/THM_EEC"},{"@id":"http://qudt.org/vocab/unit/THM_US"},{"@id":"http://qudt.org/vocab/unit/TOE"},{"@id":"http://qudt.org/vocab/unit/TeraJ"},{"@id":"http://qudt.org/vocab/unit/TeraW-HR"},{"@id":"http://qudt.org/vocab/unit/TonEnergy"},{"@id":"http://qudt.org/vocab/unit/W-HR"},{"@id":"http://qudt.org/vocab/unit/W-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.answers.com/topic/energy-imparted","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"For ionizing radiation in the matter in a given 3D domain, $\\varepsilon = \\sum_i \\varepsilon_i$, where the energy deposit, $\\varepsilon_i$ is the energy deposited in a single interaction $i$, and is given by $\\varepsilon_i = \\varepsilon_{in} - \\varepsilon_{out} + Q$, where $\\varepsilon_{in}$ is the energy of the incident ionizing particle, excluding rest energy, $\\varepsilon_{out}$ is the sum of the energies of all ionizing particles leaving the interaction, excluding rest energy, and $Q$ is the change in the rest energies of the nucleus and of all particles involved in the interaction.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Energy Imparted\", is a physical quantity associated with the energy delivered to a particular\n    volume of matter by all the directly and indirectly ionizing particles (i.e. charged and uncharged) entering that volume.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"ε","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q99526944"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Energy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Energy Imparted","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}]},{"@id":"http://qudt.org/vocab/quantitykind/EnergyInternal","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The internal energy is the total energy contained by a thermodynamic system. It is the energy needed to\n    create the system, but excludes the energy to displace the system's surroundings, any energy associated with a move as a\n    whole, or due to external force fields. Internal energy has two major components, kinetic energy and potential energy. The\n    internal energy (U) is the sum of all forms of energy (Ei) intrinsic to a thermodynamic system:  $  U = \\sum_i E_i $\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/InternalEnergy"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Internal_energy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Internal_energy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"U","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q180241"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Notranja energija","@language":"sl"},{"@value":"Tenaga dalaman","@language":"ms"},{"@value":"energia interna","@language":"it"},{"@value":"energia interna","@language":"pt"},{"@value":"energia wewnętrzna","@language":"pl"},{"@value":"energie internă","@language":"ro"},{"@value":"energía interna","@language":"es"},{"@value":"innere Energie","@language":"de"},{"@value":"internal energy","@language":"en"},{"@value":"vnitřní energie","@language":"cs"},{"@value":"énergie interne","@language":"fr"},{"@value":"İç enerji","@language":"tr"},{"@value":"внутренняя энергия","@language":"ru"},{"@value":"انرژی درونی","@language":"fa"},{"@value":"طاقة داخلية","@language":"ar"},{"@value":"आन्तरिक ऊर्जा","@language":"hi"},{"@value":"内能","@language":"zh"},{"@value":"内部エネルギー","@language":"ja"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"energia termodinamica","@language":"it"},{"@value":"tenaga termodinamik","@language":"ms"},{"@value":"thermodynamic energy","@language":"en"},{"@value":"thermodynamische Energie","@language":"de"},{"@value":"énergie thermodynamique","@language":"fr"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}]},{"@id":"http://qudt.org/vocab/quantitykind/EnergyKinetic","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The kinetic energy of an object is the energy which it possesses due to its motion. It is defined as the\n    work needed to accelerate a body of a given mass from rest to its stated velocity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/KineticEnergy"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Kinetic_energy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Kinetic_energy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The kinetic energy of an object is the energy which it possesses due to its motion. It is defined\n    as the work needed to accelerate a body of a given mass from rest to its stated velocity.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q46276"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Energie cinetică","@language":"ro"},{"@value":"Kinetik enerji","@language":"tr"},{"@value":"Tenaga kinetik","@language":"ms"},{"@value":"energia cinetica","@language":"it"},{"@value":"energia cinética","@language":"pt"},{"@value":"energia kinetyczna","@language":"pl"},{"@value":"energía cinética","@language":"es"},{"@value":"kinetic energy","@language":"en"},{"@value":"kinetická energie","@language":"cs"},{"@value":"kinetische Energie","@language":"de"},{"@value":"énergie cinétique","@language":"fr"},{"@value":"кинетическая энергия","@language":"ru"},{"@value":"انرژی جنبشی","@language":"fa"},{"@value":"طاقة حركية","@language":"ar"},{"@value":"गतिज ऊर्जा","@language":"hi"},{"@value":"动能","@language":"zh"},{"@value":"運動エネルギー","@language":"ja"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}]},{"@id":"http://qudt.org/vocab/quantitykind/EnergyLevel","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Energy Level\" is the ionization energy for an electron at the Fermi energy in the interior of a\n    substance.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AttoJ"},{"@id":"http://qudt.org/vocab/unit/BTU_IT"},{"@id":"http://qudt.org/vocab/unit/BTU_TH"},{"@id":"http://qudt.org/vocab/unit/CAL_IT"},{"@id":"http://qudt.org/vocab/unit/CAL_TH"},{"@id":"http://qudt.org/vocab/unit/ERG"},{"@id":"http://qudt.org/vocab/unit/EV"},{"@id":"http://qudt.org/vocab/unit/E_h"},{"@id":"http://qudt.org/vocab/unit/ExaJ"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F_Energy"},{"@id":"http://qudt.org/vocab/unit/FT-PDL"},{"@id":"http://qudt.org/vocab/unit/FemtoJ"},{"@id":"http://qudt.org/vocab/unit/GigaEV"},{"@id":"http://qudt.org/vocab/unit/GigaJ"},{"@id":"http://qudt.org/vocab/unit/GigaW-HR"},{"@id":"http://qudt.org/vocab/unit/J"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH"},{"@id":"http://qudt.org/vocab/unit/KiloCAL"},{"@id":"http://qudt.org/vocab/unit/KiloEV"},{"@id":"http://qudt.org/vocab/unit/KiloJ"},{"@id":"http://qudt.org/vocab/unit/KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT"},{"@id":"http://qudt.org/vocab/unit/MegaEV"},{"@id":"http://qudt.org/vocab/unit/MegaJ"},{"@id":"http://qudt.org/vocab/unit/MegaTOE"},{"@id":"http://qudt.org/vocab/unit/MegaW-HR"},{"@id":"http://qudt.org/vocab/unit/MicroJ"},{"@id":"http://qudt.org/vocab/unit/MilliJ"},{"@id":"http://qudt.org/vocab/unit/NanoJ"},{"@id":"http://qudt.org/vocab/unit/PetaJ"},{"@id":"http://qudt.org/vocab/unit/PicoJ"},{"@id":"http://qudt.org/vocab/unit/PlanckEnergy"},{"@id":"http://qudt.org/vocab/unit/QUAD"},{"@id":"http://qudt.org/vocab/unit/THERM_EC"},{"@id":"http://qudt.org/vocab/unit/THERM_US"},{"@id":"http://qudt.org/vocab/unit/THM_EEC"},{"@id":"http://qudt.org/vocab/unit/THM_US"},{"@id":"http://qudt.org/vocab/unit/TOE"},{"@id":"http://qudt.org/vocab/unit/TeraJ"},{"@id":"http://qudt.org/vocab/unit/TeraW-HR"},{"@id":"http://qudt.org/vocab/unit/TonEnergy"},{"@id":"http://qudt.org/vocab/unit/W-HR"},{"@id":"http://qudt.org/vocab/unit/W-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Energy Level\" is the ionization energy for an electron at the Fermi energy in the interior of a\n    substance.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"E","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Energy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Energy Level","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}]},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerArea","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Energy per unit area is a measure of the energy either impinging upon or generated from a given unit of\n    area. This can be a measure of the \"toughness\" of a material, being the amount of energy that needs to be applied per unit\n    area of a crack to cause it to fracture. This is a constant for a given material..\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/CentiN-M-PER-M2"},{"@id":"http://qudt.org/vocab/unit/ERG-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F-PER-M2"},{"@id":"http://qudt.org/vocab/unit/GigaJ-PER-M2"},{"@id":"http://qudt.org/vocab/unit/GigaN-M-PER-M2"},{"@id":"http://qudt.org/vocab/unit/GigaW-HR-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/GigaW-HR-PER-M2"},{"@id":"http://qudt.org/vocab/unit/J-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/J-PER-M2"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F-M-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloN-M-PER-M2"},{"@id":"http://qudt.org/vocab/unit/KiloW-HR-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/KiloW-HR-PER-M2"},{"@id":"http://qudt.org/vocab/unit/LANGLEY"},{"@id":"http://qudt.org/vocab/unit/MegaJ-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MegaN-M-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MegaW-HR-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/MegaW-HR-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MicroN-M-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MilliJ-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MilliN-M-PER-M2"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-M2"},{"@id":"http://qudt.org/vocab/unit/NanoN-M-PER-M2"},{"@id":"http://qudt.org/vocab/unit/W-HR-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/W-HR-PER-M2"},{"@id":"http://qudt.org/vocab/unit/W-SEC-PER-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.calculator.org/property.aspx?name=energy%20per%20unit%20area","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Energy per unit area is a measure of the energy either impinging upon or generated from a given\n    unit of area. This can be a measure of the \"toughness\" of a material, being the amount of energy that needs to be applied per\n    unit area of a crack to cause it to fracture. This is a constant for a given material..\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EnergyPerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Energy per Area","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerAreaElectricCharge","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Energy Per Area Electric Charge\" is the amount of electric energy associated with a unit of area.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/V-PER-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Energy Per Area Electric Charge\" is the amount of electric energy associated with a unit of area.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EnergyPerAreaElectricCharge","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Energy per Area Electric Charge","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerElectricCharge","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Voltage is a representation of the electric potential energy per unit charge. If a unit of electrical\n    charge were placed in a location, the voltage indicates the potential energy of it at that point. In other words, it is a\n    measurement of the energy contained within an electric field, or an electric circuit, at a given point. Voltage is a scalar\n    quantity. The SI unit of voltage is the volt, such that $1 volt = 1 joule/coulomb$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ExaV"},{"@id":"http://qudt.org/vocab/unit/FemtoV"},{"@id":"http://qudt.org/vocab/unit/GigaV"},{"@id":"http://qudt.org/vocab/unit/KiloV"},{"@id":"http://qudt.org/vocab/unit/MegaV"},{"@id":"http://qudt.org/vocab/unit/MicroV"},{"@id":"http://qudt.org/vocab/unit/MilliV"},{"@id":"http://qudt.org/vocab/unit/NanoV"},{"@id":"http://qudt.org/vocab/unit/PetaV"},{"@id":"http://qudt.org/vocab/unit/PicoV"},{"@id":"http://qudt.org/vocab/unit/PlanckVolt"},{"@id":"http://qudt.org/vocab/unit/TeraV"},{"@id":"http://qudt.org/vocab/unit/V"},{"@id":"http://qudt.org/vocab/unit/V_Ab"},{"@id":"http://qudt.org/vocab/unit/V_Stat"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotential"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotentialDifference"},{"@id":"http://qudt.org/vocab/quantitykind/Voltage"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.about.com/od/glossary/g/voltage.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"V","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EnergyPerElectricCharge","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Energy per Electric Charge","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerMagneticFluxDensity_Squared","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Energy Per Square Magnetic Flux Density\" is a measure of energy for a unit of magnetic flux density.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerSquareMagneticFluxDensity"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E2L2I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Energy Per Square Magnetic Flux Density\" is a measure of energy for a unit of magnetic flux\n    density.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Energy Per Square Magnetic Flux Density","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerMassAmountOfSubstance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-MOL_LB"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H0T-2D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EnergyPerMassAmountOfSubstance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Energy and Work per Mass Amount of Substance","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerSquareMagneticFluxDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Energy Per Square Magnetic Flux Density\" is a measure of energy for a unit of magnetic flux density.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-T2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E2L2I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Energy Per Square Magnetic Flux Density\" is a measure of energy for a unit of magnetic flux\n    density.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EnergyPerSquareMagneticFluxDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Energy per Square Magnetic Flux Density","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerTemperature","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H-1T-2D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EnergyPerTemperature","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Energy per Temperature","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Energy_Squared","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/SquareEnergy"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L4I0M2H0T-4D0"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Square Energy","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Enthalpy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In thermodynamics, $\\textit{enthalpy}$ is the sum of the internal energy $U$ and the product of pressure\n    $p$ and volume $V$ of a system. The characteristic function (also known as thermodynamic potential) $\\textit{enthalpy}$ used\n    to be called $\\textit{heat content}$, which is why it is conventionally indicated by $H$. The specific enthalpy of a working\n    mass is a property of that mass used in thermodynamics, defined as $h=u+p \\cdot v$,  where $u$ is the specific internal\n    energy, $p$ is the pressure, and $v$ is specific volume. In other words, $h = H / m$ where $m$ is the mass of the system. The\n    SI unit for $\\textit{Specific Enthalpy}$ is $\\textit{joules per kilogram}$\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AttoJ"},{"@id":"http://qudt.org/vocab/unit/BTU_IT"},{"@id":"http://qudt.org/vocab/unit/BTU_TH"},{"@id":"http://qudt.org/vocab/unit/CAL_IT"},{"@id":"http://qudt.org/vocab/unit/CAL_TH"},{"@id":"http://qudt.org/vocab/unit/ERG"},{"@id":"http://qudt.org/vocab/unit/EV"},{"@id":"http://qudt.org/vocab/unit/E_h"},{"@id":"http://qudt.org/vocab/unit/ExaJ"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F_Energy"},{"@id":"http://qudt.org/vocab/unit/FT-PDL"},{"@id":"http://qudt.org/vocab/unit/FemtoJ"},{"@id":"http://qudt.org/vocab/unit/GigaEV"},{"@id":"http://qudt.org/vocab/unit/GigaJ"},{"@id":"http://qudt.org/vocab/unit/GigaW-HR"},{"@id":"http://qudt.org/vocab/unit/J"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH"},{"@id":"http://qudt.org/vocab/unit/KiloCAL"},{"@id":"http://qudt.org/vocab/unit/KiloEV"},{"@id":"http://qudt.org/vocab/unit/KiloJ"},{"@id":"http://qudt.org/vocab/unit/KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT"},{"@id":"http://qudt.org/vocab/unit/MegaEV"},{"@id":"http://qudt.org/vocab/unit/MegaJ"},{"@id":"http://qudt.org/vocab/unit/MegaTOE"},{"@id":"http://qudt.org/vocab/unit/MegaW-HR"},{"@id":"http://qudt.org/vocab/unit/MicroJ"},{"@id":"http://qudt.org/vocab/unit/MilliJ"},{"@id":"http://qudt.org/vocab/unit/NanoJ"},{"@id":"http://qudt.org/vocab/unit/PetaJ"},{"@id":"http://qudt.org/vocab/unit/PicoJ"},{"@id":"http://qudt.org/vocab/unit/PlanckEnergy"},{"@id":"http://qudt.org/vocab/unit/QUAD"},{"@id":"http://qudt.org/vocab/unit/THERM_EC"},{"@id":"http://qudt.org/vocab/unit/THERM_US"},{"@id":"http://qudt.org/vocab/unit/THM_EEC"},{"@id":"http://qudt.org/vocab/unit/THM_US"},{"@id":"http://qudt.org/vocab/unit/TOE"},{"@id":"http://qudt.org/vocab/unit/TeraJ"},{"@id":"http://qudt.org/vocab/unit/TeraW-HR"},{"@id":"http://qudt.org/vocab/unit/TonEnergy"},{"@id":"http://qudt.org/vocab/unit/W-HR"},{"@id":"http://qudt.org/vocab/unit/W-SEC"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Enthalpy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://en.citizendium.org/wiki/Enthalpy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Enthalpy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$H = U + pV$, where $U$ is internal energy, $p$ is pressure and $V$ is volume.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"H","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q161064"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Energy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Entalpi","@language":"ms"},{"@value":"Entalpi","@language":"tr"},{"@value":"Entalpie","@language":"ro"},{"@value":"Enthalpie","@language":"de"},{"@value":"Enthalpy","@language":"en"},{"@value":"entalpia","@language":"it"},{"@value":"entalpia","@language":"pl"},{"@value":"entalpia","@language":"pt"},{"@value":"entalpie","@language":"cs"},{"@value":"entalpija","@language":"sl"},{"@value":"entalpía","@language":"es"},{"@value":"enthalpie","@language":"fr"},{"@value":"энтальпия","@language":"ru"},{"@value":"آنتالپی","@language":"fa"},{"@value":"محتوى حراري","@language":"ar"},{"@value":"पूर्ण ऊष्मा","@language":"hi"},{"@value":"エンタルピー","@language":"ja"},{"@value":"焓","@language":"zh"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/InternalEnergy"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}]},{"@id":"http://qudt.org/vocab/quantitykind/Entropy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"When a small amount of heat $dQ$ is received by a system whose thermodynamic temperature is $T$, the\n    entropy of the system increases by $dQ/T$, provided that no irreversible change takes place in the system.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-K"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Entropy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H-1T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD398","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD398","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"S","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q45003"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Entropy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Entropi","@language":"ms"},{"@value":"Entropie","@language":"de"},{"@value":"Entropy","@language":"en"},{"@value":"entropi","@language":"tr"},{"@value":"entropia","@language":"it"},{"@value":"entropia","@language":"pl"},{"@value":"entropia","@language":"pt"},{"@value":"entropie","@language":"cs"},{"@value":"entropie","@language":"fr"},{"@value":"entropie","@language":"ro"},{"@value":"entropija","@language":"sl"},{"@value":"entropía","@language":"es"},{"@value":"Энтропия","@language":"ru"},{"@value":"آنتروپی","@language":"fa"},{"@value":"إنتروبيا","@language":"ar"},{"@value":"एन्ट्रॉपी","@language":"hi"},{"@value":"エントロピー","@language":"ja"},{"@value":"熵","@language":"zh"}]},{"@id":"http://qudt.org/vocab/quantitykind/EquilibriumConstant","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Equlilbrium Constant\", also known as the thermodynamic equilibrium constant, is an expression that\n    gives us a ratio of the products and reactants of a reaction at equilibrium with respect to a specific unit.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Equilibrium_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$K^\\Theta = \\Pi_B(\\lambda_B^\\Theta)^{-\\nu_B}$, where $\\Pi_B$ denotes the product for all substances $B$, $\\lambda_B^\\Theta$ is the standard absolute activity of substance $B$, and $\\nu_B$ is the stoichiometric number of the substance $B$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$K^\\Theta$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Equlilbrium Constant\", also known as the thermodynamic equilibrium constant, is an expression\n    that gives us a ratio of the products and reactants of a reaction at equilibrium with respect to a specific unit.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q857809"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EquilibriumConstant","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Equilibrium Constant","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/EquilibriumConstantOnConcentrationBasis"},{"@id":"http://qudt.org/vocab/quantitykind/EquilibriumConstantOnPressureBasis"}]},{"@id":"http://qudt.org/vocab/quantitykind/EquilibriumConstantBasedOnConcentration","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The equilibrium constant of a reaction in solution expressed in absolute concentration units: Kc = ΠB(cB)νB,\n    the product of the equilibrium amount-of-substance concentrations raised to their stoichiometric numbers. This is the\n    dimensional form, maintained from the ECLASS vocabulary, carrying the dimension of amount-of-substance concentration with\n    values typically quoted in mol/L. The IEC 61360 / ISO 80000 vocabularies model the same concept as a dimensionless quantity by referring each concentration to its standard value — that dimensionless form is maintained separately as\n    quantitykind:EquilibriumConstantOnConcentrationBasis, because the two dimension conventions cannot be reconciled by a fixed\n    conversion factor.\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-M3"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ458#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L-3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD048","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD048","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Kc = ΠB(cB)νB für Lösungen","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EquilibriumConstantBasedOnConcentration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Equilibrium Constant Based On Concentration","@language":"en-us"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/EquilibriumConstantOnConcentrationBasis"}]},{"@id":"http://qudt.org/vocab/quantitykind/EquilibriumConstantBasedOnPressure","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The equilibrium constant of a gas-phase reaction expressed in absolute pressure units: Kp = ΠB(pB)νB, the\n    product of the equilibrium partial pressures raised to their stoichiometric numbers. This is the dimensional form, maintained\n    from the ECLASS vocabulary, carrying the dimension of pressure with values typically quoted in Pa or bar. The IEC 61360 /\n    ISO 80000 vocabularies model the same concept as a dimensionless quantity by referring each partial pressure to the\n    standard pressure — that dimensionless form is maintained separately as quantitykind:EquilibriumConstantOnPressureBasis,\n    because the two dimension conventions cannot be reconciled by a fixed conversion factor.\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BAR"},{"@id":"http://qudt.org/vocab/unit/PA"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ459#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD049","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD049","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Kp = ΠB(pB)νB für Gase","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EquilibriumConstantBasedOnPressure","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Equilibrium Constant Based On Pressure","@language":"en-us"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/EquilibriumConstantOnPressureBasis"}]},{"@id":"http://qudt.org/vocab/quantitykind/EquilibriumConstantOnConcentrationBasis","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The equilibrium constant of a reaction in solution expressed on a concentration basis, $K_c$: the product\n    of the equilibrium amount-of-substance concentrations raised to their stoichiometric numbers, with each concentration\n    referred to its standard value so that the quantity is dimensionless. This dimensionless convention follows the\n    ISO 80000 / IEC 61360 vocabularies. The ECLASS vocabulary models the same concept dimensionally, with concentrations in\n    absolute units — that form is maintained separately as quantitykind:EquilibriumConstantBasedOnConcentration, because the two\n    dimension conventions cannot be reconciled by a fixed conversion factor.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD048","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD048","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Equilibrium_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$K_c = \\Pi_B(c_B)^{-\\nu_B}$, for solutions","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$K_c$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/EquilibriumConstant"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The equilibrium constant of a reaction in solution expressed on a concentration basis, Kc: the\n    product of the equilibrium amount-of-substance concentrations raised to their stoichiometric numbers, with each concentration\n    referred to its standard value so that the quantity is dimensionless. This dimensionless convention follows the ISO 80000\n    / IEC 61360 vocabularies. The ECLASS vocabulary models the same concept dimensionally, with concentrations in absolute units\n    — that form is maintained separately as quantitykind:EquilibriumConstantBasedOnConcentration, because the two dimension\n    conventions cannot be reconciled by a fixed conversion factor.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q96096049"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EquilibriumConstantOnConcentrationBasis","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"The unit is unit:MOL-PER-M3 raised to the N where N is the summation of stoichiometric numbers. I don't know\n    what to do with this.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Equilibrium Constant On Concentration Basis","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/EquilibriumConstantBasedOnConcentration"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/EquilibriumConstant"}]},{"@id":"http://qudt.org/vocab/quantitykind/EquilibriumConstantOnPressureBasis","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The equilibrium constant of a gas-phase reaction expressed on a pressure basis, $K_p$: the product of the\n    equilibrium partial pressures raised to their stoichiometric numbers, with each partial pressure referred to the standard\n    pressure so that the quantity is dimensionless. This dimensionless convention follows the ISO 80000 / IEC 61360\n    vocabularies. The ECLASS vocabulary models the same concept dimensionally, with partial pressures in absolute units — that\n    form is maintained separately as quantitykind:EquilibriumConstantBasedOnPressure, because the two dimension conventions\n    cannot be reconciled by a fixed conversion factor.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD049","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD049","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Equilibrium_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$K_p = \\Pi_B(p_B)^{-\\nu_B}$, for gases","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$K_p$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/EquilibriumConstant"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The equilibrium constant of a gas-phase reaction expressed on a pressure basis, Kp: the product of\n    the equilibrium partial pressures raised to their stoichiometric numbers, with each partial pressure referred to the standard\n    pressure so that the quantity is dimensionless. This dimensionless convention follows the ISO 80000 / IEC 61360\n    vocabularies. The ECLASS vocabulary models the same concept dimensionally, with partial pressures in absolute units — that\n    form is maintained separately as quantitykind:EquilibriumConstantBasedOnPressure, because the two dimension conventions\n    cannot be reconciled by a fixed conversion factor.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T0D0"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q96096019"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EquilibriumConstantOnPressureBasis","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Equilibrium Constant On Pressure Basis","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/EquilibriumConstantBasedOnPressure"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/EquilibriumConstant"}]},{"@id":"http://qudt.org/vocab/quantitykind/EquilibriumPositionVectorOfIon","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Equilibrium Position Vector of Ion\" is the position vector of a particle in equilibrium.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ANGSTROM"},{"@id":"http://qudt.org/vocab/unit/AU"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB_F"},{"@id":"http://qudt.org/vocab/unit/CHAIN"},{"@id":"http://qudt.org/vocab/unit/CHAIN_US"},{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/DecaM"},{"@id":"http://qudt.org/vocab/unit/DeciM"},{"@id":"http://qudt.org/vocab/unit/FATH"},{"@id":"http://qudt.org/vocab/unit/FM"},{"@id":"http://qudt.org/vocab/unit/FT"},{"@id":"http://qudt.org/vocab/unit/FT_US"},{"@id":"http://qudt.org/vocab/unit/FUR"},{"@id":"http://qudt.org/vocab/unit/FemtoM"},{"@id":"http://qudt.org/vocab/unit/GAUGE_FR"},{"@id":"http://qudt.org/vocab/unit/GA_Charriere"},{"@id":"http://qudt.org/vocab/unit/HectoM"},{"@id":"http://qudt.org/vocab/unit/IN"},{"@id":"http://qudt.org/vocab/unit/KiloM"},{"@id":"http://qudt.org/vocab/unit/LY"},{"@id":"http://qudt.org/vocab/unit/M"},{"@id":"http://qudt.org/vocab/unit/MI"},{"@id":"http://qudt.org/vocab/unit/MI_N"},{"@id":"http://qudt.org/vocab/unit/MI_UK"},{"@id":"http://qudt.org/vocab/unit/MI_US"},{"@id":"http://qudt.org/vocab/unit/MicroIN"},{"@id":"http://qudt.org/vocab/unit/MicroM"},{"@id":"http://qudt.org/vocab/unit/MilLength"},{"@id":"http://qudt.org/vocab/unit/MilliIN"},{"@id":"http://qudt.org/vocab/unit/MilliM"},{"@id":"http://qudt.org/vocab/unit/NanoM"},{"@id":"http://qudt.org/vocab/unit/PARSEC"},{"@id":"http://qudt.org/vocab/unit/PCA"},{"@id":"http://qudt.org/vocab/unit/PT"},{"@id":"http://qudt.org/vocab/unit/PicoM"},{"@id":"http://qudt.org/vocab/unit/PlanckLength"},{"@id":"http://qudt.org/vocab/unit/ROD"},{"@id":"http://qudt.org/vocab/unit/YD"},{"@id":"http://qudt.org/vocab/unit/ZOLL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Position_(vector)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Equilibrium Position Vector of Ion\" is the position vector of a particle in equilibrium.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"R_0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q105533477"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Equilibrium Position Vector of Ion","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}]},{"@id":"http://qudt.org/vocab/quantitykind/EquivalenceDoseOutput","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio of equivalence dose within an appropriately small interval to this interval, calculated as the\n    differential quotient: q • D = q • ∂D/∂t as a measure of the current radiation exposure\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MicroSV-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MicroSV-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MicroSV-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MilliSV-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MilliSV-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MilliSV-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/NanoSV-PER-HR"},{"@id":"http://qudt.org/vocab/unit/NanoSV-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/NanoSV-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/SV-PER-HR"},{"@id":"http://qudt.org/vocab/unit/SV-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/SV-PER-SEC"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ450#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-3D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient aus der Äquivalenzdosis in einer angemessenen kleinen Zeitspanne und dieser Zeitspanne,\n    berechenbar als Differentialquotient: q • D = q • ∂D/∂t als Maß für die aktuelle Strahlenbelastung\n  ","@language":"de"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/DoseEquivalentRate"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:DoseEquivalentRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Equivalence Dose Output","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DoseEquivalentRate"}]},{"@id":"http://qudt.org/vocab/quantitykind/EquivalentAbsorptionArea","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In a diffuse sound field, the Equivalent Absorption Area is that area of a surface having an absorption\n    factor equal to 1, which, if diffraction effects are neglected, would, in the same diffuse sound field, absorb the same power.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"m2","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AC"},{"@id":"http://qudt.org/vocab/unit/ARE"},{"@id":"http://qudt.org/vocab/unit/BARN"},{"@id":"http://qudt.org/vocab/unit/CentiM2"},{"@id":"http://qudt.org/vocab/unit/DecaARE"},{"@id":"http://qudt.org/vocab/unit/DeciM2"},{"@id":"http://qudt.org/vocab/unit/FT2"},{"@id":"http://qudt.org/vocab/unit/HA"},{"@id":"http://qudt.org/vocab/unit/IN2"},{"@id":"http://qudt.org/vocab/unit/KiloM2"},{"@id":"http://qudt.org/vocab/unit/KiloMIL_Circ"},{"@id":"http://qudt.org/vocab/unit/M2"},{"@id":"http://qudt.org/vocab/unit/MI2"},{"@id":"http://qudt.org/vocab/unit/MIL_Circ"},{"@id":"http://qudt.org/vocab/unit/MI_US2"},{"@id":"http://qudt.org/vocab/unit/MicroM2"},{"@id":"http://qudt.org/vocab/unit/MilliM2"},{"@id":"http://qudt.org/vocab/unit/NanoM2"},{"@id":"http://qudt.org/vocab/unit/PIXEL_AREA"},{"@id":"http://qudt.org/vocab/unit/PlanckArea"},{"@id":"http://qudt.org/vocab/unit/YD2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://www.acoustic-glossary.co.uk/sound-absorption.htm#:~:text=Equivalent%20Sound%20Absorption%20Area%20(A,reverberation%20time%20in%20a%20room.","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In a diffuse sound field, the Equivalent Absorption Area is that area of a surface having an\n    absorption factor equal to 1, which, if diffraction effects are neglected, would, in the same diffuse sound field, absorb the\n    same power.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Area"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"A","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q87745170"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"belongs to SOQ-ISO","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Area","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Equivalent Absorption Area","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Area"}]},{"@id":"http://qudt.org/vocab/quantitykind/EquivalentConcentration","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Equivalent Concentration\" is the amount of a substance that reacts with (or is equivalent to) an\n    arbitrary amount (typically one mole) of another substance in a given chemical reaction, per volume.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/EQ-PER-L"},{"@id":"http://qudt.org/vocab/unit/Micr