c/terms/description":[{"@value":"1 000-fold of the CGS unit of the magnetic flux density B","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.1","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E-1","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticField"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB136","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB136","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"1 000-fold of the CGS unit of the magnetic flux density B","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/prefix":[{"@id":"http://qudt.org/vocab/prefix/Kilo"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/GAUSS"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"kGs","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"kG","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"78","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticField"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Kilogauss","@language":"en"},{"@value":"Kilogauss","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/KiloGM","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The kilogram or kilogramme (SI symbol: kg), also known as the kilo, is the base unit of mass in the\n    International System of Units and is defined as being equal to the mass of the International Prototype Kilogram (IPK), which\n    is almost exactly equal to the mass of one liter of water. The avoirdupois (or international) pound, used in both the Imperial\n    system and U.S. customary units, is defined as exactly 0.45359237 kg, making one kilogram approximately equal to 2.2046\n    avoirdupois pounds.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Kilogram","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/CO2Equivalent"},{"@id":"http://qudt.org/vocab/quantitykind/Mass"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA594","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA594","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Kilogram?oldid=493633626","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The kilogram or kilogramme (SI symbol: kg), also known as the kilo, is the base unit of mass in the\n    International System of Units and is defined as being equal to the mass of the International Prototype Kilogram (IPK), which\n    is almost exactly equal to the mass of one liter of water. The avoirdupois (or international) pound, used in both the Imperial\n    system and U.S. customary units, is defined as exactly 0.45359237 kg, making one kilogram approximately equal to 2.2046\n    avoirdupois pounds.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/SI/units/kilogram"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"kg","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"kg","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/udunitsCode":[{"@value":"kg","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"KGM","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/CO2Equivalent"},{"@id":"http://qudt.org/vocab/quantitykind/Mass"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q11570"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Chiliogramma","@language":"la"},{"@value":"Chilogrammo","@language":"it"},{"@value":"Kilogram","@language":"cs"},{"@value":"Kilogram","@language":"en"},{"@value":"Kilogram","@language":"ms"