"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Unknown"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Unknown","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unknown","@language":"en"},{"@value":"Unknown","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/UnitPole","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A magnetic pole is a unit pole if it exerts a force of one dyne on another pole of equal strength at a\n    distance of 1 cm. The strength of any given pole in cgs units is therefore numerically equal to the force in dynes which it\n    exerts on a unit pole 1 cm away.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0000001256637","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.256637E-7","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$U/nWb$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFlux"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB214","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB214","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/unitPole"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/WB"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"pole","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"P53","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFlux"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unit Pole","@language":"en"},{"@value":"Unit Pole","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/V","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Volt}$ is the SI unit of electric potential.\n  Separating electric charges creates potential energy, which can be measured in energy units such as joules.\n  Electric potential is defined as the amount of potential energy present per unit of charge.\n  Electric potential is measured in volts, with one volt representing a potential of one joule per coulomb of charge.\n  The name of the unit honors the Italian scientist Count Alessandro Volta (1745-1827), the inventor of the first battery.\n  The volt also may be expressed with a variety of other units.\n  For example, a volt is also equal to one watt per ampere ($W/A$) and one joule per ampere per second ($J/A/s$).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/PLANCK"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Volt","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-5106"},{"@id":"_:n3-5107"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotential"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotentialDifference"},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerElectricCharge"},{"@id":"http://qudt.org/vocab/quantitykind/Voltage"},{"@id":"http://qudt.org/vocab/quantitykind/VoltagePhasor"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA296","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA296","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Volt?oldid=494812083","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\textit{V}\\ \\equiv\\ \\text{volt}\\ \\equiv\\ \\frac{\\text{J}}{\\text{C}}\\ \\equiv\\ \\frac{\\text{joule}}{\\text{coulomb}}\\ \\equiv\\ \\frac{\\text{W.s}}{\\text{C}}\\ \\equiv\\ \\frac{\\text{watt.second}}{\\text{coulomb}}\\ \\equiv\\ \\frac{\\text{W}}{\\text{A}}\\ \\equiv\\ \\frac{\\text{watt}}{\\text{amp}}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/volt"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/SI/units/volt"}],"http://qudt.org/schema/qudt/siUnitsExpression":[{"@value":"W/A","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org