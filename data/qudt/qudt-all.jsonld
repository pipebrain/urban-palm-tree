://purl.org/dc/terms/description":[{"@value":"\"Fundamental Reciprocal Lattice Vector\" are fundamental, or primary, translation vectors of the\n    reciprocal lattice.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PER-ANGSTROM"},{"@id":"http://qudt.org/vocab/unit/PER-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Reciprocal_lattice","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Fundamental Reciprocal Lattice Vector\" are fundamental, or primary, translation vectors of the\n    reciprocal lattice.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/InverseLength"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"b_1, b_2, b_3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q105475399"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:FundamentalReciprocalLatticeVector","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Fundamental Reciprocal Lattice Vector","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/InverseLength"}]},{"@id":"http://qudt.org/vocab/quantitykind/GFactorOfNucleus","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"g-Factor of Nucleus\" is associated with the spin and magnetic moments of protons, neutrons, and many\n    nuclei.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Landé_g-factor","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$g = \\frac{\\mu}{I\\mu_B}$, where $\\mu$ is the magnitude of magnetic dipole moment, $I$ is the nuclear angular momentum quantum number, and $\\mu_B$ is the Bohr magneton.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"g-Factor of Nucleus\" is associated with the spin and magnetic moments of protons, neutrons,\n    and many nuclei.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"g","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q97591250"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:GFactorOfNucleus","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"g-Factor of Nucleus","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/GROSS-LIFT-OFF-WEIGHT","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The sum of a rocket's inert mass and usable fluids and gases at sea level.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Maximum_Takeoff_Weight","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The sum of a rocket's inert mass and usable fluids and gases at sea level.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Gross Lift-Off Weight","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}]},{"@id":"http://qudt.org/vocab/quantitykind/Gain","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A general term used to denote an increase in signal power or signal strength in transmission from one\n    point to another. Gain is usually expressed in decibels and is widely used to denote transducer gain.  An increase or\n    amplification. In radar there are two general usages of the term: (a) antenna gain, or gain factor, is the ratio of the power\n    transmitted along the beam axis to that of an isotropic radiator transmitting the same total power; (b) receiver gain, or\n    video gain, is the amplification given a signal by the receiver.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Gain","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A general term used to denote an increase in signal power or signal strength in transmission from\n    one point to another. Gain is usually expressed in decibels and is widely used to denote transducer gain.  An increase or\n    amplification. In radar there are two general usages of the term: (a) antenna gain, or gain factor, is the ratio of the power\n    transmitted along the beam axis to that of an isotropic radiator transmitting the same total power; (b) receiver gain, or\n    video gain, is the amplification given a signal by the receiver.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Gain","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Gain","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/GapEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Gap Energy\" is the difference in energy between the lowest level of conduction band and the highest\n    level of valence band. It is an energy range in a solid where no electron states can exist.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AttoJ"},{"@id":"http://qudt.org/vocab/unit/BTU_IT"},{"@id":"http://qudt.org/vocab/unit/BTU_TH"},{"@id":"http://qudt.org/vocab/unit/CAL_IT"},{"@id":"http://qudt.org/vocab/unit/CAL_TH"},{"@id":"http://qudt.org/vocab/unit/ERG"},{"@id":"http://qudt.org/vocab/unit/EV"},{"@id":"http://qudt.org/vocab/unit/E_h"},{"@id":"http://qudt.org/vocab/unit/ExaJ"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F_Energy"},{"@id":"http://qudt.org/vocab/unit/FT-PDL"},{"@id":"http://qudt.org/vocab/unit/FemtoJ"},{"@id":"http://qudt.org/vocab/unit/GigaEV"},{"@id":"http://qudt.org/vocab/unit/GigaJ"},{"@id":"http://qudt.org/vocab/unit/GigaW-HR"},{"@id":"http://qudt.org/vocab/unit/J"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH"},{"@id":"http://qudt.org/vocab/unit/KiloCAL"},{"@id":"http://qudt.org/vocab/unit/KiloEV"},{"@id":"http://qudt.org/vocab/unit/KiloJ"},{"@id":"http://qudt.org/vocab/unit/KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT"},{"@id":"http://qudt.org/vocab/unit/MegaEV"},{"@id":"http://qudt.org/vocab/unit/MegaJ"},{"@id":"http://qudt.org/vocab/unit/MegaTOE"},{"@id":"http://qudt.org/vocab/unit/MegaW-HR"},{"@id":"http://qudt.org/vocab/unit/MicroJ"},{"@id":"http://qudt.org/vocab/unit/MilliJ"},{"@id":"http://qudt.org/vocab/unit/NanoJ"},{"@id":"http://qudt.org/vocab/unit/PetaJ"},{"@id":"http://qudt.org/vocab/unit/PicoJ"},{"@id":"http://qudt.org/vocab/unit/PlanckEnergy"},{"@id":"http://qudt.org/vocab/unit/QUAD"},{"@id":"http://qudt.org/vocab/unit/THERM_EC"},{"@id":"http://qudt.org/vocab/unit/THERM_US"},{"@id":"http://qudt.org/vocab/unit/THM_EEC"},{"@id":"http://qudt.org/vocab/unit/THM_US"},{"@id":"http://qudt.org/vocab/unit/TOE"},{"@id":"http://qudt.org/vocab/unit/TeraJ"},{"@id":"http://qudt.org/vocab/unit/TeraW-HR"},{"@id":"http://qudt.org/vocab/unit/TonEnergy"},{"@id":"http://qudt.org/vocab/unit/W-HR"},{"@id":"http://qudt.org/vocab/unit/W-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Band_gap","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Gap Energy\" is the difference in energy between the lowest level of conduction band and the\n    highest level of valence band. It is an energy range in a solid where no electron states can exist.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"E_g","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Energy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Gap Energy","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}]},{"@id":"http://qudt.org/vocab/quantitykind/GasLeakRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio of the pV value of a gas (product of pressure and volume of a given quantity of gas at the\n    respective temperature) flowing through a pipe cross-section during a time interval and the related interval\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/GigaJ-PER-M2"},{"@id":"http://qudt.org/vocab/unit/J-PER-M2"},{"@id":"http://qudt.org/vocab/unit/LANGLEY"},{"@id":"http://qudt.org/vocab/unit/MilliJ-PER-M2"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ324#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD057","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD057","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient aus dem pV-Wert eines Gases (Produkt aus Druck und Volumen einer bestimmten Menge eines\n    Gases bei der jeweils herrschenden Temperatur), das während einer Zeitspanne durch einen Leitungsquerschnitt strömt, und der\n    zugehörigen Zeitspanne\n  ","@language":"de"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyFluence"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EnergyFluence","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Gas Leak Rate","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyFluence"}]},{"@id":"http://qudt.org/vocab/quantitykind/GaugePressure","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Gauge Pressure is the pressure of a system relative to the pressure of the surrounding atmosphere. \nIt is the difference between the absolute pressure and the atmospheric pressure. Gauge pressure is positive for pressures \nabove atmospheric pressure and negative for pressures below it. A Quantity in QUDT having a QuantityKind of GaugePressure\nwould typically also assert the value of qudt:isDeltaQuantity to be true, indicating that the value is a difference between\ntwo pressures.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ATM"},{"@id":"http://qudt.org/vocab/unit/ATM_T"},{"@id":"http://qudt.org/vocab/unit/BAR"},{"@id":"http://qudt.org/vocab/unit/BARAD"},{"@id":"http://qudt.org/vocab/unit/BARYE"},{"@id":"http://qudt.org/vocab/unit/BAR_A"},{"@id":"http://qudt.org/vocab/unit/CentiBAR"},{"@id":"http://qudt.org/vocab/unit/CentiM_H2O"},{"@id":"http://qudt.org/vocab/unit/CentiM_H2O_4DEG_C"},{"@id":"http://qudt.org/vocab/unit/CentiM_HG"},{"@id":"http://qudt.org/vocab/unit/CentiM_HG_0DEG_C"},{"@id":"http://qudt.org/vocab/unit/DYN-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/DecaPA"},{"@id":"http://qudt.org/vocab/unit/DeciBAR"},{"@id":"http://qudt.org/vocab/unit/FT_H2O"},{"@id":"http://qudt.org/vocab/unit/FT_H2O_39dot2DEG_F"},{"@id":"http://qudt.org/vocab/unit/FT_HG"},{"@id":"http://qudt.org/vocab/unit/GM_F-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/GigaPA"},{"@id":"http://qudt.org/vocab/unit/HectoBAR"},{"@id":"http://qudt.org/vocab/unit/HectoPA"},{"@id":"http://qudt.org/vocab/unit/IN_H2O"},{"@id":"http://qudt.org/vocab/unit/IN_H2O_39dot2DEG_F"},{"@id":"http://qudt.org/vocab/unit/IN_H2O_60DEG_F"},{"@id":"http://qudt.org/vocab/unit/IN_HG"},{"@id":"http://qudt.org/vocab/unit/IN_HG_32DEG_F"},{"@id":"http://qudt.org/vocab/unit/IN_HG_60DEG_F"},{"@id":"http://qudt.org/vocab/unit/KIP_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/KiloBAR"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M-SEC2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F-PER-M2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-M2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/KiloPA"},{"@id":"http://qudt.org/vocab/unit/KiloPA_A"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/M_H2O"},{"@id":"http://qudt.org/vocab/unit/MegaBAR"},{"@id":"http://qudt.org/vocab/unit/MegaN-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MegaPA"},{"@id":"http://qudt.org/vocab/unit/MegaPSI"},{"@id":"http://qudt.org/vocab/unit/MicroATM"},{"@id":"http://qudt.org/vocab/unit/MicroBAR"},{"@id":"http://qudt.org/vocab/unit/MicroPA"},{"@id":"http://qudt.org/vocab/unit/MicroTORR"},{"@id":"http://qudt.org/vocab/unit/MilliBAR"},{"@id":"http://qudt.org/vocab/unit/MilliBAR_A"},{"@id":"http://qudt.org/vocab/unit/MilliM_H2O"},{"@id":"http://qudt.org/vocab/unit/MilliM_HG"},{"@id":"http://qudt.org/vocab/unit/MilliM_HGA"},{"@id":"http://qudt.org/vocab/unit/MilliPA"},{"@id":"http://qudt.org/vocab/unit/MilliTORR"},{"@id":"http://qudt.org/vocab/unit/N-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/N-PER-M2"},{"@id":"http://qudt.org/vocab/unit/N-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/PA"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/PSI"},{"@id":"http://qudt.org/vocab/unit/PicoPA"},{"@id":"http://qudt.org/vocab/unit/PlanckPressure"},{"@id":"http://qudt.org/vocab/unit/TORR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Pressure"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ForcePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Gauge Pressure","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Pressure"}]},{"@id":"http://qudt.org/vocab/quantitykind/GeneFamilyAbundance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The abundance of each gene family in the community. Gene families are groups of evolutionarily-related\n    protein-coding sequences that often perform similar functions. Gene family abundance is reported in RPK (reads per kilobase)\n    units to normalize for gene length.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/RPK"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://learn.gencore.bio.nyu.edu/","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The abundance of each gene family in the community. Gene families are groups of\n    evolutionarily-related protein-coding sequences that often perform similar functions. Gene family abundance is reported in RPK\n    (reads per kilobase) units to normalize for gene length.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:GeneFamilyAbundance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Gene Family Abundance","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/GeneralizedCoordinate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Generalized Coordinates refers to the parameters that describe the configuration of the system relative\n    to some reference configuration. These parameters must uniquely define the configuration of the system relative to the\n    reference configuration.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Generalized_coordinates","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$q_i$, where $q_i$ is one of the coordinates that is used to describe the position of the system under consideration, and $N$ is the lowest number of coordinates necessary to fully define the position of the system.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Generalized Coordinates refers to the parameters that describe the configuration of the system\n    relative to some reference configuration. These parameters must uniquely define the configuration of the system relative to\n    the reference configuration.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"q_i","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1057607"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:GeneralizedCoordinate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Generalized Coordinate","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/GeneralizedForce","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Generalized Forces find use in Lagrangian mechanics, where they play a role conjugate to generalized\n    coordinates.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Generalized_forces","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\delta A = \\sum Q_i\\delta q_i$, where $A$ is work and $q_i$ is a generalized coordinate.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Generalized Forces find use in Lagrangian mechanics, where they play a role conjugate to\n    generalized coordinates.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Q_i","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1153787"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:GeneralizedForce","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Generalized Force","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/GeneralizedMomentum","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Generalized Momentum, also known as the canonical or conjugate momentum, extends the concepts of both\n    linear momentum and angular momentum. To distinguish it from generalized momentum, the product of mass and velocity is also\n    referred to as mechanical, kinetic or kinematic momentum.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Momentum","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$p_i = \\frac{\\partial L}{\\partial \\dot{q_i}}$, where $L$ is the Langrange function and $\\dot{q_i}$ is a generalized velocity.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Generalized Momentum, also known as the canonical or conjugate momentum, extends the concepts of\n    both linear momentum and angular momentum. To distinguish it from generalized momentum, the product of mass and velocity is\n    also referred to as mechanical, kinetic or kinematic momentum.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"p_i","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q6806305"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:GeneralizedMomentum","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Generalized Force","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/GeneralizedVelocity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Generalized Velocities are the time derivatives of the generalized coordinates of the system.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Generalized_coordinates","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\dot{q_i} = \\frac{dq_i}{dt}$, where $q_i$ is the generalized coordinate and $t$ is time.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\dot{q_i}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Generalized Velocities are the time derivatives of the generalized coordinates of the system.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q74317892"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:GeneralizedVelocity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Generalized Velocity","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/GibbsEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Internal Energy}$ is one of the potentials are used to measure energy changes in systems as\n    they evolve from an initial state to a final state. The potential used depends on the constraints of the system, such as\n    constant temperature or pressure. $\\textit{Internal Energy}$ is the internal energy of the system, $\\textit{Enthalpy}$ is\n    the internal energy of the system plus the energy related to pressure-volume work, and Helmholtz and Gibbs free energy are the\n    energies available in a system to do useful work when the temperature and volume or the pressure and temperature are fixed,\n    respectively. The name $\\textit{Gibbs Free Energy}$ is also used.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AttoJ"},{"@id":"http://qudt.org/vocab/unit/BTU_IT"},{"@id":"http://qudt.org/vocab/unit/BTU_TH"},{"@id":"http://qudt.org/vocab/unit/CAL_IT"},{"@id":"http://qudt.org/vocab/unit/CAL_TH"},{"@id":"http://qudt.org/vocab/unit/ERG"},{"@id":"http://qudt.org/vocab/unit/EV"},{"@id":"http://qudt.org/vocab/unit/E_h"},{"@id":"http://qudt.org/vocab/unit/ExaJ"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F_Energy"},{"@id":"http://qudt.org/vocab/unit/FT-PDL"},{"@id":"http://qudt.org/vocab/unit/FemtoJ"},{"@id":"http://qudt.org/vocab/unit/GigaEV"},{"@id":"http://qudt.org/vocab/unit/GigaJ"},{"@id":"http://qudt.org/vocab/unit/GigaW-HR"},{"@id":"http://qudt.org/vocab/unit/J"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH"},{"@id":"http://qudt.org/vocab/unit/KiloCAL"},{"@id":"http://qudt.org/vocab/unit/KiloEV"},{"@id":"http://qudt.org/vocab/unit/KiloJ"},{"@id":"http://qudt.org/vocab/unit/KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT"},{"@id":"http://qudt.org/vocab/unit/MegaEV"},{"@id":"http://qudt.org/vocab/unit/MegaJ"},{"@id":"http://qudt.org/vocab/unit/MegaTOE"},{"@id":"http://qudt.org/vocab/unit/MegaW-HR"},{"@id":"http://qudt.org/vocab/unit/MicroJ"},{"@id":"http://qudt.org/vocab/unit/MilliJ"},{"@id":"http://qudt.org/vocab/unit/NanoJ"},{"@id":"http://qudt.org/vocab/unit/PetaJ"},{"@id":"http://qudt.org/vocab/unit/PicoJ"},{"@id":"http://qudt.org/vocab/unit/PlanckEnergy"},{"@id":"http://qudt.org/vocab/unit/QUAD"},{"@id":"http://qudt.org/vocab/unit/THERM_EC"},{"@id":"http://qudt.org/vocab/unit/THERM_US"},{"@id":"http://qudt.org/vocab/unit/THM_EEC"},{"@id":"http://qudt.org/vocab/unit/THM_US"},{"@id":"http://qudt.org/vocab/unit/TOE"},{"@id":"http://qudt.org/vocab/unit/TeraJ"},{"@id":"http://qudt.org/vocab/unit/TeraW-HR"},{"@id":"http://qudt.org/vocab/unit/TonEnergy"},{"@id":"http://qudt.org/vocab/unit/W-HR"},{"@id":"http://qudt.org/vocab/unit/W-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://en.citizendium.org/wiki/Thermodynamics","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$G = H - T \\cdot S$, where $H$ is enthalpy, $T$ is thermodynamic temperature and $S$ is entropy.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Gibbs Energy is one of the potentials used to measure energy changes in systems as they evolve from\n    an initial state to a final state. The potential used depends on the constraints of the system, such as constant temperature\n    or pressure. $\\textit{Internal Energy} is the internal energy of the system, Enthalpy is the internal energy of the system\n    plus the energy related to pressure-volume work, and Helmholtz and Gibbs free energy are the energies available in a system to\n    do useful work when the temperature and volume or the pressure and temperature are fixed, respectively. The name Gibbs Free\n    Energy is also used.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"G","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Energy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Energía de Gibbs","@language":"es"},{"@value":"Entalpie liberă","@language":"ro"},{"@value":"Gibbs Energy","@language":"en"},{"@value":"Gibbs Serbest Enerjisi","@language":"tr"},{"@value":"Gibbsova volná energie","@language":"cs"},{"@value":"Prosta entalpija","@language":"sl"},{"@value":"Tenaga Gibbs","@language":"ms"},{"@value":"energia libera di Gibbs","@language":"it"},{"@value":"energia livre de Gibbs","@language":"pt"},{"@value":"entalpia swobodna","@language":"pl"},{"@value":"enthalpie libre","@language":"fr"},{"@value":"freie Enthalpie","@language":"de"},{"@value":"энергия Гиббса","@language":"ru"},{"@value":"انرژی آزاد گیبس","@language":"fa"},{"@value":"طاقة غيبس الحرة","@language":"ar"},{"@value":"ギブズエネルギー","@language":"ja"},{"@value":"吉布斯自由能","@language":"zh"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"},{"@id":"http://qudt.org/vocab/quantitykind/Enthalpy"},{"@id":"http://qudt.org/vocab/quantitykind/HelmholtzEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/InternalEnergy"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Gibbs function","@language":"en"},{"@value":"Gibbs-Energie","@language":"de"},{"@value":"Gibbs-Funktion","@language":"de"},{"@value":"fungsi Gibbs","@language":"ms"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}]},{"@id":"http://qudt.org/vocab/quantitykind/Gradient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MicroM-PER-M"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD058","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD058","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Gradient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Gradient","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/GrandCanonicalPartitionFunction","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"An \"Grand Canonical Partition Function\" for a grand canonical ensemble, a system that can exchange both\n    heat and particles with the environment, which has a constant temperature and a chemical potential.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Partition_function_(statistical_mechanics)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\Xi = \\sum_{N_A, N_B, ...} Z(N_A, N_B, ...) \\cdot \\lambda_A^{N_A} \\cdot \\lambda_B^{N_B} \\cdot ...$, where $Z(N_A, N_B, ...)$ is the canonical partition function for the given number of particles $A, B, ...,$, and $\\lambda_A, \\lambda_B, ...$ are the absolute activities of particles $A, B, ...$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Xi$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"An \"Grand Canonical Partition Function\" for a grand canonical ensemble, a system that can exchange\n    both heat and particles with the environment, which has a constant temperature and a chemical potential.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/CanonicalPartitionFunction"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q96176022"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CanonicalPartitionFunction","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Grand Canonical Partition Function","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/CanonicalPartitionFunction"}]},{"@id":"http://qudt.org/vocab/quantitykind/GravitationalAttraction","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The force of attraction between all masses in the universe; especially the attraction of the earth's mass\n    for bodies near its surface; the more remote the body the less the gravity; the gravitation between two bodies is proportional\n    to the product of their masses and inversely proportional to the square of the distance between them.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiN"},{"@id":"http://qudt.org/vocab/unit/DYN"},{"@id":"http://qudt.org/vocab/unit/DeciN"},{"@id":"http://qudt.org/vocab/unit/GM_F"},{"@id":"http://qudt.org/vocab/unit/GigaN"},{"@id":"http://qudt.org/vocab/unit/KIP_F"},{"@id":"http://qudt.org/vocab/unit/KiloGM-M-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F"},{"@id":"http://qudt.org/vocab/unit/KiloN"},{"@id":"http://qudt.org/vocab/unit/KiloPOND"},{"@id":"http://qudt.org/vocab/unit/LB_F"},{"@id":"http://qudt.org/vocab/unit/MegaLB_F"},{"@id":"http://qudt.org/vocab/unit/MegaN"},{"@id":"http://qudt.org/vocab/unit/MicroN"},{"@id":"http://qudt.org/vocab/unit/MilliN"},{"@id":"http://qudt.org/vocab/unit/N"},{"@id":"http://qudt.org/vocab/unit/NanoN"},{"@id":"http://qudt.org/vocab/unit/OZ_F"},{"@id":"http://qudt.org/vocab/unit/PDL"},{"@id":"http://qudt.org/vocab/unit/POND"},{"@id":"http://qudt.org/vocab/unit/PlanckForce"},{"@id":"http://qudt.org/vocab/unit/TON_F_US"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.thefreedictionary.com/gravitational+attraction","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The force of attraction between all masses in the universe; especially the attraction of the\n    earth's mass for bodies near its surface; the more remote the body the less the gravity; the gravitation between two bodies is\n    proportional to the product of their masses and inversely proportional to the square of the distance between them.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Force"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"G","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q78337869"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Force","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Gravitational Attraction","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Force"}]},{"@id":"http://qudt.org/vocab/quantitykind/Gravity_API","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The American Petroleum Institute gravity, or API gravity, is a measure of how heavy or light a petroleum\n    liquid is compared to water: if its API gravity is greater than 10, it is lighter and floats on water; if less than 10, it is\n    heavier and sinks.  API gravity is thus an inverse measure of a petroleum liquid's density relative to that of water (also\n    known as specific gravity). It is used to compare densities of petroleum liquids. For example, if one petroleum liquid is less\n    dense than another, it has a greater API gravity. Although API gravity is mathematically a dimensionless quantity (see the\n    formula below), it is referred to as being in 'degrees'. API gravity is graduated in degrees on a hydrometer instrument. API\n    gravity values of most petroleum liquids fall between 10 and 70 degrees.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/APIGravity"}],"http://qudt.org/schema/qudt/baseSIUnitDimensions":[{"@value":"$qkdv:A0E0L0I0M0H0T0D1$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/API_gravity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The American Petroleum Institute gravity, or API gravity, is a measure of how heavy or light a\n    petroleum liquid is compared to water: if its API gravity is greater than 10, it is lighter and floats on water; if less than\n    10, it is heavier and sinks.  API gravity is thus an inverse measure of a petroleum liquid's density relative to that of water\n    (also known as specific gravity). It is used to compare densities of petroleum liquids. For example, if one petroleum liquid\n    is less dense than another, it has a greater API gravity. Although API gravity is mathematically a dimensionless quantity (see\n    the formula below), it is referred to as being in 'degrees'. API gravity is graduated in degrees on a hydrometer instrument.\n    API gravity values of most petroleum liquids fall between 10 and 70 degrees.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M1H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M1H0T0D0"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q29246"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"API Gravity","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/GrossTonnage","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The formula for calculating GT is given by ${ GT=V\\times (0.2+0.02\\times \\log _{10}(V))}$\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/TON_Register"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Gross_tonnage","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"${ GT=V\\times (0.2+0.02\\times \\log _{10}(V))}$ where V is measured in cubic meters.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Gross tonnage (GT, G.T. or gt) is a nonlinear measure of a ship's overall internal volume. Gross\n    tonnage is different from gross register tonnage. Gross tonnage is used to determine things such as a ship's manning\n    regulations, safety rules, registration fees, and port dues, whereas the older gross register tonnage is a measure of the\n    volume of only certain enclosed spaces.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Volume"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"GT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:GrossTonnage","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Gross Tonnage","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Volume"}]},{"@id":"http://qudt.org/vocab/quantitykind/GroupSpeedOfSound","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In a dispersive medium sound speed is a function of sound frequency, through the dispersion relation. The\n    spatial and temporal distribution of a propagating disturbance will continually change. The group speed of sound describes the\n    propagation of the disturbance.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloHZ-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Speed_of_sound","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$c_g = \\frac{d\\omega}{dk}$, where $\\omega$ is the angular frequency and $k$ is angular wavenumber.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In a dispersive medium sound speed is a function of sound frequency, through the dispersion\n    relation. The spatial and temporal distribution of a propagating disturbance will continually change. The group speed of sound\n    describes the propagation of the disturbance.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SpeedOfSound"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"c","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q86508881"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"belongs to SOQ-ISO","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:GroupSpeedOfSound","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Group Speed of Sound","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SpeedOfSound"}]},{"@id":"http://qudt.org/vocab/quantitykind/GrowingDegreeDay","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The sum of excess temperature over 5.5°C, where the temperature is the mean of the minimum and maximum\n    atmospheric temperature in a day. This measure is appropriate for most cereal crops.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_C_GROWING_CEREAL-DAY"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The sum of excess temperature over 5.5°C, where the temperature is the mean of the minimum and\n    maximum atmospheric temperature in a day. This measure is appropriate for most cereal crops.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/TimeTemperature"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:GrowingDegreeDay","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"https://data.agrimetrics.co.uk/ontologies/qudt-extension"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Growing Degree Days (Cereals)","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/TimeTemperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/GrowingDegreeDay_Cereal","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The sum of excess temperature over 5.5°C, where the temperature is the mean of the minimum and maximum\n    atmospheric temperature in a day. This measure is appropriate for most cereal crops.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/GrowingDegreeDay"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The sum of excess temperature over 5.5°C, where the temperature is the mean of the minimum and\n    maximum atmospheric temperature in a day. This measure is appropriate for most cereal crops.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"https://data.agrimetrics.co.uk/ontologies/qudt-extension"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Growing Degree Days (Cereals)","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/TimeTemperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/GruneisenParameter","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Gruneisen Parameter\" named after Eduard Grüneisen, describes the effect that changing the volume of a\n    crystal lattice has on its vibrational properties, and, as a consequence, the effect that changing temperature has on the size\n    or dynamics of the lattice.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Grüneisen_parameter","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\gamma = \\frac{\\alpha_V}{x_T c_V\\rho}$, where $\\alpha_V$ is the cubic expansion coefficient, $x_T$ is isothermal compressibility, $c_V$ is specific heat capacity at constant volume, and $\\rho$ is mass density.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\gamma$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Gruneisen Parameter\" named after Eduard Grüneisen, describes the effect that changing the volume\n    of a crystal lattice has on its vibrational properties, and, as a consequence, the effect that changing temperature has on the\n    size or dynamics of the lattice.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q105658620"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:GruneisenParameter","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Gruneisen Parameter","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/GustatoryThreshold","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Gustatory Threshold\" is the lowest concentration of a substance in solution that can be detected by the\n    sense of taste — the threshold of sensitivity of the human mouth to classes of taste in foods, drinks and other substances.\n    It is expressed as the amount-of-substance (or mass) concentration of the tastant at the detection limit.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/FemtoMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/KiloMOL-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-DeciM3"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MicroMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/MilliMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/MilliMOL-PER-M3"},{"@id":"http://qudt.org/vocab/unit/NanoMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/PicoMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/PicoMOL-PER-M3"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L-3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\overline{T_g}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Gustatory Threshold\" is the lowest concentration of a substance in solution that can be detected by\n    the sense of taste — the threshold of sensitivity of the human mouth to classes of taste in foods, drinks and other\n    substances. It is expressed as the amount-of-substance (or mass) concentration of the tastant at the detection limit.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Concentration"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Concentration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Gustatory Threshold","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Concentration"}]},{"@id":"http://qudt.org/vocab/quantitykind/GyromagneticRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\n  $\\textit{Gyromagnetic Ratio}$, also sometimes known as the magnetogyric ratio in other disciplines,\n   of a particle or system is the ratio of its magnetic dipole moment to its angular momentum,\n  and it is often denoted by the symbol, $\\gamma$. \n  Its SI coherent unit is the radian per second per tesla ($\\mathrm{rad} \\cdot \\mathrm{s}^{-1} \\cdot \\mathrm{T}^{-1}$);\n   because the radian is dimensionless this is equal to the coulomb per kilogram ($\\mathrm{C} \\cdot \\mathrm{kg}^{-1}$).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-HR-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/A-M2-PER-J-SEC"},{"@id":"http://qudt.org/vocab/unit/C-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/HZ-PER-T"},{"@id":"http://qudt.org/vocab/unit/KiloR"},{"@id":"http://qudt.org/vocab/unit/MegaHZ-PER-T"},{"@id":"http://qudt.org/vocab/unit/MilliC-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MilliR"},{"@id":"http://qudt.org/vocab/unit/PER-T-SEC"},{"@id":"http://qudt.org/vocab/unit/R"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Gyromagnetic_ratio","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M-1H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD458","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD458","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Gyromagnetic_ratio","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mu = \\gamma J$, where $\\mu$ is the magnetic dipole moment, and $J$ is the total angular momentum.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\gamma$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerMass"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q634552"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricChargePerMass","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Gyromagnetic Ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerMass"}]},{"@id":"http://qudt.org/vocab/quantitykind/Half-Life","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Half-Life\" is the average duration required for the decay of one half of the atoms or nuclei.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/HalfLife"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{