PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PA-M3-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PFERDESTAERKE"},{"@id":"http://qudt.org/vocab/unit/PSI-IN3-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PSI-L-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PSI-M3-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PSI-YD3-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PetaJ-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PetaW"},{"@id":"http://qudt.org/vocab/unit/PicoJ-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PicoW"},{"@id":"http://qudt.org/vocab/unit/PlanckPower"},{"@id":"http://qudt.org/vocab/unit/THM_US-PER-HR"},{"@id":"http://qudt.org/vocab/unit/TON_FG"},{"@id":"http://qudt.org/vocab/unit/TeraJ-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/TeraW"},{"@id":"http://qudt.org/vocab/unit/TeraW-HR-PER-YR"},{"@id":"http://qudt.org/vocab/unit/W"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Thermal power is the rate at which thermal energy is transferred or converted, expressed as energy\n    per unit time. It characterizes the heating or cooling power output of thermal systems such as heat pumps, boilers, and\n    chillers.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"P_th","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q2419903"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Power","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Thermal Power","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergy"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}]},{"@id":"http://qudt.org/vocab/quantitykind/ThermalResistance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Thermal Resistance}$ is a heat property and a measure of a temperature difference by which an\n    object or material resists a heat flow (heat per time unit or thermal resistance). Thermal resistance is the reciprocal\n    thermal conductance. the thermodynamic temperature difference divided by heat flow rate. Thermal resistance $R$ has the units\n    $\\frac{m^2 \\cdot K}{W}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_F-HR-PER-BTU_IT"},{"@id":"http://qudt.org/vocab/unit/DEG_F-HR-PER-BTU_TH"},{"@id":"http://qudt.org/vocab/unit/DEG_F-SEC-PER-BTU_IT"},{"@id":"http://qudt.org/vocab/unit/DEG_F-SEC-PER-BTU_TH"},{"@id":"http://qudt.org/vocab/unit/K-PER-W"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Thermal_resistance","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ409#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M-1H1T3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD193","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD193","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Thermal_resistance","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"R","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q899628"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ThermalResistance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Thermal Resistance","@language":"en"},{"@value":"opór cieplny","@language":"cs"},{"@value":"resistencia térmica","@language":"es"},{"@value":"resistenza termica","@language":"it"},{"@value":"resistência térmica","@language":"pt"},{"@value":"résistance thermique","@language":"fr"},{"@value":"thermischer Widerstand","@language":"de"},{"@value":"مقاومة حرارية","@language":"ar"},{"@value":"热阻","@language":"zh"},{"@value":"熱抵抗","@language":"ja"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/HeatFlowRate"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalInsulance"},{"@id":"http://qudt.org/vocab/quantitykind/ThermodynamicTemperature"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Wärmewiderstand","@language":"de"}]},{"@id":"http://qudt.org/vocab/quantitykind/ThermalResistivity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The reciprocal of thermal conductivity is thermal resistivity, measured in $kelvin-metres$ per watt ($K\n    \\cdot m/W$).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_F-HR-FT2-PER-BTU_IT-IN"},{"@id":"http://qudt.org/vocab/unit/DEG_F-HR-FT2-PER-BTU_TH-IN"},{"@id":"http://qudt.org/vocab/unit/K-M-PER-W"},{"@id":"http://qudt.org/vocab/unit/M-K-PER-W"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ465#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M-1H1T3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD194","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD194","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q66311516"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ThermalResistivity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Thermal Resistivity","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ThermalTransmittance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Thermal transmittance is the rate of transfer of heat through matter. The thermal transmittance of a\n    material (such as insulation or concrete) or an assembly (such as a wall or window) is expressed as a U-value. The concept of\n    thermal transmittance is closely related to that of thermal resistance. The thermal resistance of a structure is the\n    reciprocal of its thermal transmittance.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-FT2-HR-DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-FT2-SEC-DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-HR-FT2-DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-HR-FT2-DEG_R"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-SEC-FT2-DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-SEC-FT2-DEG_R"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-HR-FT2-DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-SEC-FT2-DEG_F"},{"@id":"http://qudt.org/vocab/unit/CAL_IT-PER-SEC-CentiM2-K"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-SEC-CentiM2-K"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-SEC3-K"},{"@id":"http://qudt.org/vocab/unit/KiloW-PER-M2-K"},{"@id":"http://qudt.org/vocab/unit/W-PER-M2-K"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ405#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H-1T-3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD195","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD195","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Thermal_transmittance","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Thermal transmittance is the rate of transfer of heat through matter. The thermal transmittance of\n    a material (such as insulation or concrete) or an assembly (such as a wall or window) is expressed as a U-value. The concept\n    of thermal transmittance is closely related to that of thermal resistance. The thermal resistance of a structure is the\n    reciprocal of its thermal transmittance.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/CoefficientOfHeatTransfer"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CoefficientOfHeatTransfer","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Thermal Transmittance","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/CoefficientOfHeatTransfer"}]},{"@id":"http://qudt.org/vocab/quantitykind/ThermalUtilizationFactor","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Thermal Utilization Factor\" in an infinite medium, is the ratio of the number of thermal absorbed in\n    a fissionable nuclide or in a nuclear fuel, as specified, to the total number of thermal neutrons absorbed.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Four_factor_formula","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Thermal Utilization Factor\" in an infinite medium, is the ratio of the number of thermal\n    absorbed in a fissionable nuclide or in a nuclear fuel, as specified, to the total number of thermal neutrons absorbed.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"f","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q99197650"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ThermalUtilizationFactor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Thermal Utilization Factor","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ThermalUtilizationFactorForFission","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Probability that a neutron that gets absorbed does so in the fuel material.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Probability that a neutron that gets absorbed does so in the fuel material.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"f","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ThermalUtilizationFactorForFission","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Thermal Utilization Factor for Fission","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}]},{"@id":"http://qudt.org/vocab/quantitykind/ThermodynamicCriticalMagneticFluxDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Thermodynamic Critical Magnetic Flux Density\" is the maximum magnetic field strength below which a\n    material remains superconducting.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/GAMMA"},{"@id":"http://qudt.org/vocab/unit/GAUSS"},{"@id":"http://qudt.org/vocab/unit/KiloGAUSS"},{"@id":"http://qudt.org/vocab/unit/KiloT"},{"@id":"http://qudt.org/vocab/unit/MicroT"},{"@id":"http://qudt.org/vocab/unit/MilliT"},{"@id":"http://qudt.org/vocab/unit/NanoT"},{"@id":"http://qudt.org/vocab/unit/T"},{"@id":"http://qudt.org/vocab/unit/T_Ab"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$G_n - G_s = \\frac{1}{2}\\frac{B_c^2 \\cdot V}{\\mu_0}$, where $G_n$ and $G_s$ are the Gibbs energies at zero magnetic flux density in a normal conductor and superconductor, respectively, $\\mu_0$ is the magnetic constant, and $V$ is volume.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Thermodynamic Critical Magnetic Flux Density\" is the maximum magnetic field strength below which a\n    material remains superconducting.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensity"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"B_c","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q106103200"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MagneticFluxDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Thermodynamic Critical Magnetic Flux Density","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/ThermodynamicEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AttoJ"},{"@id":"http://qudt.org/vocab/unit/BTU_IT"},{"@id":"http://qudt.org/vocab/unit/BTU_TH"},{"@id":"http://qudt.org/vocab/unit/CAL_IT"},{"@id":"http://qudt.org/vocab/unit/CAL_TH"},{"@id":"http://qudt.org/vocab/unit/ERG"},{"@id":"http://qudt.org/vocab/unit/EV"},{"@id":"http://qudt.org/vocab/unit/E_h"},{"@id":"http://qudt.org/vocab/unit/ExaJ"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F_Energy"},{"@id":"http://qudt.org/vocab/unit/FT-PDL"},{"@id":"http://qudt.org/vocab/unit/FemtoJ"},{"@id":"http://qudt.org/vocab/unit/GigaEV"},{"@id":"http://qudt.org/vocab/unit/GigaJ"},{"@id":"http://qudt.org/vocab/unit/GigaW-HR"},{"@id":"http://qudt.org/vocab/unit/J"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH"},{"@id":"http://qudt.org/vocab/unit/KiloCAL"},{"@id":"http://qudt.org/vocab/unit/KiloEV"},{"@id":"http://qudt.org/vocab/unit/KiloJ"},{"@id":"http://qudt.org/vocab/unit/KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT"},{"@id":"http://qudt.org/vocab/unit/MegaEV"},{"@id":"http://qudt.org/vocab/unit/MegaJ"},{"@id":"http://qudt.org/vocab/unit/MegaTOE"},{"@id":"http://qudt.org/vocab/unit/MegaW-HR"},{"@id":"http://qudt.org/vocab/unit/MicroJ"},{"@id":"http://qudt.org/vocab/unit/MilliJ"},{"@id":"http://qudt.org/vocab/unit/NanoJ"},{"@id":"http://qudt.org/vocab/unit/PetaJ"},{"@id":"http://qudt.org/vocab/unit/PicoJ"},{"@id":"http://qudt.org/vocab/unit/PlanckEnergy"},{"@id":"http://qudt.org/vocab/unit/QUAD"},{"@id":"http://qudt.org/vocab/unit/THERM_EC"},{"@id":"http://qudt.org/vocab/unit/THERM_US"},{"@id":"http://qudt.org/vocab/unit/THM_EEC"},{"@id":"http://qudt.org/vocab/unit/THM_US"},{"@id":"http://qudt.org/vocab/unit/TOE"},{"@id":"http://qudt.org/vocab/unit/TeraJ"},{"@id":"http://qudt.org/vocab/unit/TeraW-HR"},{"@id":"http://qudt.org/vocab/unit/TonEnergy"},{"@id":"http://qudt.org/vocab/unit/W-HR"},{"@id":"http://qudt.org/vocab/unit/W-SEC"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/InternalEnergy"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"For a closed thermodynamic system, $\\Delta U = Q + W$, where $Q$ is amount of heat transferred to the system and $W$ is work done on the system provided that no chemical reactions occur.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"U","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Energy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Thermodynamic Energy","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}]},{"@id":"http://qudt.org/vocab/quantitykind/ThermodynamicEntropy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Thermodynamic Entropy is a measure of the unavailability of a system’s energy to do work. It is a measure\n    of the randomness of molecules in a system and is central to the second law of thermodynamics and the fundamental\n    thermodynamic relation, which deal with physical processes and whether they occur spontaneously. The dimensions of entropy are\n    energy divided by temperature, which is the same as the dimensions of Boltzmann's constant ($kB$) and heat capacity. The SI\n    unit of entropy is $joule\\ per\\ kelvin$. [Wikipedia]\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H-1T-2D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerTemperature"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EnergyPerTemperature","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Thermodynamic Entropy","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerTemperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/ThermodynamicTemperature","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Thermodynamic temperature is the absolute measure of temperature and is one of the principal parameters\n    of thermodynamics. Temperature is a physical property of matter that quantitatively expresses the common notions of hot and\n    cold. In thermodynamics, in a system of which the entropy is considered as an independent externally controlled variable,\n    absolute, or thermodynamic temperature is defined as the derivative of the internal energy with respect to the entropy. This\n    is a base quantity in the International System of Quantities, ISQ, on which the International System of Units, SI, is based.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_R"},{"@id":"http://qudt.org/vocab/unit/DecaK"},{"@id":"http://qudt.org/vocab/unit/K"},{"@id":"http://qudt.org/vocab/unit/MegaK"},{"@id":"http://qudt.org/vocab/unit/MilliK"},{"@id":"http://qudt.org/vocab/unit/PlanckTemperature"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/page/Thermodynamic_temperature","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ275#002","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD196","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD196","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Theta$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Thermodynamic temperature is the absolute measure of temperature and is one of the principal\n    parameters of thermodynamics. Temperature is a physical property of matter that quantitatively expresses the common notions of\n    hot and cold. In thermodynamics, in a system of which the entropy is considered as an independent externally controlled\n    variable, absolute, or thermodynamic temperature is defined as the derivative of the internal energy with respect to the\n    entropy. This is a base quantity in the International System of Quantities, ISQ, on which the International System of Units,\n    SI, is based.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/TEMT"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"T","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q264647"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ThermodynamicTemperature","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Suhu termodinamik","@language":"ms"},{"@value":"Termodynamická teplota","@language":"cs"},{"@value":"Thermodynamic Temperature","@language":"en"},{"@value":"abszolút hőmérséklet","@language":"hu"},{"@value":"temperatura termodinamica","@language":"it"},{"@value":"temperatura thermodynamica absoluta","@language":"la"},{"@value":"temperatura","@language":"es"},{"@value":"temperatura","@language":"pl"},{"@value":"temperatura","@language":"pt"},{"@value":"temperatura","@language":"sl"},{"@value":"temperatură termodinamică","@language":"ro"},{"@value":"température thermodynamique","@language":"fr"},{"@value":"termodinamik sıcaklık","@language":"tr"},{"@value":"thermodynamische Temperatur","@language":"de"},{"@value":"Απόλυτη","@language":"el"},{"@value":"Термодинамическая температура","@language":"ru"},{"@value":"Термодинамична температура","@language":"bg"},{"@value":"טמפרטורה מוחלטת","@language":"he"},{"@value":"درجة الحرارة المطلقة","@language":"ar"},{"@value":"دمای ترمودینامیکی","@language":"fa"},{"@value":"ऊष्मगतिकीय तापमान","@language":"hi"},{"@value":"热力学温度","@language":"zh"},{"@value":"熱力学温度","@language":"ja"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"temperatura assoluta","@language":"it"},{"@value":"Θερμοδυναμική Θερμοκρασία","@language":"el"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/Thickness","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Thickness\" is the the smallest of three dimensions: length, width, thickness.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ANGSTROM"},{"@id":"http://qudt.org/vocab/unit/AU"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB_F"},{"@id":"http://qudt.org/vocab/unit/CHAIN"},{"@id":"http://qudt.org/vocab/unit/CHAIN_US"},{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/DecaM"},{"@id":"http://qudt.org/vocab/unit/DeciM"},{"@id":"http://qudt.org/vocab/unit/FATH"},{"@id":"http://qudt.org/vocab/unit/FM"},{"@id":"http://qudt.org/vocab/unit/FT"},{"@id":"http://qudt.org/vocab/unit/FT_US"},{"@id":"http://qudt.org/vocab/unit/FUR"},{"@id":"http://qudt.org/vocab/unit/FemtoM"},{"@id":"http://qudt.org/vocab/unit/GAUGE_FR"},{"@id":"http://qudt.org/vocab/unit/GA_Charriere"},{"@id":"http://qudt.org/vocab/unit/HectoM"},{"@id":"http://qudt.org/vocab/unit/IN"},{"@id":"http://qudt.org/vocab/unit/KiloM"},{"@id":"http://qudt.org/vocab/unit/LY"},{"@id":"http://qudt.org/vocab/unit/M"},{"@id":"http://qudt.org/vocab/unit/MI"},{"@id":"http://qudt.org/vocab/unit/MI_N"},{"@id":"http://qudt.org/vocab/unit/MI_UK"},{"@id":"http://qudt.org/vocab/unit/MI_US"},{"@id":"http://qudt.org/vocab/unit/MicroIN"},{"@id":"http://qudt.org/vocab/unit/MicroM"},{"@id":"http://qudt.org/vocab/unit/MilLength"},{"@id":"http://qudt.org/vocab/unit/MilliIN"},{"@id":"http://qudt.org/vocab/unit/MilliM"},{"@id":"http://qudt.org/vocab/unit/NanoM"},{"@id":"http://qudt.org/vocab/unit/PARSEC"},{"@id":"http://qudt.org/vocab/unit/PCA"},{"@id":"http://qudt.org/vocab/unit/PT"},{"@id":"http://qudt.org/vocab/unit/PicoM"},{"@id":"http://qudt.org/vocab/unit/PlanckLength"},{"@id":"http://qudt.org/vocab/unit/ROD"},{"@id":"http://qudt.org/vocab/unit/YD"},{"@id":"http://qudt.org/vocab/unit/ZOLL"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Thickness","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.merriam-webster.com/dictionary/thickness","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Thickness\" is the the smallest of three dimensions: length, width, thickness.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"d","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q3589038"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Thickness","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}]},{"@id":"http://qudt.org/vocab/quantitykind/ThomsonCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Thomson Coefficient\" represents Thomson heat power developed, divided by the electric current and the\n    temperature difference.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/V-PER-K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H-1T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.daviddarling.info/encyclopedia/T/Thomson_effect.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mu$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Thomson Coefficient\" represents Thomson heat power developed, divided by the electric current and\n    the temperature difference.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q105801233"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ThomsonCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Thomson Coefficient","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Thrust","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Thrust is a reaction force described quantitatively by Newton's Second and Third Laws. When a system\n    expels or accelerates mass in one direction the accelerated mass will cause a proportional but opposite force on that system.\n    The pushing or pulling force developed by an aircraft engine or a rocket engine. The force exerted in any direction by a fluid\n    jet or by a powered screw, as, the thrust of an antitorque rotor. Specifically, in rocketry, $ F\\,= m\\cdot v$ where m is\n    propellant mass flow and v is exhaust velocity relative to the vehicle. Also called momentum thrust.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiN"},{"@id":"http://qudt.org/vocab/unit/DYN"},{"@id":"http://qudt.org/vocab/unit/DeciN"},{"@id":"http://qudt.org/vocab/unit/GM_F"},{"@id":"http://qudt.org/vocab/unit/GigaN"},{"@id":"http://qudt.org/vocab/unit/KIP_F"},{"@id":"http://qudt.org/vocab/unit/KiloGM-M-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F"},{"@id":"http://qudt.org/vocab/unit/KiloN"},{"@id":"http://qudt.org/vocab/unit/KiloPOND"},{"@id":"http://qudt.org/vocab/unit/LB_F"},{"@id":"http://qudt.org/vocab/unit/MegaLB_F"},{"@id":"http://qudt.org/vocab/unit/MegaN"},{"@id":"http://qudt.org/vocab/unit/MicroN"},{"@id":"http://qudt.org/vocab/unit/MilliN"},{"@id":"http://qudt.org/vocab/unit/N"},{"@id":"http://qudt.org/vocab/unit/NanoN"},{"@id":"http://qudt.org/vocab/unit/OZ_F"},{"@id":"http://qudt.org/vocab/unit/PDL"},{"@id":"http://qudt.org/vocab/unit/POND"},{"@id":"http://qudt.org/vocab/unit/PlanckForce"},{"@id":"http://qudt.org/vocab/unit/TON_F_US"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Thrust","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Thrust is a reaction force described quantitatively by Newton's Second and Third Laws. When a\n    system expels or accelerates mass in one direction the accelerated mass will cause a proportional but opposite force on that\n    system.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Force"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q533668"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Force","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Thrust","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Force"}]},{"@id":"http://qudt.org/vocab/quantitykind/ThrustCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The thrust force of a jet-propulsion engine per unit of frontal area per unit of incompressible dynamic\n    pressure\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Thrust_coefficient","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The thrust force of a jet-propulsion engine per unit of frontal area per unit of incompressible\n    dynamic pressure\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"C_{F}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q102040931"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ThrustCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Thrust Coefficient","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/ThrustToMassRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/LB_F-PER-LB"},{"@id":"http://qudt.org/vocab/unit/N-PER-KiloGM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Acceleration"},{"@id":"http://qudt.org/vocab/quantitykind/LinearAcceleration"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ThrustToMassRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Thrust to Mass Ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Acceleration"},{"@id":"http://qudt.org/vocab/quantitykind/LinearAcceleration"}]},{"@id":"http://qudt.org/vocab/quantitykind/ThrustToWeightRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Thrust-to-weight ratio is a ratio of thrust to weight of a rocket, jet engine, propeller engine, or a\n    vehicle propelled by such an engine. It is a dimensionless quantity and is an indicator of the performance of the engine or\n    vehicle.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\psi$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Thrust-to-weight ratio is a ratio of thrust to weight of a rocket, jet engine, propeller engine, or\n    a vehicle propelled by such an engine. It is a dimensionless quantity and is an indicator of the performance of the engine or\n    vehicle.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ThrustToWeightRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Thrust to Weight Ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/Tilt","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The angle between an object's orientation vector relative to a reference frame.  \n  In the context of architecture, this would refer to the angle between the ground and the face of a surface.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ARCMIN"},{"@id":"http://qudt.org/vocab/unit/ARCSEC"},{"@id":"http://qudt.org/vocab/unit/DEG"},{"@id":"http://qudt.org/vocab/unit/GON"},{"@id":"http://qudt.org/vocab/unit/GRAD"},{"@id":"http://qudt.org/vocab/unit/MIL_Angle"},{"@id":"http://qudt.org/vocab/unit/MIN_Angle"},{"@id":"http://qudt.org/vocab/unit/MicroRAD"},{"@id":"http://qudt.org/vocab/unit/MilliARCSEC"},{"@id":"http://qudt.org/vocab/unit/MilliRAD"},{"@id":"http://qudt.org/vocab/unit/RAD"},{"@id":"http://qudt.org/vocab/unit/REV"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The angle between an object's orientation vector relative to a reference frame.  \n  In the context of architecture, this would refer to the angle between the ground and the face of a surface.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Angle","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:PlaneAngle","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Tilt","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}]},{"@id":"http://qudt.org/vocab/quantitykind/Time","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Time is a basic component of the measuring system used to sequence events, to compare the durations of\n    events and the intervals between them, and to quantify the motions of objects.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AttoSEC"},{"@id":"http://qudt.org/vocab/unit/DAY"},{"@id":"http://qudt.org/vocab/unit/DAY_Sidereal"},{"@id":"http://qudt.org/vocab/unit/DeciSEC"},{"@id":"http://qudt.org/vocab/unit/FemtoSEC"},{"@id":"http://qudt.org/vocab/unit/HR"},{"@id":"http://qudt.org/vocab/unit/HR_Sidereal"},{"@id":"http://qudt.org/vocab/unit/KiloSEC"},{"@id":"http://qudt.org/vocab/unit/KiloYR"},{"@id":"http://qudt.org/vocab/unit/MIN"},{"@id":"http://qudt.org/vocab/unit/MIN_Sidereal"},{"@id":"http://qudt.org/vocab/unit/MO"},{"@id":"http://qudt.org/vocab/unit/MO_MeanGREGORIAN"},{"@id":"http://qudt.org/vocab/unit/MO_MeanJulian"},{"@id":"http://qudt.org/vocab/unit/MO_Synodic"},{"@id":"http://qudt.org/vocab/unit/MegaSEC"},{"@id":"http://qudt.org/vocab/unit/MegaYR"},{"@id":"http://qudt.org/vocab/unit/MicroSEC"},{"@id":"http://qudt.org/vocab/unit/MilliSEC"},{"@id":"http://qudt.org/vocab/unit/NanoSEC"},{"@id":"http://qudt.org/vocab/unit/PicoSEC"},{"@id":"http://qudt.org/vocab/unit/PlanckTime"},{"@id":"http://qudt.org/vocab/unit/SEC"},{"@id":"http://qudt.org/vocab/unit/SH"},{"@id":"http://qudt.org/vocab/unit/WK"},{"@id":"http://qudt.org/vocab/unit/YR"},{"@id":"http://qudt.org/vocab/unit/YR_Common"},{"@id":"http://qudt.org/vocab/unit/YR_Metrology"},{"@id":"http://qudt.org/vocab/unit/YR_Sidereal"},{"@id":"http://qudt.org/vocab/unit/YR_TROPICAL"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Time","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ217#006","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD197","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD197","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Time is a basic component of the measuring system used to sequence events, to compare the durations\n    of events and the intervals between them, and to quantify the motions of objects.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/TIME"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"t","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q2199864"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Time","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Masa","@language":"ms"},{"@value":"Time","@language":"en"},{"@value":"Zeit","@language":"de"},{"@value":"czas","@language":"pl"},{"@value":"idő","@language":"hu"},{"@value":"tempo","@language":"it"},{"@value":"tempo","@language":"pt"},{"@value":"temps","@language":"fr"},{"@value":"tempus","@language":"la"},{"@value":"tiempo","@language":"es"},{"@value":"timp","@language":"ro"},{"@value":"zaman","@language":"tr"},{"@value":"Čas","@language":"cs"},{"@value":"čas","@language":"sl"},{"@value":"Χρόνος","@language":"el"},{"@value":"Време","@language":"bg"},{"@value":"Время","@language":"ru"},{"@value":"זמן","@language":"he"},{"@value":"زمان","@language":"fa"},{"@value":"زمن","@language":"ar"},{"@value":"समय","@language":"hi"},{"@value":"时间","@language":"zh"},{"@value":"時間","@language":"ja"}]},{"@id":"http://qudt.org/vocab/quantitykind/TimeAveragedSoundIntensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Sound intensity or acoustic intensity ($I$) is defined as the sound power $P_a$ per unit area $A$. The\n    usual context is the noise measurement of sound intensity in the air at a listener's location as a sound energy quantity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"w/m2","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-FT2-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-FT2-SEC"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-HR-FT2"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-IN2-SEC"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-SEC-FT2"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-FT2-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-FT2-MIN"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-FT2-SEC"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-CentiM2-MIN"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-CentiM2-SEC"},{"@id":"http://qudt.org/vocab/unit/ERG-PER-CentiM2-SEC"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F-PER-FT2-SEC"},{"@id":"http://qudt.org/vocab/unit/J-PER-CentiM2-DAY"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-CentiM2-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-CentiM2-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/M-PA-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MicroW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MilliW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/NanoW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/PicoW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/W-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/W-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/W-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/W-PER-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Sound_intensity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$I = \\frac{1}{t2 - t1} \\int_{t1}^{t2}i(t)dt$, where $t1$ and $t2$ are the starting and ending times for the integral and $i$ is sound intensity.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Sound intensity or acoustic intensity ($I$) is defined as the sound power $P_a$ per unit area $A$.\n    The usual context is the noise measurement of sound intensity in the air at a listener's location as a sound energy quantity.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SoundIntensity"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"I","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q86827342"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"belongs to SOQ-ISO","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:PowerPerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Time Averaged Sound Intensity","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SoundIntensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/TimeConstant_Inductance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/InductanceBasedTimeConstant"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD198","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD198","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"time constant (inductance based)","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/quantitykind/TimePerCount","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DAY-PER-NUM"},{"@id":"http://qudt.org/vocab/unit/HR-PER-NUM"},{"@id":"http://qudt.org/vocab/unit/MIN-PER-NUM"},{"@id":"http://qudt.org/vocab/unit/MO-PER-NUM"},{"@id":"http://qudt.org/vocab/unit/SEC-PER-NUM"},{"@id":"http://qudt.org/vocab/unit/WK-PER-NUM"},{"@id":"http://qudt.org/vocab/unit/YR-PER-NUM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Time passed between N occurrences of a recurring phenomenon.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TimePerCount","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Time per Count","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/TimeRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DAY-PER-YR"},{"@id":"http://qudt.org/vocab/unit/HR-PER-YR"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TimeRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Time Ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/TimeRelatedLogERatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The natural (base-e) logarithm of the ratio of the value of a given quantity to the value of a reference\n    quantity of the same type, divided by the related time. Its corresponding unit is the neper per second.\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/NP-PER-SEC"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ415#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TimeRelatedLogERatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Time-related Logarithmic Ratio to Base e","@language":"en-us"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/LogERatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/TimeRelatedLogarithmicRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"logarithm of the ratio of the value of a defined variable to the value of a reference variable of the\n    same type, divided by the related time\n  ","@language":"en"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/TimeRelatedLogERatio"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.5.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ415#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Logarithmus des Verhältnisses des Werts einer gegebenen Größe zum Wert einer Bezugsgröße gleicher\n    Art dividiert durch die zugehörige Zeit\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Time-related Logarithmic Ratio","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/TimeTemperature","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_C-DAY"},{"@id":"http://qudt.org/vocab/unit/DEG_C-HR"},{"@id":"http://qudt.org/vocab/unit/DEG_C-WK"},{"@id":"http://qudt.org/vocab/unit/DEG_F-DAY"},{"@id":"http://qudt.org/vocab/unit/DEG_F-HR"},{"@id":"http://qudt.org/vocab/unit/K-DAY"},{"@id":"http://qudt.org/vocab/unit/K-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T1D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TimeTemperature","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Time Temperature","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Time_Squared","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/SquareTime"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Time_Squared","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T2D0"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Time Squared","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Torque","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In physics, a torque ($\\tau$) is a vector that measures the tendency of a force to rotate an object\n    about some axis. The magnitude of a torque is defined as force times its lever arm. Just as a force is a push or a pull, a\n    torque can be thought of as a twist. The SI unit for torque is newton meters ($N m$). In U.S. customary units, it is measured\n    in foot pounds (ft lbf) (also known as \"pounds feet\"). Mathematically, the torque on a particle (which has the position r in\n    some reference frame) can be defined as the cross product: $τ = r x F$ where, r is the particle's position vector relative to\n    the fulcrum F is the force acting on the particles, or, more generally, torque can be defined as the rate of change of angular\n    momentum: $τ = dL/dt$ where, L is the angular momentum vector t stands for time.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiN-M"},{"@id":"http://qudt.org/vocab/unit/DYN-CentiM"},{"@id":"http://qudt.org/vocab/unit/DYN-M"},{"@id":"http://qudt.org/vocab/unit/DeciN-M"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F_Torque"},{"@id":"http://qudt.org/vocab/unit/IN-PDL"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F-M"},{"@id":"http://qudt.org/vocab/unit/KiloN-M"},{"@id":"http://qudt.org/vocab/unit/LB_F-IN"},{"@id":"http://qudt.org/vocab/unit/MegaN-M"},{"@id":"http://qudt.org/vocab/unit/MicroN-M"},{"@id":"http://qudt.org/vocab/unit/MilliN-M"},{"@id":"http://qudt.org/vocab/unit/N-CentiM"},{"@id":"http://qudt.org/vocab/unit/N-M"},{"@id":"http://qudt.org/vocab/unit/OZ_F-IN"},{"@id":"http://qudt.org/vocab/unit/PDL-FT"},{"@id":"http://qudt.org/vocab/unit/PDL-IN"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Torque","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ233#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/MomentOfForce"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD200","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD200","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Torque","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\tau = M \\cdot e_Q$, where $M$ is the momentof force and $e_Q$ is a unit vector directed along a $Q-axis$ with respect to which the torque is considered.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\tau$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q48103"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Torque","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Torque","@language":"en"},{"@value":"Torsionmoment","@language":"de"},{"@value":"coppia","@language":"it"},{"@value":"couple","@language":"fr"},{"@value":"moment obrotowy","@language":"pl"},{"@value":"momento de torção","@language":"pt"},{"@value":"par","@language":"es"},{"@value":"عزم محورى","@language":"ar"},{"@value":"トルク","@language":"ja"},{"@value":"转矩","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Drillmoment","@language":"de"},{"@value":"binârio","@language":"pt"},{"@value":"moment de torsion","@language":"fr"},{"@value":"momento de torsión","@language":"es"},{"@value":"momento torcente","@language":"it"}]},{"@id":"http://qudt.org/vocab/quantitykind/TorqueConstant","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"product of magnetic induction, number of turns per unit length, and the area enclosed by the coil\n    corresponding to the gradient of the curve representing the ratio between the torque of the motor and the current\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/N-M-PER-A"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ298#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD201","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD201","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Produkt aus der magnetischen Induktion, der Windungszahl und der von der Spule eingeschlossenen\n    Fläche entsprechend der Steigung der Kurve des Verhältnisses Drehmoment des Motors zum Strom\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TorqueConstant","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Torque Constant","@language":"en-us"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ForceConstant"},{"@id":"http://qudt.org/vocab/quantitykind/MotorConstant"}]},{"@id":"http://qudt.org/vocab/quantitykind/TorquePerAngle","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/N-M-PER-ARCMIN"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-DEG"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-MIN_Angle"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-RAD"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TorquePerAngle","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Torque per Angle","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/TorquePerLength","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloN-M-PER-M"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-M"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/LineicTorque"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TorquePerLength","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Torque per Length","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/TorsionalRigidity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/N-M-PER-ARCMIN"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-DEG"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-MIN_Angle"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-RAD"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/RotationalStiffness"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD202","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD202","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/TorquePerAngle"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TorquePerAngle","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Torsional Rigidity","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/TorquePerAngle"}]},{"@id":"http://qudt.org/vocab/quantitykind/TorsionalSpringConstant","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio between the turning moment for elastic deformation of a torsion spring and the related angle of\n    rotation\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloN-M-PER-DEG"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-ARCMIN"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-DEG"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-MIN_Angle"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-RAD"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ448#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Torsion_spring","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A torsional spring constant is a measure of the stiffness of a torsional spring, which is a type of\n    spring that experiences twisting or torque rather than compression or extension. It is typically measured in newton-meters per\n    radian (N·m/rad) and is used to calculate the amount of torque required to twist a spring a certain amount. It is related to\n    the spring's geometry, material properties, and manufacturing process.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Quotient Drehmoment zur elastischen Verformung einer Drehfeder durch den zugehörigen Drehwinkel","@language":"de"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/TorquePerAngle"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TorsionalSpringConstant","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Federkonstante Drehfeder","@language":"de"},{"@value":"Torsional Spring Constant","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/TorquePerAngle"}]},{"@id":"http://qudt.org/vocab/quantitykind/TotalAngularMomentum","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Total Angular Momentum\" combines both the spin and orbital angular momentum of all particles and fields.\n    In atomic and nuclear physics, orbital angular momentum is usually denoted by $l$ or $L$ instead of $\\Lambda$. The magnitude\n    of $J$ is quantized so that $J^2 = \\hbar^2 j(j + 1)$, where $j$ is the total angular momentum quantum number.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ERG-SEC"},{"@id":"http://qudt.org/vocab/unit/EV-SEC"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloGM-M2-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/N-M-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Angular_momentum#Spin.2C_orbital.2C_and_total_angular_momentum","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/AngularImpulse"},{"@id":"http://qudt.org/vocab/quantitykind/AngularMomentum"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q97496506"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AngularImpulse","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:AngularMomentum","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Total Angular Momentum","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AngularImpulse"},{"@id":"http://qudt.org/vocab/quantitykind/AngularMomentum"}]},{"@id":"http://qudt.org/vocab/quantitykind/TotalAngularMomentumQuantumNumber","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Total Angular Quantum Number\" describes the magnitude of total angular momentum $J$, where $j$\n    refers to a specific particle and $J$ is used for the whole system.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Quantum_number","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/QuantumNumber"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"j","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1141095"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TotalAngularMomentumQuantumNumber","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Total Angular Momentum Quantum Number","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/QuantumNumber"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticQuantumNumber"},{"@id":"http://qudt.org/vocab/quantitykind/PrincipalQuantumNumber"},{"@id":"http://qudt.org/vocab/quantitykind/SpinQuantumNumber"}]},{"@id":"http://qudt.org/vocab/quantitykind/TotalAtomicStoppingPower","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Total Atomic Stopping Power\" for an ionizing particle passing through an element, is the particle's\n    energy loss per atom within a unit area normal to the particle's path; equal to the linear energy transfer (energy loss per\n    unit path length) divided by the number of atoms per unit volume.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/EV-M2"},{"@id":"http://qudt.org/vocab/unit/J-M2"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/AtomicStoppingPower"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L4I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.answers.com/topic/atomic-stopping-power","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$S_a = \\frac{S}{n}$, where $S$ is the total linear stopping power and $n$ is the number density of the atoms in the substance.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Total Atomic Stopping Power\" for an ionizing particle passing through an element, is the\n    particle's energy loss per atom within a unit area normal to the particle's path; equal to the linear energy transfer (energy\n    loss per unit path length) divided by the number of atoms per unit volume.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"S_a","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q112725871"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TotalAtomicStoppingPower","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Total Atomic Stopping Power","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/TotalCrossSection","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Total Cross-section\" is related to the absorbance of the light intensity through Beer-Lambert's law. It\n    is the sum of all cross-sections corresponding to the various reactions or processes between an incident particle of specified\n    type and energy and a target particle.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AC"},{"@id":"http://qudt.org/vocab/unit/ARE"},{"@id":"http://qudt.org/vocab/unit/BARN"},{"@id":"http://qudt.org/vocab/unit/CentiM2"},{"@id":"http://qudt.org/vocab/unit/DecaARE"},{"@id":"http://qudt.org/vocab/unit/DeciM2"},{"@id":"http://qudt.org/vocab/unit/FT2"},{"@id":"http://qudt.org/vocab/unit/HA"},{"@id":"http://qudt.org/vocab/unit/IN2"},{"@id":"http://qudt.org/vocab/unit/KiloM2"},{"@id":"http://qudt.org/vocab/unit/KiloMIL_Circ"},{"@id":"http://qudt.org/vocab/unit/M2"},{"@id":"http://qudt.org/vocab/unit/MI2"},{"@id":"http://qudt.org/vocab/unit/MIL_Circ"},{"@id":"http://qudt.org/vocab/unit/MI_US2"},{"@id":"http://qudt.org/vocab/unit/MicroM2"},{"@id":"http://qudt.org/vocab/unit/MilliM2"},{"@id":"http://qudt.org/vocab/unit/NanoM2"},{"@id":"http://qudt.org/vocab/unit/PIXEL_AREA"},{"@id":"http://qudt.org/vocab/unit/PlanckArea"},{"@id":"http://qudt.org/vocab/unit/YD2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Cross_section_(physics)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Total Cross-section\" is related to the absorbance of the light intensity through Beer-Lambert's\n    law. It is the sum of all cross-sections corresponding to the various reactions or processes between an incident particle of\n    specified type and energy and a target particle.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/CrossSection"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"σₜ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98206553"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Area","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Total Cross-section","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/CrossSection"}]},{"@id":"http://qudt.org/vocab/quantitykind/TotalCurrent","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Total Current\" is the sum of the electric current that is flowing through a surface and the displacement\n    current.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/altSymbol":[{"@value":"I_t","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A"},{"@id":"http://qudt.org/vocab/unit/A_Ab"},{"@id":"http://qudt.org/vocab/unit/A_Stat"},{"@id":"http://qudt.org/vocab/unit/AttoA"},{"@id":"http://qudt.org/vocab/unit/BIOT"},{"@id":"http://qudt.org/vocab/unit/FemtoA"},{"@id":"http://qudt.org/vocab/unit/GigaA"},{"@id":"http://qudt.org/vocab/unit/KiloA"},{"@id":"http://qudt.org/vocab/unit/MegaA"},{"@id":"http://qudt.org/vocab/unit/MicroA"},{"@id":"http://qudt.org/vocab/unit/MilliA"},{"@id":"http://qudt.org/vocab/unit/NanoA"},{"@id":"http://qudt.org/vocab/unit/PetaA"},{"@id":"http://qudt.org/vocab/unit/PicoA"},{"@id":"http://qudt.org/vocab/unit/PlanckCurrent"},{"@id":"http://qudt.org/vocab/unit/TeraA"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$I_{tot}= I + I_D$, where $I$ is electric current and $I_D$ is displacement current.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Total Current\" is the sum of the electric current that is flowing through a surface and the\n    displacement current.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrent"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"I_{tot}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q77679732"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricCurrent","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Total Current","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/DisplacementCurrent"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrent"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrent"}]},{"@id":"http://qudt.org/vocab/quantitykind/TotalCurrentDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Total Current Density\" is the sum of the electric current density and the displacement current density.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-PER-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$J_{tot}= J + J_D$, where $J$ is electric current density and $J_D$ is displacement current density.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$J_{tot}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Total Current Density\" is the sum of the electric current density and the displacement current\n    density.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q77680811"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TotalCurrentDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Total Current Density","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/DisplacementCurrentDensity"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/TotalIonization","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Total Ionization\" by a particle, total mean charge, divided by the elementary charge, $e$, of all\n    positive ions produced by an ionizing charged particle along its entire path and along the paths of any secondary charged\n    particles.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Ionization#Classical_ionization","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$N = \\int N_i dl$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"N_i","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98690787"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TotalIonization","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Total Ionization","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/TotalLinearStoppingPower","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Total Linear Stopping Power\" is defined as the average energy loss of the particle per unit path\n    length.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ERG-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/EV-PER-ANGSTROM"},{"@id":"http://qudt.org/vocab/unit/EV-PER-M"},{"@id":"http://qudt.org/vocab/unit/J-PER-M"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ337#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD203","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD203","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Stopping_power_(particle_radiation)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$S = -\\frac{dE}{dx}$, where $-dE$ is the energy decrement in the $x-direction$ along an elementary path with the length $dx$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Total Linear Stopping Power\" is defined as the average energy loss of the particle per unit\n    path length.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"S","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q908474"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TotalLinearStoppingPower","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Total Linear Stopping Power","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/TotalMassStoppingPower","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"If a substance is compared in gaseous and solid form, then the linear stopping powers of the two states\n    are very different just because of the different density. One therefore often divides S(E) by the density of the material to\n    obtain the \"Mass Stopping Power\". The mass stopping power then depends only very little on the density of the material.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ERG-CentiM2-PER-GM"},{"@id":"http://qudt.org/vocab/unit/EV-M2-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/J-M2-PER-KiloGM"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ348#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L4I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD204","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD204","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Stopping_power_(particle_radiation)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$S_m = \\frac{S}{\\rho}$, where $S$ is the total linear stopping power and $\\rho$ is the mass density of the sample.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"If a substance is compared in gaseous and solid form, then the linear stopping powers of the two\n    states are very different just because of the different density. One therefore often divides S(E) by the density of the\n    material to obtain the \"Mass Stopping Power\". The mass stopping power then depends only very little on the density of the\n    material.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"S_m","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98642795"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TotalMassStoppingPower","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Total Mass Stopping Power","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/TotalPressure","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The total pressure is the sum of the dynamic and static pressures, that is $P_0 = P + q$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ATM"},{"@id":"http://qudt.org/vocab/unit/ATM_T"},{"@id":"http://qudt.org/vocab/unit/BAR"},{"@id":"http://qudt.org/vocab/unit/BARAD"},{"@id":"http://qudt.org/vocab/unit/BARYE"},{"@id":"http://qudt.org/vocab/unit/BAR_A"},{"@id":"http://qudt.org/vocab/unit/CentiBAR"},{"@id":"http://qudt.org/vocab/unit/CentiM_H2O"},{"@id":"http://qudt.org/vocab/unit/CentiM_H2O_4DEG_C"},{"@id":"http://qudt.org/vocab/unit/CentiM_HG"},{"@id":"http://qudt.org/vocab/unit/CentiM_HG_0DEG_C"},{"@id":"http://qudt.org/vocab/unit/DYN-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/DecaPA"},{"@id":"http://qudt.org/vocab/unit/DeciBAR"},{"@id":"http://qudt.org/vocab/unit/FT_H2O"},{"@id":"http://qudt.org/vocab/unit/FT_H2O_39dot2DEG_F"},{"@id":"http://qudt.org/vocab/unit/FT_HG"},{"@id":"http://qudt.org/vocab/unit/GM_F-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/GigaPA"},{"@id":"http://qudt.org/vocab/unit/HectoBAR"},{"@id":"http://qudt.org/vocab/unit/HectoPA"},{"@id":"http://qudt.org/vocab/unit/IN_H2O"},{"@id":"http://qudt.org/vocab/unit/IN_H2O_39dot2DEG_F"},{"@id":"http://qudt.org/vocab/unit/IN_H2O_60DEG_F"},{"@