:"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/SI"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$s^2$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4911"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SquareTime"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/PER-SEC2"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"s²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"s2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SquareTime"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Kvadratni Sekunda","@language":"sl"},{"@value":"Quadratsekunde","@language":"de"},{"@value":"Saat Persegi","@language":"ms"},{"@value":"Saniyekare","@language":"tr"},{"@value":"Seconde Carré","@language":"fr"},{"@value":"Secondo Quadrato","@language":"it"},{"@value":"Secundum Quadratum","@language":"la"},{"@value":"Secundă Pătrat","@language":"ro"},{"@value":"Segundo Cuadrado","@language":"es"},{"@value":"Segundo Quadrado","@language":"pt"},{"@value":"Sekunda Kwadratowy","@language":"pl"},{"@value":"Square Second","@language":"en"},{"@value":"Square Second","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Čtvereční Sekunda","@language":"cs"},{"@value":"Τετραγωνικό Δευτερόλεπτο","@language":"el"},{"@value":"Квадратен Секунда","@language":"bg"},{"@value":"Квадратный Секунда","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/SH","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A shake is an informal unit of time equal to 10 nanoseconds. It has applications in nuclear physics,\n    helping to conveniently express the timing of various events in a nuclear explosion. The typical time required for one step in\n    the chain reaction (i.e. the typical time for each neutron to cause a fission event which releases more neutrons) is of order\n    1 shake, and the chain reaction is typically complete by 50 to 100 shakes.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.00000001","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E-8","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Shake","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Time"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB226","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB226","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@val