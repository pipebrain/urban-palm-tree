/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[Btu_IT].[lb_av]-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"AZ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"British Thermal Unit (international Definition) per Pound Mass","@language":"en"},{"@value":"British Thermal Unit (international Definition) per Pound Mass","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB-DEG_F","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"British Thermal Unit (therm.) Per Pound Per Fahrenheit Degree (Btu (therm.)/lb- degF) is a unit in the\n    category of Specific heat. This unit is commonly used in the UK unit system. British Thermal Unit (therm.) Per Pound Per\n    Fahrenheit Degree (Btu (therm.)/lb-degF) has a dimension of $L2T^{-2}Q^{-1}$ where $L$ is length, $T$ is time, and $Q$ is\n    temperature. It can be converted to the corresponding standard SI unit $J/kg-K$ by multiplying its value by a factor of\n    4183.99895.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"4186.799999999999999999999999999999","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"4.186799999999999999999999999999999E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$Btu/(lb-degF)$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H-1T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-654"},{"@id":"_:n3-655"},{"@id":"_:n3-656"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificEntropy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacity"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Btu{IT}/(lbm·°F)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[Btu_IT].[lb_av]-1.[degF]-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificEntropy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"British Thermal Unit (international Definition) per Pound Mass Degree Fahrenheit","@language":"en"},{"@value":"British Thermal Unit (international Definition) per Pound Mass Degree Fahrenheit","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB-DEG_R","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"${\\bf BTU \\, per \\, Pound \\, Degree \\, Rankine}$ is a unit for 'Specific Heat Capacity' expressed as\n    $Btu/(lb-degR)$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"4186.79999999999966505