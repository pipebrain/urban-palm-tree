[{"@id":"http://qudt.org/vocab/quantitykind/AbsorbedDoseRate"},{"@id":"http://qudt.org/vocab/quantitykind/KermaRate"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA164","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA164","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Gy/s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Gy.s-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"A96","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AbsorbedDoseRate"},{"@id":"http://qudt.org/vocab/quantitykind/KermaRate"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q69428896"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Graium per Secundum","@language":"la"},{"@value":"Gray na Sekunda","@language":"cs"},{"@value":"Gray na Sekunda","@language":"sl"},{"@value":"Gray par Seconde","@language":"fr"},{"@value":"Gray pe Secundă","@language":"ro"},{"@value":"Gray per Saat","@language":"ms"},{"@value":"Gray per Saniye","@language":"tr"},{"@value":"Gray per Second","@language":"en"},{"@value":"Gray per Second","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Gray per Secondo","@language":"it"},{"@value":"Gray por Segundo","@language":"es"},{"@value":"Gray por Segundo","@language":"pt"},{"@value":"Gray pro Sekunde","@language":"de"},{"@value":"Grej na Sekunda","@language":"pl"},{"@value":"Γκρέι ανά Δευτερόλεπτο","@language":"el"},{"@value":"Грей на Секунда","@language":"bg"},{"@value":"Грэй на Секунда","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/GT","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The formula for calculating GT is given by ${ GT=V\\times (0.2+0.02\\times \\log _{10}(V))}$\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"0.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Volume"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Gross_tonnage","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"${ GT=V\\times (0.2+0.02\\times \\log _{10}(V))}$ where V is measured in cubic meters.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Gross tonnage (GT, G.T. or gt) is a nonlinear measure of a ship's overall internal volume. Gross\n    tonnage is different from gross register tonnage. Gross tonnage is used to determine things such as a ship's manning\n    regulations, safety rules, registration fees, and port dues, whereas the older gross register tonnage is a measure of the\n    volume of only certain enclosed spaces.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/M3"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"G.T.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"t{gross}","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"GT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Gross Tonnage","@language":"en"},{"@value":"Gross Tonnage","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/unit/TON_Register"}]},{"@id":"http://qudt.org/vocab/unit/Gamma","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\"Gamma\" is a C.G.S System unit for  'Magnetic Field'.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/unit/GAMMA"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.000000001","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E-9","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Gamma","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticField"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensity"}],"http://qudt.org/schem