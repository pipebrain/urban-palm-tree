001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\tau, \\tau_n, \\tau_p$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Carrier LifetIme\" is a time constant for recombination or trapping of minority charge carriers in\n    semiconductors.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Time"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q5046374"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CarrierLifetime","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Carrier Lifetime","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Time"}]},{"@id":"http://qudt.org/vocab/quantitykind/CartesianArea","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Area\" is a quantity that expresses the extent of a two-dimensional surface or shape, or planar lamina,\n    in the plane.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"area","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AC"},{"@id":"http://qudt.org/vocab/unit/ARE"},{"@id":"http://qudt.org/vocab/unit/BARN"},{"@id":"http://qudt.org/vocab/unit/CentiM2"},{"@id":"http://qudt.org/vocab/unit/DecaARE"},{"@id":"http://qudt.org/vocab/unit/DeciM2"},{"@id":"http://qudt.org/vocab/unit/FT2"},{"@id":"http://qudt.org/vocab/unit/HA"},{"@id":"http://qudt.org/vocab/unit/IN2"},{"@id":"http://qudt.org/vocab/unit/KiloM2"},{"@id":"http://qudt.org/vocab/unit/KiloMIL_Circ"},{"@id":"http://qudt.org/vocab/unit/M2"},{"@id":"http://qudt.org/vocab/unit/MI2"},{"@id":"http://qudt.org/vocab/unit/MIL_Circ"},{"@id":"http://qudt.org/vocab/unit/MI_US2"},{"@id":"http://qudt.org/vocab/unit/MicroM2"},{"@id":"http://qudt.org/vocab/unit/MilliM2"},{"@id":"http://qudt.org/vocab/unit/NanoM2"},{"@id":"http://qudt.org/vocab/unit/PIXEL_AREA"},{"@id":"http://qudt.org/vocab/unit/PlanckArea"},{"@id":"http://qudt.org/vocab/unit/YD2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Area","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$A = \\int\\int dxdy$, where $x$ and $y$ are cartesian coordinates.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Area\" is a quantity that expresses the extent of a two-dimensional surface or shape, or planar\n    lamina, in the plane.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Area"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"A","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Area","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Cartesian Area","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Area"}],"h