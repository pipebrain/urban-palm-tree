dius","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Nucleon"}]},{"@id":"http://qudt.org/vocab/constant/ProtonTauMassRatio","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_ProtonTauMassRatio"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"proton-tau mass ratio","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/QuantumOfCirculation","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Circulation"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_QuantumOfCirculation"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"quantum of circulation","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Circulation_%28fluid_dynamics%29"}]},{"@id":"http://qudt.org/vocab/constant/QuantumOfCirculationTimes2","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Circulation"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_QuantumOfCirculationTimes2"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"quantum of circulation times 2","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Circulation_%28fluid_dynamics%29"}]},{"@id":"http://qudt.org/vocab/constant/ReducedPlanckConstant","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\textit{Reduced Planck Constant}$, or $\\textit{Dirac Constant}$, is used in applications where\n   frequency is expressed in terms of radians per second ($\\textit{angular frequency}$) instead of cycles per second. \n  In such cases a factor of $\\pi$ is absorbed into the constant.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-SEC"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Action"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Planck_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\hbar = \\frac{h}{2\\pi}$, where $h$ is the Planck constant.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\hbar$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_PlanckConstantOver2Pi"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Reduced Planck Constant","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/constant/PlanckConstant"}]},{"@id":"http://qudt.org/vocab/constant/RydbergConstant","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\textit{Rydberg constant}$, named after the Swedish physicist Johannes Rydberg, is a physical constant\n   relating to atomic spectra, in the science of spectroscopy.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PER-M"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Rydberg_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InverseLength"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Rydberg_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$R_\\infty = \\frac{e^2}{8\\pi \\varepsilon_0 a_0 h c_0 }$, where $e$ is the elementary charge, $\\varepsilon_0$ is the electric constant, $a_0$ is the Bohr radius, $h$ is the Planck constant, and $c_0$ is the speed of light in vacuum.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$R_\\infty$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_RydbergConstant"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Rydberg Constant","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/RydbergConstantTimesCInHz","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Frequency"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_RydbergConstantTimesCInHz"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Rydberg constant times c in Hz","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Rydberg_constant"}]},{"@id":"http://qudt.org/vocab/constant/RydbergConstantTimesHcInEV","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_RydbergConstantTimesHcInEV"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Rydberg constant times hc in eV","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Rydberg_constant"}]},{"@id":"http://qudt.org/vocab/constant/RydbergConstantTimesHcInJ","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_RydbergConstantTimesHcInJ"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Rydberg constant times hc in J","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Rydberg_constant"}]},{"@id":"http://qudt.org/vocab/constant/SackurTetrodeConstant1K100KPa","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_SackurTetrodeConstant1K100KPa"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Sackur-Tetrode constant 1 K 100 kPa","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/SackurTetrodeConstant1K101dot325KPa","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_SackurTetrodeConstant1K101dot325KPa"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Sackur-Tetrode constant 1 K 101.325 kPa","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/SecondRadiationConstant","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LengthTemperature"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_SecondRadiationConstant"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"second radiation constant","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/ShieldedHelionGyromagneticRatio","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/GyromagneticRatio"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_ShieldedHelionGyromagneticRatio"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"shielded helio