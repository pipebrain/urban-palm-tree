ema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ397#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H-1T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient aus Volumenstrom dividiert durch die zugehörige Temperatur","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Temperature-based Volume Flow Rate","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/TemperatureDifference","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://www.merusonline.com/delta-t-temperature/","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Temperature difference (Delta T) is the difference of temperatures between two measuring points","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"ΔT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TemperatureDifference","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Temperaturdifferenz","@language":"de"},{"@value":"Temperature Difference","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/TemperatureGradient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The temperature gradient measures the difference of a temperature per length, as for instance used in an\n    external wall or its layers. It is usually measured in K/m.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_C-PER-M"},{"@id":"http://qudt.org/vocab/unit/K-PER-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H1T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD375","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD375","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://standards.buildingsmart.org/IFC/RELEASE/IFC4/ADD1/HTML/link/ifctemperaturegradientmeasure.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The temperature gradient measures the difference of a temperature per length, as for instance used\n    in an external wall or its layers. It is usually measured in K/m.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TemperatureGradient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Temperature Gradient","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/TemperaturePerMagneticFluxDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"h