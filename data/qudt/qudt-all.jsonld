,{"@id":"http://qudt.org/vocab/unit/MilliM_H2O"},{"@id":"http://qudt.org/vocab/unit/MilliM_HG"},{"@id":"http://qudt.org/vocab/unit/MilliM_HGA"},{"@id":"http://qudt.org/vocab/unit/MilliPA"},{"@id":"http://qudt.org/vocab/unit/MilliTORR"},{"@id":"http://qudt.org/vocab/unit/N-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/N-PER-M2"},{"@id":"http://qudt.org/vocab/unit/N-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/PA"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/PSI"},{"@id":"http://qudt.org/vocab/unit/PicoPA"},{"@id":"http://qudt.org/vocab/unit/PlanckPressure"},{"@id":"http://qudt.org/vocab/unit/TORR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Static_pressure","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Sound Pressure is the difference between instantaneous total pressure and static pressure.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Pressure"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"p","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1068172"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"belongs to SOQ-ISO","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ForcePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Sound Pressure","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Pressure"}]},{"@id":"http://qudt.org/vocab/quantitykind/SoundPressureLevel","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Sound pressure level ($SPL$) or sound level is a logarithmic measure of the effective sound pressure of a\n    sound relative to a reference value. It is measured in decibels (dB) above a standard reference level.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/B"},{"@id":"http://qudt.org/vocab/unit/DeciB"},{"@id":"http://qudt.org/vocab/unit/DeciB_A"},{"@id":"http://qudt.org/vocab/unit/DeciB_ISO"},{"@id":"http://qudt.org/vocab/unit/DeciB_M"},{"@id":"http://qudt.org/vocab/unit/DeciB_Z"},{"@id":"http://qudt.org/vocab/unit/PHON"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Sound_pressure#Sound_pressure_level","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$L_P = 10 \\log_{10} \\frac{p^2}{p_0^2} dB$, where $p$ is sound pressure and the reference value in airborne acoustics is $p_0 = 20 \\mu Pa$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"L","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q14515278"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"belongs to SOQ-ISO","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SoundPressureLevel","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Hladina akustického tlaku","@language":"cs"},{"@value":"Schalldruckpegel","@language":"de"},{"@value":"Sound Pressure Level","@language":"en"},{"@value":"Tahap medan","@language":"ms"},{"@value":"gerilim veya akım oranı","@language":"tr"},{"@value":"livello di pressione sonora","@language":"it"},{"@value":"miary wielkości ilorazowych","@language":"pl"},{"@value":"niveau de pression acoustique","@language":"fr"},{"@value":"nivel de presión sonora","@language":"es"},{"@value":"nível de pressão acústica","@language":"pt"},{"@value":"уровень звукового давления","@language":"ru"},{"@value":"سطح یک کمیت توان-ریشه","@language":"fa"},{"@value":"كمية جذر الطاقة","@language":"ar"},{"@value":"利得","@language":"ja"},{"@value":"声压级","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Tahap tekanan bunyi","@language":"ms"}]},{"@id":"http://qudt.org/vocab/quantitykind/SoundReductionIndex","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The Sound Reduction Index is used to measure the level of sound insulation provided by a structure such\n    as a wall, window, door, or ventilator.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/B"},{"@id":"http://qudt.org/vocab/unit/DeciB"},{"@id":"http://qudt.org/vocab/unit/DeciB_A"},{"@id":"http://qudt.org/vocab/unit/DeciB_ISO"},{"@id":"http://qudt.org/vocab/unit/DeciB_M"},{"@id":"http://qudt.org/vocab/unit/DeciB_Z"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Sound_reduction_index","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$R = 10 \\log (\\frac{1}{\\tau}) dB$, where $\\tau$ is the transmission factor.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The Sound Reduction Index is used to measure the level of sound insulation provided by a structure\n    such as a wall, window, door, or ventilator.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"R","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q2230459"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"belongs to SOQ-ISO","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SoundReductionIndex","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Sound Reduction Index","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SoundVolumeVelocity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Sound Volume Velocity is the product of particle velocity $v$ and the surface area $S$ through which an\n    acoustic wave of frequency $f$ propagates. Also, the surface integral of the normal component of the sound particle velocity\n    over the cross-section (through which the sound propagates). It is used to calculate acoustic impedance.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BBL_UK_PET-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/BBL_UK_PET-PER-HR"},{"@id":"http://qudt.org/vocab/unit/BBL_UK_PET-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/BBL_UK_PET-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/BBL_US-PER-DAY"},{"@id":"http://qudt.org/voc