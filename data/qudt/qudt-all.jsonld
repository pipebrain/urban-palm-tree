tp://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Mass","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Hmotnost","@language":"cs"},{"@value":"Jisim","@language":"ms"},{"@value":"Mass","@language":"en"},{"@value":"Masse","@language":"de"},{"@value":"kütle","@language":"tr"},{"@value":"masa","@language":"es"},{"@value":"masa","@language":"pl"},{"@value":"masa","@language":"sl"},{"@value":"massa","@language":"it"},{"@value":"massa","@language":"la"},{"@value":"massa","@language":"pt"},{"@value":"masse","@language":"fr"},{"@value":"masă","@language":"ro"},{"@value":"tömeg","@language":"hu"},{"@value":"Μάζα","@language":"el"},{"@value":"Маса","@language":"bg"},{"@value":"Масса","@language":"ru"},{"@value":"מסה","@language":"he"},{"@value":"جرم","@language":"fa"},{"@value":"كتلة","@language":"ar"},{"@value":"भार","@language":"hi"},{"@value":"質量","@language":"ja"},{"@value":"质量","@language":"zh"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassAbsorptionCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The mass absorption coefficient is the linear absorption coefficient divided by the density of the\n    absorber.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM2-PER-GM"},{"@id":"http://qudt.org/vocab/unit/M2-PER-GM"},{"@id":"http://qudt.org/vocab/unit/M2-PER-GM_DRY"},{"@id":"http://qudt.org/vocab/unit/M2-PER-KiloGM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://medical-dictionary.thefreedictionary.com/mass+absorption+coefficient","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$a_m = \\frac{a}{\\rho}$, where $a$ is the linear absorption coefficient and $\\rho$ is the mass density of the medium.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$a_m$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The mass absorption coefficient is the linear absorption coefficient divided by the density of the\n    absorber.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MassAttenuationCoefficient"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q86202147"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassAttenuationCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Absorption Coefficient","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MassAttenuationCoefficient"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassAmountOfSubstance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstancePerMass"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.5.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M-1H0T0D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"This quantity kind carried the dimension mol·kg (A1E0L0I0M1H0T0D0), which was unique in the vocabulary and\n    corresponds to no known quantity; it is understood to have been a sign error for amount of substance divided by mass (mol/kg).\n    It is replaced by quantitykind:AmountOfSubstancePerMass, and its dimension is corrected here only so that it agrees with its\n    replacement.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Amount of Substance","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassAmountOfSubstanceTemperature","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MOL_LB-DEG_F"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H1T0D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassAmountOfSubstanceTemperature","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Amount of Substance Temperature","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassAttenuationCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Mass Attenuation Coefficient\" is a measurement of how strongly a chemical species or substance absorbs\n    or scatters light at a given wavelength, per unit mass.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM2-PER-GM"},{"@id":"http://qudt.org/vocab/unit/M2-PER-GM"},{"@id":"http://qudt.org/vocab/unit/M2-PER-GM_DRY"},{"@id":"http://qudt.org/vocab/unit/M2-PER-KiloGM"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ349#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD105","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD105","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Mass_attenuation_coefficient","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mu_m = \\frac{\\mu}{\\rho}$, where $\\mu$ is the linear attenuation coefficient and $\\rho$ is the mass density of the medium.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mu_m$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Mass Attenuation Coefficient\" is a measurement of how strongly a chemical species or substance\n    absorbs or scatters light at a given wavelength, per unit mass.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1907558"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassAttenuationCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Attenuation Coefficient","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassBasedBloodGlucoseLevel","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Blood sugar level, blood sugar concentration, or blood glucose level is the amount of glucose present in\n    the blood of humans and animals. Glucose is a simple sugar and approximately 4 grams of glucose are present in the blood of\n    humans at all times. Stored in skeletal muscle and liver cells in the form of glycogen, the body tightly regulates blood\n    glucose levels as a part of metabolic homeostasis. During fasting blood glucose is maintained at a constant level at the\n    expense of the glycogen stores in the liver and skeletal muscle. There are two main methods of describing concentrations: by\n    weight, and by molecular count. Weights are in grams and molecular counts in moles. A mole is $6.022\\times 10^{23}$\n    molecules. In both cases, the unit is usually modified by $milli-$ or $micro-$ or other prefix, and is always $per$ some\n    volume, often a litre. Conversion factors depend on the molecular weight of the substance in question. $mmol/L$ is\n    millimoles/liter, and is the world standard unit for measuring glucose in blood. Specifically, it is the designated SI\n    (Systeme International) unit. Some countries use $mg/dl$. A mole is about $6\\times 10^{23}$ molecules. $mg/dL$\n    (milligrams/deciliter) is the traditional unit for measuring $bG$ (blood glucose). There is a trend toward using $mmol/L$\n    however $mg/dL$ is much in practice. Some use is made of $mmol/L$ as the primary unit with $mg/dL$ quoted in parentheses. This\n    acknowledges the large base of health care providers, researchers and patients who are already familiar with $mg/dL$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MilliGM-PER-DeciL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M1H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.faqs.org/faqs/diabetes/faq/part1/section-9.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Blood_sugar_level","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MassConcentration"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassBasedBloodGlucoseLevel","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Blood Glucose Level by Mass","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/BloodGlucoseLevel"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MassConcentration"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassConcentration","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Mass Concentration\" of substance B  is defined as the mass of a constituent  divided by the volume\n    of the mixture .\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MicroGM-PER-L"},{"@id":"http://qudt.org/vocab/unit/MicroGM-PER-MilliL"},{"@id":"http://qudt.org/vocab/unit/MilliGM-PER-L"},{"@id":"http://qudt.org/vocab/unit/MilliGM-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MilliGM-PER-MilliL"},{"@id":"http://qudt.org/vocab/unit/NanoGM-PER-L"},{"@id":"http://qudt.org/vocab/unit/NanoGM-PER-MilliL"},{"@id":"http://qudt.org/vocab/unit/PicoGM-PER-MilliL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M1H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD106","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD106","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Mass_concentration_(chemistry)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\rho_B = \\frac{m_B}{V}$, where $m_B$ is the mass of substance $B$ and $V$ is the volume.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\rho_B$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Mass Concentration\" of substance B  is defined as the mass of a constituent  divided by the\n    volume of the mixture .\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/MACO"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Density"},{"@id":"http://qudt.org/vocab/quantitykind/MassDensity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q589446"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassConcentration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Concentration","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Density"},{"@id":"http://qudt.org/vocab/quantitykind/MassDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassConcentrationOfWater","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Mass Concentration of Water\" is one of a number of $\\textit{Concentration}$ quantities defined by ISO\n    80000.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M3"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M1H0T0D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$w = m/V$, where $m$ is mass of water, irrespective of the form of aggregation, and $V$ is volume. Mass concentration of water at saturation is denoted $w_{sat}$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Mass Concentration of Water is one of a number of Concentration quantities defined by ISO 80000.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MassConcentration"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"w","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q76378758"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassConcentrationOfWater","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Concentration of Water","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MassConcentration"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassConcentrationOfWaterVapour","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Mass Concentration of Water Vapour\" is one of a number of $\\textit{Concentration}$ quantities defined\n    by ISO 80000.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M3"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M1H0T0D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$w = m/V$, where $m$ is mass of water vapour and $V$ is total gas volume. Mass concentration of water vapour at saturation is denoted $v_{sat}$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Mass Concentration of Water is one of a number of Concentration quantities defined by ISO 80000.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MassConcentration"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"v","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q76378808"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassConcentrationOfWaterVapour","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Concentration of Water Vapour","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MassConcentration"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassConcentrationRateOfChange","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"the rate at which a specific chemical element or compound changes concentration over time, where with\n    concentration expressed as mass per volume. SI unit is kg * m-3 * s-1\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MicroGM-PER-L-DAY"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://pubs.usgs.gov/wri/wri034271","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"the rate at which a specific chemical element or compound changes concentration over time, where\n    with concentration expressed as mass per volume. SI unit is kg * m-3 * s-1\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M1H0T1D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassConcentrationRateOfChange","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Concentration Rate of Change","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassDefect","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Mass Defect\", also termed mass deficit, or mass packing fraction, describes mass change (decrease)\n    in bound systems, particularly atomic nuclei.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AMU"},{"@id":"http://qudt.org/vocab/unit/CARAT"},{"@id":"http://qudt.org/vocab/unit/CWT_LONG"},{"@id":"http://qudt.org/vocab/unit/CWT_SHORT"},{"@id":"http://qudt.org/vocab/unit/CentiGM"},{"@id":"http://qudt.org/vocab/unit/DRAM_UK"},{"@id":"http://qudt.org/vocab/unit/DRAM_US"},{"@id":"http://qudt.org/vocab/unit/DWT"},{"@id":"http://qudt.org/vocab/unit/DecaGM"},{"@id":"http://qudt.org/vocab/unit/DeciGM"},{"@id":"http://qudt.org/vocab/unit/DeciTONNE"},{"@id":"http://qudt.org/vocab/unit/DeciTON_Metric"},{"@id":"http://qudt.org/vocab/unit/EarthMass"},{"@id":"http://qudt.org/vocab/unit/FemtoGM"},{"@id":"http://qudt.org/vocab/unit/GM"},{"@id":"http://qudt.org/vocab/unit/GM_Carbon"},{"@id":"http://qudt.org/vocab/unit/GM_DRY"},{"@id":"http://qudt.org/vocab/unit/GM_Nitrogen"},{"@id":"http://qudt.org/vocab/unit/GRAIN"},{"@id":"http://qudt.org/vocab/unit/HectoGM"},{"@id":"http://qudt.org/vocab/unit/Hundredweight_UK"},{"@id":"http://qudt.org/vocab/unit/Hundredweight_US"},{"@id":"http://qudt.org/vocab/unit/KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloLB"},{"@id":"http://qudt.org/vocab/unit/KiloTONNE"},{"@id":"http://qudt.org/vocab/unit/KiloTON_Metric"},{"@id":"http://qudt.org/vocab/unit/LB"},{"@id":"http://qudt.org/vocab/unit/LB_M"},{"@id":"http://qudt.org/vocab/unit/LB_T"},{"@id":"http://qudt.org/vocab/unit/LunarMass"},{"@id":"http://qudt.org/vocab/unit/MOMME_Pearl"},{"@id":"http://qudt.org/vocab/unit/MOMME_Textile"},{"@id":"http://qudt.org/vocab/unit/MegaGM"},{"@id":"http://qudt.org/vocab/unit/MegaTON"},{"@id":"http://qudt.org/vocab/unit/MegaTONNE"},{"@id":"h