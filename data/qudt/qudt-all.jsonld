//qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-564"},{"@id":"_:n3-565"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/VolumetricBitDensity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA342","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA342","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"b/m³","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"bit.m-3","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/VolumetricBitDensity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bit per Cubic Meter","@language":"en-us"},{"@value":"Bit per Cubic Metre","@language":"en"},{"@value":"Bit per Cubic Metre","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BIT-PER-SEC","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A bit per second (B/s) is a unit of data transfer rate equal to 1 bits per second.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-566"},{"@id":"_:n3-567"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/BitRate"},{"@id":"http://qudt.org/vocab/quantitykind/DataRate"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA343","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA343","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Data_rate_units#Kilobyte_per_second","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"b/s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"bit.s-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/udunitsCode":[{"@value":"Bd","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"bps","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"B10","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/BitRate"},{"@id":"http://qudt.org/vocab/quantitykind/DataRate"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q549389"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bit per Second","@language":"en"},{"@value":"Bit per Second","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BQ","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\textit{Becquerel}$ is the SI derived unit of activity, usually meaning radioactivity.\n  Radioactivity is caused when atoms disintegrate, ejecting energetic particles.\n  One becquerel is the radiation caused by one disintegration per second;\n  this is equivalent to about $27.0270 \\text{picocuries (pCi)}$.\n  The unit is named for a French physicist, Antoine-Henri Becquerel (1852-1908),\n  the discoverer of radioactivity.\n  Note: both the becquerel and the hertz are basically defined as one event per second,\n  yet they measure different things.\n  The hertz is used to measure the rates of events that happen periodically in a fixed and definite cycle.\n  The becquerel is used to measure the rates of events that happen sporadically and unpredictably,\n  not in a definite cycle.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/SI"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Becquerel","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-568"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Activity"},{"@id":"http://qudt.org/vocab/quantitykind/RadioactiveDecay"},{"@id":"http://qudt.org/vocab/quantitykind/Radioactivity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA111","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA111","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Becquerel?oldid=493710036","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/becquerel"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/SI/units/becquerel"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Bq","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Bq","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/udunitsCode":[{"@value":"Bq","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"BQL","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Activity"},{"@id":"http://qudt.org/vocab/quantitykind/RadioactiveDecay"},{"@id":"http://qudt.org/vocab/quantitykind/Radioactivity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q102573"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Becquerel","@language":"cs"},{"@value":"Becquerel","@language":"de"},{"@value":"Becquerel","@language":"en"},{"@value":"Becquerel","@language":"es"},{"@value":"Becquerel","@language":"fr"},{"@value":"Becquerel","@language":"hu"},{"@value":"Becquerel","@language":"it"},{"@value":"Becquerel","@language":"ms"},{"@value":"Becquerel","@language":"pt"},{"@value":"Becquerel","@language":"ro"},{"@value":"Becquerel","@language":"sl"},{"@value":"Becquerel","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Becquerelium","@language":"la"},{"@value":"Bekerel","@language":"pl"},{"@value":"Bekerel","@language":"tr"},{"@value":"Μπεκερέλ","@language":"el"},{"@value":"Бекерел","@language":"bg"},{"@value":"Беккерель","@language":"ru"},{"@value":"בקרל","@language":"he"},{"@value":"بيكريل","@language":"ar"},{"@value":"بکرل","@language":"fa"},{"@value":"बैक्वेरल","@language":"hi"},{"@value":"ベクレル","@language":"ja"},{"@value":"贝克勒尔","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/BQ-HR-PER-M3","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Bequerel hour per cubic meter is a unit for radon exposure or time-integrated radon activity concentration, as measured for example by passive radon detectors.","@language":"en"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"3600.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"3.6E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-569"},{"@id":"_:n3-570"},{"@id":"_:n3-571"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/RadonExposure"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Bq·h/m³","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Bq.h.m-3","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/RadonExposure"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Becquerel Hour per Cubic Meter","@language":"en-us"},{"@value":"Becquerel Hour per Cubic Metre","@language":"en"},{"@value":"Becquerel Hour per Cubic Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Becquerelstunde pro Kubikmeter","@language":"de"}]},{"@id":"http://qudt.org/vocab/unit/BQ-PER-KiloGM","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The only unit in the category of Specific radioactivity. It is also known as becquerels per kilogram,\n    becquerel/kilogram. This unit is commonly used in the SI unit system. Becquerel Per Kilogram (Bq/kg) has a dimension of\n    $M{-1}T{-1}$ where $M$ is mass, and $T$ is time. It essentially the same as the corresponding standard SI unit $/kg/s$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$Bq/kg$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-572"},{"@id":"_:n3-573"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MassicActivity"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificActivity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA112","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.efunda.com/glossary/units/units--specific_radioactivity--becquerel_per_kilogram.cfm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA112","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Becquerel per Kilogram\" is used to describe radioactivity, which is often expressed in becquerels\n    per unit of volume or weight, to express how much radioactive material is contained in a sample.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Bq/kg","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Bq.kg-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"A18","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MassicActivity"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificActivity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q88768297"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Becquerel na Kilogram","@language":"cs"},{"@value":"Becquerel na Kilogram","@language":"sl"},{"@value":"Becquerel par Kilogramme","@language":"fr"},{"@value":"Becquerel pe Kilogram","@language":"ro"},{"@value":"Becquerel per Chilogrammo","@language":"it"},{"@value":"Becquerel per Kilogram","@language":"en"},{"@value":"Becquerel per Kilogram","@language":"ms"},{"@value":"Becquerel per Kilogram","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Becquerel por Kilogramo","@language":"es"},{"@value":"Becquerel por Quilograma","@language":"pt"},{"@value":"Becquerel pro Kilogramm","@language":"de"},{"@value":"Becquerelium per Chiliogramma","@language":"la"},{"@value":"Bekerel na Kilogram","@language":"pl"},{"@value":"Bekerel per Kilogram","@language":"tr"},{"@value":"Μπεκερέλ ανά Χιλιόγραμμο","@language":"el"},{"@value":"Бекерел на Килограм","@language":"bg"},{"@value":"Беккерель на Килограмм","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/BQ-PER-L","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"One radioactive disintegration per second from a one part in 10**3 of the SI unit of volume (cubic\n    metre).\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1000.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-574"},{"@id":"_:n3-575"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ActivityConcentration"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Bq/L","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Bq.L-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ActivityConcentration"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q106651237"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Becquerel per Liter","@language":"en-us"},{"@value":"Becquerel per Litre","@language":"en"},{"@value":"Becquerel per Litre","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BQ-PER-M2","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$Bq/m^2$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-576"},{"@id":"_:n3-577"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SurfaceActivityDensity"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Bq/m²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Bq.m-2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SurfaceActivityDensity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98103135"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Becquerel na Kvadratni Meter","@language":"sl"},{"@value":"Becquerel na Čtvereční Metr","@language":"cs"},{"@value":"Becquerel par Mètre Carré","@language":"fr"},{"@value":"Becquerel pe Metru Pătrat","@language":"ro"},{"@value":"Becquerel per Meter Persegi","@language":"ms"},{"@value":"Becquerel per Metro Quadrato","@language":"it"},{"@value":"Becquerel per Square Meter","@language":"en-us"},{"@value":"Becquerel per Square Metre","@language":"en"},{"@value":"Becquerel per Square Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Becquerel por Metro Cuadrado","@language":"es"},{"@value":"Becquerel por Metro Quadrado","@language":"pt"},{"@value":"Becquerel pro Quadratmeter","@language":"de"},{"@value":"Becquerelium per Metrum Quadratum","@language":"la"},{"@value":"Bekerel na Metr Kwadratowy","@language":"pl"},{"@value":"Bekerel per Metrekare","@language":"tr"},{"@value":"Μπεκερέλ ανά Τετραγωνικό Μέτρο","@language":"el"},{"@value":"Бекерел на Квадратен Метър","@language":"bg"},{"@value":"Беккерель на Квадратный Метр","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/BQ-PER-M3","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Becquerel Per Cubic Meter ($Bq/m3$) is a unit in the category of Radioactivity concentration. It is also\n    known as becquerels per cubic meter, becquerel per cubic metre, becquerels per cubic metre, becquerel/cubic inch. This unit is\n    commonly used in the SI unit system. Becquerel Per Cubic Meter (Bq/m3) has a dimension of $L{-3}T{-1}$ where $L$ is length,\n    and $T$ is time. It essentially the same as the corresponding standard SI unit $/s\\cdot m{3}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$Bq/m^3$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-578"},{"@id":"_:n3-579"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ActivityConcentration"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB126","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.efunda.com/glossary/units/units--radioactivity_concentration--becquerel_per_cubic_meter.cfm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB126","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The SI derived unit of unit in the category of Radioactivity concentration.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Bq/m³","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Bq.m-3","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"A19","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ActivityConcentration"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98102832"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Becquerel na Kubični Meter","@language":"sl"},{"@value":"Becquerel na Metr Krychlový","@language":"cs"},{"@value":"Becquerel par Mètre Cube","@language":"fr"},{"@value":"Becquerel pe Metru Cub","@language":"ro"},{"@value":"Becquerel per Cubic Meter","@language":"en-us"},{"@value":"Becquerel per Cubic Metre","@language":"en"},{"@value":"Becquerel per Cubic Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Becquerel per Meter Kubik","@language":"ms"},{"@value":"Becquerel per Metro Cubo","@language":"it"},{"@value":"Becquerel por Metro Cúbico","@language":"es"},{"@value":"Becquerel por Metro Cúbico","@language":"pt"},{"@value":"Becquerel pro Kubikmeter","@language":"de"},{"@value":"Becquerelium per Metrum Cubicum","@language":"la"},{"@value":"Bekerel na Metr Sześcienny","@language":"pl"},{"@value":"Bekerel per Metreküp","@language":"tr"},{"@value":"Μπεκερέλ ανά Κυβικό Μέτρο","@language":"el"},{"@value":"Бекерел на Кубичен Метър","@language":"bg"},{"@value":"Беккерель на Кубический Метр","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/BQ-SEC-PER-M3","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Bequerel second per cubic meter is a unit for radon exposure or time-integrated radon activity concentration, as measured for example by passive radon detectors.","@language":"en"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-580"},{"@id":"_:n3-581"},{"@id":"_:n3-582"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/RadonExposure"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Bq·s/m³","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Bq.s.m-3","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/RadonExposure"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Becquerel Saat per Meter Kubik","@language":"ms"},{"@value":"Becquerel Second per Cubic Meter","@language":"en-us"},{"@value":"Becquerel Second per Cubic Metre","@language":"en"},{"@value":"Becquerel Second per Cubic Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Becquerel Seconde par Mètre Cube","@language":"fr"},{"@value":"Becquerel Secondo per Metro Cubo","@language":"it"},{"@value":"Becquerel Secundă pe Metru Cub","@language":"ro"},{"@value":"Becquerel Segundo por Metro Cúbico","@language":"es"},{"@value":"Becquerel Segundo por Metro Cúbico","@language":"pt"},{"@value":"Becquerel Sekunda na Kubični Meter","@language":"sl"},{"@value":"Becquerel Sekunda na Metr Krychlový","@language":"cs"},{"@value":"Becquerel Sekunde pro Kubikmeter","@language":"de"},{"@value":"Becquerelium Secundum per Metrum Cubicum","@language":"la"},{"@value":"Bekerel Saniye per Metreküp","@language":"tr"},{"@value":"Bekerel Sekunda na Metr Sześcienny","@language":"pl"},{"@value":"Μπεκερέλ Δευτερόλεπτο ανά Κυβικό Μέτρο","@language":"el"},{"@value":"Бекерел Секунда на Кубичен Метър","@language":"bg"},{"@value":"Беккерель Секунда на Кубический Метр","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/BREATH","@type":["http://qudt.org/schema/qudt/ContextualUnit","http://qudt.org/schema/qudt/CountingUnit","http://qudt.org/schema/qudt/Unit"],"http://qudt.org/schema/qudt/categorizedByQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Count"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Count"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Breath","@language":"en"},{"@value":"Breath","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/unit/NUM"}]},{"@id":"http://qudt.org/vocab/unit/BREATH-PER-MIN","@type":["http://qudt.org/schema/qudt/ContextualUnit","http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A unit of respiratory rate.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.01666666666666666666666666666666667","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.666666666666666666666666666666667E-2","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$breaths/min$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-583"},{"@id":"_:n3-584"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/RespiratoryRate"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"breath/min","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"min-1{breath}","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/RespiratoryRate"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q30064611"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Breath per Minute","@language":"en"},{"@value":"Breath per Minute","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/unit/NUM-PER-MIN"}]},{"@id":"http://qudt.org/vocab/unit/BREWSTER","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The brewster (B) is a non-SI unit used to measure the susceptibility of a material to photoelasticity, or\n    the value of the stress-optic coefficient of the material. The unit has dimensions reciprocal to those of stress. One brewster\n    is defined to be equal to 10^-12 square metres per newton (m^2/N or 1/Pa) or 10^-13 square centimetres per dyne (cm^2/dyn).\n    The unit is named after David Brewster, who discovered stress-induced birefringence in 1816.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.000000000001","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E-12","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/unit/NanoM-PER-MilliM-MegaPA"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/StressOpticCoefficient"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Brewster_(unit)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/M2-PER-N"}],"http://qudt.org/schema/qudt/siUnitsExpression":[{"@value":"nm/mm/MPa","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"B","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/StressOpticCoefficient"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Brewster","@language":"en"},{"@value":"Brewster","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BTU_39DEG_F","@type":["http://qudt.org/schema/qudt/ContextualUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"unit of heat energy according to the Imperial system of units in a reference temperature of 39 °F","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1059.67","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.05967E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergy"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB216","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB216","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/J"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Btu (39 °F)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergy"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"British Thermal Unit (39 °F)","@language":"en"},{"@value":"British Thermal Unit (39 °F)","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BTU_59DEG_F","@type":["http://qudt.org/schema/qudt/ContextualUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"unit of heat energy according to the Imperial system of units in a reference temperature of 59 °F","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1054.80","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.05480E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergy"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB217","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB217","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/J"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Btu (59 °F)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"N67","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergy"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"British Thermal Unit (59 °F)","@language":"en"},{"@value":"British Thermal Unit (59 °F)","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BTU_60DEG_F","@type":["http://qudt.org/schema/qudt/ContextualUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"unit of head energy according to the Imperial system of units at a reference temperature of 60 °F","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1054.68","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.05468E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergy"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB218","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB218","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/J"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Btu (60 °F)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergy"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"British Thermal Unit (60 °F)","@language":"en"},{"@value":"British Thermal Unit (60 °F)","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BTU_IT","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{British Thermal Unit}$ (BTU or Btu) is a traditional unit of energy equal to about\n    $1.0550558526 \\textit{ kilojoule}$. It is approximately the amount of energy needed to heat 1 pound (0.454 kg) of water from\n    $39^{\\circ}{F}$ to $40^{\\circ}{F}$ . The unit is most often used in the power, steam generation, heating and air\n    conditioning industries. In scientific contexts the BTU has largely been replaced by the SI unit of energy, the $joule$,\n    though it may be used as a measure of agricultural energy production (BTU/kg). It is still used unofficially in metric\n    English-speaking countries (such as Canada), and remains the standard unit of classification for air conditioning units\n    manufactured and sold in many non-English-speaking metric countries.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1055.05585262","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.05505585262E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergy"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA114","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/Pubs/SP811/appenB9.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.iso.org/iso/home/store/catalogue_ics/catalogue_detail_ics.htm?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.knowledgedoor.com/2/units_and_constants_handbook/british-thermal-unit_group.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA114","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/British_thermal_unit","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/J"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Btu{IT}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[Btu_IT]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"BTU","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergy"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q99490009"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"British Thermal Unit (international Definition)","@language":"en"},{"@value":"British Thermal Unit (international Definition)","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BTU_IT-FT","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"${\\bf BTU_{IT} \\, Foot}$ is an Imperial unit for $\\textit{Thermal Energy Length}$ expressed as\n    $Btu-ft$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"321.581023878576","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"3.21581023878576E2","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$Btu-ft$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-585"},{"@id":"_:n3-586"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergyLength"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Btu{IT}·ft","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[Btu_IT].[ft_i]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergyLength"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"British Thermal Unit (international Definition) Foot","@language":"en"},{"@value":"British Thermal Unit (international Definition) Foot","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BTU_IT-FT-PER-FT2-HR-DEG_F","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\n  A $BTU_{IT}$, $\\italic{Foot per Square Foot Hour Degree Fahrenheit}$ is an Imperial unit for 'Thermal Conductivity',\n   expressed as $Btu_{it} \\cdot ft/(h \\cdot ft^2  \\cdot degF)$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.730734666371391076115485564304462","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.730734666371391076115485564304462E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$Btu(IT) ft/(h ft^2 degF)$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H-1T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-587"},{"@id":"_:n3-588"},{"@id":"_:n3-589"},{"@id":"_:n3-590"},{"@id":"_:n3-591"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalConductivity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA115","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA115","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Thermal_conductivity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"British thermal unit (international table) foot per hour Square foot degree Fahrenheit is the unit\n    of the thermal conductivity according to the Imperial system of units.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Btu{IT}·ft/(ft²·h·°F)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[Btu_IT].[ft_i].[ft_i]-2.h-1.[degF]-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"J40","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalConductivity"}],"http://www.linkedmodel.org/schema/vaem#comment":[{"@value":"qudt:exactMatch: unit:BTU_IT-FT-PER-HR-FT2-DEG_F","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"British Thermal Unit (international Definition) Foot per Square Foot Hour Degree Fahrenheit","@language":"en"},{"@value":"British Thermal Unit (international Definition) Foot per Square Foot Hour Degree Fahrenheit","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BTU_IT-IN","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\n  ${\\bf BTU \\, Inch}$ is an Imperial unit for 'Thermal Energy Length' expressed as $Btu-in$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"26.798418656548","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"2.6798418656548E1","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$Btu-in$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-592"},{"@id":"_:n3-593"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergyLength"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Btu{IT}·in","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[Btu_IT].[in_i]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergyLength"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"British Thermal Unit (international Definition) Inch","@language":"en"},{"@value":"British Thermal Unit (international Definition) Inch","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BTU_IT-IN-PER-FT2-HR-DEG_F","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"$BTU_{th}$ Inch per Square Foot Hour Degree Fahrenheit is an Imperial unit for 'Thermal Conductivity'\n    expressed as $Btu_{it}-in/(h-ft^{2}-degF)$. An International British thermal unit inch per second per square foot per degree\n    Fahrenheit is a unit of thermal conductivity in the US Customary Units and British Imperial Units. $1\\,Btu_{it} \\cdot in/(h\n    \\cdot ft^{2} \\cdot degF)$ shows that one thermochemical BTU of heat per one hour moves through one square foot of material,\n    which is one foot thick due to a temperature difference of one degree Fahrenheit.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.1442278888642825896762904636920385","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.442278888642825896762904636920385E-1","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-IN-PER-HR-FT2-DEG_F"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$Btu(it)-in-per-h-ft2-degF$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H-1T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-594"},{"@id":"_:n3-595"},{"@id":"_:n3-596"},{"@id":"_:n3-597"},{"@id":"_:n3-598"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalConductivity"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_F-HR-FT2-PER-BTU_IT-IN"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA117","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.translatorscafe.com/cafe/EN/units-converter/thermal-conductivity/c/","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA117","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$Btu_{it} \\cdot in/(h \\cdot ft^{2}  \\cdot degF)$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"BTU (th) Inch per Square Foot Hour Degree Fahrenheit is an Imperial unit for 'Thermal\n    Conductivity', an International British thermal unit inch per second per square foot per degree Fahrenheit is a unit of\n    thermal conductivity in the US Customary Units and British Imperial Units.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Btu{IT}·in/(ft²·h·°F)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[Btu_IT].[in_i].[ft_i]-2.h-1.[degF]-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"J41","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalConductivity"}],"http://www.linkedmodel.org/schema/vaem#comment":[{"@value":"qudt:exactMatch: unit:BTU_IT-IN-PER-HR-FT2-DEG_F","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"British Thermal Unit (international Definition) Inch per Square Foot Hour Degree Fahrenheit","@language":"en"},{"@value":"British Thermal Unit (international Definition) Inch per Square Foot Hour Degree Fahrenheit","@type":"http://www.w3.