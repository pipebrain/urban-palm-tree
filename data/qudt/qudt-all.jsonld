[{"@value":"Applicable units are those of quantitykind:ForcePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Ambient Pressure","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Pressure"}]},{"@id":"http://qudt.org/vocab/quantitykind/AmountOfBiologicallyActiveSubstance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Amount of Biologically Active Substance\" is the quantity of a substance expressed in\n    International Units (IU), a measure of biological activity. It is dimensioned as mass (M) and organized under\n    Mass Equivalent rather than as amount of substance (N): for any given substance one IU corresponds to a defined\n    mass of an international reference preparation, so the quantity is a substance-dependent mass equivalent whose\n    conversion factor is fixed per substance and resolved at the quantity level. It is deliberately not dimensioned\n    as amount of substance, since one IU is not a fixed number of moles.","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/IU"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD370","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD370","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/MassEquivalent"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AmountOfBiologicallyActiveSubstance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Amount of Biologically Active Substance","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MassEquivalent"}]},{"@id":"http://qudt.org/vocab/quantitykind/AmountOfCloudCover","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/OKTA"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://windy.app/blog/okta-cloud-cover.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"https://library.wmo.int/viewer/68695/?offset=3#page=514&viewer=picture&o=bookmark&n=0&q=","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The amount of the celestial dome covered by all clouds visible.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AmountOfCloudCover","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Amount of Cloud Cover","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/AmountOfData","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The total quantity of digital information or storage, counted as a number of bits or bytes (and their SI\n    and binary multiples). This is an abstract umbrella kind; its concrete specialisations are counted in bits\n    (quantitykind:BitDataVolume) or bytes (quantitykind:ByteDataVolume). It is a counting quantity, distinct from the\n    information-theoretic entropy carried by that data (see unit:SHANNON).\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BIT"},{"@id":"http://qudt.org/vocab/unit/BYTE"},{"@id":"http://qudt.org/vocab/unit/ExaBIT"},{"@id":"http://qudt.org/vocab/unit/ExaBYTE"},{"@id":"http://qudt.org/vocab/unit/ExbiBIT"},{"@id":"http://qudt.org/vocab/unit/ExbiBYTE"},{"@id":"http://qudt.org/vocab/unit/GibiBIT"},{"@id":"http://qudt.org/vocab/unit/GibiBYTE"},{"@id":"http://qudt.org/vocab/unit/GigaBIT"},{"@id":"http://qudt.org/vocab/unit/GigaBYTE"},{"@id":"http://qudt.org/vocab/unit/KibiBIT"},{"@id":"http://qudt.org/vocab/unit/KibiBYTE"},{"@id":"http://qudt.org/vocab/unit/KiloBIT"},{"@id":"http://qudt.org/vocab/unit/KiloBYTE"},{"@id":"http://qudt.org/vocab/unit/MebiBIT"},{"@id":"http://qudt.org/vocab/unit/MebiBYTE"},{"@id":"http://qudt.org/vocab/unit/MegaBIT"},{"@id":"http://qudt.org/vocab/unit/MegaBYTE"},{"@id":"http://qudt.org/vocab/unit/OCTET"},{"@id":"http://qudt.org/vocab/unit/PebiBIT"},{"@id":"http://qudt.org/vocab/unit/PebiBYTE"},{"@id":"http://qudt.org/vocab/unit/PetaBIT"},{"@id":"http://qudt.org/vocab/unit/PetaBYTE"},{"@id":"http://qudt.org/vocab/unit/TebiBIT"},{"@id":"http://qudt.org/vocab/unit/TebiBYTE"},{"@id":"http://qudt.org/vocab/unit/TeraBIT"},{"@id":"http://qudt.org/vocab/unit/TeraBYTE"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ203#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Count"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AmountOfData","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Amount of Data","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Count"}]},{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Amount of Substance}$ is a standards-defined quantity that measures the size of an ensemble of\n    elementary entities, such as atoms, molecules, electrons, and other particles. It is sometimes referred to as chemical amount.\n    The International System of Units (SI) defines the amount of substance to be proportional to the number of elementary entities\n    present. The SI unit for amount of substance is mole. It has the unit symbol $mol$.  The mole is defined as the amount of\n    substance that contains an equal number of elementary entities as there are atoms in 0.012kg of the isotope carbon-12. This\n    number is called Avogadro's number and has the value $6.02214179(30) \\times 10^{23}$.  The only other unit of amount of\n    substance in current use is the $pound-mole$ with the symbol $lb-mol$, which is sometimes used in chemical engineering in the\n    United States. One $pound-mole$ is exactly $453.59237 mol$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiMOL"},{"@id":"http://qudt.org/vocab/unit/FemtoMOL"},{"@id":"http://qudt.org/vocab/unit/KiloMOL"},{"@id":"http://qudt.org/vocab/unit/MOL"},{"@id":"http://qudt.org/vocab/unit/MOL_LB"},{"@id":"http://qudt.org/vocab/unit/MicroMOL"},{"@id":"http://qudt.org/vocab/unit/MilliMOL"},{"@id":"http://qudt.org/vocab/unit/MilliOSM"},{"@id":"http://qudt.org/vocab/unit/NCM"},{"@id":"http://qudt.org/vocab/unit/NCM_1ATM_0DEG_C_NL"},{"@id":"http://qudt.org/vocab/unit/NanoMOL"},{"@id":"http://qudt.org/vocab/unit/OSM"},{"@id":"http://qudt.org/vocab/unit/PicoMOL"},{"@id":"http://qudt.org/vocab/unit/SCF"},{"@id":"http://qudt.org/vocab/unit/SCM"},{"@id":"http://qudt.org/vocab/unit/SCM_1ATM_0DEG_C"},{"@id":"http://qudt.org/vocab/unit/SCM_1ATM_15DEG_C_ISO"},{"@id":"http://qudt.org/vocab/unit/SCM_1ATM_15DEG_C_NL"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Amount_of_substance","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ231#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD004","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Amount_of_substance","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/AMSU"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"n","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q104946"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AmountOfSubstance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Amount of Substance","@language":"en"},{"@value":"Jumlah bahan","@language":"ms"},{"@value":"Látkové množství","@language":"cs"},{"@value":"Stoffmenge","@language":"de"},{"@value":"anyagmennyiség","@language":"hu"},{"@value":"cantidad de sustancia","@language":"es"},{"@value":"cantitate de substanță","@language":"ro"},{"@value":"liczność materii","@language":"pl"},{"@value":"madde miktarı","@language":"tr"},{"@value":"množina snovi","@language":"sl"},{"@value":"quantidade de substância","@language":"pt"},{"@value":"quantitas substantiae","@language":"la"},{"@value":"quantità di sostanza","@language":"it"},{"@value":"quantité de matière","@language":"fr"},{"@value":"Ποσότητα Ουσίας","@language":"el"},{"@value":"Количество вещества","@language":"ru"},{"@value":"Количество вещество","@language":"bg"},{"@value":"כמות חומר","@language":"he"},{"@value":"كمية المادة","@language":"ar"},{"@value":"مقدار ماده","@language":"fa"},{"@value":"पदार्थ की मात्रा","@language":"hi"},{"@value":"物質量","@language":"ja"},{"@value":"物质的量","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"chemical amount","@language":"en"},{"@value":"jumlah kimia","@language":"ms"},{"@value":"quantità chimica","@language":"it"},{"@value":"quantità di materia","@language":"it"}]},{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstanceConcentration","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Amount of Substance of Concentration\" is defined as the amount of a constituent divided by the volume of\n    the mixture.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/FemtoMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/KiloMOL-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-DeciM3"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MicroMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/MilliMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/MilliMOL-PER-M3"},{"@id":"http://qudt.org/vocab/unit/NanoMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/PicoMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/PicoMOL-PER-M3"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstancePerVolume"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L-3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD005","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Amount_of_substance_concentration","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$C_B = \\frac{n_B}{V}$, where $n_B$ is the amount of substance $B$ and $V$ is the volume.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Amount of Substance of Concentration of B\" is defined as the amount of a constituent divided by\n    the volume of the mixture.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/AMSC"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Concentration"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"C_B","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Concentration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Amount of Substance of Concentration","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Concentration"}]},{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstanceFraction","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Fractional Amount of Substance\" is defined as tthe amount of a constituent divided by the total amount\n    of all constituents in a mixture.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PPB"},{"@id":"http://qudt.org/vocab/unit/PPM"},{"@id":"http://qudt.org/vocab/unit/PPQ"},{"@id":"http://qudt.org/vocab/unit/PPT"},{"@id":"http://qudt.org/vocab/unit/PPTH"},{"@id":"http://qudt.org/vocab/unit/PPTM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Amount_fraction","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$x_B = \\frac{n_B}{n}$, where $n_B$ is the amount of substance $B$ and $n$ is the total amount of substance.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Fractional Amount of Substance\" is defined as tthe amount of a constituent divided by the total\n    amount of all constituents in a mixture.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"X_B","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AmountOfSubstanceFraction","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Fractional Amount of Substance","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstanceIonConcentration","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Amount of Substance Ion Concentration\" is the moles of ions per volume of solution.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/FemtoMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/KiloMOL-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-DeciM3"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MicroMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/MilliMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/MilliMOL-PER-M3"},{"@id":"http://qudt.org/vocab/unit/NanoMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/PicoMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/PicoMOL-PER-M3"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/IonConcentration"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L-3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Amount of Substance Ion Concentration\" is the moles of ions per volume of solution.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Concentration"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Concentration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Amount of Substance Ion Concentration","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Concentration"}]},{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstancePerMass","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiMOL-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/FemtoMOL-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloMOL-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-TONNE"},{"@id":"http://qudt.org/vocab/unit/MOL_LB-PER-LB"},{"@id":"http://qudt.org/vocab/unit/MicroMOL-PER-GM"},{"@id":"http://qudt.org/vocab/unit/MicroMOL-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MilliMOL-PER-GM"},{"@id":"http://qudt.org/vocab/unit/MilliMOL-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MilliOSM-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/NanoMOL-PER-GM"},{"@id":"http://qudt.org/vocab/unit/NanoMOL-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/PicoMOL-PER-KiloGM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AmountOfSubstancePerMass","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Amount of Substance per Mass","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstancePerMassPressure","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Variation of Molar Mass\" of a gas as a function of pressure.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MOL-PER-KiloGM-BAR"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-KiloGM-PA"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L1I0M-2H0T2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Variation of Molar Mass\" of a gas as a function of pressure.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M2H0T-2D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AmountOfSubstancePerMassPressure","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Molar Mass Variation Due to Pressure","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstancePerVolume","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The amount of substance per volume is called the molar density. Molar density is an intensive property of\n    a substance and depends on the temperature and pressure.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/FemtoMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/KiloMOL-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-DeciM3"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MicroMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/MilliMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/MilliMOL-PER-M3"},{"@id":"http://qudt.org/vocab/unit/NanoMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/PicoMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/PicoMOL-PER-M3"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstanceConcentration"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L-3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.ask.com/answers/72367781/what-is-defined-as-the-amount-of-substance-per-unit-of-volume","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Molar_concentration","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The amount of substance per unit volume is called the molar density. Molar density is an intensive\n    property of a substance and depends on the temperature and pressure.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Concentration"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Concentration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Amount of Substance per Volume","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Concentration"}]},{"@id":"http://qudt.org/vocab/quantitykind/Angle","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The abstract notion of angle. Narrow concepts include plane angle and solid angle. While both plane angle\n    and solid angle are dimensionless, they are actually length/length and area/area respectively.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ARCMIN"},{"@id":"http://qudt.org/vocab/unit/ARCSEC"},{"@id":"http://qudt.org/vocab/unit/DEG"},{"@id":"http://qudt.org/vocab/unit/GON"},{"@id":"http://qudt.org/vocab/unit/GRAD"},{"@id":"http://qudt.org/vocab/unit/MIL_Angle"},{"@id":"http://qudt.org/vocab/unit/MIN_Angle"},{"@id":"http://qudt.org/vocab/unit/MicroRAD"},{"@id":"http://qudt.org/vocab/unit/MilliARCSEC"},{"@id":"http://qudt.org/vocab/unit/MilliRAD"},{"@id":"http://qudt.org/vocab/unit/RAD"},{"@id":"http://qudt.org/vocab/unit/REV"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Angle","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1357788"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Angle","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Angle","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/AngleOfAttack","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Angle of attack  is the angle between the oncoming air or relative wind and a reference line on the\n    airplane or wing.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ARCMIN"},{"@id":"http://qudt.org/vocab/unit/ARCSEC"},{"@id":"http://qudt.org/vocab/unit/DEG"},{"@id":"http://qudt.org/vocab/unit/GON"},{"@id":"http://qudt.org/vocab/unit/GRAD"},{"@id":"http://qudt.org/vocab/unit/MIL_Angle"},{"@id":"http://qudt.org/vocab/unit/MIN_Angle"},{"@id":"http://qudt.org/vocab/unit/MicroRAD"},{"@id":"http://qudt.org/vocab/unit/MilliARCSEC"},{"@id":"http://qudt.org/vocab/unit/MilliRAD"},{"@id":"http://qudt.org/vocab/unit/RAD"},{"@id":"http://qudt.org/vocab/unit/REV"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\alpha$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Angle of attack  is the angle between the oncoming air or relative wind and a reference line on the\n    airplane or wing.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q370906"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Angle","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:PlaneAngle","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Angle of Attack","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}]},{"@id":"http://qudt.org/vocab/quantitykind/AngleOfOpticalRotation","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Angle of Optical Rotation\" is the angle through which plane-polarized light is rotated clockwise, as\n    seen when facing the light source, in passing through an optically active medium.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ARCMIN"},{"@id":"http://qudt.org/vocab/unit/ARCSEC"},{"@id":"http://qudt.org/vocab/unit/DEG"},{"@id":"http://qudt.org/vocab/unit/GON"},{"@id":"http://qudt.org/vocab/unit/GRAD"},{"@id":"http://qudt.org/vocab/unit/MIL_Angle"},{"@id":"http://qudt.org/vocab/unit/MIN_Angle"},{"@id":"http://qudt.org/vocab/unit/MicroRAD"},{"@id":"http://qudt.org/vocab/unit/MilliARCSEC"},{"@id":"http://qudt.org/vocab/unit/MilliRAD"},{"@id":"http://qudt.org/vocab/unit/RAD"},{"@id":"http://qudt.org/vocab/unit/REV"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Optical_rotation","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\alpha$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Angle of Optical Rotation\" is the angle through which plane-polarized light is rotated\n    clockwise, as seen when facing the light source, in passing through an optically active medium.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q96323385"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Angle","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:PlaneAngle","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Angle of Optical Rotation","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}]},{"@id":"http://qudt.org/vocab/quantitykind/AngularAcceleration","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Angular acceleration is the rate of change of angular velocity over time. Measurement of the change made\n    in the rate of change of an angle that a spinning object undergoes per unit time. It is a vector quantity.  Also called\n    Rotational acceleration. In SI units, it is measured in radians per second squared ($rad/s^2$), and is usually denoted by the\n    Greek letter alpha.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/RAD-PER-SEC2"},{"@id":"http://qudt.org/vocab/unit/REV-PER-MIN-SEC"},{"@id":"http://qudt.org/vocab/unit/REV-PER-SEC2"}],"http://qudt.org/schema/qudt/baseCGSUnitDimensions":[{"@value":"U/T^2","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/baseSIUnitDimensions":[{"@value":"$/s^2$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Angular_acceleration","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ412#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD006","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD006","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/ACCA"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q186300"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AngularAcceleration","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Accelerație unghiulară","@language":"ro"},{"@value":"Angular Acceleration","@language":"en"},{"@value":"Açısal ivme","@language":"tr"},{"@value":"Pecutan bersudut","@language":"ms"},{"@value":"Przyspieszenie kątowe","@language":"pl"},{"@value":"Winkelbeschleunigung","@language":"de"},{"@value":"accelerazione angolare","@language":"it"},{"@value":"accélération angulaire","@language":"fr"},{"@value":"aceleración angular","@language":"es"},{"@value":"aceleração angular","@language":"pt"},{"@value":"Úhlové zrychlení","@language":"cs"},{"@value":"Угловое ускорение","@language":"ru"},{"@value":"تسارع زاوي","@language":"ar"},{"@value":"شتاب زاویه‌ای","@language":"fa"},{"@value":"कोणीय त्वरण","@language":"hi"},{"@value":"角加速度","@language":"ja"},{"@value":"角加速度","@language":"zh"}]},{"@id":"http://qudt.org/vocab/quantitykind/AngularCrossSection","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Angular Cross-section\" is the cross-section for ejecting or scattering a particle into an elementary\n    cone, divided by the solid angle $d\\Omega$ of that cone.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/M2-PER-SR"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ414#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD007","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD007","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Cross_section_(physics)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\sigma = \\int \\sigma_\\Omega d\\Omega$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\sigma_\\Omega$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98266630"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AngularCrossSection","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Angular Cross-section","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://qudt.org/vocab/quantitykind/SpectralCrossSection"}]},{"@id":"http://qudt.org/vocab/quantitykind/AngularDistance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Angular distance travelled by orbiting vehicle measured from the azimuth of closest approach.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ARCMIN"},{"@id":"http://qudt.org/vocab/unit/ARCSEC"},{"@id":"http://qudt.org/vocab/unit/DEG"},{"@id":"http://qudt.org/vocab/unit/GON"},{"@id":"http://qudt.org/vocab/unit/GRAD"},{"@id":"http://qudt.org/vocab/unit/MIL_Angle"},{"@id":"http://qudt.org/vocab/unit/MIN_Angle"},{"@id":"http://qudt.org/vocab/unit/MicroRAD"},{"@id":"http://qudt.org/vocab/unit/MilliARCSEC"},{"@id":"http://qudt.org/vocab/unit/MilliRAD"},{"@id":"http://qudt.org/vocab/unit/RAD"},{"@id":"http://qudt.org/vocab/unit/REV"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\theta$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Angular distance travelled by orbiting vehicle measured from the azimuth of closest approach.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Angle","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:PlaneAngle","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Angular Distance","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}]},{"@id":"http://qudt.org/vocab/quantitykind/AngularFrequency","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Angular frequency\", symbol $\\omega$ (also referred to by the terms angular speed, radial frequency,\n    circular frequency, orbital frequency, radian frequency, and pulsatance) is a scalar measure of rotation rate. Angular\n    frequency (or angular speed) is the magnitude of the vector quantity angular velocity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG-PER-HR"},{"@id":"http://qudt.org/vocab/unit/DEG-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/DEG-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PlanckFrequency_Ang"},{"@id":"http://qudt.org/vocab/unit/RAD-PER-HR"},{"@id":"http://qudt.org/vocab/unit/RAD-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/RAD-PER-SEC"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Angular_frequency","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/AngularVelocity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD397","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD397","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Angular_frequency","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\omega = 2\\pi f$, where $f$ is frequency.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\omega$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q834020"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"belongs to SOQ-ISO","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AngularFrequency","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Angular Frequency","@language":"en"},{"@value":"Kreisfrequenz","@language":"de"},{"@value":"Pulsación","@language":"fr"},{"@value":"frequenza angolare","@language":"it"},{"@value":"frequência angular","@language":"pt"},{"@value":"pulsación","@language":"es"},{"@value":"pulsacja","@language":"pl"},{"@value":"تردد زاوى","@language":"ar"},{"@value":"角振動数","@language":"ja"},{"@value":"角频率","@language":"zh"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/RotationalFrequency"},{"@id":"http://qudt.org/vocab/quantitykind/RotationalVelocity"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Pulsatanzpulsation","@language":"de"},{"@value":"pulsatance","@language":"en"},{"@value":"pulsazione","@language":"it"},{"@value":"pulsação","@language":"pt"},{"@value":"نابض","@language":"ar"},{"@value":"角周波数","@language":"ja"},{"@value":"角速度","@language":"zh"}]},{"@id":"http://qudt.org/vocab/quantitykind/AngularImpulse","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The Angular Impulse, also known as angular momentum, is the moment of linear momentum around a point. It\n    is defined as$H = \\int Mdt$, where $M$ is the moment of force and $t$ is time.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ERG-SEC"},{"@id":"http://qudt.org/vocab/unit/EV-SEC"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloGM-M2-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/N-M-SEC"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/AngularMomentum","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/AngularMomentum"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD405","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://emweb.unl.edu/NEGAHBAN/EM373/note13/note.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD405","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"H","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q73428743"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AngularImpulse","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Angular Impulse","@language":"en"},{"@value":"Drehstoß","@language":"de"},{"@value":"impulsion angulaire","@language":"fr"},{"@value":"impulso angolare","@language":"it"},{"@value":"impulso angular","@language":"es"},{"@value":"impulsão angular","@language":"pt"},{"@value":"popęd kątowy","@language":"pl"},{"@value":"نبضة دفعية زاوية","@language":"ar"},{"@value":"角冲量;冲量矩","@language":"zh"},{"@value":"角力積","@language":"ja"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Drehmomentstoß","@language":"de"}]},{"@id":"http://qudt.org/vocab/quantitykind/AngularMomentum","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Angular Momentum}$, $\\textit{Moment of Momentum}$, or $\\textit{Rotational Momentum}$, is a\n    vector quantity that represents the product of a body's rotational inertia and rotational velocity about a particular axis.\n    The $\\textit{Angular Momentum}$ of an object rotating about some reference point is the measure of the extent to which the\n    object will continue to rotate about that point unless acted upon by an external torque. In particular, if a point mass\n    rotates about an axis, then the angular momentum with respect to a point on the axis is related to the mass of the object, the\n    velocity and the distance of the mass to the axis. While the motion associated with linear momentum has no absolute frame of\n    reference, the rotation associated with angular momentum is sometimes spoken of as being measured relative to the fixed stars.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ERG-SEC"},{"@id":"http://qudt.org/vocab/unit/EV-SEC"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloGM-M2-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/N-M-SEC"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Angular_momentum","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ263#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/AngularImpulse"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD403","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD403","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Angular_momentum","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$L = I\\omega$, where $I$ is the moment of inertia, and $\\omega$ is the angular velocity.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Angular Momentum of an object rotating about some reference point is the measure of the extent to\n    which the object will continue to rotate about that point unless acted upon by an external torque. In particular, if a point\n    mass rotates about an axis, then the angular momentum with respect to a point on the axis is related to the mass of the\n    object, the velocity and the distance of the mass to the axis. While the motion associated with linear momentum has no\n    absolute frame of reference, the rotation associated with angular momentum is sometimes spoken of as being measured relative\n    to the fixed stars.  $\\textit{Angular Momentum}$, $\\textit{Moment of Momentum}, or $\\textit{Rotational Momentum\", is a\n    vector quantity that represents the product of a body's rotational inertia and rotational velocity about a particular axis.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"L","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q161254"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AngularMomentum","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Angular Momentum","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/AngularMomentumPerAngle","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/N-M-SEC-PER-RAD"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-1D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AngularMomentumPerAngle","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Angular Momentum per Angle","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/AngularReciprocalLatticeVector","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Angular Reciprocal Lattice Vector\" is a vector whose scalar products with all fundamental lattice\n    vectors are integral multiples of $2\\pi$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/RAD-PER-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.matter.org.uk/diffraction/geometry/lattice_vectors.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"G","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q105475278"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AngularReciprocalLatticeVector","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Angular Reciprocal Lattice Vector","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/AngularVelocity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Angular Velocity refers to how fast an object rotates or revolves relative to another point.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG-PER-HR"},{"@id":"http://qudt.org/vocab/unit/DEG-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/DEG-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PlanckFrequency_Ang"},{"@id":"http://qudt.org/vocab/unit/RAD-PER-HR"},{"@id":"http://qudt.org/vocab/unit/RAD-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/RAD-PER-SEC"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Angular_velocity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ413#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/AngularFrequency"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD009","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD009","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Angular_velocity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The change of angle per unit time; specifically, in celestial mechanics, the change in angle of the\n    radius vector per unit time.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T1D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/VELA"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q161635"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AngularVelocity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Angular Velocity","@language":"en"},{"@value":"Açısal hız","@language":"tr"},{"@value":"Halaju bersudut","@language":"ms"},{"@value":"Prędkość kątowa","@language":"pl"},{"@value":"Viteză unghiulară","@language":"ro"},{"@value":"Winkelgeschwindigkeit","@language":"de"},{"@value":"kotna hitrost","@language":"sl"},{"@value":"velocidad angular","@language":"es"},{"@value":"velocidade angular","@language":"pt"},{"@value":"velocità angolare","@language":"it"},{"@value":"vitesse angulaire","@language":"fr"},{"@value":"Úhlová rychlost","@language":"cs"},{"@value":"Угловая скорость","@language":"ru"},{"@value":"سرعة زاوية","@language":"ar"},{"@value":"سرعت زاویه‌ای","@language":"fa"},{"@value":"कोणीय वेग","@language":"hi"},{"@value":"角速度","@language":"ja"},{"@value":"角速度","@language":"zh"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/RotationalFrequency"},{"@id":"http://qudt.org/vocab/quantitykind/RotationalVelocity"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"angular speed","@language":"en"},{"@value":"kelajuan bersudut","@language":"ms"}]},{"@id":"http://qudt.org/vocab/quantitykind/AngularWavenumber","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"wavenumber\" is the spatial frequency of a wave - the number of waves that exist over a specified\n    distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG-PER-M"},{"@id":"http://qudt.org/vocab/unit/RAD-PER-M"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ410#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Wavenumber","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$k = \\frac{2\\pi}{\\lambda}= \\frac{2\\pi\\upsilon}{\\upsilon_p}=\\frac{\\omega}{\\upsilon_p}$, where $\\upsilon$ is the frequency of the wave, $\\lambda$ is the wavelength, $\\omega = 2\\pi \\upsilon$ is the angular frequency of the wave, and $\\upsilon_p$ is the phase velocity of the wave.\n\nAlternatively:\n\n$k = \\frac{p}{\\hbar}$, where $p$ is the linear momentum of quasi free electrons in an electron gas and $\\hbar$ is the reduced Planck constant ($h$ divided by $2\\pi$); for phonons, its magnitude is $k = \\frac{2\\pi}{\\lambda}$, where $\\lambda$ is the wavelength of the lattice vibrations.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"wavenumber\" is the spatial frequency of a wave - the number of waves that exist over a specified\n    distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"k","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q30338487"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"belongs to SOQ-ISO","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AngularWavenumber","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Angular Wavenumber","@language":"en"},{"@value":"Kreisrepetenz","@language":"de"},{"@value":"liczba falowa kątowa","@language":"pl"},{"@value":"nombre d'onde angulaire","@language":"fr"},{"@value":"numero d'onda angolare","@language":"it"},{"@value":"número de onda angular","@language":"es"},{"@value":"número de onda angular","@language":"pt"},{"@value":"عدد موجى زاوى","@language":"ar"},{"@value":"角波数","@language":"ja"},{"@value":"角波数","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Kreiswellenzahl","@language":"de"},{"@value":"angular repetency","@language":"en"},{"@value":"repetencja kątowa","@language":"pl"},{"@value":"repetência angular","@language":"pt"},{"@value":"répétence angulaire","@language":"fr"},{"@value":"تكرار زاوى","@language":"ar"}]},{"@id":"http://qudt.org/vocab/quantitykind/ApogeeRadius","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Apogee radius of an elliptical orbit","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ANGSTROM"},{"@id":"http://qudt.org/vocab/unit/AU"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB_F"},{"@id":"http://qudt.org/vocab/unit/CHAIN"},{"@id":"http://qudt.org/vocab/unit/CHAIN_US"},{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/DecaM"},{"@id":"http://qudt.org/vocab/unit/DeciM"},{"@id":"http://qudt.org/vocab/unit/FATH"},{"@id":"http://qudt.org/vocab/unit/FM"},{"@id":"http://qudt.org/vocab/unit/FT"},{"@id":"http://qudt.org/vocab/unit/FT_US"},{"@id":"http://qudt.org/vocab/unit/FUR"},{"@id":"http://qudt.org/vocab/unit/FemtoM"},{"@id":"http://qudt.org/vocab/unit/GAUGE_FR"},{"@id":"http://qudt.org/vocab/unit/GA_Charriere"},{"@id":"http://qudt.org/vocab/unit/HectoM"},{"@id":"http://qudt.org/vocab/unit/IN"},{"@id":"http://qudt.org/vocab/unit/KiloM"},{"@id":"http://qudt.org/vocab/unit/LY"},{"@id":"http://qudt.org/vocab/unit/M"},{"@id":"http://qudt.org/vocab/unit/MI"},{"@id":"http://qudt.org/vocab/unit/MI_N"},{"@id":"http://qudt.org/vocab/unit/MI_UK"},{"@id":"http://qudt.org/vocab/unit/MI_US"},{"@id":"http://qudt.org/vocab/unit/MicroIN"},{"@id":"http://qudt.org/vocab/unit/MicroM"},{"@id":"http://qudt.org/vocab/unit/MilLength"},{"@id":"http://qudt.org/vocab/unit/MilliIN"},{"@id":"http://qudt.org/vocab/unit/MilliM"},{"@id":"http://qudt.org/vocab/unit/NanoM"},{"@id":"http://qudt.org/vocab/unit/PARSEC"},{"@id":"http://qudt.org/vocab/unit/PCA"},{"@id":"http://qudt.org/vocab/unit/PT"},{"@id":"http://qudt.org/vocab/unit/PicoM"},{"@id":"http://qudt.org/vocab/unit/PlanckLength"},{"@id":"http://qudt.org/vocab/unit/ROD"},{"@id":"http://qudt.org/vocab/unit/YD"},{"@id":"http://qudt.org/vocab/unit/ZOLL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Apogee radius of an elliptical orbit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Radius"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"r_2","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Apogee Radius","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Radius"}]},{"@id":"http://qudt.org/vocab/quantitykind/ApparentEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Apparent Energy\" is the integral of apparent power over a time interval. Under sinusoidal conditions it\n    equals the product of the rms voltage, the rms electric current, and the duration of the interval. It is the modulus of the\n    complex energy $\\underline{W} = W_p + jW_q$, where $W_p$ is active energy and $W_q$ is reactive energy.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloVA-HR"},{"@id":"http://qudt.org/vocab/unit/MegaVA-HR"},{"@id":"http://qudt.org/vocab/unit/VA-HR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$W_a = \\int_{t_1}^{t_2} S \\, dt$, where $S$ is apparent power and the integral interval is the time interval from $t_1$ to $t_2$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricEnergy"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Apparent energy is the integral of apparent power over a time interval. It is commonly measured in\n    volt-ampere hours (VA·h) or kilovolt-ampere hours (kVA·h).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"W_a","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ApparentEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Apparent Energy","@language":"en"},{"@value":"Scheinenergie","@language":"de"},{"@value":"energia aparente","@language":"pt"},{"@value":"energia apparente","@language":"it"},{"@value":"energia pozorna","@language":"pl"},{"@value":"energie apparente","@language":"nl"},{"@value":"energía aparente","@language":"es"},{"@value":"énergie apparente","@language":"fr"},{"@value":"الطاقة الظاهرية","@language":"ar"},{"@value":"視在電力量","@language":"ja"},{"@value":"视在电能","@language":"zh"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ActiveEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/ApparentPower"},{"@id":"http://qudt.org/vocab/quantitykind/ReactiveEnergy"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricEnergy"}]},{"@id":"http://qudt.org/vocab/quantitykind/ApparentPower","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Apparent Power\" is the product of the rms voltage $U$ between the terminals of a two-terminal element or\n    two-terminal circuit and the rms electric current I in the element or circuit. Under sinusoidal conditions, the apparent power\n    is the modulus of the complex power.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ExaVA"},{"@id":"http://qudt.org/vocab/unit/GigaVA"},{"@id":"http://qudt.org/vocab/unit/KiloVA"},{"@id":"http://qudt.org/vocab/unit/MegaVA"},{"@id":"http://qudt.org/vocab/unit/MicroVA"},{"@id":"http://qudt.org/vocab/unit/MilliVA"},{"@id":"http://qudt.org/vocab/unit/NanoVA"},{"@id":"http://qudt.org/vocab/unit/PetaVA"},{"@id":"http://qudt.org/vocab/unit/PicoVA"},{"@id":"http://qudt.org/vocab/unit/TeraVA"},{"@id":"http://qudt.org/vocab/unit/VA"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ274#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD011","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-11-41","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD011","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\left | \\underline{S} \\right | =  UI$, where $U$ is rms value of voltage and $I$ is rms value of electric current.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\left | \\underline{S} \\right |$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricPower"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1930258"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ApparentPower","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Apparent Power","@language":"en"},{"@value":"Scheinleistung","@language":"de"},{"@value":"moc pozorna","@language":"pl"},{"@value":"potencia aparente","@language":"es"},{"@value":"potenza apparente","@language":"it"},{"@value":"potência aparente","@language":"pt"},{"@value":"puissance apparente","@language":"fr"},{"@value":"القدرة الظاهرية","@language":"ar"},{"@value":"皮相電力","@language":"ja"},{"@value":"视在功率","@language":"zh"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrent"},{"@id":"http://qudt.org/vocab/quantitykind/Voltage"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"表观功率","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricPower"}]},{"@id":"http://qudt.org/vocab/quantitykind/ApparentThermalInertia","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PER-K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H-1T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Thermal_inertia","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/InverseTemperature"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Thermal inertia is a term used to describe the observed delays in a body's temperature response\n    during heat transfers\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ApparentThermalInertia","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Measurement Unit for a Quantity Approximately Proportional to Thermal Inertia","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/InverseTemperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/Area","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Area is a quantity expressing the two-dimensional size of a defined part of a surface, typically a region\n    bounded by a closed curve.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AC"},{"@id":"http://qudt.org/vocab/unit/ARE"},{"@id":"http://qudt.org/vocab/unit/BARN"},{"@id":"http://qudt.org/vocab/unit/CentiM2"},{"@id":"http://qudt.org/vocab/unit/DecaARE"},{"@id":"http://qudt.org/vocab/unit/DeciM2"},{"@id":"http://qudt.org/vocab/unit/FT2"},{"@id":"http://qudt.org/vocab/unit/HA"},{"@id":"http://qudt.org/vocab/unit/IN2"},{"@id":"http://qudt.org/vocab/unit/KiloM2"},{"@id":"http://qudt.org/vocab/unit/KiloMIL_Circ"},{"@id":"http://qudt.org/vocab/unit/M2"},{"@id":"http://qudt.org/vocab/unit/MI2"},{"@id":"http://qudt.org/vocab/unit/MIL_Circ"},{"@id":"http://qudt.org/vocab/unit/MI_US2"},{"@id":"http://qudt.org/vocab/unit/MicroM2"},{"@id":"http://qudt.org/vocab/unit/MilliM2"},{"@id":"http://qudt.org/vocab/unit/NanoM2"},{"@id":"http://qudt.org/vocab/unit/PIXEL_AREA"},{"@id":"http://qudt.org/vocab/unit/PlanckArea"},{"@id":"http://qudt.org/vocab/unit/YD2"}],"http://qudt.org/schema/qudt/baseCGSUnitDimensions":[{"@value":"cm^2","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/baseSIUnitDimensions":[{"@value":"$m^2$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Area","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD182","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD182","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[