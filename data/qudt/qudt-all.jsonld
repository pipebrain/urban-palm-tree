guage":"pt"},{"@value":"masse au repos","@language":"fr"},{"@value":"инвариантная масса","@language":"ru"},{"@value":"جرم سکون","@language":"fa"},{"@value":"كتلة ساكنة","@language":"ar"},{"@value":"निश्चर द्रव्यमान","@language":"hi"},{"@value":"不変質量","@language":"ja"},{"@value":"静止质量","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Proper Mass","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"invariantna masa","@language":"sl"},{"@value":"lastna masa","@language":"sl"},{"@value":"masa niezmiennicza","@language":"pl"},{"@value":"masse invariante","@language":"fr"},{"@value":"masse propre","@language":"fr"},{"@value":"träge Masse","@language":"de"},{"@value":"масса покоя","@language":"ru"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}]},{"@id":"http://qudt.org/vocab/quantitykind/ReverberationTime","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Reverberation Time is the time required for reflections of a direct sound to decay by 60 dB below the\n    level of the direct sound.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Reverberation","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Reverberation Time is the time required for reflections of a direct sound to decay by 60 dB below\n    the level of the direct sound.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Time"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"T","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q606646"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"belongs to SOQ-ISO","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ReverberationTime","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Reverberation Time","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Time"}]},{"@id":"http://qudt.org/vocab/quantitykind/ReynoldsNumber","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Reynolds Number\" (Re) is a dimensionless number that gives a measure of the ratio of inertial forces\n    to viscous forces and consequently quantifies the relative importance of these two types of forces for given flow conditions.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Reynolds_number","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Reynolds_number","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$Re = \\frac{\\rho uL}{\\mu} = \\frac{uL}{\\nu}$, where $\\rho$ is mass density, $u$ is speed, $L$ is length,  $\\mu$ is dynamic viscosity, and $\\nu$ is kinematic viscosity.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31896","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Reynolds Number\" (Re) is a dimensionless number that gives a measure of the ratio of inertial\n    forces to viscous forces and consequently quantifies the relative importance of these two types of forces for given flow\n    conditions.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Re","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q178932"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ReynoldsNumber","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Reynolds Number","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Reynolds_number"}]},{"@id":"http://qudt.org/vocab/quantitykind/RichardsonConstant","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Richardson Constant\" is a constant used in developing thermionic emission current density for a metal.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-PER-M2-K2"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ453#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H-2T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD162","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD162","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Thermionic_emission","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"The thermionic emission current, $J$, for a metal is $J = AT^2\\exp{(-\\frac{\\Phi}{kT})}$, where $T$ is thermodynamic temperature, $k$ is the Boltzmann constant, and $\\Phi$ is a work function.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Richardson Constant\" is a constant used in developing thermionic emission current density for a\n    metal.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"A","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q105883079"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:RichardsonConstant","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Richardson Constant","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/RiseOfOffStateVoltage","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"du/dt as time dependent change in voltage","@language":"en"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/RateOfRiseOfOffStateVoltage"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ289#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-4D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"du/dt als zeitabhängige änderung der Spannung","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"rise of off-state voltage","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/Rotary-TranslatoryMotionConversion","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/RotaryTranslatoryMotionConversion"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD163","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD163","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"rotary-translatory motion conversion","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/quantitykind/RotaryShock","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"product of the moment of force M in a time interval multiplied by the duration of this interval","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ERG-SEC"},{"@id":"http://qudt.org/vocab/unit/EV-SEC"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloGM-M2-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/N-M-SEC"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ234#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Produkt Drehmoment M in einem Zeitintervall mal Dauer dt dieses Zeitintervalls","@language":"de"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/AngularImpulse"},{"@id":"http://qudt.org/vocab/quantitykind/AngularMomentum"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AngularImpulse","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:AngularMomentum","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Rotary Shock","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AngularImpulse"},{"@id":"http://qudt.org/vocab/quantitykind/AngularMomentum"}]},{"@id":"http://qudt.org/vocab/quantitykind/RotaryTranslatoryMotionConversion","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/IN-PER-REV"},{"@id":"http://qudt.org/vocab/unit/M-PER-RAD"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/TransmissionRatioBetweenRotationAndTranslation"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD163","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD163","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:RotaryTranslatoryMotionConversion","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Rotary-translatory Motion Conversion","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/RotationalFrequency","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A measure of the number of cycles that an item revolves per time period.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/REV-PER-HR"},{"@id":"http://qudt.org/vocab/unit/REV-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/REV-PER-SEC"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/RotationalVelocity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://standards.buildingsmart.org/IFC/DEV/IFC4_2/FINAL/HTML/link/ifcrotationalfrequencymeasure.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"IfcRotationalFrequencyMeasure is a measure of the number of cycles that an item revolves in unit\n    time. Usually measured in cycles/s.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:RotationalFrequency","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Rotational Frequency","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/AngularFrequency"},{"@id":"http://qudt.org/vocab/quantitykind/AngularVelocity"}]},{"@id":"http://qudt.org/vocab/quantitykind/RotationalMass","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Rotational Mass\" denotes the inertia of a body with respect to angular acceleration. It is usually\n    measured in kg*m^2.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloGM-M2"},{"@id":"http://qudt.org/vocab/unit/KiloGM-MilliM2"},{"@id":"http://qudt.org/vocab/unit/LB-FT2"},{"@id":"http://qudt.org/vocab/unit/LB-IN2"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/MomentOfInertia"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Moment_of_inertia","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Rotational Mass\" denotes the inertia of a body with respect to angular acceleration. It is usually\n    measured in kg*m^2.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:RotationalMass","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Rotational Mass","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/RotationalStiffness","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Rotational Stiffness is the extent to which an object resists deformation in response to an applied\n    torque.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/N-M-PER-ARCMIN"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-DEG"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-MIN_Angle"},{"@id":"http://qudt.org/vocab/unit/N-M-PER-RAD"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/TorsionalRigidity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Rotational Stiffness is the extent to which an object resists deformation in response to an applied\n    torque.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/TorquePerAngle"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TorquePerAngle","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Rotational Stiffness","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/TorquePerAngle"}]},{"@id":"http://qudt.org/vocab/quantitykind/RotationalVelocity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A measure of the number of cycles that an item revolves per time period.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/REV-PER-HR"},{"@id":"http://qudt.org/vocab/unit/REV-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/REV-PER-SEC"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/RotationalFrequency"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://standards.buildingsmart.org/IFC/DEV/IFC4_2/FINAL/HTML/link/ifcrotationalfrequencymeasure.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"IfcRotationalFrequencyMeasure is a measure of the number of cycles that an item revolves in unit\n    time. Usually measured in cycles/s.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:RotationalVelocity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Rotational Frequency","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/AngularFrequency"},{"@id":"http://qudt.org/vocab/quantitykind/AngularVelocity"}]},{"@id":"http://qudt.org/vocab/quantitykind/ScalarMagneticPotential","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Scalar Magnetic Potential\" is the scalar potential of an irrotational magnetic field strength. The\n    negative of the gradient of the scalar magnetic potential is the irrotational magnetic field strength. The magnetic scalar\n    potential is not unique since any constant scalar field can be added to it without changing its gradient.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/V-SEC-PER-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD164","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-58","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD164","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mathbf{H} = -grad V_m$, where $\\mathbf{H}$ is magnetic field strength.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\varphi$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Scalar Magnetic Potential\" is the scalar potential of an irrotational magnetic field strength. The\n    negative of the gradient of the scalar magnetic potential is the irrotational magnetic field strength. The magnetic scalar\n    potential is not unique since any constant scalar field can be added to it without changing its gradient.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"V_m","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ScalarMagneticPotential","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Scalar Magnetic Potential","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFieldStrength"}]},{"@id":"http://qudt.org/vocab/quantitykind/SecondAxialMomentOfArea","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The moment of inertia, also called mass moment of inertia, rotational inertia, polar moment of inertia of\n    mass, or the angular mass is a property of a distribution of mass in space that measures its resistance to rotational\n    acceleration about an axis.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM4"},{"@id":"http://qudt.org/vocab/unit/FT4"},{"@id":"http://qudt.org/vocab/unit/IN4"},{"@id":"http://qudt.org/vocab/unit/M4"},{"@id":"http://qudt.org/vocab/unit/MilliM4"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L4I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD165","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD165","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Second_moment_of_area","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$I_a = \\int r^2_Q dA$, where $r_Q$ is the radial distance from a $Q-axis$ and $A$ is area.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The moment of inertia, also called mass moment of inertia, rotational inertia, polar moment of\n    inertia of mass, or the angular mass is a property of a distribution of mass in space that measures its resistance to\n    rotational acceleration about an axis.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SecondMomentOfArea"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"I","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q91405496"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SecondAxialMomentOfArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Second Axial Moment of Area","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SecondMomentOfArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/SecondMomentOfArea","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The second moment of area is a property of a physical object that can be used to predict its resistance\n    to bending and deflection. The deflection of an object under load depends not only on the load, but also on the geometry of\n    the object's cross-section.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM4"},{"@id":"http://qudt.org/vocab/unit/FT4"},{"@id":"http://qudt.org/vocab/unit/IN4"},{"@id":"http://qudt.org/vocab/unit/M4"},{"@id":"http://qudt.org/vocab/unit/MilliM4"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ239#006","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L4I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Second_moment_of_area","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The second moment of area is a property of a physical object that can be used to predict its\n    resistance to bending and deflection. The deflection of an object under load depends not only on the load, but also on the\n    geometry of the object's cross-section.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q835065"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SecondMomentOfArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Flächenträgheitsmoment","@language":"de"},{"@value":"Geometryczny moment bezwładności","@language":"pl"},{"@value":"Second Moment of Area","@language":"en"},{"@value":"Segundo momento de área","@language":"pt"},{"@value":"moment quadratique","@language":"fr"},{"@value":"secondo momento di area","@language":"it"},{"@value":"segundo momento de érea","@language":"es"},{"@value":"گشتاور دوم سطح","@language":"fa"},{"@value":"क्षेत्रफल का द्वितीय आघूर्ण","@language":"hi"},{"@value":"截面二次轴矩","@language":"zh"},{"@value":"断面二次モーメント","@language":"ja"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"momento de inércia de área","@language":"pt"}]},{"@id":"http://qudt.org/vocab/quantitykind/SecondOrderReactionRateConstant","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A quantity kind that is a proportionality constant that quantifies the relationship between the molar\n    concentrations of the reactants and the rate of a second order chemical reaction.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM3-PER-MOL-SEC"},{"@id":"http://qudt.org/vocab/unit/L-PER-MOL-SEC"},{"@id":"http://qudt.org/vocab/unit/M3-PER-MOL-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L3I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A quantity kind that is a proportionality constant that quantifies the relationship between the\n    molar concentrations of the reactants and the rate of a second order chemical reaction.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SecondOrderReactionRateConstant","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Reaction Rate Constant","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SecondPolarMomentOfArea","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The moment of inertia, also called mass moment of inertia, rotational inertia, polar moment of inertia of\n    mass, or the angular mass is a property of a distribution of mass in space that measures its resistance to rotational\n    acceleration about an axis.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM4"},{"@id":"http://qudt.org/vocab/unit/FT4"},{"@id":"http://qudt.org/vocab/unit/IN4"},{"@id":"http://qudt.org/vocab/unit/M4"},{"@id":"http://qudt.org/vocab/unit/MilliM4"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L4I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD166","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD166","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Second_moment_of_area","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$I_p = \\int r^2_Q dA$, where $r_Q$ is the radial distance from a $Q-axis$ and $A$ is area.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The moment of inertia, also called mass moment of inertia, rotational inertia, polar moment of\n    inertia of mass, or the angular mass is a property of a distribution of mass in space that measures its resistance to\n    rotational acceleration about an axis.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SecondMomentOfArea"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"I","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1049636"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SecondPolarMomentOfArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Second Polar Moment of Area","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SecondMomentOfArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/SecondRadiationConstant","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"constant in Planck's radiation law on the dependence of the spectral density of various radiation\n    variables on the wavelength of the electromagnetic radiation and the absolute temperature of the black radiator, derived from\n    the product of Planck's quantum of action times the velocity of light in relation to Boltzmann's constant\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_C-CentiM"},{"@id":"http://qudt.org/vocab/unit/K-M"},{"@id":"http://qudt.org/vocab/unit/M-K"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ428#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H1T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD167","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD167","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Konstante im Planckschen Strahlungsgesetz über die Abhängigkeit der spektralen Dichte verschiedener\n    Strahlungsgrößen von der Wellenlänge der elektromagnetischen Strahlung und der absoluten Temperatur beim schwarzen Strahler,\n    welche sich zusammensetzt aus dem Produkt Plancksches Wirkungsquantum mal Lichtgeschwindigkeit bezogen auf die\n    Boltzmann-Konstante\n  ","@language":"de"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/LengthTemperature"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LengthTemperature","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Second Radiation Constant","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/LengthTemperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/SectionAreaIntegral","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The sectional area integral measure is typically used in torsional analysis. It is usually measured in\n    M⁵.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/M5"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L5I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://standards.buildingsmart.org/IFC/RELEASE/IFC4/ADD1/HTML/link/ifcsectionalareaintegralmeasure.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The sectional area integral measure is typically used in torsional analysis. It is usually measured\n    in M⁵.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SectionAreaIntegral","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Section Area Integral","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SectionModulus","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The Section Modulus is a geometric property for a given cross-section used in the design of beams or\n    flexural members.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/M3"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Section_modulus","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$Z = \\frac{I_a}{(r_Q)_{max}}$, where $I_a$ is the second axial moment of area and $(r_Q)_{max}$ is the maximum radial distance of any point in the surface considered from the $Q-axis$ with respect to which $I_a$ is defined.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The Section Modulus is a geometric property for a given cross-section used in the design of beams\n    or flexural members.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Z","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1930808"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SectionModulus","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Section Modulus","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SeebeckCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Seebeck Coefficient\", or thermopower, or thermoelectric power of a material is a measure of the\n    magnitude of an induced thermoelectric voltage in response to a temperature difference across that material.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/V-PER-K"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ430#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H-1T-3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD169","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD169","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Thermopower","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$S_{ab} = \\frac{dE_{ab}}{dT}$, where $E_{ab}$ is the thermosource voltage between substances a and b, $T$ is the thermodynamic temperature of the hot junction.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Seebeck Coefficient\", or thermopower, or thermoelectric power of a material is a measure of the\n    magnitude of an induced thermoelectric voltage in response to a temperature difference across that material.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"S_{ab}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1091448"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SeebeckCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Seebeck Coefficient","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SerumLevel","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Concentration of a biologically active substance in blood serum, expressed in International\n    Units per volume (e.g. IU/L). It is dimensioned as mass concentration, following the mass-equivalent treatment of\n    the International Unit (see unit:IU and quantitykind:AmountOfBiologicallyActiveSubstance), not as amount-of-substance\n    concentration.","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/IU-PER-L"},{"@id":"http://qudt.org/vocab/unit/IU-PER-MilliL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M1H0T0D0"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/MassConcentration"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SerumLevel","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Serum Level","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MassConcentration"}]},{"@id":"http://qudt.org/vocab/quantitykind/SerumOrPlasmaLevel","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.4","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L-3I0M0H0T0D0"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Serum or Plasma Level","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstancePerVolume"}]},{"@id":"http://qudt.org/vocab/quantitykind/ServiceFactor","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The value indicates the multiplier of the rated power that equipment can handle for some period of time\n    when operating according to a manufacturer's specified conditions; typically applicable to motors.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The value indicates the multiplier of the rated power that equipment can handle for some period of\n    time when operating according to a manufacturer's specified conditions; typically applicable to motors.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"SF","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ServiceFactor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Service Factor","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/ShannonDiversityIndex","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Information entropy applied to a collection of indiviual organisms [of selected species] in a sample\n    area. A measure of biodiversity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/NAT"},{"@id":"http://qudt.org/vocab/unit/SHANNON"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/InformationEntropy"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Information entropy applied to a collection of indiviual organisms [of selected species] in a\n    sample area. A measure of biodiversity.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ShannonDiversityIndex","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"https://data.agrimetrics.co.uk/ontologies/qudt-extension"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Shannon Diversity Index","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/InformationEntropy"}]},{"@id":"http://qudt.org/vocab/quantitykind/ShearModulus","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The Shear Modulus or modulus of rigidity, denoted by $G$, or sometimes $S$ or $\\mu$, is defined as the\n    ratio of shear stress to the shear strain.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DecaPA"},{"@id":"http://qudt.org/vocab/unit/GigaPA"},{"@id":"http://qudt.org/vocab/unit/HectoPA"},{"@id":"http://qudt.org/vocab/unit/KIP_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-M2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/KiloPA"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/MegaPA"},{"@id":"http://qudt.org/vocab/unit/MegaPSI"},{"@id":"http://qudt.org/vocab/unit/MicroPA"},{"@id":"http://qudt.org/vocab/unit/MilliPA"},{"@id":"http://qudt.org/vocab/unit/PA"},{"@id":"http://qudt.org/vocab/unit/PSI"},{"@id":"http://qudt.org/vocab/unit/PicoPA"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Shear_modulus","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$G = \\frac{\\tau}{\\gamma}$, where $\\tau$ is the shear stress and $\\gamma$ is the shear strain.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ModulusOfElasticity"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"G","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q461466"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ModulusOfElasticity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Shear Modulus","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ModulusOfElasticity"}]},{"@id":"http://qudt.org/vocab/quantitykind/ShearStrain","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Shear Strain is the amount of deformation perpendicular to a given line rather than parallel to it.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Deformation_(mechanics)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\gamma = \\frac{\\Delta x}{d}$, where $\\Delta x$ is the parallel displacement between two surfaces of a layer of thickness $d$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\gamma$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Shear Strain is the amount of deformation perpendicular to a given line rather than parallel to it.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/LengthRatio"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q7561704"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LengthRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Shear Strain","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/LengthRatio"}]},{"@id