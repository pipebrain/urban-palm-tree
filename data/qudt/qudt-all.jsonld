//qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Siemens_%28unit%29","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/unit/S"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E2L-2I0M-1H0T3D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Admittance"},{"@id":"http://qudt.org/vocab/quantitykind/Conductance"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricalConductance"},{"@id":"http://qudt.org/vocab/quantitykind/ReciprocalElectricResistance"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB200","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.simetric.co.uk/siderived.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB200","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/mho"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/S"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"℧","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"mho","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"NQ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Admittance"},{"@id":"http://qudt.org/vocab/quantitykind/Conductance"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricalConductance"},{"@id":"http://qudt.org/vocab/quantitykind/ReciprocalElectricResistance"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q14850704"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mho","@language":"en"},{"@value":"Mho","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/MHO_Stat","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\"StatMHO\" is the unit of conductance, admittance, and susceptance in the C.G.S e.s.u system of units. One\n    $statmho$ is the conductance between two points in a conductor when a constant potential difference of $1 \\; statvolt$\n    applied between the points produces in the conductor a current of $1 \\; statampere$, the conductor not being the source of\n    any electromotive force, approximately $1.1126 \\times 10^{-12} mho$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0000000000011126500561","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.1126500561E-12","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/unit/S_Stat"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E2L-3I0M-1H0T3D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricConductivity"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.sizes.com/units/statmho.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/statmho"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/S-PER-M"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"stat℧","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricConductivity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q25098783"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Statmho","@language":"en"},{"@value":"Statmho","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/MI","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The exact length of the land mile varied slightly among English-speaking countries until the\n    international yard and pound agreement in 1959 established the yard as exactly 0.9144 metres, giving a mile of exactly\n    1,609.344 metres. The United States adopted this international mile for most purposes, but retained the pre-1959 mile for some\n    land-survey data, terming it the US survey mile. In the US, statute mile formally refers to the survey mile, about 3.219 mm\n    (1/8 inch) longer than the international mile (the international mile is exactly 0.0002% less than the US survey mile).\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1609.344","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.609344E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/unit/MI_UK"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Distance"},{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA839","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA839","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Mile","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/M"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"mi","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[mi_i]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/udunitsCode":[{"@value":"mi","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"SMI","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Distance"},{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q253276"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"International Mile","@language":"en"},{"@value":"International Mile","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/MI-PER-HR","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Miles per hour is an imperial unit of speed expressing the number of statute miles covered in one hour.\n    It is currently the standard unit used for speed limits, and to express speeds generally, on roads in the United Kingdom and\n    the United States. A common abbreviation is mph or MPH.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/altSymbol":[{"@value":"mph","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.44704","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"4.4704E-1","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Miles_per_hour","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$mi/h$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-3053"},{"@id":"_:n3-3054"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/Velocity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB111","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB111","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Miles_per_hour?oldid=482840548","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"mi/h","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[mi_i].h-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"HM","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/Velocity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q211256"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"International Mile per Hour","@language":"en"},{"@value":"International Mile per Hour","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/MI-PER-MIN","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Miles per minute is an imperial unit of speed expressing the number of statute miles covered in one\n    minute.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"26.82240000000000000000000000000001","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"2.682240000000000000000000000000001E1","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$mi/min$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-3055"},{"@id":"_:n3-3056"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/Velocity"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/MIN-PER-MI"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB229","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB229","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"mi/min","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[mi_i].min-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"M57","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/Velocity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q106611642"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"International Mile per Minute","@language":"en"},{"@value":"International Mile per Minute","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/MI-PER-SEC","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Miles per second is an imperial unit of speed expressing the number of statute miles covered in one\n    second.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1609.344","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.609344E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$mi/sec$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-3057"},{"@id":"_:n3-3058"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/Velocity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB230","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB230","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"mi/s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[mi_i].s-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"M58","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/Velocity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q106611669"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"International Mile per Second","@language":"en"},{"@value":"International Mile per Second","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/MI2","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The square mile (abbreviated as sq mi and sometimes as mi) is an imperial and US unit of measure for an\n    area equal to the area of a square of one statute mile. It should not be confused with miles square, which refers to the\n    number of miles on each side squared. For instance, 20 miles square (20 × 20 miles) is equal to 400 square miles. One square\n    mile is equivalent to: 4,014,489,600 square inches 27,878,400 square feet, 3,097,600 square yards, 640 acres, 258.9988110336\n    hectares, 2560 roods, 25,899,881,103.36 square centimetres, 2,589,988.110336 square metres, 2.589988110336 square kilometres\n    When applied to a portion of the earth's surface, which is curved rather than flat, 'square mile' is an informal synonym for\n    section.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"2589988.110336","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"2.589988110336E6","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$square-mile$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-3059"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Area"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB050","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB050","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"mi²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[mi_i]2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"MIK","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Area"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q232291"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Square International Mile","@language":"en"},{"@value":"Square International Mile","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/MI3","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A cubic mile is an imperial / U.S. customary unit of volume, used in the United States, Canada, and the\n    United Kingdom. It is defined as the volume of a cube with sides of 1 mile in length.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier