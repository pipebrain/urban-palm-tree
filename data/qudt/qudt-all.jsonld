alue":"Newton Second per Metre","@language":"en"},{"@value":"Newton Second per Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Newton Seconde par Mètre","@language":"fr"},{"@value":"Newton Secondo per Metro","@language":"it"},{"@value":"Newton Secundă pe Metru","@language":"ro"},{"@value":"Newton Segundo por Metro","@language":"es"},{"@value":"Newton Segundo por Metro","@language":"pt"},{"@value":"Newton Sekunda na Meter","@language":"sl"},{"@value":"Newton Sekunda na Metr","@language":"cs"},{"@value":"Newton Sekunde pro Meter","@language":"de"},{"@value":"Newtonium Secundum per Metrum","@language":"la"},{"@value":"Niuton Sekunda na Metr","@language":"pl"},{"@value":"Νιούτον Δευτερόλεπτο ανά Μέτρο","@language":"el"},{"@value":"Ньютон Секунда на Метр","@language":"ru"},{"@value":"Нютон Секунда на Метър","@language":"bg"}]},{"@id":"http://qudt.org/vocab/unit/N-SEC-PER-M2","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"unit of the dynamic viscosity as a product of unit of the pressure (newton by square metre) multiplied\n    with the SI base unit second\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4012"},{"@id":"_:n3-4013"},{"@id":"_:n3-4014"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/DynamicViscosity"},{"@id":"http://qudt.org/vocab/quantitykind/Viscosity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB428","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB428","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"N·s/m²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"N.s.m-2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"N36","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/DynamicViscosity"},{"@id":"http://qudt.org/vocab/quantitykind/Viscosity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Newton Saat per Meter Persegi","@language":"ms"},{"@value":"Newton Saniye per Metrekare","@language":"tr"},{"@value":"Newton Second per Square Meter","@language":"en-us"},{"@value":"Newton Second per Square Metre","@language":"en"},{"@value":"Newton Second per Square Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Newton Seconde par Mètre Carré","@language":"fr"},{"@value":"Newton Secondo per Metro Quadrato","@language":"it"},{"@value":"Newton Secundă pe Metru Pătrat","@language":"ro"},{"@value":"Newton Segundo por Metro Cuadrado","@language":"es"},{"@value":"Newton Segundo por Metro Quadrado","@language":"pt"},{"@value":"Newton Sekunda na Kvadratni Meter","@language":"sl"},{"@value":"Newton Sekunda na Čtvereční Metr","@language":"cs"},{"@value":"Newton Sekunde pro Quadratmeter","@language":"de"},{"@value":"Newtonium Secundum per Metrum Quadratum","@language":"la"},{"@value":"Niuton Sekunda na Metr Kwadratowy","@language":"pl"},{"@value":"Νιούτον Δευτερόλεπτο ανά Τετραγωνικό Μέτρο","@language":"el"},{"@value":"Ньютон Секунда на Квадратный Метр","@language":"ru"},{"@value":"Нютон Секунда на Квадратен Метър","@language":"bg"}]},{"@id":"http://qudt.org/vocab/unit/N-SEC-PER-M3","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\n  The SI unit of specific acoustic impedance.\n  When sound waves pass through any physical substance the pressure of the waves causes the particles of the substance to move.\n  The sound specific impedance is the ratio between the sound pressure and the particle velocity it produces.\n  The specific impedance is $1 N \\cdot s \\cdot m^{-3}$ if unit pressure produces unit velocity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$N \\cdot s \\cdot m^{-3}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4015"},{"@id":"_:n3-4016"},{"@id":"_:n3-4017"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MechanicalSurfaceImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificAcousticImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/SurgeImpedanceOfTheMedium"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$N \\cdot s \\cdot m^{-3}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"N·s/m³","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"N.s.m-3","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MechanicalSurfaceImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificAcousticImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/SurgeImpedanceOfTheMedium"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Newton Saat per Meter Kubik","@language":"ms"},{"@value":"Newton Saniye per Metreküp","@language":"tr"},{"@value":"Newton Second per Cubic Meter","@language":"en-us"},{"@value":"Newton Second per Cubic Metre","@language":"en"},{"@value":"Newton Second per Cubic Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Newton Seconde par Mètre Cube","@language":"fr"},{"@value":"Newton Secondo per Metro Cubo","@language":"it"},{"@value":"Newton Secundă pe Metru Cub","@language":"ro"},{"@value":"Newton Segundo por Metro Cúbico","@language":"es"},{"@value":"Newton Segundo por Metro Cúbico","@language":"pt"},{"@value":"Newton Sekunda na Kubični Meter","@language":"sl"},{"@value":"Newton Sekunda na Metr Krychlový","@language":"cs"},{"@value":"Newton Sekunde pro Kubikmeter","@language":"de"},{"@value":"Newtonium Secundum per Metrum Cubicum","@language":"la"},{"@value":"Niuton Sekunda na Metr Sześcienny","@language":"pl"},{"@value":"Νιούτον Δευτερόλεπτο ανά Κυβικό Μέτρο","@language":"el"},{"@value":"Ньютон Секунда на Кубический Метр","@language":"ru"},{"@value":"Нютон Секунда на Кубичен Метър","@language":"bg"}]},{"@id":"http://qudt.org/vocab/unit/N-SEC-PER-RAD","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Newton seconds measured per radian","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4018"},{"@id":"_:n3-4019"},{"@id":"_:n3-4020"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MomentumPerAngle"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Newton seconds measured per radian","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"N·s/rad","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"N.s.rad-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MomentumPerAngle"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Newton Saat per Radian","@language":"ms"},{"@value":"Newton Saniye per Radyan","@language":"tr"},{"@value":"Newton Second per Radian","@language":"en"},{"@value":"Newton Second per Radian","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Newton Seconde par Radian","@language":"fr"},{"@value":"Newton Secondo per Radiante","@language":"it"},{"@value":"Newton Seconds per Radian","@language":"en-us"},{"@value":"Newton Secundă pe Radian","@language":"ro"},{"@value":"Newton Segundo por Radiano","@language":"pt"},{"@value":"Newton Segundo por Radián","@language":"es"},{"@value":"Newton Sekunda na Radian","@language":"sl"},{"@value":"Newton Sekunda na Radián","@language":"cs"},{"@value":"Newton Sekunde pro Radiant","@language":"de"},{"@value":"Newtonium Secundum per Radian","@language":"la"},{"@value":"Niuton Sekunda na Radian","@language":"pl"},{"@value":"Νιούτον Δευτερόλεπτο ανά Ακτίνιο","@language":"el"},{"@value":"Ньютон Секунда на Радиан","@language":"ru"},{"@value":"Нютон Секунда на Радиан","@language":"bg"}]},{"@id":"http://qudt.org/vocab/unit/NAT","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A nat is a logarithmic unit of information or entropy, based on natural logarithms and powers of e,\n    rather than the base-2 logarithms that define the shannon. The nat is the natural unit for information entropy.\n    Physical systems of natural units which normalize Boltzmann's constant to 1 are effectively measuring thermodynamic entropy in\n    nats.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/ASU"},{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-ESU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/PLANCK"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Nat","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InformationContent"},{"@id":"http://qudt.org/vocab/quantitykind/InformationEntropy"},{"@id":"http://qudt.org/vocab/quantitykind/ShannonDiversityIndex"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB345","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB345","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Nat?oldid=474010287","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"nat","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"Q16","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InformationContent"},{"@id":"http://qudt.org/vocab/quantitykind/InformationEntropy"},{"@id":"http://qudt.org/vocab/quantitykind/ShannonDiversityIndex"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q376660"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Nat","@language":"en"},{"@value":"Nat","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/NAT-PER-SEC","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\"Nat per Second\" is information rate in natural units.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$nat-per-sec$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4021"},{"@id":"_:n3-4022"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InformationFlowRate"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB348","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB348","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Nat?oldid=474010287","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31898","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"nat/s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"Q19","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InformationFlowRate"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q106467068"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Nat per Second","@language":"en"},{"@value":"Nat per Second","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/NCM","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The $\\textit{normal cubic metre}$ is a unit representing the amount of a product contained in a volume\n    of one cubic metre at reference 'normal' temperature and pressure conditions. As such, it is a measure of the actual amount of\n    product, most commonly referring to oil, not the volume of the product. The reference conditions for normal cubic metre vary\n    depending on purpose and application.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"0.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstance"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://www.wikidata.org/entity/Q350023","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/MOL"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstance"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Normal Cubic Meter","@language":"en-us"},{"@value":"Normal Cubic Metre","@language":"en"},{"@value":"Normal Cubic Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Normkubikmeter","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/unit/SCM"}]},{"@id":"http://qudt.org/vocab/unit/NCM_1ATM_0DEG_C_NL","@type":["http://qudt.org/schema/qudt/ContextualUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The $\\textit{normal cubic metre}$ is a unit for liquid products conforming to the Dutch Mining\n    Regulations (Mijnbouwregeling) for reporting in the Dutch oil and gas industry, and used predominantly for crude oil. As such,\n    it is a measure of the actual amount of oil, not the volume of the oil. The reference conditions for a Dutch normal cubic\n    metre are 0 degrees Celsius at 1 standard atmosphere (atm), equivalent to 101.325 kilopascals (kPa) of pressure.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"0.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstance"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://wetten.overheid.nl/jci1.3:c:BWBR0014468&hoofdstuk=11&paragraaf=11.3&artikel=11.3.1","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://nl.wikipedia.org/wiki/Normaal_kubieke_meter","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://open.overheid.nl/Details/fefb9108-c56d-453a-badb-c2ad144da3a1/2","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/MOL"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Nm³","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstance"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Normaal Kubieke Meter","@language":"nl"},{"@value":"Normal Cubic Metre","@language":"en"},{"@value":"Normal Cubic Metre","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/unit/SCM"}]},{"@id":"http://qudt.org/vocab/unit/NP","@type":["http://qudt.org/schema/qudt/DimensionlessUnit","http://qudt.org/schema/qudt/LogarithmicUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The neper is a logarithmic unit for ratios of measurements of physical field and power quantities, such\n    as gain and loss of electronic signals. It has the unit symbol Np. The unit's name is derived from the name of John Napier,\n    the inventor of logarithms. As is the case for the decibel and bel, the neper is not a unit in the International System of\n    Units (SI), but it is accepted for use alongside the SI. Like the decibel, the neper is a unit in a logarithmic scale. While\n    the bel uses the decadic (base-10) logarithm to compute ratios, the neper uses the natural logarithm, based on Euler's number\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"0.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Neper","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LogERatio"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA253","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA253","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Neper","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/SI/units/neper"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Np","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Np","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"C50","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LogERatio"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q50094"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Neper","@language":"en"},{"@value":"Neper","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/NP-PER-SEC","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"unit neper divided by the SI base unit second","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"0.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4023"},{"@id":"_:n3-4024"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/TimeRelatedLogERatio"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA254","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA254","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Np/s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Np.s-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"C51","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/TimeRelatedLogERatio"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Neper per Second","@language":"en"},{"@value":"Neper per Second","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/NT","@type":["http://qudt.org/schema/qudt/Unit"],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"0.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.1","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Volume"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Net_tonnage","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Net tonnage is used in the United States to determine eligibility for registering boats with\n the federal government. It is a nonlinear unit derived from the total volume of a ship's cargo space as well as some\n dimensionless factors. Net tonnage is not a measure of the weight of the ship or its cargo, and should not be confused\n with terms such as deadweight tonnage or displacement. Net tonnage is also used to determine the amount of money that\n can be charged to a ship for using a port's facilities.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/M3"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"NT","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Net Tonnage","@language":"en"},{"@value":"Net Tonnage","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/unit/TON_Register"}]},{"@id":"http://qudt.org/vocab/unit/NTU","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\"Nephelometry Turbidity Unit\" is a C.G.S System unit for  'Turbidity' expressed as $NTU$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"0.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Turbidity"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"NTU","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Turbidity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Nephelometry Tu