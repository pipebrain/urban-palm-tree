qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD035","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Viscosity#Dynamic_viscosity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\tau_{xz} = \\eta\\frac{dv_x}{dz}$, where $\\tau_{xz}$ is shear stress in a fluid moving with a velocity gradient $\\frac{dv_x}{dz}$ perpendicular to the plane of shear. ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mu$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A measure of the molecular frictional resistance of a fluid as calculated using Newton's law.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/DYVI"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q15152757"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:DynamicViscosity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dynamic Viscosity","@language":"en"},{"@value":"Kelikatan dinamik","@language":"ms"},{"@value":"Viscozitate dinamică","@language":"ro"},{"@value":"dinamik akmazlık","@language":"tr"},{"@value":"dinamična viskoznost","@language":"sl"},{"@value":"dynamische Viskosität","@language":"de"},{"@value":"lepkość dynamiczna","@language":"pl"},{"@value":"viscosidad dinámica","@language":"es"},{"@value":"viscosidade dinâmica","@language":"pt"},{"@value":"viscosità dinamica","@language":"it"},{"@value":"viscosité dynamique","@language":"fr"},{"@value":"viskozita","@language":"cs"},{"@value":"динамическую вязкость","@language":"ru"},{"@value":"لزوجة","@language":"ar"},{"@value":"گرانروی دینامیکی/ویسکوزیته دینامیکی","@language":"fa"},{"@value":"श्यानता","@language":"hi"},{"@value":"动力粘度","@language":"zh"},{"@value":"粘度","@language":"ja"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"viscosità di taglio","@language":"it"}]},{"@id":"http://qudt.org/vocab/quantitykind/EarthquakeMagnitude","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/RichterMagnitude"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD365","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD365","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EarthquakeMagnitude","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Earthquake Magnitude","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/EccentricityOfOrbit","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The orbital eccentricity of an astronomical object is a parameter that determines the amount by which its\n    orbit around another body deviates from a perfect circle. In a two-body problem with inverse-square-law force, every orbit is\n    a Kepler orbit. The eccentricity of this Kepler orbit is a positive number that defines its shape.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\varepsilon$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The orbital eccentricity of an astronomical object is a parameter that determines the amount by\n    which its orbit around another body deviates from a perfect circle. In a two-body problem with inverse-square-law force, every\n    orbit is a Kepler orbit. The eccentricity of this Kepler orbit is a positive number that defines its shape.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EccentricityOfOrbit","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Eccentricity of Orbit","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/EffectiveMass","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Effective Mass\" is used in the motional equation for electrons in solid state bodies, depending on the\n    wavenumber and corresponding to its velocity and energy level.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AMU"},{"@id":"http://qudt.org/vocab/unit/CARAT"},{"@id":"http://qudt.org/vocab/unit/CWT_LONG"},{"@id":"http://qudt.org/vocab/unit/CWT_SHORT"},{"@id":"http://qudt.org/vocab/unit/CentiGM"},{"@id":"http://qudt.org/vocab/unit/DRAM_UK"},{"@id":"http://qudt.org/vocab/unit/DRAM_US"},{"@id":"http://qudt.org/vocab/unit/DWT"},{"@id":"http://qudt.org/vocab/unit/DecaGM"},{"@id":"http://qudt.org/vocab/unit/DeciGM"},{"@id":"http://qudt.org/vocab/unit/DeciTONNE"},{"@id":"http://qudt.org/vocab/unit/DeciTON_Metric"},{"@id":"http://qudt.org/vocab/unit/EarthMass"},{"@id":"http://qudt.org/vocab/unit/FemtoGM"},{"@id":"http://qudt.org/vocab/unit/GM"},{"@id":"http://qudt.org/vocab/unit/GM_Carbon"},{"@id":"http://qudt.org/vocab/unit/GM_DRY"},{"@id":"http://qudt.org/vocab/unit/GM_Nitrogen"},{"@id":"http://qudt.org/vocab/unit/GRAIN"},{"@id":"http://qudt.org/vocab/unit/HectoGM"},{"@id":"http://qudt.org/vocab/unit/Hundredweight_UK"},{"@id":"http://qudt.org/vocab/unit/Hundredweight_US"},{"@id":"http://qudt.org/vocab/unit/KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloLB"},{"@id":"http://qudt.org/vocab/unit/KiloTONNE"},{"@id":"http://qudt.org/vocab/unit/KiloTON_Metric"},{"@id":"http://qudt.org/vocab/unit/LB"},{"@id":"http://qudt.org/vocab/unit/LB_M"},{"@id":"http://qudt.org/vocab/unit/LB_T"},{"@id":"http://qudt.org/vocab/unit/LunarMass"},{"@id":"http://qudt.org/vocab/unit/MOMME_Pearl"},{"@id":"http://qudt.org/vocab/unit/MOMME_Textile"},{"@id":"http://qudt.org/vocab/unit/MegaGM"},{"@id":"http://qudt.org/vocab/unit/MegaTON"},{"@id":"http://qudt.org/vocab/unit/MegaTONNE"},{"@id":"http://qudt.org/vocab/unit/MicroGM"},{"@id":"http://qudt.org/vocab/unit/MilliGM"},{"@id":"http://qudt.org/vocab/unit/NanoGM"},{"@id":"http://qudt.org/vocab/unit/OZ"},{"@id":"http://qudt.org/vocab/unit/OZ_M"},{"@id":"http://qudt.org/vocab/unit/OZ_TROY"},{"@id":"http://qudt.org/vocab/unit/PENNYWEIGHT"},{"@id":"http://qudt.org/vocab/unit/PFUND"},{"@id":"http://qudt.org/vocab/unit/PicoGM"},{"@id":"http://qudt.org/vocab/unit/PlanckMass"},{"@id":"http://qudt.org/vocab/unit/Quarter_UK"},{"@id":"http://qudt.org/vocab/unit/SLUG"},{"@id":"http://qudt.org/vocab/unit/SolarMass"},{"@id":"http://qudt.org/vocab/unit/Stone_UK"},{"@id":"http://qudt.org/vocab/unit/TON"},{"@id":"http://qudt.org/vocab/unit/TONNE"},{"@id":"http://qudt.org/vocab/unit/TON_Assay"},{"@id":"http://qudt.org/vocab/unit/TON_LONG"},{"@id":"http://qudt.org/vocab/unit/TON_Metric"},{"@id":"http://qudt.org/vocab/unit/TON_SHORT"},{"@id":"http://qudt.org/vocab/unit/TON_UK"},{"@id":"http://qudt.org/vocab/unit/TON_US"},{"@id":"http://qudt.org/vocab/unit/U"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Effective_mass_(solid-state_physics)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$m^* = \\hbar^2k(\\frac{d\\varepsilon}{dk})$, where $\\hbar$ is the reduced Planck constant, $k$ is the wavenumber, and $\\varepsilon$ is the energy of the electron.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Effective Mass\" is used in the motional equation for electrons in solid state bodies, depending on\n    the wavenumber and corresponding to its velocity and energy level.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m^*","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1064434"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Mass","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Effective Mass","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}]},{"@id":"http://qudt.org/vocab/quantitykind/EffectiveMultiplicationFactor","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Effective Multiplication Factor\" is the multiplication factor for a finite medium.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Nuclear_chain_reaction#Effective_neutron_multiplication_factor","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Effective Multiplication Factor\" is the multiplication factor for a finite medium.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MultiplicationFactor"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"k_{eff}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MultiplicationFactor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Effective Multiplication Factor","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MultiplicationFactor"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://qudt.org/vocab/quantitykind/InfiniteMultiplicationFactor"}]},{"@id":"http://qudt.org/vocab/quantitykind/Efficiency","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Efficiency is the ratio of output power to input power.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Deformation_(mechanics)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\eta = \\frac{P_{out}}{P_{in}}$, where $P_{out}$ is the output power and $P_{in}$ is the input power.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\eta$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Efficiency is the ratio of output power to input power.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q11945244"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Efficiency","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Efficiency","@language":"en"},{"@value":"Wirkungsgrad","@language":"de"},{"@value":"efficienza","@language":"it"},{"@value":"eficiência","@language":"pt"},{"@value":"rendement","@language":"fr"},{"@value":"rendimiento","@language":"es"},{"@value":"sprawność","@language":"pl"},{"@value":"коэффициент полезного действия","@language":"ru"},{"@value":"كفاءة","@language":"ar"},{"@value":"効率","@language":"ja"},{"@value":"效率","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"rendimento","@language":"it"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/EinsteinCoefficients","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The Einstein coefficients characterize the probability per unit time of radiative transitions between two\n    energy levels of an atom or molecule: spontaneous emission, and absorption or stimulated emission in proportion to the\n    spectral energy density of the radiation field. This quantity kind covers the induced (B) coefficients, expressed per\n    spectral radiance, with unit second per kilogram.\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/SEC-PER-KiloGM"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/EinsteinTransitionProbabilityForSpontaneousOrInducedEmissionAndAbsorption"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD036","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD036","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EinsteinCoefficients","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Einstein Coefficients","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/EinsteinTransitionProbability","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Given two atomic states of energy $E_j$ and $E_k$.  Let $E_j > E_k$.  Assume the atom is bathed in\n    radiation of energy density $u(w)$.  Transitions between these states can take place in three different ways. Spontaneous,\n    induced/stimulated emission, and induced absorption. $A_jk$ represents the Einstein transition probability for spontaneous\n    emission.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://electron6.phys.utk.edu/qm2/modules/m10/einstein.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\frac{-dN_j}{dt} = A_jkN_j$, where $-dN_j$ is the number of molecules spontaneously leaving the state j for the state k during a time interval of duration $dt$, $N_j$ is the number of molecules in the state j, and $E_j > E_k$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"A_jkN_j","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EinsteinTransitionProbability","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Einstein Transition Probability","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/EinsteinTransitionProbabilityForSpontaneousOrInducedEmissionAndAbsorption","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"nuclear constant for the special transition where the probability of the absorption, spontaneous emission\n    or induced emission of energy depends on the number of existing quantums of light, expressed as energy density in the wave\n    model of light: energy divided by volume and frequency\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/SEC-PER-KiloGM"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ456#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/EinsteinCoefficients"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H0T1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"atomare Konstante für den speziellen Übergang, wobei die Wahrscheinlichkeit der Absorption, der\n    spontanen Emission und der induzierte Emission von Energie abhängig ist von der Zahl der vorhandenen Lichtquanten, ausgedrückt\n    als Energiedichte im Wellenmodell des Lichtes: Energie durch Volumen und Frequenz\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:EinsteinTransitionProbabilityForSpontaneousOrInducedEmissionAndAbsorption","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Einstein Transition Probability for Spontaneous Or Induced Emission and Absorption","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCharge","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Electric Charge\" is a fundamental conserved property of some subatomic particles, which determines their\n    electromagnetic interaction. Electrically charged matter is influenced by, and produces, electromagnetic fields. The electric\n    charge on a body may be positive or negative. Two positively charged bodies experience a mutual repulsive force, as do two\n    negatively charged bodies. A positively charged body and a negatively charged body experience an attractive force. Electric\n    charge is carried by discrete particles and can be positive or negative. The sign convention is such that the elementary\n    electric charge $e$, that is, the charge of the proton, is positive. The SI derived unit of electric charge is the coulomb.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-HR"},{"@id":"http://qudt.org/vocab/unit/A-SEC"},{"@id":"http://qudt.org/vocab/unit/AttoC"},{"@id":"http://qudt.org/vocab/unit/C"},{"@id":"http://qudt.org/vocab/unit/C_Ab"},{"@id":"http://qudt.org/vocab/unit/C_Stat"},{"@id":"http://qudt.org/vocab/unit/CentiC"},{"@id":"http://qudt.org/vocab/unit/DecaC"},{"@id":"http://qudt.org/vocab/unit/DeciC"},{"@id":"http://qudt.org/vocab/unit/E"},{"@id":"http://qudt.org/vocab/unit/ElementaryCharge"},{"@id":"http://qudt.org/vocab/unit/ExaC"},{"@id":"http://qudt.org/vocab/unit/F"},{"@id":"http://qudt.org/vocab/unit/FR"},{"@id":"http://qudt.org/vocab/unit/FemtoC"},{"@id":"http://qudt.org/vocab/unit/GigaC"},{"@id":"http://qudt.org/vocab/unit/HectoC"},{"@id":"http://qudt.org/vocab/unit/KiloA-HR"},{"@id":"http://qudt.org/vocab/unit/KiloC"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-KiloV"},{"@id":"http://qudt.org/vocab/unit/MegaC"},{"@id":"http://qudt.org/vocab/unit/MicroC"},{"@id":"http://qudt.org/vocab/unit/MilliA-HR"},{"@id":"http://qudt.org/vocab/unit/MilliA-SEC"},{"@id":"http://qudt.org/vocab/unit/MilliC"},{"@id":"http://qudt.org/vocab/unit/NanoC"},{"@id":"http://qudt.org/vocab/unit/PetaC"},{"@id":"http://qudt.org/vocab/unit/PicoC"},{"@id":"http://qudt.org/vocab/unit/PlanckCharge"},{"@id":"http://qudt.org/vocab/unit/TeraC"},{"@id":"http://qudt.org/vocab/unit/YoctoC"},{"@id":"http://qudt.org/vocab/unit/YottaC"},{"@id":"http://qudt.org/vocab/unit/ZeptoC"},{"@id":"http://qudt.org/vocab/unit/ZettaC"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ419#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD037","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-01","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD037","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Electric_charge","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$dQ = Idt$, where $I$ is electric current.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/ELCH"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Q","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1111"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricCharge","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Cas elektrik","@language":"ms"},{"@value":"Charge électrique","@language":"fr"},{"@value":"Electric Charge","@language":"en"},{"@value":"Elektrický náboj","@language":"cs"},{"@value":"carga eléctrica","@language":"es"},{"@value":"carga elétrica","@language":"pt"},{"@value":"carica elettrica","@language":"it"},{"@value":"elektrik yükü","@language":"tr"},{"@value":"elektrische Ladung","@language":"de"},{"@value":"električni naboj","@language":"sl"},{"@value":"elektromos töltés","@language":"hu"},{"@value":"onus electricum","@language":"la"},{"@value":"sarcină electrică","@language":"ro"},{"@value":"ładunek elektryczny","@language":"pl"},{"@value":"Ηλεκτρικό φορτίο","@language":"el"},{"@value":"Електрически заряд","@language":"bg"},{"@value":"Электрический заряд","@language":"ru"},{"@value":"מטען חשמלי","@language":"he"},{"@value":"الشحنة الكهربائية","@language":"ar"},{"@value":"بار الکتریکی","@language":"fa"},{"@value":"विद्युत आवेग या विद्युत बहाव","@language":"hi"},{"@value":"电荷","@language":"zh"},{"@value":"電荷","@language":"ja"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrent"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"cantitate de electricitate","@language":"ro"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In electromagnetism, charge density is a measure of electric charge per unit volume of space, in one, two\n    or three dimensions. More specifically: the linear, surface, or volume charge density is the amount of electric charge per\n    unit length, surface area, or volume, respectively.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-HR-PER-DeciM3"},{"@id":"http://qudt.org/vocab/unit/A-HR-PER-M3"},{"@id":"http://qudt.org/vocab/unit/C-PER-CentiM3"},{"@id":"http://qudt.org/vocab/unit/C-PER-M3"},{"@id":"http://qudt.org/vocab/unit/C-PER-MilliM3"},{"@id":"http://qudt.org/vocab/unit/GigaC-PER-M3"},{"@id":"http://qudt.org/vocab/unit/KiloC-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MegaC-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MicroC-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MilliC-PER-M3"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeVolumeDensity"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$charge-density$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-3I0M0H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD242","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.maxwells-equations.com/pho/charge-density.php","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD242","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Charge_density","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\rho = \\frac{dQ}{dV}$, where $Q$ is electric charge and $V$ is Volume.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\rho$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In electromagnetism, charge density is a measure of electric charge per unit volume of space, in\n    one, two or three dimensions. More specifically: the linear, surface, or volume charge density is the amount of electric\n    charge per unit length, surface area, or volume, respectively.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/ELCD"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q69425629"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricChargeDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Charge Density","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeSurfaceDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeLineDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In electromagnetism, charge density is a measure of electric charge per unit volume of space, in one, two\n    or three dimensions. More specifically: the linear, surface, or volume charge density is the amount of electric charge per\n    unit length, surface area, or volume, respectively. The respective SI units are $C \\cdot $, $m^{-1}$, $C \\cdot m^{-2}$ or $C\n    \\cdot m^{-3}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/C-PER-M"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/LinearElectricCharge"},{"@id":"http://qudt.org/vocab/quantitykind/LinearElectricChargeDensity"},{"@id":"http://qudt.org/vocab/quantitykind/LineicCharge"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Charge_density","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\lambda$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricChargeLineDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Charge Line Density","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeLinearDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In electromagnetism, charge density is a measure of electric charge per unit volume of space, in one, two\n    or three dimensions. More specifically: the linear, surface, or volume charge density is the amount of electric charge per\n    unit length, surface area, or volume, respectively.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/LinearElectricChargeDensity"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$linear-charge-density$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Charge_density","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\rho_l = \\frac{dQ}{dl}$, where $Q$ is electric charge and $l$ is length.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\rho_l$","@type":"http://qudt.org/schema/qudt/LatexString"},{"@value":"$\\tau$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In electromagnetism, charge density is a measure of electric charge per unit volume of space, in\n    one, two or three dimensions. More specifically: the linear, surface, or volume charge density is the amount of electric\n    charge per unit length, surface area, or volume, respectively.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Charge Linear Density","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerAmountOfSubstance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Electric Charge Per Amount Of Substance\" is the charge assocated with a given amount of substance. Un\n    the ISO and SI systems this is $1 mol$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/C-PER-MOL"},{"@id":"http://qudt.org/vocab/unit/C_Stat-PER-MOL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E1L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q97061171"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricChargePerAmountOfSubstance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Charge per Amount of Substance","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerArea","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In electromagnetism, charge density is a measure of electric charge per unit volume of space, in one, two\n    or three dimensions. More specifically: the linear, surface, or volume charge density is the amount of electric charge per\n    unit length, surface area, or volume, respectively. The respective SI units are $C \\cdot m^{-1}$, $C \\cdot m^{-2}$ or $C\n    \\cdot m^{-3}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-HR-PER-M2"},{"@id":"http://qudt.org/vocab/unit/C-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/C-PER-M2"},{"@id":"http://qudt.org/vocab/unit/C-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/C_Ab-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/C_Stat-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MegaC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MicroC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MilliC-PER-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Charge_density","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\sigma$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricChargePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Charge per Area","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerMass","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Electric Charge Per Mass\" is the charge associated with a specific mass of a substance. In the SI and\n    ISO systems this is $1 kg$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-HR-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/A-M2-PER-J-SEC"},{"@id":"http://qudt.org/vocab/unit/C-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/HZ-PER-T"},{"@id":"http://qudt.org/vocab/unit/KiloR"},{"@id":"http://qudt.org/vocab/unit/MegaHZ-PER-T"},{"@id":"http://qudt.org/vocab/unit/MilliC-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MilliR"},{"@id":"http://qudt.org/vocab/unit/PER-T-SEC"},{"@id":"http://qudt.org/vocab/unit/R"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M-1H0T1D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricChargePerMass","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Charge per Mass","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeSurfaceDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In electromagnetism, charge density is a measure of electric charge per unit volume of space, in one, two\n    or three dimensions. More specifically: the linear, surface, or volume charge density is the amount of electric charge per\n    unit length, surface area, or volume, respectively.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-HR-PER-M2"},{"@id":"http://qudt.org/vocab/unit/C-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/C-PER-M2"},{"@id":"http://qudt.org/vocab/unit/C-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/C_Ab-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/C_Stat-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MegaC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MicroC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MilliC-PER-M2"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$surface-charge-density$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Charge_density","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\rho_A = \\frac{dQ}{dA}$, where $Q$ is electric charge and $A$ is Area.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\rho_A$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In electromagnetism, charge density is a measure of electric charge per unit volume of space, in\n    one, two or three dimensions. More specifically: the linear, surface, or volume charge density is the amount of electric\n    charge per unit length, surface area, or volume, respectively.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerArea"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricChargePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Charge Surface Density","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeDensity"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeVolumeDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In electromagnetism, charge density is a measure of electric charge per unit volume of space, in one, two\n    or three dimensions. More specifically: the linear, surface, or volume charge density is the amount of electric charge per\n    unit length, surface area, or volume, respectively. The respective SI units are $C \\cdot m^{-1}$, $C \\cdot m^{-2}$ or $C\n    \\cdot m^{-3}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-HR-PER-DeciM3"},{"@id":"http://qudt.org/vocab/unit/A-HR-PER-M3"},{"@id":"http://qudt.org/vocab/unit/C-PER-CentiM3"},{"@id":"http://qudt.org/vocab/unit/C-PER-M3"},{"@id":"http://qudt.org/vocab/unit/C-PER-MilliM3"},{"@id":"http://qudt.org/vocab/unit/GigaC-PER-M3"},{"@id":"http://qudt.org/vocab/unit/KiloC-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MegaC-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MicroC-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MilliC-PER-M3"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeDensity"},{"@id":"http://qudt.org/vocab/quantitykind/VolumeDensityOfCharge"},{"@id":"http://qudt.org/vocab/quantitykind/VolumetricElectricCharge"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-3I0M0H0T1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Charge_density","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\rho$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricChargeVolumeDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Charge Volume Density","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricConductivity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The quantity kind $\\textit{Electric Conductivity}$ or $\\textit{Specific Conductance}$ is a measure of a\n    material's ability to conduct an electric current. When an electrical potential difference is placed across a conductor, its\n    movable charges flow, giving rise to an electric current. The conductivity $\\sigma$ is defined as the ratio of the electric\n    current density $J$ to the electric field, $E$: $J = \\sigma E$. In isotropic materials, conductivity is scalar-valued,\n    however in general, conductivity is a tensor-valued quantity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DeciS-PER-M"},{"@id":"http://qudt.org/vocab/unit/KiloS-PER-M"},{"@id":"http://qudt.org/vocab/unit/MHO_Stat"},{"@id":"http://qudt.org/vocab/unit/MegaS-PER-M"},{"@id":"http://qudt.org/vocab/unit/MicroS-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/MicroS-PER-M"},{"@id":"http://qudt.org/vocab/unit/MilliS-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/MilliS-PER-M"},{"@id":"http://qudt.org/vocab/unit/NanoS-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/NanoS-PER-M"},{"@id":"http://qudt.org/vocab/unit/PicoS-PER-M"},{"@id":"http://qudt.org/vocab/unit/S-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/S-PER-M"},{"@id":"http://qudt.org/vocab/unit/S_Ab"},{"@id":"http://qudt.org/vocab/unit/S_Stat"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ329#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E2L-3I0M-1H0T3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD025","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-12-03","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD025","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mathbf{J} = \\sigma \\mathbf{E}$, where $\\mathbf{J}$ is electric current density, and $\\mathbf{E}$ is electric field strength.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\gamma$","@type":"http://qudt.org/schema/qudt/LatexString"},{"@value":"$\\sigma$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Electric Conductivity\" is a scalar or tensor quantity the product of which by the electric field\n    strength in a medium is equal to the electric current density. For an isotropic medium the conductivity is a scalar quantity;\n    for an anisotropic medium it is a tensor quantity.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricConductivity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Conductivity","@language":"en"},{"@value":"Kekonduksian elektrik","@language":"ms"},{"@value":"conducibilità elettrica","@language":"it"},{"@value":"conductividad eléctrica","@language":"es"},{"@value":"conductivité électrique","@language":"fr"},{"@value":"condutividade elétrica","@language":"pt"},{"@value":"elektrik iletkenliği","@language":"tr"},{"@value":"elektrische Leitfähigkeit","@language":"de"},{"@value":"električna prevodnost","@language":"sl"},{"@value":"رسانايى الکتريکى/هدایت الکتریکی","@language":"fa"},{"@value":"电导率","@language":"zh"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrent","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\n  The quantity kind $\\textit{Electric Current}$ is the flow (movement) of electric charge. \n  The amount of electric current through some surface, for example, a section through a copper conductor,\n   is defined as the amount of electric charge flowing through that surface over time. \n  Current is a scalar-valued quantity. \n  Electric current is one of the base quantities in the International System of Quantities, ISQ,\n   on which the International System of Units, SI, is based.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A"},{"@id":"http://qudt.org/vocab/unit/A_Ab"},{"@id":"http://qudt.org/vocab/unit/A_Stat"},{"@id":"http://qudt.org/vocab/unit/AttoA"},{"@id":"http://qudt.org/vocab/unit/BIOT"},{"@id":"http://qudt.org/vocab/unit/FemtoA"},{"@id":"http://qudt.org/vocab/unit/GigaA"},{"@id":"http://qudt.org/vocab/unit/KiloA"},{"@id":"http://qudt.org/vocab/unit/MegaA"},{"@id":"http://qudt.org/vocab/unit/MicroA"},{"@id":"http://qudt.org/vocab/unit/MilliA"},{"@id":"http://qudt.org/vocab/unit/NanoA"},{"@id":"http://qudt.org/vocab/unit/PetaA"},{"@id":"http://qudt.org/vocab/unit/PicoA"},{"@id":"http://qudt.org/vocab/unit/PlanckCurrent"},{"@id":"http://qudt.org/vocab/unit/TeraA"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Electric_current","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ268#006","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD039","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-13","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD039","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Electric Current\" is the flow (movement) of electric charge. The amount of electric current\n    through some surface, for example, a section through a copper conductor, is defined as the amount of electric charge flowing\n    through that surface over time. Current is a scalar-valued quantity. Electric current is one of the base quantities in the\n    International System of Quantities, ISQ, on which the International System of Units, SI, is based.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/ELCU"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"I","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q29996"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricCurrent","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Arus elektrik","@language":"ms"},{"@value":"Electric Current","@language":"en"},{"@value":"Elektrický proud","@language":"cs"},{"@value":"corrente elettrica","@language":"it"},{"@value":"corrente elétrica","@language":"pt"},{"@value":"corriente eléctrica","@language":"es"},{"@value":"curent electric","@language":"ro"},{"@value":"elektrik akımı","@language":"tr"},{"@value":"elektrische Stromstärke","@language":"de"},{"@value":"električni tok","@language":"sl"},{"@value":"elektromos áramerősség","@language":"hu"},{"@value":"fluxio electrica","@language":"la"},{"@value":"intensité de courant électrique","@language":"fr"},{"@value":"prąd elektryczny","@language":"pl"},{"@value":"Ένταση ηλεκτρικού ρεύματος","@language":"el"},{"@value":"Електрически ток","@language":"bg"},{"@value":"Сила электрического тока","@language":"ru"},{"@value":"זרם חשמלי","@language":"he"},{"@value":"تيار كهربائي","@language":"ar"},{"@value":"جریان الکتریکی","@language":"fa"},{"@value":"विद्युत धारा","@language":"hi"},{"@value":"电流","@language":"zh"},{"@value":"電流","@language":"ja"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Electric Current Density\" is a measure of the density of flow of electric charge; it is the electric\n    current per unit area of cross section. Electric current density is a vector-valued quantity. Electric current, $I$, through a\n    surface $S$ is defined as $I = \\int_S J \\cdot e_n dA$, where $e_ndA$ is the vector surface element.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/A-PER-M2"},{"@id":"http://qudt.org/vocab/unit/A-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/A_Ab-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/A_Stat-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloA-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MegaA-PER-M2"},{"@id":"http://qudt.org/vocab/unit/PlanckCurrentDensity"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Current_density","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ315#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD040","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://maxwells-equations.com/density/current.php","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD040","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$J = \\rho v$, where $\\rho$ is electric current density and $v$ is volume.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/CUDE"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q234072"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricCurrentDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Akım yoğunluğu","@language":"tr"},{"@value":"Densitate de curent","@language":"ro"},{"@value":"Electric Current Density","@language":"en"},{"@value":"Gęstość prądu elektrycznego","@language":"pl"},{"@value":"Hustota elektrického proudu","@language":"cs"},{"@value":"Ketumpatan arus elektrik","@language":"ms"},{"@value":"densidad de corriente","@language":"es"},{"@value":"densidade de corrente elétrica","@language":"pt"},{"@value":"densità di corrente elettrica","@language":"it"},{"@value":"densité de courant","@language":"fr"},{"@value":"elektrische Stromdichte","@language":"de"},{"@value":"gostota električnega toka","@language":"sl"},{"@value":"плотность тока","@language":"ru"},{"@value":"كثافة التيار","@language":"ar"},{"@value":"چگالی جریان الکتریکی","@language":"fa"},{"@value":"धारा घनत्व","@language":"hi"},{"@value":"电流密度","@language":"zh"},{"@value":"電流密度","@language":"ja"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"areic electric current","@language":"en"},{"@value":"keluasan arus elektrik","@language":"ms"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentImbalance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PERCENT"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Electric current imbalance is the percentage deviation of individual phase currents from the\n    average current across phases in a polyphase electrical system.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricCurrentImbalance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Current Imbalance","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPerAngle","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-PER-RAD"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T0D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricCurrentPerAngle","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Current per Angle","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPerEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-PER-J"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-2I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T0D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricCurrentPerEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Current per Energy","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPerLength","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/A-PER-M"},{"@id":"http://qudt.org/vocab/unit/A-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/KiloA-PER-M"},{"@id":"http://qudt.org/vocab/unit/MilliA-PER-IN"},{"@id":"http://qudt.org/vocab/unit/MilliA-PER-MilliM"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/LinearElectricCurrent"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/LinearElectricCurrentDensity"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearElectricCurrentDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Current per Length","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/LinearElectricCurrentDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPerTemperature","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Electric Current per Unit Temperature\" is used to express how a current is subject to temperature.\n    Originally used in Wien's Law to describe phenomena related to filaments. One use today is to express how a current generator\n    derates with temperature.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-PER-DEG_C"},{"@id":"http://qudt.org/vocab/unit/A-PER-K"},{"@id":"http://qudt.org/vocab/unit/KiloA-PER-K"},{"@id":"http://qudt.org/vocab/unit/MicroA-PER-K"},{"@id":"http://qudt.org/vocab/unit/MilliA-PER-K"},{"@id":"http://qudt.org/vocab/unit/NanoA-PER-K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H-1T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Electric Current per Temperature\" is used to express how a current is subject to temperature.\n    Originally used in Wien's Law to describe phenomena related to filaments. One use today is to express how a current generator\n    derates with temperature.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T0D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricCurrentPerTemperature","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Current per Temperature","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPhasor","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Electric Current Phasor\" is a representation of current as a sinusoidal integral quantity using a\n    complex quantity whose argument is equal to the initial phase and whose modulus is equal to the root-mean-square value. A\n    phasor is a constant complex number, usually expressed in exponential form, representing the complex amplitude (magnitude and\n    phase) of a sinusoidal function of time. Phasors are used by electrical engineers to simplify computations involving\n    sinusoids, where they can often reduce a differential equation problem to an algebraic one.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A"},{"@id":"http://qudt.org/vocab/unit/AttoA"},{"@id":"http://qudt.org/vocab/unit/FemtoA"},{"@id":"http://qudt.org/vocab/unit/GigaA"},{"@id":"http://qudt.org/vocab/unit/PetaA"},{"@id":"http://qudt.org/vocab/unit/TeraA"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-11-26","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Phasor_(electronics)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"When $i = \\hat{I} \\cos{(\\omega t + \\alpha)}$, where $i$ is the electric current, $\\omega$ is angular frequence, $t$ is time, and $\\alpha$ is initial phase, then $\\underline{I} = Ie^{ja}$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\underline{I}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrent"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Electric Current Phasor\" is a representation of current as a sinusoidal integral quantity using a\n    complex quantity whose argument is equal to the initial phase and whose modulus is equal to the root-mean-square value. A\n    phasor is a constant complex number, usually expressed in exponential form, representing the complex amplitude (magnitude and\n    phase) of a sinusoidal function of time. Phasors are used by electrical engineers to simplify computations involving\n    sinusoids, where they can often reduce a differential equation problem to an algebraic one.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q78514596"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricCurrentPhasor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Current Phasor","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrent"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricDipoleMoment","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Electric Dipole Moment\" is a measure of the separation of positive and negative electrical charges in a\n    system of (discrete or continuous) charges. It is a vector-valued quantity. If the system of charges is neutral, that is if\n    the sum of all charges is zero, then the dipole moment of the system is independent of the choice of a reference frame;\n    however in a non-neutral system, such as the dipole moment of a single proton, a dependence on the choice of reference point\n    arises. In such cases it is conventional to choose the reference point to be the center of mass of the system or the center of\n    charge, not some arbitrary origin. This convention ensures that the dipole moment is an intrinsic property of the system. The\n    electric dipole moment of a substance within a domain is the vector sum of electric dipole moments of all electric dipoles\n    included in the domain.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/C-M"},{"@id":"http://qudt.org/vocab/unit/DEBYE"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ236#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L1I0M0H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD041","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD041","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Electric_dipole_moment","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$E_p = -p \\cdot E$, where $E_p$ is the interaction energy of the molecule with electric dipole moment $p$ and an electric field with electric field strength $E$.\n\n$p = q(r_+ - r_i)$, where $r_+$ and $r_-$ are the position vectors to carriers of electric charge $a$ and $-q$, respectively.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Electric Dipole Moment\" is a measure of the separation of positive and negative electrical charges\n    in a system of (discrete or continuous) charges. It is a vector-valued quantity. If the system of charges is neutral, that is\n    if the sum of all charges is zero, then the dipole moment of the system is independent of the choice of a reference frame;\n    however in a non-neutral system, such as the dipole moment of a single proton, a dependence on the choice of reference point\n    arises. In such cases it is conventional to choose the reference point to be the center of mass of the system or the center of\n    charge, not some arbitrary origin. This convention ensures that the dipole moment is an intrinsic property of the system. The\n    electric dipole moment of a substance within a domain is the vector sum of electric dipole moments of all electric dipoles\n    included in the domain.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"p","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q735135"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricDipoleMoment","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dipólový moment","@language":"cs"},{"@value":"Electric Dipole Moment","@language":"en"},{"@value":"Momen dwikutub elektrik","@language":"ms"},{"@value":"elektrik dipol momenti","@language":"tr"},{"@value":"elektrisches Dipolmoment","@language":"de"},{"@value":"elektryczny moment dipolowy","@language":"pl"},{"@value":"moment dipolaire","@language":"fr"},{"@value":"moment electric dipolar","@language":"ro"},{"@value":"momento de dipolo eléctrico","@language":"es"},{"@value":"momento di dipolo elettrico","@language":"it"},{"@value":"momento do dipolo elétrico","@language":"pt"},{"@value":"Электрический дипольный момент","@language":"ru"},{"@value":"عزم ثنائي قطب","@language":"ar"},{"@value":"گشتاور دوقطبی الکتریکی","@language":"fa"},{"@value":"विद्युत द्विध्रुव आघूर्ण","@language":"hi"},{"@value":"电偶极矩","@language":"zh"},{"@value":"電気双極子","@language":"ja"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricDipoleMoment_CubicPerEnergy_Squared","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/CubicElectricDipoleMomentPerSquareEnergy"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E3L-3I0M-2H0T7D0"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Cubic Electric Dipole Moment per Square Energy","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricDipoleMoment_QuarticPerEnergy_Cubic","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/QuarticElectricDipoleMomentPerCubicEnergy"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E4L-2I0M-3H0T10D0"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Quartic Electric Dipole Moment per Cubic Energy","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricDisplacement","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In a dielectric material the presence of an electric field E causes the bound charges in the material\n    (atomic nuclei and their electrons) to slightly separate, inducing a local electric dipole moment. The Electric Displacement\n    Field, $D$, is a vector field that accounts for the effects of free charges within such dielectric materials. This describes\n    also the charge density on an extended surface that could be causing the field.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-HR-PER-M2"},{"@id":"http://qudt.org/vocab/unit/C-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/C-PER-M2"},{"@id":"http://qudt.org/vocab/unit/C-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/C_Ab-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/C_Stat-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MegaC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MicroC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MilliC-PER-M2"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricFluxDensity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.oxfordreference.com/view/10.1093/acref/9780199233991.001.0001/acref-9780199233991-e-895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$D = \\epsilon_0 E + P$, where $\\epsilon_0$ is the electric constant, $E$ is electric field strength, and $P$ is electric polarization.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerArea"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"D","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricChargePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Displacement","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricDisplacementField","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-HR-PER-M2"},{"@id":"http://qudt.org/vocab/unit/C-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/C-PER-M2"},{"@id":"http://qudt.org/vocab/unit/C-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/C_Ab-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/C_Stat-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MegaC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MicroC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MilliC-PER-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T1D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerArea"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"D","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q371907"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricChargePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Displacement Field","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Electric Energy\" is the energy transferred to or from an electrical circuit over a time interval. It is\n    the integral of electric power over time. In AC circuits it manifests in three specialised forms: active energy ($W_p$), which\n    represents energy convertible to other forms; apparent energy ($W_a = |\\underline{W}|$); and reactive energy ($W_q$), which\n    represents energy exchanged with reactive elements. Electric energy is commonly measured in watt-hours (Wh) or kilowatt-hours\n    (kWh).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AttoJ"},{"@id":"http://qudt.org/vocab/unit/ExaJ"},{"@id":"http://qudt.org/vocab/unit/FemtoJ"},{"@id":"http://qudt.org/vocab/unit/GigaJ"},{"@id":"http://qudt.org/vocab/unit/GigaW-HR"},{"@id":"http://qudt.org/vocab/unit/J"},{"@id":"http://qudt.org/vocab/unit/KiloJ"},{"@id":"http://qudt.org/vocab/unit/KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/MegaJ"},{"@id":"http://qudt.org/vocab/unit/MegaW-HR"},{"@id":"http://qudt.org/vocab/unit/MicroJ"},{"@id":"http://qudt.org/vocab/unit/MilliJ"},{"@id":"http://qudt.org/vocab/unit/NanoJ"},{"@id":"http://qudt.org/vocab/unit/PetaJ"},{"@id":"http://qudt.org/vocab/unit/PicoJ"},{"@id":"http://qudt.org/vocab/unit/TeraJ"},{"@id":"http://qudt.org/vocab/unit/TeraW-HR"},{"@id":"http://qudt.org/vocab/unit/W-HR"},{"@id":"http://qudt.org/vocab/unit/W-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Electric energy is the energy transferred to or from an electrical circuit over time. It is the\n    integral of electric power over time and is commonly measured in watt-hours (Wh) or kilowatt-hours (kWh).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"E_e","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q206799"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Energy","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ActiveEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/ApparentEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/ReactiveEnergy"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricField","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The space surrounding an electric charge or in the presence of a time-varying magnetic field has a\n    property called an electric field. This electric field exerts a force on other electrically charged objects. In the idealized\n    case, the force exerted between two point charges is inversely proportional to the square of the distance between them.\n    (Coulomb's Law).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/V-PER-M"},{"@id":"http://qudt.org/vocab/unit/V_Ab-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/V_Stat-PER-CentiM"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Electric_field","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$E$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L1I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Electric_field","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The space surrounding an electric charge or in the presence of a time-varying magnetic field has a\n    property called an electric field. This electric field exerts a force on other electrically charged objects. In the idealized\n    case, the force exerted between two point charges is inversely proportional to the square of the distance between them.\n    (Coulomb's Law).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricField","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Field","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricFieldStrength","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Electric Field Strength}$ is the magnitude and direction of an electric field, expressed by the\n    value of $E$, also referred to as $\\color{indigo} {\\textit{electric field intensity}}$ or simply the electric field.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloV-PER-M"},{"@id":"http://qudt.org/vocab/unit/MegaV-PER-M"},{"@id":"http://qudt.org/vocab/unit/MicroV-PER-M"},{"@id":"http://qudt.org/vocab/unit/MilliV-PER-M"},{"@id":"http://qudt.org/vocab/unit/V-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/V-PER-IN"},{"@id":"http://qudt.org/vocab/unit/V-PER-M"},{"@id":"http://qudt.org/vocab/unit/V-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/V_Ab-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/V_Stat-PER-CentiM"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ285#006","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L1I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD042","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD042","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mathbf{E} = \\mathbf{F}/q$, where $\\mathbf{F}$ is force and $q$ is electric charge, of a test particle at rest.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mathbf{E} $","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/ELFS"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"E","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q20989"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricFieldStrength","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Field Strength","@language":"en"},{"@value":"Elektromos mező","@language":"hu"},{"@value":"Kekuatan medan elektrik","@language":"ms"},{"@value":"câmp electric","@language":"ro"},{"@value":"elektrické pole","@language":"cs"},{"@value":"elektriksel alan kuvveti","@language":"tr"},{"@value":"elektrische Feldstärke","@language":"de"},{"@value":"intensidad de campo eléctrico","@language":"es"},{"@value":"intensidade de campo elétrico","@language":"pt"},{"@value":"intensità di campo elettrico","@language":"it"},{"@value":"intensité de champ électrique","@language":"fr"},{"@value":"jakost električnega polja","@language":"sl"},{"@value":"natężenie pola elektrycznego","@language":"pl"},{"@value":"Ηλεκτρικό πεδίο","@language":"el"},{"@value":"Електрично поле","@language":"bg"},{"@value":"Напряженность электрического поля","@language":"ru"},{"@value":"שדה חשמלי","@language":"he"},{"@value":"شدة المجال الكهربائي","@language":"ar"},{"@value":"شدت میدان الکتریکی","@language":"fa"},{"@value":"विद्युत्-क्षेत्र","@language":"hi"},{"@value":"電場","@language":"zh"},{"@value":"電界強度","@language":"ja"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricFlux","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Electric Flux\" through an area is defined as the electric field multiplied by the area of the surface\n    projected in a plane perpendicular to the field. Electric Flux is a scalar-valued quantity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/V-M"},{"@id":"http://qudt.org/vocab/unit/V_Stat-CentiM"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Electric_flux","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$electric-flux$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L3I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\Psi = \\int_S D \\cdot e_n dA$, over a surface $S$, where $D$ is electric flux density and $e_n dA$ is the vector surface element.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Psi$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Electric Flux\" through an area is defined as the electric field multiplied by the area of the\n    surface projected in a plane perpendicular to the field. Electric Flux is a scalar-valued quantity.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q501267"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricFlux","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Flux","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricFluxDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricFluxDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Electric Flux Density}$, also referred to as $\\textit{Electric Displacement}$, is related to\n    electric charge density by the following equation: $\\text{div} \\; D = \\rho$, where $\\text{div}$ denotes the divergence.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-HR-PER-M2"},{"@id":"http://qudt.org/vocab/unit/C-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/C-PER-M2"},{"@id":"http://qudt.org/vocab/unit/C-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/C_Ab-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/C_Stat-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MegaC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MicroC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MilliC-PER-M2"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Electric_flux","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricDisplacement"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD043","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD043","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mathbf{D}  = \\epsilon_0 E + P$, where $\\epsilon_0$ is the electric constant, $\\mathbf{E} $ is electric field strength, and $P$ is electric polarization.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mathbf{D}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/ELFD"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerArea"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricChargePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Densidad de flujo eléctrico","@language":"es"},{"@value":"Electric Flux Density","@language":"en"},{"@value":"Elektrická indukce","@language":"cs"},{"@value":"Induction électrique","@language":"fr"},{"@value":"Inducție electrică","@language":"ro"},{"@value":"Indukcja elektryczna","@language":"pl"},{"@value":"Ketumpatan fluks elektrik","@language":"ms"},{"@value":"campo de deslocamento elétrico","@language":"pt"},{"@value":"elektrik akı yoğunluğu","@language":"tr"},{"@value":"elektrische Flussdichte","@language":"de"},{"@value":"spostamento elettrico","@language":"it"},{"@value":"Электрическая индукция","@language":"ru"},{"@value":"إزاحة كهربائية","@language":"ar"},{"@value":"چگالی شار الکتریکی","@language":"fa"},{"@value":"電位移","@language":"zh"},{"@value":"電束密度","@language":"ja"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"anjakan","@language":"ms"},{"@value":"densité de flux électrique","@language":"fr"},{"@value":"displacement","@language":"en"},{"@value":"elektrische Induktion","@language":"de"},{"@value":"elektrische Verschiebung","@language":"de"},{"@value":"induzione elettrica","@language":"it"},{"@value":"yer değiştirme","@language":"tr"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPolarizability","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Electric Polarizability\" is the relative tendency of a charge distribution, like the electron cloud of\n    an atom or molecule, to be distorted from its normal shape by an external electric field, which is applied typically by\n    inserting the molecule in a charged parallel-plate capacitor, but may also be caused by the presence of a nearby ion or\n    dipole.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-MOL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Polarizability","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\alpha_{i,j} = \\frac{\\partial p_i}{\\partial E_j}$, where $p_i$ is the cartesian component along the $i-axis$ of the electric dipole moment induced by the applied electric field strength acting on the molecule, and $E_j$ is the component along the $j-axis$ of this electric field strength.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\alpha$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Electric Polarizability\" is the relative tendency of a charge distribution, like the electron\n    cloud of an atom or molecule, to be distorted from its normal shape by an external electric field, which is applied typically\n    by inserting the molecule in a charged parallel-plate capacitor, but may also be caused by the presence of a nearby ion or\n    dipole.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricPolarizability","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Polarizability","@language":"en"},{"@value":"Kepengkutuban elektrik","@language":"ms"},{"@value":"Kutuplanabilirlik","@language":"tr"},{"@value":"Polarisabilité","@language":"fr"},{"@value":"Polarizabilidad","@language":"es"},{"@value":"Polarizovatelnost","@language":"cs"},{"@value":"Polaryzowalność","@language":"pl"},{"@value":"elektrische Polarisierbarkeit","@language":"de"},{"@value":"polarizabilidade","@language":"pt"},{"@value":"polarizzabilità elettrica","@language":"it"},{"@value":"Поляризуемость","@language":"ru"},{"@value":"قابلية استقطاب","@language":"ar"},{"@value":"قطبیت پذیری الکتریکی","@language":"fa"},{"@value":"分極率","@language":"ja"},{"@value":"極化性","@language":"zh"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPolarization","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Electric Polarization\" is the relative shift of positive and negative electric charge in opposite\n    directions within an insulator, or dielectric, induced by an external electric field. Polarization occurs when an electric\n    field distorts the negative cloud of electrons around positive atomic nuclei in a direction opposite the field. This slight\n    separation of charge makes one side of the atom somewhat positive and the opposite side somewhat negative. In some materials\n    whose molecules are permanently polarized by chemical forces, such as water molecules, some of the polarization is caused by\n    molecules rotating into the same alignment under the influence of the electric field. One of the measures of polarization is\n    electric dipole moment, which equals the distance between the slightly shifted centres of positive and negative charge\n    multiplied by the amount of one of the charges. Polarization P in its quantitative meaning is the amount of dipole moment p\n    per unit volume V of a polarized material, P = p/V.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-HR-PER-M2"},{"@id":"http://qudt.org/vocab/unit/C-PER-M2"},{"@id":"http://qudt.org/vocab/unit/KiloC-PER-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD044","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.britannica.com/EBchecked/topic/182690/electric-polarization","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD044","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$P =\\frac{dp}{dV}$, where $p$ is electic charge density and $V$ is volume.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Electric Polarization\" is the relative shift of positive and negative electric charge in opposite\n    directions within an insulator, or dielectric, induced by an external electric field. Polarization occurs when an electric\n    field distorts the negative cloud of electrons around positive atomic nuclei in a direction opposite the field. This slight\n    separation of charge makes one side of the atom somewhat positive and the opposite side somewhat negative. In some materials\n    whose molecules are permanently polarized by chemical forces, such as water molecules, some of the polarization is caused by\n    molecules rotating into the same alignment under the influence of the electric field. One of the measures of polarization is\n    electric dipole moment, which equals the distance between the slightly shifted centres of positive and negative charge\n    multiplied by the amount of one of the charges. Polarization P in its quantitative meaning is the amount of dipole moment p\n    per unit volume V of a polarized material, P = p/V.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"P","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1050425"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricPolarization","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Polarization","@language":"en"},{"@value":"elektrische Polarisation","@language":"de"},{"@value":"polarisation électrique","@language":"fr"},{"@value":"polarización eléctrica","@language":"es"},{"@value":"polarização eléctrica","@language":"pt"},{"@value":"polarizzazione elettrica","@language":"it"},{"@value":"polaryzacja elektryczna","@language":"pl"},{"@value":"электрическая поляризация","@language":"ru"},{"@value":"إستقطاب كهربائي","@language":"ar"},{"@value":"電気分極","@language":"ja"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeDensity"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricDipoleMoment"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotential","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The Electric Potential is a scalar valued quantity associated with an electric field. The electric\n    potential $\\phi(x)$ at a point, $x$, is formally defined as the line integral of the electric field taken along a path from x\n    to the point at infinity. If the electric field is static, that is time independent, then the choice of the path is arbitrary;\n    however if the electric field is time dependent, taking the integral a different paths will produce different results.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ExaV"},{"@id":"http://qudt.org/vocab/unit/FemtoV"},{"@id":"http://qudt.org/vocab/unit/GigaV"},{"@id":"http://qudt.org/vocab/unit/KiloV"},{"@id":"http://qudt.org/vocab/unit/MegaV"},{"@id":"http://qudt.org/vocab/unit/MicroV"},{"@id":"http://qudt.org/vocab/unit/MilliV"},{"@id":"http://qudt.org/vocab/unit/NanoV"},{"@id":"http://qudt.org/vocab/unit/PetaV"},{"@id":"http://qudt.org/vocab/unit/PicoV"},{"@id":"http://qudt.org/vocab/unit/PlanckVolt"},{"@id":"http://qudt.org/vocab/unit/TeraV"},{"@id":"http://qudt.org/vocab/unit/V"},{"@id":"http://qudt.org/vocab/unit/V_Ab"},{"@id":"http://qudt.org/vocab/unit/V_Stat"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ210#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotentialDifference"},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerElectricCharge"},{"@id":"http://qudt.org/vocab/quantitykind/Voltage"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-25","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$-\\text{grad} \\; V = E + \\frac{\\partial A}{\\partial t}$, where $E$ is electric field strength, $A$ is magentic vector potential and $t$ is time.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\phi$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"V","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q55451"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricPotential","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Potential","@language":"en"},{"@value":"Keupayaan elektrik","@language":"ms"},{"@value":"elektrický potenciál","@language":"cs"},{"@value":"elektrik potansiyeli","@language":"tr"},{"@value":"elektrisches Potenzial","@language":"de"},{"@value":"električni potencial","@language":"sl"},{"@value":"elektromos feszültség , elektromos potenciálkülönbség","@language":"hu"},{"@value":"potencial eléctrico","@language":"es"},{"@value":"potencial elétrico","@language":"pt"},{"@value":"potencjał elektryczny","@language":"pl"},{"@value":"potentiel électrique","@language":"fr"},{"@value":"potenziale elettrico","@language":"it"},{"@value":"potențial electric","@language":"ro"},{"@value":"tensio electrica","@language":"la"},{"@value":"Електрически потенциал","@language":"bg"},{"@value":"электростатический потенциал","@language":"ru"},{"@value":"מתח חשמלי (הפרש פוטנציאלים)","@language":"he"},{"@value":"كمون كهربائي","@language":"ar"},{"@value":"پتانسیل الکتریکی","@language":"fa"},{"@value":"विद्युत विभव","@language":"hi"},{"@value":"電位","@language":"ja"},{"@value":"電勢","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"vis electromotrix","@language":"la"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotentialDifference","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Electric Potential Difference\" is a scalar valued quantity associated with an electric field.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ExaV"},{"@id":"http://qudt.org/vocab/unit/FemtoV"},{"@id":"http://qudt.org/vocab/unit/GigaV"},{"@id":"http://qudt.org/vocab/unit/KiloV"},{"@id":"http://qudt.org/vocab/unit/MegaV"},{"@id":"http://qudt.org/vocab/unit/MicroV"},{"@id":"http://qudt.org/vocab/unit/MilliV"},{"@id":"http://qudt.org/vocab/unit/NanoV"},{"@id":"http://qudt.org/vocab/unit/PetaV"},{"@id":"http://qudt.org/vocab/unit/PicoV"},{"@id":"http://qudt.org/vocab/unit/PlanckVolt"},{"@id":"http://qudt.org/vocab/unit/TeraV"},{"@id":"http://qudt.org/vocab/unit/V"},{"@id":"http://qudt.org/vocab/unit/V_Ab"},{"@id":"http://qudt.org/vocab/unit/V_Stat"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotential"},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerElectricCharge"},{"@id":"http://qudt.org/vocab/quantitykind/Voltage"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD237","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-26","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD237","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$V_{ab} = \\int_{r_a(C)}^{r_b} (E +\\frac{\\partial A}{\\partial t}) $, where $E$ is electric field strength, $A$ is magentic vector potential,  $t$ is time, and $r$ is position vector along a curve C from a point $a$ to $b$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Electric Potential Difference\" is a scalar valued quantity associated with an electric field.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/ELPD"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"V_{ab}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q77597807"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricPotentialDifference","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Potential Difference","@language":"en"},{"@value":"Voltan Perbezaan keupayaan elektrik","@language":"ms"},{"@value":"diferență de potențial electric","@language":"ro"},{"@value":"differenza di potenziale elettrico","@language":"it"},{"@value":"elektrické napětí","@language":"cs"},{"@value":"elektrische Spannung","@language":"de"},{"@value":"električna napetost","@language":"sl"},{"@value":"gerilim","@language":"tr"},{"@value":"napięcie elektryczne","@language":"pl"},{"@value":"tension électrique","@language":"fr"},{"@value":"tensión eléctrica","@language":"es"},{"@value":"tensão elétrica (diferença de potencial)","@language":"pt"},{"@value":"электрическое напряжение","@language":"ru"},{"@value":"جهد كهربائي","@language":"ar"},{"@value":"ولتاژ/ اختلاف پتانسیل","@language":"fa"},{"@value":"विभवांतर","@language":"hi"},{"@value":"電圧","@language":"ja"},{"@value":"電壓","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"ketegangan","@language":"ms"},{"@value":"tension","@language":"en"},{"@value":"tensione elettrica","@language":"it"},{"@value":"tensiune","@language":"ro"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPower","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Electric Power\" is the rate at which electrical energy is transferred by an electric circuit. In the\n    simple case of direct current circuits, electric power can be calculated as the product of the potential difference in the\n    circuit (V) and the amount of current flowing in the circuit (I): $P = VI$, where $P$ is the power, $V$ is the potential\n    difference, and $I$ is the current. However, in general electric power is calculated by taking the integral of the vector\n    cross-product of the electrical and magnetic fields over a specified area.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSIUnit":[{"@id":"http://qudt.org/vocab/unit/KiloW"},{"@id":"http://qudt.org/vocab/unit/MegaW"},{"@id":"http://qudt.org/vocab/unit/MilliW"},{"@id":"http://qudt.org/vocab/unit/W"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ExaW"},{"@id":"http://qudt.org/vocab/unit/GigaW"},{"@id":"http://qudt.org/vocab/unit/KiloW"},{"@id":"http://qudt.org/vocab/unit/MegaW"},{"@id":"http://qudt.org/vocab/unit/MicroW"},{"@id":"http://qudt.org/vocab/unit/MilliW"},{"@id":"http://qudt.org/vocab/unit/NanoW"},{"@id":"http://qudt.org/vocab/unit/PetaW"},{"@id":"http://qudt.org/vocab/unit/PicoW"},{"@id":"http://qudt.org/vocab/unit/TeraJ-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/TeraW"},{"@id":"http://qudt.org/vocab/unit/W"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$p = ui$, where $u$ is instantaneous voltage and $i$ is instantaneous electric current.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"P_E","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q27137"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricPower","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Power","@language":"en"},{"@value":"Elektrische Leistung","@language":"de"},{"@value":"moc elektryczna","@language":"pl"},{"@value":"potencia eléctrica","@language":"es"},{"@value":"potenza elettrica","@language":"it"},{"@value":"potência elétrica","@language":"pt"},{"@value":"puissance électrique","@language":"fr"},{"@value":"القدرة الكهربائية","@language":"ar"},{"@value":"电功率","@language":"zh"},{"@value":"電力","@language":"ja"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricQuadrupoleMoment","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The Electric Quadrupole Moment is a quantity which describes the effective shape of the ellipsoid of\n    nuclear charge distribution. A non-zero quadrupole moment Q indicates that the charge distribution is not spherically\n    symmetric. By convention, the value of Q is taken to be positive if the ellipsoid is prolate and negative if it is oblate. In\n    general, the electric quadrupole moment is tensor-valued.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/C-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L2I0M0H0T1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The Electric Quadrupole Moment is a quantity which describes the effective shape of the ellipsoid\n    of nuclear charge distribution. A non-zero quadrupole moment Q indicates that the charge distribution is not spherically\n    symmetric. By convention, the value of Q is taken to be positive if the ellipsoid is prolate and negative if it is oblate. In\n    general, the electric quadrupole moment is tensor-valued.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Q","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricQuadrupoleMoment","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Quadrupole Moment","@language":"en"},{"@value":"Momen kuadrupol elektrik","@language":"ms"},{"@value":"elektrik kuadrupol momenti","@language":"tr"},{"@value":"elektrisches Quadrupolmoment","@language":"de"},{"@value":"elektryczny moment kwadrupolowy","@language":"pl"},{"@value":"moment quadrupolaire électrique","@language":"fr"},{"@value":"momento de cuadrupolo eléctrico","@language":"es"},{"@value":"momento de quadrupolo elétrico","@language":"pt"},{"@value":"momento di quadrupolo elettrico","@language":"it"},{"@value":"Электрический квадрупольный момент","@language":"ru"},{"@value":"گشتاور چهار قطبی الکتریکی","@language":"fa"},{"@value":"四極子","@language":"ja"},{"@value":"电四极矩","@language":"zh"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricSusceptibility","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Electric Susceptibility\" is the ratio of electric polarization to electric field strength, normalized to\n    the electric constant. The definition applies to an isotropic medium. For an anisotropic medium, electric susceptibility is a\n    second order tensor.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/SUSCEPTIBILITY_ELEC"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Permittivity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$e-susceptibility$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\chi = \\frac{P}{(\\epsilon_0 E)}$, where $P$ is electric polorization, $\\epsilon_0$ is the electric constant, and $E$ is electric field strength.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\chi$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Electric Susceptibility\" is the ratio of electric polarization to electric field strength,\n    normalized to the electric constant. The definition applies to an isotropic medium. For an anisotropic medium, electric\n    susceptibility is a second order tensor.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q598305"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricSusceptibility","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electric Susceptibility","@language":"en"},{"@value":"elektrische Suszeptibilität","@language":"de"},{"@value":"podatność elektryczna","@language":"pl"},{"@value":"susceptibilidad eléctrica","@language":"es"},{"@value":"susceptibilidade eléctrica","@language":"pt"},{"@value":"susceptibilité électrique","@language":"fr"},{"@value":"suscettività elettrica","@language":"it"},{"@value":"электрическая восприимчивость","@language":"ru"},{"@value":"المتأثرية الكهربائية، سرعة التأثر الكهربائية","@language":"ar"},{"@value":"電気感受率","@language":"ja"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricFieldStrength"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPolarization"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"susceptywność elektryczna","@language":"pl"},{"@value":"диэлектрическая восприимчивость","@language":"ru"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricalConductance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"measure of the capability of a material to conduct electric current, the value of which is defined as the\n    reciprocal of the electrical resistance\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DeciS"},{"@id":"http://qudt.org/vocab/unit/KiloS"},{"@id":"http://qudt.org/vocab/unit/MHO"},{"@id":"http://qudt.org/vocab/unit/MegaS"},{"@id":"http://qudt.org/vocab/unit/MicroMHO"},{"@id":"http://qudt.org/vocab/unit/MicroS"},{"@id":"http://qudt.org/vocab/unit/MilliS"},{"@id":"http://qudt.org/vocab/unit/NanoS"},{"@id":"http://qudt.org/vocab/unit/PicoS"},{"@id":"http://qudt.org/vocab/unit/S"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ223#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/Conductance"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E2L-2I0M-1H0T3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD038","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD038","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Maß für die Fähigkeit eines Stoffes, den elektrischen Strom zu leiten, das wertmäßig definiert ist\n    als Kehrwert des elektrischen Widerstandes\n  ","@language":"de"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/ELCO"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricalConductance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electrical Conductance","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricalPowerToMassRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ERG-PER-GM-SEC"},{"@id":"http://qudt.org/vocab/unit/MilliW-PER-MilliGM"},{"@id":"http://qudt.org/vocab/unit/W-PER-GM"},{"@id":"http://qudt.org/vocab/unit/W-PER-KiloGM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-3D0"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\xi$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificPower"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SpecificPower","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electrical Power to Mass Ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificPower"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectricalResistance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"different properties of materials which impede the electrical current in its movement when the free\n    charged particles in these materials are set in motion by electrical fields and/or electrical potentials\n  ","@language":"en"},{"@value":"unterschiedlich ausgeprägte Eigenschaft von Stoffen, den elektrischen Strom in seiner Bewegung zu hemmen,\n    wenn die freien Ladungsträger in diesen Stoffen durch elektrische Felder und/oder elektrische Potentiale in Bewegung gesetzt\n    werden\n  ","@language":"de"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/NanoOHM"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ215#006","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-2L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD045","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD045","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/ELRE"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricalResistance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electrical Resistance","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectrolyticConductivity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Electrolytic Conductivity\" of an electrolyte solution is a measure of its ability to conduct\n    electricity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MicroS-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/S-PER-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E2L-3I0M-1H0T3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Conductivity_(electrolytic)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$x = \\frac{J}{E}$, where $J$ is the electrolytic current density and $E$ is the electric field strength.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Electrolytic Conductivity\" of an electrolyte solution is a measure of its ability to conduct\n    electricity.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"x","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q907564"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectrolyticConductivity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electrolytic Conductivity","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectromagneticEnergyDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Electromagnetic Energy Density}$, also known as the $\\color{indigo} {\\text{Volumic\n    Electromagnetic Energy}}$, is the energy associated with an electromagnetic field, per unit volume of the field.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-M3"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/VolumicElectromagneticEnergy"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-64","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$w = (1/2) ( \\mathbf{E} \\cdot \\mathbf{D} + \\mathbf{B} \\cdot \\mathbf{H})$, where $\\mathbf{E}$ is electric field strength, $\\mathbf{D}$ is electric flux density, $\\mathbf{M}$ is magnetic flux density, and $\\mathbf{H}$ is magnetic field strength.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyDensity"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"w","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q77989624"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectromagneticEnergyDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electromagnetic Energy Density","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricFieldStrength"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricFluxDensity"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFieldStrength"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensity"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectromagneticPermeability","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Permeability}$ is the degree of magnetization of a material that responds linearly to an\n    applied magnetic field. In general permeability is a tensor-valued quantity. The definition given applies to an isotropic\n    medium. For an anisotropic medium permeability is a second order tensor. In electromagnetism, permeability is the measure of\n    the ability of a material to support the formation of a magnetic field within itself. In other words, it is the degree of\n    magnetization that a material obtains in response to an applied magnetic field. Magnetic permeability is typically represented\n    by the Greek letter $\\mu$. The term was coined in September, 1885 by Oliver Heaviside. The reciprocal of magnetic\n    permeability is $\\textit{Magnetic Reluctivity}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/H-PER-M"},{"@id":"http://qudt.org/vocab/unit/H_Stat-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/MicroH-PER-M"},{"@id":"http://qudt.org/vocab/unit/NanoH-PER-M"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Permeability","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ362#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/Permeability"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-2L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Permeability_(electromagnetism)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mu = \\frac{B}{H}$,  where $B$ is magnetic flux density,  and $H$ is magnetic field strength.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mu$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q28352"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectromagneticPermeability","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Permeability","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/constant/ElectromagneticPermeabilityOfVacuum"},{"@id":"http://qudt.org/vocab/constant/MagneticConstant"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFieldStrength"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectromagneticPermeabilityRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Electromagnetic Permeability Ratio}$ is the ratio of the electromagnetic permeability of a\n    specific medium to the electromagnetic permeability of free space.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PERMEABILITY_EM_REL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The ratio of the electromagnetic permeability of a specific medium to the electromagnetic\n    permeability of free space.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-2L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-2L1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q77785645"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectromagneticPermeabilityRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electromagnetic Permeability Ratio","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectromagneticWavePhaseSpeed","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\n  $\\textit{Electromagnetic Wave Phase Speed}$ is the ratio of angular velocity and wavenumber.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/IN-PER-YR"},{"@id":"http://qudt.org/vocab/unit/M-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MicroM-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MicroM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/YD-PER-HR"},{"@id":"http://qudt.org/vocab/unit/YD-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/YD-PER-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-66","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$c  = w/k$ where $w$ is angular velocity and $k$ is angular wavenumber.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Speed"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Electromagnetic Wave Phase Speed\" is the ratio of angular velocity and wavenumber.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"c","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectromagneticWavePhaseSpeed","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electromagnetic Wave Phase Speed","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Speed"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectromotiveForce","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In physics, $\\textit{Electromotive Force}$, or most commonly $emf$ (seldom capitalized), or\n    (occasionally) electromotance is that which tends to cause current (actual electrons and ions) to flow. More formally, $emf$\n    is the external work expended per unit of charge to produce an electric potential difference across two open-circuited\n    terminals. $\\textit{Electromotive Force}$ is deprecated in the ISO System of Quantities.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ExaV"},{"@id":"http://qudt.org/vocab/unit/FemtoV"},{"@id":"http://qudt.org/vocab/unit/GigaV"},{"@id":"http://qudt.org/vocab/unit/KiloV"},{"@id":"http://qudt.org/vocab/unit/MegaV"},{"@id":"http://qudt.org/vocab/unit/MicroV"},{"@id":"http://qudt.org/vocab/unit/MilliV"},{"@id":"http://qudt.org/vocab/unit/NanoV"},{"@id":"http://qudt.org/vocab/unit/PetaV"},{"@id":"http://qudt.org/vocab/unit/PicoV"},{"@id":"http://qudt.org/vocab/unit/PlanckVolt"},{"@id":"http://qudt.org/vocab/unit/TeraV"},{"@id":"http://qudt.org/vocab/unit/V"},{"@id":"http://qudt.org/vocab/unit/V_Ab"},{"@id":"http://qudt.org/vocab/unit/V_Stat"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Electromotive_force","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotential"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotentialDifference"},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerElectricCharge"},{"@id":"http://qudt.org/vocab/quantitykind/Voltage"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"E","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q185329"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricPotential","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:ElectricPotentialDifference","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:EnergyPerElectricCharge","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:Voltage","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Daya gerak elektrik","@language":"ms"},{"@value":"Electromotive Force","@language":"en"},{"@value":"Elektromotor kuvvet","@language":"tr"},{"@value":"Elektromotorické napětí","@language":"cs"},{"@value":"elektromotorische Kraft","@language":"de"},{"@value":"elektromotorna sila","@language":"sl"},{"@value":"force électromotrice","@language":"fr"},{"@value":"forza elettromotrice","@language":"it"},{"@value":"força eletromotriz","@language":"pt"},{"@value":"forță electromotoare","@language":"ro"},{"@value":"fuerza electromotriz","@language":"es"},{"@value":"siła elektromotoryczna","@language":"pl"},{"@value":"электродвижущая сила","@language":"ru"},{"@value":"قوة محركة كهربائية","@language":"ar"},{"@value":"نیروی محرک الکتریکی","@language":"fa"},{"@value":"विद्युतवाहक बल","@language":"hi"},{"@value":"起電力","@language":"ja"},{"@value":"電動勢","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotential"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotentialDifference"},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerElectricCharge"},{"@id":"http://qudt.org/vocab/quantitykind/Voltage"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectronAffinity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Electron Affinity}$ is the energy difference between an electron at rest at infinity and an\n    electron at the lowest level of the conduction band in an insulator or semiconductor. The amount of energy released when an\n    electron is added to a neutral atom or molecule to form a negative ion.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AttoJ"},{"@id":"http://qudt.org/vocab/unit/BTU_IT"},{"@id":"http://qudt.org/vocab/unit/BTU_TH"},{"@id":"http://qudt.org/vocab/unit/CAL_IT"},{"@id":"http://qudt.org/vocab/unit/CAL_TH"},{"@id":"http://qudt.org/vocab/unit/ERG"},{"@id":"http://qudt.org/vocab/unit/EV"},{"@id":"http://qudt.org/vocab/unit/E_h"},{"@id"