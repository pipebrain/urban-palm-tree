ing"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electron Mobility","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Mobility"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElectronRadius","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Electron Radius}$, also known as the Lorentz radius or the Thomson scattering length, is based\n    on a classical (i.e., non-quantum) relativistic model of the electron.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ANGSTROM"},{"@id":"http://qudt.org/vocab/unit/AU"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB_F"},{"@id":"http://qudt.org/vocab/unit/CHAIN"},{"@id":"http://qudt.org/vocab/unit/CHAIN_US"},{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/DecaM"},{"@id":"http://qudt.org/vocab/unit/DeciM"},{"@id":"http://qudt.org/vocab/unit/FATH"},{"@id":"http://qudt.org/vocab/unit/FM"},{"@id":"http://qudt.org/vocab/unit/FT"},{"@id":"http://qudt.org/vocab/unit/FT_US"},{"@id":"http://qudt.org/vocab/unit/FUR"},{"@id":"http://qudt.org/vocab/unit/FemtoM"},{"@id":"http://qudt.org/vocab/unit/GAUGE_FR"},{"@id":"http://qudt.org/vocab/unit/GA_Charriere"},{"@id":"http://qudt.org/vocab/unit/HectoM"},{"@id":"http://qudt.org/vocab/unit/IN"},{"@id":"http://qudt.org/vocab/unit/KiloM"},{"@id":"http://qudt.org/vocab/unit/LY"},{"@id":"http://qudt.org/vocab/unit/M"},{"@id":"http://qudt.org/vocab/unit/MI"},{"@id":"http://qudt.org/vocab/unit/MI_N"},{"@id":"http://qudt.org/vocab/unit/MI_UK"},{"@id":"http://qudt.org/vocab/unit/MI_US"},{"@id":"http://qudt.org/vocab/unit/MicroIN"},{"@id":"http://qudt.org/vocab/unit/MicroM"},{"@id":"http://qudt.org/vocab/unit/MilLength"},{"@id":"http://qudt.org/vocab/unit/MilliIN"},{"@id":"http://qudt.org/vocab/unit/MilliM"},{"@id":"http://qudt.org/vocab/unit/NanoM"},{"@id":"http://qudt.org/vocab/unit/PARSEC"},{"@id":"http://qudt.org/vocab/unit/PCA"},{"@id":"http://qudt.org/vocab/unit/PT"},{"@id":"http://qudt.org/vocab/unit/PicoM"},{"@id":"http://qudt.org/vocab/unit/PlanckLength"},{"@id":"http://qudt.org/vocab/unit/ROD"},{"@id":"http://qudt.org/vocab/unit/YD"},{"@id":"http://qudt.org/vocab/unit/ZOLL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Classical_electron_radius","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$r_e = \\frac{e^2}{4\\pi m_e c_0^2}$, where $e$ is the elementary charge, $\\varepsilon_0$ is the electric constant, item $m_e$ is the rest mass of electrons, and $c_0$ is the speed of light in vacuum.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Electron Radius\", also known as the Lorentz radius or the Thomson scattering length, is based on a\n    classical (i.e., non-quantum) relativistic model of the electron.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"r_e","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Electron Radius","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}]},{"@id":"http://qudt.org/vocab/quantitykind/ElevationRelativeToNAP","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Height measurement relative to the Normaal Amsterdams Peil (NAP) (en: Amsterdam Ordnance System).\n    Being a form of gravity related height\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Altitude"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"mNAP","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElevationRelativeToNAP","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Height measurement relative to the Normaal Amsterdams Peil (NAP) (en: Amsterdam Ordnance System). Being a form\n    of gravity related height\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Elevation Relative to NAP","@language":"en"},{"@value":"Hoogte ten opzichte van NAP","@language":"nl"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Altitude"}],"http://www.w3.org/2004/02/skos/core#prefLabel":[{"@value":"Elevation relative to NAP","@language":"en"},{"@value":"Hoogte ten opzichte van NAP","@language":"nl"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"https://www.opengis.net/def/crs/EPSG/0/5709"}],"http://www.w3.org/ns/prov#wasInfluencedBy":[{"@id":"https://epsg.io/5709"}]},{"@id":"http://qudt.org/vocab/quantitykind/Emissivity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Emissivity of a material (usually written $\\varepsilon$ or e) is the relative ability of its surface to\n    emit energy by radiation.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Emissivity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\varepsilon = \\frac{M}{M_b}$, where $M$ is the radiant exitance of a thermal radiator and $M_b$ is the radiant exitance of a blackbody at the same temperature.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\varepsilon$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q899670"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Emissivity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Emissivity","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Energy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Energy is the quantity characterizing the ability of a system to do work.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUni