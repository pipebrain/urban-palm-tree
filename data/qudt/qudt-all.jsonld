quare Meter","@language":"en-us"},{"@value":"Watt Second per Square Metre","@language":"en"},{"@value":"Watt Second per Square Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Watt Seconde par Mètre Carré","@language":"fr"},{"@value":"Watt Secondo per Metro Quadrato","@language":"it"},{"@value":"Watt Secundă pe Metru Pătrat","@language":"ro"},{"@value":"Watt Segundo por Metro Quadrado","@language":"pt"},{"@value":"Watt Sekunda na Kvadratni Meter","@language":"sl"},{"@value":"Watt Sekunda na Čtvereční Metr","@language":"cs"},{"@value":"Watt Sekunde pro Quadratmeter","@language":"de"},{"@value":"Wattium Secundum per Metrum Quadratum","@language":"la"},{"@value":"Βατ Δευτερόλεπτο ανά Τετραγωνικό Μέτρο","@language":"el"},{"@value":"Ват Секунда на Квадратен Метър","@language":"bg"},{"@value":"Ватт Секунда на Квадратный Метр","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/WB","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The SI unit of magnetic flux. \"Flux\" is the rate (per unit of time) at which something crosses a surface\n    perpendicular to the flow. The weber is a large unit, equal to $10^{8}$ maxwells, and practical fluxes are usually fractions\n    of one weber. The weber is the magnetic flux which, linking a circuit of one turn, would produce in it an electromotive force\n    of 1 volt if it were reduced to zero at a uniform rate in 1 second. In SI base units, the dimensions of the weber are $(kg\n    \\cdot m^2)/(s^2 \\cdot A)$. The weber is commonly expressed in terms of other derived units as the Tesla-square meter ($T\n    \\cdot m^2$), volt-seconds ($V \\cdot s$), or joules per ampere ($J/A$).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Weber","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-5269"},{"@id":"_:n3-5270"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticFlux"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/A-PER-J"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA317","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA317","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Weber_(unit)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/weber"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/SI/units/weber"}],"http://qudt.org/schema/qudt/siUnitsExpression":[{"@value":"V.s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Wb","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Wb","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/udunitsCode":[{"@value":"Wb","@type"