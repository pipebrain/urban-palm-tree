veReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB323","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m³/Pa","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m3.Pa-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"M71","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/PressureBasedVolume"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Cubic Meter per Pascal","@language":"en-us"},{"@value":"Cubic Metre per Pascal","@language":"en"},{"@value":"Cubic Metre per Pascal","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Kubikmeter pro Pascal","@language":"de"},{"@value":"Kubični Meter na Pascal","@language":"sl"},{"@value":"Meter Kubik per Pascal","@language":"ms"},{"@value":"Metr Krychlový na Pascal","@language":"cs"},{"@value":"Metr Sześcienny na Paskal","@language":"pl"},{"@value":"Metreküp per Pascal","@language":"tr"},{"@value":"Metro Cubo per Pascal","@language":"it"},{"@value":"Metro Cúbico por Pascal","@language":"es"},{"@value":"Metro Cúbico por Pascal","@language":"pt"},{"@value":"Metru Cub pe Pascal","@language":"ro"},{"@value":"Metrum Cubicum per Pascalium","@language":"la"},{"@value":"Mètre Cube par Pascal","@language":"fr"},{"@value":"Κυβικό Μέτρο ανά Πασκάλ","@language":"el"},{"@value":"Кубичен Метър на Паскал","@language":"bg"},{"@value":"Кубический Метр на Паскаль","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/M3-PER-SEC","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A cubic metre per second ($m^{3}s^{-1}, m^{3}/s$), cumecs or cubic meter per second in American English)\n    is a derived SI unit of flow rate equal to that of a stere or cube with sides of one metre ( u0303 39.37 in) in length\n    exchanged or moving each second. It is popularly used for water flow, especially in rivers and streams, and fractions for HVAC\n    values measuring air flow.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$m^{3}/s$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-3030"},{"@id":"_:n3-3031"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/RecombinationCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/VolumePerTime"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA772","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA772","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m³/s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@