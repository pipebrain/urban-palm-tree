/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AreaPerLength"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/M-PER-M2"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"square metre divided by metre: plain text description in English","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m²/m","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m2.m-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AreaPerLength"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Kvadratni Meter na Meter","@language":"sl"},{"@value":"Meter Persegi per Meter","@language":"ms"},{"@value":"Metr Kwadratowy na Metr","@language":"pl"},{"@value":"Metrekare per Metre","@language":"tr"},{"@value":"Metro Cuadrado por Metro","@language":"es"},{"@value":"Metro Quadrado por Metro","@language":"pt"},{"@value":"Metro Quadrato per Metro","@language":"it"},{"@value":"Metru Pătrat pe Metru","@language":"ro"},{"@value":"Metrum Quadratum per Metrum","@language":"la"},{"@value":"Mètre Carré par Mètre","@language":"fr"},{"@value":"Quadratmeter pro Meter","@language":"de"},{"@value":"Square Meter per Meter","@language":"en-us"},{"@value":"Square Metre per Metre","@language":"en"},{"@value":"Square Metre per Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Čtvereční Metr na Metr","@language":"cs"},{"@value":"Τετραγωνικό Μέτρο ανά Μέτρο","@language":"el"},{"@value":"Квадратен Метър на Метър","@language":"bg"},{"@value":"Квадратный Метр на Метр","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/M2-PER-M2","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A square metre unit of area per square metre","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2941"},{"@id":"_:n3-2942"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AreaRatio"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/SR"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A square metre unit of area per square metre","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m²/m²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m2.m-2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AreaRatio"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Kvadratni Meter na Kvadratni Meter","@language":"sl"},{"@value":"Meter Persegi per Meter Persegi","@language":"ms"},{"@value":"Metr Kwadratowy na Metr Kwadratowy","@language":"pl"},{"@value":"Metrekare per Metrekare","@language":"tr"},{"@value":"Metro Cuadrado por Metro Cuadrado","@language":"es"},{"@value":"Metro Quadrado por Metro Quadrado","@language":"pt"},{"@value":"Metro Quadrato per Metro Quadrato","@language":"it"},{"@value":"Metru Pătrat pe Metru Pătrat","@language":"ro"},{"@value":"Metrum Quadratum per Metrum Quadratum","@language":"la"},{"@value":"Mètre Carré par Mètre Carré","@language":"fr"},{"@value":"Quadratmeter pro Quadratmeter","@language":"de"},{"@value":"Square Meter per Square Meter","@language":"en-us"},{"@value":"Square Metre per Square Metre","@language":"en"},{"@value":"Square Metre per Square Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Čtvereční Metr na Čtvereční Metr","@language":"cs"},{"@value":"Τετραγωνικό Μέτρο ανά Τετραγωνικό Μέτρο","@language":"el"},{"@value":"Квадратен Метър на Квадратен Метър","@language":"bg"},{"@value":"Квадратный Метр на Квадратный Метр","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/M2-PER-MOL","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Square Meter Per Mole (m2/mol) is a unit in the category of Specific Area. It is also known as square\n    meters per mole, square metre per per, square metres per per, square meter/per, square metre/per. This unit is commonly used\n    in the SI unit system. Square Meter Per Mole (m2/mol) has a dimension of M-1L2 where $M$ is mass, and $L$ is length. This unit\n    is the standard SI unit in this category.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$m^2/mol$","@type":"http://qudt.org/schema/qudt/LatexString"},{"@value":"$m^{2}/mol$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2943"},{"@id":"_:n3-2944"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MolarAbsorptionCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/MolarAttenuationCoefficient"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/MOL-PER-M2"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA751","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA751","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m²/mol","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m2.mol-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"D22","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MolarAbsorptionCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/MolarAttenuationCoefficient"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q86203731"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Kvadratni Meter na Mol","@language":"sl"},{"@value":"Meter Persegi per Mole","@language":"ms"},{"@value":"Metr Kwadratowy na Mol","@language":"pl"},{"@value":"Metrekare per Mol","@language":"tr"},{"@value":"Metro Cuadrado por Mol","@language":"es"},{"@value":"Metro Quadrado por Mol","@language":"pt"},{"@value":"Metro Quadrato per Mole","@language":"it"},{"@value":"Metru Pătrat pe Mol","@language":"ro"},{"@value":"Metrum Quadratum per Moles","@language":"la"},{"@value":"Mètre Carré par Mole","@language":"fr"},{"@value":"Quadratmeter pro Mol","@language":"de"},{"@value":"Square Meter per Mole","@language":"en-us"},{"@value":"Square Metre per Mole","@language":"en"},{"@value":"Square Metre per Mole","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Čtvereční Metr na Mol","@language":"cs"},{"@value":"Τετραγωνικό Μέτρο ανά Μολ","@language":"el"},{"@value":"Квадратен Метър на Мол","@language":"bg"},{"@value":"Квадратный Метр на Моль","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/M2-PER-N","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"power of the SI base unit metre with the exponent 2 divided by the derived SI unit newton","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2945"},{"@id":"_:n3-2946"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Compressibility"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/N-PER-M2"},{"@id":"http://qudt.org/vocab/unit/PA"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB492","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB492","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"power of the SI base unit metre with the exponent 2 divided by the derived SI unit newton","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m²/N","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m2.N-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"H59","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Compressibility"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Kvadratni Meter na Newton","@language":"sl"},{"@value":"Meter Persegi per Newton","@language":"ms"},{"@value":"Metr Kwadratowy na Niuton","@language":"pl"},{"@value":"Metrekare per Newton","@language":"tr"},{"@value":"Metro Cuadrado por Newton","@language":"es"},{"@value":"Metro Quadrado por Newton","@language":"pt"},{"@value":"Metro Quadrato per Newton","@language":"it"},{"@value":"Metru Pătrat pe Newton","@language":"ro"},{"@value":"Metrum Quadratum per Newtonium","@language":"la"},{"@value":"Mètre Carré par Newton","@language":"fr"},{"@value":"Quadratmeter pro Newton","@language":"de"},{"@value":"Square Meter per Newton","@language":"en-us"},{"@value":"Square Metre per Newton","@language":"en"},{"@value":"Square Metre per Newton","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Čtvereční Metr na Newton","@language":"cs"},{"@value":"Τετραγωνικό Μέτρο ανά Νιούτον","@language":"el"},{"@value":"Квадратен Метър на Нютон","@language":"bg"},{"@value":"Квадратный Метр на Ньютон","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/M2-PER-SEC","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\n  The unit $\\textit{Square Metres per Second}$ is the SI derived unit of angular momentum, defined by distance\n   or displacement in metres multiplied by distance again in metres and divided by time in seconds.\n  The unit is written in symbols as $m^2/s$ or $m^22s^{-1}$.\n  It may be better understood when phrased as $\\textit{metres per second times metres}$, i.e. the momentum\n   of an object with respect to a position.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$m^{2} s^{-1}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2947"},{"@id":"_:n3-2948"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AreaPerTime"},{"@id":"http://qudt.org/vocab/quantitykind/Circulation"},{"@id":"http://qudt.org/vocab/quantitykind/DiffusionCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/KinematicViscosity"},{"@id":"http://qudt.org/vocab/quantitykind/NeutronDiffusionCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/OrbitalAngularMomentumPerMass"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalDiffusionRatioCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalDiffusivity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA752","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA752","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m²/s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m2.s-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"S4","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AreaPerTime"},{"@id":"http://qudt.org/vocab/quantitykind/Circulation"},{"@id":"http://qudt.org/vocab/quantitykind/DiffusionCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/KinematicViscosity"},{"@id":"http://qudt.org/vocab/quantitykind/NeutronDiffusionCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/OrbitalAngularMomentumPerMass"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalDiffusionRatioCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalDiffusivity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q3332099"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Kvadratni Meter na Sekunda","@language":"sl"},{"@value":"Meter Persegi per Saat","@language":"ms"},{"@value":"Metr Kwadratowy na Sekunda","@language":"pl"},{"@value":"Metrekare per Saniye","@language":"tr"},{"@value":"Metro Cuadrado por Segundo","@language":"es"},{"@value":"Metro Quadrado por Segundo","@language":"pt"},{"@value":"Metro Quadrato per Secondo","@language":"it"},{"@value":"Metru Pătrat pe Secundă","@language":"ro"},{"@value":"Metrum Quadratum per Secundum","@language":"la"},{"@value":"Mètre Carré par Seconde","@language":"fr"},{"@value":"Quadratmeter pro Sekunde","@language":"de"},{"@value":"Square Meter per Second","@language":"en-us"},{"@value":"Square Metre per Second","@language":"en"},{"@value":"Square Metre per Second","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Čtvereční Metr na Sekunda","@language":"cs"},{"@value":"Τετραγωνικό Μέτρο ανά Δευτερόλεπτο","@language":"el"},{"@value":"Квадратен Метър на Секунда","@language":"bg"},{"@value":"Квадратный Метр на Секунда","@language":"ru"},{"@value":"متر مربع بر ثانیه","@language":"fa"},{"@value":"متر مربع في الثانية","@language":"ar"},{"@value":"वर्ग मीटर प्रति सैकिण्ड","@language":"hi"},{"@value":"平方メートル毎秒","@language":"ja"},{"@value":"平方米每秒","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/M2-PER-SEC-BAR","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The unit $\\textit{Square Metre per Second Bar}$ typically refers to a measure of fluid permeability in\n    the context of materials science or engineering. It is the volume of fluid (in square metres) that can pass through a material\n    in one second under a pressure difference of one bar. This unit is particularly important in fields such as petrophysics,\n    hydrogeology, and materials engineering, where understanding the flow of fluids through porous media is crucial. A $Bar$ is\n    not an SI unit but is a unit of pressure that is widely used in various scientific and engineering contexts. A bar is equal to\n    $100,000\\ pascals$, (symbol $Pa$), approximately equal to the atmospheric pressure on Earth at sea level.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/categorizedByQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Unknown"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.00001","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E-5","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M-1H0T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2949"},{"@id":"_:n3-2950"},{"@id":"_:n3-2951"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Unknown"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB493","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB493","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m²/(s·bar)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m2.s-1.bar-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"G41","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Square Meter per Second Bar","@language":"en-us"},{"@value":"Square Metre per Second Bar","@language":"en"},{"@value":"Square Metre per Second Bar","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/M2-PER-SEC-K","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\n  The unit $\\textit{Square Metre per Second Kelvin}$ is a heat transfer coefficient that is area-dependent\n   and varies with time and temperature difference.\n  Heat transfer is typically defined in terms of watts per square meter per kelvin ($W/m^{2}K$),\n   representing the rate of heat transfer across a surface per unit area per unit temperature difference.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/categorizedByQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Unknown"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H-1T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2952"},{"@id":"_:n3-2953"},{"@id":"_:n3-2954"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Unknown"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA753","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA753","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m²/(s·K)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m2.s-1.K-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"G09","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Kvadratni Meter na Sekunda Kelvin","@language":"sl"},{"@value":"Meter Persegi per Saat Kelvin","@language":"ms"},{"@value":"Metr Kwadratowy na Sekunda Kelwin","@language":"pl"},{"@value":"Metrekare per Saniye Kelvin","@language":"tr"},{"@value":"Metro Cuadrado por Segundo Kelvin","@language":"es"},{"@value":"Metro Quadrado por Segundo Kelvin","@language":"pt"},{"@value":"Metro Quadrato per Secondo Kelvin","@language":"it"},{"@value":"Metru Pătrat pe Secundă Kelvin","@language":"ro"},{"@value":"Metrum Quadratum per Secundum Kelvin","@language":"la"},{"@value":"Mètre Carré par Seconde Kelvin","@language":"fr"},{"@value":"Quadratmeter pro Sekunde Kelvin","@language":"de"},{"@value":"Square Meter per Second Kelvin","@language":"en-us"},{"@value":"Square Metre per Second Kelvin","@language":"en"},{"@value":"Square Metre per Second Kelvin","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Čtvereční Metr na Sekunda Kelvin","@language":"cs"},{"@value":"Τετραγωνικό Μέτρο ανά Δευτερόλεπτο Κέλβιν","@language":"el"},{"@value":"Квадратен Метър на Секунда Келвин","@language":"bg"},{"@value":"Квадратный Метр на Секунда Кельвин","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/M2-PER-SEC-PA","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The unit $\\textit{Square Metre per Second Pascal}$, symbol $m^{2}/s\\cdot Pa$, is a measure of\n    permeability, which describes the ability of a material to allow fluids to pass through it under a pressure gradient. It's\n    particularly relevant in fields like hydrogeology, petroleum engineering, and civil engineering, where understanding fluid\n    flow through porous materials is essential.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/categorizedByQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Unknown"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M-1H0T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2955"},{"@id":"_:n3-2956"},{"@id":"_:n3-2957"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Unknown"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB460","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB460","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m²/(s·Pa)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m2.s-1.Pa-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"M82","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Kvadratni Meter na Sekunda Pascal","@language":"sl"},{"@value":"Meter Persegi per Saat Pascal","@language":"ms"},{"@value":"Metr Kwadratowy na Sekunda Paskal","@language":"pl"},{"@value":"Metrekare per Saniye Pascal","@language":"tr"},{"@value":"Metro Cuadrado por Segundo Pascal","@language":"es"},{"@value":"Metro Quadrado por Segundo Pascal","@language":"pt"},{"@value":"Metro Quadrato per Secondo Pascal","@language":"it"},{"@value":"Metru Pătrat pe Secundă Pascal","@language":"ro"},{"@value":"Metrum Quadratum per Secundum Pascalium","@language":"la"},{"@value":"Mètre Carré par Seconde Pascal","@language":"fr"},{"@value":"Quadratmeter pro Sekunde Pascal","@language":"de"},{"@value":"Square Meter per Second Pascal","@language":"en-us"},{"@value":"Square Metre per Second Pascal","@language":"en"},{"@value":"Square Metre per Se