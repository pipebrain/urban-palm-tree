Schema#anyURI"}],"http://qudt.org/schema/qudt/prefix":[{"@id":"http://qudt.org/vocab/prefix/Pico"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/C"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"pC","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"pC","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"C71","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCharge"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q95446327"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Picocoulomb","@language":"cs"},{"@value":"Picocoulomb","@language":"de"},{"@value":"Picocoulomb","@language":"en"},{"@value":"Picocoulomb","@language":"fr"},{"@value":"Picocoulomb","@language":"hu"},{"@value":"Picocoulomb","@language":"it"},{"@value":"Picocoulomb","@language":"ms"},{"@value":"Picocoulomb","@language":"ro"},{"@value":"Picocoulomb","@language":"sl"},{"@value":"Picocoulomb","@language":"tr"},{"@value":"Picocoulomb","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Picoculombio","@language":"es"},{"@value":"Picokulomb","@language":"pl"}],"http://www.w3.org/ns/prov#wasDerivedFrom":[{"@id":"http://qudt.org/vocab/unit/C"}]},{"@id":"http://qudt.org/vocab/unit/PicoCI","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The picocurie (pCi) is $10^{-12}$ of the curie, a non-SI unit of radioactivity. $1\\,\\text{pCi} = 3.7\n    \\times 10^{-2}\\,\\text{Bq} = 0.037$ radioactive disintegrations per second. It is commonly used in environmental monitoring,\n    particularly for radon activity in air and water.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.037","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"3.7E-2","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Curie","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Activity"},{"@id":"http://qudt.org/vocab/quantitykind/RadioactiveDecay"},{"@id":"http://qudt.org/vocab/quantitykind/Radioactivity"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Curie?oldid=495080313","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/CI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"pCi","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"pCi","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Activity"},{"@id":"http://qudt.org/vocab/quantitykind/RadioactiveDecay"},{"@id":"http://qudt.org/vocab/quantitykind/Radioactivity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Picocurie","@language":"en"},{"@value":"Picocurie","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/PicoCI-PER-L","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Picocuries per litre is a unit of radioactivity concentration equal to $10^{-12}$ curie per litre, or\n    equivalently 37 becquerels per cubic metre ($\\text{Bq/m}^3$). It is the standard unit used in the United States for reporting\n    radon activity concentration in air and water.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"37.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"3.7E1","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4770"},{"@id":"_:n3-4771"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ActivityConcentration"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"pCi/L","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"pCi.L-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ActivityConcentration"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Picocurie per Liter","@language":"en-us"},{"@value":"Picocurie per Litre","@language":"en"},{"@value":"Picocurie per Litre","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/PicoFARAD","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\"PicoF\" is a common unit of electric capacitance equal to $10^{-12} farad$. This unit was formerly called\n    the micromicrofarad.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"h