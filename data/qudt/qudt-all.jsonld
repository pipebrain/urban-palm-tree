unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Attomásodperc","@language":"hu"},{"@value":"Attosaat","@language":"ms"},{"@value":"Attosaniye","@language":"tr"},{"@value":"Attosecond","@language":"en"},{"@value":"Attosecond","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Attoseconde","@language":"fr"},{"@value":"Attosecondo","@language":"it"},{"@value":"Attosecundă","@language":"ro"},{"@value":"Attosegundo","@language":"es"},{"@value":"Attosekunda","@language":"cs"},{"@value":"Attosekunda","@language":"pl"},{"@value":"Attosekunda","@language":"sl"},{"@value":"Attosekunde","@language":"de"}]},{"@id":"http://qudt.org/vocab/unit/B","@type":["http://qudt.org/schema/qudt/DimensionlessUnit","http://qudt.org/schema/qudt/LogarithmicUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\textit{Bel}$ is a logarithmic unit of sound pressure equal to 10 decibels (dB).\n  It is defined as: $1 B = (1/2) \\log_{10}(Np)$\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/ASU"},{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-ESU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/PLANCK"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"0.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Bel","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Log10Ratio"},{"@id":"http://qudt.org/vocab/quantitykind/SoundExposureLevel"},{"@id":"http://qudt.org/vocab/quantitykind/SoundPowerLevel"},{"@id":"http://qudt.org/vocab/quantitykind/SoundPressureLevel"},{"@id":"http://qudt.org/vocab/quantitykind/SoundReductionIndex"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB351","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB351","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Sound_unit","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/SI/units/bel"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"B","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"B","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"M72","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Log10Ratio"},{"@id":"http://qudt.org/vocab/quantitykind/SoundExposureLevel"},{"@id":"http://qudt.org/vocab/quantitykind/SoundPowerLevel"},{"@id":"http://qudt.org/vocab/quantitykind/SoundPressureLevel"},{"@id":"http://qudt.org/vocab/quantitykind/SoundReductionIndex"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q50098"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bel","@language":"cs"},{"@value":"Bel","@language":"de"},{"@value":"Bel","@language":"en"},{"@value":"Bel","@language":"fr"},{"@value":"Bel","@language":"hu"},{"@value":"Bel","@language":"it"},{"@value":"Bel","@language":"ms"},{"@value":"Bel","@language":"pl"},{"@value":"Bel","@language":"pt"},{"@value":"Bel","@language":"ro"},{"@value":"Bel","@language":"sl"},{"@value":"Bel","@language":"tr"},{"@value":"Bel","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Belio","@language":"es"},{"@value":"Μπέλ","@language":"el"},{"@value":"Бел","@language":"bg"},{"@value":"Бел","@language":"ru"},{"@value":"בל","@language":"he"},{"@value":"بل","@language":"ar"},{"@value":"بل","@language":"fa"},{"@value":"बेल","@language":"hi"},{"@value":"ベル","@language":"ja"},{"@value":"贝","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/B-PER-M","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\textit{Bel}$ is the unit $\\textit{Bel}$ divided by the SI base unit metre/\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"0.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-515"},{"@id":"_:n3-516"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Log10RatioPerLength"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB480","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB480","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"B/m","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"B.m-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"P43","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Log10RatioPerLength"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bel na Meter","@language":"sl"},{"@value":"Bel na Metr","@language":"cs"},{"@value":"Bel na Metr","@language":"pl"},{"@value":"Bel par Mètre","@language":"fr"},{"@value":"Bel pe Metru","@language":"ro"},{"@value":"Bel per Meter","@language":"en-us"},{"@value":"Bel per Meter","@language":"ms"},{"@value":"Bel per Metre","@language":"en"},{"@value":"Bel per Metre","@language":"tr"},{"@value":"Bel per Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Bel per Metro","@language":"it"},{"@value":"Bel por Metro","@language":"pt"},{"@value":"Bel pro Meter","@language":"de"},{"@value":"Belio por Metro","@language":"es"},{"@value":"Μπέλ ανά Μέτρο","@language":"el"},{"@value":"Бел на Метр","@language":"ru"},{"@value":"Бел на Метър","@language":"bg"}]},{"@id":"http://qudt.org/vocab/unit/BAN","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\n  A $\\textit{ban}$ is a logarithmic unit which measures information or entropy,\n   based on base 10 logarithms and powers of 10, rather than the base 2\n   logarithms which define the shannon.\n  One $\\textit{ban}$ is approximately $3.32 (log_2 10) shannon$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/ASU"},{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-ESU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/PLANCK"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"2.30258509","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"2.30258509E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Ban","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InformationContent"},{"@id":"http://qudt.org/vocab/quantitykind/InformationEntropy"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Ban?oldid=472969907","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/NAT"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"ban","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"Q15","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InformationContent"},{"@id":"http://qudt.org/vocab/quantitykind/InformationEntropy"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q324923"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Ban","@language":"en"},{"@value":"Ban","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BAR","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\textit{bar}$ is a non-SI unit of pressure, defined by the IUPAC as exactly equal\n   to $100,000\\,Pa$.\n  It is about equal to the atmospheric pressure on Earth at sea level, and since 1982\n   the IUPAC has recommended that the standard for atmospheric pressure should be\n   harmonized to $100,000\\,Pa = 1 \\,bar \\approx 750.0616827\\, Torr$.\n  Units derived from the bar are the megabar (symbol: $Mbar$), kilobar (symbol: $kbar$),\n   decibar (symbol: $dbar$), centibar (symbol: $cbar$), and millibar (symbol: $mbar$ or $mb$).\n  They are not SI or cgs units, but they are accepted for use with the SI.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"100000.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E5","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Bar","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/EquilibriumConstantBasedOnPressure"},{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"},{"@id":"http://qudt.org/vocab/quantitykind/VapourPressure"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA323","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA323","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Bar?oldid=493875987","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Bar_(unit)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/bar"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/PA"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"bar","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"bar","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"BAR","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/EquilibriumConstantBasedOnPressure"},{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"},{"@id":"http://qudt.org/vocab/quantitykind/VapourPressure"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q103510"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bar","@language":"en"},{"@value":"Bar","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BAR-L-PER-SEC","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\n  The unit $\\textit{Bar Litre Per Second}$ is the product of the unit $bar$ and\n   the unit $litre$ divided by the SI base unit for second.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"100.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E2","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-517"},{"@id":"_:n3-518"},{"@id":"_:n3-519"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA326","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA326","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The unit 'Bar Litre Per Second' is the product of the unit bar and the unit litre divided by the SI\n    base unit second\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"bar·L/s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"bar.L.s-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"F91","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bar Liter per Second","@language":"en-us"},{"@value":"Bar Litre per Second","@language":"en"},{"@value":"Bar Litre per Second","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BAR-M3-PER-SEC","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"product out of the 0.001-fold of the unit bar and the power of the SI base unit metre with the exponent 3\n    divided by the SI base unit second\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"100000.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E5","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVect