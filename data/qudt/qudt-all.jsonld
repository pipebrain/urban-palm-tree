p","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Electron_volt"}]},{"@id":"http://qudt.org/vocab/constant/ElementaryCharge","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Elementary_charge","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/constant/AtomicUnitOfCharge"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCharge"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Elementary_charge","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Elementary Charge\" is the electric charge carried by a single proton, or equivalently, the negation (opposite) of the electric charge carried by a single electron.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_ElementaryCharge"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/constants/ElementaryCharge"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"e","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[e]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Elementary Charge","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/ElementaryChargeOverH","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPerEnergy"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_ElementaryChargeOverH"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"elementary charge over h","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Elementary_charge"}]},{"@id":"http://qudt.org/vocab/constant/FaradayConstant","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\textit{Faraday Constant}$ is a constant equal to the product of electrical elementary charge and Avogadro constant; \n  this is approximately $9.64853321233100184 \\times 10^{4}\\ C/mol$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"c mol^{-1}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/C-PER-MOL"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Faraday_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ422#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E1L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerAmountOfSubstance"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD052","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD052","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Faraday_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$F = N_A e$, where $N_A$ is the Avogadro constant and $e$ is the elementary charge.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$F$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Physikalische Konstante, gleich dem Produkt aus elektrischer Elementarladung und Avogadro-Konstante; sie beträgt annähernd 96 485,3 C/mol","@language":"de"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_FaradayConstant"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Faraday constant","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/FermiCouplingConstant","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InverseSquareEnergy"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_FermiCouplingConstant"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Fermi coupling constant","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Coupling_constant"}]},{"@id":"http://qudt.org/vocab/constant/FineStructureConstant","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\textit{Fine-structure Constant}$ is a fundamental physical constant, namely the coupling constant\n   characterizing the strength of the electromagnetic interaction.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Fine-structure_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Fine-structure_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$a = \\frac{e^2}{4\\pi\\varepsilon_0\\hbar c_0}$, where $e$ is the elementary charge, $\\varepsilon_0$ is the electric constant, item $\\hbar$ is the reduced Planck constant, and $c_0$ is the speed of light in vacuum.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$a$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_FineStructureConstant"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Fine-Structure Constant","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/FirstRadiationConstant","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The constant $\\textit{First Radiation Constant}$ is defined in Planck's radiation law about the dependence\n   of the spectral density of various radiation variables on the wavelength of the electromagnetic radiation\n    and the absolute temperature of the black emitter.\n  This is composed of the product of twice $Pi$ times Planck's quantum of action multiplied by the square of\n   the velocity of light.\n   ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ455#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L4I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/PowerArea"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD053","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD053","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Konstante im Planckschen Strahlungsgesetz über die Abhängigkeit der spektralen Dichte verschiedener Strahlungsgrößen von der Wellenlänge der elektromagnetischen Strahlung und der absoluten Temperatur beim schwarzen Strahler, welche sich zusammensetzt aus dem Produkt zwei Pi mal Plancksches Wirkungsquantum mal dem Quadrat der Lichtgeschwindigkeit","@language":"de"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_FirstRadiationConstant"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"first radiation constant","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/FirstRadiationConstantForSpectralRadiance","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/PowerAreaPerSolidAngle"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_FirstRadiationConstantForSpectralRadiance"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"first radiation constant for spectral radiance","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/GravitationalConstant","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\textit{Gravitational Constant}$ (also known as the universal gravitational constant, is the Newtonian constant of gravitation, or the Cavendish gravitational constant).\n  Denoted by the letter $G$, it is an empirical physical constant involved in the calculation of gravitational effects in Sir Isaac Newton's law of universal gravitation \n  and in Albert Einstein's general theory of relativity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/N-M2-PER-KiloGM2"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ474#002","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/GravitationalAttraction"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD059","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD059","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Gravitational_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Empirisch ermittelte Naturkonstante, die bei bekanntem Mittelpunktsabstand zweier kugelsymmetrischer Körper deren gegenseitige Massenanziehungskraft bestimmt","@language":"de"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_GravitationalConstant"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[G]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Gravitational constant","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/HartreeAtomicMassUnitRelationship","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_HartreeAtomicMassUnitRelationship"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"hartree-atomic mass unit relationship","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Atomic_mass_unit"}]},{"@id":"http://qudt.org/vocab/constant/HartreeElectronVoltRelationship","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_HartreeElectronVoltRelationship"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"hartree-electron volt relationship","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Electron_volt"}]},{"@id":"http://qudt.org/vocab/constant/HartreeEnergy","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The constant $\\textit{Hartree Energy}$ (symbol: $E_h$ or $Ha$), also known as the $\\textit{Hartree}$, is the atomic unit of energy. \n  The hartree energy is equal to the absolute value of the electric potential energy of the hydrogen atom in its ground state. \n  The energy of the electron in an H-atom in its ground state is $-E_H$, where $E_H= 2 R_\\infty \\cdot hc_0$. \n  The 2006 CODATA recommended value was $E_H = 4.35974394(22)\\ \\times 10^{-18}\\ J = 27.21138386(68)\\ eV$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Hartree","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$E_H= \\frac{e^2}{4\\pi \\varepsilon_0 a_0 }$, where $e$ is the elementary charge, $\\varepsilon_0$ is the electric constant, and $a_0$ is the Bohr radius.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$E_h$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_HartreeEnergy"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Hartree Energy","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/HartreeEnergyInEV","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_HartreeEnergyInEV"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Hartree energy in eV","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Hartree"}]},{"@id":"http://qudt.org/vocab/constant/HartreeHertzRelationship","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Frequency"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_HartreeHertzRelationship"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"hartree-hertz relationship","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/HartreeInverseMeterRelationship","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InverseLength"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_HartreeInverseMeterRelationship"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"hartree-inverse meter relationship","@language":"en-us"},{"@value":"hartree-inverse metre relationship","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/HartreeJouleRelationship","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_HartreeJouleRelationship"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"hartree-joule relationship","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/HartreeKelvinRelationship","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermodynamicTemperature"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_HartreeKelvinRelationship"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"hartree-kelvin relationship","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/HartreeKilogramRelationship","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_HartreeKilogramRelationship"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#l