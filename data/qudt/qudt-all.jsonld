,{"@value":"Radyan per Metre","@language":"tr"},{"@value":"Ακτίνιο ανά Μέτρο","@language":"el"},{"@value":"Радиан на Метр","@language":"ru"},{"@value":"Радиан на Метър","@language":"bg"},{"@value":"رادیان بر متر","@language":"fa"},{"@value":"مقياس التبادل، الأس السالب للمتر","@language":"ar"},{"@value":"प्रति मीटर वर्ग मीटर","@language":"hi"},{"@value":"ラジアン毎メートル","@language":"ja"},{"@value":"弧度每米","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/RAD-PER-MIN","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Radian Per Minute (rad/min) is a unit in the category of Angular velocity. It is also known as radians\n    per minute, radian/minute. Radian Per Minute (rad/min) has a dimension of aT-1 where $T$ is time. It can be converted to the\n    corresponding standard SI unit rad/s by multiplying its value by a factor of 0.0166666666667.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.01666666666666666666666666666666667","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.666666666666666666666666666666667E-2","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$rad/m$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4857"},{"@id":"_:n3-4858"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AngularFrequency"},{"@id":"http://qudt.org/vocab/quantitykind/AngularVelocity"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"rad/min","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"rad.min-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AngularFrequency"},{"@id":"http://qudt.org/vocab/quantitykind/AngularVelocity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Radian per Minute","@language":"en"},{"@value":"Radian per Minute","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/RAD-PER-SEC","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\"Radian per Second\" is the SI unit of rotational speed (angular velocity), and, also the unit of angular\n    frequency. The radian per second is defined as the change in the orientation of an object, in radians, every second.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$rad/s$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4859"},{"@id":"_:n3-4860"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AngularFrequency"},{"@id":"http://qudt.org/vocab/quantitykind/AngularVelocity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA968","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA968","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"rad/s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"rad.s-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"2A","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AngularFrequency"},{"@id":"http://qudt.org/vocab/quantitykind/AngularVelocity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1063756"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Radian na Sekunda","@language":"pl"},{"@value":"Radian na Sekunda","@language":"sl"},{"@value":"Radian par Seconde","@language":"fr"},{"@value":"Radian pe Secundă","@language":"ro"},{"@value":"Radian per Saat","@language":"ms"},{"@value":"Radian per Second","@language":"en"},{"@value":"Radian per Second","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Radian per Secundum","@language":"la"},{"@value":"Radiano por Segundo","@language":"pt"},{"@value":"Radiant pro Sekunde","@language":"de"},{"@value":"Radiante per Secondo","@language":"it"},{"@value":"Radián na Sekunda","@language":"cs"},{"@value":"Radián por Segundo","@language":"es"},{"@value":"Radyan per Saniye","@language":"tr"},{"@value":"Ακτίνιο ανά Δευτερόλεπτο","@language":"el"},{"@value":"Радиан на Секунда","@language":"bg"},{"@value":"Радиан на Секунда","@language":"ru"},{"@value":"راديان في الثانية","@language":"ar"},{"@value":"رادیان بر ثانیه","@language":"fa"},{"@value":"वर्ग मीटर प्रति सैकिण्ड","@language":"hi"},{"@value":"ラジアン毎秒","@language":"ja"},{"@value":"弧度每秒","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/RAD-PER-SEC2","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Angular acceleration is the rate of change of angular velocity. In SI units, it is measured in radians\n    per Square second ($rad/s^2$), and is usually denoted by the Greek letter $\\alpha$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$rad/s2$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4861"},{"@id":"_:n3-4862"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AngularAcceleration"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA969","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA969","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"rad/s²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"rad.s-2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"2B","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AngularAcceleration"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q30338333"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Radian na Kvadratni Sekunda","@language":"sl"},{"@value":"Radian na Sekunda Kwadratowy","@language":"pl"},{"@value":"Radian par Seconde Carré","@language":"fr"},{"@value":"Radian pe Secundă Pătrat","@language":"ro"},{"@value":"Radian per Saat Persegi","@language":"ms"},{"@value":"Radian per Secundum Quadratum","@language":"la"},{"@value":"Radian per Square Second","@language":"en"},{"@value":"Radian per Square Second","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Radiano por Segundo Quadrado","@language":"pt"},{"@value":"Radiant pro Quadratsekunde","@language":"de"},{"@value":"Radiante per Secondo Quadrato","@language":"it"},{"@value":"Radián na Čtvereční Sekunda","@language":"cs"},{"@value":"Radián por Segundo Cuadrado","@language":"es"},{"@value":"Radyan per Saniyekare","@language":"tr"},{"@value":"Ακτίνιο ανά Τετραγωνικό Δευτερόλεπτο","@language":"el"},{"@value":"Радиан на Квадратен Секунда","@language":"bg"},{"@value":"Радиан на Квадратный Секунда","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/RAD_R","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The $rad$ is a deprecated unit of absorbed radiation dose, defined as $1 rad = 0.01\\,Gy = 0.01 J/kg$. It\n    was originally defined in CGS units in 1953 as the dose causing 100 ergs of energy to be absorbed by one gram of matter. It\n    has been replaced by the gray in most of the world. A related unit, the $roentgen$, was formerly used to quantify the number\n    of rad deposited into a target when it was exposed to radiation. The F-factor can used to convert between rad and roentgens.\n    The material absorbing the radiation can be human tissue or silicon microchips or any other medium (for example, air, water,\n    lead shielding, etc.).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.01","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E-2","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/RAD","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AbsorbedDose"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/RAD?oldid=493716376","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/rad"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/M2-PER-SEC2"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"rad","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"RAD","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"C80","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AbsorbedDose"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1052397"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Rad","@language":"en"},{"@value":"Rad","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/RAYL","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The $Rayl$ is one of two units of specific acoustic impedance. There is a CGS version and an MKS version\n    of different magnitude. When sound waves pass through any physical substance the pressure of the waves causes the particles of\n    the substance to move. The sound specific impedance is the ratio between the sound pressure and the particle velocity it\n    produces. The specific impedance is one rayl if unit pressure produces unit velocity. It is defined as follows: $1\\; rayl = 1\n    dyn\\cdot s\\cdot cm^{-3}$ Or in SI as: $1 \\; rayl = 10^{-1}Pa\\cdot s\\cdot m^{-1}$, which equals $10\\,N \\cdot s\\cdot\n    m^{-3}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"10.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E1","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Rayl","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MechanicalSurfaceImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificAcousticImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/SurgeImpedanceOfTheMedium"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Rayl","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M2-SEC"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"rayl","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MechanicalSurfaceImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificAcousticImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/SurgeImpedanceOfTheMedium"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q359151"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Rayl","@language":"en"},{"@value":"Rayl","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/unit/RAYL_MKS"}]},{"@id":"http://qudt.org/vocab/unit/RAYL_MKS","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The $Rayl$ is one of two units of specific acoustic impedance. There is a CGS version and an MKS version\n    of different magnitude. When sound waves pass through any physical substance the pressure of the waves causes the particles of\n    the substance to move. The sound specific impedance is the ratio between the sound pressure and the particle velocity it\n    produces. The specific impedance is one rayl if unit pressure produces unit velocity. It is defined as follows: $1\\; rayl = 1\n    dyn\\cdot s\\cdot cm^{-3}$ Or in SI as: $1 \\; rayl = 10^{-1}Pa\\cdot s\\cdot m^{-1}$, which equals $10\\,N \\cdot s\\cdot\n    m^{-3}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Rayl","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MechanicalSurfaceImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificAcousticImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/SurgeImpedanceOfTheMedium"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Rayl","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M2-SEC"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"rayl_MKS","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MechanicalSurfaceImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificAcousticImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/SurgeImpedanceOfTheMedium"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q359151"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Rayl_MKS","@language":"en"},{"@value":"Rayl_MKS","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/unit/RAYL"}]},{"@id":"http://qudt.org/vocab/unit/REM","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A Rem is a deprecated unit used to measure the biological effects of ionizing radiation. The rem is\n    defined as equal to 0.01 sievert, which is the more commonly used unit outside of the United States. Equivalent dose,\n    effective dose, and committed dose can all be measured in units of rem. These quantities are products of the absorbed dose in\n    rads and weighting factors. These factors must be selected for each exposure situation; there is no universally applicable\n    conversion constant from rad to rem. A rem is a large dose of radiation, so the millirem (mrem), which is one thousandth of a\n    rem, is often used for the dosages commonly encountered, such as the amount of radiation received from medical x-rays and\n    background sources.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.01","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E-2","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/unit/R_man"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/DoseEquivalent"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA971","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA971","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Roentgen_equivalent_man","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/rem"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/M2-PER-SEC2"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"rem","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"REM","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"D91","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/DoseEquivalent"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q260126"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Rem","@language":"en"},{"@value":"Rem","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/REM-PER-SEC","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"unit for the equivalent tin rate relating to DIN 1301-3:1979: 1 rem/s = 0.01 J/(kg·s) = 1 Sv/s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.01","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E-2","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4863"},{"@id":"_:n3-4864"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/q