exponent\n    3\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1000000.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E6","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-3I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-785"},{"@id":"_:n3-786"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeDensity"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeVolumeDensity"},{"@id":"http://qudt.org/vocab/quantitykind/VolumeDensityOfCharge"},{"@id":"http://qudt.org/vocab/quantitykind/VolumetricElectricCharge"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB120","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB120","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"derived SI unit coulomb divided by the 0.000 001-fold of the power of the SI base unit metre by\n    exponent 3\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"C/cm³","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"C.cm-3","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"A28","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeDensity"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeVolumeDensity"},{"@id":"http://qudt.org/vocab/quantitykind/VolumeDensityOfCharge"},{"@id":"http://qudt.org/vocab/quantitykind/VolumetricElectricCharge"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q106808138"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Coulomb na Centimetr Krychlový","@language":"cs"},{"@value":"Coulomb na Kubični Centimeter","@language":"sl"},{"@value":"Coulomb par Centimètre Cube","@language":"fr"},{"@value":"Coulomb pe Centimetru Cub","@language":"ro"},{"@value":"Coulomb per Centimeter Kubik","@language":"ms"},{"@value":"Coulomb per Centimetreküp","@language":"tr"},{"@value":"Coulomb per Centimetro Cubo","@language":"it"},{"@value":"Coulomb per Cubic Centimeter","@language":"en-us"},{"@value":"Coulomb per Cubic Centimetre","@language":"en"},{"@value":"Coulomb per Cubic Centimetre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Coulomb pro Kubikcentimeter","@language":"de"},{"@value":"Culombio por Centimetro Cúbico","@language":"es"},{"@value":"Kulomb na Centimetr Sześcienny","@language":"pl"}]},{"@id":"http://qudt.org/vocab/unit/C-PER-KiloGM","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Coulomb Per Kilogram (C/kg)}$ is the unit in the category of Exposure. It is also known as\n    coulombs per kilogram, coulomb/kilogram. This unit is commonly used in the SI unit system. Coulomb Per Kilogram (C/kg) has a\n    dimension of $M^{-1}TI$ where $M$ is mass, $T$ is time, and $I$ is electric current. This unit is the standard SI unit in this\n    category.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$C/kg$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M-1H0T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-787"},{"@id":"_:n3-788"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerMass"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA131","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA131","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"C/kg","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"C.kg-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"CKG","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerMass"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q28683485"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http