tants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_NeutronProtonMassRatio"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"neutron-proton mass ratio","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/NeutronTauMassRatio","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_NeutronTauMassRatio"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"neutron-tau mass ratio","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/NeutronToShieldedProtonMagneticMomentRatio","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_NeutronToShieldedProtonMagneticMomentRatio"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"neutron to shielded proton magnetic moment ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/G-factor"}]},{"@id":"http://qudt.org/vocab/constant/NewtonianConstantOfGravitation","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Gravitational_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/GravitationalAttraction"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_NewtonianConstantOfGravitation"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Newtonian constant of gravitation","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/NuclearMagneton","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The constant $\\textit{Nuclear Magneton}$ is the natural unit for expressing magnetic dipole moments of\n   heavy particles such as nucleons and atomic nuclei.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-T"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Nuclear_magneton","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticDipoleMoment"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Nuclear_magneton","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mu_N = \\frac{e\\hbar}{2m_p}$, where $e$ is the elementary charge, $\\hbar$ is the Planck constant, and $m_p$ is the rest mass of proton.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mu_N$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_NuclearMagneton"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Nuclear Magneton","@language":"en"}],"http://www.w3.org/2004/02/skos/core#related":[{"@id":"http://qudt.org/vocab/constant/BohrMagneton"}]},{"@id":"http://qudt.org/vocab/constant/NuclearMagnetonInEVPerT","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticDipoleMoment"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_NuclearMagnetonInEVPerT"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"nuclear magneton in eV per T","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Nuclear_magneton"}]},{"@id":"http://qudt.org/vocab/constant/NuclearMagnetonInInverseMetersPerTesla","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticReluctivity"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_NuclearMagnetonInInverseMetersPerTesla"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"nuclear magneton in inverse meters per tesla","@language":"en-us"},{"@value":"nuclear magneton in inverse metres per tesla","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Nuclear_magneton"}]},{"@id":"http://qudt.org/vocab/constant/NuclearMagnetonInKPerT","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/TemperaturePerMagneticFluxDensity"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_NuclearMagnetonInKPerT"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"nuclear magneton in K per T","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Nuclear_magneton"}]},{"@id":"http://qudt.org/vocab/constant/NuclearMagnetonInMHzPerT","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerMass"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_NuclearMagnetonInMHzPerT"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"nuclear magneton in MHz per T","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Nuclear_magneton"}]},{"@id":"http://qudt.org/vocab/constant/PermittivityOfVacuum","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The constant $\\textit{Permittivity of Vacuum}$, also known as the $\\textit{electric constant}$ is a constant \n  whose value is $\\approx\\,6.854188e-12\\, farad\\,per\\,metre$. Sometimes also referred to as \n  the $\\textit{Permittivity of Free Space}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FARAD-PER-M"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Permittivity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Permittivity"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\epsilon = \\frac{\\mathbf{D}}{\\mathbf{E}}$, where $\\mathbf{D}$ is electric flux density and $\\mathbf{E}$ is electric field strength.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\epsilon_0$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_PermittivityOfVacuum"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[eps_0]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Permittivity of Vacuum","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricFieldStrength"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricFluxDensity"},{"@id":"http://qudt.org/vocab/quantitykind/Permittivity"}]},{"@id":"http://qudt.org/vocab/constant/Pi","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The constant $\\pi$ is the ratio of a circle's circumference to its diameter, commonly approximated as 3.14159.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Pi","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Pi","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\pi = \\frac{C}{d}$, where $C$ is the circumference of a circle and $d$ is the diameter of a circle.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\pi$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_Pi"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pi","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/PlanckConstant","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The constant $\\textit{Planck Constant}$ is a physical constant that is the quantum of action in quantum mechanics. \n  The Planck constant was first described as the proportionality constant between the energy ($E$) of a photon\n   and the frequency ($\\nu$) of its associated electromagnetic wave.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-SEC"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Planck_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Action"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Planck_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$E = h\\nu = \\frac{hc}{\\lambda}$, where $E$ is energy, $\\nu$ is frequency, $\\lambda$ is wavelength, and $c$ is the speed of light.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$h$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_PlanckConstant"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/constants/PlanckConstant"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[h]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Planck Constant","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/PlanckConstantInEVS","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Action"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_PlanckConstantInEVS"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Planck constant in eV s","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Planck_constant"}]},{"@id":"http://qudt.org/vocab/constant/PlanckConstantOver2Pi","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Action"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_PlanckConstantOver2Pi"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Planck constant over 2 pi","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Planck_constant"}]},{"@id":"http://qudt.org/vocab/constant/PlanckConstantOver2PiInEVS","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Action"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_PlanckConstantOver2PiInEVS"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Planck constant over 2 pi in eV s","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Planck_constant"}]},{"@id":"http://qudt.org/vocab/constant/PlanckConstantOver2PiTimesCInMeVFm","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LengthEnergy"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_PlanckConstantOver2PiTimesCInMeVFm"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Planck constant over 2 pi times c in MeV fm","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Planck_constant"}]},{"@id":"http://qudt.org/vocab/constant/PlanckLength","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Planck_length","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_PlanckLength"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Planck length","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/PlanckMass","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Planck_mass","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_PlanckMass"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Planck mass","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/PlanckMassEnergyEquivalentInGeV","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_PlanckMassEnergyEquivalentInGeV"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Planck mass energy e