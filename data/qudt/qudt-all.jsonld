//qudt.org/vocab/unit/LB_F-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/M_H2O"},{"@id":"http://qudt.org/vocab/unit/MegaBAR"},{"@id":"http://qudt.org/vocab/unit/MegaN-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MegaPA"},{"@id":"http://qudt.org/vocab/unit/MegaPSI"},{"@id":"http://qudt.org/vocab/unit/MicroATM"},{"@id":"http://qudt.org/vocab/unit/MicroBAR"},{"@id":"http://qudt.org/vocab/unit/MicroPA"},{"@id":"http://qudt.org/vocab/unit/MicroTORR"},{"@id":"http://qudt.org/vocab/unit/MilliBAR"},{"@id":"http://qudt.org/vocab/unit/MilliBAR_A"},{"@id":"http://qudt.org/vocab/unit/MilliM_H2O"},{"@id":"http://qudt.org/vocab/unit/MilliM_HG"},{"@id":"http://qudt.org/vocab/unit/MilliM_HGA"},{"@id":"http://qudt.org/vocab/unit/MilliPA"},{"@id":"http://qudt.org/vocab/unit/MilliTORR"},{"@id":"http://qudt.org/vocab/unit/N-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/N-PER-M2"},{"@id":"http://qudt.org/vocab/unit/N-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/PA"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/PSI"},{"@id":"http://qudt.org/vocab/unit/PicoPA"},{"@id":"http://qudt.org/vocab/unit/PlanckPressure"},{"@id":"http://qudt.org/vocab/unit/TORR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Partial_pressure","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$p_B = x_B \\cdot p$, where $x_B$ is the amount-of-substance fraction of substance $B$ and $p$ is the total pressure.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Partial Pressure\" is the pressure that the gas would have if it alone occupied the volume of the\n    mixture at the same temperature.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Pressure"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"p_B","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q27165"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ForcePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Partial Pressure","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Pressure"}]},{"@id":"http://qudt.org/vocab/quantitykind/ParticleCurrent","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\n  The quantity kind $\\textit{Particle Current}$ can be used to describe the net number\n   of particles passing through a surface in an infinitesimal time interval.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/altSymbol":[{"@value":"S","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/NUM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-YR"},{"@id":"http://qudt.org/vocab/unit/SAMPLE-PER-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\int J \\cdot e_n dA = \\frac{dN}{dt}$, where $e_ndA$ is the vector surface element, $N$ is the net number of particles passing over a surface, and $dt$ describes the time interval.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Particle Current\" can be used to describe the net number of particles passing through a surface in\n    an infinitesimal time interval.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/CountRate"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q2400689"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CountRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Particle Current","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/CountRate"}]},{"@id":"http://qudt.org/vocab/quantitykind/ParticleCurrentDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\n  The quantity kind $\\textit{Particle Current Density}$ is a vector whose component is\n   perpendicular to a surface equal to the net number of particles crossing that surface\n   in the positive direction per unit area and per unit time.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PER-M2-SEC"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ388#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD132","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD132","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/ParticleFluenceRate"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Vektor, dessen Komponente senkrecht zu einer Fläche gleich der Nettoanzahl von Teilchen ist, die\n    flächen- und zeitbezogen in positiver Richtung durch diese Fläche hindurchgehen\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ParticleCurrentDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Particle Current Density","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ParticleFluenceRate"}]},{"@id":"http://qudt.org/vocab/quantitykind/ParticleFluence","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\n  The quantity kind $\\textit{Particle Fluence}$ is the total number of particles that\n   intersect a unit area in a specific time interval of interest, and has units of $m^{-2}$\n    (number of particles per meter squared).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/NUM-PER-HA"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-KiloM2"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-M2"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ387#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD133","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD133","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Fluence","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\Phi = \\frac{dN}{dA}$, where $dN$ describes the number of particles incident on a small spherical domain at a given point in space, and $dA$ describes the cross-sectional area of that domain.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Phi$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Particle Fluence\" is the total number of particles that intersect a unit area in a specific time\n    interval of interest, and has units of /m2 (number of particles per meter squared).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q82965908"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ParticleFluence","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Particle Fluence","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ParticleFluenceRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Particle Fluence Rate\" can be defined as the total number of particles (typically Gamma Ray Photons )\n    crossing over a sphere of unit cross section which surrounds a Point Source of Ionising Radiation.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/NUM-PER-HA-YR"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-M2-DAY"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.encyclo.co.uk/define/Fluence%20Rate","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\theta = \\frac{d\\Phi}{dt}$, where $d\\Phi$ is the increment of the particle fluence during an infinitesimal time interval with duration $dt$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\theta$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Particle Fluence Rate\" can be defined as the total number of particles (typically Gamma Ray\n    Photons ) crossing over a sphere of unit cross section which surrounds a Point Source of Ionising Radiation.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98497410"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ParticleFluenceRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Particle Fluence Rate","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ParticleNumberDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Particle Number Density\" is obtained by dividing the particle number of a system by its volume.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/NUM-PER-L"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-M3"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-MicroL"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-MilliL"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-MilliM3"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-NanoL"},{"@id":"http://qudt.org/vocab/unit/NUM-PER-PicoL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Particle_number#Particle_number_density","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$n = \\frac{N}{V}$, where $N$ is the number of particles in the 3D domain with the volume $V$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Particle Number Density\" is obtained by dividing the particle number of a system by its\n    volume.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/NumberDensity"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"n","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98601569"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:NumberDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Particle Number Density","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/NumberDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/ParticlePositionVector","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Particle Position Vector\" is the position vector of a particle.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ANGSTROM"},{"@id":"http://qudt.org/vocab/unit/AU"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB_F"},{"@id":"http://qudt.org/vocab/unit/CHAIN"},{"@id":"http://qudt.org/vocab/unit/CHAIN_US"},{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/DecaM"},{"@id":"http://qudt.org/vocab/unit/DeciM"},{"@id":"http://qudt.org/vocab/unit/FATH"},{"@id":"http://qudt.org/vocab/unit/FM"},{"@id":"http://qudt.org/vocab/unit/FT"},{"@id":"http://qudt.org/vocab/unit/FT_US"},{"@id":"http://qudt.org/vocab/unit/FUR"},{"@id":"http://qudt.org/vocab/unit/FemtoM"},{"@id":"http://qudt.org/vocab/unit/GAUGE_FR"},{"@id":"http://qudt.org/vocab/unit/GA_Charriere"},{"@id":"http://qudt.org/vocab/unit/HectoM"},{"@id":"http://qudt.org/vocab/unit/IN"},{"@id":"http://qudt.org/vocab/unit/KiloM"},{"@id":"http://qudt.org/vocab/unit/LY"},{"@id":"http:/