/vocab/unit/CCY_XAF"},{"@id":"http://qudt.org/vocab/unit/CCY_XAG"},{"@id":"http://qudt.org/vocab/unit/CCY_XAU"},{"@id":"http://qudt.org/vocab/unit/CCY_XBA"},{"@id":"http://qudt.org/vocab/unit/CCY_XBB"},{"@id":"http://qudt.org/vocab/unit/CCY_XBC"},{"@id":"http://qudt.org/vocab/unit/CCY_XBD"},{"@id":"http://qudt.org/vocab/unit/CCY_XCD"},{"@id":"http://qudt.org/vocab/unit/CCY_XDR"},{"@id":"http://qudt.org/vocab/unit/CCY_XFO"},{"@id":"http://qudt.org/vocab/unit/CCY_XFU"},{"@id":"http://qudt.org/vocab/unit/CCY_XOF"},{"@id":"http://qudt.org/vocab/unit/CCY_XPD"},{"@id":"http://qudt.org/vocab/unit/CCY_XPF"},{"@id":"http://qudt.org/vocab/unit/CCY_XPT"},{"@id":"http://qudt.org/vocab/unit/CCY_YER"},{"@id":"http://qudt.org/vocab/unit/CCY_ZAR"},{"@id":"http://qudt.org/vocab/unit/CCY_ZMW"},{"@id":"http://qudt.org/vocab/unit/CCY_ZWL"},{"@id":"http://qudt.org/vocab/unit/MegaCCY_USD"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Currency","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Currency","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In economics, currency is a generally accepted medium of exchange. These are usually the coins and\n    banknotes of a particular government, which comprise the physical aspects of a nation's money supply. The other part of a\n    nation's money supply consists of bank deposits (sometimes called deposit money), ownership of which can be transferred by\n    means of cheques, debit cards, or other forms of money transfer. Deposit money and currency are money in the sense that both\n    are acceptable as a means of payment.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Asset"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Currency","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Currency","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Asset"}]},{"@id":"http://qudt.org/vocab/quantitykind/CurrencyPerFlight","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MegaCCY_USD-PER-FLIGHT"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CurrencyPerFlight","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Currency per Flight","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/CurrencyPerTime","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MegaCCY_USD-PER-YR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A rate of currency flow, expressed as an amount of currency per unit time.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CurrencyPerTime","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Currency per Time","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/CurrentLinkage","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Current Linkage\" is the net electric current through a surface delimited by a closed loop.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A"},{"@id":"http://qudt.org/vocab/unit/AttoA"},{"@id":"http://qudt.org/vocab/unit/FemtoA"},{"@id":"http://qudt.org/vocab/unit/GigaA"},{"@id":"http://qudt.org/vocab/unit/PetaA"},{"@id":"http://qudt.org/vocab/unit/TeraA"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$current-linkage$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-60","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Theta$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrent"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Current Linkage\" is the net electric current through a surface delimited by a closed loop.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q77995703"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CurrentLinkage","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Current Linkage","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrent"}]},{"@id":"http://qudt.org/vocab/quantitykind/CurrentOfTheAmountOfSubstance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio of the amount of substance divided by the related time","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloMOL-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloMOL-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/SCF-PER-HR"},{"@id":"http://qudt.org/vocab/unit/SCF-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/SCM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/SCM-PER-MIN"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ384#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/MolarFlowRate"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient Stoffmenge dividiert durch die zugehörige Zeit","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CurrentOfTheAmountOfSubstance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Current of the Amount of Substance","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/Curvature","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The canonical example of extrinsic curvature is that of a circle, which has curvature equal to the\n    inverse of its radius everywhere. Smaller circles bend more sharply, and hence have higher curvature. The curvature of a\n    smooth curve is defined as the curvature of its osculating circle at each point. The osculating circle of a sufficiently\n    smooth plane curve at a given point on the curve is the circle whose center lies on the inner normal line and whose curvature\n    is the same as that of the given curve at that point. This circle is tangent to the curve at the given point. The magnitude of\n    curvature at points on physical curves can be measured in $diopters$ (also spelled $dioptre$) — this is the convention in\n    optics.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DIOPTER"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Curvature","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Curvature","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The canonical example of extrinsic curvature is that of a circle, which has curvature equal to the\n    inverse of its radius everywhere. Smaller circles bend more sharply, and hence have higher curvature. The curvature of a\n    smooth curve is defined as the curvature of its osculating circle at each point. The osculating circle of a sufficiently\n    smooth plane curve at a given point on the curve is the circle whose center lies on the inner normal line and whose curvature\n    is the same as that of the given curve at that point. This circle is tangent to the curve at the given point. That is, given a\n    point P on a smooth curve C, the curvature of C at P is defined to be 1/R where R is the radius of the osculating circle of C\n    at P. The magnitude of curvature at points on physical curves can be measured in diopters (also spelled dioptre) — this is the\n    convention in optics. [Wikipedia],\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q214881"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Curvature","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Curvature","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/CurvatureFromRadius","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In mathematics \"Curvature\" is the amount by which a geometric object deviates from being flat, or\n    straight in the case of a line, but this is defined in different ways depending on the context.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PER-KiloM"},{"@id":"http://qudt.org/vocab/unit/PER-M"},{"@id":"http://qudt.org/vocab/unit/PER-MicroM"},{"@id":"http://qudt.org/vocab/unit/PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/PER-NanoM"},{"@id":"http://qudt.org/vocab/unit/PER-PicoM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Curvature","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\kappa = \\frac{1}{\\rho}$, where $\\rho$ is the radius of the curvature.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\kappa$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In mathematics \"Curvature\" is the amount by which a geometric object deviates from being flat, or\n    straight in the case of a line, but this is defined in different ways depending on the context.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q214881"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CurvatureFromRadius","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Curvature","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://qudt.org/vocab/quantitykind/Curvature"}]},{"@id":"http://qudt.org/vocab/quantitykind/CutoffCurrentRating","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"cut-off current parameter as rating for fuses and switches, derived from the so-called Joule integral","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A2-SEC"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ325#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E2L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Durchlassstrom-Kennwert als Bemessungsgröße für Sicherungen und Schalter, welcher abgeleitet ist\n    aus dem sogenannten Joule-Integral\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:CutoffCurrentRating","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"I²t-value","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/CyclotronAngularFrequency","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Cyclotron Angular Frequency\" describes angular momentum vector precession about the external field\n    axis with an angular frequency.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG-PER-HR"},{"@id":"http://qudt.org/vocab/unit/DEG-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/DEG-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PlanckFrequency_Ang"},{"@id":"http://qudt.org/vocab/unit/RAD-PER-HR"},{"@id":"http://qudt.org/vocab/unit/RAD-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/RAD-PER-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Electron_cyclotron_resonance","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\omega_c = \\frac{\\left | q \\right |}{m}B$, where $q$ is the electric charge, $m$ is its mass, and $B$ is the magnetic flux density.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\omega_c$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Cyclotron Angular Frequency\" describes angular momentum vector precession about the external\n    field axis with an angular frequency.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/AngularFrequency"},{"@id":"http://qudt.org/vocab/quantitykind/AngularVelocity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q97708211"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AngularFrequency","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:AngularVelocity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Larmor Angular Frequency","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AngularFrequency"},{"@id":"http://qudt.org/vocab/quantitykind/AngularVelocity"}]},{"@id":"http://qudt.org/vocab/quantitykind/DELTA-V","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The change in translational velocity including all losses for a propulsive system or module. Delta-V\n    losses include, but are not limited to, gravity losses and steering losses.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Delta-v","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\bigtriangleup v$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The change in translational velocity including all losses for a propulsive system or module.\n    Delta-V losses include, but are not limited to, gravity losses and steering losses.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Delta-V","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Velocity"}]},{"@id":"http://qudt.org/vocab/quantitykind/DRY-MASS","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Mass of a system without the propellants, pressurants, reserve or residual fluids, personnel and\n    personnel provisions, and cargo.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Mass of a system without the propellants, pressurants, reserve or residual fluids, personnel and\n    personnel provisions, and cargo.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dry Mass","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}]},{"@id":"http://qudt.org/vocab/quantitykind/DataCapacity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The largest amount of digital data that a storage or transmission medium can hold or convey, expressed as\n    a number of bits or bytes (and their multiples). A specialisation of quantitykind:AmountOfData denoting a maximum or rated\n    capacity rather than an actual quantity stored.\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BIT"},{"@id":"http://qudt.org/vocab/unit/BYTE"},{"@id":"http://qudt.org/vocab/unit/ExaBIT"},{"@id":"http://qudt.org/vocab/unit/ExaBYTE"},{"@id":"http://qudt.org/vocab/unit/ExbiBIT"},{"@id":"http://qudt.org/vocab/unit/ExbiBYTE"},{"@id":"http://qudt.org/vocab/unit/GibiBIT"},{"@id":"http://qudt.org/vocab/unit/GibiBYTE"},{"@id":"http://qudt.org/vocab/unit/GigaBIT"},{"@id":"http://qudt.org/vocab/unit/GigaBYTE"},{"@id":"http://qudt.org/vocab/unit/KibiBIT"},{"@id":"http://qudt.org/vocab/unit/KibiBYTE"},{"@id":"http://qudt.org/vocab/unit/KiloBIT"},{"@id":"http://qudt.org/vocab/unit/KiloBYTE"},{"@id":"http://qudt.org/vocab/unit/MebiBIT"},{"@id":"http://qudt.org/vocab/unit/MebiBYTE"},{"@id":"http://qudt.org/vocab/unit/MegaBIT"},{"@id":"http://qudt.org/vocab/unit/MegaBYTE"},{"@id":"http://qudt.org/vocab/unit/OCTET"},{"@id":"http://qudt.org/vocab/unit/PebiBIT"},{"@id":"http://qudt.org/vocab/unit/PebiBYTE"},{"@id":"http://qudt.org/vocab/unit/PetaBIT"},{"@id":"http://qudt.org/vocab/unit/PetaBYTE"},{"@id":"http://qudt.org/vocab/unit/TebiBIT"},{"@id":"http://qudt.org/vocab/unit/TebiBYTE"},{"@id":"http://qudt.org/vocab/unit/TeraBIT"},{"@id":"http://qudt.org/vocab/unit/TeraBYTE"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfData"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AmountOfData","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Data Capacity","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfData"}]},{"@id":"http://qudt.org/vocab/quantitykind/DataRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The frequency derived from the period of time required to transmit one bit. This represents the amount of\n    data transferred per second by a communications channel or a computing or storage device. Data rate is measured in units of\n    bits per second (written \"b/s\" or \"bps\"), bytes per second (Bps), or baud. When applied to data rate, the multiplier prefixes\n    \"kilo-\", \"mega-\", \"giga-\", etc. (and their abbreviations, \"k\", \"M\", \"G\", etc.) always denote powers of 1000. For example, 64\n    kbps is 64,000 bits per second. This contrasts with units of storage which use different prefixes to denote multiplication by\n    powers of 1024, for example 1 kibibit = 1024 bits.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/BYTE-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/ExaBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/GigaBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/GigaBYTE-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloBYTE-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MegaBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MegaBYTE-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/OCTET-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PetaBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/TeraBIT-PER-SEC"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Data_rate","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The frequency derived from the period of time required to transmit one bit. This represents the\n    amount of data transferred per second by a communications channel or a computing or storage device. Data rate is measured in\n    units of bits per second (written \"b/s\" or \"bps\"), bytes per second (Bps), or baud. When applied to data rate, the multiplier\n    prefixes \"kilo-\", \"mega-\", \"giga-\", etc. (and their abbreviations, \"k\", \"M\", \"G\", etc.) always denote powers of 1000. For\n    example, 64 kbps is 64,000 bits per second. This contrasts with units of storage which use different prefixes to denote\n    multiplication by powers of 1024, for example 1 kibibit = 1024 bits.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:DataRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Data Rate","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/DataTransmissionRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The rate at which data is transmitted over a communications channel: a specialisation of\n    quantitykind:DataRate for the transmission context specifically (DataRate itself also covers non-transmission\n    contexts, such as storage read/write or bus throughput).\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/BYTE-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/ExaBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/GigaBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/GigaBYTE-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloBYTE-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MegaBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MegaBYTE-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/OCTET-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PetaBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/TeraBIT-PER-SEC"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ216#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/DataRate"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:DataRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Data Transmission Rate","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DataRate"}]},{"@id":"http://qudt.org/vocab/quantitykind/DatasetOfBits","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A quantity of data expressed as a number of bits. The same quantity as quantitykind:BitDataVolume, from\n    a different source vocabulary (IEC 61360).\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BIT"},{"@id":"http://qudt.org/vocab/unit/ExaBIT"},{"@id":"http://qudt.org/vocab/unit/ExbiBIT"},{"@id":"http://qudt.org/vocab/unit/GibiBIT"},{"@id":"http://qudt.org/vocab/unit/GigaBIT"},{"@id":"http://qudt.org/vocab/unit/KibiBIT"},{"@id":"http://qudt.org/vocab/unit/KiloBIT"},{"@id":"http://qudt.org/vocab/unit/MebiBIT"},{"@id":"http://qudt.org/vocab/unit/MegaBIT"},{"@id":"http://qudt.org/vocab/unit/PebiBIT"},{"@id":"http://qudt.org/vocab/unit/PetaBIT"},{"@id":"http://qudt.org/vocab/unit/TebiBIT"},{"@id":"http://qudt.org/vocab/unit/TeraBIT"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/BitDataVolume"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD027","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD027","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfData"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:DatasetOfBits","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dataset of Bits","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfData"}]},{"@id":"http://qudt.org/vocab/quantitykind/DatasetOfBytes","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A quantity of data expressed as a number of bytes. The same quantity as\n    quantitykind:ByteDataVolume, from a different source vocabulary (IEC 61360).\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BYTE"},{"@id":"http://qudt.org/vocab/unit/ExaBYTE"},{"@id":"http://qudt.org/vocab/unit/ExbiBYTE"},{"@id":"http://qudt.org/vocab/unit/GibiBYTE"},{"@id":"http://qudt.org/vocab/unit/GigaBYTE"},{"@id":"http://qudt.org/vocab/unit/KibiBYTE"},{"@id":"http://qudt.org/vocab/unit/KiloBYTE"},{"@id":"http://qudt.org/vocab/unit/MebiBYTE"},{"@id":"http://qudt.org/vocab/unit/MegaBYTE"},{"@id":"http://qudt.org/vocab/unit/OCTET"},{"@id":"http://qudt.org/vocab/unit/PebiBYTE"},{"@id":"http://qudt.org/vocab/unit/PetaBYTE"},{"@id":"http://qudt.org/vocab/unit/TebiBYTE"},{"@id":"http://qudt.org/vocab/unit/TeraBYTE"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ByteDataVolume"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD028","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD028","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfData"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:DatasetOfBytes","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dataset of Bytes","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfData"}]},{"@id":"http://qudt.org/vocab/quantitykind/Debye-WallerFactor","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Debye-Waller Factor\" (DWF), named after Peter Debye and Ivar Waller, is used in condensed matter physics\n    to describe the attenuation of x-ray scattering or coherent neutron scattering caused by thermal motion. Also, a factor by\n    which the intensity of a diffraction line is reduced because of the lattice vibrations.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/DebyeWallerFactor"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Debye–Waller_factor","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$u = R - R_0$, where $R$ is the particle position vector and $R_0$ is the equilibrium position vector of a particle.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Debye-Waller Factor\" (DWF), named after Peter Debye and Ivar Waller, is used in condensed matter\n    physics to describe the attenuation of x-ray scattering or coherent neutron scattering caused by thermal motion. Also, a\n    factor by which the intensity of a diffraction line is reduced because of the lattice vibrations.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"D, B","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q902587"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Debye-Waller Factor","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/DebyeAngularFrequency","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Debye Angular Frequency\" is the cut-off angular frequency in the Debye model of the vibrational spectrum\n    of a solid.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG-PER-HR"},{"@id":"http://qudt.org/vocab/unit/DEG-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/DEG-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PlanckFrequency_Ang"},{"@id":"http://qudt.org/vocab/unit/RAD-PER-HR"},{"@id":"http://qudt.org/vocab/unit/RAD-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/RAD-PER-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Debye_model#Debye_frequency","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\omega_b$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Debye Angular Frequency\" is the cut-off angular frequency in the Debye model of the vibrational\n    spectrum of a solid.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/AngularFrequency"},{"@id":"http://qudt.org/vocab/quantitykind/AngularVelocity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q105580986"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AngularFrequency","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:AngularVelocity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Debye Angular Frequency","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AngularFrequency"},{"@id":"http://qudt.org/vocab/quantitykind/AngularVelocity"}]},{"@id":"http://qudt.org/vocab/quantitykind/DebyeAngularWavenumber","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Debye Angular Wavenumber\" is the cut-off angular wavenumber in the Debye model of the vibrational\n    spectrum of a solid.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG-PER-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Debye Angular Wavenumber\" is the cut-off angular wavenumber in the Debye model of the vibrational\n    spectrum of a solid.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/AngularWavenumber"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"q_D","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q105554370"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:DebyeAngularWavenumber","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Debye Angular Wavenumber","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AngularWavenumber"}]},{"@id":"http://qudt.org/vocab/quantitykind/DebyeTemperature","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Debye Temperature\" is the temperature at which the highest-frequency mode (and hence all modes) are\n    excited.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Debye_model","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\Theta_D = \\frac{\\hbar\\omega_D}{k}$, where $k$ is the Boltzmann constant, $\\hbar$ is the reduced Planck constant, and $\\omega_D$ is the Debye angular frequency.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Theta_D$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Debye Temperature\" is the temperature at which the highest-frequency mode (and hence all modes)\n    are excited.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q3517821"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:DebyeTemperature","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Debye Temperature","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/DebyeWallerFactor","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Debye-Waller Factor\" (DWF), named after Peter Debye and Ivar Waller, is used in condensed matter physics\n    to describe the attenuation of x-ray scattering or coherent neutron scattering caused by thermal motion. Also, a factor by\n    which the intensity of a diffraction line is reduced because of the lattice vibrations.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Debye–Waller_factor","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$u = R - R_0$, where $R$ is the particle position vector and $R_0$ is the equilibrium position vector of a particle.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Debye-Waller Factor\" (DWF), named after Peter Debye and Ivar Waller, is used in condensed matter\n    physics to describe the attenuation of x-ray scattering or coherent neutron scattering caused by thermal motion. Also, a\n    factor by which the intensity of a diffraction line is reduced because of the lattice vibrations.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"D, B","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q902587"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:DebyeWallerFactor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Debye-Waller Factor","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/DecayConstant","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Decay Constant\" is the proportionality between the size of a population of radioactive atoms and the\n    rate at which the population decreases because of radioactive decay.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PER-DAY"},{"@id":"http://qudt.org/vocab/unit/PER-HR"},{"@id":"http://qudt.org/vocab/unit/PER-MIN"},{"@id":"http://qudt.org/vocab/unit/PER-MO"},{"@id":"http://qudt.org/vocab/unit/PER-MilliSEC"},{"@id":"http://qudt.org/vocab/unit/PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PER-WK"},{"@id":"http://qudt.org/vocab/unit/PER-YR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.britannica.com/EBchecked/topic/154945/decay-constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Exponential_decay","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"Relative variation $\\frac{dN}{N}$ of the number $N$ of atoms or nuclei in a system, due to spontaneous emission from these atoms or nuclei during an infinitesimal time interval, divided by its duration $dt$, thus $\\lambda = -\\frac{1}{N}\\frac{dN}{dt}$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\lambda$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/InverseTime"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Decay Constant\" is the proportionality between the size of a population of radioactive atoms\n    and the rate at which the population decreases because of radioactive decay.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q11477200"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:DecayConstant","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Decay Constant","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/InverseTime"}]},{"@id":"http://qudt.org/vocab/quantitykind/DegreeOfDissociation","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Degree of Dissociation\" is the fraction of original solute molecules that have dissociated.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Faraday_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Dissociation_(chemistry)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\alpha$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Degree of Dissociation\" is the fraction of original solute molecules that have dissociated.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q907334"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:DegreeOfDissociation","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Degree of Dissociation","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Density","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The mass density or density of a material is defined as its mass per unit volume. The symbol most often\n    used for density is $\\rho$. Mathematically, density is defined as mass divided by volume: $\\rho = m/V$, where $\\rho$ is the\n    density, $m$ is the mass, and $V$ is the volume. In some cases, density is also defined as its weight per unit volume,\n    although this quantity is more properly called specific weight.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEGREE_BALLING"},{"@id":"http://qudt.org/vocab/unit/DEGREE_BAUME"},{"@id":"http://qudt.org/vocab/unit/DEGREE_BAUME_US_HEAVY"},{"@id":"http://qudt.org/vocab/unit/DEGREE_BAUME_US_LIGHT"},{"@id":"http://qudt.org/vocab/unit/DEGREE_BRIX"},{"@id":"http://qudt.org/vocab/unit/DEGREE_OECHSLE"},{"@id":"http://qudt.org/vocab/unit/DEGREE_PLATO"},{"@id":"http://qudt.org/vocab/unit/DEGREE_TWADDELL"},{"@id":"http://qudt.org/vocab/unit/FemtoGM-PER-L"},{"@id":"http://qudt.org/vocab/unit/GM-PER-CentiM3"},{"@id":"http://qudt.org/vocab/unit/GM-PER-DeciL"},{"@id":"http://qudt.org/vocab/unit/GM-PER-DeciM3"},{"@id":"http://qudt.org/vocab/unit/GM-PER-L"},{"@id":"http://qudt.org/vocab/unit/GM-PER-M3"},{"@id":"http://qudt.org/vocab/unit/GM-PER-MilliL"},{"@id":"http://qudt.org/vocab/unit/GRAIN-PER-GAL_IMP"},{"@id":"http://qudt.org/vocab/unit/GRAIN-PER-GAL_US"},{"@id":"http://qudt.org/vocab/unit/GRAIN-PER-M3"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-CentiM3"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-DeciM3"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-L"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M3"},{"@id":"http://qudt.org/vocab/unit/LB-PER-FT3"},{"@id":"http://qudt.org/vocab/unit/LB-PER-GAL_IMP"},{"@id":"http://qudt.org/vocab/unit/LB-PER-GAL_UK"},{"@id":"http://qudt.org/vocab/unit/LB-PER-GAL_US"},{"@id":"http://qudt.org/vocab/unit/LB-PER-IN3"},{"@id"