":"de"},{"@value":"Square Meter per Joule","@language":"en-us"},{"@value":"Square Metre per Joule","@language":"en"},{"@value":"Square Metre per Joule","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Čtvereční Metr na Joule","@language":"cs"},{"@value":"Τετραγωνικό Μέτρο ανά Τζάουλ","@language":"el"},{"@value":"Квадратен Метър на Джаул","@language":"bg"},{"@value":"Квадратный Метр на Джоуль","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/M2-PER-K","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$m2-per-k$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H-1T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2933"},{"@id":"_:n3-2934"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AreaThermalExpansion"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m²/K","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m2.K-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AreaThermalExpansion"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Kvadratni Meter na Kelvin","@language":"sl"},{"@value":"Meter Persegi per Kelvin","@language":"ms"},{"@value":"Metr Kwadratowy na Kelwin","@language":"pl"},{"@value":"Metrekare per Kelvin","@language":"tr"},{"@value":"Metro Cuadrado por Kelvin","@language":"es"},{"@value":"Metro Quadrado por Kelvin","@language":"pt"},{"@value":"Metro Quadrato per Kelvin","@language":"it"},{"@value":"Metru Pătrat pe Kelvin","@language":"ro"},{"@value":"Metrum Quadratum per Kelvin","@language":"la"},{"@value":"Mètre Carré par Kelvin","@language":"fr"},{"@value":"Quadratmeter pro Kelvin","@language":"de"},{"@value":"Square Meter per Kelvin","@language":"en-us"},{"@value":"Square Metre per Kelvin","@language":"en"},{"@value":"Square Metre per Kelvin","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Čtvereční Metr na Kelvin","@language":"cs"},{"@value":"Τετραγωνικό Μέτρο ανά Κέλβιν","@language":"el"},{"@value":"Квадратен Метър на Келвин","@language":"bg"},{"@value":"Квадратный Метр на Кельвин","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/M2-PER-KiloGM","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\n  Square Meter Per Kilogram (m2/kg) is a unit in the category of Specific Area.\n  It is also known as square meters per kilogram, square metre per kilogram, square metres per kilogram,\n   square meter/kilogram, square metre/kilogram.\n   This unit is commonly used in the SI unit system.\n  Square Meter Per Kilogram (m2/kg) has a dimension of M-1L2 where $M$ is mass, and $L$ is length.\n  This unit is the standard SI unit in this category.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$m^2/kg$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2935"},{"@id":"_:n3-2936"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MassAttenuationCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificSurfaceArea"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M2"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA750","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA750","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m²/kg","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m2.kg-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"D21","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MassAttenuationCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificSurfaceArea"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q86200529"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Kvadratni Meter na Kilogram","@language":"sl"},{"@value":"Meter Persegi per Kilogram","@language":"ms"},{"@value":"Metr Kwadratowy na Kilogram","@language":"pl"},{"@value":"Metrekare per Kilogram","@language":"tr"},{"@value":"Metro Cuadrado por Kilogramo","@language":"es"},{"@value":"Metro Quadrado por Quilograma","@language":"pt"},{"@value":"Metro Quadrato per Chilogrammo","@language":"it"},{"@value":"Metru Pătrat pe Kilogram","@language":"ro"},{"@value":"Metrum Quadratum per Chiliogramma","@language":"la"},{"@value":"Mètre Carré par Kilogramme","@language":"fr"},{"@value":"Quadratmeter pro Kilogramm","@language":"de"},{"@value":"Square Meter per Kilogram","@language":"en-us"},{"@value":"Square Metre per Kilogram","@language":"en"},{"@value":"Square Metre per Kilogram","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Čtvereční Metr na Kilogram","@language":"cs"},{"@value":"Τετραγωνικό Μέτρο ανά Χιλιόγραμμο","@language":"el"},{"@value":"Квадратен Метър на Килограм","@language":"bg"},{"@value":"Квадратный Метр на Килограмм","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/M2-PER-KiloW","@type":["http://qudt.org/schema/qudt/Unit"],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.001","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E-3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M-1H0T3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2937"},{"@id":"_:n3-2938"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AreaPerPower"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/KiloW-PER-M2"}],"http://qudt.org/schema/qudt/plainTextDescript