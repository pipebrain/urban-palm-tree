tp://qudt.org/vocab/unit/PlanckLength"},{"@id":"http://qudt.org/vocab/unit/ROD"},{"@id":"http://qudt.org/vocab/unit/YD"},{"@id":"http://qudt.org/vocab/unit/ZOLL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Half-value_layer","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Half-Value Thickness\" is the thickness of the material at which the intensity of radiation\n    entering it is reduced by one half.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"d_{1/2}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q127526"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Half-Value Thickness","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}]},{"@id":"http://qudt.org/vocab/quantitykind/HallCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Hall Coefficient\" is defined as the ratio of the induced electric field to the product of the current\n    density and the applied magnetic field.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/M3-PER-C"},{"@id":"http://qudt.org/vocab/unit/V-IN2-PER-LB_F"},{"@id":"http://qudt.org/vocab/unit/V-PER-BAR"},{"@id":"http://qudt.org/vocab/unit/V-PER-PA"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ423#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L3I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD060","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD060","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Hall_effect","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"In an isotropic conductor, the relation between electric field strength, $E$, and electric current density, $J$ is $E = \\rho J + R_H(B X J)$, where $\\rho$ is resistivity, and $B$ is magnetic flux density.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Hall Coefficient\" is defined as the ratio of the induced electric field to the product of the\n    current density and the applied magnetic field.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"R_H, A_H","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q997439"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:HallCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Hall Coefficient","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/HamiltonFunction","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The Hamilton function, or Hamiltonian, $H$ of a mechanical system is the Legendre transform of the\n    Lagrange function, $H = \\sum_i p_i\\dot{q_i} - L$, expressed in terms of the generalized coordinates $q_i$ and their\n    conjugate momenta $p_i$. When the constraints and the potential are independent of time it equals the total energy (kinetic\n    plus potential) of the system, and it accordingly has the dimension of energy.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ERG"},{"@id":"http://qudt.org/vocab/unit/EV"},{"@id":"http://qudt.org/vocab/unit/J"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Hamiltonian_mechanics","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$H = \\sum p_i\\dot{q_i} - L$, where $p_i$ is a generalized momentum, $\\dot{q_i}$ is a generalized velocity, and $L$ is the Lagrange function.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The Hamilton function, or Hamiltonian, H of a mechanical system is the Legendre transform of the\n    Lagrange function, H = sum_i p_i q_i-dot - L, expressed in terms of the generalized coordinates q_i and their conjugate\n    momenta p_i. When the constraints and the potential are independent of time it equals the total energy (kinetic plus\n    potential) of the system, and it accordingly has the dimension of energy.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"H","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:HamiltonFunction","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Hamilton Function","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}]},{"@id":"http://qudt.org/vocab/quantitykind/HeadEndPressure","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"HEP","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ATM"},{"@id":"http://qudt.org/vocab/unit/ATM_T"},{"@id":"http://qudt.org/vocab/unit/BAR"},{"@id":"http://qudt.org/vocab/unit/BARAD"},{"@id":"http://qudt.org/vocab/unit/BARYE"},{"@id":"http://qudt.org/vocab/unit/BAR_A"},{"@id":"http://qudt.org/vocab/unit/CentiBAR"},{"@id":"http://qudt.org/vocab/unit/CentiM_H2O"},{"@id":"http://qudt.org/vocab/unit/CentiM_H2O_4DEG_C"},{"@id":"http://qudt.org/vocab/unit/CentiM_HG"},{"@id":"http://qudt.org/vocab/unit/CentiM_HG_0DEG_C"},{"@id":"http://qudt.org/vocab/unit/DYN-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/DecaPA"},{"@id":"http://qudt.org/vocab/unit/DeciBAR"},{"@id":"http://qudt.org/vocab/unit/FT_H2O"},{"@id":"http://qudt.org/vocab/unit/FT_H2O_39dot2DEG_F"},{"@id":"http://qudt.org/vocab/unit/FT_HG"},{"@id":"http://qudt.org/vocab/unit/GM_F-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/GigaPA"},{"@id":"http://qudt.org/vocab/unit/HectoBAR"},{"@id":"http://qudt.org/vocab/unit/HectoPA"},{"@id":"http://qudt.org/vocab/unit/IN_H2O"},{"@id":"http://qudt.org/vocab/unit/IN_H2O_39dot2DEG_F"},{"@id":"http://qudt.org/vocab/unit/IN_H2O_60DEG_F"},{"@id":"http://qudt.org/vocab/unit/IN_HG"},{"@id":"http://qudt.org/vocab/unit/IN_HG_32DEG_F"},{"@id":"http://qudt.org/vocab/unit/IN_HG_60DEG_F"},{"@id":"http://qudt.org/vocab/unit/KIP_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/KiloBAR"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M-SEC2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F-PER-M2"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-M2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/KiloPA"},{"@id":"http://qudt.org/vocab/unit/KiloPA_A"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/M_H2O"},{"@id":"http://qudt.org/vocab/unit/MegaBAR"},{"@id":"http://qudt.org/vocab/unit/MegaN-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MegaPA"},{"@id":"http://qudt.org/vocab/unit/MegaPSI"},{"@id":"http://qudt.org/vocab/unit/MicroATM"},{"@id":"http://qudt.org/vocab/unit/MicroBAR"},{"@id":"http://qudt.org/vocab/unit/MicroPA"},{"@id":"http://qudt.org/vocab/unit/MicroTORR"},{"@id":"http://qudt.org/vocab/unit/MilliBAR"},{"@id":"http://qudt.org/vocab/unit/MilliBAR_A"},{"@id":"http://qudt.org/vocab/unit/MilliM_H2O"},{"@id":"http://qudt.org/vocab/unit/MilliM_HG"},{"@id":"http://qudt.org/vocab/unit/MilliM_HGA"},{"@id":"http://qudt.org/vocab/unit/MilliPA"},{"@id":"http://qudt.org/vocab/unit/MilliTORR"},{"@id":"http://qudt.org/vocab/unit/N-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/N-PER-M2"},{"@id":"http://qudt.org/vocab/unit/N-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/PA"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/PSI"},{"@id":"http://qudt.org/vocab/unit/PicoPA"},{"@id":"http://qudt.org/vocab/unit/PlanckPressure"},{"@id":"http://qudt.org/vocab/unit/TORR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Pressure"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ForcePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Head End Pressure","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Pressure"}]},{"@id":"http://qudt.org/vocab/quantitykind/HeartRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The number of heartbeats per unit of time, usually per minute. The heart rate is based on the number of\n    contractions of the ventricles (the lower chambers of the heart). The heart rate may be too fast (tachycardia) or too slow\n    (bradycardia). The average adult pulse rate at rest is 60–80 per minute, but exercise, injury, illness, and emotion may\n    produce much faster rates.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BEAT-PER-MIN"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Heart_rate","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.oxfordreference.com/display/10.1093/oi/authority.20110803100354463","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/CountRate"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The number of heartbeats per unit of time, usually per minute. The heart rate is based on the\n    number of contractions of the ventricles (the lower chambers of the heart). The heart rate may be too fast (tachycardia) or\n    too slow (bradycardia). The average adult pulse rate at rest is 60–80 per minute, but exercise, injury, illness, and emotion\n    may produce much faster rates.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1073121"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:HeartRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Heart Rate","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/CountRate"}]},{"@id":"http://qudt.org/vocab/quantitykind/Heat","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Heat\" is the energy transferred by a thermal process.  Heat can be measured in terms of the dynamical\n    units of energy, as the erg, joule, etc., or in terms of the amount of energy required to produce a definite thermal change in\n    some substance, as, for example, the energy required per degree to raise the temperature of a unit mass of water at some\n    temperature ( calorie, Btu).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"heat","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_39DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_59DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_60DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_IT"},{"@id":"http://qudt.org/vocab/unit/BTU_MEAN"},{"@id":"http://qudt.org/vocab/unit/BTU_TH"},{"@id":"http://qudt.org/vocab/unit/CAL_15DEG_C"},{"@id":"http://qudt.org/vocab/unit/CAL_20DEG_C"},{"@id":"http://qudt.org/vocab/unit/CAL_IT"},{"@id":"http://qudt.org/vocab/unit/CAL_MEAN"},{"@id":"http://qudt.org/vocab/unit/CAL_TH"},{"@id":"http://qudt.org/vocab/unit/GigaJ"},{"@id":"http://qudt.org/vocab/unit/J"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH"},{"@id":"http://qudt.org/vocab/unit/KiloCAL"},{"@id":"http://qudt.org/vocab/unit/KiloCAL_IT"},{"@id":"http://qudt.org/vocab/unit/KiloCAL_Mean"},{"@id":"http://qudt.org/vocab/unit/KiloCAL_TH"},{"@id":"http://qudt.org/vocab/unit/KiloJ"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT"},{"@id":"http://qudt.org/vocab/unit/MegaJ"},{"@id":"http://qudt.org/vocab/unit/NanoJ"},{"@id":"http://qudt.org/vocab/unit/PicoJ"},{"@id":"http://qudt.org/vocab/unit/THERM_EC"},{"@id":"http://qudt.org/vocab/unit/THERM_US"},{"@id":"http://qudt.org/vocab/unit/THM_EEC"},{"@id":"http://qudt.org/vocab/unit/THM_US"},{"@id":"http://qudt.org/vocab/unit/TON_FG-HR"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Heat","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Heat\" is the energy transferred by a thermal process.  Heat can be measured in terms of the\n    dynamical units of energy, as the erg, joule, etc., or in terms of the amount of energy required to produce a definite thermal\n    change in some substance, as, for example, the energy required per degree to raise the temperature of a unit mass of water at\n    some temperature ( calorie, Btu).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergy"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Q","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q44432"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ThermalEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Heat","@language":"en"},{"@value":"Wärme","@language":"de"},{"@value":"calor","@language":"es"},{"@value":"calore","@language":"it"},{"@value":"cantitate de căldură","@language":"ro"},{"@value":"ciepło","@language":"pl"},{"@value":"jednotka tepla","@language":"cs"},{"@value":"kuantiti haba Haba","@language":"ms"},{"@value":"labor","@language":"la"},{"@value":"quantidade de calor","@language":"pt"},{"@value":"quantité de chaleur","@language":"fr"},{"@value":"toplota","@language":"sl"},{"@value":"ısı miktarı","@language":"tr"},{"@value":"Теплота","@language":"ru"},{"@value":"حرارة","@language":"ar"},{"@value":"کمیت گرما","@language":"fa"},{"@value":"ऊष्मा","@language":"hi"},{"@value":"热量","@language":"zh"},{"@value":"熱量","@language":"ja"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Wärmemenge","@language":"de"},{"@value":"amount of heat","@language":"en"},{"@value":"chaleur","@language":"fr"},{"@value":"jumlah haba","@language":"ms"},{"@value":"quantità di calore","@language":"it"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergy"}]},{"@id":"http://qudt.org/vocab/quantitykind/HeatCapacity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Heat Capacity\" (usually denoted by a capital $C$, often with subscripts), or thermal capacity, is the\n    measurable physical quantity that characterizes the amount of heat required to change a substance's temperature by a given\n    amount. In the International System of Units (SI), heat capacity is expressed in units of joule(s) (J) per kelvin (K).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-DEG_F"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-DEG_R"},{"@id":"http://qudt.org/vocab/unit/EV-PER-K"},{"@id":"http://qudt.org/vocab/unit/J-PER-K"},{"@id":"http://qudt.org/vocab/unit/MegaJ-PER-K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H-1T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD187","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD187","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Heat_capacity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$C = dQ/dT$, where $Q$ is amount of heat and $T$ is thermodynamic temperature.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/HECA"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerTemperature"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"C_P","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q179388"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:HeatCapacity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Heat Capacity","@language":"en"},{"@value":"Wärmekapazität","@language":"de"},{"@value":"capacidad calorífica","@language":"es"},{"@value":"capacidade térmica","@language":"pt"},{"@value":"capacitate termică","@language":"ro"},{"@value":"capacità termica","@language":"it"},{"@value":"capacité thermique","@language":"fr"},{"@value":"isı kapasitesi","@language":"tr"},{"@value":"muatan haba","@language":"ms"},{"@value":"pojemność cieplna","@language":"pl"},{"@value":"tepelná kapacita","@language":"cs"},{"@value":"toplotna kapaciteta","@language":"sl"},{"@value":"теплоёмкость","@language":"ru"},{"@value":"سعة حرارية","@language":"ar"},{"@value":"ظرفیت گرمایی","@language":"fa"},{"@value":"ऊष्मा धारिता","@language":"hi"},{"@value":"热容","@language":"zh"},{"@value":"熱容量","@language":"ja"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerTemperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/HeatCapacityRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The heat capacity ratio, or ratio of specific heats, is the ratio of the heat capacity at constant\n    pressure ($C_P$) to heat capacity at constant volume ($C_V$). For an ideal gas, the heat capacity is constant with temperature\n    ($\\theta$). Accordingly we can express the enthalpy as $H = C_P*\\theta$ and the internal energy as $U = C_V \\cdot \\theta$.\n    Thus, it can also be said that the heat capacity ratio is the ratio between enthalpy and internal energy.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Heat_capacity_ratio","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Heat_capacity_ratio","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H-1T-2D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H-1T-2D0"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q503869"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:HeatCapacityRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Heat Capacity Ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/HeatFlowRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The rate of heat flow between two systems is measured in watts (joules per second). The formula for rate\n    of heat flow is $\\bigtriangleup Q / \\bigtriangleup t = -K \\times A \\times \\bigtriangleup T/x$, where $\\bigtriangleup Q /\n    \\bigtriangleup t$ is the rate of heat flow; $-K$ is the thermal conductivity factor; A is the surface area; $\\bigtriangleup\n    T$ is the change in temperature and $x$ is the thickness of the material. $\\bigtriangleup  T/ x$ is called the temperature\n    gradient and is always negative because of the heat of flow always goes from more thermal energy to less).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloCAL_TH-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloCAL_TH-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloCAL_TH-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/THM_US-PER-HR"},{"@id":"http://qudt.org/vocab/unit/TON_FG"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$heat-flow-rate$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD382","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD382","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Rate_of_heat_flow","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Phi$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q12160631"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:HeatFlowRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Heat Flow Rate","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}]},{"@id":"http://qudt.org/vocab/quantitykind/HeatFlowRatePerArea","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Heat Flux}$ is the heat rate per area. In SI units, heat flux is measured in $W/m^2$. Heat rate\n    is a scalar quantity, while heat flux is a vectorial quantity. To define the heat flux at a certain point in space, one takes\n    the limiting case where the size of the surface becomes infinitesimally small.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-FT2-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-FT2-SEC"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-HR-FT2"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-IN2-SEC"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-SEC-FT2"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-FT2-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-FT2-MIN"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-FT2-SEC"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-CentiM2-MIN"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-CentiM2-SEC"},{"@id":"http://qudt.org/vocab/unit/ERG-PER-CentiM2-SEC"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F-PER-FT2-SEC"},{"@id":"http://qudt.org/vocab/unit/J-PER-CentiM2-DAY"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-CentiM2-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-CentiM2-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/M-PA-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MicroW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MilliW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/NanoW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/PicoW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/W-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/W-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/W-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/W-PER-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Heat_flux","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantit