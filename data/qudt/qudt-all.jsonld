s per meter squared per square root Seconds per degree\n    Kelvin\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalInertia"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Joules per Meter Squared Sqrt(second) Degree Kelvin","@language":"en"},{"@value":"Joules per Meter Squared Sqrt(second) Degree Kelvin","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/J-PER-M2-SEC0pt5-K","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/unit/J-PER-M2-SEC0dot5-K"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.3.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-2L2I0M1H-1T-2dot5D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1874"},{"@id":"_:n3-1875"},{"@id":"_:n3-1876"},{"@id":"_:n3-1877"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalInertia"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A unit of thermal inertia measured as Joules per meter squared per square root Seconds per degree\n    Kelvin\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Joules per Meter Squared Sqrt(second) Degree Kelvin","@language":"en"},{"@value":"Joules per Meter Squared Sqrt(second) Degree Kelvin","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/J-PER-M3","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Joule Per Cubic Meter}$ ($J/m^{3}$) is a unit in the category of Energy density. It is also\n    known as joules per cubic meter, joule per cubic metre, joules per cubic metre, joule/cubic meter, joule/cubic metre. This\n    unit is commonly used in the SI unit system.  It has a dimension of $ML^{-1}T^{-2}$ where $M$ is mass, $L$ is length, and $T$\n    is time. This unit is the standard SI unit in this category.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$j-per-m3$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1878"},{"@id":"_:n3-1879"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectromagneticEnergyDensity"},{"@id":"http://qudt.org/vocab/quantitykind/EnergyDensity"},{"@id":"http://qudt.org/vocab/quantitykind/RadiantEnergyDensity"},{"@id":"http://qudt.org/vocab/quantitykind/VolumicElectromagneticEnergy"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA180","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA180","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J/m³","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"J.m-3","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"B8","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectromagneticEnergyDensity"},{"@id":"http://qudt.org/vocab/quantitykind/EnergyDensity"},{"@id":"http://qudt.org/vocab/quantitykind/RadiantEnergyDensity"},{"@id":"http://qudt.org/vocab/quantitykind/VolumicElectromagneticEnergy"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q69424806"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dżul na Metr Sześcienny","@language":"pl"},{"@value":"Joule na Kubični Meter","@language":"sl"},{"@value":"Joule na Metr Krychlový","@language":"cs"},{"@value":"Joule par Mètre Cube","@language":"fr"},{"@value":"Joule pe Metru Cub","@language":"ro"},{"@value":"Joule per Cubic Meter","@language":"en-us"},{"@value":"Joule per Cubic Metre","@language":"en"},{"@value":"Joule per Cubic Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Joule per Meter Kubik","@language":"ms"},{"@value":"Joule per Metreküp","@language":"tr"},{"@value":"Joule per Metro Cubo","@language":"it"},{"@value":"Joule por Metro Cúbico","@language":"pt"},{"@value":"Joule pro Kubikmeter","@language":"de"},{"@value":"Joulium per Metrum Cubicum","@language":"la"},{"@value":"Julio por Metro Cúbico","@language":"es"},{"@value":"Τζάουλ ανά Κυβικό Μέτρο","@language":"el"},{"@value":"Джаул на Кубичен Метър","@language":"bg"},{"@value":"Джоуль на Кубический Метр","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/J-PER-M3-K","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Joule per Cubic Meter Kelvin}$ is a unit for 'Volumetric Heat Capacity' expressed as $J/(m^{3}\n    K)$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$J/(m^{3} K)$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H-1T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1880"},{"@id":"_:n3-1881"},{"@id":"_:n3-1882"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/VolumetricHeatCapacity"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J/(m³·K)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"J.m-3.K-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/VolumetricHeatCapacity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q3186734"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dżul na Metr Sześcienny Kelwin","@language":"pl"},{"@value":"Joule na Kubični Meter Kelvin","@language":"sl"},{"@value":"Joule na Metr Krychlový Kelvin","@language":"cs"},{"@value":"Joule par Mètre Cube Kelvin","@language":"fr"},{"@value":"Joule pe Metru Cub Kelvin","@language":"ro"},{"@value":"Joule per Cubic Meter Kelvin","@language":"en-us"},{"@value":"Joule per Cubic Metre Kelvin","@language":"en"},{"@value":"Joule per Cubic Metre Kelvin","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Joule per Meter Kubik Kelvin","@language":"ms"},{"@value":"Joule per Metreküp Kelvin","@language":"tr"},{"@value":"Joule per Metro Cubo Kelvin","@language":"it"},{"@value":"Joule por Metro Cúbico Kelvin","@language":"pt"},{"@value":"Joule pro Kubikmeter Kelvin","@language":"de"},{"@value":"Joulium per Metrum Cubicum Kelvin","@language":"la"},{"@value":"Julio por Metro Cúbico Kelvin","@language":"es"},{"@value":"Τζάουλ ανά Κυβικό Μέτρο Κέλβιν","@language":"el"},{"@value":"Джаул на Кубичен Метър Келвин","@language":"bg"},{"@value":"Джоуль на Кубический Метр Кельвин","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/J-PER-M4","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The unit $\\textit{Joule Per Quartic Meter}$ ($J/m^4$) is a unit for the spectral concentration of\n    radiant energy density (in terms of wavelength), or the spectral radiant energy density (in terms of wave length). This unit\n    is commonly used in the SI unit system.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$J/m^4$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1883"},{"@id":"_:n3-1884"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SpectralConcentrationOfRadiantEnergyDensity"},{"@id":"http://qudt.org/vocab/quantitykind/SpectralRadiantEnergyDensity"},{"@id":"http://qudt.org/vocab/quantitykind/SpectralRadiantEnergyDensityInTermsOfWavelength"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA177","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA177","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J/m⁴","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"J.m-4","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"B14","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SpectralConcentrationOfRadiantEnergyDensity"},{"@id":"http://qudt.org/vocab/quantitykind/SpectralRadiantEnergyDensity"},{"@id":"http://qudt.org/vocab/quantitykind/SpectralRadiantEnergyDensityInTermsOfWavelength"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q106867426"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Joule per Quartic Meter","@language":"en-us"},{"@value":"Joule per Quartic Metre","@language":"en"},{"@value":"Joule per Quartic Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Joule pro Meter hoch vier","@language":"de"}]},{"@id":"http://qudt.org/vocab/unit/J-PER-MIN","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"quotient from the SI derived unit joule divided by the unit minute","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.01666666666666666666666666666666667","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.666666666666666666666666666666667E-2","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1885"},{"@id":"_:n3-1886"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB444","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB444","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J/min","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"J.min-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"P15","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Joule per Minute","@language":"en"},{"@value":"Joule per Minute","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/J-PER-MOL","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The joule per mole (symbol: $J\\cdot mol^{-1}$) is an SI derived unit of energy per amount of material.\n    Energy is measured in joules, and the amount of material is measured in moles. Physical quantities measured in $J\\cdot\n    mol^{-1}$) usually describe quantities of energy transferred during phase transformations or chemical reactions. Division by\n    the number of moles facilitates comparison between processes involving different quantities of material and between similar\n    processes involving different types of materials. The meaning of such a quantity is always context-dependent and, particularly\n    for chemical reactions, is dependent on the (possibly arbitrary) definition of a 'mole' for a particular process.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$J/mol$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1887"},{"@id":"_:n3-1888"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ChemicalAffinity"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPolarizability"},{"@id":"http://qudt.org/vocab/quantitykind/MolarEnergy"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA183","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA183","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J/mol","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"J.mol-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"B15","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ChemicalAffinity"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPolarizability"},{"@id":"http://qudt.org/vocab/quantitykind/MolarEnergy"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q13035094"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dżul na Mol","@language":"pl"},{"@value":"Joule na Mol","@language":"cs"},{"@value":"Joule na Mol","@language":"sl"},{"@value":"Joule par Mole","@language":"fr"},{"@value":"Joule pe Mol","@language":"ro"},{"@value":"Joule per Mol","@language":"tr"},{"@value":"Joule per Mole","@language":"en"},{"@value":"Joule per Mole","@language":"it"},{"@value":"Joule per Mole","@language":"ms"},{"@value":"Joule per Mole","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Joule por Mol","@language":"pt"},{"@value":"Joule pro Mol","@language":"de"},{"@value":"Joulium per Moles","@language":"la"},{"@value":"Julio por Mol","@language":"es"},{"@value":"Τζάουλ ανά Μολ","@language":"el"},{"@value":"Джаул на Мол","@language":"bg"},{"@value":"Джоуль на Моль","@language":"ru"},{"@value":"جول لكل مول","@language":"ar"},{"@value":"ژول بر مول","@language":"fa"},{"@value":"जूल प्रति मोल (इकाई)","@language":"hi"},{"@value":"ジュール毎立方メートル","@language":"ja"},{"@value":"焦耳每摩尔","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/J-PER-MOL-K","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Energy needed to heat one mole of substance by 1 Kelvin, under standard conditions (not standard\n    temperature and pressure STP). The standard molar entropy is usually given the symbol S, and has units of joules per mole\n    kelvin ( $ J\\cdot mol^{-1} K^{-1}$). Unlike standard enthalpies of formation, the value of S is an absolute. That is, an\n    element in its standard state has a nonzero value of S at room temperature.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$J/(mol-K)$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H-1T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1889"},{"@id":"_:n3-1890"},{"@id":"_:n3-1891"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MolarEntropy"},{"@id":"http://qudt.org/vocab/quantitykind/MolarHeatCapacity"},{"@id":"http://qudt.org/vocab/quantitykind/MolarThermalCapacity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA184","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA184","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J/(mol·K)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"J.mol-1.K-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"B16","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MolarEntropy"},{"@id":"http://qudt.org/vocab/quantitykind/MolarHeatCapacity"},{"@id":"http://qudt.org/vocab/quantitykind/MolarThermalCapacity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q20966455"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dżul na Mol Kelwin","@language":"pl"},{"@value":"Joule na Mol Kelvin","@language":"cs"},{"@value":"Joule na Mol Kelvin","@language":"sl"},{"@value":"Joule par Mole Kelvin","@language":"fr"},{"@value":"Joule pe Mol Kelvin","@language":"ro"},{"@value":"Joule per Mol Kelvin","@language":"tr"},{"@value":"Joule per Mole Kelvin","@language":"en"},{"@value":"Joule per Mole Kelvin","@language":"it"},{"@value":"Joule per Mole Kelvin","@language":"ms"},{"@value":"Joule per Mole Kelvin","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Joule por Mol Kelvin","@language":"pt"},{"@value":"Joule pro Mol Kelvin","@language":"de"},{"@value":"Joulium per Moles Kelvin","@language":"la"},{"@value":"Julio por Mol Kelvin","@language":"es"},{"@value":"Τζάουλ ανά Μολ Κέλβιν","@language":"el"},{"@value":"Джаул на Мол Келвин","@language":"bg"},{"@value":"Джоуль на Моль Кельвин","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/J-PER-SEC","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"SI derived unit joule divided by the SI base unit second","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1892"},{"@id":"_:n3-1893"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB356","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB356","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"SI derived unit joule divided by the SI base unit second","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J/s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"J.s-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"P14","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q92711514"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dżul na Sekunda","@language":"pl"},{"@value":"Joule na Sekunda","@language":"cs"},{"@value":"Joule na Sekunda","@language":"sl"},{"@value":"Joule par Seconde","@language":"fr"},{"@value":"Joule pe Secundă","@language":"ro"},{"@value":"Joule per Saat","@language":"ms"},{"@value":"Joule per Saniye","@language":"tr"},{"@value":"Joule per Second","@language":"en"},{"@value":"Joule per Second","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Joule per Secondo","@language":"it"},{"@value":"Joule por Segundo","@language":"pt"},{"@value":"Joule pro Sekunde","@language":"de"},{"@value":"Joulium per Secundum","@language":"la"},{"@value":"Julio por Segundo","@language":"es"},{"@value":"Τζάουλ ανά Δευτερόλεπτο","@language":"el"},{"@value":"Джаул на Секунда","@language":"bg"},{"@value":"Джоуль на Секунда","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/J-PER-T","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The magnetic moment of a magnet is a quantity that determines the force that the magnet can exert on\n    electric currents and the torque that a magnetic field will exert on it. A loop of electric current, a bar magnet, an\n    electron, a molecule, and a planet all have magnetic moments. The unit for magnetic moment is not a base unit in the\n    International System of Units (SI) and it can be represented in more than one way. For example, in the current loop\n    definition, the area is measured in square meters and I is measured in amperes, so the magnetic moment is measured in\n    ampere-square meters (A m2). In the equation for torque on a moment, the torque is measured in joules and the magnetic field\n    in tesla, so the moment is measured in Joules per Tesla (J u00b7T-1). These two representations are equivalent: 1 A u00b7m2 =\n    1 J u00b7T-1.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$j-per-t$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1894"},{"@id":"_:n3-1895"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticAreaMoment"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticMoment"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB336","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB336","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J/T","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"J.T-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"Q10","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticAreaMoment"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticMoment"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q21088638"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dżul na Tesla","@language":"pl"},{"@value":"Joule na Tesla","@language":"cs"},{"@value":"Joule na Tesla","@language":"sl"},{"@value":"Joule par Tesla","@language":"fr"},{"@value":"Joule pe Tesla","@language":"ro"},{"@value":"Joule per Tesla","@language":"en"},{"@value":"Joule per Tesla","@language":"it"},{"@value":"Joule per Tesla","@language":"ms"},{"@value":"Joule per Tesla","@language":"tr"},{"@value":"Joule per Tesla","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Joule por Tesla","@language":"pt"},{"@value":"Joule pro Tesla","@language":"de"},{"@value":"Joulium per Tesla","@language":"la"},{"@value":"Julio por Tesla","@language":"es"},{"@value":"Τζάουλ ανά Τέσλα","@language":"el"},{"@value":"Джаул на Тесла","@language":"bg"},{"@value":"Джоуль на Тесла","@language":"ru"},{"@value":"جول لكل تسلا","@language":"ar"},{"@value":"ژول بر تسلا","@language":"fa"},{"@value":"जूल प्रति टैस्ला","@language":"hi"},{"@value":"ジュール毎立方メートル","@language":"ja"},{"@value":"焦耳每特斯拉","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/J-PER-T2","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A measure of the diamagnetic energy, for a Bohr-radius spread around a magnetic axis, per square Tesla.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$J T^{-2}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E2L2I0M-1H0T2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1896"},{"@id":"_:n3-1897"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerSquareMagneticFluxDensity"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.eng.famu.fsu.edu/~dommelen/quantum/style_a/elecmagfld.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J/T²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"J.T-2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerSquareMagneticFluxDensity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dżul na Tesla Kwadratowy","@language":"pl"},{"@value":"Joule na Kvadratni Tesla","@language":"sl"},{"@value":"Joule na Čtvereční Tesla","@language":"cs"},{"@value":"Joule par Tesla Carré","@language":"fr"},{"@value":"Joule pe Tesla Pătrat","@language":"ro"},{"@value":"Joule per Square Tesla","@language":"en"},{"@value":"Joule per Square Tesla","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Joule per Tesla Persegi","@language":"ms"},{"@value":"Joule per Tesla Quadrato","@language":"it"},{"@value":"Joule per Teslakare","@language":"tr"},{"@value":"Joule por Tesla Quadrado","@language":"pt"},{"@value":"Joule pro Quadrattesla","@language":"de"},{"@value":"Joulium per Tesla Quadratum","@language":"la"},{"@value":"Julio por Tesla Cuadrado","@language":"es"},{"@value":"Τζάουλ ανά Τετραγωνικό Τέσλα","@language":"el"},{"@value":"Джаул на Квадратен Тесла","@language":"bg"},{"@value":"Джоуль на Квадратный Тесла","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/J-SEC","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\textit{joule-second}$ is a unit equal to a $joule$ multiplied by a second, used to measure action.\n  The joule-second is the unit used for Planck's constant.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1898"},{"@id":"_:n3-1899"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Action"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB151","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB151","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J·s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"J.s","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"B18","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Action"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1709783"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dżul Sekunda","@language":"pl"},{"@value":"Joule Saat","@language":"ms"},{"@value":"Joule Saniye","@language":"tr"},{"@value":"Joule Second","@language":"en"},{"@value":"Joule Second","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Joule Seconde","@language":"fr"},{"@value":"Joule Secondo","@language":"it"},{"@value":"Joule Secundă","@language":"ro"},{"@value":"Joule Segundo","@language":"pt"},{"@value":"Joule Sekunda","@language":"cs"},{"@value":"Joule Sekunda","@language":"sl"},{"@value":"Joule Sekunde","@language":"de"},{"@value":"Joulium Secundum","@language":"la"},{"@value":"Julio Segundo","@language":"es"},{"@value":"Τζάουλ Δευτερόλεπτο","@language":"el"},{"@value":"Джаул Секунда","@language":"bg"},{"@value":"Джоуль Секунда","@language":"ru"},{"@value":"جول ثانية","@language":"ar"},{"@value":"ژول ثانیه","@language":"fa"},{"@value":"जूल सैकण्ड","@language":"hi"},{"@value":"ジュール秒","@language":"ja"},{"@value":"焦耳秒","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/J-SEC-PER-MOL","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Joule Second per Mole}$ is a unit for 'Molar Angular Momentum' expressed as $J s mol^{-1}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$J s mol^{-1}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L2I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1900"},{"@id":"_:n3-1901"},{"@id":"_:n3-1902"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MolarAngularMomentum"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J·s/mol","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"J.s.mol-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MolarAngularMomentum"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dżul Sekunda na Mol","@language":"pl"},{"@value":"Joule Saat per Mole","@language":"ms"},{"@value":"Joule Saniye per Mol","@language":"tr"},{"@value":"Joule Second per Mole","@language":"en"},{"@value":"Joule Second per Mole","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Joule Seconde par Mole","@language":"fr"},{"@value":"Joule Secondo per Mole","@language":"it"},{"@value":"Joule Secundă pe Mol","@language":"ro"},{"@value":"Joule Segundo por Mol","@language":"pt"},{"@value":"Joule Sekunda na Mol","@language":"cs"},{"@value":"Joule Sekunda na Mol","@language":"sl"},{"@value":"Joule Sekunde pro Mol","@language":"de"},{"@value":"Joulium Secundum per Moles","@language":"la"},{"@value":"Julio Segundo por Mol","@language":"es"},{"@value":"Τζάουλ Δευτερόλεπτο ανά Μολ","@language":"el"},{"@value":"Джаул Секунда на Мол","@language":"bg"},{"@value":"Джоуль Секунда на Моль","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/K","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The unit $\\textit{Kelvin}$ is the SI base unit of temperature, previously called the degree Kelvin. One\n    kelvin represents the same temperature difference as one degree Celsius. In 1967 the General Conference on Weights and\n    Measures defined the temperature of the triple point of water (the temperature at which water exists simultaneously in the\n    gaseous, liquid, and solid states) to be exactly 273.16 kelvins. Since this temperature is also equal to 0.01 u00b0C, the\n    temperature in kelvins is always equal to 273.15 plus the temperature in degrees Celsius. The kelvin equals exactly 1.8\n    degrees Fahrenheit. The unit is named for the British mathematician and physicist William Thomson (1824-1907), later known as\n    Lord Kelvin after he was named Baron Kelvin of Largs.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Kelvin","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/BoilingPoint"},{"@id":"http://qudt.org/vocab/quantitykind/CorrelatedColorTemperature"},{"@id":"http://qudt.org/vocab/quantitykind/CurieTemperature"},{"@id":"http://qudt.org/vocab/quantitykind/DebyeTemperature"},{"@id":"http://qudt.org/vocab/quantitykind/FermiTemperature"},{"@id":"http://qudt.org/vocab/quantitykind/FlashPoint"},{"@id":"http://qudt.org/vocab/quantitykind/MeltingPoint"},{"@id":"http://qudt.org/vocab/quantitykind/NeelTemperature"},{"@id":"http://qudt.org/vocab/quantitykind/SuperconductionTransitionTemperature"},{"@id":"http://qudt.org/vocab/quantitykind/Temperature"},{"@id":"http://qudt.org/vocab/quantitykind/TemperatureDifference"},{"@id":"http://qudt.org/vocab/quantitykind/ThermodynamicTemperature"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA185","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA185","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Kelvin?oldid=495075694","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/kelvin"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/SI/units/kelvin"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"K","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"K","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/udunitsCode":[{"@value":"K","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"KEL","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/BoilingPoint"},{"@id":"http://qudt.org/vocab/quantitykind/CorrelatedColorTemperature"},{"@id":"http://qudt.org/vocab/quantitykind/CurieTemperature"},{"@id":"http://qudt.org/vocab/quantitykind/DebyeTemperature"},{"@id":"http://qudt.org/vocab/quantitykind/FermiTemperature"},{"@id":"http://qudt.org/vocab/quantitykind/FlashPoint"},{"@id":"http://qudt.org/vocab/quantitykind/MeltingPoint"},{"@id":"http://qudt.org/vocab/quantitykind/NeelTemperature"},{"@id":"http://qudt.org/vocab/quantitykind/SuperconductionTransitionTemperature"},{"@id":"http://qudt.org/vocab/quantitykind/Temperature"},{"@id":"http://qudt.org/vocab/quantitykind/TemperatureDifference"},{"@id":"http://qudt.org/vocab/quantitykind/ThermodynamicTemperature"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q11579"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Kelvin","@language":"cs"},{"@value":"Kelvin","@language":"de"},{"@value":"Kelvin","@language":"en"},{"@value":"Kelvin","@language":"es"},{"@value":"Kelvin","@language":"fr"},{"@value":"Kelvin","@language":"hu"},{"@value":"Kelvin","@language":"it"},{"@value":"Kelvin","@language":"la"},{"@value":"Kelvin","@language":"ms"},{"@value":"Kelvin","@language":"pt"},{"@value":"Kelvin","@language":"ro"},{"@value":"Kelvin","@language":"sl"},{"@value":"Kelvin","@language":"tr"},{"@value":"Kelvin","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Kelwin","@language":"pl"},{"@value":"Κέλβιν","@language":"el"},{"@value":"Келвин","@language":"bg"},{"@value":"Кельвин","@language":"ru"},{"@value":"קלווין","@language":"he"},{"@value":"كلفن","@language":"ar"},{"@value":"کلوین","@language":"fa"},{"@value":"कैल्विन