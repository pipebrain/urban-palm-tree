age":"en-us"},{"@value":"Cubic Metre per Minute Bar","@language":"en"},{"@value":"Cubic Metre per Minute Bar","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/M3-PER-MIN-K","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"power of the SI base unit metre with the exponent 3 divided by the product out of the unit minute and the\n    SI base unit kelvin\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/categorizedByQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Unknown"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.01666666666666666666666666666666667","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.666666666666666666666666666666667E-2","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H-1T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-3020"},{"@id":"_:n3-3021"},{"@id":"_:n3-3022"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Unknown"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA769","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA769","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m³/(min·K)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m3.min-1.K-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"G71","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Cubic Meter per Minute Kelvin","@language":"en-us"},{"@value":"Cubic Metre per Minute Kelvin","@language":"en"},{"@value":"Cubic Metre per Minute Kelvin","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/M3-PER-MOL","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"<p>The molar volume, symbol $Vm$, is the volume occupied by one mole of a substance (chemical element or\n    chemical compound) at a given temperature and pressure. It is equal to the molar mass (M) divided by the mass density. It has\n    the SI unit cubic metres per mole $m3/mol$, although it is more practical to use the units cubic decimetres per mole $dm3/mol$\n    for gases and cubic centimetres per mole $cm3/mol$ for liquids and solids</p>.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$m^{3} mol^{-1}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-3023"},{"@id":"_:n3-3024"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MolarRefractivity"},{"@id":"http://qudt.org/vocab/quantitykind/MolarVolume"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/MOL-PER-M3"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA771","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA771","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m³/mol","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m3.mol-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"A40","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MolarRefractivity"},{"@id":"http://qudt.org/vocab/quantitykind/MolarVolume"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q21615967"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Cubic Meter per Mole","@language":"en-us"},{"@value":"Cubic Metre per Mole","@language":"en"},{"@value":"Cubic Metre per Mole","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Kubikmeter pro Mol","@language":"de"},{"@value":"Kubični Meter na Mol","@language":"sl"},{"@value":"Meter Kubik per Mole","@language":"ms"},{"@value":"Metr Krychlový na Mol","@language":"cs"},{"@value":"Metr Sześcienny na Mol","@language":"pl"},{"@value":"Metreküp per Mol","@language":"tr"},{"@value":"Metro Cubo per Mole","@language":"it"},{"@value":"Metro Cúbico por Mol","@language":"es"},{"@value":"Metro Cúbico por Mol","@language":"pt"},{"@value":"Metru Cub pe Mol","@language":"ro"},{"@value":"Metrum Cubicum per Moles","@language":"la"},{"@value":"Mètre Cube par Mole","@language":"fr"},{"@value":"Κυβικό Μέτρο ανά Μολ","@language":"el"},{"@value":"Кубичен Метър на Мол","@language":"bg"},{"@value":"Кубический Метр на Моль","@language":"ru"},{"@value":"متر مكعب لكل مول","@language":"ar"},{"@value":"متر مکعب بر مول","@language":"fa"},{"@value":"घन मीटर प्रति मोल (इकाई)","@language":"hi"},{"@value":"立方メートル 毎立方メートル","@language":"ja"},{"@value":"立方米每摩尔","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/M3-PER-MOL-SEC","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A unit that is the SI base unit metre with the exponent 3 divided by the SI base unit mol multiplied by\n    the SI base unit second.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A-1E0L3I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-3025"},{"@id":"_:n3-3026"},{"@id":"_:n3-3027"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AtmosphericHydroxylationRate"},{"@id":"http://qudt.org/vocab/quantitykind/SecondOrderReactionRateConstant"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m³/(mol·s)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m3.mol-1.s-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AtmosphericHydroxylationRate"},{"@id":"http://qudt.org/vocab/quantitykind/SecondOrderReactionRateConstant"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Cubic Meter per Mole Second","@language":"en-us"},{"@value":"Cubic Metre per Mole Second","@la