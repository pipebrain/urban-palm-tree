anguage":"en-us"},{"@value":"Volt per Litre Minute","@language":"en"},{"@value":"Volt per Litre Minute","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/V-PER-M","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The unit $\\{Volt Per Meter (V/m)}$ is a unit in the category of Electric field strength. It is also\n    known as volts per meter, volt/meter, volt/metre, volt per metre, volts per metre. This unit is commonly used in the SI unit\n    system. $\\{Volt Per Meter}$ has a dimension of $MLT^{-3}I^{-1}$ where $M$ is mass, $L$ is length, $T$ is time, and $I$ is\n    electric current. This unit is the standard SI unit in this category.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$V/m$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L1I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-5140"},{"@id":"_:n3-5141"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricField"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricFieldStrength"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA301","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.efunda.com/glossary/units/units--electric_field_strength--volt_per_meter.cfm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA301","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"V/m","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"V.m-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"D50","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricField"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricFieldStrength"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q3562962"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Volt na Meter","@language":"sl"},{"@value":"Volt na Metr","@language":"cs"},{"@value":"Volt par Mètre","@language":"fr"},{"@value":"Volt pe Metru","@language":"ro"},{"@value":"Volt per Meter","@language":"en-us"},{"@value":"Volt per Meter","@language":"ms"},{"@value":"Volt per Metre","@language":"en"},{"@value":"Volt per Metre","@language":"tr"},{"@value":"Volt per Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Volt per Metro","@language":"it"},{"@value":"Volt por Metro","@language":"pt"},{"@value":"Volt pro Meter","@language":"de"},{"@value":"Voltio por Metro","@language":"es"},{"@value":"Voltium per Metrum","@language":"la"},{"@value":"Wolt na Metr","@language":"pl"},{"@value":"Βολτ ανά Μέτρο","@language":"el"},{"@value":"Волт на Метър","@language":"bg"},{"@value":"Вольт на Метр","@language":"ru"},{"@value":"مقياس التبادل، الأس السالب للمتر","@language":"ar"},{"@value":"ولت بر متر","@language":"fa"},{"@value":"प्रति मीटर वोल्ट","@language":"hi"},{"@value":"ボルト毎メートル","@language":"ja"},{"@value":"伏特每米","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/V-PER-M2","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Volt per Square Metre}$ is the divergence at a particular point in a vector field is (roughly)\n    how much the vector field 'spreads out' from that point. Operationally, we take the partial derivative of each of the field\n    with respect to each of its space variables and add all the derivatives together to get the divergence. $\\textit{Electric\n    field}$ ($V/m$) differentiated with respect to distance ($m$) yields $V/(m^2)$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$V m^{-2}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-5142"},{"@id":"_:n3-5143"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerAreaElectricCharge"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"V/m²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"V.m-2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerAreaElectricCharge"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Volt na Kvadratni Meter","@language":"sl"},{"@value":"Volt na Čtvereční Metr","@language":"cs"},{"@value":"Volt par Mètre Carré","@language":"fr"},{"@value":"Volt pe Metru Pătrat","@language":"ro"},{"@value":"Volt per Meter Persegi","@language":"ms"},{"@value":"Volt per Metrekare","@language":"tr"},{"@value":"Volt per Metro Quadrato","@language":"it"},{"@value":"Volt per Square Meter","@language":"en-us"},{"@value":"Volt per Square Metre","@language":"en"},{"@value":"Volt per Square Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Volt por Metro Quadrado","@language":"pt"},{"@value":"Volt pro Quadratmeter","@language":"de"},{"@value":"Voltio por Metro Cuadrado","@language":"es"},{"@value":"Voltium per Metrum Quadratum","@language":"la"},{"@value":"Wolt na Metr Kwadratowy","@language":"pl"},{"@value":"Βολτ ανά Τετραγωνικό Μέτρο","@language":"el"},{"@value":"Волт на Квадратен Метър","@language":"bg"},{"@value":"Вольт на Квадратный Метр","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/V-PER-MicroSEC","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"SI derived unit volt divided by the 0.000001-fold of the SI base unit second","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1000000.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E6","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-4D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-5144"},{"@id":"_:n3-5145"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/PowerPerElectricCharge"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA297","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA297","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"SI derived unit volt divided by the 0.000001-fold of the SI base unit second","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"V/μs","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"V.us-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"H24","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/PowerPerElectricCharge"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Volt na Microsekunda","@language":"cs"},{"@value":"Volt na Microsekunda","@language":"sl"},{"@value":"Volt par Microseconde","@language":"fr"},{"@value":"Volt pe Microsecundă","@language":"ro"},{"@value":"Volt per Microsaat","@language":"ms"},{"@value":"Volt per Microsaniye","@language":"tr"},{"@value":"Volt per Microsecond","@language":"en"},{"@value":"Volt per Microsecond","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Volt per Microsecondo","@language":"it"},{"@value":"Volt pro Microsekunde","@language":"de"},{"@value":"Voltio por Microsegundo","@language":"es"},{"@value":"Wolt na Microsekunda","@language":"pl"}]},{"@id":"http://qudt.org/vocab/unit/V-PER-MilliM","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"SI derived unit volt divided by the 0.001-fold of the SI base unit metre","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1000.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L1I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-5146"},{"@id":"_:n3-5147"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricFieldStrength"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA302","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA302","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"SI derived unit volt divided by the 0.001-fold of the SI base unit metre","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"V/mm","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"V.mm-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"D51","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricFieldStrength"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Volt na Millimeter","@language":"sl"},{"@value":"Volt na Millimetr","@language":"cs"},{"@value":"Volt par Millimètre","@language":"fr"},{"@value":"Volt pe Millimetru","@language":"ro"},{"@value":"Volt per Millimeter","@language":"en-us"},{"@value":"Volt per Millimeter","@language":"ms"},{"@value":"Volt per Millimetre","@language":"en"},{"@value":"Volt per Millimetre","@language":"tr"},{"@value":"Volt per Millimetre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Volt per Millimetro","@language":"it"},{"@value":"Volt pro Millimeter","@language":"de"},{"@value":"Voltio por Millimetro","@language":"es"},{"@value":"Wolt na Millimetr","@language":"pl"}]},{"@id":"http://qudt.org/vocab/unit/V-PER-PA","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"SI derived unit volt divided by the SI derived unit pascal","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L3I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-5148"},{"@id":"_:n3-5149"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/HallCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/PressureBasedElectricVoltage"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB312","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB312","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"V/Pa","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"V.Pa-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"N98","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/HallCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/PressureBasedElectricVoltage"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Volt na Pascal","@language":"cs"},{"@value":"Volt na Pascal","@language":"sl"},{"@value":"Volt par Pascal","@language":"fr"},{"@value":"Volt pe Pascal","@language":"ro"},{"@value":"Volt per Pascal","@language":"en"},{"@value":"Volt per Pascal","@language":"it"},{"@value":"Volt per Pascal","@language":"ms"},{"@value":"Volt per Pascal","@language":"tr"},{"@value":"Volt per Pascal","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Volt por Pascal","@language":"pt"},{"@value":"Volt pro Pascal","@language":"de"},{"@value":"Voltio por Pascal","@language":"es"},{"@value":"Voltium per Pascalium","@language":"la"},{"@value":"Wolt na Paskal","@language":"pl"},{"@value":"Βολτ ανά Πασκάλ","@language":"el"},{"@value":"Волт на Паскал","@language":"bg"},{"@value":"Вольт на Паскаль","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/V-PER-SEC","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"'Volt per Second' is a unit of magnetic flux equaling one weber. This is the flux passing through a\n    conducting loop and reduced to zero at a uniform rate in one second inducing an electric potential of one volt in the loop.\n  ","@type":"http://www.w3.org/1999/02/22-