":"$m-per-k$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H-1T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2863"},{"@id":"_:n3-2864"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LinearThermalExpansion"},{"@id":"http://qudt.org/vocab/quantitykind/TemperatureBasedLength"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/K-PER-M"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA728","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA728","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m/K","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m.K-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"F52","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LinearThermalExpansion"},{"@id":"http://qudt.org/vocab/quantitykind/TemperatureBasedLength"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Meter na Kelvin","@language":"sl"},{"@value":"Meter per Kelvin","@language":"en-us"},{"@value":"Meter per Kelvin","@language":"ms"},{"@value":"Meter pro Kelvin","@language":"de"},{"@value":"Metr na Kelvin","@language":"cs"},{"@value":"Metr na Kelwin","@language":"pl"},{"@value":"Metre per Kelvin","@language":"en"},{"@value":"Metre per Kelvin","@language":"tr"},{"@value":"Metre per Kelvin","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Metro per Kelvin","@language":"it"},{"@value":"Metro por Kelvin","@language":"es"},{"@value":"Metro por Kelvin","@language":"pt"},{"@value":"Metru pe Kelvin","@language":"ro"},{"@value":"Metrum per Kelvin","@language":"la"},{"@value":"Mètre par Kelvin","@language":"fr"},{"@value":"Μέτρο ανά Κέλβιν","@language":"el"},{"@value":"Метр на Кельвин","@language":"ru"},{"@value":"Метър на Келвин","@language":"bg"}]},{"@id":"http://qudt.org/vocab/unit/M-PER-M2","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A rate of change of SI standard unit length per squared meter area.","@language":"en"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2865"},{"@id":"_:n3-2866"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InverseLength"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/M2-PER-M"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m/m²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m.m-2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InverseLength"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Meter na Kvadratni Meter","@language":"sl"},{"@value":"Meter per Meter Persegi","@language":"ms"},{"@value":"Meter per Square Meter","@language":"en-us"},{"@value":"Meter pro Quadratmeter","@language":"de"},{"@value":"Metr na Metr Kwadratowy","@language":"pl"},{"@value":"Metr na Čtvereční Metr","@language":"cs"},{"@value":"Metre per Metrekare","@language":"tr"},{"@value":"Metre per Square Metre","@language":"en"},{"@value":"Metre per Square Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Metro per Metro Quadrato","@language":"it"},{"@value":"Metro por Metro Cuadrado","@language":"es"},{"@value":"Metro por Metro Quadrado","@language":"pt"},{"@value":"Metru pe Metru Pătrat","@language":"ro"},{"@value":"Metrum per Metrum Quadratum","@language":"la"},{"@value":"Mètre par Mètre Carré","@language":"fr"},{"@value":"Μέτρο ανά Τετραγωνικό Μέτρο","@language":"el"},{"@value":"Метр на Квадратный Метр","@language":"ru"},{"@value":"Метър на Квадратен Метър","@language":"bg"}]},{"@id":"http://qudt.org/vocab/unit/M-PER-MIN","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Meter Per Minute (m/min) is a unit in the category of Velocity. It is also known as meter/minute, meters\n    per minute, metre per minute, metres per minute. Meter Per Minute (m/min) has a dimension of LT-1 where $L$ is length, and $T$\n    is time. It can be converted to the corresponding standard SI unit m/s by multiplying its value by a factor of 0.016666666666\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.01666666666666666666666666666666667","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.666666666666666666666666666666667E-2","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$m/min$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2867"},{"@id":"_:n3-2868"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/Velocity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA732","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA732","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m/min","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m.min-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"2X","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/Velocity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q21014455"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Meter per Minute","@language":"en-us"},{"@value":"Metre per Minute","@language":"en"},{"@value":"Metre per Minute","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/M-PER-PA","@type":["http://qudt.org/sch