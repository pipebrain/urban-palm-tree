ma#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Ettometro","@language":"it"},{"@value":"Hectometer","@language":"de"},{"@value":"Hectometer","@language":"en-us"},{"@value":"Hectometer","@language":"ms"},{"@value":"Hectometer","@language":"sl"},{"@value":"Hectometr","@language":"cs"},{"@value":"Hectometr","@language":"pl"},{"@value":"Hectometre","@language":"en"},{"@value":"Hectometre","@language":"tr"},{"@value":"Hectometre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Hectometro","@language":"es"},{"@value":"Hectometru","@language":"ro"},{"@value":"Hectomètre","@language":"fr"},{"@value":"Hectométer","@language":"hu"}]},{"@id":"http://qudt.org/vocab/unit/HectoPA","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Hectopascal is a unit of pressure. 1 Pa is approximately the pressure exerted by a 10-g mass resting on a\n    1-cm2 area. 1013 hPa = 1 atm. There are 100 pascals in 1 hectopascal.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"100.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E2","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/unit/MilliBAR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"},{"@id":"http://qudt.org/vocab/quantitykind/ModulusOfElasticity"}],"http://qudt.