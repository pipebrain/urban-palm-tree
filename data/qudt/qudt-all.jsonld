http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AttenuationCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/CurvatureFromRadius"},{"@id":"http://qudt.org/vocab/quantitykind/InverseLength"},{"@id":"http://qudt.org/vocab/quantitykind/LinearIonization"},{"@id":"http://qudt.org/vocab/quantitykind/PhaseCoefficient"},{"@id":"http://qudt.org/vocab/quantitykind/PropagationCoefficient"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Na Picometer","@language":"sl"},{"@value":"Na Picometr","@language":"cs"},{"@value":"Na Picometr","@language":"pl"},{"@value":"Par Picomètre","@language":"fr"},{"@value":"Pe Picometru","@language":"ro"},{"@value":"Per Picometer","@language":"ms"},{"@value":"Per Picometre","@language":"tr"},{"@value":"Per Picometro","@language":"it"},{"@value":"Por Picometro","@language":"es"},{"@value":"Pro Picometer","@language":"de"},{"@value":"Reciprocal Picometer","@language":"en-us"},{"@value":"Reciprocal Picometre","@language":"en"},{"@value":"Reciprocal Picometre","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/PER-PlanckMass2","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"In physics, the Planck mass, denoted by $m_P$, is the unit of mass in the system of natural units known\n    as Planck units. It is defined so that $\\approx  1.2209 \\times 10 GeV/c_0 = 2.17651(13) \\times 10 kg$, (or $21.7651 \\mu\n    g$), where $c_0$ is the speed of light in a vacuum, $G$ is the gravitational constant, and $\\hbar$ is the reduced Planck\n    constant. Particle physicists and cosmologists often use the reduced Planck mass, which is $\\approx  4.341 \\times 10 kg =\n    2.435  \\times 10 GeV/c$. The added factor of $1/{\\sqrt{8\\pi}}$ simplifies a number of equations in general relativity.\n    Quantum effects are typified by the magnitude of Planck's constant.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/PLANCK"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"2111089287176721.707084516481080014","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"2.111089287176721707084516481080014E15","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Planck_mass","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M-2H0T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4493"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InverseSquareMass"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Planck_mass?oldid=493648632","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Planck_units","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$m_P = \\sqrt{\\frac{ \\hbar c^3}{G}} \\approx 1.2209 \\times 10^{19} GeV/c^2 = 2.17651(13) \\times 10^{-8}$, where $c$ is the speed of light in a vacuum, $\\hbar$ is the reduced Planck's constant, and $G$ is the gravitational constant. The two digits enclosed by parentheses are the estimated standard error associated with the reported numerical value.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"/planckmass²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/InverseSquareMass"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vo