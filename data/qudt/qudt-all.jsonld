ntityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/M2-PER-HA"},{"@id":"http://qudt.org/vocab/unit/M2-PER-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AreaRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Area Ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/AreaTemperature","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FT2-DEG_F"},{"@id":"http://qudt.org/vocab/unit/M2-K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H1T0D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AreaTemperature","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Area Temperature","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/AreaThermalExpansion","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"When the temperature of a substance changes, the energy that is stored in the intermolecular bonds\n    between atoms changes. When the stored energy increases, so does the length of the molecular bonds. As a result, solids\n    typically expand in response to heating and contract on cooling; this dimensional response to temperature change is expressed\n    by its coefficient of thermal expansion.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/M2-PER-K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H-1T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Thermal_expansion#Area","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"When the temperature of a substance changes, the energy that is stored in the intermolecular bonds\n    between atoms changes. When the stored energy increases, so does the length of the molecular bonds. As a result, solids\n    typically expand in response to heating and contract on cooling; this dimensional response to temperature change is expressed\n    by its coefficient of thermal expansion.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AreaThermalExpansion","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Area Thermal Expansion","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/AreaTime","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM2-MIN"},{"@id":"http://qudt.org/vocab/unit/CentiM2-SEC"},{"@id":"http://qudt.org/vocab/unit/HR-FT2"},{"@id":"http://qudt.org/vocab/unit/SEC-FT2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T1D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AreaTime","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Area Time","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/AreaTimeTemperature","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FT2-HR-DEG_F"},{"@id":"http://qudt.org/vocab/unit/FT2-SEC-DEG_F"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H1T1D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AreaTimeTemperature","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Area Time Temperature","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/AreicChargeDensityOrElectricFluxDensityOrElectricPolarization","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"charge Q presented on an area of size A divided by the area A or vector quantity obtained at a given\n    point by adding the electric polarization P to the product of the electric field strength E and the electric constant\n    (permittivity) ε₀\n  ","@language":"en"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.4","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ320#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"auf einer Fläche mit dem Flächeninhalt A vorhandenen Ladung Q dividiert durch den Flächeninhalt A\n    oder vektorielle Größe, die für einen gegebenen Punkt gleich der Summe der elektrischen Polarisation P und des Produkts aus\n    der elektrischen Feldstärke E und der elektrischen Feldkonstante (Permittivität) ε₀ ist oder räumliche Dichte des elektrischen\n    Moments molekularer Dipole\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"areic charge density or electric flux density or electric polarization","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/AreicDataVolume","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"volume of data, which is usually dependent on the respective complexity of the information or its coding\n    procedure, divided by the related area\n  ","@language":"en"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ321#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Anzahl von Daten, die in der Regel abhängig von der jeweiligen Komplexität der Information oder\n    deren Codierungsverfahren ist, dividiert durch die zugehörige Fläche\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Areic Data Volume","