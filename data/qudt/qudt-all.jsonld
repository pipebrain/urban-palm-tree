,"@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m/(s·Pa)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m.s-1.Pa-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"M59","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Meter na Sekunda Pascal","@language":"sl"},{"@value":"Meter per Saat Pascal","@language":"ms"},{"@value":"Meter per Second Pascal","@language":"en-us"},{"@value":"Meter pro Sekunde Pascal","@language":"de"},{"@value":"Metr na Sekunda Pascal","@language":"cs"},{"@value":"Metr na Sekunda Paskal","@language":"pl"},{"@value":"Metre per Saniye Pascal","@language":"tr"},{"@value":"Metre per Second Pascal","@language":"en"},{"@value":"Metre per Second Pascal","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Metro per Secondo Pascal","@language":"it"},{"@value":"Metro por Segundo Pascal","@language":"es"},{"@value":"Metro por Segundo Pascal","@language":"pt"},{"@value":"Metru pe Secundă Pascal","@language":"ro"},{"@value":"Metrum per Secundum Pascalium","@language":"la"},{"@value":"Mètre par Seconde Pascal","@language":"fr"},{"@value":"Μέτρο ανά Δευτερόλεπτο Πασκάλ","@language":"el"},{"@value":"Метр на Секунда Паскаль","@language":"ru"},{"@value":"Метър на Секунда Паскал","@language":"bg"}]},{"@id":"http://qudt.org/vocab/unit/M-PER-SEC2","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The $\\textit{meter per Square second}$ is the unit of acceleration in the International System of Units\n    (SI). As a derived unit it is composed from the SI base units of length, the metre, and the standard unit of time, the second.\n    Its symbol is written in several forms as $m/s^2$, or $m s^{-2}$. As acceleration, the unit is interpreted physically as\n    change in velocity or speed per time interval, that is, $\\textit{metre per second per second}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$m/s^2$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2884"},{"@id":"_:n3-2885"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Acceleration"},{"@id":"http://qudt.org/vocab/quantitykind/LinearAcceleration"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA736","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA736","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m/s²","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m.s-2","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"MSK","@t