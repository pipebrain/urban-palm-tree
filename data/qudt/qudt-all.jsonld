/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Magnetic_moment"}]},{"@id":"http://qudt.org/vocab/constant/ShieldedProtonMagneticMomentToBohrMagnetonRatio","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_ShieldedProtonMagneticMomentToBohrMagnetonRatio"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"shielded proton magnetic moment to Bohr magneton ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Bohr_magneton"}]},{"@id":"http://qudt.org/vocab/constant/ShieldedProtonMagneticMomentToNuclearMagnetonRatio","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_ShieldedProtonMagneticMomentToNuclearMagnetonRatio"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"shielded proton magnetic moment to nuclear magneton ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://dbpedia.org/resource/Nuclear_magneton"}]},{"@id":"http://qudt.org/vocab/constant/SpeedOfLight_Vacuum","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\textit{Speed of Light in Vacuum}$, is a universal physical constant important in many areas of physics. \n  Its value is 299,792,458 metres per second, a figure that is exact because the length of the metre is\n   defined from this constant and the international standard for time.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Speed"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://dbpedia.org/resource/Speed_of_light","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=113-01-34","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.iso.org/iso/home/store/catalogue_tc/catalogue_detail.htm?csnumber=31891","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Speed_of_light","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$c_0 = 1 / \\sqrt{\\epsilon_0 \\mu_0}$, where {\\epsilon_0} is the permittivity of vacuum, and $\\mu_0$ is the magnetic constant.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$C_0$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_SpeedOfLight_Vacuum"},{"@id":"http://qudt.org/vocab/constant/Value_SpeedOfLight_Vacuum_Imperial"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/constants/SpeedOfLight"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[c]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Speed of Light (vacuum)","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/constant/MagneticConstant"},{"@id":"http://qudt.org/vocab/constant/PermittivityOfVacuum"}]},{"@id":"http://qudt.org/vocab/constant/StandardAccelerationOfGravity","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Standard_gravity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/exactConstant":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LinearAcceleration"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_StandardAccelerationOfGravity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"standard acceleration of gravity","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/StandardAtmosphere","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Standard_atmosphere","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/exactConstant":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Pressure"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_StandardAtmosphere"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"standard atmosphere","@language":"en"}]},{"@id":"http://qudt.org/vocab/constant/StefanBoltzmannConstant","@type":["http://qudt.org/schema/qudt/PhysicalConstant"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\textit{Stefan Boltzmann Constant}$ is a proportionality factor between the specific radiant heat\n   of a black body and the 4th power of its absolute temperature.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Stefan%E2%80%93Boltzmann_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ444#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H-4T-3D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/PowerPerAreaQuarticTemperature"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/cuu/Constants/bibliography.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Proportionalitätsfaktor zwischen der spezifischen Strahlungswärme eines schwarzen Strahlers und seiner absoluten Temperatur in der 4. Potenz","@language":"de"}],"http://qudt.org/schema/qudt/quantityValue":[{"@id":"http://qudt.org/vocab/constant/Value_StefanBoltzmannConstant"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/constant"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Stefan-Boltzmann Constant","@language":"en"}]},{"@id":"http://qudt.org/vocab/const