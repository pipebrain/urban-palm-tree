MilliM-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-YR"},{"@id":"http://qudt.org/vocab/unit/YD-PER-HR"},{"@id":"http://qudt.org/vocab/unit/YD-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/YD-PER-SEC"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Velocity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ281#006","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD236","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD236","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Velocity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In kinematics, velocity is the speed of an object and a specification of its direction of motion.\n    Speed describes only how fast an object is moving, whereas velocity gives both how fast and in what direction the object is\n    moving.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/VELO"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"v","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q11465"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Velocity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Geschwindigkeit","@language":"de"},{"@value":"Halaju","@language":"ms"},{"@value":"Rychlost","@language":"cs"},{"@value":"Velocity","@language":"en"},{"@value":"hitrost","@language":"sl"},{"@value":"hız","@language":"tr"},{"@value":"prędkość","@language":"pl"},{"@value":"velocidad","@language":"es"},{"@value":"velocidade","@language":"pt"},{"@value":"velocitas","@language":"la"},{"@value":"velocità","@language":"it"},{"@value":"vitesse","@language":"fr"},{"@value":"viteză","@language":"ro"},{"@value":"Επιφάνεια","@language":"el"},{"@value":"Ско́рость","@language":"ru"},{"@value":"מהירות","@language":"he"},{"@value":"السرعة","@language":"ar"},{"@value":"سرعت/تندی","@language":"fa"},{"@value":"गति","@language":"hi"},{"@value":"速力","@language":"ja"},{"@value":"速度","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"rapidez","@language":"es"},{"@value":"वेग","@language":"hi"}]},{"@id":"http://qudt.org/vocab/quantitykind/VentilationRatePerFloorArea","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Ventilation Rate is often expressed by the volumetric flowrate of outdoor air introduced to a building.\n    However, ASHRAE now recommends ventilation rates dependent upon floor area.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/L-PER-SEC-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Ventilation_(architecture)#Ventilation_rates_for_indoor_air_quality","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Ventilation Rate is often expressed by the volumetric flowrate of outdoor air introduced to a\n    building. However, ASHRAE now recommends ventilation rates dependent upon floor area.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SurfaceRelatedVolumeFlow"},{"@id":"http://qudt.org/vocab/quantitykind/SurfaceRelatedVolumeFlowRate"},{"@id":"http://qudt.org/vocab/quantitykind/VolumetricFlux"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:VentilationRatePerFloorArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Ventilation Rate per Floor Area","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SurfaceRelatedVolumeFlow"},{"@id":"http://qudt.org/vocab/quantitykind/SurfaceRelatedVolumeFlowRate"},{"@id":"http://qudt.org/vocab/quantitykind/VolumetricFlux"}]},{"@id":"http://qudt.org/vocab/quantitykind/VerticalVelocity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The rate at which a body moves upwards at an angle of 90 degrees to the ground. It is the component of a\n    projectile's velocity which is concerned with lifting the projectile.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/CentiM-PER-KiloYR"},{"@id":"http://qudt.org/vocab/unit/CentiM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/CentiM-PER-YR"},{"@id":"http://qudt.org/vocab/unit/FT-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/FT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/FT-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/FT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/GigaHZ-M"},{"@id":"http://qudt.org/vocab/unit/IN-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/IN-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/IN-PER-YR"},{"@id":"http://qudt.org/vocab/unit/KN"},{"@id":"http://qudt.org/vocab/unit/KiloM-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/KiloM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/M-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/M-PER-HR"},{"@id":"http://qudt.org/vocab/unit/M-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/M-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/M-PER-YR"},{"@id":"http://qudt.org/vocab/unit/MI-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MI-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MI-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MI_N-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MI_N-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MicroM-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MicroM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MilliM-PER-YR"},{"@id":"http://qudt.org/vocab/unit/YD-PER-HR"},{"@id":"http://qudt.org/vocab/unit/YD-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/YD-PER-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The rate at which a body moves upwards at an angle of 90 degrees to the ground. It is the component\n    of a projectile's velocity which is concerned with lifting the projectile.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/Velocity"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"V_{Z}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:LinearVelocity","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:Velocity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Vertical Velocity","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/Velocity"}]},{"@id":"http://qudt.org/vocab/quantitykind/VibrationalDensityOfStates","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Vibrational Density of States\" is the number of vibrational modes in an infinitesimal interval of\n    angular frequency divided by the range of that interval and by volume.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/SEC-PER-M3-RAD"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/SpectralConcentrationOfVibrationalModes"},{"@id":"http://qudt.org/vocab/quantitykind/SpectralDensityOfVibrationalModes"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Density_of_states","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Density of States\" is the number of vibrational modes in an infinitesimal interval of angular\n    frequency divided by the range of that interval and by volume.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"g","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q230895"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:VibrationalDensityOfStates","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Vibrational Density of States","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyDensityOfStates"}]},{"@id":"http://qudt.org/vocab/quantitykind/VideoFrameRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Frame rate (also known as frame frequency) is the frequency (rate) at which an imaging device produces\n    unique consecutive images called frames. The term applies equally well to computer graphics, video cameras, film cameras, and\n    motion capture systems. Frame rate is most often expressed in frames per second (FPS) and is also expressed in progressive\n    scan monitors as hertz (Hz).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRAME-PER-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Frame_rate","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Frame rate (also known as frame frequency) is the frequency (rate) at which an imaging device\n    produces unique consecutive images called frames. The term applies equally well to computer graphics, video cameras, film\n    cameras, and motion capture systems. Frame rate is most often expressed in frames per second (FPS) and is also expressed in\n    progressive scan monitors as hertz (Hz).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:VideoFrameRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Video Frame Rate","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Viscosity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Viscosity is a measure of the resistance of a fluid which is being deformed by either shear stress or\n    extensional stress. In general terms it is the resistance of a liquid to flow, or its \"thickness\". Viscosity describes a\n    fluid's internal resistance to flow and may be thought of as a measure of fluid friction. [Wikipedia]. In general conversation\n    or in non-scientific contexts, if someone refers to the viscosity of a fluid, they're likely talking about its dynamic (or\n    absolute) viscosity. However, in engineering or scientific contexts, it's essential to clarify which type of viscosity is\n    being discussed, as the interpretation and use of the data may differ depending on whether one is talking about dynamic or\n    kinematic viscosity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiPOISE"},{"@id":"http://qudt.org/vocab/unit/DecaPOISE"},{"@id":"http://qudt.org/vocab/unit/GM-PER-CentiM-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M-DAY"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M-HR"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloPOISE"},{"@id":"http://qudt.org/vocab/unit/LB-PER-FT-DAY"},{"@id":"http://qudt.org/vocab/unit/LB-PER-FT-HR"},{"@id":"http://qudt.org/vocab/unit/LB-PER-FT-MIN"},{"@id":"http://qudt.org/vocab/unit/LB-PER-FT-SEC"},{"@id":"http://qudt.org/vocab/unit/LB_F-SEC-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/LB_F-SEC-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/MicroPOISE"},{"@id":"http://qudt.org/vocab/unit/MilliPA-SEC"},{"@id":"http://qudt.org/vocab/unit/N-SEC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/PA-SEC"},{"@id":"http://qudt.org/vocab/unit/PDL-SEC-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/PDL-SEC-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/POISE"},{"@id":"http://qudt.org/vocab/unit/SLUG-PER-FT-SEC"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Viscosity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/DynamicViscosity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Viscosity is a measure of the resistance of a fluid which is being deformed by either shear stress\n    or extensional stress. In general terms it is the resistance of a liquid to flow, or its \"thickness\". Viscosity describes a\n    fluid's internal resistance to flow and may be thought of as a measure of fluid friction. [Wikipedia]. In general conversation\n    or in non-scientific contexts, if someone refers to the viscosity of a fluid, they're likely talking about its dynamic (or\n    absolute) viscosity. However, in engineering or scientific contexts, it's essential to clarify which type of viscosity is\n    being discussed, as the interpretation and use of the data may differ depending on whether one is talking about dynamic or\n    kinematic viscosity.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q128709"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Viscosity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Viscosity","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/VisibleRadiantEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Visible Radiant Energy\", also known as luminous energy, is the energy of electromagnetic waves. It is\n    energy of the particles that are emitted, transferred, or received as radiation.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AttoJ"},{"@id":"http://qudt.org/vocab/unit/BTU_IT"},{"@id":"http://qudt.org/vocab/unit/BTU_TH"},{"@id":"http://qudt.org/vocab/unit/CAL_IT"},{"@id":"http://qudt.org/vocab/unit/CAL_TH"},{"@id":"http://qudt.org/vocab/unit/ERG"},{"@id":"http://qudt.org/vocab/unit/EV"},{"@id":"http://qudt.org/vocab/unit/E_h"},{"@id":"http://qudt.org/vocab/unit/ExaJ"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F_Energy"},{"@id":"http://qudt.org/vocab/unit/FT-PDL"},{"@id":"http://qudt.org/vocab/unit/FemtoJ"},{"@id":"http://qudt.org/vocab/unit/GigaEV"},{"@id":"http://qudt.org/vocab/unit/GigaJ"},{"@id":"http://qudt.org/vocab/unit/GigaW-HR"},{"@id":"http://qudt.org/vocab/unit/J"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH"},{"@id":"http://qudt.org/vocab/unit/KiloCAL"},{"@id":"http://qudt.org/vocab/unit/KiloEV"},{"@id":"http://qudt.org/vocab/unit/KiloJ"},{"@id":"http://qudt.org/vocab/unit/KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT"},{"@id":"http://qudt.org/vocab/unit/MegaEV"},{"@id":"http://qudt.org/vocab/unit/MegaJ"},{"@id":"http://qudt.org/vocab/unit/MegaTOE"},{"@id":"http://qudt.org/vocab/unit/MegaW-HR"},{"@id":"http://qudt.org/vocab/unit/MicroJ"},{"@id":"http://qudt.org/vocab/unit/MilliJ"},{"@id":"http://qudt.org/vocab/unit/NanoJ"},{"@id":"http://qudt.org/vocab/unit/PetaJ"},{"@id":"http://qudt.org/vocab/unit/PicoJ"},{"@id":"http://qudt.org/vocab/unit/PlanckEnergy"},{"@id":"http://qudt.org/vocab/unit/QUAD"},{"@id":"http://qudt.org/vocab/unit/THERM_EC"},{"@id":"http://qudt.org/vocab/unit/THERM_US"},{"@id":"http://qudt.org/vocab/unit/THM_EEC"},{"@id":"http://qudt.org/vocab/unit/THM_US"},{"@id":"http://qudt.org/vocab/unit/TOE"},{"@id":"http://qudt.org/vocab/unit/TeraJ"},{"@id":"http://qudt.org/vocab/unit/TeraW-HR"},{"@id":"http://qudt.org/vocab/unit/TonEnergy"},{"@id":"http://qudt.org/vocab/unit/W-HR"},{"@id":"http://qudt.org/vocab/unit/W-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Radiant_energy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31892","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"Q","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Visible Radiant Energy\", also known as luminous energy, is the energy of electromagnetic waves. It\n    is energy of the particles that are emitted, transferred, or received as radiation.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Q","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Energy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Visible Radiant Energy","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://qudt.org/vocab/quantitykind/LuminousEnergy"}]},{"@id":"http://qudt.org/vocab/quantitykind/VisionThresholds","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Vision Thresholds\" is an abstract term to refer to a variety of measures for the thresholds of\n    sensitivity of the eye.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/NotApplicable"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Absolute_threshold#Vision","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\overline{T_v}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Vision Thresholds\" is the thresholds of sensitivity of the eye.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Vision Thresholds","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Voltage","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Voltage}$, also referred to as $\\textit{Electric Tension}$, is the difference between\n    electrical potentials of two points. For an electric field within a medium, $U_{ab} = - \\int_{r_a}^{r_b} E . {dr}$, where $E$\n    is electric field strength. For an irrotational electric field, the voltage is independent of the path between the two points\n    $a$ and $b$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ExaV"},{"@id":"http://qudt.org/vocab/unit/FemtoV"},{"@id":"http://qudt.org/vocab/unit/GigaV"},{"@id":"http://qudt.org/vocab/unit/KiloV"},{"@id":"http://qudt.org/vocab/unit/MegaV"},{"@id":"http://qudt.org/vocab/unit/MicroV"},{"@id":"http://qudt.org/vocab/unit/MilliV"},{"@id":"http://qudt.org/vocab/unit/NanoV"},{"@id":"http://qudt.org/vocab/unit/PetaV"},{"@id":"http://qudt.org/vocab/unit/PicoV"},{"@id":"http://qudt.org/vocab/unit/PlanckVolt"},{"@id":"http://qudt.org/vocab/unit/TeraV"},{"@id":"http://qudt.org/vocab/unit/V"},{"@id":"http://qudt.org/vocab/unit/V_Ab"},{"@id":"http://qudt.org/vocab/unit/V_Stat"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ267#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotential"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricPotentialDifference"},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerElectricCharge"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD237","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-27","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD237","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$U_{ab} = V_a - V_b$, where $V_a$ and $V_b$ are electric potentials at points $a$ and $b$, respectively.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$U_{ab}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"U","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q25428"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Voltage","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Voltage","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/VoltageImbalance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/PERMILLE"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Voltage imbalance is the percentage deviation of individual phase voltages from the average voltage\n    across phases in a polyphase electrical system.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:VoltageImbalance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Voltage Imbalance","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/VoltagePhasor","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Voltage Phasor\" is a representation of voltage as a sinusoidal integral quantity using a complex\n    quantity whose argument is equal to the initial phase and whose modulus is equal to the root-mean-square value. A phasor is a\n    constant complex number, usually expressed in exponential form, representing the complex amplitude (magnitude and phase) of a\n    sinusoidal function of time. Phasors are used by electrical engineers to simplify computations involving sinusoids, where they\n    can often reduce a differential equation problem to an algebraic one.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloV"},{"@id":"http://qudt.org/vocab/unit/MicroV"},{"@id":"http://qudt.org/vocab/unit/MilliV"},{"@id":"http://qudt.org/vocab/unit/V"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=131-11-26","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"When $u = \\hat{U} \\cos{(\\omega t + \\alpha)}$, where $u$ is the voltage, $\\omega$ is angular frequency, $t$ is time, and $\\alpha$ is initial phase, then $\\underline{U} = Ue^{ja}$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\underline{U}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Voltage"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Voltage Phasor\" is a representation of voltage as a sinusoidal integral quantity using a complex\n    quantity whose argument is equal to the initial phase and whose modulus is equal to the root-mean-square value. A phasor is a\n    constant complex number, usually expressed in exponential form, representing the complex amplitude (magnitude and phase) of a\n    sinusoidal function of time. Phasors are used by electrical engineers to simplify computations involving sinusoids, where they\n    can often reduce a differential equation problem to an algebraic one.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q78514605"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:VoltagePhasor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Voltage Phasor","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Voltage"}]},{"@id":"http://qudt.org/vocab/quantitykind/VoltageRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L2I0M1H0T-3D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:VoltageRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Voltage Ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/Volume","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The volume of a solid object is the three-dimensional concept of how much space it occupies, often\n    quantified numerically. One-dimensional figures (such as lines) and two-dimensional shapes (such as squares) are assigned zero\n    volume in the three-dimensional space.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AC-FT"},{"@id":"http://qudt.org/vocab/unit/AC-FT_US"},{"@id":"http://qudt.org/vocab/unit/ANGSTROM3"},{"@id":"http://qudt.org/vocab/unit/BBL"},{"@id":"http://qudt.org/vocab/unit/BBL_UK_PET"},{"@id":"http://qudt.org/vocab/unit/BU_US_DRY"},{"@id":"http://qudt.org/vocab/unit/CentiM3"},{"@id":"http://qudt.org/vocab/unit/DecaL"},{"@id":"http://qudt.org/vocab/unit/DecaM3"},{"@id":"http://qudt.org/vocab/unit/DeciL"},{"@id":"http://qudt.org/vocab/unit/DeciM3"