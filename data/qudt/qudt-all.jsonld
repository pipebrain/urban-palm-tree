Lumen por Metro Quadrado","@language":"pt"},{"@value":"Lumen pro Quadratmeter","@language":"de"},{"@value":"Lümen per Metrekare","@language":"tr"},{"@value":"Λούμεν ανά Τετραγωνικό Μέτρο","@language":"el"},{"@value":"Лумен на Квадратен Метър","@language":"bg"},{"@value":"Лумен на Квадратный Метр","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/LM-PER-W","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A measurement of luminous efficacy, which is the light output in lumens using one watt of electricity.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$lm-per-w$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I1M-1H0T3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2828"},{"@id":"_:n3-2829"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LuminousEfficacy"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA719","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA719","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"lm/W","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"lm.W-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"B61","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LuminousEfficacy"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q83386886"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Lumen na Wat","@language":"pl"},{"@value":"Lumen na Watt","@language":"cs"},{"@value":"Lumen na Watt","@language":"sl"},{"@value":"Lumen par Watt","@language":"fr"},{"@value":"Lumen pe Watt","@language":"ro"},{"@value":"Lumen per Watt","@language":"en"},{"@value":"Lumen per Watt","@language":"it"},{"@value":"Lumen per Watt","@language":"ms"},{"@value":"Lumen per Watt","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Lumen per Wattium","@language":"la"},{"@value":"Lumen por Vatio","@language":"es"},{"@value":"Lumen por Watt","@language":"pt"},{"@value":"Lumen pro Watt","@language":"de"},{"@value":"Lümen per Watt","@language":"tr"},{"@value":"Λούμεν ανά Βατ","@language":"el"},{"@value":"Лумен на Ват","@language":"bg"},{"@value":"Лумен на Ватт","@language":"ru"}]},{"@id":"http://qudt.org/vocab/unit/LM-SEC","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"In photometry, the lumen second is the SI derived unit of luminous energy. It is based on the lumen, the\n    SI unit of luminous flux, and the second, the SI base unit of time.  The lumen second is sometimes called the talbot (symbol\n    T).  An older name for the lumen second was the lumberg.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$lm s$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I1M0H0T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2830"},{"@id":"_:n3-2831"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LuminousEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/QuantityOfLight"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA722","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA722","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"lm·s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"lm.s","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"B62","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LuminousEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/QuantityOfLight"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q910311"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Lumen Saat","@language":"ms"},{"@value":"Lumen Second","@language":"en"},{"@value":"Lumen Second","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Lumen Seconde","@language":"fr"},{"@value":"Lumen Secondo","@language":"it"},{"@value":"Lumen Secundum","@language":"la"},{"@value":"Lumen Secundă","@language":"ro"},{"@value":"Lumen Segundo","@language":"es"},{"@value":"Lumen Segundo","@language":"pt"},{"@value":"Lumen Sekunda","@language":"cs"},{"@value":"Lumen Sekunda","@language":"pl"},{"@value":"Lumen Sekunda","@language":"sl"},{"@value":"Lumen Sekunde","@language":"de"},{"@value":"Lümen Saniye","@language":"tr"},{"@value":"Λούμεν Δευτερόλεπτο","@language":"el"},{"@value":"Лумен Секунда","@language":"bg"},{"@value":"Лумен Секунда","@language":"ru"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"lumberg","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"talbot","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/LUX","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The SI unit for measuring the illumination (illuminance) of a surface. One lux is defined as an\n    illumination of one lumen per square meter or 0.0001 phot. In considering the various light units, it's useful to think about\n    light originating at a point and shining upon a surface. The intensity of the light source is measured in candelas; the total\n    light flux in transit is measured in lumens (1 lumen = 1 candelau00b7steradian); and the amount of light received per unit of\n    surface area is measured in lux (1 lux = 1 lumen/square meter). One lux is equal to approximately 0.09290 foot candle.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Lux","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I1M0H0T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2832"},{"@id":"_:n3-2833"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LuminousFluxPerArea"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA723","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA723","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Lux?oldid=494700274","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/lux"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/SI/units/lux"}],"http://qudt.org/schema/qudt/siUnitsExpression":[{"@value":"lm/m^2","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"lx","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"lx","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/udunitsCode":[{"@value":"lx","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"LUX","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LuminousFluxPerArea"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q179836"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Luks","@language":"pl"},{"@value":"Luks","@language":"sl"},{"@value":"Lux","@language":"cs"},{"@value":"Lux","@language":"de"},{"@value":"Lux","@language":"el"},{"@value":"Lux","@language":"en"},{"@value":"Lux","@language":"es"},{"@value":"Lux","@language":"fr"},{"@value":"Lux","@language":"hu"},{"@value":"Lux","@language":"it"},{"@value":"Lux","@language":"ms"},{"@value":"Lux","@language":"pt"},{"@value":"Lux","@language":"ro"},{"@value":"Lux","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Lüks","@language":"tr"},{"@value":"Лукс","@language":"bg"},{"@value":"Люкс","@language":"ru"},{"@value":"לוקס","@language":"he"},{"@value":"لكس","@language":"ar"},{"@value":"لوکس","@language":"fa"},{"@value":"लक्स","@language":"hi"},{"@value":"ルクス","@language":"ja"},{"@value":"勒克斯","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/LUX-HR","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The SI unit for measuring the illumination (illuminance) of a surface. One lux is defined as an\n    illumination of one lumen per square meter or 0.0001 phot. In considering the various light units, it's useful to think about\n    light originating at a point and shining upon a surface. The intensity of the light source is measured in candelas; the total\n    light flux in transit is measured in lumens (1 lumen = 1 candelau00b7steradian); and the amount of light received per unit of\n    surface area is measured in lux (1 lux = 1 lumen/square meter). One lux is equal to approximately 0.09290 foot candle.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"3600.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"3.6E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Lux","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$lx h$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I1M0H0T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2834"},{"@id":"_:n3-2835"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LuminousExposure"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA724","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA724","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Lux?oldid=494700274","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/siUnitsExpression":[{"@value":"lm-h/m^2","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"lx·h","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"lx.h","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"B63","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/LuminousExposure"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q107361135"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Lux Hour","@language":"en"},{"@value":"Lux H