t.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0002777777777777777777777777777777778","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"2.777777777777777777777777777777778E-4","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1846"},{"@id":"_:n3-1847"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB445","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB445","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"SI derived unit joule divided by the 3600 times the SI base unit second","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J/h","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"J.h-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"P16","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q106840018"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Joule per Hour","@language":"en"},{"@value":"Joule per Hour","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/J-PER-K","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Joule Per Kelvin (J/K) is a unit in the category of Entropy. It is also known as joules per kelvin,\n    joule/kelvin. This unit is commonly used in the SI unit system. Joule Per Kelvin (J/K) has a dimension of $ML^{2}T^{-2}Q^{-1}$\n    where $M$ is mass, $L$ is length, $T$ is time, and Q is temperature. This unit is the standard SI unit in this category.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$J/K$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H-1T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1848"},{"@id":"_:n3-1849"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Entropy"},{"@id":"http://qudt.org/vocab/quantitykind/HeatCapacity"},{"@id":"http://qudt.org/vocab/quantitykind/MassieuFunction"},{"@id":"http://qudt.org/vocab/quantitykind/PlanckFunction"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA173","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA173","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J/K","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"J.K-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"JE","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Entropy"},{"@id":"http://qudt.org/vocab/quantitykind/HeatCapacity"},{"@id":"http://qudt.org/vocab/quantitykind/MassieuFunction"},{"@id":"http://qudt.org/vocab/quantitykind/PlanckFunction"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q21393312"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dżul na Kelwin","@language":"pl"},{"@value":"Joule na Kelvin","@language":"cs"},{"@value":"Joule na Kelvin","@language":"sl"},{"@value":"Joule par Kelvin","@language":"fr"},{"@value":"Joule pe Kelvin","@language":"ro"},{"@value":"Joule per Kelvin","@language":"en"},{"@value":"Joule per Kelvin","@language":"it"},{"@value":"Joule per Kelvin","@language":"ms"},{"@value":"Joule per Kelvin","@language":"tr"},{"@value":"Joule per Kelvin","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Joule por Kelvin","@language":"pt"},{"@value":"Joule pro Kelvin","@language":"de"},{"@value":"Joulium per Kelvin","@language":"la"},{"@value":"Julio por Kelvin","@language":"es"},{"@value":"Τζάουλ ανά Κέλβιν","@language":"el"},{"@value":"Джаул на Келвин","@language":"bg"},{"@value":"Джоуль на Кельвин","@language":"ru"},{"@value":"جول لكل كلفن","@language":"ar"},{"@value":"ژول بر کلوین","@language":"fa"},{"@value":"जूल प्रति कैल्विन","@language":"hi"},{"@value":"ジュール毎立方メートル","@language":"ja"},{"@value":"焦耳每开尔文","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/J-PER-KiloGM","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A $\\textit{Joule Per Kilogram}$, ($J/kg$), is a unit in the category of total energy per unit mass,\n    commonly known as specific enthalpy. It is also known as $\\textit{joules per kilogram}$. The unit has a dimension of\n    $L2T^{-2}$ where $L$ is length, and $T$ is time. This unit is the standard SI unit in this category.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$J/kg$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T-2D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1850"},{"@id":"_:n3-1851"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-J"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA175","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA175","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qud