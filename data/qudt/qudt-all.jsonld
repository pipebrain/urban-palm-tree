://qudt.org/vocab/unit/KiloN-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-M2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/KiloPA"},{"@id":"http://qudt.org/vocab/unit/KiloPA_A"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/M_H2O"},{"@id":"http://qudt.org/vocab/unit/MegaBAR"},{"@id":"http://qudt.org/vocab/unit/MegaN-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MegaPA"},{"@id":"http://qudt.org/vocab/unit/MegaPSI"},{"@id":"http://qudt.org/vocab/unit/MicroATM"},{"@id":"http://qudt.org/vocab/unit/MicroBAR"},{"@id":"http://qudt.org/vocab/unit/MicroPA"},{"@id":"http://qudt.org/vocab/unit/MicroTORR"},{"@id":"http://qudt.org/vocab/unit/MilliBAR"},{"@id":"http://qudt.org/vocab/unit/MilliBAR_A"},{"@id":"http://qudt.org/vocab/unit/MilliM_H2O"},{"@id":"http://qudt.org/vocab/unit/MilliM_HG"},{"@id":"http://qudt.org/vocab/unit/MilliM_HGA"},{"@id":"http://qudt.org/vocab/unit/MilliPA"},{"@id":"http://qudt.org/vocab/unit/MilliTORR"},{"@id":"http://qudt.org/vocab/unit/N-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/N-PER-M2"},{"@id":"http://qudt.org/vocab/unit/N-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/PA"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/PSI"},{"@id":"http://qudt.org/vocab/unit/PicoPA"},{"@id":"http://qudt.org/vocab/unit/PlanckPressure"},{"@id":"http://qudt.org/vocab/unit/TORR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Stress_(mechanics)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\tau = \\frac{dF_t}{dA}$, where $dF_t$ is the tangential component of force and $dA$ is the area of the surface element.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\tau$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Shear stress occurs when the force  occurs in shear, or perpendicular to the normal.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Stress"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q657936"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ForcePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Shear Stress","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Stress"}]},{"@id":"http://qudt.org/vocab/quantitykind/Short-RangeOrderParameter","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Short-Range Order Parameter\" is the fraction of the nearest-neighbor atom pairs in an Ising ferromagnet\n    having magnetic moments in one direction, minus the fraction having magnetic moments in the opposite direction.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/ShortRangeOrderParameter"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$r, \\sigma$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Short-Range Order Parameter\" is the fraction of the nearest-neighbor atom pairs in an Ising\n    ferromagnet having magnetic moments in one direction, minus the fraction having magnetic moments in the opposite direction.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q105495979"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Short-Range Order Parameter","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/ShortRangeOrderParameter","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Short-Range Order Parameter\" is the fraction of the nearest-neighbor atom pairs in an Ising ferromagnet\n    having magnetic moments in one direction, minus the fraction having magnetic moments in the opposite direction.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$r, \\sigma$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Short-Range Order Parameter\" is the fraction of the nearest-neighbor atom pairs in an Ising\n    ferromagnet having magnetic moments in one direction, minus the fraction having magnetic moments in the opposite direction.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q105495979"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ShortRangeOrderParameter","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Short-Range Order Parameter","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SignalDetectionThreshold","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Signal Detection Threshold\" is a dimensionless measure of the threshold for detecting a signal against a\n    background of noise. It has no single fixed form: depending on the method it may be expressed as a detection proportion or\n    probability (e.g. the fraction of signals correctly detected at threshold), as a sensitivity index such as the\n    signal-detection-theory $d'$, or as another dimensionless ratio. In every case it is a pure number.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DeciB_C"},{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Signal Detection Threshold\" is a dimensionless measure of the threshold for detecting a signal\n    against a background of noise. It has no single fixed form: depending on the method it may be expressed as a detection\n    proportion or probability (e.g. the fraction of signals correctly detected at threshold), as a sensitivity index such as the\n    signal-detection-theory d', or as another dimensionless ratio. In every case it is a pure number.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:SignalDetectionThreshold","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Signal Detection Threshold","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/SignalStrength","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In telecommunications, particularly in radio, signal strength refers to the magnitude of the electric\n    field at a reference point that is a significant distance from the transmitting antenna. It may also be referred to as\n    received signal level or field strength. Typically, it is expressed in voltage per length or signal power received by a\n    reference antenna. High-powered transmissions, such as those used in broadcasting, are expressed in dB-millivolts per metre\n    (dBmV/m).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloV-PER-M"},{"@id":"http://qudt.org/vocab/unit/MegaV-PER-M"},{"@id":"http://qudt.org/vocab/unit/MicroV-PER-M"},{"@id":"http://qudt.org/vocab/unit/MilliV-PER-M"},{"@id":"http://qudt.org/vocab/unit/V-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/V-PER-IN"},{"@id":"http://qudt.org/vocab/unit/V-PER-M"},{"@id":"http://qudt.org/vocab/unit/V-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/V_Ab-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/V_Stat-PER-CentiM"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Signal_strength","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L1I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In telecommunications, particularly in radio, signal strength refers to the magnitude of the\n    electric field at a reference point that is a significant distance from the transmitting antenna. It may also be referred to\n    as received signal level or field strength. Typically, it is expressed in voltage per length or signal power received by a\n    reference antenna. High-powered transmissions, such as those used in broadcasting, are expressed in dB-millivolts per metre\n    (dBmV/m).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricField"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricFieldStrength"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricField","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:ElectricFieldStrength","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Signal Strength","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricField"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricFieldStrength"}]},{"@id":"http://qudt.org/vocab/quantitykind/Slowing-DownArea","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Slowing-Down Area\" in an infinite homogenous medium, is one-sixth of the mean square distance between\n    the neutron source and the point where a neutron reaches a given energy.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/SlowingDownArea"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Slowing-Down Area\" in an infinite homogenous medium, is one-sixth of the mean square distance\n    between the neutron source and the point where a neutron reaches a given energy.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"L_s^2","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98950918"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Slowing-Down Area","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Area"}]},{"@id":"http://qudt.org/vocab/quantitykind/Slowing-DownDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Slowing-Down Density\" is a measure of the rate at which neutrons lose energy in a nuclear reactor\n    through collisions; equal to the number of neutrons that fall below a given energy per unit volume per unit time.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/SlowingDownDensity"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ296#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD170","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://encyclopedia2.thefreedictionary.com/slowing-down+density","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD170","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$q = -\\frac{dn}{dt}$, where $n$ is the number density and $dt$ is the duration.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Slowing-Down Density\" is a measure of the rate at which neutrons lose energy in a nuclear reactor\n    through collisions; equal to the number of neutrons that fall below a given energy per unit volume per unit time.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"q","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98915830"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Slowing-Down Density","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/Slowing-DownLength","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Slowing-Down Length\" is the average straight-line distance that a fast neutron will travel between its\n    introduction into the slowing-downmedium (moderator) and thermalization.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/SlowingDownLength"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://nuclearpowertraining.tpub.com/h1013v2/css/h1013v2_32.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Slowing-Down Length\" is the average straight-line distance that a fast neutron will travel between\n    its introduction into the slowing-downmedium (moderator) and thermalization.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"L_s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98996963"}],"http://