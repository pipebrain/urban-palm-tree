ab/dimensionvector/A0E0L-4I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"an einer festgelegten Querschnittsfläche der Quotient Druck durch den Volumenstrom, der durch diese\n    Querschnittsfläche hindurchgeht\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:PressureInRelationToVolumeFlow","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pressure in Relation to Volume Flow","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/PressureInRelationToVolumeFlowRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DYN-SEC-PER-CentiM5"},{"@id":"http://qudt.org/vocab/unit/PA-SEC-PER-L"},{"@id":"http://qudt.org/vocab/unit/PA-SEC-PER-M3"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/PressureInRelationToVolumeFlow"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-4I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD145","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD145","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:PressureInRelationToVolumeFlowRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pressure in Relation to Volume Flow Rate","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/PressureLossPerLength","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Pressure Loss per Length\" refers to the power lost in overcoming the friction between two moving\n    surfaces. Also referred to as \"Friction Loss\".\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M2-SEC2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Friction_loss","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Pressure Loss per Length\" refers to the power lost in overcoming the friction between two moving\n    surfaces. Also referred to as \"Friction Loss\".\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:PressureLossPerLength","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pressure Loss per Length","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/PressureRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BAR-PER-BAR"},{"@id":"http://qudt.org/vocab/unit/HectoPA-PER-BAR"},{"@id":"http://qudt.org/vocab/unit/KiloPA-PER-BAR"},{"@id":"http://qudt.org/vocab/unit/MegaPA-PER-BAR"},{"@id":"http://qudt.org/vocab/unit/MilliBAR-PER-BAR"},{"@id":"http://qudt.org/vocab/unit/PA-PER-BAR"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/PSI-PER-PSI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ314#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD226","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD226","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:PressureRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Pressure Ratio","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/Prevalence","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In epidemiology, prevalence is the proportion of a particular population found to be affected by a\n    medical condition (typically a disease or a risk factor such as smoking or seatbelt use) at a specific time. (Wikipedia)\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PERCENT"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Prevalence","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In epidemiology, prevalence is the proportion of a particular population found to be affected by a\n    medical condition (typically a disease or a risk factor such as smoking or seatbelt use) at a specific time. (Wikipedia)\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q719602"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Prevalence","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Prevalence","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/PrincipalQuantumNumber","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Principal Quantum Number\" describes the electron shell, or energy level, of an atom. The value of\n    $n$ ranges from 1 to the shell containing the outermost electron of that atom.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Quantum_number","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/QuantumNumber"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"n","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q867448"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:PrincipalQuantumNumber","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Principal Quantum Number","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/QuantumNumber"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://qudt.org/vocab/quantitykind/MagneticQuantumNumber"},{"@id":"http://qudt.org/vocab/quantitykind/OrbitalAngularMomentumQuantumNumber"},{"@id":"http://qudt.org/vocab/quantitykind/SpinQuantumNumber"}]},{"@id":"http://qudt.org/vocab/quantitykind/ProductOfInertia","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\n  The quantity kind $\\textit{Product of Inertia}$ is a measure of a body's dynamic\n   (or coupled) imbalance resulting in a precession when rotating about an axis \n   other than the body's principal axis.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T0D0"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/MomentOfInertia"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A measure of a body's dynamic (or coupled) imbalance resulting in a precession when rotating about\n    an axis other than the body's principal axis.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ProductOfInertia","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Product of Inertia","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MomentOfInertia"}]},{"@id":"http://qudt.org/vocab/quantitykind/ProductOfInertia_X","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\n  The quantity kind $\\textit{Product of Inertia in the X axis}$ is a measure of a body's\n   dynamic (or coupled) imbalance resulting in a precession when rotating about an\n  axis other than the body's principal axis.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A measure of a body's dynamic (or coupled) imbalance resulting in a precession when rotating about\n    an axis other than the body's principal axis.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ProductOfInertia"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ProductOfInertia","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Product of Inertia in the X Axis","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ProductOfInertia"}]},{"@id":"http://qudt.org/vocab/quantitykind/ProductOfInertia_Y","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\n  The quantity kind $\\textit{Product of Inertia in the Y axis}$ is a measure of a body's\n   dynamic (or coupled) imbalance resulting in a precession when rotating about an axis\n   other than the body's principal axis.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\n  The quantity kind 'Product of Inertia in the Y axis' is a measure of a body's \n  dynamic (or coupled) imbalance resulting in a precession when rotating about an axis\n  other than the body's principal axis.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ProductOfInertia"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ProductOfInertia","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Product of Inertia in the Y Axis","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ProductOfInertia"}]},{"@id":"http://qudt.org/vocab/quantitykind/ProductOfInertia_Z","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\n  The quantity kind $\\textit{Product of Inertia in the Z axis}$ is a measure of a body's\n   dynamic (or coupled) imbalance resulting in a precession when rotating about an axis\n  other than the body's principal axis.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A measure of a body's dynamic (or coupled) imbalance resulting in a precession when rotating about\n    an axis other than the body's principal axis.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ProductOfInertia"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ProductOfInertia","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Product of Inertia in the Z Axis","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ProductOfInertia"}]},{"@id":"http://qudt.org/vocab/quantitykind/PropagationCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The propagation constant, symbol $\\gamma$, for a given system is defined by the ratio of the amplitude\n    at the source of the wave to the amplitude at some distance x.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PER-KiloM"},{"@id":"http://qudt.org/vocab/unit/PER-M"},{"@id":"http://qudt.org/vocab/unit/PER-MicroM"},{"@id":"http://qudt.org/vocab/unit/PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/PER-NanoM"},{"@id":"http://qudt.org/vocab/unit/PER-PicoM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Propagation_constant","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\gamma = \\alpha + j\\beta$, where $\\alpha$ is the attenuation coefficient and $\\beta$ is the phase coefficient.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\gamma$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1434913"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"belongs to SOQ-ISO","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:PropagationCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Propagation Coefficient","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/QualityFactor","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Quality Factor\", of a resonant circuit, is a measure of the \"goodness\" or quality of a resonant circuit.\n    A higher value for this figure of merit correspondes to a more narrow bandwith, which is desirable in many applications. More\n    formally, $Q$ is the ratio of power stored to power dissipated in the circuit reactance and resistance, respectively\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://en.sourcetronic.com/electrical-measurement-glossary/quality-factor.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.allaboutcircuits.com/vol_2/chpt_6/6.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"If $\\underline{Z} = R + jX$, then $Q = \\left | X \\right |/R$, where $\\underline{Z}$ is impedance, $R$ is resistance, and $X$ is reactance.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Q","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q79467569"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"Resolve Quality Facor - electronics and also doses","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:QualityFactor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Quality Factor","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/Impedance"},{"@id":"http://qudt.org/vocab/quantitykind/Resistance"}]},{"@id":"http://qudt.org/vocab/quantitykind/QuantityOfLight","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"work of a light source provided in the form of light as the product of the luminous flux Φ produced by\n    the light source and the time t for which this is radiated\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/LM-HR"},{"@id":"http://qudt.org/vocab/unit/LM-SEC"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ243#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/LuminousEnergy"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I1M0H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD147","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD147","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"in Form von Licht aufgebrachte Arbeit einer Lichtquelle als Produkt aus dem von der Lichtquelle\n    ausgehenden Lichtstrom Φ und der Zeit t, während dieser ausgestrahlt wird\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:QuantityOfLight","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Quantity of Light","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/QuantumNumber","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Quantum Number\" describes values of conserved quantities in the dynamics of the quantum system.\n    Perhaps the most peculiar aspect of quantum mechanics is the quantization of observable quantities, since quantum numbers are\n    discrete sets of integers or half-integers.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Quantum_number","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31894","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Quantum Number\" describes values of conserved quantities in the dynamics of the quantum\n    system. Perhaps the most peculiar aspect of quantum mechanics is the quantization of observable quantities, since quantum\n    numbers are discrete sets of integers or half-integers.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"n","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q232431"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:QuantumNumber","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Quantum Number","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Dimensionless"}]},{"@id":"http://qudt.org/vocab/quantitykind/QuarticElectricDipoleMomentPerCubicEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/C4-M4-PER-J3"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E4L-2I0M-3H0T10D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:QuarticElectricDipoleMomentPerCubicEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Quartic Electric Dipole Moment per Cubic Energy","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/RESERVE-MASS","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A quantity of mass held by Program/project management to mitigate the risk of over-predicted performance\n    estimates, under predicted mass estimates, and future operational and mission specific requirements (program mass reserve,\n    manager's mass reserve, launch window reserve, performance reserve, etc.).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A quantity of mass held by Program/project management to mitigate the risk of over-predicted\n    performance estimates, under predicted mass estimates, and future operational and mission specific requirements (program mass\n    reserve, manager's mass reserve, launch window reserve, performance reserve, etc.).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"M_{E}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Reserve Mass","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}]},{"@id":"http://qudt.org/vocab/quantitykind/RF-Power","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Radio-Frequency Power. Power level of electromagnetic waves alternating at the frequency of radio waves\n    (up to 10^10 Hz).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/RFPower"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L1I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://www.analog.com/en/technical-articles/measurement-control-rf-power-parti.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Radio-Frequency Power. Power level of electromagnetic waves alternating at the frequency of radio\n    waves (up to 10^10 Hz).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"RF-Power Level","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SignalStrength"}]},{"@id":"http://qudt.org/vocab/quantitykind/RFPower","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Radio-Frequency Power. Power level of electromagnetic waves alternating at the frequency of radio waves\n    (up to 10^10 Hz).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloV-PER-M"},{"@id":"http://qudt.org/vocab/unit/MegaV-PER-M"},{"@id":"http://qudt.org/vocab/unit/MicroV-PER-M"},{"@id":"http://qudt.org/vocab/unit/MilliV-PER-M"},{"@id":"http://qudt.org/vocab/unit/V-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/V-PER-IN"},{"@id":"http://qudt.org/vocab/unit/V-PER-M"},{"@id":"http://qudt.org/vocab/unit/V-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/V_Ab-PER-CentiM"},{"@id":"http://qudt.org/vocab/unit/V_Stat-PER-CentiM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L1I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://www.analog.com/en/technical-articles/measurement-control-rf-power-parti.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Radio-Frequency Power. Power level of electromagnetic waves alternating at the frequency of radio\n    waves (up to 10^10 Hz).\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/SignalStrength"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricField","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:ElectricFieldStrength","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"RF-Power Level","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/SignalStrength"}]},{"@id":"http://qudt.org/vocab/quantitykind/RadialDistance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In classical geometry, the \"Radial Distance\" is a coordinate in polar coordinate systems (r, $\\theta$).\n    Basically the radial distance is the scalar Euclidean distance between a point and the origin of the system of coordinates.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ANGSTROM"},{"@id":"http://qudt.org/vocab/unit/AU"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB_F"},{"@id":"http://qudt.org/vocab/unit/CHAIN"},{"@id":"http://qudt.org/vocab/unit/CHAIN_US"},{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/DecaM"},{"@id":"http://qudt.org/vocab/unit/DeciM"},{"@id":"http://qudt.org/vocab/unit/FATH"},{"@id":"http://qudt.org/vocab/unit/FM"},{"@id":"http://qudt.org/vocab/unit/FT"},{"@id":"http://qudt.org/vocab/unit/FT_US"},{"@id":"http://qudt.org/vocab/unit/FUR"},{"@id":"http://qudt.org/vocab/unit/FemtoM"},{"@id":"http://qudt.org/vocab/unit/GAUGE_FR"},{"@id":"http://qudt.org/vocab/unit/GA_Charriere"},{"@id":"http://qudt.org/vocab/unit/HectoM"},{"@id":"http://qudt.org/vocab/unit/IN"},{"@id":"http://qudt.org/vocab/unit/KiloM"},{"@id":"http://qudt.org/vocab/unit/LY"},{"@id":"http://qudt.org/vocab/unit/M"},{"@id":"http://qudt.org/vocab/unit/MI"},{"@id":"http://qudt.org/vocab/unit/MI_N"},{"@id":"http://qudt.org/vocab/unit/MI_UK"},{"@id":"http://qudt.org/vocab/unit/MI_US"},{"@id":"http://qudt.org/vocab/unit/MicroIN"},{"@id":"http://qudt.org/vocab/unit/MicroM"},{"@id":"http://qudt.org/vocab/unit/MilLength"},{"@id":"http://qudt.org/vocab/unit/MilliIN"},{"@id":"http://qudt.org/vocab/unit/MilliM"},{"@id":"http://qudt.org/vocab/unit/NanoM"},{"@id":"http://qudt.org/vocab/unit/PARSEC"},{"@id":"http://qudt.org/vocab/unit/PCA"},{"@id":"http://qudt.org/vocab/unit/PT"},{"@id":"http://qudt.org/vocab/unit/PicoM"},{"@id":"http://qudt.org/vocab/unit/PlanckLength"},{"@id":"http://qudt.org/vocab/unit/ROD"},{"@id":"http://qudt.org/vocab/unit/YD"},{"@id":"http://qudt.org/vocab/unit/ZOLL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Radial_distance_(geometry)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$d = \\sqrt{r_1^2 + r_2^2 -2r_1r_2\\cos{(\\theta_1 - \\theta_2)}}$, where $P_1$ and $P_2$ are two points with polar coordinates $(r_1, \\theta_1)$ and $(r_2, \\theta_2)$, respectively, and $d$ is the distance.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$r_Q, \\rho$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1578234"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Radial Distance","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}]},{"@id":"http://qudt.org/vocab/quantitykind/Radiance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Radiance\" is a radiometric measure that describes the amount of light that passes through or is emitted\n    from a particular area, and falls within a given solid angle in a specified direction.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/W-PER-M2-SR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD148","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD148","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Radiance","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$L = \\frac{dI}{dA}\\frac{1}{cos\\alpha}$, where $dI$ is the radiant intensity emitted from an element of the surface area $dA$, and angle $\\alpha$ is the angle between the normal to the surface and the given direction.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Radiance\" is a radiometric measure that describes the amount of light that passes through or is\n    emitted from a particular area, and falls within a given solid angle in a specified direction.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/RADI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/PowerPerAreaAngle"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"L","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1411145"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Radiance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Radiance","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/PowerPerAreaAngle"}]},{"@id":"http://qudt.org/vocab/quantitykind/RadianceFactor","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Radiance Factor is the ratio of the radiance of the surface element in the given direction to that of a\n    perfect reflecting or transmitting diffuser identically irradiated unit.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.encyclo.co.uk/define/radiance%20factor","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\beta = \\frac{L_n}{L_d}$, where $L_n$ is the radiance of a surface element in a given direction and $L_d$ is the radiance of the perfect reflecting or transmitting diffuser identically irradiated and viewed. Reflectance factor is equivalent to radiance factor or luminance factor (when the cone angle is infinitely small, and is equivalent to reflectance when the cone angle is $2π sr$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\beta$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Radiance Factor is the ratio of the radiance of the surface element in the given direction to that\n    of a perfect reflecting or transmitting diffuser identically irradiated unit.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q85811846"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:RadianceFactor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Radiance Factor","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/RadiantEmmitance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Irradiance and Radiant Emittance are radiometry terms for the power per unit area of electromagnetic\n    radiation at a surface. \"Irradiance\" is used when the electromagnetic radiation is incident on the surface. \"Radiant\n    emmitance\" (or \"radiant exitance\") is used when the radiation is emerging from the surface.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-FT2-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-FT2-SEC"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-HR-FT2"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-IN2-SEC"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-SEC-FT2"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-FT2-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-FT2-MIN"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-FT2-SEC"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-CentiM2-MIN"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-CentiM2-SEC"},{"@id":"http://qudt.org/vocab/unit/ERG-PER-CentiM2-SEC"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F-PER-FT2-SEC"},{"@id":"http://qudt.org/vocab/unit/J-PER-CentiM2-DAY"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-CentiM2-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-CentiM2-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/M-PA-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MicroW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MilliW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/NanoW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/PicoW-PER-M2"},{"@id":"http://qudt.org/vocab/unit/W-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/W-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/W-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/W-PER-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Irradiance","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$M = \\frac{d\\Phi}{dA}$, where $d\\Phi$ is the radiant flux leaving the element of the surface area $dA$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Irradiance and Radiant Emittance are radiometry terms for the power per unit area of\n    electromagnetic radiation at a surface. \"Irradiance\" is used when the electromagnetic radiation is incident on the surface.\n    \"Radiant emmitance\" (or \"radiant exitance\") is used when the radiation is emerging from the surface.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/PowerPerArea"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:PowerPerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Radiant Emmitance","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/PowerPerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/RadiantEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In radiometry, $\\textit{Radiant Energy}$ is the energy of electromagnetic waves. The quantity of radiant\n    energy may be calculated by integrating radiant flux (or power) with respect to time. In nuclear physics, $\\textit{Radiant\n    Energy}$ is energy, excluding rest energy, of the particles that are emitted, transferred, or received.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"M-L2-PER-T2","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/altSymbol":[{"@value":"R","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AttoJ"},{"@id":"http://qudt.org/vocab/unit/BTU_IT"},{"@id":"http://qudt.org/vocab/unit/BTU_TH"},{"@id":"http://qudt.org/vocab/unit/CAL_IT"},{"@id":"http://qudt.org/vocab/unit/CAL_TH"},{"@id":"http://qudt.org/vocab/unit/ERG"},{"@id":"http://qudt.org/vocab/unit/EV"},{"@id":"http://qudt.org/vocab/unit/E_h"},{"@id":"http://qudt.org/vocab/unit/ExaJ"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F_Energy"},{"@id":"http://qudt.org/vocab/unit/FT-PDL"},{"@id":"http://qudt.org/vocab/unit/FemtoJ"},{"@id":"http://qudt.org/vocab/unit/GigaEV"},{"@id":"http://qudt.org/vocab/unit/GigaJ"},{"@id":"http://qudt.org/vocab/unit/GigaW-HR"},{"@id":"http://qudt.org/vocab/unit/J"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH"},{"@id":"http://qudt.org/vocab/unit/KiloCAL"},{"@id":"http://qudt.org/vocab/unit/KiloEV"},{"@id":"http://qudt.org/vocab/unit/KiloJ"},{"@id":"http://qudt.org/vocab/unit/KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT"},{"@id":"http://qudt.org/vocab/unit/MegaEV"},{"@id":"http://qudt.org/vocab/unit/MegaJ"},{"@id":"http://qudt.org/vocab/unit/MegaTOE"},{"@id":"http://qudt.org/vocab/unit/MegaW-HR"},{"@id":"http://qudt.org/vocab/unit/MicroJ"},{"@id":"http://qudt.org/vocab/unit/MilliJ"},{"@id":"http://qudt.org/vocab/unit/NanoJ"},{"@id":"http://qudt.org/vocab/unit/PetaJ"},{"@id":"http://qudt.org/vocab/unit/PicoJ"},{"@id":"http://qudt.org/vocab/unit/PlanckEnergy"},{"@id":"http://qudt.org/vocab/unit/QUAD"},{"@id":"http://qudt.org/vocab/unit/THERM_EC"},{"@id":"http://qudt.org/vocab/unit/THERM_US"},{"@id":"http://qudt.org/vocab/unit/THM_EEC"},{"@id":"http://qudt.org/vocab/unit/THM_US"},{"@id":"http://qudt.org/vocab/unit/TOE"},{"@id":"http://qudt.org/vocab/unit/TeraJ"},{"@id":"http://qudt.org/vocab/unit/TeraW-HR"},{"@id":"http://qudt.org/vocab/unit/TonEnergy"},{"@id":"http://qudt.org/vocab/unit/W-HR"},{"@id":"http://qudt.org/vocab/unit/W-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Radiant_energy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$Q_e$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In radiometry,\"Radiant Energy} is the energy of electromagnetic waves. The quantity of radiant\n    energy may be calculated by integrating radiant flux (or power) with respect to time.  In nuclear physics, $\\textit{Radiant\n    Energy\" is energy, excluding rest energy, of the particles that are emitted, transferred, or received.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Q_e","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q10932713"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Energy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Işınım erkesi","@language":"tr"},{"@value":"Radiant Energy","@language":"en"},{"@value":"Strahlungsenergie","@language":"de"},{"@value":"Tenaga sinaran","@language":"ms"},{"@value":"energia promienista","@language":"pl"},{"@value":"energia radiante","@language":"it"},{"@value":"energia radiante","@language":"pt"},{"@value":"energie záření","@language":"cs"},{"@value":"energía radiante","@language":"es"},{"@value":"énergie rayonnante","@language":"fr"},{"@value":"энергия излучения","@language":"ru"},{"@value":"انرژی تابشی","@language":"fa"},{"@value":"طاقة إشعاعية","@language":"ar"},{"@value":"विकिरण ऊर्जा","@language":"hi"},{"@value":"放射エネルギー","@language":"ja"},{"@value":"辐射能","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://www.w3.org/2004/02/skos/core#closeMatch":[{"@id":"http://qudt.org/vocab/quantitykind/LuminousEnergy"}]},{"@id":"http://qudt.org/vocab/quantitykind/RadiantEnergyDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Radiant Energy Density\", or radiant power, is the radiant energy per unit volume.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-M3"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}