","@language":"en"},{"@value":"Terabecquerel","@language":"es"},{"@value":"Terabecquerel","@language":"fr"},{"@value":"Terabecquerel","@language":"hu"},{"@value":"Terabecquerel","@language":"it"},{"@value":"Terabecquerel","@language":"ms"},{"@value":"Terabecquerel","@language":"ro"},{"@value":"Terabecquerel","@language":"sl"},{"@value":"Terabecquerel","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Terabekerel","@language":"pl"},{"@value":"Terabekerel","@language":"tr"}]},{"@id":"http://qudt.org/vocab/unit/TeraBYTE","@type":["http://qudt.org/schema/qudt/CountingUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The terabyte is a multiple of the unit byte for digital information. The prefix tera means 10^12 in the\n    International System of Units (SI), and therefore 1 terabyte is 1000000000000bytes, or 1 trillion bytes, or 1000 gigabytes. 1\n    terabyte in binary prefixes is 0.9095 tebibytes, or 931.32 gibibytes. The unit symbol for the terabyte is TB or TByte, but not\n    Tb (lower case b) which refers to terabit.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/ASU"},{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-ESU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/PLANCK"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"8000000000000.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"8.0E12","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Terabyte","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"