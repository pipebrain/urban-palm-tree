"@id":"http://qudt.org/vocab/unit/PK_UK-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PK_US_DRY-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/PK_US_DRY-PER-HR"},{"@id":"http://qudt.org/vocab/unit/PK_US_DRY-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/PK_US_DRY-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/QT_UK-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/QT_UK-PER-HR"},{"@id":"http://qudt.org/vocab/unit/QT_UK-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/QT_UK-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/QT_US-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/QT_US-PER-HR"},{"@id":"http://qudt.org/vocab/unit/QT_US-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/QT_US-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/YD3-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/YD3-PER-HR"},{"@id":"http://qudt.org/vocab/unit/YD3-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/YD3-PER-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T0D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:VolumePerTime","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Volume per Time","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/VolumeStrain","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Volume, or volumetric, Strain, or dilatation (the relative variation of the volume) is the trace of the\n    tensor $\\vartheta$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/PERMILLE"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Deformation_(mechanics)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\vartheta = \\frac{\\Delta V}{V_0}$, where $\\Delta V$ is the increase in volume and $V_0$ is the volume in a reference state to be specified.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\vartheta$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q73432507"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:VolumeStrain","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Volume Strain","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/VolumeThermalExpansion","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"When the temperature of a substance changes, the energy that is stored in the intermolecular bonds\n    between atoms changes. When the stored energy increases, so does the length of the molecular bonds. As a result, solids\n    typically expand in response to heating and contract on cooling; this dimensional response to temperature change is expressed\n    by its coefficient of thermal expansion.  Different coefficients of thermal expansion can be defined for a substance depending\n    on whether the expansion is measured by:  * linear thermal expansion * area thermal expansion * volumetric thermal expansion\n    These characteristics are closely related. The volumetric thermal expansion coefficient can be defined for both liquids and\n    solids. The linear thermal expansion can only be defined for solids, and is common in engineering applications.  Some\n    substances expand when cooled, such as freezing water, so they have negative thermal expansion coefficients. [Wikipedia]\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM3-PER-K"},{"@id":"http://qudt.org/vocab/unit/FT3-PER-DEG_F"},{"@id":"http://qudt.org/vocab/unit/L-PER-K"},{"@id":"http://qudt.org/vocab/unit/M3-PER-K"},{"@id":"http://qudt.org/vocab/unit/MilliL-PER-K"},{"@id":"http://qudt.org/vocab/unit/YD3-PER-DEG_F"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H-1T0D0"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/TemperatureRelatedVolume"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"When the temperature of a substance changes, the energy that is stored in the intermolecular bonds\n    between atoms changes. When the stored energy increases, so does the length of the molecular bonds. As a result, solids\n    typically expand in response to heating and contract on cooling; this dimensional response to temperature change is expressed\n    by its coefficient of thermal expansion.  Different coefficients of thermal expansion can be defined for a substance depending\n    on whether the expansion is measured by:  * linear thermal expansion * area thermal expansion * volumetric thermal expansion\n    These characteristics are closely related. The volumetric thermal expansion coefficient can be defined for both liquids and\n    solids. The linear thermal expansion can only be defined for solids, and is common in engineering applications.  Some\n    substances expand when cooled, such as freezing water, so they have negative thermal expansion coefficients. [Wikipedia]\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:VolumeThermalExpansion","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Volume Thermal Expansion","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/TemperatureRelatedVolume"}]},{"@id":"http://qudt.org/vocab/quantitykind/VolumetricBitDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BIT-PER-M3"},{"@id":"http://qudt.org/vocab/unit/ExbiBIT-PER-M3"},{"@id":"http://qudt.org/vocab/unit/GibiBIT-PER-M3"},{"@id":"http://qudt.org/vocab/unit/KibiBIT-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MebiBIT-PER-M3"},{"@id":"http://qudt.org/vocab/unit/PebiBIT-PER-M3"},{"@id":"http://qudt.org/vocab/unit/TebiBIT-PER-M3"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD241","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD241","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:VolumetricBitDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Volumic Bit Density","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/VolumetricElectricCharge","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-HR-PER-DeciM3"},{"@id":"http://qudt.org/vocab/unit/A-HR-PER-M3"},{"@id":"http://qudt.org/vocab/unit/C-PER-CentiM3"},{"@id":"http://qudt.org/vocab/unit/C-PER-M3"},{"@id":"http://qudt.org/vocab/unit/C-PER-MilliM3"},{"@id":"http://qudt.org/vocab/unit/GigaC-PER-M3"},{"@id":"http://qudt.org/vocab/unit/KiloC-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MegaC-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MicroC-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MilliC-PER-M3"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeVolumeDensity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-3I0M0H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD242","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD242","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:VolumetricElectricCharge","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Volumic Electric Charge","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/VolumetricEntityDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"quantity whose value is inversely proportional to the volume value","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PER-CentiM3"},{"@id":"http://qudt.org/vocab/unit/PER-FT3"},{"@id":"http://qudt.org/vocab/unit/PER-IN3"},{"@id":"http://qudt.org/vocab/unit/PER-L"},{"@id":"http://qudt.org/vocab/unit/PER-M3"},{"@id":"http://qudt.org/vocab/unit/PER-MilliL"},{"@id":"http://qudt.org/vocab/unit/PER-MilliM3"},{"@id":"http://qudt.org/vocab/unit/PER-YD3"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ377#006","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/InverseVolume"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Größe, deren Wert sich umgekehrt proportional zum Volumenwert verhält","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:VolumetricEntityDensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Volumetric Entity Density","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/VolumetricFlux","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In fluid dynamics, the volumetric flux is the rate of volume flow across a unit area\n    (m3·s−1·m−2).[Wikipedia]\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/M3-PER-HA-YR"},{"@id":"http://qudt.org/vocab/unit/M3-PER-SEC-M2"},{"@id":"http://qudt.org/vocab/unit/MilliL-PER-CentiM2-MIN"},{"@id":"http://qudt.org/vocab/unit/MilliL-PER-CentiM2-SEC"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/SurfaceRelatedVolumeFlow"},{"@id":"http://qudt.org/vocab/quantitykind/SurfaceRelatedVolumeFlowRate"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Volumetric_flux","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In fluid dynamics, the volumetric flux is the rate of volume flow across a unit area\n    (m3·s−1·m−2).[Wikipedia]\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T-1D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:VolumetricFlux","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Volumetric Flux","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/VolumetricHeatCapacity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Volumetric Heat Capacity (VHC)}$, also termed $\\textit{volume-specific heat capacity}$,\n    describes the ability of a given volume of a substance to store internal energy while undergoing a given temperature change,\n    but without undergoing a phase transition. It is different from specific heat capacity in that the VHC is a $\\textit{per unit\n    volume}$ measure of the relationship between thermal energy and temperature of a material, while the specific heat is a\n    $\\textit{per unit mass}$ measure (or occasionally per molar quantity of the material).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-CentiM3-K"},{"@id":"http://qudt.org/vocab/unit/J-PER-CentiM3-K"},{"@id":"http://qudt.org/vocab/unit/J-PER-M3-K"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-IN2-DEG_F"},{"@id":"http://qudt.org/vocab/unit/MilliBAR-PER-K"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Volumetric_heat_capacity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H-1T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Volumetric_heat_capacity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q900661"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:VolumetricHeatCapacity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Volumetric Heat Capacity","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/VolumetricOutputPower","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/W-PER-M3"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/PowerDensity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD243","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD243","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:VolumetricOutputPower","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Volumic Output Power","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/VolumicAmountOfSubstance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"quantity proportional to the number of single particles of a defined type present in a given sample,\n    divided by the related volume of this sample\n  ","@language":"en"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ402#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L-3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Größe proportional der Anzahl von Einzelteilchen festgelegter Art, die in einer gegebenen\n    Substanzprobe enthalten sind, dividiert durch das zugehörige Volumen dieser Substanzprobe\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Volumic Amount of Substance","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/VolumicDataQuantity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"amount of data, which is usually dependent on the respective complexity of the information or its coding\n    procedure, divided by the related volume\n  ","@language":"en"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ401#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Anzahl von Daten, die in der Regel abhängig von der jeweiligen Komplexität der Information oder\n    deren Codierungsverfahren ist, dividiert durch das zugehörige Volumen\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Volumic Data Quantity","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/VolumicElectromagneticEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Volumic Electromagnetic Energy}$, also known as the $\\textit{Electromagnetic Energy Density}$,\n    is the energy associated with an electromagnetic field, per unit volume of the field.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-M3"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/ElectromagneticEnergyDensity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.electropedia.org/iev/iev.nsf/display?openform&ievref=121-11-64","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://webstore.iec.ch/en/publication/60010","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$w = (1/2) ( \\mathbf{E} \\cdot \\mathbf{D} + \\mathbf{B} \\cdot \\mathbf{H})$, where $\\mathbf{E}$ is electric field strength, $\\mathbf{D}$ is electric flux density, $\\mathbf{M}$ is magnetic flux density, and $\\mathbf{H}$ is magnetic field strength.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$w$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyDensity"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:VolumicElectromagneticEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Volumic Electromagnetic Energy","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricFieldStrength"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricFluxDensity"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFieldStrength"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticFluxDensity"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/EnergyDensity"}]},{"@id":"http://qudt.org/vocab/quantitykind/VolumicOutput","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio released power divided by volume","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/W-PER-M3"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ366#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/PowerDensity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient freigesetzte Wärmeleistung durch Volumen","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:VolumicOutput","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Volumic Output","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/Vorticity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In the simplest sense, vorticity is the tendency for elements of a fluid to \"spin.\" More formally,\n    vorticity can be related to the amount of \"circulation\" or \"rotation\" (or more strictly, the local angular rate of rotation)\n    in a fluid. The average vorticity in a small region of fluid flow is equal to the circulation C around the boundary of the\n    small region, divided by the area A of the small region. Mathematically, vorticity is a vector field and is defined as the\n    curl of the velocity field.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG-PER-HR"},{"@id":"http://qudt.org/vocab/unit/DEG-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/DEG-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PlanckFrequency_Ang"},{"@id":"http://qudt.org/vocab/unit/RAD-PER-HR"},{"@id":"http://qudt.org/vocab/unit/RAD-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/RAD-PER-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\omega$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In the simplest sense, vorticity is the tendency for elements of a fluid to \"spin.\" More formally,\n    vorticity can be related to the amount of \"circulation\" or \"rotation\" (or more strictly, the local angular rate of rotation)\n    in a fluid. The average vorticity in a small region of fluid flow is equal to the circulation C around the boundary of the\n    small region, divided by the area A of the small region. Mathematically, vorticity is a vector field and is defined as the\n    curl of the velocity field.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/AngularFrequency"},{"@id":"http://qudt.org/vocab/quantitykind/AngularVelocity"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1143513"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:AngularFrequency","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:AngularVelocity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Vorticity","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AngularFrequency"},{"@id":"http://qudt.org/vocab/quantitykind/AngularVelocity"}]},{"@id":"http://qudt.org/vocab/quantitykind/WarmReceptorThreshold","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Warm Receptor Threshold\" is the threshold of warm-sensitive free nerve-ending.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_C"},{"@id":"http://qudt.org/vocab/unit/DEG_C_GROWING_CEREAL"},{"@id":"http://qudt.org/vocab/unit/DEG_F"},{"@id":"http://qudt.org/vocab/unit/DEG_R"},{"@id":"http://qudt.org/vocab/unit/DecaK"},{"@id":"http://qudt.org/vocab/unit/K"},{"@id":"http://qudt.org/vocab/unit/MegaK"},{"@id":"http://qudt.org/vocab/unit/MilliDEG_C"},{"@id":"http://qudt.org/vocab/unit/MilliK"},{"@id":"http://qudt.org/vocab/unit/PlanckTemperature"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\overline{T_w}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Warm Receptor Threshold\" is the threshold of warm-sensitive free nerve-ending.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Temperature","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Warm Receptor Threshold","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/WarpingConstant","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Warping Constant\" is a measure for the warping constant or warping resistance of a cross section\n    under torsional loading. It is usually measured in m⁶.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM6"},{"@id":"http://qudt.org/vocab/unit/M6"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L6I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://standards.buildingsmart.org/IFC/RELEASE/IFC4/ADD1/HTML/link/ifcwarpingconstantmeasure.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Warping Constant\" is a measure for the warping constant or warping resistance of a cross\n    section under torsional loading. It is usually measured in m⁶.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:WarpingConstant","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Warping Constant","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/WarpingMoment","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The warping moment measure is a measure for the warping moment, which occurs in warping torsional\n    analysis. It is usually measured in kNm².\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloN-M2"},{"@id":"http://qudt.org/vocab/unit/N-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://standards.buildingsmart.org/IFC/RELEASE/IFC4/ADD1/HTML/link/ifcwarpingmomentmeasure.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The warping moment measure is a measure for the warping moment, which occurs in warping torsional\n    analysis. It is usually measured in kNm².\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:WarpingMoment","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Warping Moment","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/WaterHorsepower","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"No pump can convert all of its mechanical power into water power. Mechanical power is lost in the pumping\n    process due to friction losses and other physical losses. It is because of these losses that the horsepower going into the\n    pump has to be greater than the water horsepower leaving the pump. The efficiency of any given pump is defined as the ratio of\n    the water horsepower out of the pump compared to the mechanical horsepower into the pump.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BAR-L-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/BAR-M3-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/ERG-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/ExaJ-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/ExaW"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F-PER-HR"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/GigaJ-PER-HR"},{"@id":"http://qudt.org/vocab/unit/GigaJ-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/GigaW"},{"@id":"http://qudt.org/vocab/unit/HP"},{"@id":"http://qudt.org/vocab/unit/HP_Boiler"},{"@id":"http://qudt.org/vocab/unit/HP_Brake"},{"@id":"http://qudt.org/vocab/unit/HP_Electric"},{"@id":"http://qudt.org/vocab/unit/HP_H2O"},{"@id":"http://qudt.org/vocab/unit/HP_Metric"},{"@id":"http://qudt.org/vocab/unit/HectoPA-L-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/HectoPA-M3-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/J-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/J-PER-HR"},{"@id":"http://qudt.org/vocab/unit/J-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/J-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F-M-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloJ-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloW"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MegaJ-PER-HR"},{"@id":"http://qudt.org/vocab/unit/MegaJ-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MegaPA-L-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MegaPA-M3-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MegaW"},{"@id":"http://qudt.org/vocab/unit/MicroJ-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MicroW"},{"@id":"http://qudt.org/vocab/unit/MilliBAR-L-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MilliBAR-M3-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MilliJ-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MilliW"},{"@id":"http://qudt.org/vocab/unit/NanoJ-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/NanoW"},{"@id":"http://qudt.org/vocab/unit/PA-L-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PA-M3-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PFERDESTAERKE"},{"@id":"http://qudt.org/vocab/unit/PSI-IN3-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PSI-L-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PSI-M3-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PSI-YD3-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PetaJ-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PetaW"},{"@id":"http://qudt.org/vocab/unit/PicoJ-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PicoW"},{"@id":"http://qudt.org/vocab/unit/PlanckPower"},{"@id":"http://qudt.org/vocab/unit/THM_US-PER-HR"},{"@id":"http://qudt.org/vocab/unit/TON_FG"},{"@id":"http://qudt.org/vocab/unit/TeraJ-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/TeraW"},{"@id":"http://qudt.org/vocab/unit/TeraW-HR-PER-YR"},{"@id":"http://qudt.org/vocab/unit/W"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://pubs.nmsu.edu/_m/M227/index.html#:~:text=Water%20horsepower%20is%20the%20minimum,produce%20that%20flow%20are%20known.","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Power","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Water Horsepower","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}]},{"@id":"http://qudt.org/vocab/quantitykind/WaterSolubility","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"An amount of substance per unit volume that is the concentration of a saturated solution expressed as the\n    ratio of the solute concentration over the volume of water.  A substance's solubility fundamentally depends on several\n    physical and chemical properties of the solution as well as the environment it is in.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FemtoMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/KiloMOL-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-DeciM3"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/MOL-PER-M3"},{"@id":"http://qudt.org/vocab/unit/MicroMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/MilliMOL-PER-M3"},{"@id":"http://qudt.org/vocab/unit/PicoMOL-PER-L"},{"@id":"http://qudt.org/vocab/unit/PicoMOL-PER-M3"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L-3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"An amount of substance per unit volume that is the concentration of a saturated solution expressed\n    as the ratio of the solute concentration over the volume of water.  A substance's solubility fundamentally depends on several\n    physical and chemical properties of the solution as well as the environment it is in.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstanceConcentration"},{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstancePerVolume"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:WaterSolubility","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Water Solubility","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstanceConcentration"},{"@id":"http://qudt.org/vocab/quantitykind/AmountOfSubstancePerVolume"}]},{"@id":"http://qudt.org/vocab/quantitykind/WaterVaporDiffusionCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/WaterVapourDiffusionCoefficient"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://www.wufi-wiki.com/mediawiki/index.php/Details:WaterVaporDiffusion","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The Water vapour diffusion coefficient describes how easy vapour diffusion happens in a given\n    material.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Wasserdampfdiffusionsleitkoeffizient","@language":"de"},{"@value":"Water vapour diffusion coefficient","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/WaterVapourDiffusionCoefficient","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-PA-SEC-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://www.wufi-wiki.com/mediawiki/index.php/Details:WaterVaporDiffusion","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The Water vapour diffusion coefficient describes how easy vapour diffusion happens in a given\n    material.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:WaterVapourDiffusionCoefficient","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Wasserdampfdiffusionsleitkoeffizient","@language":"de"},{"@value":"Water Vapour Diffusion Coefficient","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/WaterVapourPermeability","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"mass of water vapour passing a surface divided by the area of this surface, the pressure difference, and\n    the corresponding time\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-PA-SEC-M"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ446#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/VapourPermeability"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD244","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD244","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Masse des durch eine Fläche hindurchtretenden Wasserdampfes, dividiert durch den Flächeninhalt\n    dieser Fläche, die Druckdifferenz und die dazugehörige Zeit\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:WaterVapourPermeability","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Water Vapour Permeability","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/Wavelength","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"For a monochromatic wave, \"wavelength\" is the distance between two successive points in a direction\n    perpendicular to the wavefront where at a given instant the phase differs by $2\\pi$. The wavelength of a sinusoidal wave is\n    the spatial period of the wave—the distance over which the wave's shape repeats. The SI unit of wavelength is the meter.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ANGSTROM"},{"@id":"http://qudt.org/vocab/unit/AU"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB_F"},{"@id":"http://qudt.org/vocab/unit/CHAIN"},{"@id":"http://qudt.org/vocab/unit/CHAIN_US"},{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/DecaM"},{"@id":"http://qudt.org/vocab/unit/DeciM"},{"@id":"http://qudt.org/vocab/unit/FATH"},{"@id":"http://qudt.org/vocab/unit/FM"},{"@id":"http://qudt.org/vocab/unit/FT"},{"@id":"http://qudt.org/vocab/unit/FT_US"},{"@id":"http://qudt.org/vocab/unit/FUR"},{"@id":"http://qudt.org/vocab/unit/FemtoM"},{"@id":"http://qudt.org/vocab/unit/GAUGE_FR"},{"@id":"http://qudt.org/vocab/unit/GA_Charriere"},{"@id":"http://qudt.org/vocab/unit/HectoM"},{"@id":"http://qudt.org/vocab/unit/IN"},{"@id":"http://qudt.org/vocab/unit/KiloM"},{"@id":"http://qudt.org/vocab/unit/LY"},{"@id":"http://qudt.org/vocab/unit/M"},{"@id":"http://qudt.org/vocab/unit/MI"},{"@id":"http://qudt.org/vocab/unit/MI_N"},{"@id":"http://qudt.org/vocab/unit/MI_UK"},{"@id":"http://qudt.org/vocab/unit/MI_US"},{"@id":"http://qudt.org/vocab/unit/MicroIN"},{"@id":"http://qudt.org/vocab/unit/MicroM"},{"@id":"http://qudt.org/vocab/unit/MilLength"},{"@id":"http://qudt.org/vocab/unit/MilliIN"},{"@id":"http://qudt.org/vocab/unit/MilliM"},{"@id":"http://qudt.org/vocab/unit/NanoM"},{"@id":"http://qudt.org/vocab/unit/PARSEC"},{"@id":"http://qudt.org/vocab/unit/PCA"},{"@id":"http://qudt.org/vocab/unit/PT"},{"@id":"http://qudt.org/vocab/unit/PicoM"},{"@id":"http://qudt.org/vocab/unit/PlanckLength"},{"@id":"http://qudt.org/vocab/unit/ROD"},{"@id":"http://qudt.org/vocab/unit/YD"},{"@id":"http://qudt.org/vocab/unit/ZOLL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD455","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD455","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Wavelength","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\lambda = \\frac{c}{\\nu}$, where $\\lambda$ is the wave length, $\\nu$ is the frequency, and $c$ is the speed of light in the medium.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"λ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q41364"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"belongs to SOQ-ISO","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Length","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Jarak gelombang","@language":"ms"},{"@value":"Vlnové délka","@language":"cs"},{"@value":"Wavelength","@language":"en"},{"@value":"Wellenlänge","@language":"de"},{"@value":"comprimento de onda","@language":"pt"},{"@value":"dalga boyu","@language":"tr"},{"@value":"longitud de onda","@language":"es"},{"@value":"longueur d'onde","@language":"fr"},{"@value":"lunghezza d'onda","@language":"it"},{"@value":"длина волны","@language":"ru"},{"@value":"طول موج","@language":"fa"},{"@value":"波长","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}]},{"@id":"http://qudt.org/vocab/quantitykind/Wavenumber","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Wavenumber\" is the spatial frequency of a wave - the number of waves that exist over a specified\n    distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector. Light passing\n    through different media keeps its frequency, but not its wavelength or wavenumber. The unit for wavenumber commonly used in\n    spectroscopy is centimetre to power minus one, PER-CM, rather than metre to power minus one, PER-M.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PER-M"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD392","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD392","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Wavenumber","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\sigma = \\frac{\\nu}{c}$, where $\\sigma$ is the wave number, $\\nu$ is the frequency, and $c$ is the speed of light in the medium.\n\nOr:\n\n$k = \\frac{2\\pi}{\\lambda}= \\frac{2\\pi\\upsilon}{\\upsilon_p}=\\frac{\\omega}{\\upsilon_p}$, where $\\upsilon$ is the frequency of the wave, $\\lambda$ is the wavelength, $\\omega = 2\\pi \\upsilon$ is the angular frequency of the wave, and $\\upsilon_p$ is the phase velocity of the wave.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\sigma$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/InverseLength"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Wavenumber\" is the spatial frequency of a wave - the number of waves that exist over a specified\n    distance. More formally, it is the reciprocal of the wavelength. It is also the magnitude of the wave vector. Light passing\n    through different media keeps its frequency, but not its wavelength or wavenumber. The unit for wavenumber commonly used in\n    spectroscopy is centimetre to power minus one, PER-CM, rather than metre to power minus one, PER-M.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/WANU"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q192510"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Wavenumber","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bilangan gelombang","@language":"ms"},{"@value":"Liczba falowa","@language":"pl"},{"@value":"Repetenz","@language":"de"},{"@value":"Vlnové číslo","@language":"cs"},{"@value":"Wavenumber","@language":"en"},{"@value":"dalga sayısı","@language":"tr"},{"@value":"nombre d'onde","@language":"fr"},{"@value":"numero d'onda","@language":"it"},{"@value":"número de ola","@language":"es"},{"@value":"número de onda","@language":"pt"},{"@value":"valovno število","@language":"sl"},{"@value":"Волновое число","@language":"ru"},{"@value":"عدد الموجة","@language":"ar"},{"@value":"عدد موج","@language":"fa"},{"@value":"波数","@language":"ja"},{"@value":"波数","@language":"zh"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/AngularWavenumber"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Wellenzahl","@language":"de"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/InverseLength"}]},{"@id":"http://qudt.org/vocab/quantitykind/WebTime","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MilliSEC"},{"@id":"http://qudt.org/vocab/unit/SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Time"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:WebTime","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Web Time","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Time"}]},{"@id":"http://qudt.org/vocab/quantitykind/WebTimeAveragePressure","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ATM"},{"@id":"http://qudt.org/vocab/