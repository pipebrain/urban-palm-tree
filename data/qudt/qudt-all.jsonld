hema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q321017"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Roentgen","@language":"en"},{"@value":"Roentgen","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/R-PER-SEC","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"unit roentgen, the use of which is no longer permitted divided by the SI base unit second","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.000258","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"2.58E-4","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4843"},{"@id":"_:n3-4844"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ExposureRate"},{"@id":"http://qudt.org/vocab/quantitykind/ExposureRateOfIonizingRadiation"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA276","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA276","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"R/s","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"R.s-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"D6","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ExposureRate"},{"@id":"http://qudt.org/vocab/quantitykind/ExposureRateOfIonizingRadiation"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Roentgen per Second","@language":"en"},{"@value":"Roentgen per Second","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/RAD","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The radian is the standard unit of angular measure, used in many areas of mathematics. It describes the\n    plane angle subtended by a circular arc as the length of the arc divided by the radius of the arc. In the absence of any\n    symbol radians are assumed, and when degrees are meant the symbol $^{\\ circ}$ is used.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Radian","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/guidance":[{"@value":"<p>See NIST section <a href=\"http://physics.nist.gov/Pubs/SP811/sec07.html#7.10\">SP811 section7.10</a></p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4845"},{"@id":"_:n3-4846"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA966","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA966","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Radian?oldid=492309312","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/radian"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The radian is the standard unit of angular measure, used in many areas of mathematics. It describes\n    the plane angle subtended by a circular arc as the length of the arc divided by the radius of the arc. The unit was formerly a\n    SI supplementary unit, but this category was abolished in 1995 and the radian is now considered a SI derived unit. The SI unit\n    of solid angle measurement is the steradian.  The radian is represented by the symbol \"rad\" or, more rarely, by the\n    superscript c (for \"circular measure\"). For example, an angle of 1.2 radians would be written as \"1.2 rad\" or \"1.2c\" (the\n    second symbol is often mistaken for a degree: \"1.2u00b0\"). As the ratio of two lengths, the radian is a \"pure number\" that\n    needs no unit symbol, and in mathematical writing the symbol \"rad\" is almost always omitted. In the absence of any symbol\n    radians are assumed, and when degrees are meant the symbol u00b0 is used. [Wikipedia]\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/SI/units/radian"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"rad","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"rad","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/udunitsCode":[{"@value":"rad","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"C81","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q33680"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"The radian and steradian are special names for the number one that may be used to convey information about the\n    quantity concerned. In practice the symbols rad and sr are used where appropriate, but the symbol for the derived unit one is\n    generally omitted in specifying the values of dimensionless quantities.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Radian","@language":"en"},{"@value":"Radian","@language":"fr"},{"@value":"Radian","@language":"la"},{"@value":"Radian","@language":"ms"},{"@value":"Radian","@language":"pl"},{"@value":"Radian","@language":"ro"},{"@value":"Radian","@language":"sl"},{"@value":"Radian","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Radiano","@language":"pt"},{"@value":"Radiant","@language":"de"},{"@value":"Radiante","@language":"it"},{"@value":"Radián","@language":"cs"},{"@value":"Radián","@language":"es"},{"@value":"Radián","@language":"hu"},{"@value":"Radyan","@language":"tr"},{"@value":"Ακτίνιο","@language":"el"},{"@value":"Радиан","@language":"bg"},{"@value":"Радиан","@language":"ru"},{"@value":"רדיאן","@language":"he"},{"@value":"راديان","@language":"ar"},{"@value":"رادیان","@language":"fa"},{"@value":"वर्ग मीटर","@language":"hi"},{"@value":"ラジアン","@language":"ja"},{"@value":"弧度","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/RAD-M2-PER-KiloGM","@type":["http://qudt.org/schema/qudt/Unit"],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$rad m^2 / kg$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-4847"},{"@id":"_:n3-4848"},{"@id":"_:n3-4849"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SpecificOpticalRotationalAbility"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificOpticalRotatoryPower"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB162","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB162","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"rad·m²/kg","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"rad.m2.kg-1","@type":"http://qudt.org/schema/qudt/UCU