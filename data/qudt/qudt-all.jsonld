/qudt.org/vocab/unit/KiloGM_F-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/KiloLB_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-M2"},{"@id":"http://qudt.org/vocab/unit/KiloN-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/KiloPA"},{"@id":"http://qudt.org/vocab/unit/KiloPA_A"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/LB_F-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/M_H2O"},{"@id":"http://qudt.org/vocab/unit/MegaBAR"},{"@id":"http://qudt.org/vocab/unit/MegaN-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MegaPA"},{"@id":"http://qudt.org/vocab/unit/MegaPSI"},{"@id":"http://qudt.org/vocab/unit/MicroATM"},{"@id":"http://qudt.org/vocab/unit/MicroBAR"},{"@id":"http://qudt.org/vocab/unit/MicroPA"},{"@id":"http://qudt.org/vocab/unit/MicroTORR"},{"@id":"http://qudt.org/vocab/unit/MilliBAR"},{"@id":"http://qudt.org/vocab/unit/MilliBAR_A"},{"@id":"http://qudt.org/vocab/unit/MilliM_H2O"},{"@id":"http://qudt.org/vocab/unit/MilliM_HG"},{"@id":"http://qudt.org/vocab/unit/MilliM_HGA"},{"@id":"http://qudt.org/vocab/unit/MilliPA"},{"@id":"http://qudt.org/vocab/unit/MilliTORR"},{"@id":"http://qudt.org/vocab/unit/N-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/N-PER-M2"},{"@id":"http://qudt.org/vocab/unit/N-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/PA"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/PDL-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/PSI"},{"@id":"http://qudt.org/vocab/unit/PicoPA"},{"@id":"http://qudt.org/vocab/unit/PlanckPressure"},{"@id":"http://qudt.org/vocab/unit/TORR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Pressure","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Another name for Force Per Area, used by the Industry Foundation Classes (IFC) standard.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"p","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ForcePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Flächenlast","@language":"de"},{"@value":"Planar Force","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/PlanckFunction","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In the ISO System of Quantities, the $\\textit{Planck function}$ is defined by the formula $Y = -G/T$,\n    where $G$ is Gibbs energy and $T$ is thermodynamic temperature. It is a thermodynamic potential divided by temperature (a\n    \"free entropy\"), expressed in joules per kelvin, and is the Gibbs-energy counterpart of the Massieu function $J = -A/T$. The\n    same name is also widely used in radiometry for the spectral radiance $B(T)$ emitted by a black body, given by Planck's law;\n    that is a different quantity, of a different dimension, and is covered by quantitykind:SpectralRadiance.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H-1T-2D0"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$Y = -G/T$, where $G$ is Gibbs energy and $T$ is thermodynamic temperature.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q76364998"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:PlanckFunction","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Planck Function","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/MassieuFunction"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnthalpy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificGibbsEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHelmholtzEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificInternalEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SpectralRadiance"}]},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The inclination to each other of two intersecting lines, measured by the arc of a circle intercepted\n    between the two lines forming the angle, the center of the circle being the point of intersection.  An acute angle is less\n    than $90^\\circ$, a right angle $90^\\circ$; an obtuse angle, more than $90^\\circ$ but less than $180^\\circ$; a straight\n    angle, $180^\\circ$; a reflex angle, more than $180^\\circ$ but less than $360^\\circ$; a perigon, $360^\\circ$. Any angle not\n    a multiple of $90^\\circ$ is an oblique angle. If the sum of two angles is $90^\\circ$, they are complementary angles; if\n    $180^\\circ$, supplementary angles; if $360^\\circ$, explementary angles.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ARCMIN"},{"@id":"http://qudt.org/vocab/unit/ARCSEC"},{"@id":"http://qudt.org/vocab/unit/DEG"},{"@id":"http://qudt.org/vocab/unit/GON"},{"@id":"http://qudt.org/vocab/unit/GRAD"},{"@id":"http://qudt.org/vocab/unit/MIL_Angle"},{"@id":"http://qudt.org/vocab/unit/MIN_Angle"},{"@id":"http://qudt.org/vocab/unit/MicroRAD"},{"@id":"http://qudt.org/vocab/unit/MilliARCSEC"},{"@id":"http://qudt.org/vocab/unit/MilliRAD"},{"@id":"http://qudt.org/vocab/unit/RAD"},{"@id":"http://qudt.org/vocab/unit/REV"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Plane_angle","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ205#007","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD140","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.thefreedictionary.com/plane+angle","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD140","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"An angle formed by two straight lines (in the same plane) angle - the space between two lines or\n    planes that intersect; the inclination of one line to another; measured in degrees or radians\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/ANGP"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:PlaneAngle","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Plane Angle","@language":"en"},{"@value":"Rovinný úhel","@language":"cs"},{"@value":"Sudut satah","@language":"ms"},{"@value":"angle plan","@language":"fr"},{"@value":"angolo piano","@language":"it"},{"@value":"angulus planus","@language":"la"},{"@value":"düzlemsel açı","@language":"tr"},{"@value":"ebener Winkel","@language":"de"},{"@value":"kąt płaski","@language":"pl"},{"@value":"medida angular","@language":"pt"},{"@value":"ravninski kot","@language":"sl"},{"@value":"szög","@language":"hu"},{"@value":"unghi plan","@language":"ro"},{"@value":"ángulo plano","@language":"es"},{"@value":"Επίπεδη γωνία","@language":"el"},{"@value":"Плоский угол","@language":"ru"},{"@value":"Равнинен ъгъл","@language":"bg"},{"@value":"זווית","@language":"he"},{"@value":"الزاوية النصف قطرية","@language":"ar"},{"@value":"زاویه مستوی","@language":"fa"},{"@value":"क्षेत्र","@language":"hi"},{"@value":"弧度","@language":"ja"},{"@value":"角度","@language":"zh"}]},{"@id":"http://qudt.org/vocab/quantitykind/PlasmaLevel","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Concentration of a biologically active substance in blood plasma, expressed in International\n    Units per volume (e.g. IU/L). It is dimensioned as mass concentration, following the mass-equivalent treatment of\n    the International Unit (see unit:IU and quantitykind:AmountOfBiologicallyActiveSubstance), not as amount-of-substance\n    concentration.","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/IU-PER-L"},{"@id":"http://qudt.org/vocab/unit/IU-PER-MilliL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M1H0T0D0"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/MassConcentration"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:PlasmaLevel","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Plasma Level","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MassConcentration"}]},{"@id":"http://qudt.org/vocab/quantitykind/PoissonRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The Poisson Ratio is the negative ratio of transverse to axial strain. In fact, when a sample object is\n    stretched (or squeezed), to an extension (or contraction) in the direction of the applied load, it corresponds a contraction\n    (or extension) in a direction perpendicular to the applied load. The ratio between these two quantities is the Poisson's\n    ratio.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Poisson%27s_ratio","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\mu = \\frac{\\Delta \\delta}{\\Delta l}$, where $\\Delta \\delta$ is the lateral contraction and $\\Delta l$ is the elongation.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mu$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The Poisson Ratio is the negative ratio of transverse to axial strain. In fact, when a sample\n    object is stretched (or squeezed), to an extension (or contraction) in the direction of the applied load, it corresponds a\n    contraction (or extension) in a direction perpendicular to the applied load. The ratio between these two quantities is the\n    Poisson's ratio.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:PoissonRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Poisson Ratio","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/PolarMomentOfInertia","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The polar moment of inertia is a quantity used to predict an object's ability to resist torsion, in\n    objects (or segments of objects) with an invariant circular cross-section and no significant warping or out-of-plane\n    deformation. It is used to calculate the angular displacement of an object subjected to a torque. It is analogous to the area\n    moment of inertia, which characterizes an object's ability to resist bending.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloGM-M2"},{"@id":"http://qudt.org/vocab/unit/KiloGM-MilliM2"},{"@id":"http://qudt.org/vocab/unit/LB-FT2"},{"@id":"http://qudt.org/vocab/unit/LB-IN2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Second_moment_of_area","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The polar moment of inertia is a quantity used to predict an object's ability to resist torsion, in\n    objects (or segments of objects) with an invariant circular cross-section and no significant warping or out-of-plane\n    deformation. It is used to calculate the angular displacement of an object subjected to a torque. It is analogous to the area\n    moment of inertia, which characterizes an object's ability to resist bending.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MomentOfInertia"},{"@id":"http://qudt.org/vocab/quantitykind/RotationalMass"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"J_{zz}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MomentOfInertia","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:RotationalMass","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Polar Moment of Inertia","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MomentOfInertia"},{"@id":"http://qudt.org/vocab/quantitykind/RotationalMass"}]},{"@id":"http://qudt.org/vocab/quantitykind/Polarizability","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Polarizability\" is the relative tendency of a charge distribution, like the electron cloud of an atom or\n    molecule, to be distorted from its normal shape by an external electric field, which may be caused by the presence of a nearby\n    ion or dipole. The electronic polarizability $\\alpha$ is defined as the ratio of the induced dipole moment of an atom to the\n    electric field that produces this dipole moment. Polarizability is often a scalar valued quantity, however in the general case\n    it is tensor-valued.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"},{"@value":"measure of the deformability of the electron shell of molecules and atoms","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/C-M2-PER-V"},{"@id":"http://qudt.org/vocab/unit/C2-M2-PER-J"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Polarizability","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ365#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E2L0I0M-1H0T4D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD141","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD141","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\alpha$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Maß für die Deformierbarkeit der Elektronenhülle von Molekülen und Atomen ","@language":"de"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q869891"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Polarizability","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Polarisability","@language":"en"},{"@value":"Polarizability","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/PolarizationField","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The Polarization Field is the vector field that expresses the density of permanent or induced electric\n    dipole moments in a dielectric material. The polarization vector P is defined as the ratio of electric dipole moment per unit\n    volume.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-HR-PER-M2"},{"@id":"http://qudt.org/vocab/unit/C-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/C-PER-M2"},{"@id":"http://qudt.org/vocab/unit/C-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/C_Ab-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/C_Stat-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MegaC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MicroC-PER-M2"},{"@id":"http://qudt.org/vocab/unit/MilliC-PER-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-2I0M0H0T1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The Polarization Field is the vector field that expresses the density of permanent or induced\n    electric dipole moments in a dielectric material. The polarization vector P is defined as the ratio of electric dipole moment\n    per unit volume.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerArea"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"P","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ElectricChargePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Polarization Field","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargePerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/Population","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Population typically refers to the number of people in a single area, whether it be a city or town,\n    region, country, continent, or the world, but can also represent the number of any kind of entity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/COUNT"},{"@id":"http://qudt.org/vocab/unit/INDIV"},{"@id":"http://qudt.org/vocab/unit/KiloINDIV"},{"@id":"http://qudt.org/vocab/unit/MegaINDIV"},{"@id":"http://qudt.org/vocab/unit/NUM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Population","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/Count"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Population typically refers to the number of people in a single area, whether it be a city or town,\n    region, country, continent, or the world, but can also represent the number of any kind of entity.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Population","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Population","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Count"}]},{"@id":"http://qudt.org/vocab/quantitykind/PositionVector","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A \"Position Vector\", also known as location vector or radius vector, is a Euclidean vector which\n    represents the position of a point P in space in relation to an arbitrary reference origin O.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ANGSTROM"},{"@id":"http://qudt.org/vocab/unit/AU"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB_F"},{"@id":"http://qudt.org/vocab/unit/CHAIN"},{"@id":"http://qudt.org/vocab/unit/CHAIN_US"},{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/DecaM"},{"@id":"http://qudt.org/vocab/unit/DeciM"},{"@id":"http://qudt.org/vocab/unit/FATH"},{"@id":"http://qudt.org/vocab/unit/FM"},{"@id":"http://qudt.org/vocab/unit/FT"},{"@id":"http://qudt.org/vocab/unit/FT_US"},{"@id":"http://qudt.org/vocab/unit/FUR"},{"@id":"http://qudt.org/vocab/unit/FemtoM"},{"@id":"http://qudt.org/vocab/unit/GAUGE_FR"},{"@id":"http://qudt.org/vocab/unit/GA_Charriere"},{"@id":"http://qudt.org/vocab/unit/HectoM"},{"@id":"http://qudt.org/vocab/unit/IN"},{"@id":"http://qudt.org/vocab/unit/KiloM"},{"@id":"http://qudt.org/vocab/unit/LY"},{"@id":"http://qudt.org/vocab/unit/M"},{"@id":"http://qudt.org/vocab/unit/MI"},{"@id":"http://qudt.org/vocab/unit/MI_N"},{"@id":"http://qudt.org/vocab/unit/MI_UK"},{"@id":"http://qudt.org/vocab/unit/MI_US"},{"@id":"http://qudt.org/vocab/unit/MicroIN"},{"@id":"http://qudt.org/vocab/unit/MicroM"},{"@id":"http://qudt.org/vocab/unit/MilLength"},{"@id":"http://qudt.org/vocab/unit/MilliIN"},{"@id":"http://qudt.org/vocab/unit/MilliM"},{"@id":"http://qudt.org/vocab/unit/NanoM"},{"@id":"http://qudt.org/vocab/unit/PARSEC"},{"@id":"http://qudt.org/vocab/unit/PCA"},{"@id":"http://qudt.org/vocab/unit/PT"},{"@id":"http://qudt.org/vocab/unit/PicoM"},{"@id":"http://qudt.org/vocab/unit/PlanckLength"},{"@id":"http://qudt.org/vocab/unit/ROD"},{"@id":"http://qudt.org/vocab/unit/YD"},{"@id":"http://qudt.org/vocab/unit/ZOLL"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Position_(vector)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$r = \\overrightarrow{OP}$, where $O$ and $P$ are two points in space.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A \"Position Vector\", also known as location vector or radius vector, is a Euclidean vector which\n    represents the position of a point P in space in relation to an arbitrary reference origin O.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Length"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"r","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q192388"}],"http://www.w