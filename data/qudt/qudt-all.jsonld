bleSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.000001","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E-6","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L-3I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-3289"},{"@id":"_:n3-3290"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeDensity"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeVolumeDensity"},{"@id":"http://qudt.org/vocab/quantitykind/VolumeDensityOfCharge"},{"@id":"http://qudt.org/vocab/quantitykind/VolumetricElectricCharge"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA061","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA061","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"0.000001-fold of the SI derived unit coulomb divided by the power of the SI base unit metre with\n    the exponent 3\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"μC/m³","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"uC.m-3","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"B87","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeDensity"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricChargeVolumeDensity"},{"@id":"http://qudt.org/vocab/quantitykind/VolumeDensityOfCharge"},{"@id":"http://qudt.org/vocab/quantitykind/VolumetricElectricCharge"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q106808156"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Microcoulomb na Kubični Meter","@language":"sl"},{"@value":"Microcoulomb na Metr Krychlový","@language":"cs"},{"@value":"Microcoulomb par Mètre Cube","@language":"fr"},{"@value":"Microcoulomb pe Metru Cub","@language":"ro"},{"@value":"Microcoulomb per Cubic Meter","@language":"en-us"},{"@value":"Microcoulomb per Cubic Metre","@language":"en"},{"@value":"Microcoulomb per Cubic Metre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Microcoulomb per Meter Kubik","@language":"ms"},{"@value":"Microcoulomb per Metreküp","@language":"tr"},{"@value":"Microcoulomb per Metro Cubo","@language":"it"},{"@value":"Microcoulomb pro Kubikmeter","@language":"de"},{"@value":"Microculombio por Metro Cúbico","@language":"es"},{"@value":"Microkulomb na Metr Sześcienny","@language":"pl"}]},{"@id":"http://qudt.org/vocab/unit/MicroCI","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Another commonly used measure of radioactivity, the microcurie: $1 \\micro Ci = 3.7 \\times 10\n    disintegrations per second = 2.22 \\times 10 disintegrations per minute$. A radiotherapy machine may have roughly 1000 Ci of a\n    radioisotope such as caesium-137 or cobalt-60. This quantity of radioactivity can produce serious health effects with only a\n    few minutes of close-range, un-shielded exposure. The typical human body contains roughly $0.1\\micro Ci$ of naturally\n    occurring potassium-40.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"37000.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"3.7E4","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Curie","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Activity"},{"@id":"http://qudt.org/vocab/quantitykind/RadioactiveDecay"},{"@id":"http://qudt.org/vocab/quantitykind/Radioactivity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA062","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA062","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Curie?oldid=495080313","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/prefix":[{"@id":"http://qudt.org/vocab/prefix/Micro"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/CI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"μCi","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"uCi","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"M5","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Activity"},{"@id":"http://qudt.org/vocab/quantitykind/RadioactiveDecay"},{"@id":"http://qudt.org/vocab/quantitykind/Radioactivity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Microcurie","@language":"en"},{"@value":"Microcurie","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/MicroCi","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Another commonly used measure of radioactivity, the microcurie: $1 \\micro Ci = 3.7 \\times 10\n    disintegrations per second = 2.22 \\times 10 disintegrations per minute$. A radiotherapy machine may have roughly 1000 Ci of a\n    radioisotope such as caesium-137 or cobalt-60. This quantity of radioactivity can produce serious health effects with only a\n    few minutes of close-range, un-shielded exposure. The typical human body contains roughly $0.1\\micro Ci$ of naturally\n    occurring potassium-40.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/unit/MicroCI"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"37000.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"3.7E4","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Curie","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.4","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Activity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA062","@type":"http://www.w3.org/2001/XMLSch