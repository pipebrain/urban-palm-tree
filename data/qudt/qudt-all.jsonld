:"Newton Centimetre","@language":"en"},{"@value":"Newton Centimetre","@language":"tr"},{"@value":"Newton Centimetre","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Newton Centimetro","@language":"es"},{"@value":"Newton Centimetro","@language":"it"},{"@value":"Newton Centimetru","@language":"ro"},{"@value":"Newton Centimètre","@language":"fr"},{"@value":"Niuton Centimetr","@language":"pl"}]},{"@id":"http://qudt.org/vocab/unit/N-M","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\"Torque\" is the tendency of a force to cause a rotation, is the product of the force and the distance\n    from the center of rotation to the point where the force is applied. Torque has the same units as work or energy, but it is a\n    different physical concept. To stress the difference, scientists measure torque in newton meters rather than in joules, the SI\n    unit of work. One newton meter is approximately 0.737562 pound foot.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Newton_metre","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/derivedCoherentUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M