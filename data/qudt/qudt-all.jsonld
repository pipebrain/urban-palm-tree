udt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"81","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Inductance"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q163354"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Henr","@language":"pl"},{"@value":"Henrio","@language":"es"},{"@value":"Henrium","@language":"la"},{"@value":"Henry","@language":"cs"},{"@value":"Henry","@language":"de"},{"@value":"Henry","@language":"en"},{"@value":"Henry","@language":"fr"},{"@value":"Henry","@language":"hu"},{"@value":"Henry","@language":"it"},{"@value":"Henry","@language":"ms"},{"@value":"Henry","@language":"pt"},{"@value":"Henry","@language":"ro"},{"@value":"Henry","@language":"sl"},{"@value":"Henry","@language":"tr"},{"@value":"Henry","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Χένρι","@language":"el"},{"@value":"Генри","@language":"ru"},{"@value":"Хенри","@language":"bg"},{"@value":"הנרי","@language":"he"},{"@value":"هنري","@language":"ar"},{"@value":"هنری","@language":"fa"},{"@value":"हेनरी","@language":"hi"},{"@value":"ヘンリー","@language":"ja"},{"@value":"亨利","@language":"zh"}]},{"@id":"http://qudt.org/vocab/unit/H-PER-KiloOHM","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"SI derived unit henry divided by the 1 000-fold of the SI derived unit ohm","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.001","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conve