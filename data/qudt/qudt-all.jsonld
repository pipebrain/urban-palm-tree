imal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E5","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-4I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1172"},{"@id":"_:n3-1173"},{"@id":"_:n3-1174"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AcousticImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/PressureInRelationToVolumeFlow"},{"@id":"http://qudt.org/vocab/quantitykind/PressureInRelationToVolumeFlowRate"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAB045","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAB045","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"dyn·s/cm⁵","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"dyn.s.cm-5","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"A52","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AcousticImpedance"},{"@id":"http://qudt.org/vocab/quantitykind/PressureInRelationToVolumeFlow"},{"@id":"http://qudt.org/vocab/quantitykind/PressureInRelationToVolumeFlowRate"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Dyne Second per Quintic Centimeter","@language":"en-us"},{"@value":"Dyne Second per Quintic Centimetre","@language":"en"},{"@value":"Dyne Second per Quintic Centimetre","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/Da","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The unified atomic mass unit (symbol: $\\mu$) or dalton (symbol: Da) is a unit that is used for\n    indicating mass on an atomic or molecular scale. It is defined as one twelfth of the rest mass of an unbound atom of carbon-12\n    in its nuclear and electronic ground state, and has a value of $1.660538782(83) \\times 10^{-27} kg$. One $Da$ is\n    approximately equal to the mass of one proton or one neutron. The CIPM have categorised it as a \"non-SI unit whose values in\n    SI units must be obtained experimentally\".\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/unit/DA"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.00000000000000000000000000166053878283","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.66053878283E-27","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Dalton","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/unit/AMU"},{"@id":"http://qudt.org/vocab/unit/U"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/MolecularMass"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Atomic_mass_unit","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@va