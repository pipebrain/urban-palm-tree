hema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2993"},{"@id":"_:n3-2994"},{"@id":"_:n3-2995"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SurfaceRelatedVolumeFlow"},{"@id":"http://qudt.org/vocab/quantitykind/SurfaceRelatedVolumeFlowRate"},{"@id":"http://qudt.org/vocab/quantitykind/VolumetricFlux"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"power of the SI base unit metre with the exponent 3 divided by the unit hectare and by the unit\n    year\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m³/(ha·a)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m3.har-1.a-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/SurfaceRelatedVolumeFlow"},{"@id":"http://qudt.org/vocab/quantitykind/SurfaceRelatedVolumeFlowRate"},{"@id":"http://qudt.org/vocab/quantitykind/VolumetricFlux"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Cubic Meter per Hectare Year","@language":"en-us"},{"@value":"Cubic Metre per Hectare Year","@language":"en"},{"@value":"Cubic Metre per Hectare Year","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/M3-PER-HR","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"Cubic Meter Per Hour (m3/h) is a unit in the category of Volume flow rate. It is also known as cubic\n    meters per hour, cubic metre per hour, cubic metres per hour, cubic meter/hour, cubic metre/hour, cubic meter/h, cubic\n    metre/h, flowrate. Cubic Meter Per Hour (m3/h) has a dimension of L3T-1 where $L$ is length, and $T$ is time. It can be\n    converted to the corresponding standard SI unit m3/s by multiplying its value by a factor of 0.00027777777.\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0002777777777777777777777777777777778","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"2.777777777777777777777777777777778E-4","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$m^{3}/h$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L3I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-2996"},{"@id":"_:n3-2997"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/VolumeFlowRate"},{"@id":"http://qudt.org/vocab/quantitykind/VolumePerTime"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA763","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA763","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"m³/h","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"m3.h-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"MQH","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/VolumeFl