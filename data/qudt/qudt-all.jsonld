http://purl.org/dc/terms/description":[{"@value":"unit of the heat energy according to the Imperial system of units","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1055.87","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.05587E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergy"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA113","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA113","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"unit of the heat energy according to the Imperial system of units","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/J"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"BTU{mean}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[Btu_m]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"J39","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergy"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q99491447"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"British Thermal Unit (mean)","@language":"en"},{"@value":"British Thermal Unit (mean)","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BTU_TH","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The $\\textit{British Thermal Unit (thermochemical definition)}$ ($BTU_{th}$), is a traditional unit of\n    energy equal to about $1.0543502645 kilojoule$. It is approximately the amount of energy needed to heat 1 pound (0.454 kg) of\n    water from $39^{\\circ}\\text{F}$ ($3.9^{\\circ}\\text{C}$) to $40^{\\circ}\\text{F}$ ($4.4^{\\circ}\\text{C}$). The unit is\n    most often used in the power, steam generation, heating and air conditioning industries. In scientific contexts the BTU has\n    largely been replaced by the SI unit of energy, the $joule$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1054.3502645","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0543502645E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergy"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA122","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://physics.nist.gov/Pubs/SP811/appenB9.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.iso.org/iso/home/store/catalogue_ics/catalogue_detail_ics.htm?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.knowledgedoor.com/2/units_and_constants_handbook/british-thermal-unit_group.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA122","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/British_thermal_unit","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/J"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Btu{th}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[Btu_th]","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergy"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q211580"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"British Thermal Unit (thermochemical Definition)","@language":"en"},{"@value":"British Thermal Unit (thermochemical Definition)","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BTU_TH-FT-PER-FT2-HR-DEG_F","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"\n  The $\\textit{BTU (TH) Foot per Square Foot Hour Degree Fahrenheit}$ is an Imperial unit for 'Thermal Conductivity' defined as:\n  $$Btu_{th} \\cdot ft/(h \\cdot ft^2 \\cdot degF)$$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.729577205544619422572178477690289","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.729577205544619422572178477690289E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$Btu(IT) ft/(h ft^2 degF)$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H-1T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-692"},{"@id":"_:n3-693"},{"@id":"_:n3-694"},{"@id":"_:n3-695"},{"@id":"_:n3-696"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalConductivity"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.translatorscafe.com/cafe/EN/units-converter/thermal-conductivity/c/","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Thermal_conductivity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Btu{th}·ft/(ft²·h·°F)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[Btu_th].[ft_i].[ft_i]-2.h-1.[degF]-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalConductivity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"British Thermal Unit (thermochemical Definition) Foot per Square Foot Hour Degree Fahrenheit","@language":"en"},{"@value":"British Thermal Unit (thermochemical Definition) Foot per Square Foot Hour Degree Fahrenheit","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BTU_TH-FT-PER-HR-FT2-DEG_F","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"The $\\textit{British Thermal Unit (thermochemical) Foot Per Hour Square Foot degree Fahrenheit}$ is a\n    unit of thermal conductivity in the Imperial system of units.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.729577205544619422572178477690289","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.729577205544619422572178477690289E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H-1T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-697"},{"@id":"_:n3-698"},{"@id":"_:n3-699"},{"@id":"_:n3-700"},{"@id":"_:n3-701"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalConductivity"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA123","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA123","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"unit of the thermal conductivity according to the Imperial system of units","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Btu{th}·ft/(h·ft²·°F)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[Btu_th].[ft_i].h-1.[ft_i]-2.[degF]-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"J46","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalConductivity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"British Thermal Unit (thermochemical Definition) Foot per Hour Square Foot Degree Fahrenheit","@language":"en"},{"@value":"British Thermal Unit (thermochemical Definition) Foot per Hour Square Foot Degree Fahrenheit","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/BTU_TH-IN-PER-FT2-HR-DEG_F","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"${\\bf BTU_{th}}$, Inch per Square Foot Hour Degree Fahrenheit, is an Imperial unit for 'Thermal\n    Conductivity' expressed as $Btu-in/(h-ft^{2}-degF)$. A thermochemical British thermal unit inch per second per square foot per\n    degree Fahrenheit is a unit of thermal conductivity in the US Customary Units and British Imperial Units. $1 Btu_{th} \\cdot\n    in/(h \\cdot ft^{2}  \\cdot degF)$ shows that one thermochemical BTU of heat per one hour moves through one square foot of\n    material, which is one foot thick due to a temperature difference of one degree Fahrenheit.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.1441314337953849518810148731408574","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.441314337953849518810148731408574E-1","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/definedUnitOfSystem":[{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/expression":[{"@value":"$Btu(th)-in-per-h-ft2-degF$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M1H-1T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-702"},{"@id":"_:n3-703"},{"@id":"_:n3-704"},{"@id":"_:n3-705"},{"@id":"_:n3-706"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalConductivity"}],"http://qudt.org/schema/qudt/hasReciprocalUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_F-HR-FT2-PER-BTU_TH-IN"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA125","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.translatorscafe.com/cafe/EN/units-converter/thermal-conductivity/c/","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA125","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$Btu_{th} \\cdot in/(h \\cdot ft^{2}  \\cdot degF)$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Unit of thermal conductivity according to the Imperial system of units","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Btu{th}·in/(ft²·h·°F)","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"[Btu_th].[in_i].[ft_i]-2.h-1.[degF]-1","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"J48","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/ThermalConductivity"}