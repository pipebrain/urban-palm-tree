/qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Period"},{"@id":"http://qudt.org/vocab/quantitykind/Time"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAC698","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAC698","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/prefix":[{"@id":"http://qudt.org/vocab/prefix/Mega"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/SEC"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Ms","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"Ms","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Period"},{"@id":"http://qudt.org/vocab/quantitykind/Time"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Megamásodperc","@language":"hu"},{"@value":"Megasaat","@language":"ms"},{"@value":"Megasaniye","@language":"tr"},{"@value":"Megasecond","@language":"en"},{"@value":"Megasecond","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Megaseconde","@language":"fr"},{"@value":"Megasecondo","@language":"it"},{"@value":"Megasecundă","@language":"ro"},{"@value":"Megasegundo","@language":"es"},{"@value":"Megasekunda","@language":"cs"},{"@value":"Megasekunda","@language":"pl"},{"@value":"Megasekunda","@language":"sl"},{"@value":"Megasekunde","@language":"de"}]},{"@id":"http://qudt.org/vocab/unit/MegaTOE","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"<p>The tonne of oil equivalent (toe) is a unit of energy: the amount of energy released by burning one\n    tonne of crude oil, approximately 42 GJ (as different crude oils have different calorific values, the exact value of the toe\n    is defined by convention; unfortunately there are several slightly different definitions as discussed below). The toe is\n    sometimes used for large amounts of energy, as it can be more intuitive to visualise, say, the energy released by burning 1000\n    tonnes of oil than 42,000 billion joules (the SI unit of energy).</p> <p>Multiples of the toe are used, in particular the\n    megatoe (Mtoe, one million toe) and the gigatoe (Gtoe, one billion toe).</p>\n  ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/USCS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"41868000000000000.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"4.1868E16","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Tonne_of_oil_equivalent","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/prefix":[{"@id":"http://qudt.org/vocab/prefix/Mega"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/TOE"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Mtoe","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mega Ton of Oil Equivalent","@language":"en"},{"@value