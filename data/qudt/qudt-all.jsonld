nit/PicoPA"},{"@id":"http://qudt.org/vocab/unit/PlanckPressure"},{"@id":"http://qudt.org/vocab/unit/TORR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.oxfordreference.com/display/10.1093/acref/9780199549351.001.0001/acref-9780199549351-e-1162","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The pressure of blood in the arteries which rises to a maximum as blood is pumped out by the left\n    ventricle (systole) and drops to a minimum in diastole. The systolic/diastolic pressure is normally ~120/80 mmHg in a young\n    adult.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Pressure"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q42015775"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:ForcePerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Systolic Blood Pressure","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/DiastolicBloodPressure"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Pressure"}]},{"@id":"http://qudt.org/vocab/quantitykind/TARGET-BOGIE-MASS","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"An informal mass limit established by a Project Office (at the Element Integrated Product Team (IPT)\n    level or below) to control mass.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.2.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"An informal mass limit established by a Project Office (at the Element Integrated Product Team\n    (IPT) level or below) to control mass.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Target Bogie Mass","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}]},{"@id":"http://qudt.org/vocab/quantitykind/Temperature","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Temperature is a physical property of matter that quantitatively expresses the common notions of hot and\n    cold. Objects of low temperature are cold, while various degrees of higher temperatures are referred to as warm or hot. Heat\n    spontaneously flows from bodies of a higher temperature to bodies of lower temperature, at a rate that increases with the\n    temperature difference and the thermal conductivity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_C"},{"@id":"http://qudt.org/vocab/unit/DEG_C_GROWING_CEREAL"},{"@id":"http://qudt.org/vocab/unit/DEG_F"},{"@id":"http://qudt.org/vocab/unit/DEG_R"},{"@id":"http://qudt.org/vocab/unit/DecaK"},{"@id":"http://qudt.org/vocab/unit/K"},{"@id":"http://qudt.org/vocab/unit/MegaK"},{"@id":"http://qudt.org/vocab/unit/MilliDEG_C"},{"@id":"http://qudt.org/vocab/unit/MilliK"},{"@id":"http://qudt.org/vocab/unit/PlanckTemperature"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Temperature","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ202#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD374","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD374","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Temperature is a physical property of matter that quantitatively expresses the common notions of\n    hot and cold. Objects of low temperature are cold, while various degrees of higher temperatures are referred to as warm or\n    hot. Heat spontaneously flows from bodies of a higher temperature to bodies of lower temperature, at a rate that increases\n    with the temperature difference and the thermal conductivity.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q11466"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Temperature","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Temperature","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/ThermodynamicTemperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/TemperatureAmountOfSubstance","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MOL-DEG_C"},{"@id":"http://qudt.org/vocab/unit/MOL-K"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H1T0D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TemperatureAmountOfSubstance","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Temperature Amount of Substance","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/TemperatureBasedAmountOfSubstanceConcentration","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio of material concentration divided by the related temperature","@language":"en"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ395#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L-3I0M0H-1T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient aus Stoffmengenkonzentration dividiert durch die zugehörige Temperatur","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Temperature-based Amount-of-substance Concentration","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/TemperatureBasedDensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio of density divided by the related temperature","@language":"en"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ389#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M1H-1T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient aus Dichte dividiert durch die zugehörige Temperatur","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Temperature-based Density","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/TemperatureBasedDynamicViscosity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio of dynamic viscosity, divided by temperature","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiPOISE-PER-K"},{"@id":"http://qudt.org/vocab/unit/MilliPA-SEC-PER-K"},{"@id":"http://qudt.org/vocab/unit/PA-SEC-PER-K"},{"@id":"http://qudt.org/vocab/unit/POISE-PER-K"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ390#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H-1T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient der dynamischen Viskosität dividiert durch die Temperatur","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TemperatureBasedDynamicViscosity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Temperature-based Dynamic Viscosity","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/TemperatureBasedKinematicViscosity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio of dynamic viscosity and the density of a material, divided by the related temperature","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ST-PER-K"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ392#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M0H-1T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient aus der dynamischen Viskosität und der Dichte eines Stoffes dividiert durch die zugehörige\n    Temperatur\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TemperatureBasedKinematicViscosity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Temperature-based Kinematic Viscosity","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/TemperatureBasedLength","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio of length divided by the related temperature","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/M-PER-K"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ393#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H-1T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient aus Länge dividiert durch die zugehörige Temperatur","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:TemperatureBasedLength","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-sc