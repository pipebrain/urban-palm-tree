/www.wikidata.org/entity/Q1588477"}],"http://www.linkedmodel.org/schema/vaem#todo":[{"@value":"belongs to SOQ-ISO","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Power","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Schallleistung","@language":"de"},{"@value":"Sound Power","@language":"en"},{"@value":"moc akustyczna","@language":"pl"},{"@value":"potencie acústica","@language":"es"},{"@value":"potenza sonora","@language":"it"},{"@value":"potência acústica","@language":"pt"},{"@value":"puissance acoustique","@language":"fr"},{"@value":"звуковая мощность","@language":"ru"},{"@value":"القدرة الصوتية","@language":"ar"},{"@value":"音源の音響出力","@language":"ja"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"potência sonora","@language":"pt"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}]},{"@id":"http://qudt.org/vocab/quantitykind/SoundPowerLevel","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Sound Power Level abbreviated as $SWL$ expresses sound power more practically as a relation to the\n    threshold of hearing - 1 picoW - in a logarithmic scale.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/B"},{"@id":"http://qudt.org/vocab/unit/DeciB"},{"@id":"http://qudt.org/vocab/unit/DeciB_A"},{"@id":"http://qudt.org/vocab/unit/DeciB_ISO"},{"@id":"http://qudt.org/vocab/unit/DeciB_M"},{"@id":"http://qudt.org/vocab/unit/DeciB_Z"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":