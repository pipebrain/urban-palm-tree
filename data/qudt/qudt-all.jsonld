imensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Radiant_flux","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\Phi = \\frac{dQ}{dt}$, where $dQ$ is the radiant energy emitted, transferred, or received during a time interval of the duration $dt$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\phi$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Radiant Flux, or radiant power, is the measure of the total power of electromagnetic radiation\n    (including infrared, ultraviolet, and visible light). The power may be the total emitted from a source, or the total landing\n    on a particular surface.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1253356"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Power","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Radiant Flux","@language":"en"},{"@value":"Strahlungsfluss","@language":"de"},{"@value":"flusso radiante","@language":"it"},{"@value":"flux énergétique","@language":"fr"},{"@value":"moc promieniowania","@language":"pl"},{"@value":"potencia radiante","@language":"es"},{"@value":"potência radiante","@language":"pt"},{"@value":"قدرة إشعاعية","@language":"ar"},{"@value":"放射パワー","@language":"ja"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"Strahlungsleistung","@language":"de"},{"@value":"flujo radiante","@language":"es"},{"@value":"fluxo energético","@language":"pt"},{"@value":"moc promienista","@language":"pl"},{"@value":"potenza radiante","@language":"it"},{"@value":"puissance rayonnante","@language":"fr"},{"@value":"radiant power","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Power"}]},{"@id":"http://qudt.org/vocab/quantitykind/RadiantIntensity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Radiant Intensity is a measure of the intensity of electromagnetic radiation. It is defined as power per\n    unit solid angle.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/W-PER-SR"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ385#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD151","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD151","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Radiant_intensity","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$I = \\frac{d\\Phi}{d\\Omega}$, where $d\\Phi$ is the radiant flux leaving the source in an elementary cone containing the given direction with the solid angle $d\\Omega$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Radiant Intensity is a measure of the intensity of electromagnetic radiation. It is defined as\n    power per unit solid angle.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/quantities/RAIN"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"I","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1253365"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:RadiantIntensity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Radiant Intensity","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/RadiativeHeatTransfer","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Radiative Heat Transfer\" is proportional to $(T_1^4 - T_2^4)$ and area of the surface, where $T_1$ and\n    $T_2$ are thermodynamic temperatures of two black surfaces, for non totally black surfaces an additional factor less than 1 is\n    needed.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-HR"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/BTU_TH-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/CAL_TH-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloCAL-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloCAL_TH-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloCAL_TH-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/KiloCAL_TH-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT-PER-HR"},{"@id":"http://qudt.org/vocab/unit/THM_US-PER-HR"},{"@id":"http://qudt.org/vocab/unit/TON_FG"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Heat_transfer#Radiation","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=43012","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\Phi_r$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/HeatFlowRate"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:HeatFlowRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Radiative Heat Transfer","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/HeatFlowRate"}]},{"@id":"http://qudt.org/vocab/quantitykind/RadioactiveDecay","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BQ"},{"@id":"http://qudt.org/vocab/unit/CI"},{"@id":"http://qudt.org/vocab/unit/GigaBQ"},{"@id":"http://qudt.org/vocab/unit/KiloBQ"},{"@id":"http://qudt.org/vocab/unit/KiloCI"},{"@id":"http://qudt.org/vocab/unit/MegaBQ"},{"@id":"http://qudt.org/vocab/unit/MicroBQ"},{"@id":"http://qudt.org/vocab/unit/MicroCI"},{"@id":"http://qudt.org/vocab/unit/MilliBQ"},{"@id":"http://qudt.org/vocab/unit/MilliCI"},{"@id":"http://qudt.org/vocab/unit/NanoBQ"},{"@id":"http://qudt.org/vocab/unit/PetaBQ"},{"@id":"http://qudt.org/vocab/unit/PicoCI"},{"@id":"http://qudt.org/vocab/unit/TeraBQ"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/Activity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD152","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD152","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/StochasticProcess"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:RadioactiveDecay","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Radioactive Decay","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/StochasticProcess"}]},{"@id":"http://qudt.org/vocab/quantitykind/Radioactivity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"number of spontaneous nuclear transformations in a defined amount of substance during a sufficiently\n    small period of time divided by this period, expressed as a ratio ∂N/∂t, where ∂N is the expected value for the number of\n    spontaneous transformations from this state within the time period ∂t\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BQ"},{"@id":"http://qudt.org/vocab/unit/CI"},{"@id":"http://qudt.org/vocab/unit/GigaBQ"},{"@id":"http://qudt.org/vocab/unit/KiloBQ"},{"@id":"http://qudt.org/vocab/unit/KiloCI"},{"@id":"http://qudt.org/vocab/unit/MegaBQ"},{"@id":"http://qudt.org/vocab/unit/MicroBQ"},{"@id":"http://qudt.org/vocab/unit/MicroCI"},{"@id":"http://qudt.org/vocab/unit/MilliBQ"},{"@id":"http://qudt.org/vocab/unit/MilliCI"},{"@id":"http://qudt.org/vocab/unit/NanoBQ"},{"@id":"http://qudt.org/vocab/unit/PetaBQ"},{"@id":"http://qudt.org/vocab/unit/PicoCI"},{"@id":"http://qudt.org/vocab/unit/TeraBQ"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ230#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/Activity"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Anzahl der spontanen Kernumwandlungen in einer gegebenen Menge eines Stoffes während eines\n    hinreichend kleinen Zeitintervalls, dividiert durch dieses Zeitintervall, ausgedrückt als Quotient ∂N/∂t, wobei ∂N der\n    Erwartungswert für die Anzahl der spontanen Übergänge aus diesem Zustand im Zeitintervall ∂t ist\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Radioactivity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Radioactivity","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/Radiosity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Radiosity is the total emitted and reflected radiation leaving a surface.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/J-PER-CentiM2-DAY"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Radiosity is the total emitted and reflected radiation leaving a surface.","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/PowerPerArea"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Radiosity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Radiosity","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/PowerPerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/Radius","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In classical geometry, the \"Radius\" of a circle or sphere is any line segment from its center to its\n    perimeter the radius of a circle or sphere is the length of any such segment.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ANGSTROM"},{"@id":"http://qudt.org/vocab/unit/AU"},{"@id":"http://qudt.org/vocab/unit/BTU_IT-PER-LB_F"},{"@id":"http://qudt.org/vocab/unit/CHAIN"},{"@id":"http://qudt.org/vocab/unit/CHAIN_US"},{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/DecaM"},{"@id":"http://qudt.org/vocab/unit/DeciM"},{"@id":"http://qudt.org/vocab/unit/FATH"},{"@id":"http://qudt.org/vocab/unit/FM"},{"@id":"http://qudt.org/vocab/unit/FT"},{"@id":"http://qudt.org/vocab/unit/FT_US"},{"@id":"http://qudt.org/vocab/unit/FUR"},{"@id":"http://qudt.org/vocab/unit/FemtoM"},{"@id":"http://qudt.org/vocab/unit/GAUGE_FR"},{"@id":"http://qudt.org/vocab/unit/GA_Charriere"},{"@id":"http://qudt.org/vocab/unit/HectoM"},{"@id":"htt