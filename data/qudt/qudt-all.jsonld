nguage":"sl"},{"@value":"Decapascal","@language":"tr"},{"@value":"Decapascal","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Decapaskal","@language":"pl"},{"@value":"Dekapascal","@language":"de"}]},{"@id":"http://qudt.org/vocab/unit/DecaPOISE","@type":["http://qudt.org/schema/qudt/Unit"],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/DynamicViscosity"},{"@id":"http://qudt.org/vocab/quantitykind/Viscosity"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"10-fold of the CGS unit of the dynamic viscosity poise","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/prefix":[{"@id":"http://qudt.org/vocab/prefix/Deca"}],"http://qudt.org/schema/qudt/scalingOf":[{"@id":"http://qudt.org/vocab/unit/POISE"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"daP","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"daP","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/DynamicViscosity"},{"@id":"http://qudt.org/vocab/quantitykind/Viscosity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Decapoise","@language":"en"},{"@value":"Decapoise","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Dekapoise","@language":"de"}]},{"@id":"http://qudt.org/vocab/unit/DeciB","@type":["http://qudt.org/schema/qudt/DimensionlessUnit","http://qudt.org/schema/qudt/LogarithmicUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"A customary logarithmic measure most commonly used (in various ways) for measuring sound.Sound is\n    measured on a logarithmic scale. Informally, if one sound is $1\\,bel$ (10 decibels) \"louder\" than another, this means the\n    louder sound is 10 times louder than the fainter one. A difference of 20 decibels corresponds to an increase of 10 x 10 or 100\n    times in intensity. The beginning of the scale, 0 decibels, can be set in different ways, depending on exactly the aspect of\n    sound being measured. For sound intensity (the power of the sound waves per unit of area) $0\\,decibel$ is equal to\n    $1\\,picoWatts\\,per\\,Metre\\,Squared$. This corresponds approximately to the faintest sound that can be detected by a person\n    who has good hearing. For sound pressure (the pressure exerted by the sound waves) 0 decibels equals\n    $20\\,micropascals\\,RMS$, and for sound power $0\\,decibels$ sometimes equals $1\\,picoWatt$. In all cases, one decibel\n    equals $\\approx\\,0.115129\\,neper$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/ASU"},{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-ESU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/IMPERIAL"},{"@id":"http://qudt.org/vocab/sou/PLANCK"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"0.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Decibel","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Log10Ratio"},{"@id":"http://qudt.org/vocab/quantitykind/SoundExposureLevel"},{"@id":"http://qudt.org/vocab/quantitykind/SoundPowerLevel"},{"@id":"http://qudt.org/vocab/quantitykind/SoundPressureLevel"},{"@id":"http://qudt.org/vocab/quantitykind/SoundReductionIndex"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA409","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA409","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Decibel?oldid=495380648","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"dB","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"dB","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"2N","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Log10Ratio"},{"@id":"http://qudt.org/vocab/quantitykind/SoundExposureLevel"},{"@id":"http://qudt.org/vocab/quantitykind/SoundPowerLevel"},{"@id":"http://qudt.org/vocab/quantitykind/SoundPressureLevel"},{"@id":"http://qudt.org/vocab/quantitykind/SoundReductionIndex"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q5329"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Decibel","@language":"en"},{"@value":"Decibel","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/DeciB-MilliW","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"unit of level used to indicate that a power ratio is expressed in decibel (dB) with reference to one\n    milliwatt (mW)\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/categorizedByQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Unknown"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"0.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-3D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-1176"},{"@id":"_:n3-1177"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Unknown"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD891","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAD891","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"dB·mW","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"dB.mW","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"DBM","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Decibel Milliwatt","@language":"en"},{"@value":"Decibel Milliwatt","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/DeciB-MilliW-PER-MegaHZ","@type":["http://qudt.org/s