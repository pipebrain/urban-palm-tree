01/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Azimuth","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}]},{"@id":"http://qudt.org/vocab/quantitykind/BandwidthDistanceProduct","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The product of a transmission medium's bandwidth and the transmission distance, characterising the\n    signal-carrying capacity of the medium: a link may trade bandwidth against distance while their product remains limited (for\n    example a multimode optical fibre rated in MHz·km). The same quantity as quantitykind:BandwidthLengthProduct, from a\n    different source vocabulary.\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MegaHZ-KiloM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD016","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD016","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/BandwidthLengthProduct"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:BandwidthLengthProduct","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bandwidth Distance Product","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/BandwidthLengthProduct"}]},{"@id":"http://qudt.org/vocab/quantitykind/BandwidthLengthProduct","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"parameter of transmission media for determination of frequency and length restrictions as reciprocal\n    value of the multimode distortion corresponding to the product of maximum pulse frequency and maximum transmission distance\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MegaHZ-KiloM"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ293#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Parameter von Übertragungsmedien zur Bestimmung der Frequenz- und Längenrestriktionen als reziproke\n    Wert der Modendispersion entsprechend dem Produkt aus maximaler Impulsfrequenz mal maximaler Übertragungsstrecke\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:BandwidthLengthProduct","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bandwidth Length Product","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/Basicity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\n  Chemicals or substances having a $pH$ higher than 7 are said to be basic;\n   higher $pH$ means higher basicity.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/PH"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Base_(chemistry)","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/PH","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://iupac.org/wp-content/uploads/2019/05/IUPAC-GB3-2012-2ndPrinting-PDFsearchable.pdf","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Chemicals or substances having a pH higher than 7 are said to be basic; higher pH means higher\n    basicity.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Basicity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Basicity","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/Acidity"}]},{"@id":"http://qudt.org/vocab/quantitykind/BatteryCapacity","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"quantity of electricity or electrical charge which a fully charged battery can supply under specified conditions as a product of discharge current and discharge time","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-HR"},{"@id":"http://qudt.org/vocab/unit/A-MIN"},{"@id":"http://qudt.org/vocab/unit/A-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloA-HR"},{"@id":"http://qudt.org/vocab/unit/MilliA-HR"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ270#006","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD017","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD017","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Elektrizitätsmenge oder elektrische Ladung, die eine vollgeladenen Batterie unter festgelegten Bedingungen abgeben kann als Produkt aus Entladestrom und Entladezeit","@language":"de"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCharge"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:BatteryCapacity","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Battery Capacity","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/ElectricCharge"}]},{"@id":"http://qudt.org/vocab/quantitykind/BendingMomentOfForce","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A bending moment exists in a structural element when a moment is applied to the element so that the\n    element bends. It is the component of moment of force perpendicular to the longitudinal axis of a beam or a shaft.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/CentiN-M"},{"@id":"http://qudt.org/vocab/unit/DYN-CentiM"},{"@id":"http://qudt.org/vocab/unit/DYN-M"},{"@id":"http://qudt.org/vocab/unit/DeciN-M"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F_Torque"},{"@id":"http://qudt.org/vocab/unit/IN-PDL"},{"@id":"http://qudt.org/vocab/unit/KiloGM_F-M"},{"@id":"http://qudt.org/vocab/unit/KiloN-M"},{"@id":"http://qudt.org/vocab/unit/LB_F-IN"},{"@id":"http://qudt.org/vocab/unit/MegaN-M"},{"@id":"http://qudt.org/vocab/unit/MicroN-M"},{"@id":"http://qudt.org/vocab/unit/MilliN-M"},{"@id":"http://qudt.org/vocab/unit/N-CentiM"},{"@id":"http://qudt.org/vocab/unit/N-M"},{"@id":"http://qudt.org/vocab/unit/OZ_F-IN"},{"@id":"http://qudt.org/vocab/unit/PDL-FT"},{"@id":"http://qudt.org/vocab/unit/PDL-IN"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Torque","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Bending_moment","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31889","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$M_b = M \\cdot e_Q$, where $M$ is the momentof force and $e_Q$ is a unit vector directed along a $Q-axis$ with respect to which the torque is considered.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A bending moment exists in a structural element when a moment is applied to the element so that the\n    element bends. It is the component of moment of force perpendicular to the longitudinal axis of a beam or a shaft.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MomentOfForce"},{"@id":"http://qudt.org/vocab/quantitykind/Torque"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"M_b","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q857244"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MomentOfForce","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:Torque","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bending Moment of Force","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MomentOfForce"},{"@id":"http://qudt.org/vocab/quantitykind/Torque"}]},{"@id":"http://qudt.org/vocab/quantitykind/BetaDisintegrationEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Beta Disintegration Energy\" is the  energy released by a beta particle radioactive decay. It is the sum\n    of the maximum beta-particle kinetic energy and the recoil energy of the atom produced in the reference frame in which the\n    emitting nucleus is at rest before its disintegration.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/AttoJ"},{"@id":"http://qudt.org/vocab/unit/BTU_IT"},{"@id":"http://qudt.org/vocab/unit/BTU_TH"},{"@id":"http://qudt.org/vocab/unit/CAL_IT"},{"@id":"http://qudt.org/vocab/unit/CAL_TH"},{"@id":"http://qudt.org/vocab/unit/ERG"},{"@id":"http://qudt.org/vocab/unit/EV"},{"@id":"http://qudt.org/vocab/unit/E_h"},{"@id":"http://qudt.org/vocab/unit/ExaJ"},{"@id":"http://qudt.org/vocab/unit/FT-LB_F_Energy"},{"@id":"http://qudt.org/vocab/unit/FT-PDL"},{"@id":"http://qudt.org/vocab/unit/FemtoJ"},{"@id":"http://qudt.org/vocab/unit/GigaEV"},{"@id":"http://qudt.org/vocab/unit/GigaJ"},{"@id":"http://qudt.org/vocab/unit/GigaW-HR"},{"@id":"http://qudt.org/vocab/unit/J"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_IT"},{"@id":"http://qudt.org/vocab/unit/KiloBTU_TH"},{"@id":"http://qudt.org/vocab/unit/KiloCAL"},{"@id":"http://qudt.org/vocab/unit/KiloEV"},{"@id":"http://qudt.org/vocab/unit/KiloJ"},{"@id":"http://qudt.org/vocab/unit/KiloW-HR"},{"@id":"http://qudt.org/vocab/unit/MegaBTU_IT"},{"@id":"http://qudt.org/vocab/unit/MegaEV"},{"@id":"http://qudt.org/vocab/unit/MegaJ"},{"@id":"http://qudt.org/vocab/unit/MegaTOE"},{"@id":"http://qudt.org/vocab/unit/MegaW-HR"},{"@id":"http://qudt.org/vocab/unit/MicroJ"},{"@id":"http://qudt.org/vocab/unit/MilliJ"},{"@id":"http://qudt.org/vocab/unit/NanoJ"},{"@id":"http://qudt.org/vocab/unit/PetaJ"},{"@id":"http://qudt.org/vocab/unit/PicoJ"},{"@id":"http://qudt.org/vocab/unit/PlanckEnergy"},{"@id":"http://qudt.org/vocab/unit/QUAD"},{"@id":"http://qudt.org/vocab/unit/THERM_EC"},{"@id":"http://qudt.org/vocab/unit/THERM_US"},{"@id":"http://qudt.org/vocab/unit/THM_EEC"},{"@id":"http://qudt.org/vocab/unit/THM_US"},{"@id":"http://qudt.org/vocab/unit/TOE"},{"@id":"http://qudt.org/vocab/unit/TeraJ"},{"@id":"http://qudt.org/vocab/unit/TeraW-HR"},{"@id":"http://qudt.org/vocab/unit/TonEnergy"},{"@id":"http://qudt.org/vocab/unit/W-HR"},{"@id":"http://qudt.org/vocab/unit/W-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L2I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Decay_energy","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/normativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Beta Disintegration Energy\" is the  energy released by a beta particle radioactive decay. It is\n    the sum of the maximum beta-particle kinetic energy and the recoil energy of the atom produced in the reference frame in which\n    the emitting nucleus is at rest before its disintegration.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"Qᵦ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98148340"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Energy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Beta Disintegration Energy","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Energy"}]},{"@id":"http://qudt.org/vocab/quantitykind/BevelGearPitchAngle","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Pitch angle in bevel gears is the angle between an element of a pitch cone and its axis. In external and\n    internal bevel gears, the pitch angles are respectively less than and greater than 90 degrees.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ARCMIN"},{"@id":"http://qudt.org/vocab/unit/ARCSEC"},{"@id":"http://qudt.org/vocab/unit/DEG"},{"@id":"http://qudt.org/vocab/unit/GON"},{"@id":"http://qudt.org/vocab/unit/GRAD"},{"@id":"http://qudt.org/vocab/unit/MIL_Angle"},{"@id":"http://qudt.org/vocab/unit/MIN_Angle"},{"@id":"http://qudt.org/vocab/unit/MicroRAD"},{"@id":"http://qudt.org/vocab/unit/MilliARCSEC"},{"@id":"http://qudt.org/vocab/unit/MilliRAD"},{"@id":"http://qudt.org/vocab/unit/RAD"},{"@id":"http://qudt.org/vocab/unit/REV"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\theta$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Pitch angle in bevel gears is the angle between an element of a pitch cone and its axis. In\n    external and internal bevel gears, the pitch angles are respectively less than and greater than 90 degrees.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Angle","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:PlaneAngle","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bevel Gear Pitch Angle","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}]},{"@id":"http://qudt.org/vocab/quantitykind/BinaryLogarithmicMedianInformationFlow","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"ratio of the median information content divided by the expected value for the duration of a character,\n    expressed as a logarithm to base 2\n  ","@language":"en"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/InformationFlowRate"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.5.0","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ464#001","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Quotient mittlerer Informationsgehalt durch den Erwartungswert für die Dauer eines Zeichens,\n    ausgedrückt als Logarithmus zur Basis 2\n  ","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Median Information Flow (from a Source of Information), Expressed as a Binary Logarithm","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/BindingFraction","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The \"Binding Fraction\" is the ratio of the binding energy of a nucleus to the atomic mass number.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://encyclopedia2.thefreedictionary.com/binding+fraction","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31895","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$b = \\frac{B_r}{A}$, where $B_r$ is the relative mass defect and $A$ is the nucleon number.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The \"Binding Fraction\" is the ratio of the binding energy of a nucleus to the atomic mass number.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"b","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q98058362"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:BindingFraction","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Binding Fraction","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/BioconcentrationFactor","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The bioconcentration factor is the ratio of the concentration of a chemical substance in biota over the\n    concentration of the same chemical substance in water. It is related to the octanol-water partition coefficient.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/PERCENT"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/organizedUnder":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"The bioconcentration factor is the ratio of the concentration of a chemical substance in biota over\n    the concentration of the same chemical substance in water. It is related to the octanol-water partition coefficient.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:BioconcentrationFactor","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bioconcentration Factor","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DimensionlessRatio"}]},{"@id":"http://qudt.org/vocab/quantitykind/BiodegredationHalfLife","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A time that quantifies how long it takes to reduce a substance's concentration by 50% from any\n    concentration point in time in a water or soil environment by either bacteria or another living organism.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DAY"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A time that quantifies how long it takes to reduce a substance's concentration by 50% from any\n    concentration point in time in a water or soil environment by either bacteria or another living organism.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Time"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:BiodegredationHalfLife","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Biodegredation Half Life","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Time"}]},{"@id":"http://qudt.org/vocab/quantitykind/BiogeochemicalRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"the rate at which a specific chemical element or compound is processed or transformed, as amount per unit\n    mass of the relevant material Unreduced, SI unit is mole * kg-1 * s-1\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MOL-PER-GM-HR"},{"@id":"http://qudt.org/vocab/unit/MicroMOL-PER-GM-HR"},{"@id":"http://qudt.org/vocab/unit/MicroMOL-PER-GM-SEC"},{"@id":"http://qudt.org/vocab/unit/MicroMOL-PER-KiloGM-YR"},{"@id":"http://qudt.org/vocab/unit/NanoMOL-PER-GM-HR"},{"@id":"http://qudt.org/vocab/unit/NanoMOL-PER-GM-SEC"},{"@id":"http://qudt.org/vocab/unit/NanoMOL-PER-MicroGM-HR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M-1H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"the rate at which a specific chemical element or compound is processed or transformed, as amount\n    per unit mass of the relevant material. Unreduced, SI unit is mole * kg-1 * s-1\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T1D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L0I0M0H0T0D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:BiogeochemicalRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Biogeochemical Rate","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/BitDataVolume","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"name for a particular quantity of data on the basis of the binary digit \"Bit\" (basic indissoluble\n    information unit) which can only assume a state of 1 or 0\n  ","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BIT"},{"@id":"http://qudt.org/vocab/unit/ExaBIT"},{"@id":"http://qudt.org/vocab/unit/ExbiBIT"},{"@id":"http://qudt.org/vocab/unit/GibiBIT"},{"@id":"http://qudt.org/vocab/unit/GigaBIT"},{"@id":"http://qudt.org/vocab/unit/KibiBIT"},{"@id":"http://qudt.org/vocab/unit/KiloBIT"},{"@id":"http://qudt.org/vocab/unit/MebiBIT"},{"@id":"http://qudt.org/vocab/unit/MegaBIT"},{"@id":"http://qudt.org/vocab/unit/PebiBIT"},{"@id":"http://qudt.org/vocab/unit/PetaBIT"},{"@id":"http://qudt.org/vocab/unit/TebiBIT"},{"@id":"http://qudt.org/vocab/unit/TeraBIT"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ436#005","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/DatasetOfBits"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Bezeichnung für eine bestimmte Anzahl von Daten auf Basis der Binärziffer Bit (en: Basic\n    Indissoluble Information Unit, dt: kleinstmögliche Informationseinheit), welche nur den Zustand 1 oder 0 annehmen kann\n  ","@language":"de"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfData"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:BitDataVolume","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bit Data Volume","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/AmountOfData"}]},{"@id":"http://qudt.org/vocab/quantitykind/BitRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/ExaBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/GigaBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MegaBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PetaBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/TeraBIT-PER-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD018","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD018","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/DataRate"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:BitRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bit Rate","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/DataRate"}]},{"@id":"http://qudt.org/vocab/quantitykind/BitTransmissionRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"speed with which one bit will be transmitted per second","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/BIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/ExaBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/GigaBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/MegaBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/PetaBIT-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/TeraBIT-PER-SEC"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ295#006","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Geschwindigkeit, mit der Binärzeichen übertragen werden","@language":"de"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/BitRate"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:BitRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bit Transmission Rate","@language":"en-us"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/BitRate"}]},{"@id":"http://qudt.org/vocab/quantitykind/BloodGlucoseLevel","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Blood sugar level, blood sugar concentration, or blood glucose level is the amount of glucose present in\n    the blood of humans and animals. Glucose is a simple sugar and approximately 4 grams of glucose are present in the blood of\n    humans at all times. Stored in skeletal muscle and liver cells in the form of glycogen, the body tightly regulates blood\n    glucose levels as a part of metabolic homeostasis. During fasting blood glucose is maintained at a constant level at the\n    expense of the glycogen stores in the liver and skeletal muscle. There are two main methods of describing concentrations: by\n    weight, and by molecular count. Weights are in grams and molecular counts in moles. A mole is $6.022\\times 10^{23}$\n    molecules. In both cases, the unit is usually modified by $milli-$ or $micro-$ or other prefix, and is always $per$ some\n    volume, often a litre. Conversion factors depend on the molecular weight of the substance in question. $mmol/L$ is\n    millimoles/liter, and is the world standard unit for measuring glucose in blood. Specifically, it is the designated SI\n    (Systeme International) unit. Some countries use $mg/dl$. A mole is about $6\\times 10^{23}$ molecules. $mg/dL$\n    (milligrams/deciliter) is the traditional unit for measuring $bG$ (blood glucose). There is a trend toward using $mmol/L$\n    however $mg/dL$ is much in practice. Some use is made of $mmol/L$ as the primary unit with $mg/dL$ quoted in parentheses. This\n    acknowledges the large base of health care providers, researchers and patients who are already familiar with $mg/dL$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MilliMOL-PER-L"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A1E0L-3I0M0H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.faqs.org/faqs/diabetes/faq/part1/section-9.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Blood_sugar_level","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:BloodGlucoseLevel","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Blood Glucose Level","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/MassBasedBloodGlucoseLevel"}]},{"@id":"http://qudt.org/vocab/quantitykind/BloodGlucoseLevel_Mass","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Blood sugar level, blood sugar concentration, or blood glucose level is the amount of glucose present in\n    the blood of humans and animals. Glucose is a simple sugar and approximately 4 grams of glucose are present in the blood of\n    humans at all times. Stored in skeletal muscle and liver cells in the form of glycogen, the body tightly regulates blood\n    glucose levels as a part of metabolic homeostasis. During fasting blood glucose is maintained at a constant level at the\n    expense of the glycogen stores in the liver and skeletal muscle. There are two main methods of describing concentrations: by\n    weight, and by molecular count. Weights are in grams and molecular counts in moles. A mole is $6.022\\times 10^{23}$\n    molecules. In both cases, the unit is usually modified by $milli-$ or $micro-$ or other prefix, and is always $per$ some\n    volume, often a litre. Conversion factors depend on the molecular weight of the substance in question. $mmol/L$ is\n    millimoles/liter, and is the world standard unit for measuring glucose in blood. Specifically, it is the designated SI\n    (Systeme International) unit. Some countries use $mg/dl$. A mole is about $6\\times 10^{23}$ molecules. $mg/dL$\n    (milligrams/deciliter) is the traditional unit for measuring $bG$ (blood glucose). There is a trend toward using $mmol/L$\n    however $mg/dL$ is much in practice. Some use is made of $mmol/L$ as the primary unit with $mg/dL$ quoted in parentheses. This\n    acknowledges the large base of health care providers, researchers and patients who are already familiar with $mg/dL$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/quantitykind/MassBasedBloodGlucoseLevel"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.3","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-3I0M1H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.faqs.org/faqs/diabetes/faq/part1/section-9.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Blood_sugar_level","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Blood Glucose Level by Mass","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/BloodGlucoseLevel"}]},{"@id":"http://qudt.org/vocab/quantitykind/BodyMassIndex","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Body Mass Index}$, BMI, is an index of weight for height, calculated as: $BMI =\n    \\frac{M_{body}}{H^2}$, where $M_{body}$ is body mass in kg, and $H$ is height in metres. The BMI has been used as a guideline\n    for defining whether a person is overweight because it minimizes the effect of height, but it does not take into consideration\n    other important factors, such as age and body build. The BMI has also been used as an indicator of obesity on the assumption\n    that the higher the index, the greater the level of body fat.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.oxfordreference.com/view/10.1093/acref/9780198631477.001.0001/acref-9780198631477-e-254","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/MassPerArea"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"BMI","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q131191"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:BodyMassIndex","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Body Mass Index","@language":"en"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"BMI","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/MassPerArea"}]},{"@id":"http://qudt.org/vocab/quantitykind/BoilingPoint","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"A temperature that is the one at which a substance will change its physical state from a liquid to a gas.\n    It is also the temperature where the liquid and gaseous forms of a pure substance can exist in equilibrium.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DEG_C"},{"@id":"http://qudt.org/vocab/unit/DEG_F"},{"@id":"http://qudt.org/vocab/unit/DEG_R"},{"@id":"http://qudt.org/vocab/unit/DecaK"},{"@id":"http://qudt.org/vocab/unit/K"},{"@id":"http://qudt.org/vocab/unit/MegaK"},{"@id":"http://qudt.org/vocab/unit/MilliDEG_C"},{"@id":"http://qudt.org/vocab/unit/MilliK"},{"@id":"http://qudt.org/vocab/unit/PlanckTemperature"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H1T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"A temperature that is the one at which a substance will change its physical state from a liquid to\n    a gas.  It is also the temperature where the liquid and gaseous forms of a pure substance can exist in equilibrium.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:BoilingPoint","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Boiling Point Temperature","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Temperature"}]},{"@id":"http://qudt.org/vocab/quantitykind/BraggAngle","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Bragg Angle\" describes the condition for a plane wave to be diffracted from a family of lattice planes,\n    the angle between the wavevector of the incident plane wave, and the lattice planes.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ARCMIN"},{"@id":"http://qudt.org/vocab/unit/ARCSEC"},{"@id":"http://qudt.org/vocab/unit/DEG"},{"@id":"http://qudt.org/vocab/unit/GON"},{"@id":"http://qudt.org/vocab/unit/GRAD"},{"@id":"http://qudt.org/vocab/unit/MIL_Angle"},{"@id":"http://qudt.org/vocab/unit/MIN_Angle"},{"@id":"http://qudt.org/vocab/unit/MicroRAD"},{"@id":"http://qudt.org/vocab/unit/MilliARCSEC"},{"@id":"http://qudt.org/vocab/unit/MilliRAD"},{"@id":"http://qudt.org/vocab/unit/RAD"},{"@id":"http://qudt.org/vocab/unit/REV"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://reference.iucr.org/dictionary/Bragg_angle","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31897","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$2d\\sin{\\vartheta} = n\\lambda $","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\vartheta$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"\"Bragg Angle\" describes the condition for a plane wave to be diffracted from a family of lattice\n    planes, the angle between the wavevector of the incident plane wave, and the lattice planes.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q105488118"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Angle","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Applicable units are those of quantitykind:PlaneAngle","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Bragg Angle","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}]},{"@id":"http://qudt.org/vocab/quantitykind/Breadth","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Breadth\" is the extent or measure of how broad or wide something is.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{