{"@id":"http://qudt.org/vocab/unit/DRAM_US"},{"@id":"http://qudt.org/vocab/unit/DWT"},{"@id":"http://qudt.org/vocab/unit/DecaGM"},{"@id":"http://qudt.org/vocab/unit/DeciGM"},{"@id":"http://qudt.org/vocab/unit/DeciTONNE"},{"@id":"http://qudt.org/vocab/unit/DeciTON_Metric"},{"@id":"http://qudt.org/vocab/unit/EarthMass"},{"@id":"http://qudt.org/vocab/unit/FemtoGM"},{"@id":"http://qudt.org/vocab/unit/GM"},{"@id":"http://qudt.org/vocab/unit/GM_Carbon"},{"@id":"http://qudt.org/vocab/unit/GM_DRY"},{"@id":"http://qudt.org/vocab/unit/GM_Nitrogen"},{"@id":"http://qudt.org/vocab/unit/GRAIN"},{"@id":"http://qudt.org/vocab/unit/HectoGM"},{"@id":"http://qudt.org/vocab/unit/Hundredweight_UK"},{"@id":"http://qudt.org/vocab/unit/Hundredweight_US"},{"@id":"http://qudt.org/vocab/unit/KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloLB"},{"@id":"http://qudt.org/vocab/unit/KiloTONNE"},{"@id":"http://qudt.org/vocab/unit/KiloTON_Metric"},{"@id":"http://qudt.org/vocab/unit/LB"},{"@id":"http://qudt.org/vocab/unit/LB_M"},{"@id":"http://qudt.org/vocab/unit/LB_T"},{"@id":"http://qudt.org/vocab/unit/LunarMass"},{"@id":"http://qudt.org/vocab/unit/MOMME_Pearl"},{"@id":"http://qudt.org/vocab/unit/MOMME_Textile"},{"@id":"http://qudt.org/vocab/unit/MegaGM"},{"@id":"http://qudt.org/vocab/unit/MegaTON"},{"@id":"http://qudt.org/vocab/unit/MegaTONNE"},{"@id":"http://qudt.org/vocab/unit/MicroGM"},{"@id":"http://qudt.org/vocab/unit/MilliGM"},{"@id":"http://qudt.org/vocab/unit/NanoGM"},{"@id":"http://qudt.org/vocab/unit/OZ"},{"@id":"http://qudt.org/vocab/unit/OZ_M"},{"@id":"http://qudt.org/vocab/unit/OZ_TROY"},{"@id":"http://qudt.org/vocab/unit/PENNYWEIGHT"},{"@id":"http://qudt.org/vocab/unit/PFUND"},{"@id":"http://qudt.org/vocab/unit/PicoGM"},{"@id":"http://qudt.org/vocab/unit/PlanckMass"},{"@id":"http://qudt.org/vocab/unit/Quarter_UK"},{"@id":"http://qudt.org/vocab/unit/SLUG"},{"@id":"http://qudt.org/vocab/unit/SolarMass"},{"@id":"http://qudt.org/vocab/unit/Stone_UK"},{"@id":"http://qudt.org/vocab/unit/TON"},{"@id":"http://qudt.org/vocab/unit/TONNE"},{"@id":"http://qudt.org/vocab/unit/TON_Assay"},{"@id":"http://qudt.org/vocab/unit/TON_LONG"},{"@id":"http://qudt.org/vocab/unit/TON_Metric"},{"@id":"http://qudt.org/vocab/unit/TON_SHORT"},{"@id":"http://qudt.org/vocab/unit/TON_UK"},{"@id":"http://qudt.org/vocab/unit/TON_US"},{"@id":"http://qudt.org/vocab/unit/U"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$M_{\\oplus}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Earth mass is the unit of mass equal to that of the Earth.  Earth mass is often used to describe\n    masses of rocky terrestrial planets.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/specializationOf":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:Mass","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass of the Earth","@language":"en"}],"http://www.w3.org/2004/02/skos/core#broader":[{"@id":"http://qudt.org/vocab/quantitykind/Mass"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassPerArea","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The area density (also known as areal density, surface density, or superficial density) of a\n    two-dimensional object is calculated as the mass per unit area. The SI derived unit is: kilogram per square metre  ($kg \\cdot\n    m^{-2}$).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/GM-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/GM-PER-HA"},{"@id":"http://qudt.org/vocab/unit/GM-PER-M2"},{"@id":"http://qudt.org/vocab/unit/GM-PER-MilliM2"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-HA"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-KiloM2"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M2"},{"@id":"http://qudt.org/vocab/unit/LB-PER-AC"},{"@id":"http://qudt.org/vocab/unit/LB-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/LB-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/LB-PER-YD2"},{"@id":"http://qudt.org/vocab/unit/MegaGM-PER-HA"},{"@id":"http://qudt.org/vocab/unit/MicroGM-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/MicroGM-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/MilliGM-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/MilliGM-PER-DeciM2"},{"@id":"http://qudt.org/vocab/unit/MilliGM-PER-HA"},{"@id":"http://qudt.org/vocab/unit/MilliGM-PER-M2"},{"@id":"http://qudt.org/vocab/unit/NanoGM-PER-CentiM2"},{"@id":"http://qudt.org/vocab/unit/OZ-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/OZ-PER-IN2"},{"@id":"http://qudt.org/vocab/unit/OZ-PER-YD2"},{"@id":"http://qudt.org/vocab/unit/SLUG-PER-FT2"},{"@id":"http://qudt.org/vocab/unit/TONNE-PER-HA"},{"@id":"http://qudt.org/vocab/unit/TON_Metric-PER-HA"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Area_density","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$\\rho_A = \\frac {m} {A}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\rho_A $","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassPerArea","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass per Area","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassPerAreaTime","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In Physics and Engineering, mass flux is the rate of mass flow per unit area. The common symbols are $j$,\n    $J$, $\\phi$, or $\\Phi$  (Greek lower or capital Phi), sometimes with subscript $m$ to indicate mass is the flowing quantity.\n    Its SI units are $ kg s^{-1} m^{-2}$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DYN-SEC-PER-CentiM3"},{"@id":"http://qudt.org/vocab/unit/GM-PER-CentiM2-YR"},{"@id":"http://qudt.org/vocab/unit/GM-PER-M2-DAY"},{"@id":"http://qudt.org/vocab/unit/GM-PER-M2-HR"},{"@id":"http://qudt.org/vocab/unit/GM-PER-M2-YR"},{"@id":"http://qudt.org/vocab/unit/GM_Carbon-PER-M2-DAY"},{"@id":"http://qudt.org/vocab/unit/GM_Nitrogen-PER-M2-DAY"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-HA-YR"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M2-DAY"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M2-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-SEC-M2"},{"@id":"http://qudt.org/vocab/unit/MegaGM-PER-HA-YR"},{"@id":"http://qudt.org/vocab/unit/MicroGM-PER-CentiM2-WK"},{"@id":"http://qudt.org/vocab/unit/MicroGM-PER-M2-DAY"},{"@id":"http://qudt.org/vocab/unit/MilliGM-PER-M2-DAY"},{"@id":"http://qudt.org/vocab/unit/MilliGM-PER-M2-HR"},{"@id":"http://qudt.org/vocab/unit/MilliGM-PER-M2-SEC"},{"@id":"http://qudt.org/vocab/unit/NanoGM-PER-CentiM2-DAY"},{"@id":"http://qudt.org/vocab/unit/TONNE-PER-HA-YR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Mass_flux","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$j_m = \\lim\\limits_{A \\rightarrow 0}\\frac{I_m}{A}$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassPerAreaTime","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass per Area Time","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassPerElectricCharge","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"The mass-to-charge ratio ratio ($m/Q$) is a physical quantity that is widely used in the electrodynamics\n    of charged particles, for example, in electron optics and ion optics. The importance of the mass-to-charge ratio, according to\n    classical electrodynamics, is that two particles with the same mass-to-charge ratio move in the same path in a vacuum when\n    subjected to the same electric and magnetic fields. Its SI units are $kg/C$, but it can also be measured in Thomson ($Th$).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/T-SEC"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E-1L0I0M1H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Mass-to-charge_ratio","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassPerElectricCharge","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass per Electric Charge","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassPerEnergy","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Mass per Energy ($m/E$) is a physical quantity that bridges mass and energy. The SI unit is $kg/J$ or\n    equivalently $s^2/m^2$.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/GM-PER-CentiM3-BAR"},{"@id":"http://qudt.org/vocab/unit/GM-PER-DeciM3-BAR"},{"@id":"http://qudt.org/vocab/unit/GM-PER-L-BAR"},{"@id":"http://qudt.org/vocab/unit/GM-PER-M3-BAR"},{"@id":"http://qudt.org/vocab/unit/GM-PER-MilliL-BAR"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-CentiM3-BAR"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-DeciM3-BAR"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-GigaJ"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-J"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-L-BAR"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M3-BAR"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M3-PA"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-MegaBTU_IT"},{"@id":"http://qudt.org/vocab/unit/LB-PER-FT3-PSI"},{"@id":"http://qudt.org/vocab/unit/LB-PER-IN3-PSI"},{"@id":"http://qudt.org/vocab/unit/MicroGM-PER-M3-BAR"},{"@id":"http://qudt.org/vocab/unit/MilliGM-PER-M3-BAR"},{"@id":"http://qudt.org/vocab/unit/TONNE-PER-M3-BAR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-2I0M0H0T2D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Mass per Energy is a physical quantity that can be used to relate the energy of a system to its\n    mass.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassPerEnergy","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass per Energy","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassPerLength","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"Linear density, linear mass density or linear mass is a measure of mass per unit of length, and it is a\n    characteristic of strings or other one-dimensional objects. The SI unit of linear density is the kilogram per metre ($kg/m$).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/DENIER"},{"@id":"http://qudt.org/vocab/unit/GM-PER-KiloM"},{"@id":"http://qudt.org/vocab/unit/GM-PER-M"},{"@id":"http://qudt.org/vocab/unit/GM-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-M"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-MilliM"},{"@id":"http://qudt.org/vocab/unit/LB-PER-FT"},{"@id":"http://qudt.org/vocab/unit/LB-PER-IN"},{"@id":"http://qudt.org/vocab/unit/MilliGM-PER-M"},{"@id":"http://qudt.org/vocab/unit/SLUG-PER-FT"},{"@id":"http://qudt.org/vocab/unit/TEX"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/LineicMass"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L-1I0M1H0T0D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Linear_density","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexSymbol":[{"@value":"$\\mu$","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassPerLength","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass per Length","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassPerTime","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-HR"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/KiloLB-PER-HR"},{"@id":"http://qudt.org/vocab/unit/LB-PER-HR"},{"@id":"http://qudt.org/vocab/unit/LB-PER-MIN"},{"@id":"http://qudt.org/vocab/unit/NanoGM-PER-DAY"},{"@id":"http://qudt.org/vocab/unit/SLUG-PER-SEC"},{"@id":"http://qudt.org/vocab/unit/TONNE-PER-MO"},{"@id":"http://qudt.org/vocab/unit/TONNE-PER-YR"},{"@id":"http://qudt.org/vocab/unit/TON_SHORT-PER-HR"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T-1D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassPerTime","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass per Time","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassRatio","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"In aerospace engineering, mass ratio is a measure of the efficiency of a rocket. It describes how much\n    more massive the vehicle is with propellant than without; that is, it is the ratio of the rocket's wet mass (vehicle plus\n    contents plus propellant) to its dry mass (vehicle plus contents)\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/FRACTION"},{"@id":"http://qudt.org/vocab/unit/FemtoGM-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/GM-PER-GM"},{"@id":"http://qudt.org/vocab/unit/GM-PER-HectoGM"},{"@id":"http://qudt.org/vocab/unit/GM-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/GM-PER-TONNE"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/KiloGM-PER-TONNE"},{"@id":"http://qudt.org/vocab/unit/LB-PER-LB"},{"@id":"http://qudt.org/vocab/unit/MicroGM-PER-GM"},{"@id":"http://qudt.org/vocab/unit/MicroGM-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/MicroGM-PER-MilliGM"},{"@id":"http://qudt.org/vocab/unit/MilliGM-PER-GM"},{"@id":"http://qudt.org/vocab/unit/MilliGM-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/NanoGM-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/NanoGM-PER-MilliGM"},{"@id":"http://qudt.org/vocab/unit/PicoGM-PER-GM"},{"@id":"http://qudt.org/vocab/unit/PicoGM-PER-KiloGM"},{"@id":"http://qudt.org/vocab/unit/PicoGM-PER-MilliGM"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD109","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/ListsOfUnitsAllVersions/0112-2---62720%23UAD109","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"In aerospace engineering, mass ratio is a measure of the efficiency of a rocket. It describes how\n    much more massive the vehicle is with propellant than without; that is, it is the ratio of the rocket's wet mass (vehicle plus\n    contents plus propellant) to its dry mass (vehicle plus contents)\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"R or M_{R}","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q1563068"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassRatio","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Ratio","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/quantitykind/MassFraction"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassRatioOfWaterToDryMatter","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Mass Ratio of Water to Dry Matter\" is one of a number of $\\textit{Concentration Ratio}$ quantities\n    defined by ISO 80000.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$u = m/m_d$, where $m$ is mass of water vapour and $m_d$ is mass of dry matter. Mass ratio of water to dry matter at saturation is denoted $u_{sat}$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Mass Ratio of Water to Dry Matter is one of a number of Concentration Ratio quantities defined by\n    ISO 80000.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"u","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassRatioOfWaterToDryMatter","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Concentration of Water to Dry Matter","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassRatioOfWaterVapourToDryGas","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"\"Mass Ratio of Water Vapour to Dry Gas\" is one of a number of $\\textit{Concentration Ratio}$ quantities\n    defined by ISO 80000.\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/isoNormativeReference":[{"@value":"http://www.iso.org/iso/catalogue_detail?csnumber=31890","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/latexDefinition":[{"@value":"$x = m/m_d$, where $m$ is mass of water vapour and $m_d$ is mass of dry gas. Mass ratio of water vapour to dry gas  at saturation is denoted $x_{sat}$.","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"Mass Ratio of Water Vapour to Dry Gas is one of a number of Concentration Ratio quantities defined\n    by ISO 80000.\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"x","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q17232415"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassRatioOfWaterVapourToDryGas","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Ratio of Water Vapour to Dry Gas","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassRelatedElectricalCurrent","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"electrical current intensity divided by the associated mass","@language":"en"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/A-PER-KiloGM"}],"http://qudt.org/schema/qudt/eclassCode":[{"@value":"0173-1#Z4-BAJ347#004","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/exactMatch":[{"@id":"http://qudt.org/vocab/quantitykind/MassicElectricCurrent"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M-1H0T0D0"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"elektrische Stromstärke dividiert durch die zugehörige Masse","@language":"de"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassRelatedElectricalCurrent","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass-related Electrical Current","@language":"en-us"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassSpecificBiogeochemicalRate","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://purl.org/dc/terms/description":[{"@value":"the rate at which a specific chemical element or compound is processed or transformed within an\n    ecosystem, calculated per unit mass of the relevant biological material. Unreduced, SI unit is kg * kg-1 * s-1\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/MicroGM-PER-GM-DAY"},{"@id":"http://qudt.org/vocab/unit/MicroGM-PER-GM-HR"},{"@id":"http://qudt.org/vocab/unit/MilliGM-PER-GM-HR"},{"@id":"http://qudt.org/vocab/unit/MilliGM-PER-KiloGM-DAY"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T-1D0"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://esajournals.onlinelibrary.wiley.com/doi/10.1002/ecs2.2228","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/plainTextDescription":[{"@value":"the rate at which a specific chemical element or compound is processed or transformed within an\n    ecosystem, calculated per unit mass of the relevant biological material. Unreduced, SI unit is g * g-1 * s-1\n  ","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T1D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M1H0T0D0"}],"http://www.w3.org/2000/01/rdf-schema#comment":[{"@value":"Applicable units are those of quantitykind:MassSpecificBiogeochemicalRate","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/quantitykind"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Mass Specific Biogeochemical Rate","@language":"en"}]},{"@id":"http://qudt.org/vocab/quantitykind/MassStoppingPower","@type":["http://qudt.org/schema/qudt/QuantityKind"],"http://qudt.org/schema/qudt/applicableUnit":[{"@id":"http://qudt.org/vocab/unit/ERG-CentiM2"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L4I0M1H0T-2D0"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD130","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"0112/2///62720#UAD290","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https