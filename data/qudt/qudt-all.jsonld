rAreaPerSolidAngle"},{"@id":"http://qudt.org/vocab/quantitykind/PowerPerArea"},{"@id":"http://qudt.org/vocab/quantitykind/PowerPerAreaAngle"},{"@id":"http://qudt.org/vocab/quantitykind/PowerPerAreaQuarticTemperature"},{"@id":"http://qudt.org/vocab/quantitykind/PowerPerElectricCharge"},{"@id":"http://qudt.org/vocab/quantitykind/QuarticElectricDipoleMomentPerCubicEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/RadiantIntensity"},{"@id":"http://qudt.org/vocab/quantitykind/Resistance"},{"@id":"http://qudt.org/vocab/quantitykind/SolidAngle"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacity"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatPressure"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatVolume"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificImpulseByMass"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificVolume"},{"@id":"http://qudt.org/vocab/quantitykind/SquareEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SquareTime"},{"@id":"http://qudt.org/vocab/quantitykind/StandardGravitationalParameter"},{"@id":"http://qudt.org/vocab/quantitykind/Stress"},{"@id":"http://qudt.org/vocab/quantitykind/TemperatureAmountOfSubstance"},{"@id":"http://qudt.org/vocab/quantitykind/TemperaturePerMagneticFluxDensity"},{"@id":"http://qudt.org/vocab/quantitykind/TemperaturePerTime"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalConductivity"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalDiffusivity"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalInsulance"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalResistance"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalResistivity"},{"@id":"http://qudt.org/vocab/quantitykind/ThrustToMassRatio"},{"@id":"http://qudt.org/vocab/quantitykind/TimeTemperature"},{"@id":"http://qudt.org/vocab/quantitykind/Torque"},{"@id":"http://qudt.org/vocab/quantitykind/Volume"},{"@id":"http://qudt.org/vocab/quantitykind/VolumePerTime"},{"@id":"http://qudt.org/vocab/quantitykind/VolumeThermalExpansion"},{"@id":"http://qudt.org/vocab/quantitykind/VolumetricHeatCapacity"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/soqk"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"International System of Quantity Kinds","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/soqk/USCS","@type":["http://qudt.org/schema/qudt/SystemOfQuantityKinds"],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/AngularAcceleration"},{"@id":"http://qudt.org/vocab/quantitykind/AngularVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/Area"},{"@id":"http://qudt.org/vocab/quantitykind/AreaTemperature"},{"@id":"http://qudt.org/vocab/quantitykind/AreaTime"},{"@id":"http://qudt.org/vocab/quantitykind/AreaTimeTemperature"},{"@id":"http://qudt.org/vocab/quantitykind/CoefficientOfHeatTransfer"},{"@id":"http://qudt.org/vocab/quantitykind/Density"},{"@id":"http://qudt.org/vocab/quantitykind/DynamicViscosity"},{"@id":"http://qudt.org/vocab/quantitykind/EnergyPerArea"},{"@id":"http://qudt.org/vocab/quantitykind/Force"},{"@id":"http://qudt.org/vocab/quantitykind/ForcePerArea"},{"@id":"http://qudt.org/vocab/quantitykind/ForcePerLength"},{"@id":"http://qudt.org/vocab/quantitykind/HeatCapacity"},{"@id":"http://qudt.org/vocab/quantitykind/HeatFlowRate"},{"@id":"http://qudt.org/vocab/quantitykind/KinematicViscosity"},{"@id":"http://qudt.org/vocab/quantitykind/Length"},{"@id":"http://qudt.org/vocab/quantitykind/LinearAcceleration"},{"@id":"http://qudt.org/vocab/quantitykind/LinearVelocity"},{"@id":"http://qudt.org/vocab/quantitykind/LiquidVolume"},{"@id":"http://qudt.org/vocab/quantitykind/Mass"},{"@id":"http://qudt.org/vocab/quantitykind/MassPerArea"},{"@id":"http://qudt.org/vocab/quantitykind/MassPerLength"},{"@id":"http://qudt.org/vocab/quantitykind/MassPerTime"},{"@id":"http://qudt.org/vocab/quantitykind/MassTemperature"},{"@id":"http://qudt.org/vocab/quantitykind/MolarHeatCapacity"},{"@id":"http://qudt.org/vocab/quantitykind/Power"},{"@id":"http://qudt.org/vocab/quantitykind/PowerPerArea"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/SpecificHeatCapacity"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalConductivity"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalDiffusivity"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergy"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalEnergyLength"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalInsulance"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalResistance"},{"@id":"http://qudt.org/vocab/quantitykind/ThermalResistivity"},{"@id":"http://qudt.org/vocab/quantitykind/ThermodynamicTemperature"},{"@id":"http://qudt.org/vocab/quantitykind/ThrustToMassRatio"},{"@id":"http://qudt.org/vocab/quantitykind/Time"},{"@id":"http://qudt.org/vocab/quantitykind/Torque"},{"@id":"http://qudt.org/vocab/quantitykind/Volume"},{"@id":"http://qudt.org/vocab/quantitykind/VolumePerTime"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/soqk"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"US Customary System of Quantity Kinds","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/sou/ASU","@type":["http://qudt.org/schema/qudt/SystemOfUnits"],"http://purl.org/dc/terms/description":[{"@value":"The astronomical system of units, formally called the IAU (1976) System of Astronomical Constants, is a system of measurement developed for use in astronomy. It was adopted by the International Astronomical Union (IAU) in 1976, and has been slightly updated since then. The system was developed because of the difficulties in measuring and expressing astronomical data in International System of Units (SI units). In particular, there is a huge quantity of very precise data relating to the positions of objects within the solar system which cannot conveniently be expressed or processed in SI units. Through a number of modifications, the astronomical system of units now explicitly recognizes the consequences of general relativity, which is a necessary addition to the International System of Units in order to accurately treat astronomical data. The astronomical system of units is a tridimensional system, in that it defines units of length, mass and time. The associated astronomical constants also fix the different frames of reference that are needed to report observations. The system is a conventional system, in that neither the unit of length nor the unit of mass are true physical constants, and there are at least three different measures of time.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.iau.org/public/themes/measuring/","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/sou"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Astronomic System Of Units","@language":"en"}]},{"@id":"http://qudt.org/vocab/sou/CGS","@type":["http://qudt.org/schema/qudt/SystemOfUnits"],"http://purl.org/dc/terms/description":[{"@value":"<p>The centimetre-gram-second system (abbreviated CGS or cgs) is a variant of the metric system of physical units based on centimetre as the unit of length, gram as a unit of mass, and second as a unit of time. All CGS mechanical units are unambiguously derived from these three base units, but there are several different ways of extending the CGS system to cover electromagnetism. The CGS system has been largely supplanted by the MKS system, based on metre, kilogram, and second. Note that the term cgs is ambiguous, since there are several variants with conflicting definitions of electromagnetic quantities and units. The unqualified term is generally associated with the Gaussian system of units, so this more precise URI is preferred.</p>","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"CGS","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Centimetre_gram_second_system_of_units","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasBaseUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/GM"},{"@id":"http://qudt.org/vocab/unit/SEC"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://scienceworld.wolfram.com/physics/cgs.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.tf.uni-kiel.de/matwis/amat/mw1_ge/kap_2/basics/b2_1_14.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Centimetre–gram–second_system_of_units","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/sou"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"CGS System of Units","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-ESU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"}]},{"@id":"http://qudt.org/vocab/sou/CGS-EMU","@type":["http://qudt.org/schema/qudt/SystemOfUnits"],"http://purl.org/dc/terms/description":[{"@value":"The units in this system are formed in a manner similar to that of the cgs electrostatic system of units: the unit of electric current was defined using the law that describes the force between current-carrying wires. To do this, the permeability of free space (the magnetic constant, relating the magnetic flux density in a vacuum to the strength of the external magnetic field), was set at 1. To distinguish cgs electromagnetic units from units in the international system, they were often given the prefix “ab-”. However, most are often referred to purely descriptively as the 'e.m. unit of capacitance', etc. ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"CGS-EMU","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasBaseUnit":[{"@id":"http://qudt.org/vocab/unit/BIOT"},{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/GM"},{"@id":"http://qudt.org/vocab/unit/SEC"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.sizes.com/units/sys_cgs_em.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/sou"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"CGS System of Units - EMU","@language":"en"}]},{"@id":"http://qudt.org/vocab/sou/CGS-ESU","@type":["http://qudt.org/schema/qudt/SystemOfUnits"],"http://purl.org/dc/terms/description":[{"@value":"The electrostatic system of units is a system of units used to measure electrical quantities of electric charge, current, and voltage, within the centimeter gram second (or \"CGS\") metric system of units. In electrostatic units, electrical charge is defined via the force it exerts on other charges. The various units of the e.s.u. system have specific names obtained by prefixing more familiar names with $stat$, but are often referred to purely descriptively as the 'e.s. unit of capacitance', etc. ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"CGS-ESU","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Electrostatic_units","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.oxfordreference.com/view/10.1093/acref/9780198605225.001.0001/acref-9780198605225-e-399#","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.sizes.com/units/sys_cgs_stat.htm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/sou"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"CGS System of Units ESU","@language":"en"}]},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS","@type":["http://qudt.org/schema/qudt/SystemOfUnits"],"http://purl.org/dc/terms/description":[{"@value":"Gaussian units constitute a metric system of physical units. This system is the most common of the several electromagnetic unit systems based on cgs (centimetre–gram–second) units. It is also called the Gaussian unit system, Gaussian-cgs units, or often just cgs units. The term \"cgs units\" is ambiguous and therefore to be avoided if possible: there are several variants of cgs with conflicting definitions of electromagnetic quantities and units. [Wikipedia]","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"CGS-GAUSS","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasBaseUnit":[{"@id":"http://qudt.org/vocab/unit/CentiM"},{"@id":"http://qudt.org/vocab/unit/GM"},{"@id":"http://qudt.org/vocab/unit/SEC"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Gaussian_units","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/sou"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"CGS System of Units - Gaussian","@language":"en"}],"http://www.w3.org/2000/01/rdf-schema#seeAlso":[{"@id":"http://qudt.org/vocab/sou/CGS"}]},{"@id":"http://qudt.org/vocab/sou/IMPERIAL","@type":["http://qudt.org/schema/qudt/SystemOfUnits"],"http://purl.org/dc/terms/description":[{"@value":"A system of units formerly widely used in the UK and the rest of the English-speaking world. It includes the pound (lb), quarter (qt), hundredweight (cwt), and ton (ton); the foot (ft), yard (yd), and mile (mi); and the gallon (gal), British thermal unit (btu), etc. These units have been largely replaced by metric units, although Imperial units persist in some contexts. In January 2000 an EU regulation outlawing the sale of goods in Imperial measures was adopted into British law; an exception was made for the sale of beer and milk in pints. ","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"Imperial","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Imperial_units","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.oxfordreference.com/view/10.1093/acref/9780199234899.001.0001/acref-9780199234899-e-3147","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/sou"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Imperial System of Units","@language":"en"}]},{"@id":"http://qudt.org/vocab/sou/PLANCK","@type":["http://qudt.org/schema/qudt/SystemOfUnits"],"http://purl.org/dc/terms/description":[{"@value":"In physics, Planck units are physical units of measurement defined exclusively in terms of five universal physical constants listed below, in such a manner that these five physical constants take on the numerical value of 1 when expressed in terms of these units. Planck units elegantly simplify particular algebraic expressions appearing in physical law.  \nOriginally proposed in 1899 by German physicist Max Planck, these units are also known as natural units because the origin of their definition comes only from properties of nature and not from any human construct. Planck units are unique among systems of natural units, because they are not defined in terms of properties of any prototype, physical object, or even elementary particle.\nUnlike the meter and second, which exist as fundamental units in the SI system for (human) historical reasons, the Planck length and Planck time are conceptually linked at a fundamental physical level. Natural units help physicists to reframe questions.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"PLANCK","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Planck_units","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasBaseUnit":[{"@id":"http://qudt.org/vocab/unit/PlanckCharge"},{"@id":"http://qudt.org/vocab/unit/PlanckLength"},{"@id":"http://qudt.org/vocab/unit/PlanckMass"},{"@id":"http://qudt.org/vocab/unit/PlanckTemperature"},{"@id":"http://qudt.org/vocab/unit/PlanckTime"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://en.wikipedia.org/wiki/Planck_units?oldid=495407713","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/sou"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Planck System of Units","@language":"en"}]},{"@id":"http://qudt.org/vocab/sou/SI","@type":["http://qudt.org/schema/qudt/SystemOfUnits"],"http://purl.org/dc/terms/description":[{"@value":"The International System of Units (abbreviated $SI$ from French: Système international d'unités) is the modern form of the metric system and is generally a system of units of measurement devised around seven base units and the convenience of the number ten. The older metric system included several groups of units. The SI was established in 1960, based on the metre-kilogram-second system, rather than the centimetre-gram-second system, which, in turn, had a few variants.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"SI","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/International_System_of_Units","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasBaseUnit":[{"@id":"http://qudt.org/vocab/unit/A"},{"@id":"http://qudt.org/vocab/unit/CD"},{"@id":"http://qudt.org/vocab/unit/K"},{"@id":"http://qudt.org/vocab/unit/KiloGM"},{"@id":"http://qudt.org/vocab/unit/M"},{"@id":"http://qudt.org/vocab/unit/MOL"},{"@id":"http://qudt.org/vocab/unit/SEC"},{"@id":"http://qudt.org/vocab/unit/UNITLESS"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://aurora.regenstrief.org/~ucum/ucum.html","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://physics.info/system-international/","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://physics.nist.gov/Pubs/SP811","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.nist.gov/pml/pubs/sp811/index.cfm","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.oxfordreference.com/view/10.1093/acref/9780198605225.001.0001/acref-9780198605225-e-1292","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.oxfordreference.com/view/10.1093/acref/9780199233991.001.0001/acref-9780199233991-appendix-0003","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"http://www.oxfordreference.com/view/10.1093/acref/9780199233991.001.0001/acref-9780199233991-e-2791","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://www.govinfo.gov/content/pkg/GOVPUB-C13-f10c2ff9e7af2091314396a2d53213e4/pdf/GOVPUB-C13-f10c2ff9e7af2091314396a2d53213e4.pdf","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/prefix":[{"@id":"http://qudt.org/vocab/prefix/Atto"},{"@id":"http://qudt.org/vocab/prefix/Centi"},{"@id":"http://qudt.org/vocab/prefix/Deca"},{"@id":"http://qudt.org/vocab/prefix/Deci"},{"@id":"http://qudt.org/vocab/prefix/Deka"},{"@id":"http://qudt.org/vocab/prefix/Exa"},{"@id":"http://qudt.org/vocab/prefix/Femto"},{"@id":"http://qudt.org/vocab/prefix/Giga"},{"@id":"http://qudt.org/vocab/prefix/Hecto"},{"@id":"http://qudt.org/vocab/prefix/Kilo"},{"@id":"http://qudt.org/vocab/prefix/Mega"},{"@id":"http://qudt.org/vocab/prefix/Micro"},{"@id":"http://qudt.org/vocab/prefix/Milli"},{"@id":"http://qudt.org/vocab/prefix/Nano"},{"@id":"http://qudt.org/vocab/prefix/Peta"},{"@id":"http://qudt.org/vocab/prefix/Pico"},{"@id":"http://qudt.org/vocab/prefix/Quecto"},{"@id":"http://qudt.org/vocab/prefix/Quetta"},{"@id":"http://qudt.org/vocab/prefix/Ronna"},{"@id":"http://qudt.org/vocab/prefix/Ronto"},{"@id":"http://qudt.org/vocab/prefix/Tera"},{"@id":"http://qudt.org/vocab/prefix/Yocto"},{"@id":"http://qudt.org/vocab/prefix/Yotta"},{"@id":"http://qudt.org/vocab/prefix/Zepto"},{"@id":"http://qudt.org/vocab/prefix/Zetta"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/sou"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"International System of Units","@language":"en"}]},{"@id":"http://qudt.org/vocab/sou/UNSTATED","@type":["http://qudt.org/schema/qudt/SystemOfUnits"],"http://purl.org/dc/terms/description":[{"@value":"This placeholder system of units is for all units that do not fit will into any other system of units as modeled here.","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/sou"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Unstated System Of Units","@language":"en"}]},{"@id":"http://qudt.org/vocab/sou/USCS","@type":["http://qudt.org/schema/qudt/SystemOfUnits"],"http://purl.org/dc/terms/description":[{"@value":"United States customary units are a system of measurements commonly used in the United States. Many U.S. units are virtually identical to their imperial counterparts, but the U.S. customary system developed from English units used in the British Empire before the system of imperial units was standardized in 1824. Several numerical differences from the imperial system are present. The vast majority of U.S. customary units have been defined in terms of the meter and the kilogram since the Mendenhall Order of 1893 (and, in practice, for many years before that date). These definitions were refined in 1959. The United States is the only industrialized nation that does not mainly use the metric system in its commercial and standards activities, although the International System of Units (SI, often referred to as \"metric\") is commonly used in the U.S. Armed Forces, in fields relating to science, and increasingly in medicine, aviation, and government as well as various sectors of industry. [Wikipedia]","@type":"http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML"}],"http://qudt.org/schema/qudt/abbreviation":[{"@value":"US Customary","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/United_States_customary_units","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.linkedmodel.org/schema/vaem#url":[{"@value":"https://en.wikipedia.org/wiki/US_customary_units","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/sou"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"US Customary Unit System","@language":"en"}]},{"@id":"http://qudt.org/vocab/unit/2PiRAD","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/isReplacedBy":[{"@id":"http://qudt.org/vocab/unit/REV"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"0.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"0.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/deprecated":[{"@value":"true","@type":"http://www.w3.org/2001/XMLSchema#boolean"}],"http://qudt.org/schema/qudt/deprecatedInVersion":[{"@value":"3.1.2","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L0I0M0H0T0D1"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Angle"},{"@id":"http://qudt.org/vocab/quantitykind/PlaneAngle"}],"http://qudt.org/schema/qudt/qkdvDenominator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://qudt.org/schema/qudt/qkdvNumerator":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E0L1I0M0H0T0D0"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"2pirad","@language":"en"},{"@value":"2pirad","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/A","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Ampere}$, often shortened to $\\text{amp}$,\nis the SI unit of electric current and is one of the seven SI base units defined as:\n\n$$\\text{A} \\equiv \\frac{\\textit{C}}{\\textit{s}}\n\\equiv \\frac{\\textit{coulomb}}{\\textit{second}}\n\\equiv \\frac{\\text{joule}}{\\text{weber}}$$\n\nNote that SI supports only the use of symbols and deprecates the use of any abbreviations for units.\n","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/PLANCK"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"1.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"1.0E0","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/dbpediaMatch":[{"@value":"http://dbpedia.org/resource/Ampere","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T0D0"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/CurrentLinkage"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrent"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPhasor"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticTension"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA101","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA101","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Ampere?oldid=494026699","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/omUnit":[{"@id":"http://www.ontology-of-units-of-measure.org/resource/om-2/ampere"}],"http://qudt.org/schema/qudt/siExactMatch":[{"@id":"https://si-digital-framework.org/SI/units/ampere"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"A","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"A","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/udunitsCode":[{"@value":"A","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"AMP","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/CurrentLinkage"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrent"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCurrentPhasor"},{"@id":"http://qudt.org/vocab/quantitykind/MagneticTension"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q25272"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Amper","@language":"hu"},{"@value":"Amper","@language":"pl"},{"@value":"Amper","@language":"ro"},{"@value":"Amper","@language":"sl"},{"@value":"Amper","@language":"tr"},{"@value":"Ampere","@language":"de"},{"@value":"Ampere","@language":"en"},{"@value":"Ampere","@language":"it"},{"@value":"Ampere","@language":"ms"},{"@value":"Ampere","@language":"pt"},{"@value":"Ampere","@type":"http://www.w3.org/2001/XMLSchema#string"},{"@value":"Amperio","@language":"es"},{"@value":"Amperium","@language":"la"},{"@value":"Ampère","@language":"fr"},{"@value":"Ampér","@language":"cs"},{"@value":"Αμπέρ","@language":"el"},{"@value":"Ампер","@language":"bg"},{"@value":"Ампер","@language":"ru"},{"@value":"אמפר","@language":"he"},{"@value":"آمپر","@language":"fa"},{"@value":"أمبير","@language":"ar"},{"@value":"एम्पीयर","@language":"hi"},{"@value":"アンペア","@language":"ja"},{"@value":"安培","@language":"zh"}],"http://www.w3.org/2004/02/skos/core#altLabel":[{"@value":"amp","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/A-HR","@type":["http://qudt.org/schema/qudt/DerivedUnit","http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Ampere Hour}$ is a practical unit of electric charge equal to the charge flowing\n   in one hour through a conductor passing one ampere.\n   An ampere-hour or amp-hour (symbol $Ah,\\,AHr,\\, A \\cdot h, A h$) is a unit of electric\n    charge, with sub-units milliampere-hour ($mAh$) and milliampere second ($mAs$).\n    One ampere-hour is equal to 3600 coulombs (ampere-seconds), the electric charge transferred\n     by a steady current of one ampere for one hour.\n    The ampere-hour is frequently used in measurements of electrochemical systems such as\n     electroplating and electrical batteries.\n    The commonly seen milliampere-hour ($mAh$ or $mA \\cdot h$) is one-thousandth of an\n     ampere-hour ($3.6 \\,coulombs$).\n  ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/applicableSystem":[{"@id":"http://qudt.org/vocab/sou/CGS"},{"@id":"http://qudt.org/vocab/sou/CGS-EMU"},{"@id":"http://qudt.org/vocab/sou/CGS-GAUSS"},{"@id":"http://qudt.org/vocab/sou/SI"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"3600.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"3.6E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H0T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-428"},{"@id":"_:n3-429"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/BatteryCapacity"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCharge"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAA102","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"http://www.oxfordreference.com/view/10.1093/acref/9780199233991.001.0001/acref-9780199233991-e-86","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAA102","@type":"http://www.w3.org/2001/XMLSchema#anyURI"},{"@value":"https://en.wikipedia.org/wiki/Ampere-hour","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"http://qudt.org/schema/qudt/symbol":[{"@value":"A·h","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/ucumCode":[{"@value":"A.h","@type":"http://qudt.org/schema/qudt/UCUMcs"}],"http://qudt.org/schema/qudt/uneceCommonCode":[{"@value":"AMH","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/unitForQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/BatteryCapacity"},{"@id":"http://qudt.org/vocab/quantitykind/ElectricCharge"}],"http://qudt.org/schema/qudt/wikidataMatch":[{"@id":"http://www.wikidata.org/entity/Q212120"}],"http://www.w3.org/2000/01/rdf-schema#isDefinedBy":[{"@id":"http://qudt.org/3.5.2/vocab/unit"}],"http://www.w3.org/2000/01/rdf-schema#label":[{"@value":"Ampere Hour","@language":"en"},{"@value":"Ampere Hour","@type":"http://www.w3.org/2001/XMLSchema#string"}]},{"@id":"http://qudt.org/vocab/unit/A-HR-PER-DEG_C","@type":["http://qudt.org/schema/qudt/Unit"],"http://purl.org/dc/terms/description":[{"@value":"$\\textit{Ampere Hour per Degree Celsius}$ is the product of the SI base unit ampere and the unit hour\n divided by the unit degree Celsius.\n ","@type":"http://qudt.org/schema/qudt/LatexString"}],"http://qudt.org/schema/qudt/categorizedByQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Unknown"}],"http://qudt.org/schema/qudt/conversionMultiplier":[{"@value":"3600.0","@type":"http://www.w3.org/2001/XMLSchema#decimal"}],"http://qudt.org/schema/qudt/conversionMultiplierSN":[{"@value":"3.6E3","@type":"http://www.w3.org/2001/XMLSchema#double"}],"http://qudt.org/schema/qudt/hasDimensionVector":[{"@id":"http://qudt.org/vocab/dimensionvector/A0E1L0I0M0H-1T1D0"}],"http://qudt.org/schema/qudt/hasFactorUnit":[{"@id":"_:n3-430"},{"@id":"_:n3-431"},{"@id":"_:n3-432"}],"http://qudt.org/schema/qudt/hasQuantityKind":[{"@id":"http://qudt.org/vocab/quantitykind/Unknown"}],"http://qudt.org/schema/qudt/iec61360Code":[{"@value":"0112/2///62720#UAD886","@type":"http://www.w3.org/2001/XMLSchema#string"}],"http://qudt.org/schema/qudt/informativeReference":[{"@value":"https://cdd.iec.ch/cdd/iec62720/iec62720.nsf/Units/0112-2---62720%23UAD886","@type":"http://www.w3.org/2001/XMLSchema#anyURI"}],"htt